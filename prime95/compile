# Standard options
masm=ml /c /coff /I..\gwnum
#masm=ml /c /coff /I..\gwnum /Fl /Sf /Sa
masm64=ml64 /c /DX86_64 /I..\gwnum
#masm64=ml64 /c /DX86_64 /DGDEBUG /I..\gwnum
#masm64=ml64 /c /DX86_64 /I..\gwnum /Fl /Sf /Sa
cl4=\msdev\bin\cl /I.. /I C:\msdev\include\ /O2 /GF /W3 /MT /c
#cl4=\msdev\bin\cl /I.. /I C:\msdev\include\ /O2 /GF /W3 /MT /Zi /c
cl=cl /I.. /GF /W3 /MT /D_CRT_SECURE_NO_DEPRECATE /c
#cl=cl /I.. /GF /W3 /MT /D_CRT_SECURE_NO_DEPRECATE /Zi /c

# Create 32-bit object files

factor32.obj: factor32.asm factor32.mac
    $(masm) /Fofactor32.obj factor32.asm

# Compile special services code

service.obj: service.c
    $(cl) service.c

# Create 64-bit object files

amd64\factor64.obj: factor64.asm
    $(masm64) /Foamd64\factor64.obj factor64.asm

