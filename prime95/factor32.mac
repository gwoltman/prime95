************************************************************************
; This macro uses SSE2 instructions to perform the powering and modulo
; step in factoring.  Since the SSE2 shift instructions only accept an
; immediate shift count, we need to have different code for every bit length.
;
; This code can handle factors from 61 bits up to 86 bits (I think!).
; How far it can actually handle depends on the error in computing the
; quotient, which I think is 2 bits, but I could be wrong.

sse2_fac MACRO fac_size
	LOCAL	nomul2

;; Note that at the beginning of the xmm0, xmm1, xmm2 contains the
;; remainder to square.  This remainder can be one more bit than the
;; fac_size.  This is because we do not perform a modulo after the optional
;; multiply by two at the end of this macro.

;; Also note that in very rare cases the remainder could be two more bits
;; than fac_size.  Since the caluclated quotient could be one too small,
;; the maximum remainder is 2 * (factor + epsilon).  This extremely rare
;; extra bit should not be a problem as the code below uses 30 bit integers
;; and it shouldn't be a problem handling one more bit.

;; In the comments of this code, we'll assume fac_size is 89 bits and the
;; input remainder is 90 bits (30 bits in each xmm register).

;; rem = A,B,C (30,30,30 bits unsigned)
;; Square rem producing a 180 bit result stored in temp1, temp3, temp5
;; temp5 = CC				(60)
;; temp4 = 2BC				(61)
;; temp3 = 2AC + BB			(62 = 61 + 60)
;; temp2 = 2AB				(61)
;; temp1 = AA				(60)
;;
;; temp5 += (temp4 & 0x3FFFFFFF) << 30	(61)
;; temp3 += (temp4 >> 30) +
;;	    (temp2 & 0x3FFFFFFF) << 30	(63 = 61 + 60 + 60 + 31)
;; temp1 += temp2 >> 30			(60)

	movdqa	xmm3, xmm0		;; Copy A
	movdqa	xmm4, xmm0		;; Copy A
	pmuludq	xmm0, xmm1		;; AB
	movdqa	xmm5, xmm1		;; Copy B
	pmuludq	xmm1, xmm2		;; BC
	paddd	xmm3, xmm3		;; 2A
	pmuludq	xmm3, xmm2		;; 2AC
	movdqa	xmm6, XMM_BITS29
	pand	xmm6, xmm0		;; Lower 29 bits of AB
	pmuludq	xmm5, xmm5		;; BB
	movdqa	xmm7, XMM_BITS29
	pand	xmm7, xmm1		;; Lower 29 bits of BC
	pmuludq	xmm4, xmm4		;; AA
	paddq	xmm5, xmm3		;; temp3 = 2AC + BB
	psllq	xmm6, 30+1		;; (temp2 & 0x3FFFFFFF) << 30
	psrlq	xmm1, 30-1		;; temp4 >> 30
	psrlq	xmm0, 30-1		;; temp2 >> 30
	por	xmm1, xmm6		;; temp4>>30 + (temp2 & 0x3FFFFFFF)<<30
	paddq	xmm4, xmm0		;; temp1 = AA + temp2 >> 30
	paddq	xmm5, xmm1		;; temp3 += (temp4>>30) + ...
	pmuludq	xmm2, xmm2		;; CC
	psllq	xmm7, 30+1		;; (temp4 & 0x3FFFFFFF) << 30
	paddq	xmm7, xmm2		;; temp5 = CC + (temp4&0x3FFFFFFF)<<30

;; Squared remainder is in xmm4, xmm5, xmm7

;; Save the bottom 90 bits for later use (we'll subtract quotient * factor)
;; from these bits
;;
;; S4 = temp5				(61)
;; S3 = temp3				(63 of which we only care about 30)

	movdqa	xmm6, xmm5		;; Save temp3

;; Shift the squared remainder left until we have enough bits in three
;; registers to accurately compute the quotient.  There are three cases
;; detailed below.
;;
;; We will produce three 30 bit registers (SS1, SS2, SS3) containing
;; up to 90 bits.

;; If fac_size is 75 bits or more (the remainder is 76 bits or more), then
;; the squared remainder is more than 150 bits.  In this case, get the top
;; 90 bits from temp1 and temp3.

	IF fac_size GE 75

;; define BS (bit shift) = 2 * (fac_size - 74).  This is the amount to
;; shift temp1,temp3 reight to get the upper 90 bits for computing quotient.
;; BS ranges from 2 (fac_size = 75) to 30 (fac_size = 89).
;;
;; SS3 = (temp3 >> BS) & 0x3FFFFFFF			(30 bits)
;; SS2 = (temp3 >> 30+BS) +
;;	 ((temp1 & (mask to get BS bits)) << (30-BS))	(could be 31 bits)
;; SS1 = temp1 >> BS					(could be 31 bits)

	BS = 2 * (fac_size - 74)

	movdqa	xmm0, xmm5		;; SS3 = temp3
	psllq	xmm0, 64-(30+BS)	;; shift SS3 left
	psrlq	xmm0, 34		;; SS3 = (temp3 >> BS) & 0x3FFFFFFF
	psrlq	xmm5, 30+BS		;; SS2 = temp3 >> 30+BS
	movdqa	xmm1, xmm4		;; Copy temp1
	psllq	xmm1, 64-BS		;; Mask to get BS bits
	psrlq	xmm1, 34		;; (temp1 & mask) << (30-BS)
	paddd	xmm1, xmm5		;; SS2 += (temp1 & mask) << (30-BS)
	psrlq	xmm4, BS		;; SS1 = temp1 >> BS
	ENDIF

;; If fac_size if between 64 and 74, then there are enough bits in temp1,
;; temp3 to accurately compute the quotient.  For example, if fac_size is 64
;; and remainder is 64 bits, then rem_squared is 128 bits.  temp1 and temp3
;; contain 128 - 60 = 68 bits (enough to accurately compute a 64 bit quotient).

	IF fac_size GE 64 AND fac_size LE 74

;; SS3 = temp3 & 0x3FFFFFFF		(30 bits)
;; SS2 = (temp3 >> 30) & 0x3FFFFFFF	(30 bits)
;; SS1 = temp1 + (temp3 >> 60)		(30 bits)

	movdqa	xmm0, XMM_BITS30	;; mask to get 30 bits
	pand	xmm0, xmm5		;; SS3 = temp3 & 0x3FFFFFFF
	movdqa	xmm1, xmm5		;; SS2 = temp3
	psllq	xmm1, 4			;; Apply mask to get 30 bits
	psrlq	xmm1, 34		;; Shift left 30 bits
	psrlq	xmm5, 60		;; temp3 >> 60
	paddd	xmm4, xmm5		;; SS1 += temp3 >> 60
	ENDIF

;; If fac_size is less 64 bits, then we need to pull in some bits from
;; temp5 to get enough bits to compute quotient.  Pulling in 15 bits
;; from temp5 is more than enough.

	IF fac_size LE 63

;; SS3 = (temp5 >> (60 - 15)) +
;;	 ((temp3 & 0x7FFF) << 15)		(could be 31 bits)
;; SS2 = (temp3 >> 15) & 0x3FFFFFFF		(30 bits)
;; SS1 = (temp1 << 15) + (temp3 >> (30+15))	(less than 30 bits)

	movdqa	xmm0, xmm7		;; SS3 = temp5
	psrlq	xmm0, 60-15		;; SS3 = temp5 >> (60-15)
	movdqa	xmm3, xmm5		;; Copy temp3
	psllq	xmm3, 64-15		;; Apply mask to get 15 bits
	psrlq	xmm3, 34		;; ((temp3 & 0x7FFF) << 15)
	paddd	xmm0, xmm3		;; SS3 += ((temp3 & 0xFFFF) << 16)
	movdqa	xmm1, xmm5		;; SS2 = temp3
	psllq	xmm1, 64-(30+15)	;; mask SS2 to get just 30 bits
	psrlq	xmm1, 34		;; SS2 = (temp3 >> 15) & 0x3FFFFFFF
	psrlq	xmm5, 30+15		;; temp3 >> (30+15)
	psllq	xmm4, 15		;; SS1 = temp1 << 15
	paddd	xmm4, xmm5		;; SS1 += temp3 >> (30+15)
	ENDIF

;; The upper bits of rem squared are now in xmm4, xmm1, xmm0

;; Now take the upper bits of rem squared = SS1,SS2,SS3
;; and multiply it by 90 bits of 1/factor (I1, I2, I3).  This will
;; give us the quotient (shifted left somewhat).  We only need to
;; compute the upper 90 bits of the quotient.  
;;
;; temp3 = I3*SS1 + I2*SS2 + I1*SS3	(62)
;; temp2 =          I2*SS1 + I1*SS2	(61)
;; temp1 =                   I1*SS1	(60)
;;
;; temp2 += temp3 >> 30			(61)
;; temp1 += temp2 >> 30			(60)
;; temp2 &= 0x3FFFFFFF			(30)

	movdqa	xmm2, I1
	pmuludq	xmm0, xmm2		;; temp3 = I1 * SS3
	movdqa	xmm5, I3
	pmuldq	xmm5, xmm4		;; I3 * SS1
	paddq	xmm0, xmm5		;; temp3 += I3 * SS1
	movdqa	xmm5, xmm1		;; Copy SS2
	movdqa	xmm3, I2
	pmuludq	xmm1, xmm3		;; I2 * SS2
	pmuludq	xmm3, xmm4		;; temp2 = I2 * SS1
	pmuludq	xmm4, xmm2		;; temp1 = I1 * SS1
	pmuludq	xmm2, xmm5		;; I1 * SS2
	paddq	xmm0, xmm1		;; temp3 += I2 * SS2
	paddq	xmm3, xmm2		;; temp2 += I1 * SS2

	psrlq	xmm0, 30		;; temp3 >> 30
	paddq	xmm3, xmm0		;; temp2 += temp3 >> 30
	movdqa	xmm2, XMM_BITS30	;; mask to get 30 bits
	pand	xmm2, xmm3		;; new temp2 = temp2 & 0x3FFFFFFF
	psrlq	xmm3, 30		;; old temp2 >> 30
	paddq	xmm4, xmm3		;; temp1 += old temp2 >> 30

;; 90 bits of shifted quotient are now in xmm4, xmm2 (60, 30)


;; Shift the quotient right to compensate for the shift left done earlier
;; (to get enough bits of the upper portion of rem squared).
;;
;; define BS (bit shift amount). This is the amount to shift the quotient
;; xmm4, xmm2 right to compute the quotient.

;; Handle the large trial factors, there is always 90 bit in shifted quotient.
;; For example, fac_size = 75, rem_squared is 152 bits, quotient is 77 bits.
;; BS is 90 - 77.  

	IF fac_size GE 75
	BS = 88 - fac_size
	ENDIF

;; Handle the medium trial factors.
;; For example, fac_size = 64, rem_squared is 130 bits, quotient is 66 bits.
;; Shifted quotient was 130 - 60 bits.  BS is 70 - 66.

	IF fac_size GE 64 AND fac_size LE 74
	BS = fac_size - 60
	ENDIF

;; Handle the small trial factors.
;; For example, fac_size = 61, rem_squared is 124 bits, quotient is 63 bits.
;; Shifted quotient was 124 - 45 bits.  BS is 79 - 63.

	IF fac_size GE 64 AND fac_size LE 74
	BS = fac_size - 45
	ENDIF

;; Now shift right to get the quotient
;;
;; Q3 = (temp2 >> BS) |
;;      (temp1 & mask to get BS bits) << (30-BS)	(30)
;; Q2 = (temp1 >> BS) & 0x3FFFFFFF			(30)
;; Q1 = temp1 >> (30 + BS)

	movdqa	xmm0, xmm4		;; Copy temp1
	psrlq	xmm2, BS		;; temp2 >> BS
	psllq	xmm0, 64-BS		;; shift to get BS bits
	psrlq	xmm0, 34		;; (BS bits of temp1) << (30-BS)
	por	xmm0, xmm2		;; Q3
	movdqa	xmm1, xmm4		;; Copy temp1
	psllq	xmm1, 64-(30+BS)	;; mask to get middle 30 bits
	psrlq	xmm1, 34		;; Q2 = (temp1 >> BS) & 0x3FFFFFFF
	psrlq	xmm4, 30+BS		;; Q1 = temp1 >> (30 + BS)
	
;; quotient is now in xmm4, xmm1, xmm0


;; Multiply quotient Q1,Q2,Q3 factor F1,F2,F3
;; Only compute bottom 90 bits.
;;
;; temp1 = F3*Q3				(60)
;; temp2 = F3*Q2 + F2*Q3			(61)
;; temp1 = F3*Q1 + F2*Q2 + F1*Q3		(61)
;;
;; QF2 = temp1+((temp2 & 0x3FFFFFFF)<<30)	(61)
;; QF1 = temp1 + (temp2 >> 30)			(61)

	movdqa	xmm2, F3
	pmuludq	xmm4, xmm2		;; temp1 = F3 * Q1
	movdqa	xmm5, F1
	pmuldq	xmm5, xmm0		;; F1 * Q3
	paddq	xmm4, xmm5		;; temp1 += F1 * Q3
	movdqa	xmm5, xmm1		;; Copy Q2
	pmuludq	xmm1, xmm2		;; temp2 = F3 * Q2
	pmuludq	xmm2, xmm0		;; temp1 = F3 * Q3
	movdqa	xmm3, F2
	pmuludq	xmm0, xmm3		;; F2 * Q3
	pmuludq	xmm3, xmm5		;; F2 * Q2
	paddq	xmm1, xmm0		;; temp2 += F2 * Q3
	paddq	xmm4, xmm3		;; temp1 += F2 * Q2

	movdqa	xmm0, XMM_BITS30	;; mask to get 30 bits
	pand	xmm0, xmm1		;; temp2 & 0x3FFFFFFF
	psllq	xmm0, 30		;; (temp2 & 0x3FFFFFFF) << 30
	paddq	xmm2, xmm0		;; QF2 = temp1 + (temp2&0x3FFFFFFF)<<30
	psrlq	xmm1, 30		;; temp2 >> 30
	paddq	xmm4, xmm1		;; QF1 = temp1 + temp2 >> 30

;; Subtract QF1,QF2 from S3,S4
;;
;; temp2 = S4 - QF2			(signed 62)
;; temp1 = S3 - QF1			(signed 62)

	psubq	xmm7, xmm2		;; temp2 = S4 - QF2
	psubq	xmm6, xmm4		;; temp1 = S3 - QF1

;; If mul by 2 is required:  mul temp2,temp1 by 2 here!!

	cmp	something
	je	short nomul2
	psllq	xmm7, 1			;; temp2 *= 2
	psllq	xmm6, 1			;; temp1 *= 2
nomul2:

;; Break remainder into 30 bit quantities.
;;
;; RES3 = temp2 & 0x3FFFFFFF		(30)
;; temp2 >>= 30				(signed 32)
;; RES2 = temp2 & 0x3FFFFFFF		(30)
;; temp2 >>= 30				(signed 2)
;; temp1 += temp2
;; RES1 = temp1 & (mask fac_size-60+2)	(30)

	movdqa	xmm2, XMM_BITS30	;; Mask to get 30 bits
	pand	xmm2, xmm7		;; RES3 = temp2 & 0x3FFFFFFF
	psrlq	xmm7, 30		;; temp2 >>= 30
	movdqa	xmm1, XMM_BITS30	;; Mask to get 30 bits
	pand	xmm1, xmm7		;; RES2 = temp2 & 0x3FFFFFFF
	psrlq	xmm7, 30		;; temp2 >>= 30
	paddd	xmm6, xmm7		;; temp1 += temp2
	movdqa	xmm0, XMM_BITS??	;; Mask to get fac_size-60+2 bits
	pand	xmm0, xmm6		;; RES1 = temp1 & (mask fac_size-60+2)
	ENDM

