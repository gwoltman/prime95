# Makefile for prime95's 32-bit factoring code on Linux and FreeBSD
#
# Builds linux/factor32.o, which linux/makefile and linux/makebsd link with.
# It does what the factor32 rule in compile does on Windows: uasm assembles
# factor32.asm to a 32-bit COFF object and objconv converts it to ELF.
#
# Needs uasm 2.58 with the fix from https://github.com/gwoltman/UASM-2.58-gw1,
# and objconv.  See BUILDING.md.
#	make -f makeasm32 UASM=~/tools/uasm OBJCONV=~/tools/objconv

UASM = uasm
OBJCONV = objconv
# uasm reads extra command line arguments from an environment variable named
# UASM, so don't pass this variable to the commands below
unexport UASM
UASMFLAGS = -c -nologo -coff -safeseh -I../gwnum

OUT = linux

#########################################################################

all:	$(OUT)/factor32.o

$(OUT)/factor32.o: $(OUT)/factor32.obj
	$(OBJCONV) -felf32 $< $@

$(OUT)/factor32.obj: factor32.asm factor32.mac ../gwnum/unravel.mac | $(OUT)
	$(UASM) $(UASMFLAGS) -Fo$@ factor32.asm

$(OUT):
	mkdir -p $(OUT)

clean:
	rm -f $(OUT)/factor32.obj

distclean: clean
	rm -f $(OUT)/factor32.o

.PHONY: all clean distclean
.SECONDARY:
