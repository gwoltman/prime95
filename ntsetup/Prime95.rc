IDD_ABOUTBOX DIALOGEX 0, 0, 238, 63
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Setup for NT Service version of Prime95"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "NTPrime Setup - Version 22.5.5",IDC_STATIC,40,12,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright © 1996-2002 Just For Fun Software, Inc.",
                    IDC_STATIC,39,22,154,8
    DEFPUSHBUTTON   "OK",IDOK,199,7,32,14,WS_GROUP
    LTEXT           "Author: George Woltman",IDC_STATIC,39,32,128,8
    LTEXT           "Email:  woltman@alum.mit.edu",IDC_STATIC,39,42,161,8
END

IDD_CPU DIALOGEX 0, 0, 227, 151
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CPU Settings and Information"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "&Hours per day this program will run:",IDC_STATIC,7,7,
                    117,10
    EDITTEXT        IDC_HOURS,125,8,37,12
    LTEXT           "&Daytime available memory  (in MB):",IDC_STATIC,7,41,
                    115,10
    EDITTEXT        IDC_DAY_MEMORY,125,40,37,12
    LTEXT           "&Nighttime available memory  (in MB):",IDC_STATIC,7,54,
                    117,10
    EDITTEXT        IDC_NIGHT_MEMORY,125,54,37,12
    LTEXT           "Daytime &begins:",IDC_STATIC,7,68,53,10
    EDITTEXT        IDC_START_TIME,61,66,37,12,ES_AUTOHSCROLL
    LTEXT           "end&s:",IDC_STATIC,102,69,20,10
    EDITTEXT        IDC_END_TIME,125,67,37,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,170,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,170,24,50,14
    LTEXT           "Please see the readme.txt file for very important information on the available memory settings.",
                    IDC_STATIC,7,19,155,16
    GROUPBOX        "CPU Information",IDC_STATIC,7,84,213,60
    LTEXT           "",IDC_CPU_INFO,14,95,200,43
END

