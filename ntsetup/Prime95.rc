END

IDD_VACATION DIALOGEX 0, 0, 249, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vacation or Holiday Absence"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "&Days of vacation:",-1,7,65,59,8
    EDITTEXT        IDC_DAYS,67,63,33,13,ES_AUTOHSCROLL
    CONTROL         "&Computer will be on during your absence",IDC_CHECK1,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,79,159,10
    DEFPUSHBUTTON   "OK",IDOK,192,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,192,24,50,14
    LTEXT           "If you are going on vacation and your computer will not be running or your computer will not be connected to the Internet, then the PrimeNet server must be informed of new expected completion dates.",
                    -1,7,7,179,33
    LTEXT           "Please make sure you are connected to the Internet long enough to send the new completion dates.",
                    -1,7,43,202,19
END

IDD_MANUAL_COMM DIALOG  0, 0, 238, 51
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Manual PrimeNet Communication"
