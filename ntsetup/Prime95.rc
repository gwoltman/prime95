/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\Prime95.ico"
IDI_YELLOW_ICON         ICON                    "res\\yellow_i.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Test"
    BEGIN
        MENUITEM "&PrimeNet...",                IDM_PRIMENET
        MENUITEM "P-&1...",                     IDM_PMINUS1
        MENUITEM "&ECM...",                     IDM_ECM
        MENUITEM SEPARATOR
        MENUITEM "&User Information...",        ID_RANGE_USERINFORMATION
        MENUITEM "&Vacation or Holiday...",     IDM_VACATION
        MENUITEM "&Status...",                  ID_RANGE_STATUS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&CPU...",                     IDM_CPU
        MENUITEM "&Preferences...",             IDM_PREFERENCES
        MENUITEM "Priorit&y...",                IDM_PRIORITY
        MENUITEM "&Affinity...",                IDM_AFFINITY
        MENUITEM "&Manual Communication...",    IDM_MANUALCOMM
        MENUITEM "&Quit GIMPS...",              IDM_QUIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics",                ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "&About NTSetup...",           ID_APP_ABOUT
        MENUITEM "About PrimeNet &Server...",   IDM_SERVER
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    VK_ESCAPE,      IDM_STOP,               VIRTKEY, NOINVERT
    VK_F1,          ID_HELP,                VIRTKEY, NOINVERT
    VK_F1,          ID_CONTEXT_HELP,        VIRTKEY, SHIFT, NOINVERT
END


