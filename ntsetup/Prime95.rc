                    9,117,10
    EDITTEXT        IDC_R_ITER,128,7,38,12
    LTEXT           "Minutes between &disk writes:",IDC_STATIC,7,22,92,10
    EDITTEXT        IDC_DISK,128,20,38,12
    LTEXT           "Minutes between &modem retries:",IDC_MODEM_TEXT,7,35,
                    109,10
    EDITTEXT        IDC_MODEM,127,33,38,12
    LTEXT           "Minutes between &network retries:",IDC_NETWORK_TEXT,7,
                    48,109,10
    EDITTEXT        IDC_NETWORK,128,46,38,12
    LTEXT           "Days between sending &end dates:",IDC_END_DATES_TEXT,7,
                    61,109,10
    EDITTEXT        IDC_END_DATES,128,59,38,12
    CONTROL         "&Create Two Backup Files",IDC_BACKUP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,74,107,10
    CONTROL         "Make noise if new Mersenne &prime is found",IDC_NOISE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,87,152,10
    DEFPUSHBUTTON   "OK",IDOK,173,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,173,24,50,14
END

IDD_USER DIALOGEX 0, 0, 278, 144
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "End User Information"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Your &name:",IDC_NAME_TEXT,7,9,65,10
    EDITTEXT        IDC_NAME,72,7,145,12,ES_AUTOHSCROLL
    LTEXT           "Your &email address:",IDC_STATIC,7,23,64,8
    EDITTEXT        IDC_EMAIL,72,21,145,12,ES_AUTOHSCROLL
    CONTROL         "&Receive email from PrimeNet server if exponents are about to expire",
                    IDC_SENDEMAIL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,38,
                    236,10
    LTEXT           "Your user &ID:",IDC_ID_TEXT,7,73,50,10
    EDITTEXT        IDC_USERID,74,71,64,12,ES_AUTOHSCROLL
    LTEXT           "Your &password:",IDC_PWD_TEXT,7,87,61,8
    EDITTEXT        IDC_PASSWORD,74,85,64,12,ES_AUTOHSCROLL
    LTEXT           "Your &computer ID:",IDC_STATIC,7,101,64,8
    EDITTEXT        IDC_COMPID,74,99,64,12,ES_AUTOHSCROLL
    CONTROL         "Create a team using the information above.  &Team accounts are protected by the PrimeNet server against unintentional or unauthorized changes.",
                    IDC_TEAM,"Button",BS_AUTOCHECKBOX | BS_MULTILINE | 
                    WS_TABSTOP,7,114,264,20
    DEFPUSHBUTTON   "OK",IDOK,221,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,221,22,50,14
    LTEXT           "You can either pick your own user ID, password, and computer ID or let the PrimeNet server assign one to you.  See the readme.txt file for details.",
                    IDC_STATIC,7,51,264,19
END

IDD_PRIMENET DIALOGEX 0, 0, 281, 121
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configure PrimeNet"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    CONTROL         "Use &PrimeNet to get work and report results",
                    IDC_PRIMENET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,7,
                    153,10
    CONTROL         "Use a dial-up &connection to the Internet",IDC_DIALUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,19,153,10
    LTEXT           "Always have at least this many days of &work queued up:",
                    IDC_WORK_TEXT,7,31,180,10
    EDITTEXT        IDC_WORK,188,30,29,12
    CONTROL         "Request whatever type of work makes the most &sense",
                    IDC_WORK_DFLT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,42,
                    186,10
    CONTROL         "Request &10,000,000 digit numbers to test",IDC_BIGONES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,66,192,10
    CONTROL         "Request Mersenne numbers to run primality &tests",
                    IDC_LL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,78,190,
                    10
    CONTROL         "Request Mersenne numbers to &double-check",IDC_DBLCHK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,90,189,10
    CONTROL         "Request Mersenne numbers to &factor",IDC_FACTOR,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,13,102,190,10
    DEFPUSHBUTTON   "OK",IDOK,224,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,224,24,50,14
    GROUPBOX        "Types of work to request from server",IDC_WORKGROUP,7,
                    55,212,59
END

IDD_PRIORITY DIALOGEX 0, 0, 221, 121
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Set Priority"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "Priority:",IDC_STATIC,7,98,22,8
    EDITTEXT        IDC_PRIORITY,39,95,40,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,164,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,164,24,50,14
    LTEXT           "Pick a priority between 1 and 10 where 1 is the lowest priority and 10 is the highest.  Screen savers run at priority 4.  Most applications run at priority 9.",
                    IDC_STATIC,7,7,151,35
    LTEXT           "It is strongly recommended that you use the default priority of 1.  This program is unlikely to run any faster at a higher priority.",
                    IDC_STATIC,7,43,202,19
    LTEXT           "The only time you should raise the priority is when another process, such as a screen saver, is stealing CPU cycles from this program.",
                    IDC_STATIC,7,66,200,26
END

