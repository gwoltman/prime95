; Copyright 2011 - Mersenne Research, Inc.  All rights reserved
; Author:  George Woltman
; Email: woltman@alum.mit.edu
;
; These macros do the first pass of an AVX primarily radix-4 DJB "r4dwpn" FFT.
;

; ********************************************************
; ********************************************************
; ******************  PASS 1 MACROS  *********************
; ********************************************************
; ********************************************************

;;
;; Estimated memory requirements for each real pass 1 macro:
;;
;; Pass 1 size:			128	256	320	384	448	512	640	768	896	1024	1280	1536	1792	2048	2560	3072	3584	4096
;;
;; FFT data:			16K	32K	40K	48K	56K	64K	80K	96K	112K	128K	160K	192K	224K	256K	320K	384K	448K	512K
;; Scratch size:		16K	32K	40K	48K	56K	64K	80K	96K	112K	128K	160K	192K	224K	256K	320K	384K	448K	512K
;; Variable sin/cos data:	11.5K	23K	17.5K	19K	21.5K	23.5K	35K	39K	43K	47K	33.5K	31.5K	46.5K	48.5K	73K	63K	75K	79K
;; Fixed sin/cos data:		1.5K	1.5K	4.5K	4.5K	6.5K	6K	9K	9K	13K	16K	18K	18K	26K	32K	36K	48K	52K	64K
;; Normalization data:		5K	5K	12.5K	15K	17.5K	20K	12.5K	15K	17.5K	20K	25K	60K	17.5K	20K	50K	60K	70K	80K
;; Big/lit flags:		0.5K	1K	1.25K	1.5K	1.75K	2K	2.5K	3K	3.5K	4K	5K	6K	7K	8K	10K	12K	14K	16K
;; Data prefetched early:	8K	16K	16K	12K	16K	16K	32K	24K	32K	32K	16K	0K	64K	0K	32K	0K	128K	0K
;;
;; Min L2 cache size (clm=4):	86K	165.5K	189.25K	216K	252.75K	283K	366K	417K	488K	550K	611K	723K	879.5K	928K	1234K	1398K	1758K	1858K
;;     L2 cache size (clm=2):		86K	103.13K	117.75K	138.38K	154.5K	193.75K	220.5K	259.25K	293K	327K	400.5K	461.5K	488.5K	660K	753K	940K	999K
;;     L2 cache size (clm=1):		46.25K	60K	68.63K	81.25K	90.25K	107.63K	122.25K	144.88K	164.5K	185K	239.25K	252.5K	270.25K	373K	430.5K	531K	571.5K
;;
;; NOTE:  To calculate the minimum efficient L2 cache size, we double the
;; data and variable sin/cos data sizes as both the current data
;; and next block data will be in the cache at the same time.  Any data
;; prefetched early (during the inverse FFT process) runs the danger of
;; pushing out the fixed sin/cos data and normalization data because of the
;; LRU cache-eviction algorithm.  The L2 cache size formula is:
;;	(FFT data size + Variable sin/cos data) * 2 +
;;	(Scratch size + Fixed sin/cos data + Normalization data + big/lit data) +
;;	(amount of data prefetched during inverse FFT process)
;; ALSO NOTE:  Numbers above are for clm = 4.  Clm affects the FFT data size,
;; scratch size, variable sin/cos size, big/lit flags, and data prefetched early.

;; Estimated memory requirements for each all-complex pass 1 macro:
;;
;; Pass 1 size:			128	256	384	512	640	768	1024	1280	1536	2048	2560	3072	4096	5120
;;
;; FFT data:			16K	32K	48K	64K	80K	96K	128K	160K	192K	256K	320K	384K	512K	640K
;; Scratch size:		16K	32K	48K	64K	80K	96K	128K	160K	192K	256K	320K	384K	512K	640K
;; Variable sin/cos data:	8K	12K	11.5K	16K	16K	24K	32K	32K	24K	34K	28K	48K	56K	56K
;; Fixed sin/cos data:		5K	5K	9K	12K	15K	18K	24K	30K	39K	52K	65K	78K	104K	130K
;; Normalization data:		5K	5K	15K	20K	25K	15K	20K	25K	60K	20K	100K	60K	80K	100K
;; Big/lit flags:		0.5K	1K	1.5K	2K	2.5K	3K	4K	5K	6K	8K	10K	12K	16K	20K
;; Data prefetched early:	8K	16K	12K	16K	10K	24K	32K	20K	0K	0K	0K	0K	0K	0K
;;
;; Min L2 cache size (clm=4):	82.5K	147K	205.5K	274K	324.5K	396K	528K	624K	729K	916K	1191K	1398K	1848K	2282K
;;     L2 cache size (clm=2):	46.25K	78.5K	114.75K	153K	182.25K	214.5K	286K	339.5K	414K	494K	678K	768K	1016K	1060K
;;     L2 cache size (clm=1):		44.25K	69.38K	92.5K	111.13K	123.75K	165K	197.25K	256.5K	283K	421.5K	453K	600K	645K


;; Constant to control when we group pass 1 sections.  Sandy Bridge CPUs have a 32KB L1 data cache.
;; We're guessing grouping isn't necessary when pass 1 data is less than 24KB.  We need to tune this!

GROUPING_SIZE = 24*1024 *1000
CLM_GROUPING = 2

;;***********************************************************************
;; Pass 1 macros
;;
;; p2cl = number of 128-byte cache lines processed from a pass 2 block
;; clm = cache line multiplier (num cache lines processed each iteration)
;;***********************************************************************

; Note:  All memory layouts are for 64 byte cache lines.


;; Perform a pass 1 FFT of length 128 doubles.
;; Memory examples are for a 128K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 = 44*clm 64-byte cache lines

yr4dwpn_pass1sc128 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b6b, b7b, b8b, b9b, c0b, c1b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 128, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 128K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 15 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 3.75 macros each processing 32 data values

c0b:	start_timer 16
	mov	rbp, DATA_ADDR		;; Get source address
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]	;; Complex data sin/cos ptr
pfing	lea	rcx, [rdx+(44-16)*clm*64] ;; Finish prefetch the sin/cos/premult data
	loops_init_prefetch 4*4*clm, 64, 1, rcx ;; 4*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	clm, c8b		;; Loop clm times
	bump	rbp, -clm*64+4*blkdst	;; Next source pointer
	bump	rsi, -clm*256+clmblkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	clm, c9b		;; Loop clm times
	bump	rbp, -clm*64+4*blkdst	;; Next source pointer
	bump	rsi, -clm*256+clmblkdst ;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b			;; Test loop counter
	bump	rdi, clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	2, c9b			;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, c9b
	bump	rsi, -2*clmblkdst8	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 12 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 3 macros each processing 32 data values

	start_timer 17
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 4*4*clm		;; 4*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloop	2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloop	2, c7b, -2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	loops_init 4*4*clm		;; 4 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	4, c1b			;; 4 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 16
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 16

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 32 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, 8*4*blkdst		;; We've already prefetched 8 blocks
	loops_init 4*4*clm		;; 4 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -4*clmblkdst	;; 4 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 12 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 3 macros each processing 32 data values

	start_timer 25
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD2 + 4*clm*YMM_SCD4 ;; sin/cos ptr
	loops_init 4*4*clm		;; 4 iterations of 4*clm
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, b6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos ptr

	loops_reset
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, b7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos ptr
	yloop	2, b7b, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter, next source pointer
	yloop	2, b7b,	-2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 25

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 15 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 3.75 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4	;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2] ;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 4*4*clm, 128, 1, rcx ;; 4 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	clm, b8b		;; clm iterations
	bump	rsi, -clm*256+clmblkdst ;; Next source pointer
	bump	rbp, -clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 128 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 128 doubles.
;; Memory examples are for a 128K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4 = 30*clm 64-byte cache lines

yr4dwpn_pass1sc128ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b7b, b9b, c0b, c1b, c7b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 128, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 128K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 16 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 4 macros each processing 32 data values

c0b:	start_timer 16
	mov	rbp, DATA_ADDR		;; Get source address
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rcx, [rdi+(30-16)*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 4*4*clm, 64, 1, rcx ;; 4*4*clm iterations
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	clm, c9b		;; Loop clm times
	bump	rbp, -clm*64+4*blkdst	;; Next source pointer
	bump	rsi, -clm*256+clmblkdst ;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b			;; Test loop counter
	bump	rdi, clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	2, c9b			;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, c9b
	bump	rsi, -2*clmblkdst8	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	start_timer 17
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 4*4*clm		;; 4*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	yloop	2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloop	2, c7b,	-2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...

;; Do 16 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed premultiplier/sin/cos ptr
	loops_init 4*4*clm		;; 4 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	4, c1b			;; 4 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 16
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 16

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 four_complex_first_fft operations
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 32 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, 8*4*blkdst		;; We've already prefetched 8 blocks
	loops_init 4*4*clm		;; 4 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -4*clmblkdst	;; 4 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	start_timer 25
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 4*clm*YMM_SCD4
	loops_init 4*4*clm		;; 4 iters of 4*clm
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop	4*clm, b7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos ptr
	yloop	2, b7b, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter, next source pointer
	yloop	2, b7b, -2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 25

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 4 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4	;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 4*4*clm, 64, 1, rcx ;; 4 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 128 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 256 doubles.
;; Memory examples are for a 256K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 2*4*clm*YMM_SCND4 + clm*YMM_SCD4 + 4*clm*YMM_SCD8 = 88*clm 64-byte cache lines

yr4dwpn_pass1sc256 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b6b, b7b, b8b, b9b, c0b, c1b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 256, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 256K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 6,7,8
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 15 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 3.75 macros each processing 64 data values

c0b:	start_timer 16
	mov	rbp, DATA_ADDR		;; Get source address
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD4]	;; Complex data sin/cos ptr
pfing	lea	rcx, [rdx+(88-32)*clm*64] ;; Finish prefetch the sin/cos/premult data
	loops_init_prefetch 4*4*clm, 128, 1, rcx ;; 4*4*clm iterations
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	clm, c8b		;; Loop clm times
	bump	rbp, -clm*64+8*blkdst	;; Next source pointer
	bump	rsi, -clm*256+2*clmblkdst ;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	clm, c9b		;; Loop clm times
	bump	rbp, -clm*64+8*blkdst	;; Next source pointer
	bump	rsi, -clm*256+2*clmblkdst ;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	4, c9b			;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8 ;; Next dest pointer
	bump	rdi, clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	4, c9b
	bump	rsi, -4*clmblkdst8	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 2 macro processing 32 data values
;; Do 24 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 6 macros each processing 32 data values

	start_timer 17
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 8*4*clm		;; 8*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+clmblkdst	 ;; 4*clm iterations
	yloop	2, c6b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	 ;; 4*clm iterations
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, restore sin/cos pointer
	yloop	4, c7b, -4*clmblkdst8		;; Test loop counter, restore source pointer
	end_timer 17

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...

;; Do 32 eight_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	loops_init 8*4*clm		;; 8 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	8, c1b			;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 32
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 32

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	64K	...
;;	...

;; Do 32 eight_reals_fft operations
;;	distance between fft data elements is 32K
;;	do 8 iterations each processing 32 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, 16*4*blkdst	;; We've already prefetched 16 blocks
	loops_init 8*4*clm		;; 8 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst	;; 8 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 8 eight_reals_fft operations
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 32 data values
;; Do 24 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 6 macros each processing 32 data values

	start_timer 25
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD4 + 4*clm*YMM_SCD8 ;; sin/cos ptr
	loops_init 8*4*clm		;; 8 iterations of 4*clm
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, b6b, -4*clm*64+clmblkdst	;; 4*clm iterations
	yloop	2, b6b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, restore sin/cos ptr

	loops_reset
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4		;; Next sine/cosine pointer
	yloop	4*clm, b7b, -4*clm*64+clmblkdst	;; 4*clm iterations
	yloop	2, b7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, restore sin/cos ptr
	yloop	4, b7b,	-4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 25

;; Do FFT levels 6,7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 15 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 3.75 macros each processing 64 data values

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD8	;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 4*4*clm, 128, 1, rcx ;; 4 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	clm, b8b		;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst ;; Next source pointer
	bump	rbp, -clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst ;; Next source pointer
	bump	rbp, -clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 256 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 256 doubles.
;; Memory examples are for a 256K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 2*4*clm*YMM_SCND2 + 4*clm*YMM_SCD8 = 60*clm 64-byte cache lines

yr4dwpn_pass1sc256ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b7b, b9b, c0b, c1b, c7b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 256, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 256K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 6,7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 16 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 4 macros each processing 64 data values

c0b:	start_timer 16
	mov	rbp, DATA_ADDR		;; Get source address
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rcx, [rdi+(60-32)*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 4*4*clm, 128, 1, rcx ;; 4*4*clm iterations
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	clm, c9b		;; Loop clm times
	bump	rbp, -clm*64+8*blkdst	;; Next source pointer
	bump	rsi, -clm*256+2*clmblkdst ;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	4, c9b			;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8 ;; Next dest pointer
	bump	rdi, clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	4, c9b
	bump	rsi, -4*clmblkdst8	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 32 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	start_timer 17
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 8*4*clm		;; 8*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND2 ;; Loop, restore sin/cos pointer
	yloop	4, c7b,	-4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...

;; Do 32 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed premultiplier/sin/cos ptr
	loops_init 8*4*clm		;; 8 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	8, c1b			;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 32
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 32

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 32 four_complex_first_fft operations
;;	distance between fft data elements is 32K
;;	do 8 iterations each processing 32 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, 16*4*blkdst	;; We've already prefetched 16 blocks
	loops_init 8*4*clm		;; 8 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst	;; 8 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 32 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	start_timer 25
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 4*clm*YMM_SCD8
	loops_init 8*4*clm		;; 8 iters of 4*clm
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop	4*clm, b7b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloop	2, b7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND2 ;; Loop, restore sin/cos ptr
	yloop	4, b7b, -4*clmblkdst8		;; Test loop counter, restore source pointer
	end_timer 25

;; Do FFT levels 6,7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 16 eight_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 4 macros each processing 64 data values

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD8	;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 4*4*clm, 128, 1, rcx ;; 4 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst ;; Next source pointer
	bump	rbp, -clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	4, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 256 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 320 doubles.
;; Memory examples are for a 320K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 10*clm*YMM_SCD4 = 68*clm 64-byte cache lines

yr4dwpn_pass1sc320 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b6b, b7a, b7b, b8b, b9a, b9b, c0b, c1b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 320, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 320K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 39 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 9.75 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 36 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 9 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (40*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 10*4*clm			;; 10*4*clm iterations
	lea	rbx, [rdi+10*clm*YMM_SCD4]	;; Sin/cos ptr

	start_timer 16
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst, rdi, clm*YMM_SCD4 ;; Test loop counter, restore scratch area pointer, next sin/cos pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre 4*clm, c6b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
c7c:	end_timer 17

	yloopdoublepre 2, c9a, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopdoublepre 5, c9a, -5*clmblkdst8	;; Test loop counter, restore source pointer

ELSE

	start_timer 16
	loops_init 10*4*clm			;; 10*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next sin/cos pointer
	yloopnopre 2, c9b, -8*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopnopre 5, c9b, -5*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 10*4*clm			;; 10*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre 4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloopdoublepre 2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloopdoublepre 5, c7b, -5*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	160K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	156K	...

;; Do 16 twenty_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 80 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	loops_init 4*4*clm		;; 4 iterations of 4*clm
	yr5_10cl_20_reals_unfft_preload
c1b:	yr5_10cl_20_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloopdoublepre 4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD9 ;; 4*clm iterations
	yloopdoublepre 4, c1b		;; 4 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 40
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 40

;; Do FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	160K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	156K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 twenty_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 80 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (26-2)*4*blkdst	;; We've already prefetched 26 blocks which will be 2 too many
	loops_init 4*4*clm		;; 4 iters of 4*clm
	yr5_10cl_20_reals_fft_preload
b1b:	yr5_10cl_20_reals_fft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloopquadpre 4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD9 ;; 4*clm iters
	yloopquadpre 4, b1b, -4*clmblkdst ;; 4 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 36 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 9 macros each processing 32 data values

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 39 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 9.75 macros each processing 32 data values

IF (40*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+10*clm*YMM_SCD4]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 10*4*clm, 64, 1, rcx ;; 10 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 10*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 4*clm

	start_timer 26
	loops_set_prefetch 64, 10*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx, rdx
	bump	rbx, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(68-39)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 36*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
b9a:	loops_set_prefetch 64, 1, rdx		;; Prefetch 39*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	end_timer 26

	loops	2, b7a				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	5, b7a				;; Test loop counter

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD2 + 10*clm*YMM_SCD4 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 10*4*clm, 64, 1, rcx ;; 10 iterations of 4*clm
	loops_set_prefetch 64, 10*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 36*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	5, b7b				;; Test loop counter
	bump	rsi, -5*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -10*clm*YMM_SCD4		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 10*4*clm, 64, 1, rcx ;; 10 iters of 4*clm
	loops_set_prefetch 64, 10*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 39*clm cache lines
pfing	bump	rcx, (68-36-39)*clm*64		;; Finish prefetch the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	2, b9b				;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8	;; Next source pointer
	loops	5, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 320 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 384 doubles.
;; Memory examples are for a 384K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*4*clm*YMM_SCD2 + 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 = 76*clm 64-byte cache lines

yr4dwpn_pass1sc384 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b4b, b5b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c4a, c4b, c5b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 384, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 384K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 47 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 11.75 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 44 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 11 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 12*4*clm			;; 12*4*clm iterations
	lea	rbx, [rdi+4*clm*YMM_SCD4]	;; Second sin/cos ptr

	start_timer 16
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst		;; Test loop counter, restore scratch area pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
c7c:	end_timer 17

	yloopnopre 3, c9a, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next sin/cos pointer
	yloopnopre 4, c9a, -12*4*clmblkdst	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+4*clm*YMM_SCND4]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 12*4*clm			;; 12*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 12, c9b, 0, rdi, clm*YMM_SCD4 ;; Test loop counter, next sin/cos pointer
	yloopnopre 4, c9b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 12*4*clm			;; 12*4*clm iterations
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloop	12, c7b, -12*4*clmblkdst, rdi, 4*clm*YMM_SCND4 ;; Test loop counter, restore source pointer, next sin/cos ptr
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...

;; Do 16 six_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macro processing 24 data values
;; Do 48 three_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 24 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	192K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	188K	...

;; Do 48 eight_reals_unfft operations
;;	distance between fft data elements is 48K
;;	do 12 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, sincos2			;; Load fixed sin/cos data ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
	loops_init 16*4*clm			;; 16 or 12 iters of 4*clm

c4a:	start_timer 18
	yr3_3cl_csc_six_reals_unfft_preload
c4b:	yr3_3cl_csc_six_reals_unfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c4b, -4*clm*64+12*clmblkdst, rdi, -4*clm*YMM_SCD2 ;; Test loop counter

	loops_reset
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c5b, -4*clm*64+12*clmblkdst, rdi, -4*clm*YMM_SCD2 ;; Test loop counter
	yloophalfpre 4, c5b, -4*12*clmblkdst, rdi, 4*clm*YMM_SCD2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
	loops_reset 4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rbx
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rbx, 4*YMM_SCD3 ;; Test loop counter
	yloop	4, c1b, -3*4*clmblkdst+clmblkdst, rbx, -3*4*YMM_SCD3+YMM_SCD3 ;; 3 iterations!! next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c4a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr3_3cl_csc_six_reals_unfft_preload
c4b:	yr3_3cl_csc_six_reals_unfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 4, c4b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos pointer

	loops_reset
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 4, c5b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; 4 iterations, restore sine/cosine pointer
	yloophalfpre 4, c5b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	loops_init 12*4*clm			;; 12 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	12, c1b				;; Test loop counter
	end_timer 20
ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 48
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 48

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	192K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	188K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...

;; Do 48 eight_reals_fft operations
;;	distance between fft data elements is 48K
;;	do 12 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 six_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 24 data values
;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 24 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 32*4*blkdst		;; We've already prefetched 32 blocks

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rbx, 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 ;; Create second sin/cos ptr
	loops_init 16*4*clm			;; 12 or 16 iters of 4*clm

b1a:	start_timer 22
	loops_reset 4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -3*4*clmblkdst, rdi, -3*4*YMM_SCD3+YMM_SCD3 ;; Loop 3 times!! restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr3_3cl_csc_six_reals_fft_preload
b4b:	yr3_3cl_csc_six_reals_fft rsi, 64, 4*clmblkdst, rbx
	bump	rbx, YMM_SCD2
	yloopquarterpre 4*clm, b4b, -4*clm*64+12*clmblkdst, rbx, -4*clm*YMM_SCD2 ;; 4*clm iterations

	loops_reset
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, 4*clmblkdst, rbx
	bump	rbx, YMM_SCD2
	yloopquarterpre 4*clm, b5b, -4*clm*64+12*clmblkdst, rbx, -4*clm*YMM_SCD2 ;; 4*clm iterations
	yloopquarterpre 4, b5b, -4*12*clmblkdst+clmblkdst, rbx, 4*clm*YMM_SCD2 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer
	lea	rdi, [rbx-4*4*clm*YMM_SCD2]	;; Restore sin/cos ptr

ELSE

	start_timer 22
	loops_init 12*4*clm			;; 12 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	12, b1b, -12*clmblkdst		;; Loop, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 ;; Sin/cos ptr
	loops_init 16*4*clm			;; 16 iterations of 4*clm
	yr3_3cl_csc_six_reals_fft_preload
b4b:	yr3_3cl_csc_six_reals_fft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloopquarterpre 4*clm, b4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, b4b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr

	loops_reset
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2
	yloopquarterpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, b5b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 24

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 44 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 11 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 47 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 11.75 macros each processing 32 data values

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	bump	rdi, -4*clm*YMM_SCND4		;; Premultiplier/sin/cos ptr
	lea	rbx, [rdi-4*clm*YMM_SCD4]	;; Complex data sin/cos ptr
	lea	rdx, [rbx-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 12*4*clm, 64, 1, rcx ;; 12 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 12*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 4*clm

	start_timer 26
	loops_set_prefetch 64, 12*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx, rdx
	bump	rbx, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(76-47)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 44*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
b9a:	loops_set_prefetch 64, 1, rdx		;; Prefetch 47*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

	loops	3, b7a				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	bump	rdi, -4*clm*YMM_SCND4		;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 12*4*clm, 64, 1, rcx ;; 12 iterations of 4*clm
	loops_set_prefetch 64, 12*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 44*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	12, b7b				;; Test loop counter
	bump	rsi, -12*4*clmblkdst		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 12*4*clm, 64, 1, rcx ;; 12 iters of 4*clm
	loops_set_prefetch 64, 12*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer

	loops_reset
pfing	bump	rcx, (76-44-47)*clm*64		;; Finish prefetch the sin/cos/premult data
	loops_set_prefetch 64, 1, rcx		;; Prefetch 47*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	12, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 384 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 384 doubles.
;; Memory examples are for a 384K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*4*clm*YMM_SCD1 + 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4 = 46*clm 64-byte cache lines

yr4dwpn_pass1sc384ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b5b, b7a, b7b, b9b, c0b, c1b, c5a, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 384, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 384K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 48 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 12 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 48 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 12 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, PREMULT_ADDR		;; Load premult/sin/cos pointer
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+4*clm*YMM_SCD4]	;; Load second premult/sin/cos pointer
	loops_init 12*4*clm			;; 12*4*clm iterations

c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst		;; Test loop counter, restore scratch area ptr
	loops_undo 4*clm
	end_timer 16

	start_timer 17
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	end_timer 17

	yloopnopre 3, c9a, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9a, -12*4*clmblkdst	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+4*clm*YMM_SCND2]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 12*4*clm			;; 12*4*clm iterations
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 12, c9b, 0, rdi, clm*YMM_SCD4 ;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 12*4*clm			;; 12*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	yloop	12, c7b, -12*4*clmblkdst, rdi, 4*clm*YMM_SCND2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...

;; Do 64 three_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 24 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	192K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	188K	...

;; Do 48 four_complex_unfft operations
;;	distance between fft data elements is 48K
;;	do 12 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 16*4*clm			;; 16 or 12 iters of 4*clm
	mov	rbp, sincos2			;; Load fixed premultiplier/sin/cos ptr

c5a:	start_timer 18
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD1			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+12*clmblkdst, rdi, -4*clm*YMM_SCD1 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, c5b, -4*12*clmblkdst, rdi, 4*clm*YMM_SCD1 ;; Test loop counter, restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
	loops_reset 4*clm			;; Do fewer iterations in this loop
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rbp
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rbp, 4*YMM_SCD6 ;; 4*clm iterations
	yloop	4, c1b, -3*4*clmblkdst+clmblkdst, rbp, -3*4*YMM_SCD6+YMM_SCD6 ;; Loop 3 times!! next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c5a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD1			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 4, c5b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD1 ;; 4 iterations, restore sin/cos pointer
	yloophalfpre 4, c5b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	loops_init 12*4*clm			;; 12 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	12, c1b				;; Test loop counter
	end_timer 20

ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 48
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 48

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	192K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	188K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...

;; Do 48 four_complex_first_fft operations
;;	distance between fft data elements is 48K
;;	do 12 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	48K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	44K	...
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 64 three_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 24 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 32*4*blkdst		;; We've already prefetched 32 blocks

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbp, PREMULT_ADDR		;; Address of sin/cos table
	bump	rbp, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 16*4*clm			;; 12 or 16 iters of 4*clm
b1a:	start_timer 22
	loops_reset 4*clm			;; Do fewer iterations in this loop
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -3*4*clmblkdst, rdi, -3*4*YMM_SCD6+YMM_SCD6 ;; 3 iterations!! restore source ptr, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, 4*clmblkdst, rbp
	bump	rbp, YMM_SCD1			;; Next sine/cosine pointer
	yloopquarterpre 4*clm, b5b, -4*clm*64+12*clmblkdst, rbp, -4*clm*YMM_SCD1 ;; 4*clm iterations, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*12*clmblkdst+clmblkdst, rbp, 4*clm*YMM_SCD1 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer
	lea	rdi, [rbp-4*4*clm*YMM_SCD1-4*clm*YMM_SCND2] ;; Next sin/cos ptr

ELSE

	start_timer 22
	loops_init 12*4*clm			;; 12 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 12*clmblkdst, 24*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	12, b1b, -12*clmblkdst		;; Test loop counter, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of sin/cos table
	bump	rdi, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 16*4*clm			;; 16 iters of 4*clm
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD1			;; Next sine/cosine pointer
	yloopquarterpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, b5b, -4*clmblkdst+12*clmblkdst, rdi, -4*4*clm*YMM_SCD1 ;; Test loop counter, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*12*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 24
	bump	rdi, -4*clm*YMM_SCND2		;; Next sin/cos ptr

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 12 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 12 macros each processing 32 data values

IF (48*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi-4*clm*YMM_SCD4]	;; Second premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
pfing	lea	rdx, [rcx+(46-24)*clm*64]	;; Create second prefetching pointer
	loops_init_prefetch 12*4*clm, 64, 2, rcx ;; 12 iters of 4*clm

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 24*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
	loops_set_prefetch 64, 2, rdx		;; Prefetch 24*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

	loops	3, b7a				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	start_timer 25
	loops_init_prefetch 12*4*clm, 64, 2, rcx ;; 12 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops	12, b7b				;; Test loop counter
	bump	rsi, -12*4*clmblkdst		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4		;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 12*4*clm, 64, 2, rcx ;; 12 iters of 4*clm
pfing	bump	rcx, (46-24-24)*clm*64		;; Finish prefetching the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	12, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 384 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 448 doubles.
;; Memory examples are for a 448K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 14*clm*YMM_SCD4 = 84*clm 64-byte cache lines

yr4dwpn_pass1sc448 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b6b, b7a, b7b, b8b, b9a, b9b, c0b, c1b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 448, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 448K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 55 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 13.75 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 52 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 13 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (56*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 14*4*clm			;; 14*4*clm iterations
	lea	rbx, [rdi+14*clm*YMM_SCD4]	;; Sin/cos ptr

	start_timer 16
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst, rdi, clm*YMM_SCD4 ;; Test loop counter, restore scratch area pointer, next sin/cos pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre 4*clm, c6b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
c7c:	end_timer 17

	yloopdoublepre 2, c9a, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopdoublepre 7, c9a, -7*clmblkdst8	;; Test loop counter, restore source pointer

ELSE

	start_timer 16
	loops_init 14*4*clm			;; 14*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next sin/cos pointer
	yloopnopre 2, c9b, -8*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopnopre 7, c9b, -7*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 14*4*clm			;; 14*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre 4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloopdoublepre 2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloopdoublepre 7, c7b, -7*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	224K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	220K	...

;; Do 16 twenty_eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 112 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	loops_init 4*4*clm		;; 4 iterations of 4*clm
	yr7_14cl_28_reals_unfft_preload
c1b:	yr7_14cl_28_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloopquadpre 4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD13 ;; 4*clm iterations
	yloopquadpre 4, c1b		;; 4 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 56
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 56

;; Do FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	224K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	220K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 twenty_eight_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 112 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (42-2)*4*blkdst	;; We've already prefetched 42 blocks which will be 2 too many
	loops_init 4*4*clm		;; 4 iters of 4*clm
	yr7_14cl_28_reals_fft_preload
b1b:	yr7_14cl_28_reals_fft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloopquadpre 4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD13 ;; 4*clm iters prefetching 4*clm cache lines
	yloopquadpre 4, b1b, -4*clmblkdst ;; 4 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 52 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 13 macros each processing 32 data values

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 55 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 13.75 macros each processing 32 data values

IF (56*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+14*clm*YMM_SCD4]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 14*4*clm, 64, 1, rcx ;; 14 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 14*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 4*clm

	start_timer 26
	loops_set_prefetch 64, 14*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx, rdx
	bump	rbx, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(84-55)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 52*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
b9a:	loops_set_prefetch 64, 1, rdx		;; Prefetch 55*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	end_timer 26

	loops	2, b7a				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	7, b7a				;; Test loop counter

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD2 + 14*clm*YMM_SCD4 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 14*4*clm, 64, 1, rcx ;; 14 iterations of 4*clm
	loops_set_prefetch 64, 14*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 52*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	7, b7b				;; Test loop counter
	bump	rsi, -7*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -14*clm*YMM_SCD4		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 14*4*clm, 64, 1, rcx ;; 14 iters of 4*clm
	loops_set_prefetch 64, 14*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 55*clm cache lines
pfing	bump	rcx, (84-52-55)*clm*64		;; Finish prefetch the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	2, b9b				;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8	;; Next source pointer
	loops	7, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 320 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 512 doubles.
;; Memory examples are for a 512K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 16*clm*YMM_SCD4 = 92*clm 64-byte cache lines

yr4dwpn_pass1sc512 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b4b, b5b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c4a, c4b, c5b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 512, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 512K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 63 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 15.75 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 60 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 15 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 16*4*clm			;; 16*4*clm iterations
	lea	rbx, [rdi+16*clm*YMM_SCD4]	;; Sin/cos ptr

	start_timer 16
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst, rdi, clm*YMM_SCD4 ;; Test loop counter, restore scratch area pointer, next sin/cos pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
c7c:	end_timer 17

	yloopnopre 2, c9a, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopnopre 8, c9a, -8*clmblkdst8	;; Test loop counter, restore source pointer

ELSE

	start_timer 16
	loops_init 16*4*clm			;; 16*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next sin/cos pointer
	yloopnopre 2, c9b, -8*clmblkdst+clmblkdst8 ;; Test loop counter, next dest pointer
	yloopnopre 8, c9b, -8*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 16*4*clm			;; 16*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloop	2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloop	8, c7b, -8*clmblkdst8		;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macro processing 32 data values
;; Do 48 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 32 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	256K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	252K	...

;; Do 64 eight_reals_unfft operations
;;	distance between fft data elements is 64K
;;	do 16 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	lea	rbx, [rdi+16*YMM_SCD3]		;; Sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
	loops_init 16*4*clm			;; 16*4*clm iterations

c4a:	start_timer 18
	yr4_4cl_csc_eight_reals_unfft_preload
c4b:	yr4_4cl_csc_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rbx
	yloophalfpre 4*clm, c4b, -4*clm*64+2*clmblkdst8 ;; Test loop counter

	loops_reset
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rbx
	yloophalfpre 4*clm, c5b, -4*clm*64+2*clmblkdst8 ;; Test loop counter
	yloophalfpre 4, c5b, -4*2*clmblkdst8, rbx, YMM_SCD4 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 18
	loops_undo 4*4*clm

	start_timer 20
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD3 ;; Test loop counter
	yloop	2, c1b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloop	2, c1b, -2*clmblkdst8+clmblkdst, rdi, -4*4*YMM_SCD3+YMM_SCD3 ;; 2 iterations, next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c4a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	bump	rdi, 16*YMM_SCD3		;; Sin/cos ptr
	loops_init 16*4*clm			;; 16*4*clm iterations

	yr4_4cl_csc_eight_reals_unfft_preload
c4b:	yr4_4cl_csc_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloophalfpre 4*clm, c4b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 4, c4b, -4*clmblkdst+2*clmblkdst8, rdi, -4*YMM_SCD4 ;; Test loop counter, restore sin/cos pointer

	loops_reset
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 4, c5b, -4*clmblkdst+2*clmblkdst8, rdi, -4*YMM_SCD4 ;; 4 iterations, restore sine/cosine pointer
	yloophalfpre 4, c5b, -4*2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	bump	rdi, -16*YMM_SCD3		;; Next fixed sine/cosine pointer
	loops_init 16*4*clm			;; 16 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	2, c1b				;; 2 iterations
	end_timer 20
ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 64
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 64

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	256K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	252K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...

;; Do 64 eight_reals_fft operations
;;	distance between fft data elements is 64K
;;	do 16 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 32 data values
;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 40*4*blkdst		;; We've already prefetched 40 blocks

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+16*YMM_SCD3]		;; Sin/cos ptr
	loops_init 16*4*clm			;; 16 iters of 4*clm
b1a:	start_timer 22
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	2, b1b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations
	yloop	2, b1b, -2*clmblkdst8, rdi, -4*4*YMM_SCD3+YMM_SCD3 ;; 2 iterations, restore source pointer, next sin/cos ptr
	loops_undo 2*2*4*clm
	end_timer 22

	start_timer 24
	yr4_4cl_csc_eight_reals_fft_preload
b4b:	yr4_4cl_csc_eight_reals_fft rsi, 64, 4*clmblkdst, clmblkdst8, rbx
	yloophalfpre 4*clm, b4b, -4*clm*64+2*clmblkdst8 ;; 4*clm iterations

	loops_reset
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rbx
	yloophalfpre 4*clm, b5b, -4*clm*64+2*clmblkdst8 ;; 4*clm iterations
	yloophalfpre 4, b5b, -4*2*clmblkdst8+clmblkdst, rbx, YMM_SCD4 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 22
	loops_init 16*4*clm			;; 16 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3	;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	2, b1b, -2*clmblkdst8		;; 2 iterations, restore source pointer
	end_timer 22

	start_timer 24
	loops_init 16*4*clm			;; 16 iterations of 4*clm
	yr4_4cl_csc_eight_reals_fft_preload
b4b:	yr4_4cl_csc_eight_reals_fft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloophalfpre 4*clm, b4b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 4, b4b, -4*clmblkdst+2*clmblkdst8, rdi, -4*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr

	loops_reset
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	yloophalfpre 4*clm, b5b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 4, b5b, -4*clmblkdst+2*clmblkdst8, rdi, -4*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 60 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 15 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 63 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 15.75 macros each processing 32 data values

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+16*clm*YMM_SCD4]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 16*4*clm, 64, 2, rcx ;; 16 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 16*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 4*clm

	start_timer 26
	loops_set_prefetch 64, 16*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx, rdx
	bump	rbx, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(92-63)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 30*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
b9a:	loops_set_prefetch 64, 1, rdx		;; Prefetch 63*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	end_timer 26

	loops	2, b7a				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	8, b7a				;; Test loop counter

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD2 + 16*clm*YMM_SCD4 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 16*4*clm, 64, 2, rcx ;; 16 iterations of 4*clm
	loops_set_prefetch 64, 16*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 2, rcx		;; Prefetch 30*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	8, b7b				;; Test loop counter
	bump	rsi, -8*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -16*clm*YMM_SCD4		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 16*4*clm, 64, 1, rcx ;; 16 iters of 4*clm
	loops_set_prefetch 64, 16*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 63*clm cache lines
pfing	bump	rcx, (92-30-63)*clm*64		;; Finish prefetch the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	2, b9b				;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8	;; Next source pointer
	loops	8, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 512 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 512 doubles.
;; Memory examples are for a 512K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*4*clm*YMM_SCD2 + 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4 = 62*clm 64-byte cache lines

yr4dwpn_pass1sc512ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b5b, b7a, b7b, b9b, c0b, c1b, c5a, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 512, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 512K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 64 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 16 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 16 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, PREMULT_ADDR		;; Load premult/sin/cos pointer
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+4*clm*YMM_SCD4]	;; Load second premult/sin/cos pointer
	loops_init 16*4*clm			;; 16*4*clm iterations

c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst		;; Test loop counter, restore scratch area ptr
	loops_undo 4*clm
	end_timer 16

	start_timer 17
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	end_timer 17

	yloopnopre 2, c9a, -2*4*clmblkdst+clmblkdst8 ;; Test loop counter
	yloopnopre 2, c9a, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9a, -8*clmblkdst8	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+4*clm*YMM_SCND2]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 16*4*clm			;; 16*4*clm iterations
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 8, c9b, -8*clmblkdst+clmblkdst8 ;; Test loop counter
	yloopnopre 2, c9b, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9b, -8*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	yloop	2, c7b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations, next source pointer
	yloop	8, c7b, -8*clmblkdst8, rdi, 4*clm*YMM_SCND2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	256K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	252K	...

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 64K
;;	do 16 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 16*4*clm			;; 16*4*clm iterations
	mov	rbp, sincos2			;; Load fixed premultiplier/sin/cos ptr

c5a:	start_timer 18
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+2*clmblkdst8, rdi, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, c5b, -4*2*clmblkdst8, rdi, 4*clm*YMM_SCD2 ;; Test loop counter, restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rbp
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rbp, 4*YMM_SCD6 ;; 4*clm iterations
	yloop	2, c1b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations
	yloop	2, c1b, -2*clmblkdst8+clmblkdst, rbp, -4*4*YMM_SCD6+YMM_SCD6 ;; 2 iterations, next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c5a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 4, c5b, -4*clmblkdst+2*clmblkdst8, rdi, -4*4*clm*YMM_SCD2 ;; 4 iterations, restore sin/cos pointer
	yloophalfpre 4, c5b, -4*2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	loops_init 16*4*clm			;; 16 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	2, c1b				;; 2 iterations
	end_timer 20

ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 64
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 64

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	256K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	252K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...

;; Do 64 four_complex_first_fft operations
;;	distance between fft data elements is 64K
;;	do 16 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	64K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	60K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 40*4*blkdst		;; We've already prefetched 40 blocks

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbp, PREMULT_ADDR		;; Address of sin/cos table
	bump	rbp, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 16*4*clm			;; 16 iters of 4*clm
b1a:	start_timer 22
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	2, b1b, -2*4*clmblkdst+clmblkdst8 ;; 2 iterations
	yloop	2, b1b, -2*clmblkdst8, rdi, -4*4*YMM_SCD6+YMM_SCD6 ;; 2 iterations, restore source ptr, next sin/cos ptr
	loops_undo 2*2*4*clm
	end_timer 22

	start_timer 24
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rbp
	bump	rbp, YMM_SCD2			;; Next sine/cosine pointer
	yloophalfpre 4*clm, b5b, -4*clm*64+2*clmblkdst8, rbp, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*2*clmblkdst8+clmblkdst, rbp, 4*clm*YMM_SCD2 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer
	lea	rdi, [rbp-4*4*clm*YMM_SCD2-4*clm*YMM_SCND2] ;; Next sin/cos ptr

ELSE

	start_timer 22
	loops_init 16*4*clm			;; 16 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	2, b1b, -2*clmblkdst8		;; 2 iterations
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of sin/cos table
	bump	rdi, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 16*4*clm			;; 16 iters of 4*clm
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next sine/cosine pointer
	yloophalfpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 4, b5b, -4*clmblkdst+2*clmblkdst8, rdi, -4*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*2*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24
	bump	rdi, -4*clm*YMM_SCND2		;; Next sin/cos ptr

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 16 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 16 macros each processing 32 data values

IF (64*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi-4*clm*YMM_SCD4]	;; Second premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
pfing	lea	rdx, [rcx+(62-32)*clm*64]	;; Create second prefetching pointer
	loops_init_prefetch 16*4*clm, 64, 2, rcx ;; 16 iters of 4*clm

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 32*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
	loops_set_prefetch 64, 2, rdx		;; Prefetch 32*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

	loops	2, b7a				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	2, b7a				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	start_timer 25
	loops_init_prefetch 16*4*clm, 64, 2, rcx ;; 16 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8	;; Next source pointer
	loops	8, b7b				;; Test loop counter
	bump	rsi, -8*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4		;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 16*4*clm, 64, 2, rcx ;; 16 iters of 4*clm
pfing	bump	rcx, (62-32-32)*clm*64		;; Finish prefetching the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	8, b9b				;; Test loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8	;; Next source pointer
	loops	2, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 512 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 640 doubles.
;; Memory examples are for a 640K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*4*clm*YMM_SCD4 + 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 = 108*clm 64-byte cache lines

IFDEF INFERIOR
yr4dwpn_pass1sc640 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b4b, b5b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c4a, c4b, c5b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 640, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 640K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 79 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 19.75 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 1 macro processing 32 data values
;; Do 76 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 19 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD2]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 20*4*clm			;; 20*4*clm iterations
	lea	rbx, [rdi+4*clm*YMM_SCD4]	;; Second sin/cos ptr

	start_timer 16
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst		;; Test loop counter, restore scratch area pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
c7c:	end_timer 17

	yloopnopre 5, c9a, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next sin/cos pointer
	yloopnopre 4, c9a, -20*4*clmblkdst	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+4*clm*YMM_SCND4]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 20*4*clm			;; 20*4*clm iterations
c8b:	yr4_sg4cl_2sc_eight_reals_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 20, c9b, 0, rdi, clm*YMM_SCD4 ;; Test loop counter, next sin/cos pointer
	yloopnopre 4, c9b, -4*20*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 20*4*clm			;; 20*4*clm iterations
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND4 ;; 4*clm iterations, restore sin/cos pointer
	yloop	20, c7b, -20*4*clmblkdst, rdi, 4*clm*YMM_SCND4 ;; Test loop counter, restore source pointer, next sin/cos ptr
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...

;; Do 16 ten_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 4 macro processing 40 data values
;; Do 48 five_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 40 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	316K	...

;; Do 80 eight_reals_unfft operations
;;	distance between fft data elements is 80K
;;	do 20 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, sincos2			;; Load fixed sin/cos data ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
	loops_init 32*4*clm			;; 16 or 20 iters of 4*clm

c4a:	start_timer 18
	loops_reset 4*4*clm			;; Do fewer iterations in this loop
	yr5_5cl_csc_ten_reals_unfft_preload
c4b:	yr5_5cl_csc_ten_reals_unfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloopquarterpre 4*clm, c4b, -4*clm*64+20*clmblkdst, rdi, -4*clm*YMM_SCD4 ;; Test loop counter

	loops_reset
	yr5_5cl_five_complex_djbunfft_preload
c5b:	yr5_5cl_five_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloopquarterpre 4*clm, c5b, -4*clm*64+20*clmblkdst, rdi, -4*clm*YMM_SCD4 ;; Test loop counter
	yloopquarterpre 8, c5b, -4*20*clmblkdst, rdi, 4*clm*YMM_SCD4 ;; 4 iterations!! Test loop counter, restore source pointer, next sin/cos pointer
	loops_undo 8*4*clm
	end_timer 18

	start_timer 20
	loops_reset 3*4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rbx
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rbx, 4*YMM_SCD3 ;; Test loop counter
	yloop	8, c1b, -5*4*clmblkdst+clmblkdst, rbx, -5*4*YMM_SCD3+YMM_SCD3 ;; 5 iterations!! next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c4a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr5_5cl_csc_ten_reals_unfft_preload
c4b:	yr5_5cl_csc_ten_reals_unfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloopquarterpre 4*clm, c4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, c4b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD4 ;; Test loop counter, restore sin/cos pointer

	loops_reset
	yr5_5cl_five_complex_djbunfft_preload
c5b:	yr5_5cl_five_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloopquarterpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, c5b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD4 ;; 4 iterations, restore sine/cosine pointer
	yloopquarterpre 4, c5b, -4*20*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	loops_init 20*4*clm			;; 20 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	20, c1b				;; Test loop counter
	end_timer 20
ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 80
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 80

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	316K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...

;; Do 80 eight_reals_fft operations
;;	distance between fft data elements is 80K
;;	do 20 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 16 ten_reals_fft operations
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 40 data values
;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 12 macros each processing 40 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 44*4*blkdst		;; We've already prefetched 44 blocks

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rbx, 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 ;; Create second sin/cos ptr
	loops_init 32*4*clm			;; 20 or 16 iters of 4*clm

b1a:	start_timer 22
	loops_reset 3*4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -5*4*clmblkdst, rdi, -5*4*YMM_SCD3+YMM_SCD3 ;; Loop 5 times!! restore source pointer, next sin/cos ptr
	loops_undo 8*4*clm
	end_timer 22

	start_timer 24
	loops_reset 4*4*clm			;; Do fewer iterations in this loop
	yr5_5cl_csc_ten_reals_fft_preload
b4b:	yr5_5cl_csc_ten_reals_fft rsi, 64, 4*clmblkdst, rbx
	bump	rbx, YMM_SCD4
	yloop	4*clm, b4b, -4*clm*64+20*clmblkdst, rbx, -4*clm*YMM_SCD4 ;; 4*clm iterations

	loops_reset
	yr5_5cl_five_complex_djbfft_preload
b5b:	yr5_5cl_five_complex_djbfft rsi, 64, 4*clmblkdst, rbx
	bump	rbx, YMM_SCD4
	yloop	4*clm, b5b, -4*clm*64+20*clmblkdst, rbx, -4*clm*YMM_SCD4 ;; 4*clm iterations
	yloop	8, b5b, -4*20*clmblkdst+clmblkdst, rbx, 4*clm*YMM_SCD4 ;; 4 iterations!! next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer
	lea	rdi, [rbx-4*4*clm*YMM_SCD4]	;; Restore sin/cos ptr

ELSE

	start_timer 22
	loops_init 20*4*clm			;; 20 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	20, b1b, -20*clmblkdst		;; Loop, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, 4*clm*YMM_SCND4 + clm*YMM_SCD2 + 4*clm*YMM_SCD4 ;; Sin/cos ptr
	loops_init 16*4*clm			;; 16 iterations of 4*clm
	yr5_5cl_csc_ten_reals_fft_preload
b4b:	yr5_5cl_csc_ten_reals_fft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloop	4*clm, b4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloop	4, b4b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr

	loops_reset
	yr5_5cl_five_complex_djbfft_preload
b5b:	yr5_5cl_five_complex_djbfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD4
	yloop	4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloop	4, b5b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr
	yloop	4, b5b, -4*20*clmblkdst		;; Test loop counter, restore source pointer
	end_timer 24

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 4 eight_reals_fft operations
;;	distance between fft data elements is 4K
;;	do 1 macros each processing 32 data values
;; Do 76 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 19 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 eight_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 32 data values
;; Do 79 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 19.75 macros each processing 32 data values

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	bump	rdi, -4*clm*YMM_SCND4		;; Premultiplier/sin/cos ptr
	lea	rbx, [rdi-4*clm*YMM_SCD4]	;; Complex data sin/cos ptr
	lea	rdx, [rbx-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 20*4*clm, 64, 1, rcx ;; 20 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 4*clm

	start_timer 26
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx, rdx
	bump	rbx, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(108-40)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 76*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
b9a:	loops_set_prefetch 64, 2, rdx		;; Prefetch 40*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

	loops	5, b7a				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	bump	rdi, -4*clm*YMM_SCND4		;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 20*4*clm, 64, 1, rcx ;; 20 iterations of 4*clm
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source ptr
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 76*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	20, b7b				;; Test loop counter
	bump	rsi, -20*4*clmblkdst		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD2]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 20*4*clm, 64, 1, rcx ;; 20 iters of 4*clm
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_sg4cl_2sc_eight_reals_fft4_preload
b8b:	yr4_sg4cl_2sc_eight_reals_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer

	loops_reset
pfing	bump	rcx, (108-76-40)*clm*64		;; Finish prefetch the sin/cos/premult data
	loops_set_prefetch 64, 2, rcx		;; Prefetch 40*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	20, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 640 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM
ENDIF


;; Perform a pass 1 FFT of length 640 doubles.
;; Memory examples are for a 640K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 2*4*clm*YMM_SCND4 + clm*YMM_SCD4 + 10*clm*YMM_SCD8 = 136*clm 64-byte cache lines

yr4dwpn_pass1sc640 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 640, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 640K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 39 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 9.75 macros each processing 64 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 2 macro processing 32 data values
;; Do 72 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 18 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 20*4*clm			;; 10*4*clm or 20*4*clm iterations
	lea	rbx, [rdi+10*clm*YMM_SCD8]	;; Sin/cos ptr

	start_timer 16
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst, rdi, clm*YMM_SCD8 ;; Test loop counter, restore scratch area pointer, next sin/cos pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre	4*clm, c6b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloopnopre	2, c6b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; 4*clm iterations, next source ptr, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source ptr
	yloopdoublepre 2, c7b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos pointer
c7c:	end_timer 17

	yloopdoublepre 10, c9a, -10*clmblkdst8	;; Test loop counter, restore source pointer

ELSE

	start_timer 16
	loops_init 10*4*clm			;; 10*4*clm iterations
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst+clmblkdst8, rdi, clm*YMM_SCD8	;; Test loop counter, next dest pointer, next sin/cos pointer
	yloopnopre 10, c9b, -10*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 20*4*clm			;; 20*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloopnopre 4*clm, c6b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source pointer
	yloopnopre 2, c6b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloopdoublepre 4*clm, c7b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source ptr
	yloopdoublepre 2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr
	yloopdoublepre 10, c7b, -10*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	636K	...

;; Do 32 twenty_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 80 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	loops_init 8*4*clm		;; 8 iterations of 4*clm
	yr5_10cl_20_reals_unfft_preload
c1b:	yr5_10cl_20_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloopdoublepre 4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD9 ;; 4*clm iterations
	yloopdoublepre 8, c1b		;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 80
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 80

;; Do FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	636K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 32 twenty_reals_fft operations
;;	distance between fft data elements is 32K
;;	do 8 iterations each processing 80 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (52-4)*4*blkdst	;; We've already prefetched 52 blocks which will be 4 too many
	loops_init 8*4*clm		;; 8 iters of 4*clm
	yr5_10cl_20_reals_fft_preload
b1b:	yr5_10cl_20_reals_fft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloopquadpre 4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD9 ;; 4*clm iters
	yloopquadpre 8, b1b, -8*clmblkdst ;; 8 iterations, restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 8 eight_reals_fft operations
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 32 data values
;; Do 72 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 18 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 39 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 9.75 macros each processing 64 data values

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+10*clm*YMM_SCD8]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 20*4*clm, 64, 2, rcx ;; 20 or 10 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 2*4*clm

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx, rdx
	bump	rbx, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(136-78)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 72*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 2*4*clm
	end_timer 25

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
b9a:	loops_set_prefetch 128, 1, rdx		;; Prefetch 78*clm cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx
	bump	rbx, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rbx, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	end_timer 26

	loops	20, b7a				;; 10 iterations!!!

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD4 + 10*clm*YMM_SCD8 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 20*4*clm, 64, 1, rcx ;; 20 iterations of 4*clm
	loops_set_prefetch 64, 20*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 72*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	10, b7b				;; Test loop counter
	bump	rsi, -10*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -10*clm*YMM_SCD8		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD4]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 10*4*clm, 64, 1, rcx ;; 10 iters of 4*clm
pfing	bump	rcx, (136-72-78)*clm*64		;; Finish prefetch the sin/cos/premult data
	loops_set_prefetch 64, 10*4*clm, rcx	;; Prefetch no cache lines
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer

	loops_reset
	loops_set_prefetch 128, 1, rcx		;; Prefetch 78 cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	10, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 640 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 640 doubles.
;; Memory examples are for a 640K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 4*4*clm*YMM_SCD2 + 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4 = 62*clm 64-byte cache lines

yr4dwpn_pass1sc640ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b5b, b7a, b7b, b9b, c0b, c1b, c5a, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 640, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 640K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 80 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 20 macros each processing 32 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 80 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 20 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, PREMULT_ADDR		;; Load premult/sin/cos pointer
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+4*clm*YMM_SCD4]	;; Load second premult/sin/cos pointer
	loops_init 20*4*clm			;; 20*4*clm iterations

c9a:	start_timer 16
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*clmblkdst		;; Test loop counter, restore scratch area ptr
	loops_undo 4*clm
	end_timer 16

	start_timer 17
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rbx
	bump	rbx, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rbx, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	end_timer 17

	yloopnopre 5, c9a, 0, rdi, clm*YMM_SCD4	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9a, -20*4*clmblkdst	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+4*clm*YMM_SCND2]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 20*4*clm			;; 20*4*clm iterations
c9b:	yr4_sg4cl_four_complex_unfft4 rbp, 64, blkdst, 2*blkdst, rsi, 256, 64, 128, rdi
 	bump	rdi, YMM_SCD4			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+clmblkdst, rbp, -clm*64+4*blkdst, rdi, -clm*YMM_SCD4 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 20, c9b, 0, rdi, clm*YMM_SCD4 ;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9b, -4*20*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 20*4*clm			;; 20*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+4*clmblkdst, rdi, -4*clm*YMM_SCND2 ;; 4*clm iterations, restore sin/cos pointer
	yloop	20, c7b, -20*4*clmblkdst, rdi, 4*clm*YMM_SCND2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...

;; Do 64 five_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 40 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	316K	...

;; Do 80 four_complex_unfft operations
;;	distance between fft data elements is 80K
;;	do 20 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 32*4*clm			;; 16 or 20 iters of 4*clm
	mov	rbp, sincos2			;; Load fixed premultiplier/sin/cos ptr

c5a:	start_timer 18
	loops_reset 4*4*clm			;; Do fewer iterations in this loop
	yr5_5cl_five_complex_djbunfft_preload
c5b:	yr5_5cl_five_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloopquarterpre 4*clm, c5b, -4*clm*64+20*clmblkdst, rdi, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloopquarterpre 8, c5b, -4*20*clmblkdst, rdi, 4*clm*YMM_SCD2 ;; 4 iterations!! restore source pointer, next sin/cos ptr
	loops_undo 8*4*clm
	end_timer 18

	start_timer 20
	loops_reset 3*4*clm			;; Do fewer iterations in this loop
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rbp
	yloop	4*clm, c1b, -4*clm*64+4*clmblkdst, rbp, 4*YMM_SCD6 ;; 4*clm iterations
	yloop	8, c1b, -5*4*clmblkdst+clmblkdst, rbp, -5*4*YMM_SCD6+YMM_SCD6 ;; 5 iterations!! next source pointer, next sin/cos ptr
	end_timer 20

	loops	4, c5a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 16*4*clm			;; 16*4*clm iterations
	yr5_5cl_five_complex_djbunfft_preload
c5b:	yr5_5cl_five_complex_djbunfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloopquarterpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 4, c5b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; 4 iterations, restore sin/cos pointer
	yloopquarterpre 4, c5b, -4*20*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	loops_init 20*4*clm			;; 20 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	20, c1b				;; Test loop counter
	end_timer 20

ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 80
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 80

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	320K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	316K
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...

;; Do 80 four_complex_first_fft operations
;;	distance between fft data elements is 80K
;;	do 20 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	80K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	76K	...
;;	160K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...

;; Do 64 five_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 40 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 44*4*blkdst		;; We've already prefetched 44 blocks

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbp, PREMULT_ADDR		;; Address of sin/cos table
	bump	rbp, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 32*4*clm			;; 20 or 16 iters of 4*clm
b1a:	start_timer 22
	loops_reset 3*4*clm			;; Do fewer iterations in this loop
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+4*clmblkdst, rdi, 4*YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -5*4*clmblkdst, rdi, -5*4*YMM_SCD6+YMM_SCD6 ;; 5 iterations!! restore source ptr, next sin/cos ptr
	loops_undo 8*4*clm
	end_timer 22

	start_timer 24
	loops_reset 4*4*clm			;; Do fewer iterations in this loop
	yr5_5cl_five_complex_djbfft_preload
b5b:	yr5_5cl_five_complex_djbfft rsi, 64, 4*clmblkdst, rbp
	bump	rbp, YMM_SCD2			;; Next sine/cosine pointer
	yloop	4*clm, b5b, -4*clm*64+20*clmblkdst, rbp, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloop	8, b5b, -4*20*clmblkdst+clmblkdst, rbp, 4*clm*YMM_SCD2 ;; 4 iterations!! next source pointer, next sin/cos ptr
	end_timer 24

	loops	4, b1a				;; Test loop counter
	bump	rsi, -4*clmblkdst		;; Restore source pointer
	lea	rdi, [rbp-4*4*clm*YMM_SCD2-4*clm*YMM_SCND2] ;; Next sin/cos ptr

ELSE

	start_timer 22
	loops_init 20*4*clm			;; 20 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 20*clmblkdst, 40*clmblkdst, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	20, b1b, -20*clmblkdst		;; Test loop counter, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of sin/cos table
	bump	rdi, 4*clm*YMM_SCND2 + 4*clm*YMM_SCD4
	loops_init 16*4*clm			;; 16 iters of 4*clm
	yr5_5cl_five_complex_djbfft_preload
b5b:	yr5_5cl_five_complex_djbfft rsi, 64, 4*clmblkdst, rdi
	bump	rdi, YMM_SCD2			;; Next sine/cosine pointer
	yloop	4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloop	4, b5b, -4*clmblkdst+20*clmblkdst, rdi, -4*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr
	yloop	4, b5b, -4*20*clmblkdst	;; Test loop counter, restore source pointer
	end_timer 24
	bump	rdi, -4*clm*YMM_SCND2		;; Next sin/cos ptr

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	16K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	12K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...

;; Do 80 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 20 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	4K	+1K	+1K	+1K
;;	8K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	4K	+1	+1	+1
;;	1K	...
;;	...
;;	3K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 80 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 20 macros each processing 32 data values

IF (80*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi-4*clm*YMM_SCD4]	;; Second premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
pfing	lea	rdx, [rcx+(62-40)*clm*64]	;; Create second prefetching pointer
	loops_init_prefetch 20*4*clm, 64, 2, rcx ;; 20 iters of 4*clm

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 40*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64			;; Restore source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops_undo 4*clm
	end_timer 25

	start_timer 26
	loops_set_prefetch 64, 2, rdx		;; Prefetch 40*clm cache lines
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rbx
	bump	rbx, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

	loops	5, b7a				;; Test loop counter
	bump	rbx, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	start_timer 25
	loops_init_prefetch 20*4*clm, 64, 2, rcx ;; 20 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst, 2*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+4*clmblkdst	;; Next source pointer
	bump	rdi, -4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops	20, b7b				;; Test loop counter
	bump	rsi, -20*4*clmblkdst		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD4		;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 20*4*clm, 64, 2, rcx ;; 20 iters of 4*clm
pfing	bump	rcx, (62-40-40)*clm*64		;; Finish prefetching the sin/cos/premult data
b9b:	yr4_sg4cl_four_complex_fft4 rsi, 256, 64, 128, rbp, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+clmblkdst		;; Next source pointer
	bump	rbp, -clm*64+4*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD4		;; Restore premult/sine/cosine pointer
	loops	20, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD4		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 640 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 768 doubles.
;; Memory examples are for a 768K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 8*4*clm*YMM_SCD2 + 2*4*clm*YMM_SCND4 + clm*YMM_SCD4 + 4*clm*YMM_SCD8 = 152*clm 64-byte cache lines

yr4dwpn_pass1sc768 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b4b, b5b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c4a, c4b, c5b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 768, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 768K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 47 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 11.75 macros each processing 64 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 2 macro processing 32 data values
;; Do 88 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 22 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 24*4*clm			;; 12*4*clm or 24*4*clm iterations
	lea	rbx, [rdi+4*clm*YMM_SCD8]	;; Sin/cos ptr

	start_timer 16
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst	;; Test loop counter, restore scratch area pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c6b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; 4*clm iterations, next source ptr, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos pointer
c7c:	end_timer 17

	yloop	3, c9a, 0, rdi, clm*YMM_SCD8	;; Test loop counter
	yloop	4, c9a, -12*clmblkdst8		;; Test loop counter, restore source pointer
	lea	rdi, [rbx+2*4*clm*YMM_SCND4]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 12*4*clm			;; 12*4*clm iterations
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst+clmblkdst8	;; Test loop counter, next dest pointer
	yloopnopre 3, c9b, 0, rdi, clm*YMM_SCD8	;; Test loop counter, next sin/cos pointer
	yloopnopre 4, c9b, -12*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 24*4*clm			;; 24*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source pointer
	yloop	2, c6b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst ;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr
	yloop	12, c7b, -12*clmblkdst8, rdi, 2*4*clm*YMM_SCND4 ;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...

;; Do 32 six_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 8 macro processing 24 data values
;; Do 96 three_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 24 macros each processing 24 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	384K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	380K	...

;; Do 96 eight_reals_unfft operations
;;	distance between fft data elements is 96K
;;	do 24 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, sincos2			;; Load fixed sin/cos data ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
	loops_init 32*4*clm			;; 32 or 24 iters of 4*clm

c4a:	start_timer 18
	yr3_3cl_csc_six_reals_unfft_preload
c4b:	yr3_3cl_csc_six_reals_unfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c4b, -4*clm*64+3*clmblkdst8, rdi, -4*clm*YMM_SCD2 ;; Test loop counter

	loops_reset
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c5b, -4*clm*64+3*clmblkdst8, rdi, -4*clm*YMM_SCD2 ;; Test loop counter
	yloophalfpre 4, c5b, -4*3*clmblkdst8, rdi, 4*clm*YMM_SCD2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
	loops_reset 4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rbx
	yloop	4*clm, c1b, -4*clm*64+clmblkdst8, rbx, 8*YMM_SCD3 ;; Test loop counter
	yloop	4, c1b, -3*clmblkdst8+clmblkdst, rbx, -3*8*YMM_SCD3+YMM_SCD3 ;; 3 iterations!! next source pointer, next sin/cos ptr
	end_timer 20

	yloop	8, c4a, -8*clmblkdst		;; Test loop counter, restore source pointer

ELSE

	start_timer 18
	loops_init 32*4*clm			;; 32*4*clm iterations
	yr3_3cl_csc_six_reals_unfft_preload
c4b:	yr3_3cl_csc_six_reals_unfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 8, c4b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos pointer

	loops_reset
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 8, c5b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; 4 iterations, restore sine/cosine pointer
	yloophalfpre 4, c5b, -4*3*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	loops_init 24*4*clm			;; 24 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8 ;; Test loop counter, next source ptr
	yloop	3, c1b				;; Test loop counter
	end_timer 20
ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 96
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 96

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	384K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	380K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...

;; Do 96 eight_reals_fft operations
;;	distance between fft data elements is 96K
;;	do 24 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 32 six_reals_fft operations
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 24 data values
;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 24 macros each processing 24 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 64*4*blkdst		;; We've already prefetched 64 blocks

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbx, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rbx, 8*clm*YMM_SCND4 + clm*YMM_SCD4 + 4*clm*YMM_SCD8 ;; Create second sin/cos ptr
	loops_init 32*4*clm			;; 24 or 32 iters of 4*clm

b1a:	start_timer 22
	loops_reset 4*clm			;; Do fewer iterations in this loop
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst8, rdi, 8*YMM_SCD3 ;; 4*clm iters
	yloop	4, b1b, -3*clmblkdst8, rdi, -3*8*YMM_SCD3+YMM_SCD3 ;; Loop 3 times!! restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr3_3cl_csc_six_reals_fft_preload
b4b:	yr3_3cl_csc_six_reals_fft rsi, 64, clmblkdst8, rbx
	bump	rbx, YMM_SCD2
	yloopquarterpre 4*clm, b4b, -4*clm*64+3*clmblkdst8, rbx, -4*clm*YMM_SCD2 ;; 4*clm iterations

	loops_reset
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, clmblkdst8, rbx
	bump	rbx, YMM_SCD2
	yloopquarterpre 4*clm, b5b, -4*clm*64+3*clmblkdst8, rbx, -4*clm*YMM_SCD2 ;; 4*clm iterations
	yloopquarterpre 4, b5b, -4*3*clmblkdst8+clmblkdst, rbx, 4*clm*YMM_SCD2 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	yloop	8, b1a, -8*clmblkdst		;; Test loop counter, restore source pointer
	lea	rdi, [rbx-8*4*clm*YMM_SCD2]	;; Restore sin/cos ptr

ELSE

	start_timer 22
	loops_init 24*4*clm			;; 24 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8	;; Loop, next source pointer
	yloop	3, b1b, -3*clmblkdst8		;; Loop, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, 8*clm*YMM_SCND4 + clm*YMM_SCD4 + 4*clm*YMM_SCD8 ;; Sin/cos ptr
	loops_init 32*4*clm			;; 32 iterations of 4*clm
	yr3_3cl_csc_six_reals_fft_preload
b4b:	yr3_3cl_csc_six_reals_fft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloopquarterpre 4*clm, b4b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 8, b4b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr

	loops_reset
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD2
	yloopquarterpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 8, b5b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*3*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 8 eight_reals_fft operations
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 32 data values
;; Do 72 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 18 macros each processing 32 data values

;; Do FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 47 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 11.75 macros each processing 64 data values

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+4*clm*YMM_SCD8]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 24*4*clm, 64, 2, rcx ;; 24 or 12 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 24*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 2*4*clm

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
	loops_set_prefetch 64, 24*4*clm, rcx	;; Prefetch no cache lines
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx, rdx
	bump	rbx, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(152-94)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 88*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 2*4*clm
	end_timer 25

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
b9a:	loops_set_prefetch 128, 1, rdx		;; Prefetch 94*clm cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx
	bump	rbx, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	end_timer 26

	loops	6, b7a				;; 3 iterations!!!
	bump	rbx, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; 4 iterations

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD4 + 4*clm*YMM_SCD8 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 24*4*clm, 64, 1, rcx ;; 24 iterations of 4*clm
	loops_set_prefetch 64, 24*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 88*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	12, b7b				;; Test loop counter
	bump	rsi, -12*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD8		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD4]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 12*4*clm, 64, 1, rcx ;; 12 iters of 4*clm
pfing	bump	rcx, (152-88-94)*clm*64		;; Finish prefetch the sin/cos/premult data
	loops_set_prefetch 64, 12*4*clm, rcx	;; Prefetch no cache lines
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer

	loops_reset
	loops_set_prefetch 128, 1, rcx		;; Prefetch 94 cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	loops	3, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 768 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 768 doubles.
;; Memory examples are for a 768K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 8*4*clm*YMM_SCD1 + 2*4*clm*YMM_SCND2 + 4*clm*YMM_SCD8 = 92*clm 64-byte cache lines

yr4dwpn_pass1sc768ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b5b, b7a, b7b, b9b, c0b, c1b, c5a, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 768, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 768K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 48 four_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 12 macros each processing 64 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 96 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 24 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, PREMULT_ADDR		;; Load premult/sin/cos pointer
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+4*clm*YMM_SCD8]	;; Load second premult/sin/cos pointer
	loops_init 24*4*clm			;; 12*4*clm or 24*4*clm iterations

c9a:	start_timer 16
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst	;; Test loop counter, restore scratch area ptr
	loops_undo 4*clm
	end_timer 16

	start_timer 17
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND2 ;; Loop, next source ptr, restore sin/cos pointer
	end_timer 17

	yloop	3, c9a, 0, rdi, clm*YMM_SCD8	;; Test loop counter, next premult/sin/cos pointer
	yloop	4, c9a, -12*clmblkdst8		;; Test loop counter, restore source pointer
	lea	rdi, [rbx+2*4*clm*YMM_SCND2]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 12*4*clm			;; 12*4*clm iterations
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst+clmblkdst8 ;; Test loop counter
	yloopnopre 3, c9b, 0, rdi, clm*YMM_SCD8	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9b, -12*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 24*4*clm			;; 24*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND2 ;; Loop, next source ptr, restore sin/cos pointer
	yloop	12, c7b, -12*clmblkdst8, rdi, 2*4*clm*YMM_SCND2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...

;; Do 128 three_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 24 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	384K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	380K	...

;; Do 96 four_complex_last_unfft operations
;;	distance between fft data elements is 96K
;;	do 24 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 32*4*clm			;; 32 or 24 iters of 4*clm
	mov	rbp, sincos2			;; Load fixed premultiplier/sin/cos ptr

c5a:	start_timer 18
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD1			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+3*clmblkdst8, rdi, -4*clm*YMM_SCD1 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, c5b, -4*3*clmblkdst8, rdi, 4*clm*YMM_SCD1 ;; Test loop counter, restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
	loops_reset 4*clm			;; Do fewer iterations in this loop
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rbp
	yloop	4*clm, c1b, -4*clm*64+clmblkdst8, rbp, 8*YMM_SCD6 ;; 4*clm iterations
	yloop	4, c1b, -3*clmblkdst8+clmblkdst, rbp, -3*8*YMM_SCD6+YMM_SCD6 ;; Loop 3 times!! next source pointer, next sin/cos ptr
	end_timer 20

	yloop	8, c5a, -8*clmblkdst		;; Test loop counter, restore source pointer

ELSE

	start_timer 18
	loops_init 32*4*clm			;; 32*4*clm iterations
	yr3_3cl_three_complex_djbunfft_preload
c5b:	yr3_3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD1			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 8, c5b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD1 ;; 8 iterations, restore sin/cos pointer
	yloophalfpre 4, c5b, -4*3*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	loops_init 24*4*clm			;; 24 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8	;; Test loop counter
	yloop	3, c1b				;; Test loop counter
	end_timer 20

ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 96
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 96

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	384K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	380K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...

;; Do 96 four_complex_first_fft operations
;;	distance between fft data elements is 96K
;;	do 24 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	96K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	92K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 128 three_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 24 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 64*4*blkdst		;; We've already prefetched 64 blocks

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbp, PREMULT_ADDR		;; Address of sin/cos table
	bump	rbp, 2*4*clm*YMM_SCND2 + 4*clm*YMM_SCD8
	loops_init 32*4*clm			;; 24 or 32 iters of 4*clm
b1a:	start_timer 22
	loops_reset 4*clm			;; Do fewer iterations in this loop
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst8, rdi, 8*YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -3*clmblkdst8, rdi, -3*8*YMM_SCD6+YMM_SCD6 ;; 3 iterations!! restore source ptr, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, clmblkdst8, rbp
	bump	rbp, YMM_SCD1			;; Next sine/cosine pointer
	yloopquarterpre 4*clm, b5b, -4*clm*64+3*clmblkdst8, rbp, -4*clm*YMM_SCD1 ;; 4*clm iterations, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*3*clmblkdst8+clmblkdst, rbp, 4*clm*YMM_SCD1 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	8, b1a				;; Test loop counter
	bump	rsi, -8*clmblkdst		;; Restore source pointer
	lea	rdi, [rbp-8*4*clm*YMM_SCD1-2*4*clm*YMM_SCND2] ;; Next sin/cos ptr

ELSE

	start_timer 22
	loops_init 24*4*clm			;; 24 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8	;; Test loop counter, next source pointer
	yloop	3, b1b, -3*clmblkdst8		;; Test loop counter, restore source pointer
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of sin/cos table
	bump	rdi, 2*4*clm*YMM_SCND2 + 4*clm*YMM_SCD8
	loops_init 32*4*clm			;; 32 iters of 4*clm
	yr3_3cl_three_complex_djbfft_preload
b5b:	yr3_3cl_three_complex_djbfft rsi, 64, clmblkdst8, rdi
	bump	rdi, YMM_SCD1			;; Next sine/cosine pointer
	yloopquarterpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloopquarterpre 8, b5b, -8*clmblkdst+3*clmblkdst8, rdi, -8*4*clm*YMM_SCD1 ;; Test loop counter, restore sin/cos ptr
	yloopquarterpre 4, b5b, -4*3*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24
	bump	rdi, -2*4*clm*YMM_SCND2		;; Next sin/cos ptr

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 24 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 48 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 12 macros each processing 64 data values

IF (96*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi-4*clm*YMM_SCD8]	;; Second premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
pfing	lea	rdx, [rcx+(92-48)*clm*64]	;; Create second prefetching pointer
	loops_init_prefetch 24*4*clm, 64, 2, rcx ;; 24 or 12 iters of 4*clm

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 64*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source pointer
	bump	rdi, -2*4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops_undo 2*4*clm
	end_timer 25

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
	loops_set_prefetch 64, 1, rdx		;; Prefetch 64*clm cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx
	bump	rbx, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	end_timer 26

	loops	6, b7a				;; 3 iterations!!!
	bump	rbx, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	start_timer 25
	loops_init_prefetch 24*4*clm, 64, 2, rcx ;; 24 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, -2*4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops	12, b7b				;; Test loop counter
	bump	rsi, -12*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD8		;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 12*4*clm, 64, 1, rcx ;; 16 iters of 4*clm
pfing	bump	rcx, (92-48-48)*clm*64		;; Finish prefetching the sin/cos/premult data
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	loops	3, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 768 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 1024 doubles.
;; Memory examples are for a 1024K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 2*4*clm*YMM_SCND4 + clm*YMM_SCD4 + 16*clm*YMM_SCD8 = 184*clm 64-byte cache lines

yr4dwpn_pass1sc1024 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b4b, b5b, b6b, b7a, b7b, b8b, b9a, b9b
	LOCAL	c0b, c1b, c4a, c4b, c5b, c6b, c7a, c7b, c7c, c8b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, 1024, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1024K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 63 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 15.75 macros each processing 64 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 2 macro processing 32 data values
;; Do 120 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 30 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdx, PREMULT_ADDR		;; Real data sin/cos pointer
	lea	rdi, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 32*4*clm			;; 16*4*clm or 32*4*clm iterations
	lea	rbx, [rdi+16*clm*YMM_SCD8]	;; Sin/cos ptr

	start_timer 16
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	end_timer 16

	loops_reset
c9a:	start_timer 16
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst, rdi, clm*YMM_SCD8 ;; Test loop counter, restore scratch area pointer, next sin/cos pointer
	end_timer 16
	loops_undo 4*clm

	start_timer 17
	cmp	rsi, scratch_area		;; Do reals macro on first iteration, do complex on later iterations
	jne	c7a				;; Do complex macro
	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c6b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; 4*clm iterations, next source ptr, restore sin/cos pointer
	jmp	c7c
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

c7a:	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos pointer
c7c:	end_timer 17

	yloopnopre 16, c9a, -16*clmblkdst8	;; Test loop counter, restore source pointer

ELSE

	start_timer 16
	loops_init 16*4*clm			;; 16*4*clm iterations
c8b:	yr8_sg8cl_2sc_sixteen_reals_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	yloopnopre clm, c8b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr

	loops_reset
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next src/dest ptrs, restore sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst+clmblkdst8, rdi, clm*YMM_SCD8	;; Test loop counter, next dest pointer, next sin/cos pointer
	yloopnopre 16, c9b, -16*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 32*4*clm			;; 32*4*clm iterations

	yr4_b4cl_csc_wpn_eight_reals_unfft_preload
c6b:	yr4_b4cl_csc_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	yloop	4*clm, c6b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source pointer
	yloop	2, c6b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr

	loops_reset
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND4 ;; Loop, next source ptr, restore sin/cos ptr
	yloop	16, c7b, -16*clmblkdst8		;; Test loop counter, restore source pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 8 macro processing 32 data values
;; Do 96 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 24 macros each processing 32 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	512K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	508K	...

;; Do 128 eight_reals_unfft operations
;;	distance between fft data elements is 128K
;;	do 32 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	lea	rbx, [rdi+32*YMM_SCD3]		;; Sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
	loops_init 32*4*clm			;; 32*4*clm iterations

c4a:	start_timer 18
	yr4_4cl_csc_eight_reals_unfft_preload
c4b:	yr4_4cl_csc_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rbx
	yloophalfpre 4*clm, c4b, -4*clm*64+4*clmblkdst8 ;; Test loop counter

	loops_reset
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rbx
	yloophalfpre 4*clm, c5b, -4*clm*64+4*clmblkdst8 ;; Test loop counter
	yloophalfpre 4, c5b, -4*4*clmblkdst8, rbx, YMM_SCD4 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 18
	loops_undo 4*4*clm

	start_timer 20
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst8, rdi, 8*YMM_SCD3 ;; Test loop counter
	yloop	4, c1b, -4*clmblkdst8+clmblkdst, rdi, -4*8*YMM_SCD3+YMM_SCD3 ;; 4 iterations, next source pointer, next sin/cos ptr
	end_timer 20

	loops	8, c4a				;; Test loop counter
	bump	rsi, -8*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	mov	rdi, sincos2			;; Load fixed sin/cos data ptr
	bump	rdi, 32*YMM_SCD3		;; Sin/cos ptr
	loops_init 32*4*clm			;; 32*4*clm iterations

	yr4_4cl_csc_eight_reals_unfft_preload
c4b:	yr4_4cl_csc_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloophalfpre 4*clm, c4b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 8, c4b, -8*clmblkdst+4*clmblkdst8, rdi, -8*YMM_SCD4 ;; Test loop counter, restore sin/cos pointer

	loops_reset
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 8, c5b, -8*clmblkdst+4*clmblkdst8, rdi, -8*YMM_SCD4 ;; 8 iterations, restore sine/cosine pointer
	yloophalfpre 4, c5b, -4*4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	bump	rdi, -32*YMM_SCD3		;; Next fixed sine/cosine pointer
	loops_init 32*4*clm			;; 32 iterations of 4*clm
	yr4_4cl_eight_reals_unfft_preload
c1b:	yr4_4cl_eight_reals_unfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	4, c1b				;; 4 iterations
	end_timer 20
ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 128
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 128

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	512K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	508K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...

;; Do 128 eight_reals_fft operations
;;	distance between fft data elements is 128K
;;	do 32 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 32 eight_reals_fft operations
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 32 data values
;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 24 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 80*4*blkdst		;; We've already prefetched 80 blocks

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+32*YMM_SCD3]		;; Sin/cos ptr
	loops_init 32*4*clm			;; 32 iters of 4*clm
b1a:	start_timer 22
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst8, rdi, 8*YMM_SCD3 ;; 4*clm iters, next source ptr, next sin/cos ptr
	yloop	4, b1b, -4*clmblkdst8, rdi, -4*8*YMM_SCD3+YMM_SCD3 ;; 4 iterations, restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr4_4cl_csc_eight_reals_fft_preload
b4b:	yr4_4cl_csc_eight_reals_fft rsi, 64, clmblkdst8, 2*clmblkdst8, rbx
	yloophalfpre 4*clm, b4b, -4*clm*64+4*clmblkdst8 ;; 4*clm iterations

	loops_reset
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rbx
	yloophalfpre 4*clm, b5b, -4*clm*64+4*clmblkdst8 ;; 4*clm iterations
	yloophalfpre 4, b5b, -4*4*clmblkdst8+clmblkdst, rbx, YMM_SCD4 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	8, b1a				;; Test loop counter
	bump	rsi, -8*clmblkdst		;; Restore source pointer

ELSE

	start_timer 22
	loops_init 32*4*clm			;; 32 iters of 4*clm
	yr4_4cl_eight_reals_fft_preload
b1b:	yr4_4cl_eight_reals_fft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD3	;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	4, b1b, -4*clmblkdst8		;; 4 iterations, restore source pointer
	end_timer 22

	start_timer 24
	loops_init 32*4*clm			;; 32 iterations of 4*clm
	yr4_4cl_csc_eight_reals_fft_preload
b4b:	yr4_4cl_csc_eight_reals_fft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloophalfpre 4*clm, b4b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 8, b4b, -8*clmblkdst+4*clmblkdst8, rdi, -8*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr

	loops_reset
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	yloophalfpre 4*clm, b5b, -4*clm*64+clmblkdst, rdi, YMM_SCD4 ;; 4*clm iterations
	yloophalfpre 8, b5b, -8*clmblkdst+4*clmblkdst8, rdi, -8*YMM_SCD4 ;; Test loop counter, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 8 eight_reals_fft operations
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 32 data values
;; Do 120 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 30 macros each processing 32 data values

;; Do FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;;	distance between fft data elements is 1K
;;	do 0.25 macros each processing 64 data values
;; Do 63 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 15.75 macros each processing 64 data values

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rdx, PREMULT_ADDR		;; Real data sin/cos ptr
	lea	rbx, [rdx+clm*YMM_SCD4]		;; Complex data sin/cos ptr
	lea	rdi, [rbx+16*clm*YMM_SCD8]	;; Premultiplier/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	loops_init_prefetch 32*4*clm, 64, 2, rcx ;; 32 or 16 iterations of 4*clm

	start_timer 25
	loops_set_prefetch 64, 32*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	end_timer 25
	loops_undo 2*4*clm

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
	loops_set_prefetch 64, 1, rcx		;; Prefetch 1*clm cache lines
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx, rdx
	bump	rbx, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
pfing	lea	rdx, [rcx+(184-63)*clm*64]	;; Create second prefetch ptr
	jmp	b9a				;; Do remaining complex macro calls
	loops_reset				;; Dummy loops_reset so that next section prefetches properly

b7a:	start_timer 25
	loops_set_prefetch 64, 1, rcx		;; Prefetch 120*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops_undo 2*4*clm
	end_timer 25

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
b9a:	loops_set_prefetch 64, 1, rdx		;; Prefetch 63*clm cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx
	bump	rbx, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rbx, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	end_timer 26

	loops	32, b7a				;; 16 iterations!!!

ELSE

	mov	rdi, PREMULT_ADDR		;; Address of premultiplier/sin/cos table
	bump	rdi, clm*YMM_SCD4 + 16*clm*YMM_SCD8 ;; Sin/cos ptr
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	start_timer 25
	loops_init_prefetch 32*4*clm, 64, 2, rcx ;; 32 iterations of 4*clm
	loops_set_prefetch 64, 32*4*clm, rcx	;; Prefetch no cache lines
	yr4_b4cl_csc_wpn_eight_reals_fft_preload
b6b:	yr4_b4cl_csc_wpn_eight_reals_fft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b6b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source ptr
	loops	2, b6b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source ptr
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr

	loops_reset
	loops_set_prefetch 64, 1, rcx		;; Prefetch 120*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND4			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, -2*4*clm*YMM_SCND4		;; Restore sin/cos ptr
	loops	16, b7b				;; Test loop counter
	bump	rsi, -16*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -16*clm*YMM_SCD8		;; Complex data sin/cos ptr
	lea	rdx, [rdi-clm*YMM_SCD4]		;; Real data sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 16*4*clm, 64, 1, rcx ;; 16 iters of 4*clm
pfing	bump	rcx, (184-120-64)*clm*64	;; Finish prefetch the sin/cos/premult data
	yr8_sg8cl_2sc_sixteen_reals_fft8_preload
b8b:	yr8_sg8cl_2sc_sixteen_reals_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi, rdx
	bump	rdi, YMM_SCD8			;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4			;; Next sine/cosine pointer
	loops	clm, b8b			;; clm iterations
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	16, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 1024 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 1024 doubles.
;; Memory examples are for a 1024K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 8*4*clm*YMM_SCD2 + 2*4*clm*YMM_SCND2 + 4*clm*YMM_SCD8 = 124*clm 64-byte cache lines

yr4dwpn_pass1sc1024ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1a, b1b, b5b, b7a, b7b, b9b, c0b, c1b, c5a, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, 1024, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1024K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; The output cache lines are swizzled to hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 64 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 16 macros each processing 64 data values

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 128 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 32 macros each processing 32 data values

c0b:	mov	rbp, DATA_ADDR			;; Get source address
	mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, PREMULT_ADDR		;; Load premult/sin/cos pointer
	set_data_prefetch_ptrs			;; Init prefetching pointers

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi+4*clm*YMM_SCD8]	;; Load second premult/sin/cos pointer
	loops_init 32*4*clm			;; 16*4*clm or 32*4*clm iterations

c9a:	start_timer 16
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst	;; Test loop counter, restore scratch area ptr
	loops_undo 4*clm
	end_timer 16

	start_timer 17
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rbx
	bump	rbx, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rbx, -2*4*clm*YMM_SCND2 ;; Loop, next source ptr, restore sin/cos pointer
	end_timer 17

	yloopnopre 4, c9a, 0, rdi, clm*YMM_SCD8	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9a, -16*clmblkdst8	;; Test loop counter, restore source pointer
	lea	rdi, [rbx+8*clm*YMM_SCND2]	;; Next sin/cos ptr

ELSE

	start_timer 16
	loops_init 16*4*clm			;; 16*4*clm iterations
c9b:	yr8_sg8cl_eight_complex_unfft8 rbp, 64, blkdst, 2*blkdst, 4*blkdst, rsi, 256, 64, 128, clmblkdst, rdi
 	bump	rdi, YMM_SCD8			;; Next premult/sin/cos data
	yloopnopre clm, c9b, -clm*256+2*clmblkdst, rbp, -clm*64+8*blkdst, rdi, -clm*YMM_SCD8 ;; Loop, next dest/src ptrs, restore premult/sin/cos ptr
	yloopnopre 4, c9b, -4*2*clmblkdst+clmblkdst8 ;; Test loop counter
	yloopnopre 4, c9b, 0, rdi, clm*YMM_SCD8	;; Test loop counter, next premult/sin/cos pointer
	yloopnopre 4, c9b, -16*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 16

	start_timer 17
	loops_init 32*4*clm			;; 32*4*clm iterations
	yr4_b4cl_wpn_four_complex_djbunfft_preload
c7b:	yr4_b4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next clm's sin/cos data
	yloop	4*clm, c7b, -4*clm*64+clmblkdst	;; 4*clm iterations, next source ptr
	yloop	2, c7b, -2*clmblkdst+clmblkdst8, rdi, -2*4*clm*YMM_SCND2 ;; Loop, next source ptr, restore sin/cos pointer
	yloop	16, c7b, -16*clmblkdst8, rdi, 2*4*clm*YMM_SCND2 ;; Test loop counter, restore source pointer, next sin/cos pointer
	end_timer 17

ENDIF

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...

;; Do 128 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	512K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	508K	...

;; Do 128 four_complex_unfft operations
;;	distance between fft data elements is 128K
;;	do 32 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	loops_init 32*4*clm			;; 32*4*clm iterations
	mov	rbp, sincos2			;; Load fixed premultiplier/sin/cos ptr

c5a:	start_timer 18
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+4*clmblkdst8, rdi, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, c5b, -4*4*clmblkdst8, rdi, 4*clm*YMM_SCD2 ;; Test loop counter, restore source pointer, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 18

	start_timer 20
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rbp
	yloop	4*clm, c1b, -4*clm*64+clmblkdst8, rbp, 8*YMM_SCD6 ;; 4*clm iterations
	yloop	4, c1b, -4*clmblkdst8+clmblkdst, rbp, -4*8*YMM_SCD6+YMM_SCD6 ;; 4 iterations, next source pointer, next sin/cos ptr
	end_timer 20

	loops	8, c5a				;; Test loop counter
	bump	rsi, -8*clmblkdst		;; Restore source pointer

ELSE

	start_timer 18
	loops_init 32*4*clm			;; 32*4*clm iterations
	yr4_4cl_four_complex_djbunfft_preload
c5b:	yr4_4cl_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next clm's sin/cos data
	yloophalfpre 4*clm, c5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 8, c5b, -8*clmblkdst+4*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; 8 iterations, restore sin/cos pointer
	yloophalfpre 4, c5b, -4*4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 18

	start_timer 20
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	loops_init 32*4*clm			;; 32 iterations of 4*clm
c1b:	yr4_4cl_csc_four_complex_last_djbunfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, c1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iterations
	yloop	8, c1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	4, c1b				;; 4 iterations
	end_timer 20

ENDIF

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 128
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 128

;; Do FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	512K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	508K	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...

;; Do 128 four_complex_first_fft operations
;;	distance between fft data elements is 128K
;;	do 32 iterations each processing 32 data values

;; Do FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	128K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	124K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...

;; Do 128 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

;; Process data in small chunks for more L1 data cache hits

yes_fft:mov	rsi, scratch_area		;; Get address of scratch area
	mov	rdi, sincos2			;; Load fixed premultiplier/sin/cos ptr
	set_data_prefetch_ptrs			;; Init prefetching pointers
pfing	bump	rcx, 80*4*blkdst		;; We've already prefetched 80 blocks

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	mov	rbp, PREMULT_ADDR		;; Address of sin/cos table
	bump	rbp, 8*clm*YMM_SCND2 + 4*clm*YMM_SCD8
	loops_init 32*4*clm			;; 32 iters of 4*clm
b1a:	start_timer 22
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst8, rdi, 8*YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	4, b1b, -4*clmblkdst8, rdi, -4*8*YMM_SCD6+YMM_SCD6 ;; 4 iterations, restore source ptr, next sin/cos ptr
	loops_undo 4*4*clm
	end_timer 22

	start_timer 24
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rbp
	bump	rbp, YMM_SCD2			;; Next sine/cosine pointer
	yloophalfpre 4*clm, b5b, -4*clm*64+4*clmblkdst8, rbp, -4*clm*YMM_SCD2 ;; 4*clm iterations, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*4*clmblkdst8+clmblkdst, rbp, 4*clm*YMM_SCD2 ;; Test loop counter, next source pointer, next sin/cos ptr
	end_timer 24

	loops	8, b1a				;; Test loop counter
	bump	rsi, -8*clmblkdst		;; Restore source pointer
	lea	rdi, [rbp-8*4*clm*YMM_SCD2-8*clm*YMM_SCND2] ;; Next sin/cos ptr

ELSE

	start_timer 22
	loops_init 32*4*clm			;; 32 iters of 4*clm
b1b:	yr4_4cl_csc_four_complex_first_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	yloop	4*clm, b1b, -4*clm*64+clmblkdst, rdi, YMM_SCD6 ;; 4*clm iters prefetching 4*clm cache lines
	yloop	8, b1b, -8*clmblkdst+clmblkdst8 ;; 8 iterations
	yloop	4, b1b, -4*clmblkdst8		;; 4 iterations
	end_timer 22

	start_timer 24
	mov	rdi, PREMULT_ADDR		;; Address of sin/cos table
	bump	rdi, 8*clm*YMM_SCND2 + 4*clm*YMM_SCD8
	loops_init 32*4*clm			;; 32 iters of 4*clm
	yr4_4cl_four_complex_djbfft_preload
b5b:	yr4_4cl_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD2			;; Next sine/cosine pointer
	yloophalfpre 4*clm, b5b, -4*clm*64+clmblkdst ;; 4*clm iterations
	yloophalfpre 8, b5b, -8*clmblkdst+4*clmblkdst8, rdi, -8*4*clm*YMM_SCD2 ;; Test loop counter, restore sin/cos ptr
	yloophalfpre 4, b5b, -4*4*clmblkdst8	;; Test loop counter, restore source pointer
	end_timer 24
	bump	rdi, -8*clm*YMM_SCND2		;; Next sin/cos ptr

ENDIF

;; Do FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	32K	+1K	+1K	+1K
;;	4K	...
;;	...
;;	28K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...

;; Do 128 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 32 macros each processing 32 data values

;; Do FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	+1K	+1K	+1K	8K	+1K	+1K	+1K
;;	4K	...
;;	16K	...
;;	...
;; The input is swizzled to hold these data values:
;;	0K	+1	+1	+1	8K	+1	+1	+1
;;	1K	...
;;	...
;;	7K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	+1	+1	+1	1K	+1	+1	+1
;;	2K	...
;;	...

;; Do 64 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 16 macros each processing 64 data values

IF (128*4*clm*64 GT GROUPING_SIZE) OR (clm GE CLM_GROUPING)

	lea	rbx, [rdi-4*clm*YMM_SCD8]	;; Second premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
pfing	lea	rdx, [rcx+(124-64)*clm*64]	;; Create second prefetching pointer
	loops_init_prefetch 32*4*clm, 64, 2, rcx ;; 32 or 16 iters of 4*clm

b7a:	start_timer 25
	loops_set_prefetch 64, 2, rcx		;; Prefetch 64*clm cache lines
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst		;; Restore source pointer
	bump	rdi, -2*4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops_undo 2*4*clm
	end_timer 25

	start_timer 26
	loops_reset 4*clm			;; Fewer iterations in this loop
	loops_set_prefetch 64, 1, rdx		;; Prefetch 64*clm cache lines
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rbx
	bump	rbx, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rbx, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	end_timer 26

	loops	8, b7a				;; 4 iterations!!!
	bump	rbx, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b7a				;; Test loop counter

ELSE

	start_timer 25
	loops_init_prefetch 32*4*clm, 64, 2, rcx ;; 32 iters of 4*clm
pfing	mov	rcx, PREMULT_PREFETCH		;; Load premult/sin/cos prefetch pointer
	yr4_b4cl_wpn_four_complex_djbfft_preload
b7b:	yr4_b4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi
	bump	rdi, YMM_SCND2			;; Next sine/cosine pointer
	loops	4*clm, b7b			;; Test loop counter
	bump	rsi, -4*clm*64+clmblkdst	;; Next source pointer
	loops	2, b7b				;; Test loop counter
	bump	rsi, -2*clmblkdst+clmblkdst8	;; Next source pointer
	bump	rdi, -2*4*clm*YMM_SCND2		;; Restore sin/cos ptr
	loops	16, b7b				;; Test loop counter
	bump	rsi, -16*clmblkdst8		;; Restore source pointer
	end_timer 25

	start_timer 26
	bump	rdi, -4*clm*YMM_SCD8		;; Next premult/sin/cos ptr
	mov	rbp, DATA_ADDR			;; Destination pointer
	loops_init_prefetch 16*4*clm, 64, 1, rcx ;; 16 iters of 4*clm
pfing	bump	rcx, (124-64-64)*clm*64		;; Finish prefetching the sin/cos/premult data
b9b:	yr8_sg8cl_eight_complex_fft8 rsi, 256, 64, 128, clmblkdst, rbp, 64, blkdst, 2*blkdst, 4*blkdst, rdi
	bump	rdi, YMM_SCD8			;; Next premult/sin/cos ptr
	loops	clm, b9b
	bump	rsi, -clm*256+2*clmblkdst	;; Next source pointer
	bump	rbp, -clm*64+8*blkdst		;; Next dest pointer
	bump	rdi, -clm*YMM_SCD8		;; Restore premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	bump	rsi, -4*2*clmblkdst+clmblkdst8	;; Next source pointer
	loops	4, b9b				;; Test loop counter
	bump	rdi, clm*YMM_SCD8		;; Next premult/sine/cosine pointer
	loops	4, b9b				;; Test loop counter
	end_timer 26

ENDIF

;; Work on next 4*clm sets of 1024 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM










IFDEF OLD_CODE

;; Perform a pass 1 FFT of length 896 doubles.
;; Memory examples are for a 896K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R + 2*clm*YMM_SCD4 + 14*2*clm*YMM_SCD8 = 86*2*clm 64-byte cache lines

yr4dwpn_pass1sc896 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b4a, b4b, b5a, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 448K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 55 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 55 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD4+128] ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
pfing	lea	rbp, [rdx+(86-56)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 56*2*clm, 64, 1, rbp ;; 56*2*clm iterations
c8b:	r8_sg4cl_sixteen_reals_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	2, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	14, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	lea	rdx, [rdi-128]		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values
;; Do 104 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 52 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 56*2*clm		;; 56 iterations of 2*clm

	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2, rdx, 4*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	14, c7b			;; Test outer loop counter
	bump	rsi, -14*2*clmblkdst8	;; Restore source pointer
	end_timer 17

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.807 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	224K	448K	672K
;;	1K	...
;;	...
;;	223K

;; Do 128 28_reals_last_unfft operations
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 112 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 16*2*clm		;; 16 iterations of 2*clm
	r7_x14cl_28_reals_last_unfft_preload
c1b:	r7_x14cl_28_reals_last_unfft rsi, 64, 2*clmblkdst8, rdi, 16*YMM_SCD13
	yloop1quadpre c1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c1b			;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 224
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 224

;; Do FFT levels 1,2,3,4,5 (actually 4.807 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	224K	448K	672K
;;	1K	...
;;	...
;;	223K
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 128 28_reals_first_fft operations
;;	distance between fft data elements is 32K
;;	do 32 iterations each processing 56 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (64-8)*blkdst	;; We've already prefetched 64 blocks, but
					;; code below will fetch 8 blocks too many
	loops_init 32*2*clm		;; 32 iters of 2*clm
	r7_x7cl_28_reals_first_fft_scratch_preload
b1b:	r7_x7cl_28_reals_first_fft_scratch rsi, 64, 4*clmblkdst8, rdi
	yloop1doublepre b1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iters prefetching 4*clm cache lines
	loops	8, b1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 8 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values
;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 48 macros each processing 32 data values

	start_timer 25
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 2*clm*YMM_SCD4 + 14*2*clm*YMM_SCD8 ;; Real data sin/cos ptr
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 56*2*clm		;; 7 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1 b6b, clmblkdst	;; 2*clm iterations
	loops	8, b6b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1doublepre b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	7, b7b			;; Test outer loop counter
	bump	rsi, -7*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 8,9,10
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 1 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 64 data values
;; Do 54 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 27 macros each processing 64 data values

	start_timer 26
	bump	rdi, -8*2*clm*YMM_SCND2R-14*2*clm*YMM_SCD8+128 ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
	lea	rdx, [rdi-128-2*clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 28*2*clm, 128, 1, rbp ;; 28 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r8_sg8cl_sixteen_reals_eight_complex_fft8_preload
b8b:	r8_sg8cl_sixteen_reals_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	14, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 896 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 1280 doubles.
;; Memory examples are for a 1280K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCND2R +
;;			2*clm*YMM_SCD2 + 10*2*clm*YMM_SCD4 = 67*clm 64-byte cache lines

yr4dwpn_pass1sc1280 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1280K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 16 data values
;; Do 159 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 159 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
pfing	lea	rbp, [rdx+(67-40)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 160*2*clm, 64, 4, rbp ;; 160*2*clm iterations
c8b:	r4_sg2cl_eight_reals_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	4, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	10, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values
;; Do 156 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 78 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+4*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 80*2*clm		;; 80*2*clm iterations

	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2, rdx, 2*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c6b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	40, c7b			;; Test outer loop counter
	bump	rsi, -40*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+4*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values
;; Do 144 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 72 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+16*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 80*2*clm		;; 80*2*clm iterations

	r4_x4cl_eight_reals_unfft_preload
c4b:	r4_x4cl_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCD2, rdx, 8*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c5b:	r4_x4cl_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	10, c5b			;; Test outer loop counter
	bump	rsi, -10*4*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K

;; Do 256 20_reals_unfft operations
;;	distance between fft data elements is 64K
;;	do 32 macros each processing 80 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 32*2*clm		;; 32 iterations of 2*clm
	r5_x10cl_20_reals_last_unfft_preload
c1b:	r5_x10cl_20_reals_last_unfft rsi, 64, 4*clmblkdst8, rdi, 32*YMM_SCD9
	yloop1 c1b, clmblkdst, rdi, YMM_SCD9 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 320
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 320

;; Do FFT levels 1,2,3,4,5 (actually 4.32 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	196K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...

;; Do 256 20_reals_first_fft operations
;;	distance between fft data elements is 64K
;;	do 64 iterations each processing 40 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (32-0)*blkdst	;; We've already prefetched 32 blocks, perfect!
	loops_init 64*2*clm		;; 64 iters of 2*clm
	r5_x5cl_20_reals_first_fft_scratch_preload
b1b:	r5_x5cl_20_reals_first_fft_scratch rsi, 64, 8*clmblkdst8, rdi
	yloop1doublepre b1b, clmblkdst, rdi, YMM_SCD9 ;; 2*clm iters prefetching 4*clm cache lines
	loops	8, b1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	196K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values
;; Do 128 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 64 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 4*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCND2R + 2*clm*YMM_SCD2 + 10*2*clm*YMM_SCD4 ;; Real data sin/cos ptr
	lea	rdi, [rdx+16*2*clm*YMM_SCD2] ;; Next sin/cos ptr
	loops_init 80*2*clm		;; 5 iterations of 16 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst	;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b4b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b5b:	r4_x4cl_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, b5b			;; Test middle loop counter
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b5b			;; Test outer loop counter
	bump	rsi, -5*8*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 4 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values
;; Do 152 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 76 macros each processing 32 data values

	start_timer 25
	bump	rdi, -16*2*clm*YMM_SCD2-4*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-4*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 80*2*clm		;; 20 iterations of 4 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1 b6b, clmblkdst	;; 2*clm iterations
	loops	4, b6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	20, b7b			;; Test outer loop counter
	bump	rsi, -20*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 1 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 158 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 79 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*2*clm*YMM_SCND2R-10*2*clm*YMM_SCD4 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 80*2*clm, 64, 2, rbp ;; 80 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r4_sg4cl_eight_reals_four_complex_fft4_preload
b8b:	r4_sg4cl_eight_reals_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	10, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 1280 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 1536 doubles.
;; Memory examples are for a 1536K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCD1 + 16*2*clm*YMM_SCD1 + 4*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCD2R +
;;			2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4 = 63*2*clm 64-byte cache lines

yr4dwpn_pass1sc1536 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1536K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 16 data values
;; Do 191 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 191 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
pfing	lea	rbp, [rdx+(63-24)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 192*2*clm, 64, 8, rbp ;; 192*2*clm iterations
c8b:	r4_sg2cl_eight_reals_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	3, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values
;; Do 188 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 94 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+4*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 96*2*clm		;; 96*2*clm iterations

	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2, rdx, 2*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c6b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	48, c7b			;; Test outer loop counter
	bump	rsi, -48*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+4*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...

;; Do 16 six_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 24 data values
;; Do 240 three_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 120 macros each processing 24 data values

	start_timer 18
	lea	rdi, [rdx+16*2*clm*YMM_SCD1] ;; Real data sin/cos ptr
	loops_init 128*2*clm		;; 128 iterations of 2*clm
c4b:	r3_x3cl_six_reals_unfft rsi, 64, clmblkdst8, rdi, 8*2*clm*YMM_SCD1, rdx, 8*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD1		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+3*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD1	;; Restore sine/cosine pointer

	loops_reset
	r3_x3cl_three_complex_djbunfft_preload
c5b:	r3_x3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi, 8*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+3*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD1	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*3*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K
;;	384K	...
;;	...

;; Do 48 eight_reals_unfft operations
;;	distance between fft data elements is 48K
;;	do 24 macros each processing 32 data values
;; Do 144 four_complex_unfft operations
;;	distance between fft data elements is 48K
;;	do 72 macros each processing 32 data values

	start_timer 19
	mov	rdx, sincos2		;; Load fixed sin/cos data ptr
	bump	rdx, 192*YMM_SCD3	;; Real data sin/cos ptr
	lea	rdi, [rdx+48*YMM_SCD2]	;; Complex data sin/cos ptr

	loops_init 96*2*clm		;; 24*2*clm iterations
	r4_x4cl_eight_reals_unfft_preload
c2b:	r4_x4cl_eight_reals_unfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi, 24*YMM_SCD2, rdx, 24*YMM_SCD2
	loops	2*clm, c2b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	3, c2b			;; 3 iterations
	bump	rsi, -3*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -24*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi, 24*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -24*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*12*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K
;;	384K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K

;; Do 192 eight_reals_unfft operations
;;	distance between fft data elements is 192K
;;	do 96 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 96*2*clm		;; 96 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c1b:	r4_x4cl_eight_reals_unfft rsi, 64, 12*clmblkdst8, 24*clmblkdst8, rdi, 96*YMM_SCD3
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD3 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	12, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 384
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 384

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K
;; On output the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K	...
;;	768K	...
;;	...

;; Do 192 eight_reals_fft operations
;;	distance between fft data elements is 192K
;;	do 192 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 192*2*clm		;; 24 iters of 4 iters of 2*2*clm
	r4_x2cl_eight_reals_fft_scratch_preload
b1b:	r4_x2cl_eight_reals_fft_scratch rsi, 64, 24*clmblkdst8, rdi
	yloop2 b1b, clmblkdst, rdi, YMM_SCD3 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	24, b1b			;; Test loop counter
	bump	rsi, -24*clmblkdst8	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos ptr
pfing	bump	rcx, -4*blkdst		;; We've just prefetched 96 blocks, correct for
					;; code below that prefetches 4 blocks too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K	...
;;	768K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K	...
;;	192K	...
;;	...

;; Do 48 eight_reals_fft operations
;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 48K
;;	do 48 macros each processing 32 data values
;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 48K
;;	do 48 macros each processing 32 data values

	start_timer 23
	lea	rdi, [rdx+48*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 48*2*clm		;; 6 iters of 8 of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b2b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi, rdx
	yloop2 b2b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD2 ;; 2*2*clm iterations
	loops	4, b2b			;; 4 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	6, b2b			;; 2 iterations
	bump	rsi, -6*clmblkdst8+24*clmblkdst8
	bump	rdi, -48*YMM_SCD2	;; Restore sin/cos ptr

	loops_init 48*2*clm		;; 6 iters of 8 of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2 ;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	6, b3b			;; Test middle loop counter
	bump	rsi, -6*clmblkdst8-24*clmblkdst8 ;; Next source pointer
	end_timer 23

;; Do FFT levels 6,7 (actually 1.585 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 16 six_reals_fft operations
;; Do 16 three_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 24 data values
;; Do 224 three_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 112 macros each processing 24 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 4*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCND2R + 2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4 ;; Real data sin/cos ptr
	lea	rdi, [rdx+16*2*clm*YMM_SCD1] ;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 8 iters of 2 iters of 8 of 2*clm
	r3_x3cl_six_reals_three_complex_djbfft_preload
b4b:	r3_x3cl_six_reals_three_complex_djbfft rsi, 64, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst	;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD1	;; Restore sin/cos ptr

	loops_reset
	r3_x3cl_three_complex_djbfft_preload
b5b:	r3_x3cl_three_complex_djbfft rsi, 64, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Restore source pointer
	bump	rdi, -16*2*clm*YMM_SCD1	;; Restore sin/cos ptr
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*6*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 4 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values
;; Do 184 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 92 macros each processing 32 data values

	start_timer 25
	bump	rdi, -16*2*clm*YMM_SCD1-4*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-4*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 96*2*clm		;; 24 iterations of 4 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1nopre b6b, clmblkdst	;; 2*clm iterations
	loops	4, b6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	24, b7b			;; Test outer loop counter
	bump	rsi, -24*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 1 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 190 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 95 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*2*clm*YMM_SCND2R-16*2*clm*YMM_SCD4 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 96*2*clm, 64, 2, rbp ;; 96 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r4_sg4cl_eight_reals_four_complex_fft4_preload
b8b:	r4_sg4cl_eight_reals_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	3, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 1536 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 1792 doubles.
;; Memory examples are for a 1792K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCND2R + 4*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCD2 +
;;			2*clm*YMM_SCD2 + 14*2*clm*YMM_SCD4 = 93*2*clm 64-byte cache lines

yr4dwpn_pass1sc1792 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1792K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 16 data values
;; Do 223 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 223 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
pfing	lea	rbp, [rdx+(93-56)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 224*2*clm, 64, 4, rbp ;; 224*2*clm iterations
c8b:	r4_sg2cl_eight_reals_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	4, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	14, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values
;; Do 220 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 110 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+4*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 112*2*clm		;; 112*2*clm iterations

	r4_x4cl_eight_reals_unfft_preload
c6b:	r4_x4cl_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCD2, rdx, 2*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c6b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c7b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	56, c7b			;; Test outer loop counter
	bump	rsi, -56*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+4*2*clm*YMM_SCD2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values
;; Do 208 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 104 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+16*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 112*2*clm		;; 112*2*clm iterations

	r4_x4cl_wpn_eight_reals_unfft_preload
c4b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCND2, rdx, 8*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c5b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	14, c5b			;; Test outer loop counter
	bump	rsi, -14*4*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.807 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	448K	896K	1344K
;;	1K	...
;;	...
;;	447K

;; Do 256 28_reals_last_unfft operations
;;	distance between fft data elements is 64K
;;	do 32 macros each processing 112 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 32*2*clm		;; 32 iterations of 2*clm
	r7_x14cl_28_reals_last_unfft_preload
c1b:	r7_x14cl_28_reals_last_unfft rsi, 64, 4*clmblkdst8, rdi, 32*YMM_SCD13
	yloop1quadpre c1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, c1b			;; 4 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 448
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 448

;; Do FFT levels 1,2,3,4,5 (actually 4.807 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	448K	896K	1344K
;;	1K	...
;;	...
;;	447K
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...

;; Do 256 28_reals_first_fft operations
;;	distance between fft data elements is 64K
;;	do 64 iterations each processing 56 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (128-12)*blkdst	;; We've already prefetched 128 blocks, but
					;; code below will fetch 12 blocks too many
	loops_init 64*2*clm		;; 64 iters of 2*clm
	r7_x7cl_28_reals_first_fft_scratch_preload
b1b:	r7_x7cl_28_reals_first_fft_scratch rsi, 64, 8*clmblkdst8, rdi
	yloop1doublepre b1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iters prefetching 4*clm cache lines
	loops	8, b1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values
;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 96 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 4*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCD2 + 2*clm*YMM_SCD2 + 14*2*clm*YMM_SCD4 ;; Real data sin/cos ptr
	lea	rdi, [rdx+16*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 112*2*clm		;; 7 iterations of 16 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1nopre b4b, clmblkdst	 ;; 2*clm iterations
	loops	8, b4b			;; 4 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b4b			;; 4 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8
	bump	rdi, -16*2*clm*YMM_SCND2 ;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b5b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, b5b			;; Test middle loop counter
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCND2 ;; Restore sin/cos ptr
	loops	7, b5b			;; Test outer loop counter
	bump	rsi, -7*8*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 4 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values
;; Do 216 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 108 macros each processing 32 data values

	start_timer 25
	bump	rdi, -16*2*clm*YMM_SCND2R-4*2*clm*YMM_SCD2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-4*2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	loops_init 112*2*clm		;; 28 iterations of 4 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1nopre b6b, clmblkdst	;; 2*clm iterations
	loops	4, b6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8
	bump	rdi, -4*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b7b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	28, b7b			;; Test outer loop counter
	bump	rsi, -28*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 1 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 222 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 111 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*2*clm*YMM_SCD2-14*2*clm*YMM_SCD4 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 112*2*clm, 64, 2, rbp ;; 112 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r4_sg4cl_eight_reals_four_complex_fft4_preload
b8b:	r4_sg4cl_eight_reals_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	14, b9b			;; Test loop counter
	end_timer 26

;; Work on next 4*clm sets of 1792 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 2048 doubles.
;; Memory examples are for a 2048K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCND2R + 4*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCD2 +
;;			2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4 = 97*2*clm 64-byte cache lines

yr4dwpn_pass1sc2048 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 2048K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10.11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 1 eight_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 16 data values
;; Do 255 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 255 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
pfing	lea	rbp, [rdx+(97-64)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 256*2*clm, 64, 4, rbp ;; 256*2*clm iterations
c8b:	r4_sg2cl_eight_reals_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	4, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft operations
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values
;; Do 252 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 126 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+4*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 128*2*clm iterations

	r4_x4cl_eight_reals_unfft_preload
c6b:	r4_x4cl_eight_reals_unfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCD2, rdx, 2*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c6b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c7b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	64, c7b			;; Test outer loop counter
	bump	rsi, -64*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+4*2*clm*YMM_SCD2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values
;; Do 240 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 120 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+16*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r4_x4cl_wpn_eight_reals_unfft_preload
c4b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCND2, rdx, 8*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c5b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*4*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K
;;	512K	...
;;	...

;; Do 64 eight_reals_unfft operations
;;	distance between fft data elements is 64K
;;	do 32 macros each processing 32 data values
;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 64K
;;	do 96 macros each processing 32 data values

	start_timer 19
	mov	rdx, sincos2		;; Load fixed sin/cos data ptr
	bump	rdx, 256*YMM_SCD3	;; Real data sin/cos ptr
	lea	rdi, [rdx+64*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 128 iterations of 2*clm

	r4_x4cl_eight_reals_unfft_preload
c2b:	r4_x4cl_eight_reals_unfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, 32*YMM_SCD2, rdx, 32*YMM_SCD2
	loops	2*clm, c2b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, c2b			;; 4 iterations
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, 32*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, c3b			;; 8 iterations
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*16*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K

;; Do 256 eight_reals_unfft operations
;;	distance between fft data elements is 256K
;;	do 128 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c1b:	r4_x4cl_eight_reals_unfft rsi, 64, 16*clmblkdst8, 32*clmblkdst8, rdi, 128*YMM_SCD3
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD3 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	16, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 512
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 512

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K

;; Do 256 eight_reals_fft operations
;;	distance between fft data elements is 256K
;;	do 256 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 256*2*clm		;; 32 iters of 4 iters of 2*2*clm
	r4_x2cl_eight_reals_fft_scratch_preload
b1b:	r4_x2cl_eight_reals_fft_scratch rsi, 64, 32*clmblkdst8, rdi
	yloop2 b1b, clmblkdst, rdi, YMM_SCD3 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	32, b1b			;; Test loop counter
	bump	rsi, -32*clmblkdst8	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos ptr
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 64K
;;	do 64 macros each processing 32 data values
;; Do 128 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 64 macros each processing 32 data values

	start_timer 23
	lea	rdi, [rdx+64*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 2 sets of 8 iters of 8 of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b2b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi, rdx
	yloop1 b2b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD2 ;; 2*clm iterations
	loops	8, b2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	8, b2b			;; Test loop counter
	bump	rsi, -8*clmblkdst8+32*clmblkdst8 ;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	8, b3b			;; Test loop counter
	bump	rsi, -8*clmblkdst8-32*clmblkdst8 ;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values
;; Do 224 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 112 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 4*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCD2 + 2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4 ;; Real data sin/cos ptr
	lea	rdi, [rdx+16*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 8 iters of 16 of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst	;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b5b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCND2 ;; Restore sin/cos ptr
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*8*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 4 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values
;; Do 248 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 124 macros each processing 32 data values

	start_timer 25
	bump	rdi, -16*2*clm*YMM_SCND2R-4*2*clm*YMM_SCD2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-4*2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	loops_init 128*2*clm		;; 32 iterations of 4 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b6b, clmblkdst		;; 2*clm iterations
	loops	4, b6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8
	bump	rdi, -4*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b7b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst		;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	32, b7b			;; Test outer loop counter
	bump	rsi, -32*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 1 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 254 four_complex_fft4 operations
;;	distance between fft data elements is 1K
;;	do 127 macros each processing 32 data values

	start_timer 26
	bump	rdi, -4*2*clm*YMM_SCD2-16*2*clm*YMM_SCD4 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 128*2*clm, 64, 2, rbp ;; 128 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r4_sg4cl_eight_reals_four_complex_fft4_preload
b8b:	r4_sg4cl_eight_reals_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi, rdx
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer

	loops_reset
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 2048 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 2560 doubles.
;; Memory examples are for a 2560K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD2 + 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R +
;;			2*clm*YMM_SCD4 + 10*2*clm*YMM_SCD8 = 134*2*clm 64-byte cache lines

yr4dwpn_pass1sc2560 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 2560K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 159 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 159 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD4+128] ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
pfing	lea	rbp, [rdx+(134-40-20)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 160*2*clm, 64, 4, rbp ;; 160*2*clm iterations
c8b:	r8_sg4cl_sixteen_reals_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	8, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	10, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	lea	rdx, [rdi-128]		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values
;; Do 312 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 156 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init_prefetch 160*2*clm, 64, 8, rbp ;; 160 iterations of 2*clm
	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2, rdx, 4*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	40, c7b			;; Test outer loop counter
	bump	rsi, -40*2*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+8*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values
;; Do 288 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 144 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 160*2*clm		;; 160 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c4b:	r4_x4cl_eight_reals_unfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2, rdx, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c4b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c5b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	10, c5b			;; Test outer loop counter
	bump	rsi, -10*8*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K

;; Do 512 20_reals_last_unfft operations
;;	distance between fft data elements is 128K
;;	do 64 macros each processing 80 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 64*2*clm		;; 64 iterations of 2*clm
	r5_x10cl_20_reals_last_unfft_preload
c1b:	r5_x10cl_20_reals_last_unfft rsi, 64, 8*clmblkdst8, rdi, 64*YMM_SCD9
	yloop1 c1b, clmblkdst, rdi, YMM_SCD9 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	8, c1b			;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 640
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 640

;; Do FFT levels 1,2,3,4,5 (actually 4.32 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...

;; Do 512 20_reals_first_fft operations
;;	distance between fft data elements is 128K
;;	do 128 iterations each processing 40 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (64-0)*blkdst	;; We've already prefetched 64 blocks, perfect!
	loops_init 128*2*clm		;; 128 iters of 2*clm
	r5_x5cl_20_reals_first_fft_scratch_preload
b1b:	r5_x5cl_20_reals_first_fft_scratch rsi, 64, 16*clmblkdst8, rdi
	yloop1doublepre b1b, clmblkdst, rdi, YMM_SCD9 ;; 2*clm iters prefetching 4*clm cache lines
	loops	8, b1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 32 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values
;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 128 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R + 2*clm*YMM_SCD4 + 10*2*clm*YMM_SCD8 ;; Real data sin/cos ptr
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 160*2*clm		;; 5 iterations of 32 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst		;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b4b			;; 4 iterations
	bump	rsi, -4*clmblkdst8+16*clmblkdst8
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b5b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst		;; 2*clm iterations
	loops	8, b5b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b5b			;; Test outer loop counter
	bump	rsi, -5*16*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 8 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values
;; Do 308 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 152 macros each processing 32 data values

	start_timer 25
	bump	rdi, -32*2*clm*YMM_SCD2-8*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-8*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 160*2*clm		;; 20 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1 b6b, clmblkdst	;; 2*clm iterations
	loops	8, b6b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	20, b7b			;; Test outer loop counter
	bump	rsi, -20*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 1 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 64 data values
;; Do 158 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 79 macros each processing 64 data values

	start_timer 26
	bump	rdi, -8*2*clm*YMM_SCND2R-10*2*clm*YMM_SCD8+128 ;; Complex data premult/sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
	lea	rdx, [rdi-128-2*clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 80*2*clm, 64, 1, rbp ;; 80 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r8_sg8cl_sixteen_reals_eight_complex_fft8_preload
b8b:	r8_sg8cl_sixteen_reals_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	8, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	10, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 2560 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 3072 doubles.
;; Memory examples are for a 3072K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD1 + 32*2*clm*YMM_SCD1 + 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R +
;;			2*clm*YMM_SCD4 + 16*2*clm*YMM_SCD8 = 126*2*clm 64-byte cache lines

yr4dwpn_pass1sc3072 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 3072K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 191 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 191 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD4+128] ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
pfing	lea	rbp, [rdx+(126-48)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 192*2*clm, 64, 4, rbp ;; 192*2*clm iterations
c8b:	r8_sg4cl_sixteen_reals_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	6, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	lea	rdx, [rdi-128]		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values
;; Do 376 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 188 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 192*2*clm		;; 192 iterations of 2*clm

	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2, rdx, 4*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	48, c7b			;; Test outer loop counter
	bump	rsi, -48*2*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+8*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K
;;	192K	...
;;	...

;; Do 32 six_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values
;; Do 480 three_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 240 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+32*2*clm*YMM_SCD1] ;; Complex data sin/cos ptr
	loops_init 256*2*clm		;; 256 iterations of 2*clm

c4b:	r3_x3cl_six_reals_unfft rsi, 64, 2*clmblkdst8, rdi, 16*2*clm*YMM_SCD1, rdx, 16*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD1		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c4b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD1 ;; Restore sine/cosine pointer

	loops_reset
	r3_x3cl_three_complex_djbunfft_preload
c5b:	r3_x3cl_three_complex_djbunfft rsi, 64, 2*clmblkdst8, rdi, 16*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD1 ;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*6*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K
;;	768K	...
;;	...

;; Do 96 eight_reals_unfft operations
;;	distance between fft data elements is 96K
;;	do 48 macros each processing 32 data values
;; Do 288 four_complex_unfft operations
;;	distance between fft data elements is 96K
;;	do 144 macros each processing 32 data values

	start_timer 19
	mov	rdx, sincos2		;; Load fixed sin/cos data ptr
	bump	rdx, 384*YMM_SCD3	;; Real data sin/cos ptr
	lea	rdi, [rdx+96*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 192*2*clm		;; 192 iterations of 2*clm

	r4_x4cl_eight_reals_unfft_preload
c2b:	r4_x4cl_eight_reals_unfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi, 48*YMM_SCD2, rdx, 48*YMM_SCD2
	loops	2*clm, c2b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	6, c2b			;; 6 iterations
	bump	rsi, -6*clmblkdst8+24*clmblkdst8 ;; Next source pointer
	bump	rdi, -48*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi, 48*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	6, c3b			;; 6 iterations
	bump	rsi, -6*clmblkdst8+24*clmblkdst8 ;; Next source pointer
	bump	rdi, -48*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*24*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K
;;	768K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	768K	1536K	2304K
;;	1K	...
;;	...
;;	767K

;; Do 384 eight_reals_unfft operations
;;	distance between fft data elements is 384K
;;	do 192 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 192*2*clm		;; 192 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c1b:	r4_x4cl_eight_reals_unfft rsi, 64, 24*clmblkdst8, 48*clmblkdst8, rdi, 192*YMM_SCD3
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD3 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	24, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 768
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 768

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	768K	1536K	2304K
;;	1K	...
;;	...
;;	767K
;; On output the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K	...
;;	1536K	...
;;	...

;; Do 384 eight_reals_fft operations
;;	distance between fft data elements is 384K
;;	do 384 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 384*2*clm		;; 48 iters of 4 iters of 2*2*clm
	r4_x2cl_eight_reals_fft_scratch_preload
b1b:	r4_x2cl_eight_reals_fft_scratch rsi, 64, 48*clmblkdst8, rdi
	yloop2 b1b, clmblkdst, rdi, YMM_SCD3 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	48, b1b			;; Test loop counter
	bump	rsi, -48*clmblkdst8	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos ptr
pfing	bump	rcx, -8*blkdst		;; We just prefetched 192 blocks, correct for
					;; code below that will prefetch 8 too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K	...
;;	1536K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K	...
;;	384K	...
;;	...

;; Do 96 eight_reals_fft operations
;; Do 96 four_complex_fft operations
;;	distance between fft data elements is 96K
;;	do 96 macros each processing 32 data values
;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 96K
;;	do 96 macros each processing 32 data values

	start_timer 24
	lea	rdi, [rdx+96*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 96*2*clm		;; 12 iterations of 8 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b2b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 12*clmblkdst8, 24*clmblkdst8, rdi, rdx
	yloop2 b2b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD2 ;; 2*2*clm iterations
	loops	4, b2b			;; 4 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	12, b2b			;; 12 iterations
	bump	rsi, -12*clmblkdst8+48*clmblkdst8
	bump	rdi, -96*YMM_SCD2	;; Restore sin/cos ptr

	loops_init 96*2*clm		;; 12 iterations of 8 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 12*clmblkdst8, 24*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	12, b3b			;; Test loop counter
	bump	rsi, -12*clmblkdst8-48*clmblkdst8 ;; Restore source pointer
	end_timer 24

;; Do FFT levels 6,7 (actually 1.585 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K	...
;;	384K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 32 six_reals_fft operations
;; Do 32 three_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values
;; Do 448 three_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 224 macros each processing 32 data values

	start_timer 23
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R + 2*clm*YMM_SCD4 + 16*2*clm*YMM_SCD8 ;; Real data sin/cos ptr
	lea	rdi, [rdx+32*2*clm*YMM_SCD1] ;; Real data sin/cos ptr
	loops_init 256*2*clm		;; 2 sets of 16 iters of 8 of 2*clm
	r3_x3cl_six_reals_three_complex_djbfft_preload
b4b:	r3_x3cl_six_reals_three_complex_djbfft rsi, 64, 4*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst		;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD1 ;; Restore sin/cos ptr

	loops_reset
	r3_x3cl_three_complex_djbfft_preload
b5b:	r3_x3cl_three_complex_djbfft rsi, 64, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst		;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD1 ;; Restore sin/cos ptr
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*12*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 8 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values
;; Do 368 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 184 macros each processing 32 data values

	start_timer 25
	bump	rdi, -32*2*clm*YMM_SCD1-8*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-8*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 192*2*clm		;; 24 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1nopre b6b, clmblkdst	;; 2*clm iterations
	loops	8, b6b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	24, b7b			;; Test outer loop counter
	bump	rsi, -24*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 1 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 64 data values
;; Do 190 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 95 macros each processing 64 data values

	start_timer 26
	bump	rdi, -8*2*clm*YMM_SCND2R-16*2*clm*YMM_SCD8+128 ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
	lea	rdx, [rdi-128-2*clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 96*2*clm, 64, 1, rbp ;; 96 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r8_sg8cl_sixteen_reals_eight_complex_fft8_preload
b8b:	r8_sg8cl_sixteen_reals_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	6, b9b			;; Test outer loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 3072 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 3584 doubles.
;; Memory examples are for a 3584K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD2 + 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R +
;;			2*clm*YMM_SCD4 + 14*2*clm*YMM_SCD8 = 150*2*clm 64-byte cache lines

yr4dwpn_pass1sc3584 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 3584K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 223 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 223 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD4+128] ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
pfing	lea	rbp, [rdx+(150-56)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 224*2*clm, 64, 4, rbp ;; 224*2*clm iterations
c8b:	r8_sg4cl_sixteen_reals_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	8, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	14, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	lea	rdx, [rdi-128]		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values
;; Do 440 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 220 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 224*2*clm		;; 224 iterations of 2*clm
	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2, rdx, 4*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	56, c7b			;; Test outer loop counter
	bump	rsi, -56*2*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+8*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values
;; Do 416 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 208 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 224*2*clm		;; 224 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c4b:	r4_x4cl_eight_reals_unfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2, rdx, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c4b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c5b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	14, c5b			;; Test outer loop counter
	bump	rsi, -14*8*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 1,2,3,4,5 (actually 4.807 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	896K	1792K	2688K
;;	1K	...
;;	...
;;	895K

;; Do 512 28_reals_last_unfft operations
;;	distance between fft data elements is 128K
;;	do 64 macros each processing 112 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 64*2*clm		;; 64iterations of 2*clm
	r7_x14cl_28_reals_last_unfft_preload
c1b:	r7_x14cl_28_reals_last_unfft rsi, 64, 8*clmblkdst8, rdi, 64*YMM_SCD13
	yloop1quadpre c1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	8, c1b			;; 8 iterations
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 896
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 896

;; Do FFT levels 1,2,3,4,5 (actually 4.807 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	896K	1792K	2688K
;;	1K	...
;;	...
;;	895K
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...

;; Do 512 28_reals_first_fft operations
;;	distance between fft data elements is 128K
;;	do 128 iterations each processing 56 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (256-24)*blkdst	;; We've already prefetched 256 blocks, but
					;; code below will fetch 24 blocks too many
	loops_init 128*2*clm		;; 128 iters of 2*clm
	r7_x7cl_28_reals_first_fft_scratch_preload
b1b:	r7_x7cl_28_reals_first_fft_scratch rsi, 64, 16*clmblkdst8, rdi
	yloop1doublepre b1b, clmblkdst, rdi, YMM_SCD13 ;; 2*clm iters prefetching 4*clm cache lines
	loops	8, b1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 32 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values
;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 192 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R + 2*clm*YMM_SCD4 + 14*2*clm*YMM_SCD8 ;; Real data sin/cos ptr
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 224*2*clm		;; 7 iterations of 32 iters of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1nopre b4b, clmblkdst	;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b4b			;; 4 iterations
	bump	rsi, -4*clmblkdst8+16*clmblkdst8
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b5b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	7, b5b			;; Test outer loop counter
	bump	rsi, -7*16*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 8 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values
;; Do 432 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 216 macros each processing 32 data values

	start_timer 25
	bump	rdi, -32*2*clm*YMM_SCD2-8*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-8*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 224*2*clm		;; 28 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1nopre b6b, clmblkdst	;; 2*clm iterations
	loops	8, b6b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	28, b7b			;; Test outer loop counter
	bump	rsi, -28*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 1 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 64 data values
;; Do 222 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 111 macros each processing 64 data values

	start_timer 26
	bump	rdi, -8*2*clm*YMM_SCND2R-14*2*clm*YMM_SCD8+128 ;; Complex data premult/sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
	lea	rdx, [rdi-128-2*clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 112*2*clm, 64, 1, rbp ;; 112 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r8_sg8cl_sixteen_reals_eight_complex_fft8_preload
b8b:	r8_sg8cl_sixteen_reals_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	8, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	14, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 3584 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 FFT of length 4096 doubles.
;; Memory examples are for a 4M FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD2 + 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R +
;;			2*clm*YMM_SCD4 + 16*2*clm*YMM_SCD8 = 158*2*clm 64-byte cache lines

yr4dwpn_pass1sc4096 MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b, b8b, b9b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b, c8b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 0, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 4M FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 1 sixteen_reals_unfft operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 32 data values
;; Do 255 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 255 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdx, PREMULT_ADDR	;; Real data sin/cos pointer
	lea	rdi, [rdx+2*clm*YMM_SCD4+128] ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
pfing	lea	rbp, [rdx+(158-32)*2*clm*64] ;; Finish prefetching the sin/cos data
	loops_init_prefetch 256*2*clm, 64, 8, rbp ;; 256*2*clm iterations
c8b:	r8_sg4cl_sixteen_reals_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, c8b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	8, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	lea	rdx, [rdi-128]		;; Next real data sin/cos pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft operations
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values
;; Do 504 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 252 macros each processing 32 data values

	start_timer 17
	lea	rdi, [rdx+8*2*clm*YMM_SCND2R] ;; Complex data sin/cos ptr
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r4_x4cl_wpn_eight_reals_unfft_preload
c6b:	r4_x4cl_wpn_eight_reals_unfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2, rdx, 4*2*clm*YMM_SCND2R
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	loops	2*clm, c6b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c6b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	64, c7b			;; Test outer loop counter
	bump	rsi, -64*2*clmblkdst8	;; Restore source pointer
	lea	rdx, [rdi+8*2*clm*YMM_SCND2] ;; Next real data sin/cos ptr
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft operations
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values
;; Do 480 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 240 macros each processing 32 data values

	start_timer 18
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Complex data sin/cos ptr
	loops_init 256*2*clm		;; 256 iterations of 2*clm

	r4_x4cl_eight_reals_unfft_preload
c4b:	r4_x4cl_eight_reals_unfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2, rdx, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	2*clm, c4b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c4b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2 ;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c5b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2 ;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*8*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K
;;	1024K	...
;;	...

;; Do 128 eight_reals_unfft operations
;;	distance between fft data elements is 128K
;;	do 64 macros each processing 32 data values
;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 128K
;;	do 192 macros each processing 32 data values

	start_timer 19
	mov	rdx, sincos2		;; Load fixed sin/cos data ptr
	bump	rdx, 512*YMM_SCD3	;; Real data sin/cos ptr
	lea	rdi, [rdx+128*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 256*2*clm		;; 256 iterations of 2*clm

	r4_x4cl_eight_reals_unfft_preload
c2b:	r4_x4cl_eight_reals_unfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi, 64*YMM_SCD2, rdx, 64*YMM_SCD2
	loops	2*clm, c2b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	8, c2b			;; 2 iterations
	bump	rsi, -8*clmblkdst8+32*clmblkdst8 ;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi, 64*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sin/cos ptr
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	8, c3b			;; 2 iterations
	bump	rsi, -8*clmblkdst8+32*clmblkdst8 ;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*32*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K
;;	1024K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	1024K	2048K	3072K
;;	1K	...
;;	...
;;	1023K

;; Do 512 eight_reals_unfft operations
;;	distance between fft data elements is 512K
;;	do 256 macros each processing 32 data values

	start_timer 20
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r4_x4cl_eight_reals_unfft_preload
c1b:	r4_x4cl_eight_reals_unfft rsi, 64, 32*clmblkdst8, 64*clmblkdst8, rdi, 256*YMM_SCD3
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD3 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	32, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 1024
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 1024

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	1024K	2048K	3072K
;;	1K	...
;;	...
;;	1023K
;; On output the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K	...
;;	2048K	...
;;	...

;; Do 512 eight_reals_fft operations
;;	distance between fft data elements is 512K
;;	do 512 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 512*2*clm		;; 64 iters of 4 iters of 2*2*clm
	r4_x2cl_eight_reals_fft_scratch_preload
b1b:	r4_x2cl_eight_reals_fft_scratch rsi, 64, 64*clmblkdst8, rdi
	yloop2 b1b, clmblkdst, rdi, YMM_SCD3 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*clmblkdst8	;; Restore source pointer
	mov	rdx, rdi		;; Next real data sin/cos ptr
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K	...
;;	2048K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 128 four_complex_fft operations
;;	distance between fft data elements is 128K
;;	do 128 macros each processing 32 data values
;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 128K
;;	do 128 macros each processing 32 data values

	start_timer 23
	lea	rdi, [rdx+128*YMM_SCD2]	;; Complex data sin/cos ptr
	loops_init 128*2*clm		;; 16 iters of 8 of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b2b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 16*clmblkdst8, 32*clmblkdst8, rdi, rdx
	yloop1 b2b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD2 ;; 2*clm iterations
	loops	8, b2b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	16, b2b			;; Test loop counter
	bump	rsi, -16*clmblkdst8+64*clmblkdst8 ;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sin/cos ptr

	loops_init 128*2*clm		;; 16 iters of 8 of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 16*clmblkdst8, 32*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*clmblkdst8-64*clmblkdst8 ;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 32 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values
;; Do 448 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 224 macros each processing 32 data values

	start_timer 24
	mov	rdx, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdx, 8*2*clm*YMM_SCND2 + 8*2*clm*YMM_SCND2R + 2*clm*YMM_SCD4 + 16*2*clm*YMM_SCD8 ;; Real data sin/cos ptr
	lea	rdi, [rdx+32*2*clm*YMM_SCD2] ;; Real data sin/cos ptr
	loops_init 256*2*clm		;; 8 iters of 32 of 2*clm
	r4_x4cl_eight_reals_four_complex_djbfft_preload
b4b:	r4_x4cl_eight_reals_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b4b, clmblkdst	;; 2*clm iterations
	loops	8, b4b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_four_complex_djbfft_preload
b5b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*16*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 8 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values
;; Do 496 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 248 macros each processing 32 data values

	start_timer 25
	bump	rdi, -32*2*clm*YMM_SCD2-8*2*clm*YMM_SCND2 ;; Complex data sin/cos ptr
	lea	rdx, [rdi-8*2*clm*YMM_SCND2R] ;; Real data sin/cos ptr
	loops_init 256*2*clm		;; 32 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_eight_reals_four_complex_djbfft_preload
b6b:	r4_x4cl_wpn_eight_reals_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, rdx
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCND2R		;; Next sine/cosine pointer
	yloop1 b6b, clmblkdst	;; 2*clm iterations
	loops	8, b6b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr

	loops_reset
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	32, b7b			;; Test outer loop counter
	bump	rsi, -32*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 1 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 1 macros each processing 64 data values
;; Do 254 eight_complex_fft8 operations
;;	distance between fft data elements is 1K
;;	do 127 macros each processing 64 data values

	start_timer 26
	bump	rdi, -8*2*clm*YMM_SCND2R-16*2*clm*YMM_SCD8+128 ;; Complex data sin/cos ptr and use -128
					;; addressing to generate 1 byte offsets in radix-8 macro
	lea	rdx, [rdi-128-2*clm*YMM_SCD4] ;; Real data sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 128*2*clm, 64, 1, rbp ;; 128 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
	r8_sg8cl_sixteen_reals_eight_complex_fft8_preload
b8b:	r8_sg8cl_sixteen_reals_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128, rdx
	bump	rdi, YMM_SCD8		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD4		;; Next sine/cosine pointer
	loops	2*clm, b8b		;; 2*clm iterations
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore sin/cos pointer

	loops_reset
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	8, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 4096 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 1280 doubles.
;; Memory examples are for a 1280K FFT with 10 levels done in pass 2.
;; Prefetch 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCD8 = 64*2*clm 64-byte cache lines

yr4dwpn_pass1sc1280ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b5b, b7b, b9b, c0b, c1b, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1280K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 8,9,10
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 80 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 80 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(64-40)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 80*2*clm, 64, 2, rbp ;; 80*2*clm iterations
	bump	rdi, 128		;; Generates 1 byte offsets in radix-8 macro
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	10, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	4, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	bump	rdi, -128		;; Next sin/cos data pointer
	end_timer 16

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 160 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 80 macros each processing 32 data values

	start_timer 17
	loops_init 80*2*clm		;; 80 iterations of 2*clm
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	20, c7b			;; Test outer loop counter
	bump	rsi, -20*2*clmblkdst8	;; Restore source pointer
	bump	rdi, 8*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 4,5 (actually 2.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K
;;	320K	...
;;	...

;; Do 128 five_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 64 macros each processing 40 data values

	start_timer 18
	loops_init 64*2*clm		;; 64 iterations of 2*clm
	r5_x5cl_five_complex_djbunfft_preload
c5b:	r5_x5cl_five_complex_djbunfft rsi, 64, 2*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+10*clmblkdst8 ;; Next source pointer
	bump	rdi, -2*8*2*clm*YMM_SCD2 ;; Restore sine/cosine pointer
	loops	4, c5b			;; Test outer loop counter
	bump	rsi, -4*10*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K
;;	320K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K

;; Do 160 four_complex_unfft operations
;;	distance between fft data elements is 160K
;;	do 80 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 80*2*clm		;; 80 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 10*clmblkdst8, 20*clmblkdst8, rdi, 80*YMM_SCD2, rdx, 80*YMM_SCD4
	yloop2 c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iterations
	loops	4, c1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	10, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 320
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 320

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K
;; On output the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K	...
;;	640K	...
;;	...

;; Do 160 four_complex_first_fft operations
;;	distance between fft data elements is 160K
;;	do 160 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
pfing	bump	rcx, (40-8)*blkdst	;; We've already prefetched 40 blocks, but
					;; code below prefetches 8 blocks too many
	loops_init 160*2*clm		;; 20 iters of 4 iters of 2*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 20*clmblkdst8, rdi, rdx
	yloop2 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	20, b1b			;; Test loop counter
	bump	rsi, -20*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 4,5 (actually 2.32 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K	...
;;	640K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 128 five_complex_fft operations
;;	distance between fft data elements is 40K
;;	do 64 macros each processing 40 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 8*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCD8
	loops_init 64*2*clm		;; 2 iters of 4 iters of 8 of 2*clm
	r5_x5cl_five_complex_djbfft_preload
b5b:	r5_x5cl_five_complex_djbfft rsi, 64, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1doublepre b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+20*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b5b			;; Test outer loop counter
	bump	rsi, -2*20*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 160 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 80 macros each processing 32 data values

	start_timer 25
	bump	rdi, -8*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 80*2*clm		;; 20 iterations of 2 iters of 2*2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst		;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	10, b7b			;; Test outer loop counter
	bump	rsi, -10*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 8,9,10
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 80 eight_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 40 macros each processing 64 data values

	start_timer 26
	bump	rdi, -4*2*clm*YMM_SCD8+128 ;; Next premult/sin/cos ptr (gen 1 byte offsets in radix-8 macro)
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 40*2*clm, 64, 1, rbp ;; 40 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	10, b9b			;; Test outer loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	4, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 1280 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 1536 doubles.
;; Memory examples are for a 1536K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCD1 + 4*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD4 = 48*2*clm 64-byte cache lines

yr4dwpn_pass1sc1536ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b, c0b, c1b, c3b, c5b, c7a, c7b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 1536K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 192 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 192 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(48-24)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 192*2*clm, 64, 8, rbp ;; 192*2*clm iterations
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	3, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 96 macros each processing 32 data values

	start_timer 17
	loops_init 96*2*clm		;; 96*2*clm iterations
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	48, c7b			;; Test outer loop counter
	bump	rsi, -48*clmblkdst8	;; Restore source pointer
	bump	rdi, 4*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...

;; Do 256 three_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 24 data values

	start_timer 18
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r3_x3cl_three_complex_djbunfft_preload
c5b:	r3_x3cl_three_complex_djbunfft rsi, 64, clmblkdst8, rdi, 8*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+3*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD1	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*3*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 48K
;;	do 96 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 192*YMM_SCD2	;; Sin/cos ptr
	loops_init 96*2*clm		;; 96*2*clm iterations
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 3*clmblkdst8, 6*clmblkdst8, rdi, 24*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -24*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*12*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	23K
;;	96K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 192K
;;	do 96 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 96*2*clm		;; 96 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 12*clmblkdst8, 24*clmblkdst8, rdi, 96*YMM_SCD2, rdx, 96*YMM_SCD4
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	12, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 384
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 384

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K
;; On output the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K	...
;;	768K	...
;;	...

;; Do 192 four_complex_first_fft operations
;;	distance between fft data elements is 192K
;;	do 192 macros each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 192*2*clm		;; 24 iters of 4 iters of 2*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 24*clmblkdst8, rdi, rdx
	yloop2 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	24, b1b			;; Test loop counter
	bump	rsi, -24*clmblkdst8	;; Restore source pointer
pfing	bump	rcx, -32*blkdst		;; We just prefetched 96 blocks, correct for
					;; code below which prefetches 32 blocks too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K	...
;;	768K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K	...
;;	192K	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 48K
;;	do 96 macros each processing 32 data values

	start_timer 23
	loops_init 96*2*clm		;; 6 iterations of 16 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	6, b3b			;; Test middle loop counter
	bump	rsi, -6*clmblkdst8+24*clmblkdst8 ;; Next source pointer
	bump	rdi, -48*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*24*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7 (actually 1.585 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K	...
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 256 three_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 24 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 4*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD4
	loops_init 128*2*clm		;; 2 iters of 8 iters of 8 of 2*clm
	r3_x3cl_three_complex_djbfft_preload
b5b:	r3_x3cl_three_complex_djbfft rsi, 64, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst		;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b5b			;; Test middle loop counter
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD1	;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*6*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 96 macros each processing 32 data values

	start_timer 25
	bump	rdi, -4*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 96*2*clm		;; 24 iterations of 4 iters of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	24, b7b			;; Test outer loop counter
	bump	rsi, -24*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 96 macros each processing 32 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD4	;; Next premult/sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 96*2*clm, 64, 4, rbp ;; 96 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	3, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 1536 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 2048 doubles.
;; Memory examples are for a 2048K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCND2 + 4*2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4 = 68*2*clm 64-byte cache lines

yr4dwpn_pass1sc2048ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b
	LOCAL	c0b, c1b, c3b, c5b, c7a, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 2M FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 256 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 256 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(68-32)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 256*2*clm, 64, 8, rbp ;; 256*2*clm iterations
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	4, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 128 macros each processing 32 data values

	start_timer 17
	loops_init 128*2*clm		;; 128*2*clm iterations
	r4_x4cl_four_complex_djbunfft_preload
c7b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	64, c7b			;; Test outer loop counter
	bump	rsi, -64*clmblkdst8	;; Restore source pointer
	bump	rdi, 4*2*clm*YMM_SCD2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...

;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 32 data values

	start_timer 18
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r4_x4cl_wpn_four_complex_djbunfft_preload
c5b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi, 8*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*4*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K
;;	512K	...
;;	...

;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 64K
;;	do 128 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 256*YMM_SCD2	;; Sin/cos ptr
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi, 32*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, c3b			;; 8 iterations
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*16*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K

;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 256K
;;	do 128 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 128*2*clm		;; 128 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 16*clmblkdst8, 32*clmblkdst8, rdi, 128*YMM_SCD2, rdx, 128*YMM_SCD4
	yloop1nopre c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	16, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 512
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 512

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K
;; On output the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K	...
;;	1024K	...
;;	...

;; Do 256 four_complex_first_fft operations
;;	distance between fft data elements is 256K
;;	do 256 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 256*2*clm		;; 32 iters of 4 iters of 2*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 32*clmblkdst8, rdi, rdx
	yloop2 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	32, b1b			;; Test loop counter
	bump	rsi, -32*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K	...
;;	1024K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...

;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 64K
;;	do 128 macros each processing 32 data values

	start_timer 23
	loops_init 128*2*clm		;; 2 iters of 8 iters of 8 of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst8+32*clmblkdst8 ;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*32*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 32 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 4*2*clm*YMM_SCD2 + 16*2*clm*YMM_SCD4
	loops_init 128*2*clm		;; 8 iters of 2 iters of 8 of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b5b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b5b			;; Test middle loop counter
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCND2 ;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*8*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 128 macros each processing 32 data values

	start_timer 25
	bump	rdi, -4*2*clm*YMM_SCD2	;; Next sin/cos ptr
	loops_init 128*2*clm		;; 32 iterations of 4 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b7b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	32, b7b			;; Test outer loop counter
	bump	rsi, -32*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 32 macros each processing 32 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD4	;; Next premult/sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 128*2*clm, 64, 2, rbp ;; 128 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	4, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 2048 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 2560 doubles.
;; Memory examples are for a 2560K FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 16*2*clm*YMM_SCD2 + 4*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD4 = 56*2*clm 64-byte cache lines

yr4dwpn_pass1sc2560ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b, c0b, c1b, c3b, c5b, c7a, c7b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 2560K FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...

;; Do 320 four_complex_unfft4 operations
;;	distance between fft data elements is 1K
;;	do 320 macros each processing 16 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(56-20)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 320*2*clm, 64, 16, rbp ;; 320*2*clm iterations
c9b:	r4_sg2cl_four_complex_unfft4 rsi, 64, blkdst, rcx, 64, clmblkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+2*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+2*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sin/cos data pointer
	loops	4, c9b
	bump	rcx, -4*2*clmblkdst+clmblkdst8
	loops	5, c9b
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	1K	...
;;	8K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 4K
;;	do 160 macros each processing 32 data values

	start_timer 17
	loops_init 160*2*clm		;; 160*2*clm iterations
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 2*clmblkdst, 4*clmblkdst, rdi, 2*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	2, c7b			;; 2 iterations
	bump	rsi, -2*clmblkdst+clmblkdst8 ;; Next source pointer
	bump	rdi, -2*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	80, c7b			;; Test outer loop counter
	bump	rsi, -80*clmblkdst8	;; Restore source pointer
	bump	rdi, 4*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	40K	80K	120K
;;	1K	...
;;	...
;;	39K
;;	160K	...
;;	...

;; Do 256 five_complex_unfft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 40 data values

	start_timer 18
	loops_init 128*2*clm		;; 128 iterations of 2*clm
	r5_x5cl_five_complex_djbunfft_preload
c5b:	r5_x5cl_five_complex_djbunfft rsi, 64, clmblkdst8, rdi, 8*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next sin/cos ptr
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+5*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCD2	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*5*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	40K	80K	120K
;;	1K	...
;;	...
;;	39K
;;	160K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K
;;	640K	...
;;	...

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 80K
;;	do 160 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 320*YMM_SCD2	;; Sin/cos ptr
	loops_init 160*2*clm		;; 160*2*clm iterations
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 5*clmblkdst8, 10*clmblkdst8, rdi, 40*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sin/cos ptr
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	5, c3b			;; Test middle loop counter
	bump	rsi, -5*clmblkdst8+20*clmblkdst8 ;; Next source pointer
	bump	rdi, -40*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*20*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K
;;	640K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 320K
;;	do 160 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 160*2*clm		;; 160 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 20*clmblkdst8, 40*clmblkdst8, rdi, 160*YMM_SCD2, rdx, 160*YMM_SCD4
	yloop1 c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	20, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 640
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 640

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K
;; On output the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K	...
;;	1280K	...
;;	...

;; Do 320 four_complex_first_fft operations
;;	distance between fft data elements is 320K
;;	do 320 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 320*2*clm		;; 40 iters of 2 iters of 4*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 40*clmblkdst8, rdi, rdx
	yloop4 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 4*2*clm iters prefetching 2*clm cache lines
	loops	2, b1b			;; 2 iterations
	bump	rsi, -2*4*clmblkdst+clmblkdst8
	loops	40, b1b			;; Test loop counter
	bump	rsi, -40*clmblkdst8	;; Restore source pointer
pfing	bump	rcx, -16*blkdst		;; We just prefetched 80 blocks, correct for
					;; code below which will prefetch 16 blocks too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K	...
;;	1280K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K	...
;;	320K	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 80K
;;	do 160 macros each processing 32 data values

	start_timer 23
	loops_init 160*2*clm		;; 10 iterations of 16 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 10*clmblkdst8, 20*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	10, b3b			;; Test middle loop counter
	bump	rsi, -10*clmblkdst8+40*clmblkdst8 ;; Next source pointer
	bump	rdi, -80*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*40*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7 (actually 2.322 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K	...
;;	320K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...

;; Do 256 five_complex_fft operations
;;	distance between fft data elements is 16K
;;	do 128 macros each processing 40 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 4*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD4
	loops_init 128*2*clm		;; 2 iters of 8 iters of 8 of 2*clm
	r5_x5cl_five_complex_djbfft_preload
b5b:	r5_x5cl_five_complex_djbfft rsi, 64, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1doublepre b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	2, b5b			;; Test middle loop counter
	bump	rsi, -2*clmblkdst8+10*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*10*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 4K
;;	do 160 macros each processing 32 data values

	start_timer 25
	bump	rdi, -4*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 160*2*clm		;; 40 iterations of 4 iters of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	4, b7b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	40, b7b			;; Test outer loop counter
	bump	rsi, -40*2*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 160 macros each processing 32 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD4	;; Next premult/sin/cos ptr
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 160*2*clm, 64, 4, rbp ;; 160 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r4_sg4cl_four_complex_fft4 rsi, 64, clmblkdst, 2*clmblkdst, rcx, 64, blkdst, 2*blkdst, rdi
	bump	rdi, YMM_SCD4		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+4*clmblkdst ;; Next source pointer
	bump	rcx, -2*clm*64+4*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD4	;; Restore premult/sine/cosine pointer
	loops	2, b9b			;; Test loop counter
	bump	rsi, -2*4*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	5, b9b			;; Test loop counter
	bump	rdi, 2*clm*YMM_SCD4	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 2560 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 3072 doubles.
;; Memory examples are for a 3M FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD1 + 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8 = 96*2*clm 64-byte cache lines

yr4dwpn_pass1sc3072ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b, c0b, c1a, c1b, c3b, c5b, c7b, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 3M FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 192 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 192 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(96-48)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 192*2*clm, 64, 4, rbp ;; 192*2*clm iterations
	bump	rdi, 128		;; Generates 1 byte offsets in radix-8 macro
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	6, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	bump	rdi, -128		;; Next sin/cos data pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 192 macros each processing 32 data values

	start_timer 17
	loops_init 192*2*clm		;; 192*2*clm iterations
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	48, c7b			;; Test outer loop counter
	bump	rsi, -48*2*clmblkdst8	;; Restore source pointer
	bump	rdi, 8*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K
;;	192K	...
;;	...

;; Do 512 three_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 24 data values

	start_timer 18
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r3_x3cl_three_complex_djbunfft_preload
c5b:	r3_x3cl_three_complex_djbunfft rsi, 64, 2*clmblkdst8, rdi, 16*2*clm*YMM_SCD1
	bump	rdi, YMM_SCD1		;; Next sin/cos ptr
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+6*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD1 ;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*6*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	1K	...
;;	...
;;	47K
;;	192K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K
;;	768K	...
;;	...

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 96K
;;	do 192 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 384*YMM_SCD2	;; Sin/cos ptr
	loops_init 192*2*clm		;; 192 iterations of 2*clm
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 6*clmblkdst8, 12*clmblkdst8, rdi, 48*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sin/cos ptr
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	6, c3b			;; 6 iterations
	bump	rsi, -6*clmblkdst8+24*clmblkdst8 ;; Next source pointer
	bump	rdi, -48*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*24*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	192K	384K	576K
;;	1K	...
;;	...
;;	191K
;;	768K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	768K	1536K	2304K
;;	1K	...
;;	...
;;	767K

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 384K
;;	do 192 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 192*2*clm		;; 192 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 24*clmblkdst8, 48*clmblkdst8, rdi, 192*YMM_SCD2, rdx, 192*YMM_SCD4
	yloop1 c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	24, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 768
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 768

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	768K	1536K	2304K
;;	1K	...
;;	...
;;	767K
;; On output the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K	...
;;	1536K	...
;;	...

;; Do 384 four_complex_first_fft operations
;;	distance between fft data elements is 384K
;;	do 384 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 384*2*clm		;; 48 iters of 4 iters of 2*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 48*clmblkdst8, rdi, rdx
	yloop2 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	48, b1b			;; Test loop counter
	bump	rsi, -48*clmblkdst8	;; Restore source pointer
pfing	bump	rcx, -64*blkdst		;; We just prefetched 192 blocks, correct for code
					;; below which will prefetch 64 blocks too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	384K	768K	1152K
;;	1K	...
;;	...
;;	383K	...
;;	1536K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K	...
;;	384K	...
;;	...

;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 96K
;;	do 192 macros each processing 32 data values

	start_timer 23
	loops_init 192*2*clm		;; 6 iterations of 32 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 12*clmblkdst8, 24*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	12, b3b			;; Test middle loop counter
	bump	rsi, -12*clmblkdst8+48*clmblkdst8 ;; Next source pointer
	bump	rdi, -96*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*48*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7 (actually 1.585 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	96K	192K	288K
;;	1K	...
;;	...
;;	95K	...
;;	384K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 512 three_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 24 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8
	loops_init 256*2*clm		;; 2 iters of 16 iters of 8 of 2*clm
	r3_x3cl_three_complex_djbfft_preload
b5b:	r3_x3cl_three_complex_djbfft rsi, 64, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCD1		;; Next sine/cosine pointer
	yloop1 b5b, clmblkdst		;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+12*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD1 ;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*12*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 192 macros each processing 32 data values

	start_timer 25
	bump	rdi, -8*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 192*2*clm		;; 24 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1 b7b, clmblkdst	;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	24, b7b			;; Test outer loop counter
	bump	rsi, -24*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 192 eight_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 96 macros each processing 64 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD8+128 ;; Next premult/sin/cos ptr (gen 1 byte offsets in radix-8 macro)
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 96*2*clm, 64, 2, rbp ;; 96 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	6, b9b			;; Test outer loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 3072 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 4096 doubles.
;; Memory examples are for a 4M FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8 = 112*2*clm 64-byte cache lines

yr4dwpn_pass1sc4096ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b, c0b, c1b, c3b, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 4M FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 256 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 256 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(112-64)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 256*2*clm, 64, 4, rbp ;; 256*2*clm iterations
	bump	rdi, 128		;; Generates 1 byte offsets in radix-8 macro
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	8, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	bump	rdi, -128		;; Next sin/cos data pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 256 macros each processing 32 data values

	start_timer 17
	loops_init 256*2*clm		;; 256*2*clm iterations
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	64, c7b			;; Test outer loop counter
	bump	rsi, -64*2*clmblkdst8	;; Restore source pointer
	bump	rdi, 8*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 32 data values

	start_timer 18
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r4_x4cl_four_complex_djbunfft_preload
c5b:	r4_x4cl_four_complex_djbunfft rsi, 64, 2*clmblkdst8, 4*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+8*clmblkdst8 ;; Next source pointer
	bump	rdi, -2*8*2*clm*YMM_SCD2 ;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*8*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	1K	...
;;	...
;;	63K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K
;;	1024K	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 128K
;;	do 256 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 512*YMM_SCD2	;; Sin/cos ptr
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 8*clmblkdst8, 16*clmblkdst8, rdi, 64*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst8+32*clmblkdst8 ;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*32*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	1K	...
;;	...
;;	255K
;;	1024K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	1024K	2048K	3072K
;;	1K	...
;;	...
;;	1023K

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 512K
;;	do 256 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 256*2*clm		;; 256 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 32*clmblkdst8, 64*clmblkdst8, rdi, 256*YMM_SCD2, rdx, 256*YMM_SCD4
	yloop1 c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	32, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 1024
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 1024

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	1024K	2048K	3072K
;;	1K	...
;;	...
;;	1023K
;; On output the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K	...
;;	2048K	...
;;	...

;; Do 512 four_complex_first_fft operations
;;	distance between fft data elements is 512K
;;	do 512 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 512*2*clm		;; 64 iters of 4 iters of 2*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 64*clmblkdst8, rdi, rdx
	yloop2 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*2*clm iters prefetching 2*clm cache lines
	loops	4, b1b			;; 4 iterations
	bump	rsi, -4*2*clmblkdst+clmblkdst8
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*clmblkdst8	;; Restore source pointer
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	512K	1024K	1536K
;;	1K	...
;;	...
;;	511K	...
;;	2048K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 128K
;;	do 256 macros each processing 32 data values

	start_timer 23
	loops_init 256*2*clm		;; 2 iters of 16 iters of 8 of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 16*clmblkdst8, 32*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	16, b3b			;; Test middle loop counter
	bump	rsi, -16*clmblkdst8+64*clmblkdst8 ;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*64*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	1K	...
;;	...
;;	127K	...
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 32 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8
	loops_init 256*2*clm		;; 8 iters of 4 iters of 8 of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b5b:	r4_x4cl_four_complex_djbfft rsi, 64, 4*clmblkdst8, 8*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1	b5b, clmblkdst		;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+16*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2	;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*16*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 256 macros each processing 32 data values

	start_timer 25
	bump	rdi, -8*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 256*2*clm		;; 32 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1	b7b, clmblkdst		;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	32, b7b			;; Test outer loop counter
	bump	rsi, -32*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 256 eight_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 128 macros each processing 64 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD8+128 ;; Next premult/sin/cos ptr (gen 1 byte offsets in radix-8 macro)
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 128*2*clm, 64, 2, rbp ;; 128 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	8, b9b			;; Test outer loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 4096 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


;; Perform a pass 1 all-complex FFT of length 5120 doubles.
;; Memory examples are for a 5M FFT with 10 levels done in pass 2.
;; Sin/cos data needed: 32*2*clm*YMM_SCD2 + 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8 = 112*2*clm 64-byte cache lines

yr4dwpn_pass1sc5120ac MACRO fftname, pass2_levels, clmarg
	LOCAL	b0b, b1b, b3b, b5b, b7b, b9b, c0b, c1b, c3b, c5b, c7b, c9a, c9b
	LOCAL	pass2, endlp, yes_fft

	set_FFT_constants fftname, 0, 1, pass2_levels, clmarg
	yfft_header

;; Jump to pass 2 FFT code if the FFT has already been started

	clear_timers
	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump if FFT already started

;; Fire up auxillary threads to do pass 1 forward FFT

	pass1_forward_fft_setup endlp
	jmp	b0b			;; Jump to forward fft code

;; Do pass 2 (the last 10 FFT levels if this is a 5M FFT)

pass2:	start_timer 0
	call	ypass2name
	end_timer 0
	cmp	ffttype, 1		;; We're done if FFTing only
	je	ygw_finish_fft

;; Do the inverse FFT

	pass1_inverse_fft_setup endlp

;; Do inverse FFT levels 10,11,12
;; On input the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K
;;	...
;; On input the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K
;;	...
;; On output the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...

;; Do 320 eight_complex_unfft8 operations
;;	distance between fft data elements is 1K
;;	do 320 macros each processing 32 data values

c0b:	start_timer 16
	mov	rsi, DATA_ADDR		;; Get source address
	mov	rcx, scratch_area	;; Get address of scratch area
	mov	rdi, PREMULT_ADDR	;; Load premult/sin/cos pointer
pfing	lea	rbp, [rdi+(112-40)*2*clm*64] ;; Finish prefetching the sin/cos/premult data
	loops_init_prefetch 320*2*clm, 64, 8, rbp ;; 320*2*clm iterations
	bump	rdi, 128		;; Generates 1 byte offsets in radix-8 macro
c9b:	r8_sg4cl_eight_complex_unfft8 rsi, 64, blkdst, 2*blkdst, rcx, 64, clmblkdst, 2*clmblkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos data
	loops	2*clm, c9b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+4*blkdst	;; Next source pointer
	bump	rcx, -2*clm*64+4*clmblkdst ;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sin/cos data pointer
	loops	2, c9b
	bump	rcx, -2*4*clmblkdst+clmblkdst8
	loops	10, c9b
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sin/cos pointer
	loops	16, c9b
	mov	rsi, scratch_area	;; Restore source pointer
	bump	rdi, -128		;; Next sin/cos data pointer
	end_timer 16

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	1K	...
;;	...
;;	3K
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 8K
;;	do 320 macros each processing 32 data values

	start_timer 17
	loops_init 320*2*clm		;; 320 iterations of 2*clm
	r4_x4cl_wpn_four_complex_djbunfft_preload
c7b:	r4_x4cl_wpn_four_complex_djbunfft rsi, 64, 4*clmblkdst, clmblkdst8, rdi, 4*2*clm*YMM_SCND2
	bump	rdi, YMM_SCND2		;; Next clm's sin/cos data
	loops	2*clm, c7b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	4, c7b			;; 4 iterations
	bump	rsi, -4*clmblkdst+2*clmblkdst8 ;; Next source pointer
	bump	rdi, -4*2*clm*YMM_SCND2	;; Restore sine/cosine pointer
	loops	80, c7b			;; Test outer loop counter
	bump	rsi, -80*2*clmblkdst8	;; Restore source pointer
	bump	rdi, 8*2*clm*YMM_SCND2	;; Next sin/cos data pointer
	end_timer 17

;; Do inverse FFT levels 6,7 (actually 2.32 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	1K	...
;;	...
;;	15K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K
;;	320K	...
;;	...

;; Do 512 five_complex_unfft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 40 data values

	start_timer 18
	loops_init 256*2*clm		;; 256 iterations of 2*clm
	r5_x5cl_five_complex_djbunfft_preload
c5b:	r5_x5cl_five_complex_djbunfft rsi, 64, 2*clmblkdst8, rdi, 16*2*clm*YMM_SCD2
	bump	rdi, YMM_SCD2		;; Next clm's sin/cos data
	loops	2*clm, c5b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	loops	8, c5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	2, c5b			;; 2 iterations
	bump	rsi, -2*clmblkdst8+10*clmblkdst8 ;; Next source pointer
	bump	rdi, -16*2*clm*YMM_SCD2 ;; Restore sine/cosine pointer
	loops	16, c5b			;; Test outer loop counter
	bump	rsi, -16*10*clmblkdst8	;; Restore source pointer
	end_timer 18

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	80K	160K	240K
;;	1K	...
;;	...
;;	79K
;;	320K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K
;;	1280K	...
;;	...

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 160K
;;	do 320 macros each processing 32 data values

	start_timer 19
	mov	rdi, sincos2		;; Load fixed sin/cos data ptr
	bump	rdi, 640*YMM_SCD2	;; Sin/cos ptr
	loops_init 320*2*clm		;; 320 iterations of 2*clm
	r4_x4cl_four_complex_djbunfft_preload
c3b:	r4_x4cl_four_complex_djbunfft rsi, 64, 10*clmblkdst8, 20*clmblkdst8, rdi, 80*YMM_SCD2
	loops	2*clm, c3b		;; Loop 2*clm times
	bump	rsi, -2*clm*64+clmblkdst ;; Next source pointer
	bump	rdi, YMM_SCD2		;; Next sin/cos ptr
	loops	8, c3b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	10, c3b			;; 10 iterations
	bump	rsi, -10*clmblkdst8+40*clmblkdst8 ;; Next source pointer
	bump	rdi, -80*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test outer loop counter
	bump	rsi, -4*40*clmblkdst8	;; Restore source pointer
	end_timer 19

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	320K	640K	960K
;;	1K	...
;;	...
;;	319K
;;	1280K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	1280K	2560K	3840K
;;	1K	...
;;	...
;;	1279K

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 640K
;;	do 320 macros each processing 32 data values

	start_timer 20
	mov	rdx, sincos1		;; Load fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	loops_init 320*2*clm		;; 320 iterations of 2*clm
c1b:	r4_x4cl_four_complex_last_djbunfft rsi, 64, 40*clmblkdst8, 80*clmblkdst8, rdi, 320*YMM_SCD2, rdx, 320*YMM_SCD4
	yloop1 c1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 2*clm iterations
	loops	8, c1b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	40, c1b			;; Test outer loop counter
	end_timer 20

;; Normalize these values

	pass1_normalize 1, yes_fft

;; Copy data from the scratch area back to the FFT data area

	copy_scratch_data_to_fft 1280
	jmp	endlp			;; Skip FFT code if flag not set

;; Copy data from the FFT data area back to the scratch area

b0b:	copy_fft_data_to_scratch 1280

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	1280K	2560K	3840K
;;	1K	...
;;	...
;;	1279K
;; On output the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K	...
;;	2560K	...
;;	...

;; Do 640 four_complex_first_fft operations
;;	distance between fft data elements is 640K
;;	do 640 iterations each processing 16 data values

yes_fft:start_timer 22
	mov	rsi, scratch_area	;; Get address of scratch area
	mov	rdx, sincos1		;; Address of fixed all-complex premultipliers
	mov	rdi, sincos2		;; Load fixed sin/cos postmultipliers
	set_data_prefetch_ptrs		;; Init prefetching pointers
	loops_init 640*2*clm		;; 80 iters of 2 iters of 4*2*clm
b1b:	r4_x2cl_four_complex_first_djbfft_scratch rsi, 64, 80*clmblkdst8, rdi, rdx
	yloop4 b1b, clmblkdst, rdi, YMM_SCD2, rdx, YMM_SCD4 ;; 4*2*clm iters prefetching 2*clm cache lines
	loops	2, b1b			;; 2 iterations
	bump	rsi, -2*4*clmblkdst+clmblkdst8
	loops	80, b1b			;; Test loop counter
	bump	rsi, -80*clmblkdst8	;; Restore source pointer
pfing	bump	rcx, -32*blkdst		;; We just prefetched 160 blocks, corect for code
					;; below which will prefetch 32 blocks too many
	end_timer 22

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	640K	1280K	1920K
;;	1K	...
;;	...
;;	639K	...
;;	2560K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K	...
;;	640K	...
;;	...

;; Do 640 four_complex_fft operations
;;	distance between fft data elements is 160K
;;	do 320 macros each processing 32 data values

	start_timer 23
	loops_init 320*2*clm		;; 10 iterations of 32 iters of 2*clm
	r4_x4cl_four_complex_djbfft_preload
b3b:	r4_x4cl_four_complex_djbfft rsi, 64, 20*clmblkdst8, 40*clmblkdst8, rdi
	yloop1 b3b, clmblkdst, rdi, YMM_SCD2	;; 2*clm iterations
	loops	8, b3b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+clmblkdst8 ;; Next source pointer
	loops	20, b3b			;; Test middle loop counter
	bump	rsi, -20*clmblkdst8+80*clmblkdst8 ;; Next source pointer
	bump	rdi, -160*YMM_SCD2	;; Restore sin/cos ptr
	loops	2, b3b			;; Test outer loop counter
	bump	rsi, -2*80*clmblkdst8	;; Restore source pointer
	end_timer 23

;; Do FFT levels 6,7 (actually 2.32 levels)
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	160K	320K	480K
;;	1K	...
;;	...
;;	159K	...
;;	640K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...

;; Do 512 five_complex_fft operations
;;	distance between fft data elements is 32K
;;	do 256 macros each processing 40 data values

	start_timer 24
	mov	rdi, PREMULT_ADDR	;; Address of premultiplier/sin/cos table
	bump	rdi, 8*2*clm*YMM_SCND2 + 16*2*clm*YMM_SCD8
	loops_init 256*2*clm		;; 2 iters of 16 iters of 8 of 2*clm
	r5_x5cl_five_complex_djbfft_preload
b5b:	r5_x5cl_five_complex_djbfft rsi, 64, 4*clmblkdst8, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	yloop1doublepre b5b, clmblkdst	;; 2*clm iterations
	loops	8, b5b			;; 8 iterations
	bump	rsi, -8*clmblkdst+clmblkdst8
	loops	4, b5b			;; Test middle loop counter
	bump	rsi, -4*clmblkdst8+20*clmblkdst8 ;; Next source pointer
	bump	rdi, -32*2*clm*YMM_SCD2 ;; Restore sin/cos ptr
	loops	8, b5b			;; Test outer loop counter
	bump	rsi, -8*20*clmblkdst8	;; Restore source pointer
	end_timer 24

;; Do FFT levels 8,9
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	1K	...
;;	...
;;	31K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...

;; Do 640 four_complex_fft operations
;;	distance between fft data elements is 8K
;;	do 320 macros each processing 32 data values

	start_timer 25
	bump	rdi, -8*2*clm*YMM_SCND2	;; Next sin/cos ptr
	loops_init 320*2*clm		;; 40 iterations of 8 iters of 2*clm
	r4_x4cl_wpn_four_complex_djbfft_preload
b7b:	r4_x4cl_wpn_four_complex_djbfft rsi, 64, clmblkdst8, 2*clmblkdst8, rdi
	bump	rdi, YMM_SCND2		;; Next sine/cosine pointer
	yloop1	b7b, clmblkdst		;; 2*clm iterations
	loops	8, b7b			;; Test middle loop counter
	bump	rsi, -8*clmblkdst+4*clmblkdst8 ;; Next source pointer
	bump	rdi, -8*2*clm*YMM_SCND2	;; Restore sin/cos ptr
	loops	40, b7b			;; Test outer loop counter
	bump	rsi, -40*4*clmblkdst8	;; Restore source pointer
	end_timer 25

;; Do FFT levels 10,11,12
;;
;; On input the 64-byte cache lines hold these data values (+512 in high word):
;;	0K	8K	16K	24K
;;	1K	...
;;	...
;;	7K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 2 swizzles:
;;	0K	+512	1K	+512	2K	+512	3K	+512
;;	4K	...
;;	...
;; On output the 64-byte cache lines hold these data values if pass 1 swizzles:
;;	0K	+2K	512	+2K	1K	+2K	1536	+2K
;;	4K	...
;;	...

;; Do 320 eight_complex_fft operations
;;	distance between fft data elements is 1K
;;	do 160 macros each processing 64 data values

	start_timer 26
	bump	rdi, -16*2*clm*YMM_SCD8+128 ;; Next premult/sin/cos ptr (gen 1 byte offsets in radix-8 macro)
	mov	rcx, DATA_ADDR		;; Destination pointer
	loops_init_prefetch 160*2*clm, 64, 2, rbp ;; 160 iters of 2*clm
pfing	mov	rbp, PREMULT_PREFETCH	;; Load premult/sin/cos prefetch pointer
b9b:	r8_sg8cl_eight_complex_fft8 rsi, 64, clmblkdst, 2*clmblkdst, 4*clmblkdst, rcx, 64, blkdst, 2*blkdst, 4*blkdst, rdi-128
	bump	rdi, YMM_SCD8		;; Next premult/sin/cos ptr
	loops	2*clm, b9b
	bump	rsi, -2*clm*64+clmblkdst8 ;; Next source pointer
	bump	rcx, -2*clm*64+8*blkdst	;; Next dest pointer
	bump	rdi, -2*clm*YMM_SCD8	;; Restore premult/sine/cosine pointer
	loops	10, b9b			;; Test outer loop counter
	bump	rdi, 2*clm*YMM_SCD8	;; Next premult/sine/cosine pointer
	loops	16, b9b			;; Test outer loop counter
	end_timer 26

;; Work on next 4*clm sets of 5120 values

endlp:	ypass1_get_next_block pass2, c0b, b0b, _wpn ;; Get next block and jump
	yfft_footer
	ENDM


ENDIF
