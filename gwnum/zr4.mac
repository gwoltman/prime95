;; Include other macro files needed by the AVX-512 versions of our primarily radix-8 traditional FFTs

INCLUDE zr2.mac
INCLUDE zr3.mac
INCLUDE zr5.mac
INCLUDE zr6.mac
INCLUDE zr7.mac
INCLUDE zr8.mac
INCLUDE zr10.mac
INCLUDE zr12.mac
INCLUDE zr16.mac
INCLUDE zr64.mac

;;
;; ************************************* Macros used in one pass FFTs ******************************************
;;


;;GW:  these should be double_four_complex to improve instruction scheduling.  May reduce s/c data loads too.       Use maxrpt arg!

;;
;; ************************************* four-complex-djbfft variants ******************************************
;;
;; Macros to do Daniel J. Bernstein's exponent-1 butterflies.  The
;; difference with a standard four-complex-fft is in the postmultiply step.
;; Instead of multiplying by w^2x, w^x, w^3x, we multiply by w^2x, w^x, w^-x.
;;

; Basic four-complex DJB FFT building block
zr4_four_complex_djbfft_preload MACRO
	zr4_4c_djbfft_cmn_preload
	ENDM
zr4_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,noexec,0,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the 4cl version except vbroadcastsd is used to reduce sin/cos data
zr4b_four_complex_djbfft_preload MACRO
	zr4_4c_djbfft_cmn_preload
	ENDM
zr4b_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	zr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,exec,screg,16,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from the eight-real/four_complex sin/cos table
zr4rb_four_complex_djbfft_preload MACRO
	zr4_4c_djbfft_cmn_preload
	ENDM
zr4rb_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	zr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,exec,screg+8,128,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Common macro to get the four complex djbfft job done

zr4_4c_djbfft_cmn_preload MACRO
	ENDM
zr4_4c_djbfft_cmn MACRO srcreg,srcinc,srcoff,d1,d2,bcast,bcreg,bcsz,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm2, [srcreg+srcoff]		;; R1
	vmovapd	zmm6, [srcreg+srcoff+d2]	;; R3
	vsubpd	zmm0, zmm2, zmm6		;; R1 - R3 (new R3)			; 1-4		n 5

	vmovapd	zmm5, [srcreg+srcoff+64]	;; I1
	vmovapd	zmm7, [srcreg+srcoff+d2+64]	;; I3
	vsubpd	zmm4, zmm5, zmm7		;; I1 - I3 (new I3)			; 1-4		n 5

	vaddpd	zmm2, zmm2, zmm6		;; R1 + R3 (new R1)			; 2-5		n 6

	vmovapd	zmm1, [srcreg+srcoff+d1]	;; R2
	vmovapd	zmm8, [srcreg+srcoff+d2+d1]	;; R4
	vaddpd	zmm3, zmm1, zmm8		;; R2 + R4 (new R2)			; 2-5		n 6

	vaddpd	zmm5, zmm5, zmm7		;; I1 + I3 (new I1)			; 3-6		n 7

;;	L1prefetchw srcreg+L1pd, L1pt
;;	L1prefetchw srcreg+64+L1pd, L1pt

	vmovapd	zmm6, [srcreg+srcoff+d1+64]	;; I2
	vmovapd	zmm9, [srcreg+srcoff+d2+d1+64]	;; I4
	vaddpd	zmm7, zmm6, zmm9		;; I2 + I4 (new I2)			; 3-6		n 7

	vsubpd	zmm1, zmm1, zmm8		;; R2 - R4 (new R4)			; 4-7		n 9
	vsubpd	zmm6, zmm6, zmm9		;; I2 - I4 (new I4)			; 4-7		n 9

;;	L1prefetchw srcreg+d1+L1pd, L1pt
;;	L1prefetchw srcreg+d1+64+L1pd, L1pt

no bcast vmovapd zmm10, [screg+0*128]		;; Sine
bcast	vbroadcastsd zmm10, Q [bcreg+0*bcsz]	;; Sine
	vmulpd	zmm0, zmm0, zmm10		;; R3s = R3 * sine			; 5-8		n 9
	vmulpd	zmm4, zmm4, zmm10		;; I3s = I3 * sine			; 5-8		n 9

	vsubpd	zmm8, zmm2, zmm3		;; R1 - R2 (final R2)			; 6-9		n 11
	vaddpd	zmm2, zmm2, zmm3		;; R1 + R2 (final R1)			; 6-9

	vsubpd	zmm3, zmm5, zmm7		;; I1 - I2 (final I2)			; 7-10		n 11
	vaddpd	zmm5, zmm5, zmm7		;; I1 + I2 (final I1)			; 7-10

											;; STALL!!!

	zfnmaddpd zmm7, zmm6, zmm10, zmm0	;; R3s - I4*sine (final R3s)		; 9-12		n 13
	zfmaddpd zmm9, zmm1, zmm10, zmm4	;; I3s + R4*sine (final I3s)		; 9-12

;;	L1prefetchw srcreg+d2+L1pd, L1pt
;;	L1prefetchw srcreg+d2+64+L1pd, L1pt

	zfmaddpd zmm6, zmm6, zmm10, zmm0	;; R3s + I4*sine (final R4s)		; 10-13		n 14
	zfnmaddpd zmm1, zmm1, zmm10, zmm4	;; I3s - R4*sine (final I4s)		; 10-13

no bcast vmovapd zmm10, [screg+1*128+64]	;; cosine/sine
bcast	vbroadcastsd zmm10, Q [bcreg+1*bcsz+bcsz/2] ;; cosine/sine
	zfmsubpd zmm0, zmm8, zmm10, zmm3	;; A2 = R2 * cosine/sine - I2		; 11-14		n 15
	zfmaddpd zmm3, zmm3, zmm10, zmm8	;; B2 = I2 * cosine/sine + R2		; 11-14

											;; STALL!!!

no bcast vmovapd zmm10, [screg+0*128+64]	;; cosine/sine
bcast	vbroadcastsd zmm10, Q [bcreg+0*bcsz+bcsz/2] ;; cosine/sine
	zfmsubpd zmm4, zmm7, zmm10, zmm9	;; R3s * cosine/sine - I3s (final R3)	; 13-16
	zfmaddpd zmm9, zmm9, zmm10, zmm7	;; I3s * cosine/sine + R3s (final I3)	; 13-15

;;	L1prefetchw srcreg+d2+d1+L1pd, L1pt
;;	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt

	zfmaddpd zmm7, zmm6, zmm10, zmm1	;; R4s * cosine/sine + I4s (final R4)	; 14-17
	zfmsubpd zmm1, zmm1, zmm10, zmm6	;; I4s * cosine/sine - R4s (final I4)	; 14-17

no bcast vmovapd zmm10, [screg+1*128]		;; Sine
bcast	vbroadcastsd zmm10, Q [bcreg+1*bcsz]	;; Sine
	vmulpd	zmm0, zmm0, zmm10		;; A2 = A2 * sine (final R2)		; 15-18
	vmulpd	zmm3, zmm3, zmm10		;; B2 = B2 * sine (final I2)		; 15-18

	zstore	[srcreg], zmm2			;; Save R1
	zstore	[srcreg+64], zmm5		;; Save I1
	zstore	[srcreg+d1], zmm0		;; Save R2
	zstore	[srcreg+d1+64], zmm3		;; Save I2
	zstore	[srcreg+d2], zmm4		;; Save R3
	zstore	[srcreg+d2+64], zmm9		;; Save I3
	zstore	[srcreg+d2+d1], zmm7		;; Save R4
	zstore	[srcreg+d2+d1+64], zmm1		;; Save I4

	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM


;;
;; ************************************* four-complex-djbunfft variants ******************************************
;;

; Basic four-complex DJB inverse FFT building block
zr4_four_complex_djbunfft_preload MACRO
	zr4_4c_djbunfft_cmn_preload
	ENDM
zr4_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	zr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,noexec,0,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the 4cl version except vbroadcastsd is used to reduce sin/cos data
zr4b_four_complex_djbunfft_preload MACRO
	zr4_4c_djbunfft_cmn_preload
	ENDM
zr4b_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	zr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,exec,screg,16,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from the eight-real/four_complex sin/cos table
zr4rb_four_complex_djbunfft_preload MACRO
	zr4_4c_djbunfft_cmn_preload
	ENDM
zr4rb_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	zr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,exec,screg+8,128,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; Common macros to get the four complex djbunfft job done

zr4_4c_djbunfft_cmn_preload MACRO
	ENDM
zr4_4c_djbunfft_cmn MACRO srcreg,srcinc,d1,d2,bcast,bcreg,bcsz,screg,scinc,maxrpt,L1pt,L1pd

no bcast vmovapd zmm10, [screg+1*128+64]	;; cosine/sine
bcast	vbroadcastsd zmm10, Q [bcreg+1*bcsz++bcsz/2] ;; cosine/sine
	vmovapd	zmm2, [srcreg+d1]		;; R2
	vmovapd	zmm0, [srcreg+d1+64]		;; I2
	zfmaddpd zmm6, zmm2, zmm10, zmm0	;; A2 = R2 * cosine/sine + I2		; 1-4		n 5
	zfmsubpd zmm0, zmm0, zmm10, zmm2	;; B2 = I2 * cosine/sine - R2		; 1-4

no bcast vmovapd zmm10, [screg+0*128+64]	;; cosine/sine
bcast	vbroadcastsd zmm10, Q [bcreg+0*bcsz++bcsz/2] ;; cosine/sine
	vmovapd	zmm4, [srcreg+d2]		;; R3
	vmovapd	zmm1, [srcreg+d2+64]		;; I3
	zfmaddpd zmm7, zmm4, zmm10, zmm1	;; A3 = R3 * cosine/sine + I3		; 2-5
	zfmsubpd zmm1, zmm1, zmm10, zmm4	;; B3 = I3 * cosine/sine - R3		; 2-5

;;	L1prefetchw srcreg+L1pd, L1pt
;;	L1prefetchw srcreg+64+L1pd, L1pt

	vmovapd	zmm2, [srcreg+d2+d1]		;; R4
	vmovapd	zmm4, [srcreg+d2+d1+64]		;; I4
	zfmsubpd zmm3, zmm2, zmm10, zmm4	;; A4 = R4 * cosine/sine - I4		; 3-6
	zfmaddpd zmm4, zmm4, zmm10, zmm2	;; B4 = I4 * cosine/sine + R4		; 3-6

											;; STALL!!!

no bcast vmovapd zmm9, [screg+1*128]		;; Sine
bcast	vbroadcastsd zmm9, Q [bcreg+1*bcsz]	;; Sine
;;	L1prefetchw srcreg+d1+L1pd, L1pt
;;	L1prefetchw srcreg+d1+64+L1pd, L1pt

	vmovapd	zmm2, [srcreg]			;; R1
	zfmaddpd zmm5, zmm6, zmm9, zmm2		;; R1 + R2*sine (new R1)		; 5-8
	zfnmaddpd zmm6, zmm6, zmm9, zmm2	;; R1 - R2*sine (new R2)		; 5-8
;;	L1prefetchw srcreg+d2+L1pd, L1pt
;;	L1prefetchw srcreg+d2+64+L1pd, L1pt


	vmovapd	zmm2, [srcreg+64]		;; I1
	zfnmaddpd zmm8, zmm0, zmm9, zmm2	;; I1 - I2*sine (new I2)		; 6-9
	zfmaddpd zmm0, zmm0, zmm9, zmm2		;; I1 + I2*sine (new I1)		; 6-9
;;	L1prefetchw srcreg+d2+d1+L1pd, L1pt
;;	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	vaddpd	zmm2, zmm3, zmm7		;; R4 + R3 (new R3)			; 7-10
	vsubpd	zmm3, zmm3, zmm7		;; R4 - R3 (new I4)			; 7-10

	vsubpd	zmm7, zmm1, zmm4		;; I3 - I4 (new R4)			; 8-11
	vaddpd	zmm1, zmm1, zmm4		;; I3 + I4 (new I3)			; 8-11

											;; STALL!!!
											;; STALL!!!
											;; STALL!!!

no bcast vmovapd zmm10, [screg+0*128]		;; Sine
bcast	vbroadcastsd zmm10, Q [bcreg+0*bcsz]	;; Sine

	zfnmaddpd zmm4, zmm2, zmm10, zmm5	;; R1 - R3*sine (final R3)		; 11-14
	zfmaddpd zmm2, zmm2, zmm10, zmm5	;; R1 + R3*sine (final R1)		; 11-14

	zfnmaddpd zmm5, zmm7, zmm10, zmm6	;; R2 - R4*sine (final R4)		; 12-15
	zfmaddpd zmm7, zmm7, zmm10, zmm6	;; R2 + R4*sine (final R2)		; 12-15

	zfnmaddpd zmm6, zmm3, zmm10, zmm8	;; I2 - I4*sine (final I4)		; 13-16
	zfmaddpd zmm3, zmm3, zmm10, zmm8	;; I2 + I4*sine (final I2)		; 13-16

	zfnmaddpd zmm8, zmm1, zmm10, zmm0	;; I1 - I3*sine (final I3)		; 14-17
	zfmaddpd zmm1, zmm1, zmm10, zmm0	;; I1 + I3*sine (final I1)		; 14-17

	zstore	[srcreg], zmm2			;; Save R1
	zstore	[srcreg+64], zmm1		;; Save I1
	zstore	[srcreg+d1], zmm7		;; Save R2
	zstore	[srcreg+d1+64], zmm3		;; Save I2
	zstore	[srcreg+d2], zmm4		;; Save R3
	zstore	[srcreg+d2+64], zmm8		;; Save I3
	zstore	[srcreg+d2+d1], zmm5		;; Save R4
	zstore	[srcreg+d2+d1+64], zmm6		;; Save I4
	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM


;;
;; ********************************* eight-reals-four-complex-fft variants ***************************************
;;

;; Macro to do one eight_reals_fft and three four_complex_djbfft.  Having eight-real data and four-complex data in the same ZMM register
;; is not an ideal situation.  However, sometimes one cannot get the perfect memory layout.

zr4_eight_reals_four_complex_djbfft_preload MACRO
	mov	r9d, 11111110b			;; We're pretty sure r9 is safe to use
	kmovw	k7, r9d				;; Set k7 to 11111110b
	knotw	k6, k7				;; Set k6 to 00000001b
	vbroadcastsd zmm0, ZMM_SQRTHALF
	vbroadcastsd zmm28, ZMM_ONE
	vxorpd	zmm1, zmm1, zmm1
	vblendmpd zmm27 {k6}, zmm28, zmm0	;; 1, 1, 1, 1, 1, 1, 1		SQRTHALF
	vsubpd	zmm28 {k6}, zmm1, zmm0		;; 1, 1, 1, 1, 1, 1, 1		-SQRTHALF
	zblendmpd_preload zmm29
	ENDM
;; Does eight_reals on the low word of the zmm register and four complex on the high words of the zmm register
;; This is REALLY funky, as we do both at the same time within the full zmm register whenever possible.
zr4_eight_reals_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt
						;; Four-complex comments	Eight-reals comments
	vmovapd	zmm1, [srcreg]			;; R1				R1+R5 (new R1)
	vmovapd	zmm7, [srcreg+d2]		;; R3				R3+R7 (new R3)
	vaddpd	zmm0, zmm1, zmm7		;; R1 + R3 (new R1)		R1 + R3 (newer R1)			; 1-11		n 5
	vsubpd	zmm1, zmm1, zmm7		;; R1 - R3 (new R3)		R1 - R3 (newer R3 and final R2)		; 1-11		n 5

;;GW lots of stalls -- need to unroll using maxrpt

	vmovapd	zmm3, [srcreg+d1]		;; R2				R2+R6 (new R2)
	vmovapd	zmm7, [srcreg+d2+d1]		;; R4				R4+R8 (new R4)
	vaddpd	zmm2, zmm3, zmm7		;; R2 + R4 (new R2)		R2 + R4 (newer R2)			; 2-9		n 5
	vsubpd	zmm3, zmm3, zmm7		;; R2 - R4 (new R4)		R2 - R4 (newer R4 & final I2)		; 2-8		n 6

						;;				new R5/R7 morphs into newer real/imag
						;;				new R6/R8 morphs into newer real/imag
	vmovapd	zmm5, [srcreg+d1+64]		;; I2				R2-R6 (new R6)
	vmovapd	zmm7, [srcreg+d2+d1+64]		;; I4				R4-R8 (new R8)
	vaddpd	zmm4, zmm5, zmm7		;; I2 + I4 (new I2)		interim R8 = R6 + R8			; 3-9		n 6
	vsubpd	zmm5, zmm5, zmm7		;; I2 - I4 (new I4)		interim R6 = R6 - R8			; 3-8		n 8

	vmovapd	zmm8, [srcreg+64]		;; I1				R1-R5 (new R5)
	vmovapd	zmm7, [srcreg+d2+64]		;; I3				R3-R7 (new R7)
	vaddpd	zmm6 {k7}{z}, zmm8, zmm7	;; I1 + I3 (new I1)		0					; 4-10		n 6
	vsubpd	zmm7 {k7}, zmm8, zmm7		;; I1 - I3 (new I3)		blend in new R7				; 4-10		n 7

	zblendmpd zmm8, k6, zmm1, zmm8		;; R3				R5					; 5-5		n 8
	zblendmpd zmm9, k6, zmm3, zmm4		;; R4				R8					; 5-5		n 8

	vsubpd	zmm10, zmm0, zmm2		;; R1 - R2 (final R2)		R1 - R2 (final R1b store in I1)		; 6-14		n 7
	vaddpd	zmm0, zmm0, zmm2		;; R1 + R2 (final R1)		R1 + R2 (final R1)			; 6-14

						;;				newer R3/R4 becomes final R2/I2
	vmovapd	zmm2, zmm10			;; unimportant			final I1
	vsubpd	zmm3 {k7}, zmm6, zmm4		;; I1 - I2 (final I2)		blend in final I2			; 7-13		n 
	vaddpd	zmm2 {k7}, zmm6, zmm4		;; I1 + I2 (final I1)		blend in final I1			; 7-13		n 

	zfmaddpd zmm4, zmm9, zmm27, zmm7	;; I3 + R4*1 (final I3)		R7 + R8*SQRTHALF (final I3)		; 8-16		n 
	zfnmaddpd zmm9, zmm9, zmm27, zmm7	;; I3 - R4*1 (final I4)		R7 - R8*SQRTHALF (final I4)		; 8-16		n 

	zfnmaddpd zmm7, zmm5, zmm28, zmm8	;; R3 - I4*1 (final R3)		R5 - R6*-SQRTHALF (final R3)		; 9-17		n 
	zfmaddpd zmm5, zmm5, zmm28, zmm8	;; R3 + I4*1 (final R4)		R5 + R6*-SQRTHALF (final R4)		; 9-17		n 

	zblendmpd zmm10, k6, zmm10, zmm1	;; R2				R2					; 10-5		n 

	vmovapd	zmm8, [screg+1*128+64]				;; cosine/sine
	zfmaddpd zmm6, zmm3, zmm8, zmm10			;; B2 = I2 * cosine/sine + R2			; 14-18
	zfmsubpd zmm10, zmm10, zmm8, zmm3			;; A2 = R2 * cosine/sine - I2			; 14-18

	vmovapd	zmm8, [screg+0*128+64]				;; cosine/sine
	zfmaddpd zmm3, zmm4, zmm8, zmm7				;; B3 = I3 * cosine/sine + R3			; 18-22
	zfmsubpd zmm7, zmm7, zmm8, zmm4				;; A3 = R3 * cosine/sine - I3			; 18-22

	vmovapd	zmm8, [screg+2*128+64]				;; cosine/sine
	zfmaddpd zmm4, zmm9, zmm8, zmm5				;; B4 = I4 * cosine/sine + R4			; 19-23
	zfmsubpd zmm5, zmm5, zmm8, zmm9				;; A4 = R4 * cosine/sine - I4			; 19-23

	vmovapd	zmm8, [screg+1*128]				;; Sine
	vmulpd	zmm6, zmm6, zmm8				;; B2 = B2 * sine (final I2)			; 20-24
	vmulpd	zmm10, zmm10, zmm8				;; A2 = A2 * sine (final R2)			; 20-24
	vmovapd	zmm8, [screg+0*128]				;; Sine
	vmulpd	zmm3, zmm3, zmm8				;; B3 = B3 * sine (final I3)			; 23-27
	vmulpd	zmm7, zmm7, zmm8				;; A3 = A3 * sine (final R3)			; 23-27
	vmovapd	zmm8, [screg+2*128]				;; Sine
	vmulpd	zmm4, zmm4, zmm8				;; B4 = B4 * sine (final I4)			; 24-28
	vmulpd	zmm5, zmm5, zmm8				;; A4 = A4 * sine (final R4)			; 24-28

	zstore	[srcreg], zmm0			;; Save R1
	zstore	[srcreg+64], zmm2		;; Save I1
	zstore	[srcreg+d1], zmm10		;; Save R2
	zstore	[srcreg+d1+64], zmm6		;; Save I2
	zstore	[srcreg+d2], zmm7		;; Save R3
	zstore	[srcreg+d2+64], zmm3		;; Save I3
	zstore	[srcreg+d2+d1], zmm5		;; Save R4
	zstore	[srcreg+d2+d1+64], zmm4		;; Save I4
	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM

;;
;; ********************************* eight-reals-four-complex-unfft variants ***************************************
;;

;; Macro to do one eight_reals_unfft and seven four_complex_djbunfft.  The eight-reals operation is done in the lower word of the ZMM register.
;; This isn't very efficient, but this macro isn't called a whole lot.
zr4_eight_reals_four_complex_djbunfft_preload MACRO
	mov	r9d, 11111110b			;; We're pretty sure r9 is safe to use
	kmovw	k7, r9d				;; Set k7 to 11111110b
	knotw	k6, k7				;; Set k6 to 00000001b
	vbroadcastsd zmm0, ZMM_SQRTHALF
	vbroadcastsd zmm28, ZMM_ONE
	vxorpd	zmm1, zmm1, zmm1
	vblendmpd zmm27 {k6}, zmm28, zmm0	;; 1, 1, 1, 1, 1, 1, 1		SQRTHALF
	vsubpd	zmm28 {k6}, zmm1, zmm0		;; 1, 1, 1, 1, 1, 1, 1		-SQRTHALF
	zblendmpd_preload zmm29
	ENDM

zr4_eight_reals_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm8, [screg+0*128+64]				;; cosine/sine
	vmovapd	zmm2, [srcreg+d2]				;; R3
	vmovapd	zmm4, [srcreg+d2+64]				;; I3
	zfmaddpd zmm7, zmm2, zmm8, zmm4				;; A3 = R3 * cosine/sine + I3			; 1-4		n 5
	zfmsubpd zmm4, zmm4, zmm8, zmm2				;; B3 = I3 * cosine/sine - R3			; 1-4		n 

	vmovapd	zmm12, [screg+1*128+64]				;; cosine/sine
	vmovapd	zmm11, [srcreg+d1]				;; R2
	vmovapd	zmm10, [srcreg+d1+64]				;; I2
	zfmaddpd zmm6, zmm11, zmm12, zmm10			;; A2 = R2 * cosine/sine + I2			; 2-5		n 6 
	zfmsubpd zmm10, zmm10, zmm12, zmm11			;; B2 = I2 * cosine/sine - R2			; 2-5		n 

	vmovapd	zmm5, [screg+2*128+64]				;; cosine/sine
	vmovapd	zmm0, [srcreg+d2+d1]				;; R4
	vmovapd	zmm8, [srcreg+d2+d1+64]				;; I4
	zfmaddpd zmm1, zmm0, zmm5, zmm8				;; A4 = R4 * cosine/sine + I4			; 3-6		n 
	zfmsubpd zmm8, zmm8, zmm5, zmm0				;; B4 = I4 * cosine/sine - R4			; 3-6		n 

;;GW lots of stalls -- need to unroll using maxrpt

	vmovapd	zmm13, [screg+0*128]				;; Sine
	vmulpd	zmm7, zmm7, zmm13				;; A3 = A3 * sine				; 5-8		n 9
	vmulpd	zmm4, zmm4, zmm13				;; B3 = B3 * sine				; 5-8		n 

	vmovapd	zmm5, [screg+1*128]				;; Sine
	vmulpd	zmm6, zmm6, zmm5				;; A2 = A2 * sine				; 5-8		n 9
	vmulpd	zmm10, zmm10, zmm5				;; B2 = B2 * sine				; 5-8		n 

						;; Four complex comments	Eight reals comments
	vmovapd	zmm9, [srcreg]			;; R1				R1a
	vmovapd	zmm5, [srcreg+64]		;; I1				R1b
						;;				R1a/R1b becomes R1/R2, R2/I2 becomes R3/R4, R3/I3 => R5/R7, R4/I4 => R6/R8
;;GW blend earlier
	zblendmpd zmm12, k6, zmm6, zmm5		;; R2				R2				; 6-9		n 22

	vaddpd	zmm3, zmm9, zmm12		;; R1 + R2 (new R1)		R1 + R2 (new R1)		; 22-25		n 32
	vsubpd	zmm9, zmm9, zmm12		;; R1 - R2 (new R2)		R1 - R2 (new R2)		; 23-26		n 33

	vmovapd	zmm0, zmm9			;; unimportant			new R2
	vaddpd zmm0 {k7}, zmm5, zmm10		;; I1 + I2 (new I1)		blend in new R2			; 6-9		n 
	vsubpd zmm5 {k7}{z}, zmm5, zmm10	;; I1 - I2 (new I2)		0				; 6-9		n 

	vmovapd	zmm11, [screg+2*128]		;; Sine
	zfmaddpd zmm2, zmm1, zmm11, zmm7	;; R4*sine + R3 (new R3)	R6*sine + R5 (new R5)		; 16-19		n 23
	zfmsubpd zmm1, zmm1, zmm11, zmm7	;; R4*sine - R3 (new I4)	R6*sine - R5 (new negR6)	; 17-20		n 29

	zfnmaddpd zmm7, zmm8, zmm11, zmm4	;; I3 - I4*sine (new R4)	R7 - R8*sine (new R8)		; 17-20		n 24
	zfmaddpd zmm8, zmm8, zmm11, zmm4	;; I3 + I4*sine (new I3)	R7 + R8*sine (new R7)		; 18-21		n 27

	zblendmpd zmm10, k6, zmm8, zmm10	;; new I3			new R4				; 19-22
	zblendmpd zmm6, k6, zmm2, zmm6		;; new R3			new R3				; 19-22

						;;				multiply R6/R8 by SQRTHALF - i*SQRTHALF
	vmulpd	zmm5 {k6}, zmm7, zmm27		;; blend in new I2		R8*SQRTHALF

	vaddpd	zmm4, zmm0, zmm10		;; I1 + I3 (final I1)		R2 + R4 (final R2)		; 15-18		n 19
	vsubpd	zmm0, zmm0, zmm10		;; I1 - I3 (final I3)		R2 - R4 (final R4)		; 15-18

	vaddpd	zmm10, zmm3, zmm6		;; R1 + R3 (final R1)		R1 + R3 (final R1)		; 14-17
	vsubpd	zmm3, zmm3, zmm6		;; R1 - R3 (final R3)		R1 - R3 (final R3)		; 14-17		n 19

	zfmaddpd zmm6, zmm1, zmm28, zmm5	;; I2 + I4*1 (final I2)		R8 + negR6*-SQRTHALF (final R6) ; 17-20	n 21
	zfnmaddpd zmm1, zmm1, zmm28, zmm5	;; I2 - I4*1 (final I4)		R8 - negR6*-SQRTHALF (final R8) ; 17-20

	zblendmpd zmm2, k6, zmm4, zmm2		;; final I1			final R5			; 19-22
	zblendmpd zmm8, k6, zmm0, zmm8		;; final I3			final R7			; 19-22
	vaddpd	zmm4 {k7}, zmm9, zmm7		;; R2 + R4 (final R2)		blend in final R2		; 16-19
	vsubpd	zmm0 {k7}, zmm9, zmm7		;; R2 - R4 (final R4)		blend in final R4		; 16-19		n 21

	zstore	[srcreg], zmm10			;; Save R1
	zstore	[srcreg+64], zmm2		;; Save I1
	zstore	[srcreg+d1], zmm4		;; Save R2
	zstore	[srcreg+d1+64], zmm6		;; Save I2
	zstore	[srcreg+d2], zmm3		;; Save R3
	zstore	[srcreg+d2+64], zmm8		;; Save I3
	zstore	[srcreg+d2+d1], zmm0		;; Save R4
	zstore	[srcreg+d2+d1+64], zmm1		;; Save I4
	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM
