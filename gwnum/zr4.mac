;; Include other macro files needed by the AVX-512 versions of our primarily radix-4/8 traditional FFTs

INCLUDE zr5.mac
INCLUDE zr6.mac
INCLUDE zr7.mac
INCLUDE zr8.mac
INCLUDE zr10.mac
INCLUDE zr12.mac
INCLUDE zr16.mac
INCLUDE zr64.mac


;;GW:  these should be double_four_complex to improve instruction scheduling.  May reduc s/c data loads too.

;;
;; ************************************* four-complex-djbfft variants ******************************************
;;
;; Macros to do Daniel J. Bernstein's exponent-1 butterflies.  The
;; difference with a standard four-complex-fft is in the postmultiply step.
;; Instead of multiplying by w^2x, w^x, w^3x, we multiply by w^2x, w^x, w^-x.
;;

; Basic four-complex DJB FFT building block
yr4_4cl_four_complex_djbfft_preload MACRO
	yr4_4c_djbfft_cmn_preload
	ENDM
yr4_4cl_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,noexec,screg,screg+64,32,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the 4cl version except vbroadcastsd is used to reduce sin/cos data
yr4_b4cl_four_complex_djbfft_preload MACRO
	yr4_4c_djbfft_cmn_preload
	ENDM
yr4_b4cl_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,exec,screg,screg+16,8,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from an earlier level's uncompressed sin/cos data
yr4_eb4cl_four_complex_djbfft_preload MACRO
	yr4_4c_djbfft_cmn_preload
	ENDM
yr4_eb4cl_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,exec,screg,screg+64,32,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from the eight-real/four_complex sin/cos table
yr4_rb4cl_four_complex_djbfft_preload MACRO
	yr4_4c_djbfft_cmn_preload
	ENDM
yr4_rb4cl_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbfft_cmn srcreg,srcinc,0,d1,d2,exec,screg+8,screg+80,40,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Common macro to get the four complex djbfft job done

yr4_4c_djbfft_cmn_preload MACRO
	ENDM

yr4_4c_djbfft_cmn MACRO srcreg,srcinc,srcoff,d1,d2,bcast,screg1,screg2,scoff,swiz,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm0, [srcreg+srcoff]		;; R1
	vmovapd	zmm6, [srcreg+srcoff+d2]	;; R3
	vaddpd	zmm2, zmm0, zmm6		;; R1 + R3 (new R1)		; 1-3

	vmovapd	zmm1, [srcreg+srcoff+d1]	;; R2
	vmovapd	zmm7, [srcreg+srcoff+d2+d1]	;; R4
	vaddpd	zmm3, zmm1, zmm7		;; R2 + R4 (new R2)		; 2-4

	vsubpd	zmm0, zmm0, zmm6		;; R1 - R3 (new R3)		; 3-5
	vsubpd	zmm1, zmm1, zmm7		;; R2 - R4 (new R4)		; 4-6

	vmovapd	zmm4, [srcreg+srcoff+32]	;; I1
	vmovapd	zmm7, [srcreg+srcoff+d2+32]	;; I3
	vaddpd	zmm6, zmm4, zmm7		;; I1 + I3 (new I1)		; 5-7

;;	L1prefetchw srcreg+L1pd, L1pt

	vsubpd	zmm5, zmm2, zmm3		;; R1 - R2 (final R2)		; 6-8
	vaddpd	zmm2, zmm2, zmm3		;; R1 + R2 (final R1)		; 7-9

	zstore	[srcreg], zmm2			;; Save R1

	vmovapd	zmm2, [srcreg+srcoff+d1+32]	;; I2
	vaddpd	zmm3, zmm2, [srcreg+srcoff+d2+d1+32] ;; I2 + I4 (new I2)	; 8-10
	vsubpd	zmm2, zmm2, [srcreg+srcoff+d2+d1+32] ;; I2 - I4 (new I4)	; 9-11

;;	L1prefetchw srcreg+d1+L1pd, L1pt

	vsubpd	zmm4, zmm4, zmm7		;; I1 - I3 (new I3)		; 10-12

	vsubpd	zmm7, zmm6, zmm3		;; I1 - I2 (final I2)		; 11-13
	vaddpd	zmm6, zmm6, zmm3		;; I1 + I2 (final I1)		; 12-14

	zstore	[srcreg+32], zmm6		;; Save I1

	vsubpd	zmm3, zmm0, zmm2		;; R3 - I4 (final R3)		; 13-15
	vaddpd	zmm6, zmm4, zmm1		;; I3 + R4 (final I3)		; 14-16

;;	L1prefetchw srcreg+d2+L1pd, L1pt

	vaddpd	zmm0, zmm0, zmm2		;; R3 + I4 (final R4)		; 15-17
	vsubpd	zmm4, zmm4, zmm1		;; I3 - R4 (final I4)		; 16-18

no bcast vmovapd zmm1, [screg2+32]		;; cosine/sine
bcast	vbroadcastsd zmm1, Q [screg2+scoff]	;; cosine/sine
	vmulpd	zmm2, zmm5, zmm1		;; A2 = R2 * cosine/sine	;  9-13
	vsubpd	zmm2, zmm2, zmm7		;; A2 = A2 - I2			; 17-19

	vmulpd	zmm7, zmm7, zmm1		;; B2 = I2 * cosine/sine	; 14-18
	vaddpd	zmm7, zmm7, zmm5		;; B2 = B2 + R2			; 19-21

no bcast vmovapd zmm1, [screg1+32]		;; cosine/sine
bcast	vbroadcastsd zmm1, Q [screg1+scoff]	;; cosine/sine
	vmulpd	zmm5, zmm3, zmm1		;; A3 = R3 * cosine/sine	; 16-20
	vsubpd	zmm5, zmm5, zmm6		;; A3 = A3 - I3			; 21-23

	vmulpd	zmm6, zmm6, zmm1		;; B3 = I3 * cosine/sine	; 17-21
	vaddpd	zmm6, zmm6, zmm3		;; B3 = B3 + R3			; 22-24

;;	L1prefetchw srcreg+d2+d1+L1pd, L1pt

	vmulpd	zmm3, zmm0, zmm1		;; A4 = R4 * cosine/sine	; 18-22
	vaddpd	zmm3, zmm3, zmm4		;; A4 = A4 + I4			; 23-25

	vmulpd	zmm4, zmm4, zmm1		;; B4 = I4 * cosine/sine	; 19-23
	vsubpd	zmm4, zmm4, zmm0		;; B4 = B4 - R4			; 24-26

no bcast vmovapd zmm1, [screg2]			;; Sine
bcast	vbroadcastsd zmm1, Q [screg2]		;; Sine
	vmulpd	zmm2, zmm2, zmm1		;; A2 = A2 * sine (final R2)	; 20-24
	vmulpd	zmm7, zmm7, zmm1		;; B2 = B2 * sine (final I2)	; 22-26

no bcast vmovapd zmm1, [screg1]			;; Sine
bcast	vbroadcastsd zmm1, Q [screg1]		;; Sine
	vmulpd	zmm5, zmm5, zmm1		;; A3 = A3 * sine (final R3)	; 24-28
	vmulpd	zmm6, zmm6, zmm1		;; B3 = B3 * sine (final I3)	; 25-29

	vmulpd	zmm3, zmm3, zmm1		;; A4 = A4 * sine (final R4)	; 26-30
	vmulpd	zmm4, zmm4, zmm1		;; B4 = B4 * sine (final I4)	; 27-31

;;	zstore	[srcreg], zmm0			;; Save R1
;;	zstore	[srcreg+32], zmm0		;; Save I1
	zstore	[srcreg+d1], zmm2		;; Save R2
	zstore	[srcreg+d1+32], zmm7		;; Save I2
	zstore	[srcreg+d2], zmm5		;; Save R3
	zstore	[srcreg+d2+32], zmm6		;; Save I3
	zstore	[srcreg+d2+d1], zmm3		;; Save R4
	zstore	[srcreg+d2+d1+32], zmm4		;; Save I4

	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM


;;
;; ************************************* four-complex-djbunfft variants ******************************************
;;

; Basic four-complex DJB inverse FFT building block
yr4_4cl_four_complex_djbunfft_preload MACRO
	yr4_4c_djbunfft_cmn_preload
	ENDM
yr4_4cl_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,noexec,screg,screg+64,32,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the 4cl version except vbroadcastsd is used to reduce sin/cos data
yr4_b4cl_four_complex_djbunfft_preload MACRO
	yr4_4c_djbunfft_cmn_preload
	ENDM
yr4_b4cl_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,exec,screg,screg+16,8,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from a earlier level's uncompressed sin/cos data
yr4_eb4cl_four_complex_djbunfft_preload MACRO
	yr4_4c_djbunfft_cmn_preload
	ENDM
yr4_eb4cl_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,exec,screg,screg+64,32,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like b4cl but extracts the sin/cos data to broadcast from the eight-real/four_complex sin/cos table
yr4_rb4cl_four_complex_djbunfft_preload MACRO
	yr4_4c_djbunfft_cmn_preload
	ENDM
yr4_rb4cl_four_complex_djbunfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbunfft_cmn srcreg,srcinc,d1,d2,exec,screg+8,screg+80,40,noexec,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; Common macros to get the four complex djbunfft job done

yr4_4c_djbunfft_cmn_preload MACRO
	ENDM

yr4_4c_djbunfft_cmn MACRO srcreg,srcinc,d1,d2,bcast,screg1,screg2,scoff,swiz,screg,scinc,maxrpt,L1pt,L1pd
	yr4_4c_djbunfft srcreg,srcinc,d1,d2,bcast,screg1,screg2,scoff,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

yr4_4c_djbunfft MACRO srcreg,srcinc,d1,d2,bcast,screg1,screg2,scoff,screg,scinc,maxrpt,L1pt,L1pd
no bcast vmovapd zmm3, [screg2+32]		;; cosine/sine
bcast	vbroadcastsd zmm3, Q [screg2+scoff]	;; cosine/sine
	vmovapd	zmm2, [srcreg+d1]		;; R2
	vmulpd	zmm6, zmm2, zmm3		;; A2 = R2 * cosine/sine		; 1-5
	vmovapd	zmm0, [srcreg+d1+32]		;; I2
	vmulpd	zmm3, zmm3, zmm0		;; B2 = I2 * cosine/sine		; 2-6

no bcast vmovapd zmm5, [screg1+32]		;; cosine/sine
bcast	vbroadcastsd zmm5, Q [screg1+scoff]	;; cosine/sine
	vmovapd	zmm4, [srcreg+d2]		;; R3
	vmulpd	zmm7, zmm4, zmm5		;; A3 = R3 * cosine/sine		; 3-7
	vmovapd	zmm1, [srcreg+d2+32]		;; I3

	vaddpd	zmm6, zmm6, zmm0		;; A2 = A2 + I2				; 6-8

	vmulpd	zmm0, zmm1, zmm5		;; B3 = I3 * cosine/sine		; 4-8
;;	L1prefetchw srcreg+L1pd, L1pt

	vsubpd	zmm3, zmm3, zmm2		;; B2 = B2 - R2				; 7-9
	vaddpd	zmm7, zmm7, zmm1		;; A3 = A3 + I3				; 8-10

	vmovapd	zmm2, [srcreg+d2+d1]		;; R4
	vmulpd	zmm1, zmm2, zmm5		;; A4 = R4 * cosine/sine		; 5-9

	vsubpd	zmm0, zmm0, zmm4		;; B3 = B3 - R3				; 9-11

	vmovapd	zmm4, [srcreg+d2+d1+32]		;; I4
	vmulpd	zmm5, zmm4, zmm5		;; B4 = I4 * cosine/sine		; 6-10

	vsubpd	zmm1, zmm1, zmm4		;; A4 = A4 - I4				; 10-12

no bcast vmovapd zmm4, [screg2]			;; Sine
bcast	vbroadcastsd zmm4, Q [screg2]		;; Sine
	vmulpd	zmm6, zmm6, zmm4		;; A2 = A2 * sine (new R2)		; 9-13
	vmulpd	zmm3, zmm3, zmm4		;; B2 = B2 * sine (new I2)		; 10-14
;;	L1prefetchw srcreg+d1+L1pd, L1pt

	vaddpd	zmm5, zmm5, zmm2		;; B4 = B4 + R4				; 11-13

no bcast vmovapd zmm4, [screg1]			;; Sine
bcast	vbroadcastsd zmm4, Q [screg1]		;; Sine
	vmulpd	zmm7, zmm7, zmm4		;; A3 = A3 * sine (new R3)		; 11-15
	vmulpd	zmm0, zmm0, zmm4		;; B3 = B3 * sine (new I3)		; 12-16
	vmulpd	zmm1, zmm1, zmm4		;; A4 = A4 * sine (new R4)		; 13-17
	vmulpd	zmm5, zmm5, zmm4		;; B4 = B4 * sine (new I4)		; 14-18

	vmovapd	zmm2, [srcreg]			;; R1
	vaddpd	zmm4, zmm2, zmm6		;; R1 + R2 (new R1)			; 14-16
	vsubpd	zmm2, zmm2, zmm6		;; R1 - R2 (new R2)			; 15-17
;;	L1prefetchw srcreg+d2+L1pd, L1pt

	vaddpd	zmm6, zmm1, zmm7		;; R4 + R3 (new R3)			; 16-18
	vsubpd	zmm1, zmm1, zmm7		;; R4 - R3 (new I4)			; 17-19

	vsubpd	zmm7, zmm0, zmm5		;; I3 - I4 (new R4)			; 18-20
	vaddpd	zmm0, zmm0, zmm5		;; I3 + I4 (new I3)			; 19-21

	vsubpd	zmm5, zmm4, zmm6		;; R1 - R3 (final R3)			; 20-22
	vaddpd	zmm4, zmm4, zmm6		;; R1 + R3 (final R1)			; 21-23

	vmovapd	zmm6, [srcreg+32]		;; I1
	zstore	[srcreg], zmm4			;; Store R1

	vsubpd	zmm4, zmm6, zmm3		;; I1 - I2 (new I2)			; 22-24
	vaddpd	zmm6, zmm6, zmm3		;; I1 + I2 (new I1)			; 23-25
;;	L1prefetchw srcreg+d2+d1+L1pd, L1pt

	vsubpd	zmm3, zmm2, zmm7		;; R2 - R4 (final R4)			; 24-26
	vaddpd	zmm2, zmm2, zmm7		;; R2 + R4 (final R2)			; 25-27

	vsubpd	zmm7, zmm4, zmm1		;; I2 - I4 (final I4)			; 26-28
	vaddpd	zmm4, zmm4, zmm1		;; I2 + I4 (final I2)			; 27-29

	vsubpd	zmm1, zmm6, zmm0		;; I1 - I3 (final I3)			; 28-30
	vaddpd	zmm6, zmm6, zmm0		;; I1 + I3 (final I1)			; 29-31

;;	zstore	[srcreg], zmm			;; Save R1
	zstore	[srcreg+32], zmm6		;; Save I1
	zstore	[srcreg+d1], zmm2		;; Save R2
	zstore	[srcreg+d1+32], zmm4		;; Save I2
	zstore	[srcreg+d2], zmm5		;; Save R3
	zstore	[srcreg+d2+32], zmm1		;; Save I3
	zstore	[srcreg+d2+d1], zmm3		;; Save R4
	zstore	[srcreg+d2+d1+32], zmm7		;; Save I4
	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM



;;
;; ********************************* one-eight-reals-three-four-complex-fft variants ***************************************
;;

;; Macro to do one eight_reals_fft and three four_complex_djbfft.
;; Having eight-real data and four-complex data in the same ZMM register
;; is not an ideal situation.  However, sometimes one cannot get the
;; perfect memory layout.

yr4_4cl_eight_reals_four_complex_djbfft_preload MACRO
	yr4_o8r_t4c_djbfft_mem_preload
	ENDM
yr4_4cl_eight_reals_four_complex_djbfft MACRO srcreg,srcinc,d1,d2,screg,scinc,maxrpt
	yr4_o8r_t4c_djbfft_mem [srcreg],[srcreg+d1],[srcreg+d2],[srcreg+d2+d1],[srcreg+32],[srcreg+d1+32],[srcreg+d2+32],[srcreg+d2+d1+32],screg,[srcreg]
;;	zstore	[srcreg], zmm7		;; Save R1
	zstore	[srcreg+32], zmm0	;; Save I1
	zstore	[srcreg+d1], zmm3	;; Save R2
	zstore	[srcreg+d1+32], zmm6	;; Save I2
	zstore	[srcreg+d2], zmm2	;; Save R3
	zstore	[srcreg+d2+32], zmm1	;; Save I3
	zstore	[srcreg+d2+d1], zmm5	;; Save R4
	zstore	[srcreg+d2+d1+32], zmm4	;; Save I4
	bump	srcreg, srcinc
	bump	screg, scinc
	ENDM

;; Does a yr4_x8r_fft_mem on the low word of the zmm register
;; Does a yr4_x4c_djbfft_mem on the high words of the zmm register
;; This is REALLY funky, as we do both at the same time within
;; the full zmm register whenever possible.
yr4_o8r_t4c_djbfft_mem_preload MACRO
	vmovapd	zmm15, ZMM_ONE		;; One
	vblendpd zmm14, zmm15, ZMM_SQRTHALF, 1 ;; Three ones and one sqrthalf
	ENDM

yr4_o8r_t4c_djbfft_mem MACRO mem1,mem2,mem3,mem4,mem5,mem6,mem7,mem8,screg,dst
					;; Eight-reals comments		; Three four-complex comments
	vmovapd	zmm13, mem6		;; R6				; I2
	vmovapd	zmm7, mem4		;; R4				; R4
	vblendpd zmm5, zmm13, zmm7, 1	;; R4				; I2
	vmovapd	zmm4, mem8		;; R8				; I4
	zfmsubpd zmm1, zmm5, zmm15, zmm4 ;; interim R8 = R4 - R8	; I2 - I4 (new I4)		;	1-5

	vblendpd zmm7, zmm7, zmm13, 1	;; R6				; R4
	vmovapd	zmm11, mem2		;; R2				; R2
	zfmsubpd zmm6, zmm11, zmm15, zmm7 ;; interim R6 = R2 - R6	; R2 - R4 (new R4)		; 1-5

	zfmaddpd zmm11, zmm11, zmm15, zmm7 ;; new R2 = R2 + R6		; R2 + R4 (new R2)		;	2-6
	zfmaddpd zmm5, zmm5, zmm15, zmm4 ;; new R4 = R4 + R8		; I2 + I4 (new I2)		; 2-6

	vmovapd	zmm7, mem3		;; R3				; R3
	vmovapd	zmm9, mem5		;; R5				; I1
	vblendpd zmm8, zmm9, zmm7, 1	;; R3				; I1

	vmovapd	zmm3, mem7		;; R7				; I3
	zfmaddpd zmm10, zmm8, zmm15, zmm3 ;; new R3 = R3 + R7		; I1 + I3 (new I1)		;	3-7
	zfmsubpd zmm8, zmm8, zmm15, zmm3 ;; new R7 = R3 - R7		; I1 - I3 (new I3)		; 3-7

	vblendpd zmm7, zmm7, zmm9, 1	;; R5				; R3
	vmovapd	zmm12, mem1		;; R1				; R1
	zfmaddpd zmm13, zmm12, zmm15, zmm7 ;; new R1 = R1 + R5		; R1 + R3 (new R1)		;	4-8
	zfmsubpd zmm12, zmm12, zmm15, zmm7 ;; new R5 = R1 - R5		; R1 - R3 (new R3)		; 4-8

	vblendpd zmm0, zmm10, zmm11, 1	;; new R2			; new I1			;		8
	vblendpd zmm4, zmm11, zmm10, 1	;; new R3			; new R2			;		9

	zfmaddpd zmm9, zmm6, zmm15, zmm1 ;; new R8 = interim R6 + R8	; meaningless			;	6-10
	zfmsubpd zmm3, zmm1, zmm15, zmm6 ;; new negR6 = interim R8 - R6	; meaningless			; 6-10

	vblendpd zmm9, zmm6, zmm9, 1	;; new R8			; new R4			;		11
	vblendpd zmm1, zmm1, zmm3, 1	;; new negR6			; new I4			;		12
	vmovapd	zmm3, [screg+64+32]			;; cosine/sine

	zfmsubpd zmm7, zmm0, zmm15, zmm5 ;; R2 - R4 (final I2)		; I1 - I2 (final I2)		;	9-13
	zfmaddpd zmm0, zmm0, zmm15, zmm5 ;; R2 + R4 (final I1, a.k.a 2nd real result) ; I1 + I2 (final I1) ; 9-13
	vmovapd	zmm2, [screg+32]			;; cosine/sine

	zfmsubpd zmm10, zmm13, zmm15, zmm4 ;; R1 - R3 (final R2)	; R1 - R2 (final R2)		;	10-14
	zfmaddpd zmm13, zmm13, zmm15, zmm4 ;; R1 + R3 (final R1)	; R1 + R2 (final R1)		; 10-14
	vmovapd	zmm5, [screg+128+32]			;; cosine/sine

	zfmaddpd zmm11, zmm9, zmm14, zmm8 ;; R7 + R8*SQRTHALF (final I3) ; I3 + R4*1 (final I3)		;	12-16
	zfnmaddpd zmm8, zmm9, zmm14, zmm8 ;; R7 - R8*SQRTHALF (final I4) ; I3 - R4*1 (final I4)		; 12-16

	zfnmaddpd zmm9, zmm1, zmm14, zmm12 ;; R5 - negR6*SQRTHALF (final R3) ; R3 - I4*1 (final R3)	;	13-17
	zfmaddpd zmm12, zmm1, zmm14, zmm12 ;; R5 + negR6*SQRTHALF (final R4) ; R3 + I4*1 (final R4)	; 13-17

	zfmaddpd zmm6, zmm7, zmm3, zmm10		;; B2 = I2 * cosine/sine + R2			;	14-18
	zfmsubpd zmm3, zmm10, zmm3, zmm7		;; A2 = R2 * cosine/sine - I2			; 14-18
	vmovapd	zmm10, [screg+64]			;; Sine
	vmovapd	zmm7, [screg]				;; Sine
	zstore	dst, zmm13				;; Save final R1				;		15

	zfmaddpd zmm1, zmm11, zmm2, zmm9		;; B3 = I3 * cosine/sine + R3			;	18-22
	zfmsubpd zmm2, zmm9, zmm2, zmm11		;; A3 = R3 * cosine/sine - I3			; 18-22
	vmovapd	zmm9, [screg+128]			;; Sine

	zfmaddpd zmm4, zmm8, zmm5, zmm12		;; B4 = I4 * cosine/sine + R4			;	19-23
	zfmsubpd zmm5, zmm12, zmm5, zmm8		;; A4 = R4 * cosine/sine - I4			; 19-23

	vmulpd	zmm6, zmm6, zmm10			;; B2 = B2 * sine (final I2)			;	20-24
	vmulpd	zmm3, zmm3, zmm10			;; A2 = A2 * sine (final R2)			; 20-24
	vmulpd	zmm1, zmm1, zmm7			;; B3 = B3 * sine (final I3)			;	23-27
	vmulpd	zmm2, zmm2, zmm7			;; A3 = A3 * sine (final R3)			; 23-27
	vmulpd	zmm4, zmm4, zmm9			;; B4 = B4 * sine (final I4)			;	24-28
	vmulpd	zmm5, zmm5, zmm9			;; A4 = A4 * sine (final R4)			; 24-28
	ENDM

;;
;; ********************************* one-eight-reals-three-four-complex-unfft variants ***************************************
;;

;; Macro to do one eight_reals_unfft and three four_complex_djbunfft.
;; The eight-reals operation is done in the lower word of the ZMM
;; register.  This isn't very efficient, but this macro isn't called a whole lot.
yr4_o8r_t4c_djbunfft_mem_preload MACRO
	vmovapd	zmm15, ZMM_ONE
	vblendpd zmm14, zmm15, ZMM_SQRTHALF, 1
	ENDM

yr4_o8r_t4c_djbunfft_mem MACRO mem1,mem2,mem3,mem4,mem5,mem6,mem7,mem8,screg,dst
	vmovapd	zmm8, [screg+32]			;; cosine/sine
	vmovapd	zmm2, mem5				;; R3
	vmovapd	zmm4, mem6				;; I3
	zfmaddpd zmm7, zmm2, zmm8, zmm4			;; A3 = R3 * cosine/sine + I3			;	1-5
	zfmsubpd zmm4, zmm4, zmm8, zmm2			;; B3 = I3 * cosine/sine - R3			; 1-5

	vmovapd	zmm12, [screg+64+32]			;; cosine/sine
	vmovapd	zmm11, mem3				;; R2
	vmovapd	zmm10, mem4				;; I2
	zfmaddpd zmm6, zmm11, zmm12, zmm10		;; A2 = R2 * cosine/sine + I2			;	2-6
	zfmsubpd zmm10, zmm10, zmm12, zmm11		;; B2 = I2 * cosine/sine - R2			; 2-6

	vmovapd	zmm5, [screg+128+32]			;; cosine/sine
	vmovapd	zmm0, mem7				;; R4
	vmovapd	zmm8, mem8				;; I4
	zfmaddpd zmm1, zmm0, zmm5, zmm8			;; A4 = R4 * cosine/sine + I4			;	3-7
	zfmsubpd zmm8, zmm8, zmm5, zmm0			;; B4 = I4 * cosine/sine - R4			; 3-7

	vmovapd	zmm13, [screg]				;; Sine
	vmulpd	zmm7, zmm7, zmm13			;; A3 = A3 * sine				;	6-10
	vmulpd	zmm4, zmm4, zmm13			;; B3 = B3 * sine				; 6-10


					;; Eight reals comments		; Four complex comments
					;; R5 = A3			R3 = A3
					;; R6 = B3			I3 = B3
					;; R7/sine = A4			R4/sine = A4
					;; R8/sine = B4			I4/sine = B4
					;; R3/sine = A2			R2/sine = A2
					;; R4/sine = B2			I2/sine = B2

	vmovapd	zmm0, mem2		;; R2				; I1
	vmovapd	zmm5, [screg+64]			;; Sine
	zfmaddpd zmm9, zmm10, zmm5, zmm0 ;; R2 + R4 * sine (new R2)	; I1 + I2 * sine (new I1)	;	7-11
	zfnmaddpd zmm10, zmm10, zmm5, zmm0 ;; R2 - R4 * sine (new R4)	; I1 - I2 * sine (new I2)	; 7-11

	vmovapd	zmm3, mem1		;; R1				; R1
	zfmaddpd zmm12, zmm6, zmm5, zmm3 ;; R1 + R3 * sine (new R1)	; R1 + R2 * sine (new R1)	;	8-12
	zfnmaddpd zmm6, zmm6, zmm5, zmm3 ;; R1 - R3 * sine (new R3)	; R1 - R2 * sine (new R2)	; 8-12

	vmovapd	zmm2, [screg+128]			;; Sine
	zfnmaddpd zmm3, zmm1, zmm2, zmm7 ;; R5 - R7 * sine (new R6)	; R3 - R4 * sine (new negI4)	;	11-15
	zfnmaddpd zmm0, zmm8, zmm2, zmm4 ;; R6 - R8 * sine (new R8)	; I3 - I4 * sine (new R4)	; 11-15

	zfmaddpd zmm1, zmm1, zmm2, zmm7 ;; R5 + R7 * sine (new R5)	; R3 + R4 * sine (new R3)	;	12-16
	zfmaddpd zmm8, zmm8, zmm2, zmm4 ;; R6 + R8 * sine (new R7)	; I3 + I4 * sine (new I3)	; 12-16

	vblendpd zmm4, zmm9, zmm6, 1	;; new R3			; new I1			;		13		
	vblendpd zmm6, zmm6, zmm9, 1	;; new R2			; new R2			;		14

	zfmaddpd zmm13, zmm3, zmm15, zmm0 ;; R6 = R6 + R8		; meaningless			;	16-20
	zfmsubpd zmm9, zmm3, zmm15, zmm0 ;; negR8 = R6 - R8		; meaningless			; 16-20

	zfmsubpd zmm11, zmm12, zmm15, zmm1 ;; R1 - R5 (final R5)	; R1 - R3 (final R3)		;	17-21
	zfmaddpd zmm12, zmm12, zmm15, zmm1 ;; R1 + R5 (final R1)	; R1 + R3 (final R1)		; 17-21

	zfmaddpd zmm1, zmm4, zmm15, zmm8 ;; R3 + R7 (final R3)		; I1 + I3 (final I1)		;	18-22
	zfmsubpd zmm4, zmm4, zmm15, zmm8 ;; R3 - R7 (final R7)		; I1 - I3 (final I3)		; 18-22

	vblendpd zmm0, zmm0, zmm13, 1	;; new R6/SQRTHALF		; new R4			;		21

	zfnmaddpd zmm8, zmm0, zmm14, zmm6 ;; R2 - R6*SQRTHALF (final R6) ; R2 - R4*1 (final R4)		;	22-26
	zfmaddpd zmm0, zmm0, zmm14, zmm6 ;; R2 + R6*SQRTHALF (final R2)	; R2 + R4*1 (final R2)		; 22-26
	vblendpd zmm3, zmm3, zmm9, 1	;; new negR8/SQRTHALF		; new negI4			;		22
	zstore	dst, zmm12		;; Store R1							;		22

	zfnmaddpd zmm9, zmm3, zmm14, zmm10 ;; R4 - negR8*SQRTHALF (final R4) ; I2 - negI4*1 (final I2)	;	23-27
	zfmaddpd zmm3, zmm3, zmm14, zmm10 ;; R4 + negR8*SQRTHALF (final R8) ; I2 + negI4*1 (final I4)	; 23-27
	vblendpd zmm5, zmm11, zmm1, 1	;; final R3			; final R3			;		23

	vblendpd zmm6, zmm1, zmm11, 1	;; final R5			; final I1			;		24
	vblendpd zmm2, zmm9, zmm8, 1	;; final R6			; final I2			;		28
	vblendpd zmm7, zmm8, zmm9, 1	;; final R4			; final R4			;		29
	ENDM
