;;
;; Macros for a traditional radix-4 FFT but with split all-complex premultipliers
;; and radix-8 for odd FFT levels.
;;

INCLUDE r4spm.mac

xfft_type TEXTEQU <r4r8>


;;	We need a radix-8 version for pass 2.  The best place is probably the last 3 levels.
;;	In which case we'll need the square and  mulf versions too.  ---  and maybe
;;	swizzling versions for one-pass FFTs.

;;
;; Do a traditional radix-8 forward FFT with 7 sin/cos multipliers.
;;

r4r8_g8cl_eight_complex_djbfft MACRO srcreg,srcinc,d1,d2,d4,dstreg,dstinc,e1,e2,e4,screg,scoff
	;; need code here
	ENDM

;;
;; In the all-complex split premultiplier case, we apply part of the roots of -1 at the
;; end of the first pass.  Thus we have 8 sin/cos/premultipliers instead
;; of the usual 7.
;;
;; NOTE:  Unlike many "gNcl" macros this one will not work if srcreg and dstreg point to the
;; same memory location.
;;

r4r8_g8cl_eight_complex_ac_djbfft MACRO srcreg,srcinc,d1,d2,d4,dstreg,dstinc,e1,e2,e4,screg,scoff
	r4r8_x8c_fft8 srcreg+0,d1,d2,d4,dstreg+0,e1,e2,screg+scoff
	r4r8_x8c_fft8 srcreg+32,d1,d2,d4,dstreg+e4,e1,e2,screg+scoff
	bump	srcreg, srcinc
	bump	dstreg, dstinc
	ENDM

r4r8_x8c_fft8 MACRO srcreg,d1,d2,d4,dstreg,e1,e2,screg
	xload	xmm0, [srcreg]			;; R1
	xload	xmm2, [srcreg+d4]		;; R5
	addpd	xmm2, xmm0			;; R5 = R1 + R5 (new R1)	;24-27

	xload	xmm1, [srcreg+d2]		;; R3
	xload	xmm3, [srcreg+d4+d2]		;; R7
	addpd	xmm3, xmm1			;; R7 = R3 + R7 (new R3)	;34-37

	xload	xmm4, [srcreg+16]		;; I1
	xload	xmm6, [srcreg+d4+16]		;; I5
	addpd	xmm6, xmm4			;; I5 = I1 + I5 (new I1)	;28-31

	subpd	xmm0, [srcreg+d4]		;; R1 = R1 - R5 (new R5)	;20-23
	subpd	xmm1, [srcreg+d4+d2]		;; R3 = R3 - R7 (new R7)	;26-29

	xcopy	xmm5, xmm3			;; Copy R3
	addpd	xmm3, xmm2			;; R3 = R1 + R3 (final R1)	;48-51
	subpd	xmm2, xmm5			;; R1 = R1 - R3 (final R3)	;40-43

	xload	xmm5, [srcreg+d2+16]		;; I3
	xload	xmm7, [srcreg+d4+d2+16]		;; I7
	addpd	xmm7, xmm5			;; I7 = I3 + I7 (new I3)	;36-39

	subpd	xmm4, [srcreg+d4+16]		;; I1 = I1 - I5 (new I5)	;22-25
	subpd	xmm5, [srcreg+d4+d2+16]		;; I3 = I3 - I7 (new I7)	;30-33

	xstore	[dstreg], xmm3			;; Save R1

	xcopy	xmm3, xmm7			;; Copy I3
	addpd	xmm7, xmm6			;; I3 = I1 + I3 (final I1)	;50-53
	subpd	xmm6, xmm3			;; I1 = I1 - I3 (final I3)	;42-45

	xstore	[dstreg+16], xmm7		;; Save I1

	xcopy	xmm3, xmm1			;; Copy R7
	addpd	xmm1, xmm4			;; R7 = I5 + R7 (final I5)	;44-47
	xcopy	xmm7, xmm0			;; Copy R5
	subpd	xmm0, xmm5			;; R5 = R5 - I7 (final R5)	;38-41
	subpd	xmm4, xmm3			;; I5 = I5 - R7 (final I7)	;32-35
	addpd	xmm5, xmm7			;; I7 = R5 + I7 (final R7)	;46-49

	xstore	[dstreg+e1], xmm2		;; Save R3
	xstore	[dstreg+e1+16], xmm6		;; Save I3
	xstore	[dstreg+e2], xmm0		;; Save R5
	xstore	[dstreg+e2+16], xmm1		;; Save I5
	xstore	[dstreg+e2+e1], xmm5		;; Save R7
	xstore	[dstreg+e2+e1+16], xmm4		;; Save I7

	xload	xmm0, [srcreg+d1]		;; R2
	xload	xmm2, [srcreg+d4+d1]		;; R6
	addpd	xmm2, xmm0			;; R6 = R2 + R6 (new R2)	;24-27

	xload	xmm1, [srcreg+d2+d1]		;; R4
	xload	xmm3, [srcreg+d4+d2+d1]		;; R8
	addpd	xmm3, xmm1			;; R8 = R4 + R8 (new R4)	;34-37

	xload	xmm4, [srcreg+d1+16]		;; I2
	xload	xmm6, [srcreg+d4+d1+16]		;; I6
	addpd	xmm6, xmm4			;; I6 = I2 + I6 (new I2)	;28-31

	subpd	xmm0, [srcreg+d4+d1]		;; R2 = R2 - R6 (new R6)	;20-23
	subpd	xmm1, [srcreg+d4+d2+d1]		;; R4 = R4 - R8 (new R8)	;26-29

	xcopy	xmm5, xmm3			;; Copy R4
	addpd	xmm3, xmm2			;; R4 = R2 + R4 (final R2)	;48-51
	subpd	xmm2, xmm5			;; R2 = R2 - R4 (final R4)	;40-43

	xload	xmm5, [srcreg+d2+d1+16]		;; I4
	xload	xmm7, [srcreg+d4+d2+d1+16]	;; I8
	addpd	xmm7, xmm5			;; I8 = I4 + I8 (new I4)	;36-39

	subpd	xmm4, [srcreg+d4+d1+16]		;; I2 = I2 - I6 (new I6)	;22-25
	subpd	xmm5, [srcreg+d4+d2+d1+16]	;; I4 = I4 - I8 (new I8)	;30-33

	xstore	[dstreg+32], xmm3		;; Save R2

	xcopy	xmm3, xmm7			;; Copy I4
	addpd	xmm7, xmm6			;; I4 = I2 + I4 (final I2)	;50-53
	subpd	xmm6, xmm3			;; I2 = I2 - I4 (final I4)	;42-45

	xstore	[dstreg+48], xmm7		;; Save I2

	xcopy	xmm3, xmm1			;; Copy I6
	addpd	xmm1, xmm4			;; R8 = I6 + R8 (new I6)	;44-47
	xcopy	xmm7, xmm0			;; Copy R6
	subpd	xmm0, xmm5			;; R6 = R6 - I8 (new R6)	;38-41
	subpd	xmm4, xmm3			;; I6 = I6 - R8 (new I8)	;32-35
	addpd	xmm5, xmm7			;; I8 = R6 + I8 (new R8)	;46-49

	xcopy	xmm3, xmm0			;; Copy R6
	subpd	xmm0, xmm1			;; R6 = R6 - I6			;12-15
	addpd	xmm1, xmm3			;; I6 = R6 + I6			;16-19
	xload	xmm3, XMM_SQRTHALF
	mulpd	xmm0, xmm3			;; R6 = R6 * SQRTHALF (final R6)
	mulpd	xmm1, xmm3			;; I6 = I6 * SQRTHALF (final I6)

	xcopy	xmm7, xmm5			;; Copy R8
	subpd	xmm5, xmm4			;; R8 = R8 - I8			;12-15
	addpd	xmm4, xmm7			;; I8 = R8 + I8			;16-19
	mulpd	xmm5, xmm3			;; R8 = R8 * SQRTHALF (final R8)
	mulpd	xmm4, xmm3			;; I8 = I8 * SQRTHALF (final I8)

	xstore	[dstreg+e1+32], xmm2		;; Save R4
	xstore	[dstreg+e1+48], xmm6		;; Save I4

;; the last level

	xload	xmm2, [dstreg+e2]		;; R5
	subpd	xmm2, xmm0			;; R5 = R5 - R6 (new R6)	;40-43
	addpd	xmm0, [dstreg+e2]		;; R6 = R5 + R6 (new R5)	;48-51

	xload	xmm3, [dstreg+e2+16]		;; I5
	subpd	xmm3, xmm1			;; I5 = I5 - I6 (new I6)	;42-45
	addpd	xmm1, [dstreg+e2+16]		;; I6 = I5 + I6 (new I5)	;50-53

	xload	xmm6, [screg+160+16]		;; cosine/sine
	mulpd	xmm6, xmm2			;; A6 = R6 * cosine/sine	;5-10
	subpd	xmm6, xmm3			;; A6 = A6 - I6			;12-15
	mulpd	xmm3, [screg+160+16]		;; B6 = I6 * cosine/sine	;9-14
	addpd	xmm3, xmm2			;; B6 = B6 + R6			;16-19

	xload	xmm2, [dstreg+e2+e1]		;; R7
	subpd	xmm2, xmm4			;; R7 = R7 - I8 (new R7)	;38-41
	addpd	xmm4, [dstreg+e2+e1]		;; I8 = R7 + I8 (new R8)	;46-49

	xload	xmm7, [screg+128+16]		;; cosine/sine
	mulpd	xmm7, xmm0			;; A5 = R5 * cosine/sine	;11-16
	subpd	xmm7, xmm1			;; A5 = A5 - I5			;18-21
	mulpd	xmm1, [screg+128+16]		;; B5 = I5 * cosine/sine	;7-12
	addpd	xmm1, xmm0			;; B5 = B5 + R5			;14-17

	xload	xmm0, [dstreg+e2+e1+16]		;; I7
	subpd	xmm0, xmm5			;; I7 = I7 - R8 (new I8)	;32-35
	addpd	xmm5, [dstreg+e2+e1+16]		;; R8 = I7 + R8 (new I7)	;44-47

	mulpd	xmm6, [screg+160]		;; A6 = A6 * sine (final R6)	;17-22
	xstore	[dstreg+e2+32], xmm6		;; Save R6

	xload	xmm6, [screg+192+16]		;; cosine/sine
	mulpd	xmm6, xmm2			;; A7 = R7 * cosine/sine	;1-6
	subpd	xmm6, xmm5			;; A7 = A7 - I7			;8-11
	mulpd	xmm5, [screg+192+16]		;; B7 = I7 * cosine/sine	;3-8
	addpd	xmm5, xmm2			;; B7 = B7 + R7			;10-13

	mulpd	xmm3, [screg+160]		;; B6 = B6 * sine (final I6)	;21-26
	xstore	[dstreg+e2+48], xmm3		;; Save I6

	mulpd	xmm7, [screg+128]		;; A5 = A5 * sine (final R5)	;19-24
	mulpd	xmm1, [screg+128]		;; B5 = B5 * sine (final I5)	;23-28

	xstore	[dstreg+e2], xmm7		;; Save R5
	xstore	[dstreg+e2+16], xmm1		;; Save I5

	xload	xmm3, [screg+224+16]		;; cosine/sine
	mulpd	xmm3, xmm4			;; A8 = R8 * cosine/sine	;11-16
	subpd	xmm3, xmm0			;; A8 = A8 - I8			;18-21
	mulpd	xmm0, [screg+224+16]		;; B8 = I8 * cosine/sine	;7-12
	addpd	xmm0, xmm4			;; B8 = B8 + R8			;14-17

	mulpd	xmm6, [screg+192]		;; A7 = A7 * sine (new R7)	;13-18
	mulpd	xmm5, [screg+192]		;; B7 = B7 * sine (new I7)	;15-20
	mulpd	xmm3, [screg+224]		;; A8 = A8 * sine (new R8)	;19-24
	mulpd	xmm0, [screg+224]		;; B8 = B8 * sine (new I8)	;23-28

	xstore	[dstreg+e2+e1], xmm6		;; Save R7
	xstore	[dstreg+e2+e1+16], xmm5		;; Save I7
	xstore	[dstreg+e2+e1+32], xmm3		;; Save R8
	xstore	[dstreg+e2+e1+48], xmm0		;; Save I8

	xload	xmm3, [dstreg]			;; R1
	xload	xmm4, [dstreg+32]		;; R2
	subpd	xmm3, xmm4			;; R1 = R1 - R2 (new R2)	;40-43
	addpd	xmm4, [dstreg]			;; R2 = R1 + R2 (new R1)	;48-51

	xload	xmm7, [dstreg+16]		;; I1
	xload	xmm0, [dstreg+48]		;; I2
	subpd	xmm7, xmm0			;; I1 = I1 - I2 (new I2)	;42-45
	addpd	xmm0, [dstreg+16]		;; I2 = I1 + I2 (new I1)	;50-53

	xload	xmm1, [screg+32+16]		;; cosine/sine
	mulpd	xmm1, xmm3			;; A2 = R2 * cosine/sine	;5-10
	subpd	xmm1, xmm7			;; A2 = A2 - I2			;12-15
	mulpd	xmm7, [screg+32+16]		;; B2 = I2 * cosine/sine	;9-14
	addpd	xmm7, xmm3			;; B2 = B2 + R2			;16-19

	xload	xmm2, [screg+0+16]		;; cosine/sine
	mulpd	xmm2, xmm4			;; A1 = R1 * cosine/sine	;11-16
	subpd	xmm2, xmm0			;; A1 = A1 - I1			;18-21
	mulpd	xmm0, [screg+0+16]		;; B1 = I1 * cosine/sine	;7-12
	addpd	xmm0, xmm4			;; B1 = B1 + R1			;14-17

	mulpd	xmm1, [screg+32]		;; A2 = A2 * sine (final R2)	;17-22
	mulpd	xmm7, [screg+32]		;; B2 = B2 * sine (final I2)	;21-26
	mulpd	xmm2, [screg+0]			;; A1 = A1 * sine (final R1)	;19-24
	mulpd	xmm0, [screg+0]			;; B1 = B1 * sine (final I1)	;23-28

	xload	xmm5, [dstreg+e1]		;; R3
	xload	xmm6, [dstreg+e1+48]		;; I4
	subpd	xmm5, xmm6			;; R3 = R3 - I4 (new R3)	;38-41
	addpd	xmm6, [dstreg+e1]		;; I4 = R3 + I4 (new R4)	;46-49

	xload	xmm3, [dstreg+e1+16]		;; I3
	xload	xmm4, [dstreg+e1+32]		;; R4
	subpd	xmm3, xmm4			;; I3 = I3 - R4 (final I4)	;32-35
	addpd	xmm4, [dstreg+e1+16]		;; R4 = I3 + R4 (final I3)	;44-47

	xstore	[dstreg+32], xmm1		;; Save R2
	xstore	[dstreg+48], xmm7		;; Save I2
	xstore	[dstreg], xmm2			;; Save R1
	xstore	[dstreg+16], xmm0		;; Save I1

	xload	xmm1, [screg+64+16]		;; cosine/sine
	mulpd	xmm1, xmm5			;; A3 = R3 * cosine/sine	;1-6
	subpd	xmm1, xmm4			;; A3 = A3 - I3			;8-11
	mulpd	xmm4, [screg+64+16]		;; B3 = I3 * cosine/sine	;3-8
	addpd	xmm4, xmm5			;; B3 = B3 + R3			;10-13

	xload	xmm7, [screg+96+16]		;; cosine/sine
	mulpd	xmm7, xmm6			;; A4 = R4 * cosine/sine	;11-16
	subpd	xmm7, xmm3			;; A4 = A4 - I4			;18-21
	mulpd	xmm3, [screg+96+16]		;; B4 = I4 * cosine/sine	;7-12
	addpd	xmm3, xmm6			;; B4 = B4 + R4			;14-17

	mulpd	xmm1, [screg+64]		;; A3 = A3 * sine (final R3)	;13-18
	mulpd	xmm4, [screg+64]		;; B3 = B3 * sine (final I3)	;15-20
	mulpd	xmm7, [screg+96]		;; A4 = A4 * sine (final R4)	;19-24
	mulpd	xmm3, [screg+96]		;; B4 = B4 * sine (final I4)	;23-28

	xstore	[dstreg+e1], xmm1		;; Save R3
	xstore	[dstreg+e1+16], xmm4		;; Save I3
	xstore	[dstreg+e1+32], xmm7		;; Save R4
	xstore	[dstreg+e1+48], xmm3		;; Save I4
	ENDM

;
; Traditional radix-8 inverse FFT building block with 7 sin/cos multipliers
;

r4r8_g4cl_eight_complex_djbunfft MACRO srcreg,srcinc,d1,d2,dstreg,dstinc,e1,e2,screg,scoff
	;; need code here
	ENDM

;
; Radix-8 inverse FFT building block for all-complex split premultipliers.
; Has 8 premult/sin/cos multipliers.
;

r4r8_g4cl_eight_complex_ac_djbunfft MACRO srcreg,srcinc,d1,d2,dstreg,dstinc,e1,e2,screg,scoff
	xload	xmm7, [screg+scoff+0+16]	;; cosine/sine
	mulpd	xmm7, [srcreg]			;; A1 = R1 * cosine/sine	;5-10
	xload	xmm3, [screg+scoff+32+16]	;; cosine/sine
	mulpd	xmm3, [srcreg+32]		;; A2 = R2 * cosine/sine	;5-10
	xload	xmm0, [screg+scoff+64+16]	;; cosine/sine
	mulpd	xmm0, [srcreg+d1]		;; A3 = R3 * cosine/sine	;1-6
	xload	xmm1, [screg+scoff+96+16]	;; cosine/sine
	mulpd	xmm1, [srcreg+d1+32]		;; A4 = R4 * cosine/sine	;7-12

	xload	xmm2, [srcreg+16]		;; I1
	addpd	xmm7, xmm2			;; A1 = A1 + I1			;12-15
	mulpd	xmm2, [screg+scoff+0+16]	;; B1 = I1 * cosine/sine	;9-14
	xload	xmm4, [srcreg+48]		;; I2
	addpd	xmm3, xmm4			;; A2 = A2 + I2			;12-15
	mulpd	xmm4, [screg+scoff+32+16]	;; B2 = I2 * cosine/sine	;9-14
	xload	xmm6, [srcreg+d1+16]
	addpd	xmm0, xmm6			;; A3 = A3 + I3			;8-11
	mulpd	xmm6, [screg+scoff+64+16]	;; B3 = I3 * cosine/sine	;3-8

	mulpd	xmm7, [screg+scoff+0]		;; A1 = A1 * sine (new R1)	;17-22
	mulpd	xmm3, [screg+scoff+32]		;; A2 = A2 * sine (new R2)	;17-22

	xcopy	xmm5, xmm7			;; Copy R1
	subpd	xmm7, xmm3			;; R1 = R1 - R2 (new R2)	;20-23
	addpd	xmm3, xmm5			;; R2 = R1 + R2 (new R1)	;24-27

	xload	xmm5, [srcreg+d1+48]		;; I4
	addpd	xmm1, xmm5	 		;; A4 = A4 + I4			;14-17
	mulpd	xmm5, [screg+scoff+96+16]	;; B4 = I4 * cosine/sine	;11-16

	subpd	xmm2, [srcreg]			;; B1 = B1 - R1			;16-19
	subpd	xmm4, [srcreg+32]		;; B2 = B2 - R2			;16-19
	subpd	xmm6, [srcreg+d1]		;; B3 = B3 - R3			;10-13
	mulpd	xmm0, [screg+scoff+64]		;; A3 = A3 * sine (new R3)	;13-18
	subpd	xmm5, [srcreg+d1+32]		;; B4 = B4 - R4			;18-21
	mulpd	xmm1, [screg+scoff+96]		;; A4 = A4 * sine (new R4)	;19-24

	xstore	[dstreg+e1], xmm7		;; R2

	mulpd	xmm2, [screg+scoff+0]		;; B1 = B1 * sine (new I1)	;21-26
	mulpd	xmm4, [screg+scoff+32]		;; B2 = B2 * sine (new I2)	;21-26
	mulpd	xmm6, [screg+scoff+64]		;; B3 = B3 * sine (new I3)	;15-20
	mulpd	xmm5, [screg+scoff+96]		;; B4 = B4 * sine (new I4)	;23-28

	xcopy	xmm7, xmm1			;; Copy R4
	subpd	xmm1, xmm0			;; R4 = R4 - R3 (new I4)	;26-29
	addpd	xmm0, xmm7			;; R3 = R4 + R3 (new R3)	;34-37

	xcopy	xmm7, xmm2			;; Copy I1
	subpd	xmm2, xmm4			;; I1 = I1 - I2 (new I2)	;22-25
	addpd	xmm4, xmm7			;; I2 = I1 + I2 (new I1)	;28-31

	xcopy	xmm7, xmm6			;; Copy I3
	subpd	xmm6, xmm5			;; I3 = I3 - I4 (new R4)	;30-33
	addpd	xmm5, xmm7			;; I4 = I3 + I4 (new I3)	;36-39

	xload	xmm7, [screg+scoff+128+16]	;; cosine/sine
	mulpd	xmm7, [srcreg+d2]		;; A5 = R5 * cosine/sine	;5-10
	xstore	[dstreg], xmm3			;; R1
	xload	xmm3, [screg+scoff+160+16]	;; cosine/sine
	mulpd	xmm3, [srcreg+d2+32]		;; A6 = R6 * cosine/sine	;5-10
	xstore	[dstreg+e2], xmm0		;; R3
	xload	xmm0, [screg+scoff+192+16]	;; cosine/sine
	mulpd	xmm0, [srcreg+d2+d1]		;; A7 = R7 * cosine/sine	;1-6
	xstore	[dstreg+e2+e1+32], xmm1		;; I4
	xload	xmm1, [screg+scoff+224+16]	;; cosine/sine
	mulpd	xmm1, [srcreg+d2+d1+32]		;; A8 = R8 * cosine/sine	;7-12

	xstore	[dstreg+e1+32], xmm2		;; I2
	xload	xmm2, [srcreg+d2+16]		;; I5
	addpd	xmm7, xmm2			;; A5 = A5 + I5			;12-15
	xstore	[dstreg+32], xmm4		;; I1
	xload	xmm4, [srcreg+d2+48]		;; I6
	addpd	xmm3, xmm4			;; A6 = A6 + I6			;12-15
	xstore	[dstreg+e2+e1], xmm6		;; R4
	xload	xmm6, [srcreg+d2+d1+16]		;; I7
	addpd	xmm0, xmm6			;; A7 = A7 + I7			;8-11

	mulpd	xmm7, [screg+scoff+128]		;; A5 = A5 * sine (new R5)	;17-22
	mulpd	xmm3, [screg+scoff+160]		;; A6 = A6 * sine (new R6)	;17-22

	xstore	[dstreg+e2+32], xmm5		;; I3

	xcopy	xmm5, xmm7			;; Copy R5
	subpd	xmm7, xmm3			;; R5 = R5 - R6 (new R6)	;20-23
	addpd	xmm3, xmm5			;; R6 = R5 + R6 (new R5)	;24-27

	xload	xmm5, [srcreg+d2+d1+48]		;; I8
	addpd	xmm1, xmm5	 		;; A8 = A8 + I8			;14-17

	mulpd	xmm2, [screg+scoff+128+16]	;; B5 = I5 * cosine/sine	;9-14
	subpd	xmm2, [srcreg+d2]		;; B5 = B5 - R5			;16-19

	mulpd	xmm4, [screg+scoff+160+16]	;; B6 = I6 * cosine/sine	;9-14
	subpd	xmm4, [srcreg+d2+32]		;; B6 = B6 - R6			;16-19

	mulpd	xmm6, [screg+scoff+192+16]	;; B7 = I7 * cosine/sine	;3-8
	subpd	xmm6, [srcreg+d2+d1]		;; B7 = B7 - R7			;10-13

	mulpd	xmm5, [screg+scoff+224+16]	;; B8 = I8 * cosine/sine	;11-16
	subpd	xmm5, [srcreg+d2+d1+32]		;; B8 = B8 - R8			;18-21

	mulpd	xmm2, [screg+scoff+128]		;; B5 = B5 * sine (new I5)	;21-26
	mulpd	xmm4, [screg+scoff+160]		;; B6 = B6 * sine (new I6)	;21-26

	mulpd	xmm0, [screg+scoff+192]		;; A7 = A7 * sine (new R7)	;13-18
	mulpd	xmm6, [screg+scoff+192]		;; B7 = B7 * sine (new I7)	;15-20

	mulpd	xmm1, [screg+scoff+224]		;; A8 = A8 * sine (new R8)	;19-24
	mulpd	xmm5, [screg+scoff+224]		;; B8 = B8 * sine (new I8)	;23-28

	bump	srcreg, srcinc

	xstore	[dstreg+e1+16], xmm7		;; R6

	xcopy	xmm7, xmm2			;; Copy I5
	subpd	xmm2, xmm4			;; I5 = I5 - I6 (new I6)	;22-25
	addpd	xmm4, xmm7			;; I6 = I5 + I6 (new I5)	;28-31

	xcopy	xmm7, xmm1			;; Copy R8
	subpd	xmm1, xmm0			;; R8 = R8 - R7 (new I8)	;26-29
	addpd	xmm0, xmm7			;; R7 = R8 + R7 (new R7)	;34-37

	xcopy	xmm7, xmm6			;; Copy I7
	subpd	xmm6, xmm5			;; I7 = I7 - I8 (new R8)	;30-33
	addpd	xmm5, xmm7			;; I8 = I7 + I8 (new I7)	;36-39

	xcopy	xmm7, xmm0			;; Copy R7
	subpd	xmm0, xmm3			;; R7 = R7 - R5 (new I7)	;26-29
	addpd	xmm3, xmm7			;; R5 = R7 + R5 (new R5)	;34-37

	xcopy	xmm7, xmm4			;; Copy I5
	subpd	xmm4, xmm5			;; I5 = I5 - I7 (new R7)	;30-33
	addpd	xmm5, xmm7			;; I7 = I5 + I7 (new I5)	;36-39

	xstore	[dstreg+e1+48], xmm2		;; I6

	xload	xmm7, [dstreg]			;; R1
	xload	xmm2, [dstreg+e2]		;; R3
	subpd	xmm7, xmm2			;; R1 = R1 - R3 (new R3)	;20-23
	addpd	xmm2, [dstreg]			;; R3 = R1 + R3 (new R1)	;24-27

	xstore	[dstreg+e2+e1+16], xmm6		;; R8

	xcopy	xmm6, xmm7			;; Copy R3
	subpd	xmm7, xmm4			;; R3 = R3 - R7 (final R7)	;32-35
	addpd	xmm4, xmm6			;; R7 = R3 + R7 (final R3)	;44-47

	xstore	[dstreg+e2+e1+48], xmm1		;; I8

	xload	xmm6, [dstreg+32]		;; I1
	xload	xmm1, [dstreg+e2+32]		;; I3
	subpd	xmm6, xmm1			;; I1 = I1 - I3 (new I3)	;22-25
	addpd	xmm1, [dstreg+32]		;; I3 = I1 + I3 (new I1)	;28-31

	xstore	[dstreg+e2+16], xmm7		;; R7

	xcopy	xmm7, xmm6			;; Copy I3
	subpd	xmm6, xmm0			;; I3 = I3 - I7 (final I7)	;38-41
	addpd	xmm0, xmm7			;; I7 = I3 + I7 (final I3)	;46-49

	xcopy	xmm7, xmm2			;; Copy R1
	subpd	xmm2, xmm3			;; R1 = R1 - R5 (final R5)	;40-43
	addpd	xmm3, xmm7			;; R5 = R1 + R5 (final R1)	;48-51

	xcopy	xmm7, xmm1			;; Copy I1
	subpd	xmm1, xmm5			;; I1 = I1 - I5 (final I5)	;42-45
	addpd	xmm5, xmm7			;; I5 = I1 + I5 (final I1)	;50-53

	xstore	[dstreg+e2], xmm4		;; R3
	xstore	[dstreg+e2+32], xmm0		;; I3

	;; multiply R6/I6 by SQRTHALF - i*SQRTHALF
	xload	xmm4, [dstreg+e1+16]		;; R6
	xload	xmm0, [dstreg+e1+48]		;; I6
	subpd	xmm0, xmm4			;; I6 = I6 - R6			;16-19
	addpd	xmm4, [dstreg+e1+48]		;; R6 = R6 + I6			;12-15

	xstore	[dstreg+16], xmm2		;; R5
	xstore	[dstreg+48], xmm1		;; I5

	;; multiply R8/I8 by SQRTHALF - i*SQRTHALF
	xload	xmm2, [dstreg+e2+e1+16]		;; R8
	xload	xmm1, [dstreg+e2+e1+48]		;; I8
	subpd	xmm1, xmm2			;; I8 = I8 - R8			;16-19
	addpd	xmm2, [dstreg+e2+e1+48]		;; R8 = R8 + I8			;12-15

	xstore	[dstreg+32], xmm5		;; I1
	xload	xmm5, XMM_SQRTHALF
	mulpd	xmm0, xmm5			;; I6 = I6 * SQRTHALF (new I6)
	mulpd	xmm4, xmm5			;; R6 = R6 * SQRTHALF (new R6)
	mulpd	xmm1, xmm5			;; I8 = I8 * SQRTHALF (new I8)
	mulpd	xmm2, xmm5			;; R8 = R8 * SQRTHALF (new R8)

	xstore	[dstreg], xmm3			;; R1

	xload	xmm3, [dstreg+e1]		;; R2
	xload	xmm7, [dstreg+e2+e1]		;; R4
	addpd	xmm7, xmm3			;; R4 = R2 + R4 (new R2)	;24-27
	subpd	xmm3, [dstreg+e2+e1]		;; R2 = R2 - R4 (new R4)	;20-23

	xcopy	xmm5, xmm2			;; Copy R8
	subpd	xmm2, xmm4			;; R8 = R8 - R6 (new I8)	;26-29
	addpd	xmm4, xmm5			;; R6 = R8 + R6 (new R6)	;34-37

	xcopy	xmm5, xmm0			;; Copy I6
	subpd	xmm0, xmm1			;; I6 = I6 - I8 (new R8)	;30-33
	addpd	xmm1, xmm5			;; I8 = I6 + I8 (new I6)	;36-39

	xcopy	xmm5, xmm7			;; Copy R2
	subpd	xmm7, xmm4			;; R2 = R2 - R6 (final R6)	;40-43
	addpd	xmm4, xmm5			;; R6 = R2 + R6 (final R2)	;48-51

	xstore	[dstreg+e2+48], xmm6		;; I7
	xstore	[dstreg+e1+16], xmm7		;; R6

	xload	xmm5, [dstreg+e1+32]		;; I2
	xload	xmm6, [dstreg+e2+e1+32]		;; I4
	addpd	xmm6, xmm5			;; I4 = I2 + I4 (new I2)	;28-31
	subpd	xmm5, [dstreg+e2+e1+32]		;; I2 = I2 - I4 (new I4)	;22-25

	xcopy	xmm7, xmm3			;; Copy I4
	subpd	xmm3, xmm0			;; R4 = R4 - R8 (final R8)	;32-35
	addpd	xmm0, xmm7			;; R8 = R4 + R8 (final R4)	;44-47

	xcopy	xmm7, xmm6			;; Copy I2
	subpd	xmm6, xmm1			;; I2 = I2 - I6 (final I6)	;42-45
	addpd	xmm1, xmm7			;; I6 = I2 + I6 (final I2)	;50-53

	xcopy	xmm7, xmm5			;; Copy I4
	subpd	xmm5, xmm2			;; I4 = I4 - I8 (final I8)	;38-41
	addpd	xmm2, xmm7			;; I8 = I4 + I8 (final I4)	;46-49

	xstore	[dstreg+e1], xmm4		;; R2
	xstore	[dstreg+e1+32], xmm1		;; I2
	xstore	[dstreg+e2+e1], xmm0		;; R4
	xstore	[dstreg+e2+e1+32], xmm2		;; I4
	xstore	[dstreg+e1+48], xmm6		;; I6
	xstore	[dstreg+e2+e1+16], xmm3		;; R8
	xstore	[dstreg+e2+e1+48], xmm5		;; I8
	bump	dstreg, dstinc
	ENDM


;;
;; Override some of the above macros with versions optimized
;; for 64-bit Core 2 / Core i7.
;;

IFDEF X86_64
INCLUDE	r4r864.mac
ENDIF

;;
;; Override any or all of the above macros with versions
;; optimized for a different CPU architecture
;;

IF @INSTR(,@CATSTR(%xarch),<P4>) EQ 1
INCLUDE	r4r8p4.mac
IFDEF X86_64
;INCLUDE r4r864p4.mac
ENDIF
ENDIF

IF @INSTR(,@CATSTR(%xarch),<K8>) EQ 1
;INCLUDE	r4r8k8.mac
IFDEF X86_64
;INCLUDE	r4r864k8.mac
ENDIF
ENDIF

