;;
;; Macros for a radix-7 step in an AVX-512 FFT.
;;

;;
;; ************************************* seven-complex-djbfft variants ******************************************
;;

;; The standard version
zr7_seven_complex_djbfft_preload MACRO
	zr7_7c_djbfft_cmn_preload
	ENDM
zr7_seven_complex_djbfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbfft_cmn srcreg,0,srcinc,d1,noexec,0,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Offsets source by rbx
zr7f_seven_complex_djbfft_preload MACRO
	zr7_7c_djbfft_cmn_preload
	ENDM
zr7f_seven_complex_djbfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbfft_cmn srcreg,rbx,srcinc,d1,noexec,0,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like standard version except vbroadcastsd is used to reduce sin/cos data
zr7b_seven_complex_djbfft_preload MACRO
	zr7_7c_djbfft_cmn_preload
	ENDM
zr7b_seven_complex_djbfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbfft_cmn srcreg,0,srcinc,d1,exec,screg,16,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the zr7b version except sin/cos data is loaded from a larger fourteen-real/seven-complex sin/cos table
zr7rb_seven_complex_djbfft_preload MACRO
	zr7_7c_djbfft_cmn_preload
	ENDM
zr7rb_seven_complex_djbfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbfft_cmn srcreg,0,srcinc,d1,exec,screg+8,128,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; Common macro to operate on 7 complex values doing 2.807 levels of the FFT, applying
;; the sin/cos multipliers afterwards.

;; To calculate a 7-complex FFT in a brute force way (using a shorthand notation):
;; c1 + c2 + ... + c7 * w^0000000
;; c1 + c2 + ... + c7 * w^0123456
;; c1 + c2 + ... + c7 * w^02468AC
;; c1 + c2 + ... + c7 * w^0369...
;; c1 + c2 + ... + c7 * w^048...
;; c1 + c2 + ... + c7 * w^05A...
;; c1 + c2 + ... + c7 * w^06C...
;;
;; The sin/cos values (w = 7th root of unity) are:
;; w^1 = .623 + .782i
;; w^2 = -.223 + .975i
;; w^3 = -.901 + .434i
;; w^4 = -.901 -.434i .
;; w^5 = -.223 - .975i
;; w^6 = .623 - .782i
;;
;; Applying the sin/cos values above:
;; reals:
;; r1     +r2     +r3     +r4     +r5     +r6     +r7
;; r1 +.623r2 -.223r3 -.901r4 -.901r5 -.223r6 +.623r7  -.782i2 -.975i3 -.434i4 +.434i5 +.975i6 +.782i7
;; r1 -.223r2 -.901r3 +.623r4 +.623r5 -.901r6 -.223r7  -.975i2 +.434i3 +.782i4 -.782i5 -.434i6 +.975i7
;; r1 -.901r2 +.623r3 -.223r4 -.223r5 +.623r6 -.901r7  -.434i2 +.782i3 -.975i4 +.975i5 -.782i6 +.434i7
;; r1 -.901r2 +.623r3 -.223r4 -.223r5 +.623r6 -.901r7  +.434i2 -.782i3 +.975i4 -.975i5 +.782i6 -.434i7
;; r1 -.223r2 -.901r3 +.623r4 +.623r5 -.901r6 -.223r7  +.975i2 -.434i3 -.782i4 +.782i5 +.434i6 -.975i7
;; r1 +.623r2 -.223r3 -.901r4 -.901r5 -.223r6 +.623r7  +.782i2 +.975i3 +.434i4 -.434i5 -.975i6 -.782i7
;; imaginarys:
;;                                                 +i1     +i2     +i3     +i4     +i5     +i6     +i7
;; +.782r2 +.975r3 +.434r4 -.434r5 -.975r6 -.782r7 +i1 +.623i2 -.223i3 -.901i4 -.901i5 -.223i6 +.623i7
;; +.975r2 -.434r3 -.782r4 +.782r5 +.434r6 -.975r7 +i1 -.223i2 -.901i3 +.623i4 +.623i5 -.901i6 -.223i7
;; +.434r2 -.782r3 +.975r4 -.975r5 +.782r6 -.434r7 +i1 -.901i2 +.623i3 -.223i4 -.223i5 +.623i6 -.901i7
;; -.434r2 +.782r3 -.975r4 +.975r5 -.782r6 +.434r7 +i1 -.901i2 +.623i3 -.223i4 -.223i5 +.623i6 -.901i7
;; -.975r2 +.434r3 +.782r4 -.782r5 -.434r6 +.975r7 +i1 -.223i2 -.901i3 +.623i4 +.623i5 -.901i6 -.223i7
;; -.782r2 -.975r3 -.434r4 +.434r5 +.975r6 +.782r7 +i1 +.623i2 -.223i3 -.901i4 -.901i5 -.223i6 +.623i7
;;
;; Simplifying, we get:
;; R1= r1     +(r2+r7)     +(r3+r6)     +(r4+r5)
;; R2= r1 +.623(r2+r7) -.223(r3+r6) -.901(r4+r5)  -.782(i2-i7) -.975(i3-i6) -.434(i4-i5)
;; R7= r1 +.623(r2+r7) -.223(r3+r6) -.901(r4+r5)  +.782(i2-i7) +.975(i3-i6) +.434(i4-i5)
;; R3= r1 -.223(r2+r7) -.901(r3+r6) +.623(r4+r5)  -.975(i2-i7) +.434(i3-i6) +.782(i4-i5)
;; R6= r1 -.223(r2+r7) -.901(r3+r6) +.623(r4+r5)  +.975(i2-i7) -.434(i3-i6) -.782(i4-i5)
;; R4= r1 -.901(r2+r7) +.623(r3+r6) -.223(r4+r5)  -.434(i2-i7) +.782(i3-i6) -.975(i4-i5)
;; R5= r1 -.901(r2+r7) +.623(r3+r6) -.223(r4+r5)  +.434(i2-i7) -.782(i3-i6) +.975(i4-i5)
;; I1= i1                                             +(i2+i7)     +(i3+i6)     +(i4+i5)
;; I2= i1 +.782(r2-r7) +.975(r3-r6) +.434(r4-r5)  +.623(i2+i7) -.223(i3+i6) -.901(i4+i5)
;; I7= i1 -.782(r2-r7) -.975(r3-r6) -.434(r4-r5)  +.623(i2+i7) -.223(i3+i6) -.901(i4+i5)
;; I3= i1 +.975(r2-r7) -.434(r3-r6) -.782(r4-r5)  -.223(i2+i7) -.901(i3+i6) +.623(i4+i5)
;; I6= i1 -.975(r2-r7) +.434(r3-r6) +.782(r4-r5)  -.223(i2+i7) -.901(i3+i6) +.623(i4+i5)
;; I4= i1 +.434(r2-r7) -.782(r3-r6) +.975(r4-r5)  -.901(i2+i7) +.623(i3+i6) -.223(i4+i5)
;; I5= i1 -.434(r2-r7) +.782(r3-r6) -.975(r4-r5)  -.901(i2+i7) +.623(i3+i6) -.223(i4+i5)

;; Companion macro to peculiar 14-reals fft macro.  This seven-complex implementation internally produces R2/I2 through R7/I7
;; multiplied by 1/.975 and expects the sine values pre-multiplied by .975 to compensate.

;; The cos rows share a base.  With sum = (r2+r7)+(r3+r6)+(r4+r5), base = r1 - .223*sum zeroes one term in each cos row:
;; R27 = base + .846(r2+r7) - .678(r4+r5),  R36 = base - .678(r3+r6) + .846(r4+r5),  R45 = base - .678(r2+r7) + .846(r3+r6)
;; where .846 = .623+.223 and .678 = .901-.223.  The imaginary cos rows are done the same way.  This saves four FMAs.

zr7_7c_djbfft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975 = (.901-.223)/.975
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975 = (.623+.223)/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm28, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm27, ZMM_P782_P975	;; .782/.975
	vbroadcastsd zmm26, ZMM_P1_P975		;; 1/.975
	ENDM
zr7_7c_djbfft_cmn MACRO srcreg,srcoff,srcinc,d1,bcast,bcreg,bcsz,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm0, [srcreg+srcoff+1*d1+64]	;; i2
	vmovapd	zmm1, [srcreg+srcoff+6*d1+64]	;; i7
	vmovapd	zmm2, [srcreg+srcoff+2*d1]	;; r3
	vmovapd	zmm3, [srcreg+srcoff+5*d1]	;; r6
	vaddpd	zmm4, zmm0, zmm1		;; i2+i7						; 1-4		n 6
	vaddpd	zmm5, zmm2, zmm3		;; r3+r6						; 1-4		n 6

	vmovapd	zmm6, [srcreg+srcoff+1*d1]	;; r2
	vmovapd	zmm7, [srcreg+srcoff+6*d1]	;; r7
	vmovapd	zmm8, [srcreg+srcoff+2*d1+64]	;; i3
	vmovapd	zmm9, [srcreg+srcoff+5*d1+64]	;; i6
	vaddpd	zmm10, zmm6, zmm7		;; r2+r7						; 2-5		n 6
	vaddpd	zmm11, zmm8, zmm9		;; i3+i6						; 2-5		n 6

	vmovapd	zmm12, [srcreg+srcoff+3*d1+64]	;; i4
	vmovapd	zmm13, [srcreg+srcoff+4*d1+64]	;; i5
	vsubpd	zmm14, zmm12, zmm13		;; i4-i5						; 3-6		n 8
	vaddpd	zmm12, zmm12, zmm13		;; i4+i5						; 3-6		n 10

	vmovapd	zmm13, [srcreg+srcoff+3*d1]	;; r4
	vmovapd	zmm15, [srcreg+srcoff+4*d1]	;; r5
	vaddpd	zmm16, zmm13, zmm15		;; r4+r5						; 4-7		n 10
	vsubpd	zmm0, zmm0, zmm1		;; i2-i7						; 4-7		n 8

	vsubpd	zmm1, zmm2, zmm3		;; r3-r6						; 5-8		n 9
	vsubpd	zmm2, zmm13, zmm15		;; r4-r5						; 5-8		n 9

	vaddpd	zmm3, zmm10, zmm5		;; rsum = (r2+r7) + (r3+r6)				; 6-9		n 10
	vaddpd	zmm13, zmm4, zmm11		;; isum = (i2+i7) + (i3+i6)				; 6-9		n 10

	vsubpd	zmm6, zmm6, zmm7		;; r2-r7						; 7-10		n 11
	vsubpd	zmm7, zmm8, zmm9		;; i3-i6						; 7-10		n 11

	vmovapd	zmm8, [srcreg+srcoff+0*d1+64]	;; i1
	zfmaddpd zmm9, zmm0, zmm28, zmm14	;; r45tmp = .434/.975(i2-i7) + (i4-i5)			; 8-11		n 13
	vmulpd	zmm15, zmm26, zmm8		;; i1/.975						; 8-11		n 14

	L1prefetchw srcreg+0*d1+L1pd, L1pt
	vmovapd	zmm17, [srcreg+srcoff+0*d1]	;; r1
	zfmaddpd zmm18, zmm2, zmm28, zmm1	;; i27tmp = .434/.975(r4-r5) + (r3-r6)			; 9-12		n 13
	vmulpd	zmm19, zmm26, zmm17		;; r1/.975						; 9-12		n 14

	L1prefetchw srcreg+0*d1+64+L1pd, L1pt
	vaddpd	zmm3, zmm3, zmm16		;; rsum = rsum + (r4+r5)				; 10-13		n 14
	vaddpd	zmm13, zmm13, zmm12		;; isum = isum + (i4+i5)				; 10-13		n 14

	L1prefetchw srcreg+1*d1+L1pd, L1pt
	zfmsubpd zmm20, zmm1, zmm28, zmm6	;; i36tmp = .434/.975(r3-r6) - (r2-r7)			; 11-14		n 15
	zfmaddpd zmm21, zmm14, zmm28, zmm7	;; r27tmp = .434/.975(i4-i5) + (i3-i6)			; 11-14		n 15

	L1prefetchw srcreg+1*d1+64+L1pd, L1pt
	zfmsubpd zmm22, zmm7, zmm28, zmm0	;; r36tmp = .434/.975(i3-i6) - (i2-i7)			; 12-15		n 16
	zfmaddpd zmm23, zmm6, zmm28, zmm2	;; i45tmp = .434/.975(r2-r7) + (r4-r5)			; 12-15		n 16

	L1prefetchw srcreg+2*d1+L1pd, L1pt
	zfmaddpd zmm18, zmm6, zmm27, zmm18	;; i27tmp = i27tmp + .782/.975(r2-r7)			; 13-16		n 17
	zfnmaddpd zmm9, zmm7, zmm27, zmm9	;; r45tmp = r45tmp - .782/.975(i3-i6)			; 13-16		n 17

	L1prefetchw srcreg+2*d1+64+L1pd, L1pt
	zfnmaddpd zmm15, zmm13, zmm29, zmm15	;; ibase = i1/.975 - .223/.975*isum			; 14-17		n 19
	zfnmaddpd zmm19, zmm3, zmm29, zmm19	;; rbase = r1/.975 - .223/.975*rsum			; 14-17		n 18

	L1prefetchw srcreg+3*d1+L1pd, L1pt
	zfmaddpd zmm20, zmm2, zmm27, zmm20	;; i36tmp = i36tmp + .782/.975(r4-r5)			; 15-18		n 22
	zfmaddpd zmm21, zmm0, zmm27, zmm21	;; r27tmp = r27tmp + .782/.975(i2-i7)			; 15-18		n 23

	L1prefetchw srcreg+3*d1+64+L1pd, L1pt
	zfmaddpd zmm22, zmm14, zmm27, zmm22	;; r36tmp = r36tmp + .782/.975(i4-i5)			; 16-19		n 21
	zfnmaddpd zmm23, zmm1, zmm27, zmm23	;; i45tmp = i45tmp - .782/.975(r3-r6)			; 16-19		n 21

	L1prefetchw srcreg+4*d1+L1pd, L1pt
no bcast vmovapd zmm0, [screg+2*128]		;; sine*.975 for R4/I4/R5/I5 (w^3)
bcast	vbroadcastsd zmm0, Q [bcreg+2*bcsz]	;; sine*.975 for R4/I4/R5/I5 (w^3)
no bcast vmovapd zmm1, [screg+0*128]		;; sine*.975 for R2/I2/R7/I7 (w^1)
bcast	vbroadcastsd zmm1, Q [bcreg+0*bcsz]	;; sine*.975 for R2/I2/R7/I7 (w^1)
	vmulpd	zmm2, zmm9, zmm0		;; r45tmp = r45tmp * sine45*.975			; 17-20		n 28
	vmulpd	zmm6, zmm18, zmm1		;; i27tmp = i27tmp * sine27*.975			; 17-20		n 29

	L1prefetchw srcreg+4*d1+64+L1pd, L1pt
	zfmaddpd zmm7, zmm10, zmm30, zmm19	;; R27 = rbase + .846/.975(r2+r7)			; 18-21		n 22
	zfnmaddpd zmm10, zmm10, zmm31, zmm19	;; R45 = rbase - .678/.975(r2+r7)			; 18-21		n 24

	L1prefetchw srcreg+5*d1+L1pd, L1pt
	zfnmaddpd zmm19, zmm5, zmm31, zmm19	;; R36 = rbase - .678/.975(r3+r6)			; 19-22		n 23
	zfmaddpd zmm9, zmm4, zmm30, zmm15	;; I27 = ibase + .846/.975(i2+i7)			; 19-22		n 25

	L1prefetchw srcreg+5*d1+64+L1pd, L1pt
	zfnmaddpd zmm4, zmm4, zmm31, zmm15	;; I45 = ibase - .678/.975(i2+i7)			; 20-23		n 25
	zfnmaddpd zmm15, zmm11, zmm31, zmm15	;; I36 = ibase - .678/.975(i3+i6)			; 20-23		n 24

	L1prefetchw srcreg+6*d1+L1pd, L1pt
no bcast vmovapd zmm14, [screg+1*128]		;; sine*.975 for R3/I3/R6/I6 (w^2)
bcast	vbroadcastsd zmm14, Q [bcreg+1*bcsz]	;; sine*.975 for R3/I3/R6/I6 (w^2)
	vmulpd	zmm18, zmm22, zmm14		;; r36tmp = r36tmp * sine36*.975			; 21-24		n 27
	vmulpd	zmm22, zmm23, zmm0		;; i45tmp = i45tmp * sine45*.975			; 21-24		n 29

	L1prefetchw srcreg+6*d1+64+L1pd, L1pt
	zfnmaddpd zmm7, zmm16, zmm31, zmm7	;; R27 = R27 - .678/.975(r4+r5)				; 22-25		n 27
	vmulpd	zmm20, zmm20, zmm14		;; i36tmp = i36tmp * sine36*.975			; 22-25		n 28

	zfmaddpd zmm19, zmm16, zmm30, zmm19	;; R36 = R36 + .846/.975(r4+r5)				; 23-26		n 27
	vmulpd	zmm16, zmm21, zmm1		;; r27tmp = r27tmp * sine27*.975			; 23-26		n 27

	zfmaddpd zmm15, zmm12, zmm30, zmm15	;; I36 = I36 + .846/.975(i4+i5)				; 24-27		n 28
	zfmaddpd zmm10, zmm5, zmm30, zmm10	;; R45 = R45 + .846/.975(r3+r6)				; 24-27		n 28

	zfnmaddpd zmm9, zmm12, zmm31, zmm9	;; I27 = I27 - .678/.975(i4+i5)				; 25-28		n 29
	zfmaddpd zmm4, zmm11, zmm30, zmm4	;; I45 = I45 + .846/.975(i3+i6)				; 25-28		n 29

	vaddpd	zmm3, zmm17, zmm3		;; R1 = r1 + rsum					; 26-29
	vaddpd	zmm5, zmm8, zmm13		;; I1 = i1 + isum					; 26-29

	zfmaddpd zmm8, zmm19, zmm14, zmm18	;; R3 = R36*sine36*.975 + r36tmp			; 27-30		n 32
	zfmsubpd zmm11, zmm7, zmm1, zmm16	;; R2 = R27*sine27*.975 - r27tmp			; 27-30		n 34

	zfmsubpd zmm12, zmm10, zmm0, zmm2	;; R4 = R45*sine45*.975 - r45tmp			; 28-31		n 36
	zfmsubpd zmm13, zmm15, zmm14, zmm20	;; I3 = I36*sine36*.975 - i36tmp			; 28-31		n 32

	zfmaddpd zmm17, zmm9, zmm1, zmm6	;; I2 = I27*sine27*.975 + i27tmp			; 29-32		n 34
	zfmsubpd zmm21, zmm4, zmm0, zmm22	;; I5 = I45*sine45*.975 - i45tmp			; 29-32		n 37

	zfmsubpd zmm6, zmm9, zmm1, zmm6		;; I7 = I27*sine27*.975 - i27tmp			; 30-33		n 37
	zfmaddpd zmm22, zmm4, zmm0, zmm22	;; I4 = I45*sine45*.975 + i45tmp			; 30-33		n 36
	zstore	[srcreg+0*d1], zmm3		;; Save R1						; 30

	zfmsubpd zmm18, zmm19, zmm14, zmm18	;; R6 = R36*sine36*.975 - r36tmp			; 31-34		n 35
	zfmaddpd zmm20, zmm15, zmm14, zmm20	;; I6 = I36*sine36*.975 + i36tmp			; 31-34		n 35
	zstore	[srcreg+0*d1+64], zmm5		;; Save I1						; 30+1

no bcast vmovapd zmm3, [screg+1*128+64]		;; cosine/sine for R3/I3/R6/I6 (w^2)
bcast	vbroadcastsd zmm3, Q [bcreg+1*bcsz+bcsz/2] ;; cosine/sine for R3/I3/R6/I6 (w^2)
	zfmsubpd zmm4, zmm8, zmm3, zmm13	;; R3 * cosine/sine - I3 (final R3)			; 32-35
	zfmaddpd zmm8, zmm13, zmm3, zmm8	;; I3 * cosine/sine + R3 (final I3)			; 32-35

	zfmaddpd zmm2, zmm10, zmm0, zmm2	;; R5 = R45*sine45*.975 + r45tmp			; 33-36		n 37
	zfmaddpd zmm16, zmm7, zmm1, zmm16	;; R7 = R27*sine27*.975 + r27tmp			; 33-36		n 37

no bcast vmovapd zmm0, [screg+0*128+64]		;; cosine/sine for R2/I2/R7/I7 (w^1)
bcast	vbroadcastsd zmm0, Q [bcreg+0*bcsz+bcsz/2] ;; cosine/sine for R2/I2/R7/I7 (w^1)
	zfmaddpd zmm1, zmm17, zmm0, zmm11	;; I2 * cosine/sine + R2 (final I2)			; 34-37
	zfmsubpd zmm17, zmm11, zmm0, zmm17	;; R2 * cosine/sine - I2 (final R2)			; 34-37

	zfmaddpd zmm5, zmm18, zmm3, zmm20	;; R6 * cosine/sine + I6 (final R6)			; 35-38
	zfmsubpd zmm18, zmm20, zmm3, zmm18	;; I6 * cosine/sine - R6 (final I6)			; 35-38

no bcast vmovapd zmm3, [screg+2*128+64]		;; cosine/sine for R4/I4/R5/I5 (w^3)
bcast	vbroadcastsd zmm3, Q [bcreg+2*bcsz+bcsz/2] ;; cosine/sine for R4/I4/R5/I5 (w^3)
	bump	screg, scinc
	zfmsubpd zmm7, zmm12, zmm3, zmm22	;; R4 * cosine/sine - I4 (final R4)			; 36-39
	zfmaddpd zmm12, zmm22, zmm3, zmm12	;; I4 * cosine/sine + R4 (final I4)			; 36-39
	zstore	[srcreg+2*d1], zmm4		;; Save R3						; 36

	zfmaddpd zmm4, zmm16, zmm0, zmm6	;; R7 * cosine/sine + I7 (final R7)			; 37-40
	zfmsubpd zmm9, zmm21, zmm3, zmm2	;; I5 * cosine/sine - R5 (final I5)			; 37-40
	zstore	[srcreg+2*d1+64], zmm8		;; Save I3						; 36+1

	zfmsubpd zmm16, zmm6, zmm0, zmm16	;; I7 * cosine/sine - R7 (final I7)			; 38-41
	zfmaddpd zmm21, zmm2, zmm3, zmm21	;; R5 * cosine/sine + I5 (final R5)			; 38-41
	zstore	[srcreg+1*d1], zmm17		;; Save R2						; 38

	zstore	[srcreg+1*d1+64], zmm1		;; Save I2						; 38+1
	zstore	[srcreg+5*d1], zmm5		;; Save R6						; 39+1
	zstore	[srcreg+5*d1+64], zmm18		;; Save I6						; 39+2
	zstore	[srcreg+3*d1], zmm7		;; Save R4						; 40+2
	zstore	[srcreg+3*d1+64], zmm12		;; Save I4						; 40+3
	zstore	[srcreg+6*d1], zmm4		;; Save R7						; 41+3
	zstore	[srcreg+4*d1+64], zmm9		;; Save I5						; 41+4
	zstore	[srcreg+6*d1+64], zmm16		;; Save I7						; 42+4
	zstore	[srcreg+4*d1], zmm21		;; Save R5						; 42+5
	bump	srcreg, srcinc
	ENDM

;;
;; ************************************* seven-complex-djbunfft variants ******************************************
;;

;; The standard version
zr7_seven_complex_djbunfft_preload MACRO
	zr7_7c_djbunfft_cmn_preload
	ENDM
zr7_seven_complex_djbunfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbunfft_cmn srcreg,srcinc,d1,noexec,0,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the standard version except vbroadcastsd is used to reduce sin/cos data
zr7b_seven_complex_djbunfft_preload MACRO
	zr7_7c_djbunfft_cmn_preload
	ENDM
zr7b_seven_complex_djbunfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbunfft_cmn srcreg,srcinc,d1,exec,screg,16,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

; Like the zr7b version except sin/cos data is loaded from a larger fourteen-real/seven_complex sin/cos table
zr7rb_seven_complex_djbunfft_preload MACRO
	zr7_7c_djbunfft_cmn_preload
	ENDM
zr7rb_seven_complex_djbunfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_7c_djbunfft_cmn srcreg,srcinc,d1,exec,screg+8,128,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; Common code to do the 7-complex inverse FFT.
;; First we apply twiddle factors to 6 of the 7 input numbers.
;; A 7-complex inverse FFT is like the forward FFT except all the sin values are negated.

;; To calculate a 7-complex FFT in a brute force way (using a shorthand notation):
;; c1 + c2 + ... + c7 * w^-0000000
;; c1 + c2 + ... + c7 * w^-0123456
;; c1 + c2 + ... + c7 * w^-02468AC
;; c1 + c2 + ... + c7 * w^-0369...
;; c1 + c2 + ... + c7 * w^-048...
;; c1 + c2 + ... + c7 * w^-05A...
;; c1 + c2 + ... + c7 * w^-06C...
;;
;; The sin/cos values (w = 7th root of unity) are:
;; w^-1 = .623 - .782i
;; w^-2 = -.223 - .975i
;; w^-3 = -.901 - .434i
;; w^-4 = -.901 + .434i
;; w^-5 = -.223 + .975i
;; w^-6 = .623 + .782i
;;
;; Applying the sin/cos values above:
;; reals:
;; R1= r1     +r2     +r3     +r4     +r5     +r6     +r7
;; R2= r1 +.623r2 -.223r3 -.901r4 -.901r5 -.223r6 +.623r7  +.782i2 +.975i3 +.434i4 -.434i5 -.975i6 -.782i7
;; R3= r1 -.223r2 -.901r3 +.623r4 +.623r5 -.901r6 -.223r7  +.975i2 -.434i3 -.782i4 +.782i5 +.434i6 -.975i7
;; R4= r1 -.901r2 +.623r3 -.223r4 -.223r5 +.623r6 -.901r7  +.434i2 -.782i3 +.975i4 -.975i5 +.782i6 -.434i7
;; R5= r1 -.901r2 +.623r3 -.223r4 -.223r5 +.623r6 -.901r7  -.434i2 +.782i3 -.975i4 +.975i5 -.782i6 +.434i7
;; R6= r1 -.223r2 -.901r3 +.623r4 +.623r5 -.901r6 -.223r7  -.975i2 +.434i3 +.782i4 -.782i5 -.434i6 +.975i7
;; R7= r1 +.623r2 -.223r3 -.901r4 -.901r5 -.223r6 +.623r7  -.782i2 -.975i3 -.434i4 +.434i5 +.975i6 +.782i7
;; I1= i1                                                      +i2     +i3     +i4     +i5     +i6     +i7
;; I2= i1 -.782r2 -.975r3 -.434r4 +.434r5 +.975r6 +.782r7  +.623i2 -.223i3 -.901i4 -.901i5 -.223i6 +.623i7
;; I3= i1 -.975r2 +.434r3 +.782r4 -.782r5 -.434r6 +.975r7  -.223i2 -.901i3 +.623i4 +.623i5 -.901i6 -.223i7
;; I4= i1 -.434r2 +.782r3 -.975r4 +.975r5 -.782r6 +.434r7  -.901i2 +.623i3 -.223i4 -.223i5 +.623i6 -.901i7
;; I5= i1 +.434r2 -.782r3 +.975r4 -.975r5 +.782r6 -.434r7  -.901i2 +.623i3 -.223i4 -.223i5 +.623i6 -.901i7
;; I6= i1 +.975r2 -.434r3 -.782r4 +.782r5 +.434r6 -.975r7  -.223i2 -.901i3 +.623i4 +.623i5 -.901i6 -.223i7
;; I7= i1 +.782r2 +.975r3 +.434r4 -.434r5 -.975r6 -.782r7  +.623i2 -.223i3 -.901i4 -.901i5 -.223i6 +.623i7

;; Simplifying, we get:
;; R1= r1     +(r2+r7)     +(r3+r6)     +(r4+r5)
;; R2= r1 +.623(r2+r7) -.223(r3+r6) -.901(r4+r5)  +.782(i2-i7) +.975(i3-i6) +.434(i4-i5)
;; R7= r1 +.623(r2+r7) -.223(r3+r6) -.901(r4+r5)  -.782(i2-i7) -.975(i3-i6) -.434(i4-i5)
;; R3= r1 -.223(r2+r7) -.901(r3+r6) +.623(r4+r5)  +.975(i2-i7) -.434(i3-i6) -.782(i4-i5)
;; R6= r1 -.223(r2+r7) -.901(r3+r6) +.623(r4+r5)  -.975(i2-i7) +.434(i3-i6) +.782(i4-i5)
;; R4= r1 -.901(r2+r7) +.623(r3+r6) -.223(r4+r5)  +.434(i2-i7) -.782(i3-i6) +.975(i4-i5)
;; R5= r1 -.901(r2+r7) +.623(r3+r6) -.223(r4+r5)  -.434(i2-i7) +.782(i3-i6) -.975(i4-i5)
;; I1= i1                                             +(i2+i7)     +(i3+i6)     +(i4+i5)
;; I2= i1 -.782(r2-r7) -.975(r3-r6) -.434(r4-r5)  +.623(i2+i7) -.223(i3+i6) -.901(i4+i5)
;; I7= i1 +.782(r2-r7) +.975(r3-r6) +.434(r4-r5)  +.623(i2+i7) -.223(i3+i6) -.901(i4+i5)
;; I3= i1 -.975(r2-r7) +.434(r3-r6) +.782(r4-r5)  -.223(i2+i7) -.901(i3+i6) +.623(i4+i5)
;; I6= i1 +.975(r2-r7) -.434(r3-r6) -.782(r4-r5)  -.223(i2+i7) -.901(i3+i6) +.623(i4+i5)
;; I4= i1 -.434(r2-r7) +.782(r3-r6) -.975(r4-r5)  -.901(i2+i7) +.623(i3+i6) -.223(i4+i5)
;; I5= i1 +.434(r2-r7) -.782(r3-r6) +.975(r4-r5)  -.901(i2+i7) +.623(i3+i6) -.223(i4+i5)

;; The cos rows share a base.  With sum = (r2+r7)+(r3+r6)+(r4+r5), base = r1 - .223*sum zeroes one term in each cos row:
;; R27 = base + .846(r2+r7) - .678(r4+r5),  R36 = base - .678(r3+r6) + .846(r4+r5),  R45 = base - .678(r2+r7) + .846(r3+r6)
;; where .846 = .623+.223 and .678 = .901-.223.  The imaginary cos rows are done the same way.  This saves four FMAs.

zr7_7c_djbunfft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975 = (.901-.223)/.975
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975 = (.623+.223)/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm28, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm27, ZMM_P782_P975	;; .782/.975
	vbroadcastsd zmm26, ZMM_P1_P975		;; 1/.975
	ENDM
zr7_7c_djbunfft_cmn MACRO srcreg,srcinc,d1,bcast,bcreg,bcsz,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm0, [srcreg+2*d1]		;; r3
no bcast vmovapd zmm1, [screg+1*128+64]		;; cosine/sine for R3/I3/R6/I6 (w^2)
bcast	vbroadcastsd zmm1, Q [bcreg+1*bcsz+bcsz/2] ;; cosine/sine for R3/I3/R6/I6 (w^2)
	vmovapd	zmm2, [srcreg+2*d1+64]		;; i3
	vmovapd	zmm3, [srcreg+1*d1]		;; r2
no bcast vmovapd zmm4, [screg+0*128+64]		;; cosine/sine for R2/I2/R7/I7 (w^1)
bcast	vbroadcastsd zmm4, Q [bcreg+0*bcsz+bcsz/2] ;; cosine/sine for R2/I2/R7/I7 (w^1)
	vmovapd	zmm5, [srcreg+1*d1+64]		;; i2
	zfmaddpd zmm6, zmm0, zmm1, zmm2		;; A3 = R3 * cosine/sine + I3				; 1-4		n 5
	zfmaddpd zmm7, zmm3, zmm4, zmm5		;; A2 = R2 * cosine/sine + I2				; 1-4		n 5

	zfmsubpd zmm3, zmm5, zmm4, zmm3		;; B2 = I2 * cosine/sine - R2				; 2-5		n 6
	zfmsubpd zmm0, zmm2, zmm1, zmm0		;; B3 = I3 * cosine/sine - R3				; 2-5		n 6

	vmovapd	zmm2, [srcreg+6*d1]		;; r7
	vmovapd	zmm5, [srcreg+6*d1+64]		;; i7
	vmovapd	zmm8, [srcreg+3*d1+64]		;; i4
no bcast vmovapd zmm9, [screg+2*128+64]		;; cosine/sine for R4/I4/R5/I5 (w^3)
bcast	vbroadcastsd zmm9, Q [bcreg+2*bcsz+bcsz/2] ;; cosine/sine for R4/I4/R5/I5 (w^3)
	vmovapd	zmm10, [srcreg+3*d1]		;; r4
	zfmsubpd zmm11, zmm2, zmm4, zmm5	;; A7 = R7 * cosine/sine - I7				; 3-6		n 9
	zfmsubpd zmm12, zmm8, zmm9, zmm10	;; B4 = I4 * cosine/sine - R4				; 3-6		n 10

	vmovapd	zmm13, [srcreg+5*d1]		;; r6
	vmovapd	zmm14, [srcreg+5*d1+64]		;; i6
	zfmaddpd zmm8, zmm10, zmm9, zmm8	;; A4 = R4 * cosine/sine + I4				; 4-7		n 8
	zfmsubpd zmm10, zmm13, zmm1, zmm14	;; A6 = R6 * cosine/sine - I6				; 4-7		n 9

no bcast vmovapd zmm15, [screg+1*128]		;; sine*.975 for R3/I3/R6/I6 (w^2)
bcast	vbroadcastsd zmm15, Q [bcreg+1*bcsz]	;; sine*.975 for R3/I3/R6/I6 (w^2)
no bcast vmovapd zmm16, [screg+0*128]		;; sine*.975 for R2/I2/R7/I7 (w^1)
bcast	vbroadcastsd zmm16, Q [bcreg+0*bcsz]	;; sine*.975 for R2/I2/R7/I7 (w^1)
	vmulpd	zmm6, zmm6, zmm15		;; A3 = A3 * sine*.975 (new R3)				; 5-8		n 9
	vmulpd	zmm7, zmm7, zmm16		;; A2 = A2 * sine*.975 (new R2)				; 5-8		n 9

	vmulpd	zmm0, zmm0, zmm15		;; B3 = B3 * sine*.975 (new I3)				; 6-9		n 11
	vmulpd	zmm3, zmm3, zmm16		;; B2 = B2 * sine*.975 (new I2)				; 6-9		n 11

	zfmaddpd zmm13, zmm14, zmm1, zmm13	;; B6 = I6 * cosine/sine + R6				; 7-10		n 11
	zfmaddpd zmm2, zmm5, zmm4, zmm2		;; B7 = I7 * cosine/sine + R7				; 7-10		n 11

no bcast vmovapd zmm1, [screg+2*128]		;; sine*.975 for R4/I4/R5/I5 (w^3)
bcast	vbroadcastsd zmm1, Q [bcreg+2*bcsz]	;; sine*.975 for R4/I4/R5/I5 (w^3)
	bump	screg, scinc
	vmovapd	zmm4, [srcreg+4*d1]		;; r5
	vmovapd	zmm5, [srcreg+4*d1+64]		;; i5
	vmulpd	zmm8, zmm8, zmm1		;; A4 = A4 * sine*.975 (new R4)				; 8-11		n 12
	zfmsubpd zmm14, zmm4, zmm9, zmm5	;; A5 = R5 * cosine/sine - I5				; 8-11		n 12

	L1prefetchw srcreg+0*d1+L1pd, L1pt
	zfmaddpd zmm17, zmm10, zmm15, zmm6	;; r3+r6*sine*.975					; 9-12		n 13
	zfmaddpd zmm18, zmm11, zmm16, zmm7	;; r2+r7*sine*.975					; 9-12		n 13

	L1prefetchw srcreg+0*d1+64+L1pd, L1pt
	vmulpd	zmm12, zmm12, zmm1		;; B4 = B4 * sine*.975 (new I4)				; 10-13		n 14
	zfmaddpd zmm4, zmm5, zmm9, zmm4		;; B5 = I5 * cosine/sine + R5				; 10-13		n 14

	L1prefetchw srcreg+1*d1+L1pd, L1pt
	zfmaddpd zmm5, zmm13, zmm15, zmm0	;; i3+i6*sine*.975					; 11-14		n 15
	zfmaddpd zmm9, zmm2, zmm16, zmm3	;; i2+i7*sine*.975					; 11-14		n 15

	L1prefetchw srcreg+1*d1+64+L1pd, L1pt
	zfmaddpd zmm19, zmm14, zmm1, zmm8	;; r4+r5*sine*.975					; 12-15		n 17
	zfnmaddpd zmm7, zmm11, zmm16, zmm7	;; r2-r7*sine*.975					; 12-15		n 18

	L1prefetchw srcreg+2*d1+L1pd, L1pt
	vaddpd	zmm11, zmm18, zmm17		;; rsum = (r2+r7) + (r3+r6)				; 13-16		n 17
	zfnmaddpd zmm3, zmm2, zmm16, zmm3	;; i2-i7*sine*.975					; 13-16		n 21

	L1prefetchw srcreg+2*d1+64+L1pd, L1pt
	zfmaddpd zmm2, zmm4, zmm1, zmm12	;; i4+i5*sine*.975					; 14-17		n 19
	zfnmaddpd zmm6, zmm10, zmm15, zmm6	;; r3-r6*sine*.975					; 14-17		n 18

	L1prefetchw srcreg+3*d1+L1pd, L1pt
	vaddpd	zmm10, zmm9, zmm5		;; isum = (i2+i7) + (i3+i6)				; 15-18		n 19
	zfnmaddpd zmm8, zmm14, zmm1, zmm8	;; r4-r5*sine*.975					; 15-18		n 19

	L1prefetchw srcreg+3*d1+64+L1pd, L1pt
	zfnmaddpd zmm12, zmm4, zmm1, zmm12	;; i4-i5*sine*.975					; 16-19		n 20
	zfnmaddpd zmm0, zmm13, zmm15, zmm0	;; i3-i6*sine*.975					; 16-19		n 20

	L1prefetchw srcreg+4*d1+L1pd, L1pt
	vaddpd	zmm1, zmm11, zmm19		;; rsum = rsum + (r4+r5)				; 17-20		n 21

	L1prefetchw srcreg+4*d1+64+L1pd, L1pt
	zfmsubpd zmm4, zmm6, zmm28, zmm7	;; i36tmp = .434/.975(r3-r6) - (r2-r7)			; 18-21		n 22

	L1prefetchw srcreg+5*d1+L1pd, L1pt
	vaddpd	zmm10, zmm10, zmm2		;; isum = isum + (i4+i5)				; 19-22		n 23
	zfmaddpd zmm11, zmm8, zmm28, zmm6	;; i27tmp = .434/.975(r4-r5) + (r3-r6)			; 19-22		n 23

	L1prefetchw srcreg+5*d1+64+L1pd, L1pt
	zfmaddpd zmm13, zmm12, zmm28, zmm0	;; r27tmp = .434/.975(i4-i5) + (i3-i6)			; 20-23		n 24
	zfmaddpd zmm14, zmm7, zmm28, zmm8	;; i45tmp = .434/.975(r2-r7) + (r4-r5)			; 20-23		n 24

	L1prefetchw srcreg+6*d1+L1pd, L1pt
	vmovapd	zmm15, [srcreg+0*d1]		;; r1
	zfnmaddpd zmm16, zmm1, zmm29, zmm15	;; rbase = r1 - .223/.975*rsum				; 21-24		n 25
	zfmsubpd zmm20, zmm0, zmm28, zmm3	;; r36tmp = .434/.975(i3-i6) - (i2-i7)			; 21-24		n 28

	L1prefetchw srcreg+6*d1+64+L1pd, L1pt
	zfmaddpd zmm21, zmm3, zmm28, zmm12	;; r45tmp = .434/.975(i2-i7) + (i4-i5)			; 22-25		n 26
	zfmaddpd zmm4, zmm8, zmm27, zmm4	;; i36tmp = i36tmp + .782/.975(r4-r5)			; 22-25		n 36

	vmovapd	zmm8, [srcreg+0*d1+64]		;; i1
	zfnmaddpd zmm22, zmm10, zmm29, zmm8	;; ibase = i1 - .223/.975*isum				; 23-26		n 27
	zfmaddpd zmm11, zmm7, zmm27, zmm11	;; i27tmp = i27tmp + .782/.975(r2-r7)			; 23-26		n 35

	zfnmaddpd zmm14, zmm6, zmm27, zmm14	;; i45tmp = i45tmp - .782/.975(r3-r6)			; 24-27		n 36
	zfmaddpd zmm13, zmm3, zmm27, zmm13	;; r27tmp = r27tmp + .782/.975(i2-i7)			; 24-27		n 33

	zfnmaddpd zmm3, zmm18, zmm31, zmm16	;; R45 = rbase - .678/.975(r2+r7)			; 25-28		n 29
	zfmaddpd zmm18, zmm18, zmm30, zmm16	;; R27 = rbase + .846/.975(r2+r7)			; 25-28		n 29

	zfnmaddpd zmm16, zmm17, zmm31, zmm16	;; R36 = rbase - .678/.975(r3+r6)			; 26-29		n 30
	zfnmaddpd zmm21, zmm0, zmm27, zmm21	;; r45tmp = r45tmp - .782/.975(i3-i6)			; 26-29		n 33

	zfmaddpd zmm0, zmm9, zmm30, zmm22	;; I27 = ibase + .846/.975(i2+i7)			; 27-30		n 31
	zfnmaddpd zmm9, zmm9, zmm31, zmm22	;; I45 = ibase - .678/.975(i2+i7)			; 27-30		n 31

	zfnmaddpd zmm22, zmm5, zmm31, zmm22	;; I36 = ibase - .678/.975(i3+i6)			; 28-31		n 32
	zfmaddpd zmm20, zmm12, zmm27, zmm20	;; r36tmp = r36tmp + .782/.975(i4-i5)			; 28-31		n 34

	zfmaddpd zmm3, zmm17, zmm30, zmm3	;; R45 = R45 + .846/.975(r3+r6)				; 29-32		n 33
	zfnmaddpd zmm18, zmm19, zmm31, zmm18	;; R27 = R27 - .678/.975(r4+r5)				; 29-32		n 33

	zfmaddpd zmm16, zmm19, zmm30, zmm16	;; R36 = R36 + .846/.975(r4+r5)				; 30-33		n 34
	zfmaddpd zmm15, zmm26, zmm1, zmm15	;; R1 = r1 + 1/.975*rsum				; 30-33

	zfnmaddpd zmm0, zmm2, zmm31, zmm0	;; I27 = I27 - .678/.975(i4+i5)				; 31-34		n 35
	zfmaddpd zmm9, zmm5, zmm30, zmm9	;; I45 = I45 + .846/.975(i3+i6)				; 31-34		n 36

	zfmaddpd zmm22, zmm2, zmm30, zmm22	;; I36 = I36 + .846/.975(i4+i5)				; 32-35		n 36
	zfmaddpd zmm8, zmm26, zmm10, zmm8	;; I1 = i1 + 1/.975*isum				; 32-35

	vsubpd	zmm1, zmm3, zmm21		;; R5 = R45 - r45tmp					; 33-36
	vaddpd	zmm2, zmm18, zmm13		;; R2 = R27 + r27tmp					; 33-36

	vaddpd	zmm5, zmm16, zmm20		;; R6 = R36 + r36tmp					; 34-37
	vaddpd	zmm3, zmm3, zmm21		;; R4 = R45 + r45tmp					; 34-37
	zstore	[srcreg+0*d1], zmm15		;; Save R1						; 34

	vaddpd	zmm6, zmm0, zmm11		;; I7 = I27 + i27tmp					; 35-38
	vsubpd	zmm7, zmm18, zmm13		;; R7 = R27 - r27tmp					; 35-38

	vsubpd	zmm10, zmm22, zmm4		;; I6 = I36 - i36tmp					; 36-39
	vaddpd	zmm12, zmm9, zmm14		;; I5 = I45 + i45tmp					; 36-39
	zstore	[srcreg+0*d1+64], zmm8		;; Save I1						; 36

	vsubpd	zmm0, zmm0, zmm11		;; I2 = I27 - i27tmp					; 37-40
	vsubpd	zmm8, zmm9, zmm14		;; I4 = I45 - i45tmp					; 37-40
	zstore	[srcreg+1*d1], zmm2		;; Save R2						; 37

	vaddpd	zmm2, zmm22, zmm4		;; I3 = I36 + i36tmp					; 38-41
	vsubpd	zmm4, zmm16, zmm20		;; R3 = R36 - r36tmp					; 38-41
	zstore	[srcreg+4*d1], zmm1		;; Save R5						; 37+1

	zstore	[srcreg+5*d1], zmm5		;; Save R6						; 38+1
	zstore	[srcreg+3*d1], zmm3		;; Save R4						; 38+2
	zstore	[srcreg+6*d1], zmm7		;; Save R7						; 39+2
	zstore	[srcreg+6*d1+64], zmm6		;; Save I7						; 39+3
	zstore	[srcreg+5*d1+64], zmm10		;; Save I6						; 40+3
	zstore	[srcreg+4*d1+64], zmm12		;; Save I5						; 40+4
	zstore	[srcreg+1*d1+64], zmm0		;; Save I2						; 41+4
	zstore	[srcreg+3*d1+64], zmm8		;; Save I4						; 41+5
	zstore	[srcreg+2*d1], zmm4		;; Save R3						; 42+5
	zstore	[srcreg+2*d1+64], zmm2		;; Save I3						; 42+6
	bump	srcreg, srcinc
	ENDM


;;
;; ************************************* fourteen-reals-fft variants ******************************************
;;

; Uses two sin/cos pointers
zr7_2sc_fourteen_reals_fft_preload MACRO
	zr7_14r_fft_cmn_preload
	ENDM
zr7_2sc_fourteen_reals_fft MACRO srcreg,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	zr7_14r_fft_cmn srcreg,0,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	ENDM

; Offsets source by rbx
zr7f_2sc_fourteen_reals_fft_preload MACRO
	zr7_14r_fft_cmn_preload
	ENDM
zr7f_2sc_fourteen_reals_fft MACRO srcreg,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	zr7_14r_fft_cmn srcreg,rbx,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	ENDM

; Combined sin/cos data
zr7_csc_fourteen_reals_fft_preload MACRO
	zr7_14r_fft_cmn_preload
	ENDM
zr7_csc_fourteen_reals_fft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_14r_fft_cmn srcreg,0,srcinc,d1,screg+3*128,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; To calculate a 14-reals FFT, we calculate 14 complex values in a brute force way (using a shorthand notation):
;; r1 + r2 + ... + r14	*  w^00000000000000
;; r1 + r2 + ... + r14	*  w^0123456789ABCD
;; r1 + r2 + ... + r14	*  w^02468ACE....
;;    ...
;; r1 + r2 + ... + r14	*  w^0DCBA987654321
;; Note that Hermetian symmetry means we won't need to calculate the last 6 complex values.
;;
;; The sin/cos values (w = 14th root of unity) are:
;; w^1 = .901 + .434i
;; w^2 = .623 + .782i
;; w^3 = .223 + .975i
;; w^4 = -.223 + .975i
;; w^5 = -.623 + .782i
;; w^6 = -.901 + .434i
;; w^7 = -1
;;
;; Applying the sin/cos values above (and noting that combining r2 and r9, r3 and r10, etc. will simplify calculations):
;; reals:
;; R1 = (r1+r8)     +((r2+r9)+(r7+r14))     +((r3+r10)+(r6+r13))     +((r4+r11)+(r5+r12))
;; R2=  (r1-r8) +.901((r2-r9)-(r7-r14)) +.623((r3-r10)-(r6-r13)) +.223((r4-r11)-(r5-r12))
;; R3=  (r1+r8) +.623((r2+r9)+(r7+r14)) -.223((r3+r10)+(r6+r13)) -.901((r4+r11)+(r5+r12))
;; R4=  (r1-r8) +.223((r2-r9)-(r7-r14)) -.901((r3-r10)-(r6-r13)) -.623((r4-r11)-(r5-r12))
;; R5=  (r1+r8) -.223((r2+r9)+(r7+r14)) -.901((r3+r10)+(r6+r13)) +.623((r4+r11)+(r5+r12))
;; R6=  (r1-r8) -.623((r2-r9)-(r7-r14)) -.223((r3-r10)-(r6-r13)) +.901((r4-r11)-(r5-r12))
;; R7=  (r1+r8) -.901((r2+r9)+(r7+r14)) +.623((r3+r10)+(r6+r13)) -.223((r4+r11)+(r5+r12))
;; R8 = (r1-r8)     -((r2-r9)-(r7-r14))     +((r3-r10)-(r6-r13))     -((r4-r11)-(r5-r12))
;; I2=          +.434((r2-r9)+(r7-r14)) +.782((r3-r10)+(r6-r13)) +.975((r4-r11)+(r5-r12))
;; I3=          +.782((r2+r9)-(r7+r14)) +.975((r3+r10)-(r6+r13)) +.434((r4+r11)-(r5+r12))
;; I4=          +.975((r2-r9)+(r7-r14)) +.434((r3-r10)+(r6-r13)) -.782((r4-r11)+(r5-r12))
;; I5=          +.975((r2+r9)-(r7+r14)) -.434((r3+r10)-(r6+r13)) -.782((r4+r11)-(r5+r12))
;; I6=          +.782((r2-r9)+(r7-r14)) -.975((r3-r10)+(r6-r13)) +.434((r4-r11)+(r5-r12))
;; I7=          +.434((r2+r9)-(r7+r14)) -.782((r3+r10)-(r6+r13)) +.975((r4+r11)-(r5+r12))

;; Peculiar version that internally computes R2/I2 through R7/I7 divided by .975.  This saves 2 clocks.
;; We compensate by multiplying the R2/I2 through R7/I7 sine values by .975.
;; Obviously, the corresponding unfft macro must also deal with sine values that have been multiplied by .975.
;; NOTE:  Because this macro uses the same sine values as the seven-complex, this trick requires changing the
;; seven-complex FFT macros to also work with sine values that have been multiplied by .975.

;; The cos rows share a base.  With sum = (r2++)+(r3++)+(r4++), base = (r1+r8) - .223*sum zeroes one term in each even row:
;; R3 = base + .846(r2++) - .678(r4++),  R5 = base - .678(r3++) + .846(r4++),  R7 = base - .678(r2++) + .846(r3++)
;; where .846 = .623+.223 and .678 = .901-.223.
;; The odd rows also share a base.  With dif = (r2--)-(r3--)+(r4--), base = (r1-r8) + .223*dif:
;; R2 = base + .678(r2--) + .846(r3--),  R4 = base - .678(r3--) - .846(r4--),  R6 = base - .846(r2--) + .678(r4--),  R8 = (r1-r8) - dif.

zr7_14r_fft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975 = (.901-.223)/.975
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975 = (.623+.223)/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm28, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm27, ZMM_P782_P975	;; .782/.975
	vbroadcastsd zmm26, ZMM_P1_P975		;; 1/.975
	ENDM
zr7_14r_fft_cmn MACRO srcreg,srcoff,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	vmovapd	zmm0, [srcreg+srcoff+1*d1]	;; r2+r9
	vmovapd	zmm1, [srcreg+srcoff+6*d1]	;; r7+r14
	vmovapd	zmm2, [srcreg+srcoff+2*d1]	;; r3+r10
	vmovapd	zmm3, [srcreg+srcoff+5*d1]	;; r6+r13
	vaddpd	zmm4, zmm0, zmm1		;; r2++ = (r2+r9)+(r7+r14)				; 1-4		n 5
	vaddpd	zmm5, zmm2, zmm3		;; r3++ = (r3+r10)+(r6+r13)				; 1-4		n 5

	vmovapd	zmm6, [srcreg+srcoff+1*d1+64]	;; r2-r9
	vmovapd	zmm7, [srcreg+srcoff+6*d1+64]	;; r7-r14
	vmovapd	zmm8, [srcreg+srcoff+2*d1+64]	;; r3-r10
	vmovapd	zmm9, [srcreg+srcoff+5*d1+64]	;; r6-r13
	vsubpd	zmm10, zmm6, zmm7		;; r2-- = (r2-r9)-(r7-r14)				; 2-5		n 6
	vsubpd	zmm11, zmm8, zmm9		;; r3-- = (r3-r10)-(r6-r13)				; 2-5		n 6

	vmovapd	zmm12, [srcreg+srcoff+3*d1+64]	;; r4-r11
	vmovapd	zmm13, [srcreg+srcoff+4*d1+64]	;; r5-r12
	vmovapd	zmm14, [srcreg+srcoff+0*d1]	;; r1+r8
	vsubpd	zmm15, zmm12, zmm13		;; r4-- = (r4-r11)-(r5-r12)				; 3-6		n 10
	vmulpd	zmm16, zmm14, zmm26		;; r1+r8 / .975						; 3-6		n 13

	vmovapd	zmm17, [srcreg+srcoff+3*d1]	;; r4+r11
	vmovapd	zmm18, [srcreg+srcoff+4*d1]	;; r5+r12
	vaddpd	zmm19, zmm17, zmm18		;; r4++ = (r4+r11)+(r5+r12)				; 4-7		n 9
	vsubpd	zmm17, zmm17, zmm18		;; r4+- = (r4+r11)-(r5+r12)				; 4-7		n 10

	vmovapd	zmm18, [srcreg+srcoff+0*d1+64]	;; r1-r8
	vaddpd	zmm20, zmm4, zmm5		;; sum = (r2++) + (r3++)				; 5-8		n 9
	vmulpd	zmm21, zmm18, zmm26		;; r1-r8 / .975						; 5-8		n 14

	vsubpd	zmm22, zmm10, zmm11		;; dif = (r2--) - (r3--)				; 6-9		n 10
	vsubpd	zmm2, zmm2, zmm3		;; r3+- = (r3+r10)-(r6+r13)				; 6-9		n 10

	vaddpd	zmm3, zmm6, zmm7		;; r2-+ = (r2-r9)+(r7-r14)				; 7-10		n 12
	vsubpd	zmm0, zmm0, zmm1		;; r2+- = (r2+r9)-(r7+r14)				; 7-10		n 11

	L1prefetchw srcreg+0*d1+L1pd, L1pt
	vaddpd	zmm1, zmm8, zmm9		;; r3-+ = (r3-r10)+(r6-r13)				; 8-11		n 12
	vaddpd	zmm6, zmm12, zmm13		;; r4-+ = (r4-r11)+(r5-r12)				; 8-11		n 12

	L1prefetchw srcreg+0*d1+64+L1pd, L1pt
	vaddpd	zmm7, zmm20, zmm19		;; sum = sum + (r4++)					; 9-12		n 13

	L1prefetchw srcreg+1*d1+L1pd, L1pt
	vaddpd	zmm8, zmm22, zmm15		;; dif = dif + (r4--)					; 10-13		n 14
	zfnmaddpd zmm9, zmm2, zmm27, zmm17	;; I7 = (r4+-) - .782/.975(r3+-)			; 10-13		n 14

	L1prefetchw srcreg+1*d1+64+L1pd, L1pt
	zfmaddpd zmm12, zmm0, zmm27, zmm2	;; I3 = .782/.975(r2+-) + (r3+-)			; 11-14		n 15
	zfnmaddpd zmm2, zmm2, zmm28, zmm0	;; I5 = (r2+-) - .434/.975(r3+-)			; 11-14		n 15

	L1prefetchw srcreg+2*d1+L1pd, L1pt
	zfmaddpd zmm13, zmm1, zmm27, zmm6	;; I2 = (r4-+) + .782/.975(r3-+)			; 12-15		n 16
	zfmaddpd zmm20, zmm1, zmm28, zmm3	;; I4 = (r2-+) + .434/.975(r3-+)			; 12-15		n 16

	L1prefetchw srcreg+2*d1+64+L1pd, L1pt
	zfnmaddpd zmm16, zmm7, zmm29, zmm16	;; ebase = (r1+r8)/.975 - .223/.975*sum			; 13-16		n 17
	zfmsubpd zmm1, zmm3, zmm27, zmm1	;; I6 = .782/.975(r2-+) - (r3-+)			; 13-16		n 20

	L1prefetchw srcreg+3*d1+L1pd, L1pt
	zfmaddpd zmm21, zmm8, zmm29, zmm21	;; obase = (r1-r8)/.975 + .223/.975*dif			; 14-17		n 18
	zfmaddpd zmm9, zmm0, zmm28, zmm9	;; I7 = I7 + .434/.975(r2+-)				; 14-17		n 25

	L1prefetchw srcreg+3*d1+64+L1pd, L1pt
	zfmaddpd zmm12, zmm17, zmm28, zmm12	;; I3 = I3 + .434/.975(r4+-)				; 15-18		n 25
	zfnmaddpd zmm2, zmm17, zmm27, zmm2	;; I5 = I5 - .782/.975(r4+-)				; 15-18		n 28

	L1prefetchw srcreg+4*d1+L1pd, L1pt
	zfmaddpd zmm13, zmm3, zmm28, zmm13	;; I2 = I2 + .434/.975(r2-+)				; 16-19		n 26
	zfnmaddpd zmm20, zmm6, zmm27, zmm20	;; I4 = I4 - .782/.975(r4-+)				; 16-19		n 27

	L1prefetchw srcreg+4*d1+64+L1pd, L1pt
	zfmaddpd zmm0, zmm4, zmm30, zmm16	;; R3 = ebase + .846/.975(r2++)				; 17-20		n 21
	zfnmaddpd zmm4, zmm4, zmm31, zmm16	;; R7 = ebase - .678/.975(r2++)				; 17-20		n 21

	L1prefetchw srcreg+5*d1+L1pd, L1pt
	zfmaddpd zmm3, zmm10, zmm31, zmm21	;; R2 = obase + .678/.975(r2--)				; 18-21		n 22
	zfnmaddpd zmm10, zmm10, zmm30, zmm21	;; R6 = obase - .846/.975(r2--)				; 18-21		n 22

	L1prefetchw srcreg+5*d1+64+L1pd, L1pt
	zfnmaddpd zmm21, zmm11, zmm31, zmm21	;; R4 = obase - .678/.975(r3--)				; 19-22		n 23
	zfnmaddpd zmm16, zmm5, zmm31, zmm16	;; R5 = ebase - .678/.975(r3++)				; 19-22		n 23

	L1prefetchw srcreg+6*d1+L1pd, L1pt
	zfmaddpd zmm1, zmm6, zmm28, zmm1	;; I6 = I6 + .434/.975(r4-+)				; 20-23		n 29
	vsubpd	zmm6, zmm18, zmm8		;; R8 = (r1-r8) - dif					; 20-23

	L1prefetchw srcreg+6*d1+64+L1pd, L1pt
	zfnmaddpd zmm0, zmm19, zmm31, zmm0	;; R3 = R3 - .678/.975(r4++)				; 21-24		n 25
	zfmaddpd zmm4, zmm5, zmm30, zmm4	;; R7 = R7 + .846/.975(r3++)				; 21-24		n 25

	zfmaddpd zmm10, zmm15, zmm31, zmm10	;; R6 = R6 + .678/.975(r4--)				; 22-25		n 29
	zfmaddpd zmm3, zmm11, zmm30, zmm3	;; R2 = R2 + .846/.975(r3--)				; 22-25		n 26

	zfmaddpd zmm16, zmm19, zmm30, zmm16	;; R5 = R5 + .846/.975(r4++)				; 23-26		n 28
	zfnmaddpd zmm21, zmm15, zmm30, zmm21	;; R4 = R4 - .846/.975(r4--)				; 23-26		n 27

	vaddpd	zmm5, zmm14, zmm7		;; R1 = (r1+r8) + sum					; 24-27
	zstore	[srcreg+0*d1+64], zmm6		;; Save R8						; 24

	vmovapd	zmm6, [screg2+2*128+64]		;; cosine/sine for R7/I7 (w^6 = complex w^3)
	vmovapd	zmm7, [screg2+0*128+64]		;; cosine/sine for R3/I3 (w^2 = complex w^1)
	zfmaddpd zmm8, zmm9, zmm6, zmm4		;; B7 = I7 * cosine/sine + R7				; 25-28		n 34
	zfmsubpd zmm11, zmm0, zmm7, zmm12	;; A3 = R3 * cosine/sine - I3				; 25-28		n 29

	vmovapd	zmm14, [screg1+0*128+64]	;; cosine/sine for R2/I2 (w^1)
	zfmsubpd zmm15, zmm3, zmm14, zmm13	;; A2 = R2 * cosine/sine - I2				; 26-29		n 30
	zfmaddpd zmm3, zmm13, zmm14, zmm3	;; B2 = I2 * cosine/sine + R2				; 26-29		n 30

	vmovapd	zmm13, [screg1+1*128+64]	;; cosine/sine for R4/I4 (w^3)
	zfmaddpd zmm14, zmm20, zmm13, zmm21	;; B4 = I4 * cosine/sine + R4				; 27-30		n 32
	zfmsubpd zmm20, zmm21, zmm13, zmm20	;; A4 = R4 * cosine/sine - I4				; 27-30		n 34

	vmovapd	zmm13, [screg2+1*128+64]	;; cosine/sine for R5/I5 (w^4 = complex w^2)
	zfmaddpd zmm17, zmm2, zmm13, zmm16	;; B5 = I5 * cosine/sine + R5				; 28-31		n 36
	zfmsubpd zmm2, zmm16, zmm13, zmm2	;; A5 = R5 * cosine/sine - I5				; 28-31		n 33
	zstore	[srcreg+0*d1], zmm5		;; Save R1						; 28

	vmovapd	zmm5, [screg2+0*128]		;; sine*.975 for R3/I3 (w^2 = complex w^1)
	vmovapd	zmm13, [screg1+2*128+64]	;; cosine/sine for R6/I6 (w^5)
	vmulpd	zmm11, zmm11, zmm5		;; A3 = A3 * sine*.975 (final R3)			; 29-32
	zfmsubpd zmm16, zmm10, zmm13, zmm1	;; A6 = R6 * cosine/sine - I6				; 29-32		n 33

	vmovapd	zmm18, [screg1+0*128]		;; sine*.975 for R2/I2 (w^1)
	vmulpd	zmm3, zmm3, zmm18		;; B2 = B2 * sine*.975 (final I2)			; 30-33
	vmulpd	zmm15, zmm15, zmm18		;; A2 = A2 * sine*.975 (final R2)			; 30-33

	zfmaddpd zmm0, zmm12, zmm7, zmm0	;; B3 = I3 * cosine/sine + R3				; 31-34		n 35
	zfmaddpd zmm10, zmm1, zmm13, zmm10	;; B6 = I6 * cosine/sine + R6				; 31-34		n 35

	vmovapd	zmm1, [screg1+1*128]		;; sine*.975 for R4/I4 (w^3)
	zfmsubpd zmm9, zmm4, zmm6, zmm9		;; A7 = R7 * cosine/sine - I7				; 32-35		n 36
	vmulpd	zmm4, zmm14, zmm1		;; B4 = B4 * sine*.975 (final I4)			; 32-35

	vmovapd	zmm6, [screg1+2*128]		;; sine*.975 for R6/I6 (w^5)
	bump	screg1, scinc1
	vmovapd	zmm7, [screg2+1*128]		;; sine*.975 for R5/I5 (w^4 = complex w^2)
	vmulpd	zmm12, zmm16, zmm6		;; A6 = A6 * sine*.975 (final R6)			; 33-36
	vmulpd	zmm2, zmm2, zmm7		;; A5 = A5 * sine*.975 (final R5)			; 33-36
	zstore	[srcreg+2*d1], zmm11		;; Save R3						; 33

	vmovapd	zmm11, [screg2+2*128]		;; sine*.975 for R7/I7 (w^6 = complex w^3)
	bump	screg2, scinc2
	vmulpd	zmm1, zmm20, zmm1		;; A4 = A4 * sine*.975 (final R4)			; 34-37
	vmulpd	zmm8, zmm8, zmm11		;; B7 = B7 * sine*.975 (final I7)			; 34-37
	zstore	[srcreg+1*d1], zmm15		;; Save R2						; 34

	vmulpd	zmm0, zmm0, zmm5		;; B3 = B3 * sine*.975 (final I3)			; 35-38
	vmulpd	zmm5, zmm10, zmm6		;; B6 = B6 * sine*.975 (final I6)			; 35-38
	zstore	[srcreg+1*d1+64], zmm3		;; Save I2						; 34+1

	vmulpd	zmm3, zmm9, zmm11		;; A7 = A7 * sine*.975 (final R7)			; 36-39
	vmulpd	zmm6, zmm17, zmm7		;; B5 = B5 * sine*.975 (final I5)			; 36-39
	zstore	[srcreg+3*d1+64], zmm4		;; Save I4						; 36

	zstore	[srcreg+4*d1], zmm2		;; Save R5						; 37
	zstore	[srcreg+5*d1], zmm12		;; Save R6						; 37+1
	zstore	[srcreg+6*d1+64], zmm8		;; Save I7						; 38+1
	zstore	[srcreg+3*d1], zmm1		;; Save R4						; 38+2
	zstore	[srcreg+2*d1+64], zmm0		;; Save I3						; 39+2
	zstore	[srcreg+5*d1+64], zmm5		;; Save I6						; 39+3
	zstore	[srcreg+4*d1+64], zmm6		;; Save I5						; 40+3
	zstore	[srcreg+6*d1], zmm3		;; Save R7						; 40+4
	bump	srcreg, srcinc
	ENDM

;;
;; ************************************* fourteen-reals-unfft variants ******************************************
;;

;; Uses two sin/cos ptrs
zr7_2sc_fourteen_reals_unfft_preload MACRO
	zr7_14r_unfft_cmn_preload
	ENDM
zr7_2sc_fourteen_reals_unfft MACRO srcreg,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	zr7_14r_unfft_cmn srcreg,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	ENDM

;; Combined sin/cos data
zr7_csc_fourteen_reals_unfft_preload MACRO
	zr7_14r_unfft_cmn_preload
	ENDM
zr7_csc_fourteen_reals_unfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt,L1pd
	zr7_14r_unfft_cmn srcreg,srcinc,d1,screg+3*128,0,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

;; To calculate a 14-reals inverse fft (in a shorthand notation):
;; c1 + c2 + c3 + ... + c14	*  w^-00000000000000
;; c1 + c2 + c3 + ... + c14	*  w^-0123456789ABCD
;; c1 + c2 + c3 + ... + c14	*  w^-02468AC024..
;;		  ...
;; c1 + c2 + c3 + ... + c14	*  w^-0CA86420CA..
;; c1 + c2 + c3 + ... + c14	*  w^-0DCBA987654321
;; incoming is:	c1 = r1a + 0
;;		c2 = r2 + i2
;;		c3 = r3 + i3
;;		...
;;		c7 = r7 + i7
;;		c8 = r1b + 0
;;		c9 = r7 - i7	(implied)
;;		...
;;		c13 = r3 - i3	(implied)
;;		c14 = r2 - i2	(implied)
;; The sin/cos values (w = 14th root of unity) are:
;; w^-1 = .901 - .434i
;; w^-2 = .623 - .782i
;; w^-3 = .223 - .975i
;; w^-4 = -.223 - .975i
;; w^-5 = -.623 - .782i
;; w^-6 = -.901 - .434i
;; w^-7 = -1

;; We get (after dropping a multiplication by 2 -- the actual r1a and r1b inputs are already halved
;; and expand the sin/cos multipliers):
;; R1 = r1a + r1b + r2 + r3 + r4 + r5 + r6 + r7
;; R2 = r1a - r1b + .901r2 + .623r3 + .223r4 - .223r5 - .623r6 - .901r7 + .434i2 + .782i3 + .975i4 + .975i5 + .782i6 + .434i7
;; R3 = r1a + r1b + .623r2 - .223r3 - .901r4 - .901r5 - .223r6 + .623r7 + .782i2 + .975i3 + .434i4 - .434i5 - .975i6 - .782i7
;; R4 = r1a - r1b + .223r2 - .901r3 - .623r4 + .623r5 + .901r6 - .223r7 + .975i2 + .434i3 - .782i4 - .782i5 + .434i6 + .975i7
;; R5 = r1a + r1b - .223r2 - .901r3 + .623r4 + .623r5 - .901r6 - .223r7 + .975i2 - .434i3 - .782i4 + .782i5 + .434i6 - .975i7
;; R6 = r1a - r1b - .623r2 - .223r3 + .901r4 - .901r5 + .223r6 + .623r7 + .782i2 - .975i3 + .434i4 + .434i5 - .975i6 + .782i7
;; R7 = r1a + r1b - .901r2 + .623r3 - .223r4 - .223r5 + .623r6 - .901r7 + .434i2 - .782i3 + .975i4 - .975i5 + .782i6 - .434i7
;; R8 = r1a - r1b - r2 + r3 - r4 + r5 - r6 + r7
;; R9 = r1a + r1b - .901r2 + .623r3 - .223r4 - .223r5 + .623r6 - .901r7 - .434i2 + .782i3 - .975i4 + .975i5 - .782i6 + .434i7
;; R10= r1a - r1b - .623r2 - .223r3 + .901r4 - .901r5 + .223r6 + .623r7 - .782i2 + .975i3 - .434i4 - .434i5 + .975i6 - .782i7
;; R11= r1a + r1b - .223r2 - .901r3 + .623r4 + .623r5 - .901r6 - .223r7 - .975i2 + .434i3 + .782i4 - .782i5 - .434i6 + .975i7
;; R12= r1a - r1b + .223r2 - .901r3 - .623r4 + .623r5 + .901r6 - .223r7 - .975i2 - .434i3 + .782i4 + .782i5 - .434i6 - .975i7
;; R13= r1a + r1b + .623r2 - .223r3 - .901r4 - .901r5 - .223r6 + .623r7 - .782i2 - .975i3 - .434i4 + .434i5 + .975i6 + .782i7
;; R14= r1a - r1b + .901r2 + .623r3 + .223r4 - .223r5 - .623r6 - .901r7 - .434i2 - .782i3 - .975i4 - .975i5 - .782i6 - .434i7

;; Regrouping:
;; R1 = r1a + r3 + r5 + r7 + (r1b + r2 + r4 + r6)
;; R8 = r1a + r3 + r5 + r7 - (r1b + r2 + r4 + r6)
;; R2 = r1a - r1b  + .901r2 + .623r3 + .223r4 - .223r5 - .623r6 - .901r7 + (+ .434i2 + .782i3 + .975i4 + .975i5 + .782i6 + .434i7)
;; R14= r1a - r1b  + .901r2 + .623r3 + .223r4 - .223r5 - .623r6 - .901r7 - (+ .434i2 + .782i3 + .975i4 + .975i5 + .782i6 + .434i7)
;; R3 = r1a + r1b  + .623r2 - .223r3 - .901r4 - .901r5 - .223r6 + .623r7 + (+ .782i2 + .975i3 + .434i4 - .434i5 - .975i6 - .782i7)
;; R13= r1a + r1b  + .623r2 - .223r3 - .901r4 - .901r5 - .223r6 + .623r7 - (+ .782i2 + .975i3 + .434i4 - .434i5 - .975i6 - .782i7)
;; R4 = r1a - r1b  + .223r2 - .901r3 - .623r4 + .623r5 + .901r6 - .223r7 + (+ .975i2 + .434i3 - .782i4 - .782i5 + .434i6 + .975i7)
;; R12= r1a - r1b  + .223r2 - .901r3 - .623r4 + .623r5 + .901r6 - .223r7 - (+ .975i2 + .434i3 - .782i4 - .782i5 + .434i6 + .975i7)
;; R5 = r1a + r1b  - .223r2 - .901r3 + .623r4 + .623r5 - .901r6 - .223r7 + (+ .975i2 - .434i3 - .782i4 + .782i5 + .434i6 - .975i7)
;; R11= r1a + r1b  - .223r2 - .901r3 + .623r4 + .623r5 - .901r6 - .223r7 - (+ .975i2 - .434i3 - .782i4 + .782i5 + .434i6 - .975i7)
;; R6 = r1a - r1b  - .623r2 - .223r3 + .901r4 - .901r5 + .223r6 + .623r7 + (+ .782i2 - .975i3 + .434i4 + .434i5 - .975i6 + .782i7)
;; R10= r1a - r1b  - .623r2 - .223r3 + .901r4 - .901r5 + .223r6 + .623r7 - (+ .782i2 - .975i3 + .434i4 + .434i5 - .975i6 + .782i7)
;; R7 = r1a + r1b  - .901r2 + .623r3 - .223r4 - .223r5 + .623r6 - .901r7 + (+ .434i2 - .782i3 + .975i4 - .975i5 + .782i6 - .434i7)
;; R9 = r1a + r1b  - .901r2 + .623r3 - .223r4 - .223r5 + .623r6 - .901r7 - (+ .434i2 - .782i3 + .975i4 - .975i5 + .782i6 - .434i7)

;; Finally:
;; R1 = r1a+r1b  +    (r2+r7) +    (r3+r6) +    (r4+r5)
;; R8 = r1a-r1b  -    (r2-r7) +    (r3-r6) -    (r4-r5)
;; R2 = r1a-r1b  +.901(r2-r7) +.623(r3-r6) +.223(r4-r5) + (+.434(i2+i7) +.782(i3+i6) +.975(i4+i5))
;; R14= r1a-r1b  +.901(r2-r7) +.623(r3-r6) +.223(r4-r5) - (+.434(i2+i7) +.782(i3+i6) +.975(i4+i5))
;; R3 = r1a+r1b  +.623(r2+r7) -.223(r3+r6) -.901(r4+r5) + (+.782(i2-i7) +.975(i3-i6) +.434(i4-i5))
;; R13= r1a+r1b  +.623(r2+r7) -.223(r3+r6) -.901(r4+r5) - (+.782(i2-i7) +.975(i3-i6) +.434(i4-i5))
;; R4 = r1a-r1b  +.223(r2-r7) -.901(r3-r6) -.623(r4-r5) + (+.975(i2+i7) +.434(i3+i6) -.782(i4+i5))
;; R12= r1a-r1b  +.223(r2-r7) -.901(r3-r6) -.623(r4-r5) - (+.975(i2+i7) +.434(i3+i6) -.782(i4+i5))
;; R5 = r1a+r1b  -.223(r2+r7) -.901(r3+r6) +.623(r4+r5) + (+.975(i2-i7) -.434(i3-i6) -.782(i4-i5))
;; R11= r1a+r1b  -.223(r2+r7) -.901(r3+r6) +.623(r4+r5) - (+.975(i2-i7) -.434(i3-i6) -.782(i4-i5))
;; R6 = r1a-r1b  -.623(r2-r7) -.223(r3-r6) +.901(r4-r5) + (+.782(i2+i7) -.975(i3+i6) +.434(i4+i5))
;; R10= r1a-r1b  -.623(r2-r7) -.223(r3-r6) +.901(r4-r5) - (+.782(i2+i7) -.975(i3+i6) +.434(i4+i5))
;; R7 = r1a+r1b  -.901(r2+r7) +.623(r3+r6) -.223(r4+r5) + (+.434(i2-i7) -.782(i3-i6) +.975(i4-i5))
;; R9 = r1a+r1b  -.901(r2+r7) +.623(r3+r6) -.223(r4+r5) - (+.434(i2-i7) -.782(i3-i6) +.975(i4-i5))

;; The cos rows share a base.  With sum = (r2+r7)+(r3+r6)+(r4+r5), base = (r1a+r1b) - .223*sum zeroes one term in each even row:
;; R3Da = base + .846(r2+r7) - .678(r4+r5),  R5Ba = base - .678(r3+r6) + .846(r4+r5),  R79a = base - .678(r2+r7) + .846(r3+r6)
;; where .846 = .623+.223 and .678 = .901-.223.
;; The odd rows also share a base.  With dif = (r2-r7)-(r3-r6)+(r4-r5), base = (r1a-r1b) + .223*dif:
;; R2Ea = base + .678(r2-r7) + .846(r3-r6),  R4Ca = base - .678(r3-r6) - .846(r4-r5),  R6Aa = base - .846(r2-r7) + .678(r4-r5),  R8 = (r1a-r1b) - dif.

zr7_14r_unfft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975 = (.901-.223)/.975
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975 = (.623+.223)/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm28, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm27, ZMM_P782_P975	;; .782/.975
	vbroadcastsd zmm26, ZMM_P1_P975		;; 1/.975
	ENDM
zr7_14r_unfft_cmn MACRO srcreg,srcinc,d1,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	vmovapd	zmm0, [srcreg+2*d1]		;; r3
	vmovapd	zmm1, [screg2+0*128+64]		;; cosine/sine for R3/I3 (w^2 = complex w^1)
	vmovapd	zmm2, [srcreg+2*d1+64]		;; i3
	vmovapd	zmm3, [srcreg+1*d1]		;; r2
	vmovapd	zmm4, [screg1+0*128+64]		;; cosine/sine for R2/I2 (w^1)
	vmovapd	zmm5, [srcreg+1*d1+64]		;; i2
	zfmaddpd zmm6, zmm0, zmm1, zmm2		;; A3 = R3 * cosine/sine + I3				; 1-4		n 5
	zfmaddpd zmm7, zmm3, zmm4, zmm5		;; A2 = R2 * cosine/sine + I2				; 1-4		n 5

	vmovapd	zmm8, [srcreg+3*d1]		;; r4
	vmovapd	zmm9, [screg1+1*128+64]		;; cosine/sine for R4/I4 (w^3)
	vmovapd	zmm10, [srcreg+3*d1+64]		;; i4
	vmovapd	zmm11, [srcreg+6*d1]		;; r7
	vmovapd	zmm12, [screg2+2*128+64]	;; cosine/sine for R7/I7 (w^6 = complex w^3)
	vmovapd	zmm13, [srcreg+6*d1+64]		;; i7
	zfmaddpd zmm14, zmm8, zmm9, zmm10	;; A4 = R4 * cosine/sine + I4				; 2-5		n 6
	zfmaddpd zmm15, zmm11, zmm12, zmm13	;; A7 = R7 * cosine/sine + I7				; 2-5		n 9

	vmovapd	zmm16, [srcreg+5*d1]		;; r6
	vmovapd	zmm17, [screg1+2*128+64]	;; cosine/sine for R6/I6 (w^5)
	vmovapd	zmm18, [srcreg+5*d1+64]		;; i6
	zfmaddpd zmm19, zmm16, zmm17, zmm18	;; A6 = R6 * cosine/sine + I6				; 3-6		n 9
	zfmsubpd zmm0, zmm2, zmm1, zmm0		;; B3 = I3 * cosine/sine - R3				; 3-6		n 8

	vmovapd	zmm1, [srcreg+4*d1]		;; r5
	vmovapd	zmm2, [screg2+1*128+64]		;; cosine/sine for R5/I5 (w^4 = complex w^2)
	vmovapd	zmm20, [srcreg+4*d1+64]		;; i5
	zfmaddpd zmm21, zmm1, zmm2, zmm20	;; A5 = R5 * cosine/sine + I5				; 4-7		n 11
	zfmsubpd zmm1, zmm20, zmm2, zmm1	;; B5 = I5 * cosine/sine - R5				; 4-7		n 15

	vmovapd	zmm2, [screg2+0*128]		;; sine*.975 for R3/I3 (w^2 = complex w^1)
	vmovapd	zmm20, [screg1+0*128]		;; sine*.975 for R2/I2 (w^1)
	vmulpd	zmm6, zmm6, zmm2		;; A3 = A3 * sine*.975 (new R3)				; 5-8		n 9
	vmulpd	zmm7, zmm7, zmm20		;; A2 = A2 * sine*.975 (new R2)				; 5-8		n 9

	vmovapd	zmm22, [screg1+1*128]		;; sine*.975 for R4/I4 (w^3)
	vmulpd	zmm14, zmm14, zmm22		;; A4 = A4 * sine*.975 (new R4)				; 6-9		n 11
	zfmsubpd zmm3, zmm5, zmm4, zmm3		;; B2 = I2 * cosine/sine - R2				; 6-9		n 12

	zfmsubpd zmm16, zmm18, zmm17, zmm16	;; B6 = I6 * cosine/sine - R6				; 7-10		n 13
	zfmsubpd zmm8, zmm10, zmm9, zmm8	;; B4 = I4 * cosine/sine - R4				; 7-10		n 11

	vmulpd	zmm0, zmm0, zmm2		;; B3 = B3 * sine*.975 (new I3)				; 8-11		n 13
	zfmsubpd zmm11, zmm13, zmm12, zmm11	;; B7 = I7 * cosine/sine - R7				; 8-11		n 16

	L1prefetchw srcreg+0*d1+L1pd, L1pt
	vmovapd	zmm2, [screg1+2*128]		;; sine*.975 for R6/I6 (w^5)
	bump	screg1, scinc1
	vmovapd	zmm4, [screg2+2*128]		;; sine*.975 for R7/I7 (w^6 = complex w^3)
	zfnmaddpd zmm5, zmm19, zmm2, zmm6	;; r3 - r6*sine*.975					; 9-12		n 13
	zfnmaddpd zmm9, zmm15, zmm4, zmm7	;; r2 - r7*sine*.975					; 9-12		n 13

	L1prefetchw srcreg+0*d1+64+L1pd, L1pt
	zfmaddpd zmm6, zmm19, zmm2, zmm6	;; r3 + r6*sine*.975					; 10-13		n 14
	zfmaddpd zmm7, zmm15, zmm4, zmm7	;; r2 + r7*sine*.975					; 10-13		n 14

	L1prefetchw srcreg+1*d1+L1pd, L1pt
	vmovapd	zmm10, [screg2+1*128]		;; sine*.975 for R5/I5 (w^4 = complex w^2)
	bump	screg2, scinc2
	vmulpd	zmm8, zmm8, zmm22		;; B4 = B4 * sine*.975 (new I4)				; 11-14		n 15
	zfmaddpd zmm12, zmm21, zmm10, zmm14	;; r4 + r5*sine*.975					; 11-14		n 18

	L1prefetchw srcreg+1*d1+64+L1pd, L1pt
	zfnmaddpd zmm14, zmm21, zmm10, zmm14	;; r4 - r5*sine*.975					; 12-15		n 17
	vmulpd	zmm3, zmm3, zmm20		;; B2 = B2 * sine*.975 (new I2)				; 12-15		n 16

	L1prefetchw srcreg+2*d1+L1pd, L1pt
	vsubpd	zmm13, zmm9, zmm5		;; dif = (r2-r7) - (r3-r6)				; 13-16		n 17
	zfnmaddpd zmm15, zmm16, zmm2, zmm0	;; i3 - i6*sine*.975					; 13-16		n 19

	L1prefetchw srcreg+2*d1+64+L1pd, L1pt
	vaddpd	zmm17, zmm7, zmm6		;; sum = (r2+r7) + (r3+r6)				; 14-17		n 18
	zfmaddpd zmm0, zmm16, zmm2, zmm0	;; i3 + i6*sine*.975					; 14-17		n 19

	L1prefetchw srcreg+3*d1+L1pd, L1pt
	zfnmaddpd zmm2, zmm1, zmm10, zmm8	;; i4 - i5*sine*.975					; 15-18		n 19
	zfmaddpd zmm8, zmm1, zmm10, zmm8	;; i4 + i5*sine*.975					; 15-18		n 19

	L1prefetchw srcreg+3*d1+64+L1pd, L1pt
	zfmaddpd zmm1, zmm11, zmm4, zmm3	;; i2 + i7*sine*.975					; 16-19		n 20
	zfnmaddpd zmm3, zmm11, zmm4, zmm3	;; i2 - i7*sine*.975					; 16-19		n 20

	L1prefetchw srcreg+4*d1+L1pd, L1pt
	vaddpd	zmm4, zmm13, zmm14		;; dif = dif + (r4-r5)					; 17-20		n 21

	L1prefetchw srcreg+4*d1+64+L1pd, L1pt
	vaddpd	zmm10, zmm17, zmm12		;; sum = sum + (r4+r5)					; 18-21		n 22

	L1prefetchw srcreg+5*d1+L1pd, L1pt
	zfmaddpd zmm11, zmm0, zmm27, zmm8	;; R2Eb = +(i4+i5) +.782/.975(i3+i6)			; 19-22		n 23
	zfnmaddpd zmm13, zmm15, zmm27, zmm2	;; R79b = +(i4-i5) -.782/.975(i3-i6)			; 19-22		n 24

	L1prefetchw srcreg+5*d1+64+L1pd, L1pt
	zfmsubpd zmm16, zmm1, zmm27, zmm0	;; R6Ab = -(i3+i6) +.782/.975(i2+i7)			; 20-23		n 32
	zfnmaddpd zmm17, zmm2, zmm27, zmm3	;; R5Bb = +(i2-i7) -.782/.975(i4-i5)			; 20-23		n 24

	L1prefetchw srcreg+6*d1+L1pd, L1pt
	vmovapd	zmm18, [srcreg+0*d1+64]		;; r1a-r1b
	zfmaddpd zmm19, zmm4, zmm29, zmm18	;; obase = r1a-r1b + .223/.975*dif			; 21-24		n 25
	zfmaddpd zmm20, zmm3, zmm27, zmm15	;; R3Db = +(i3-i6) +.782/.975(i2-i7)			; 21-24		n 28

	L1prefetchw srcreg+6*d1+64+L1pd, L1pt
	vmovapd	zmm21, [srcreg+0*d1]		;; r1a+r1b
	zfnmaddpd zmm22, zmm10, zmm29, zmm21	;; ebase = r1a+r1b - .223/.975*sum			; 22-25		n 26
	zfnmaddpd zmm23, zmm8, zmm27, zmm1	;; R4Cb = +(i2+i7) -.782/.975(i4+i5)			; 22-25		n 28

	zfmaddpd zmm11, zmm1, zmm28, zmm11	;; R2Eb = R2Eb + .434/.975(i2+i7)			; 23-26		n 33
	zfnmaddpd zmm18, zmm26, zmm4, zmm18	;; R8 = r1a-r1b - 1/.975*dif				; 23-26

	zfnmaddpd zmm17, zmm15, zmm28, zmm17	;; R5Bb = R5Bb - .434/.975(i3-i6)			; 24-27		n 35
	zfmaddpd zmm13, zmm3, zmm28, zmm13	;; R79b = R79b + .434/.975(i2-i7)			; 24-27		n 34

	zfnmaddpd zmm1, zmm9, zmm30, zmm19	;; R6Aa = obase - .846/.975(r2-r7)			; 25-28		n 29
	zfmaddpd zmm9, zmm9, zmm31, zmm19	;; R2Ea = obase + .678/.975(r2-r7)			; 25-28		n 29

	zfnmaddpd zmm3, zmm7, zmm31, zmm22	;; R79a = ebase - .678/.975(r2+r7)			; 26-29		n 30
	zfmaddpd zmm7, zmm7, zmm30, zmm22	;; R3Da = ebase + .846/.975(r2+r7)			; 26-29		n 30

	zfnmaddpd zmm22, zmm6, zmm31, zmm22	;; R5Ba = ebase - .678/.975(r3+r6)			; 27-30		n 31
	zfnmaddpd zmm19, zmm5, zmm31, zmm19	;; R4Ca = obase - .678/.975(r3-r6)			; 27-30		n 32
	zstore	[srcreg+0*d1+64], zmm18		;; Save R8						; 27

	zfmaddpd zmm23, zmm0, zmm28, zmm23	;; R4Cb = R4Cb + .434/.975(i3+i6)			; 28-31		n 36
	zfmaddpd zmm20, zmm2, zmm28, zmm20	;; R3Db = R3Db + .434/.975(i4-i5)			; 28-31		n 34

	zfmaddpd zmm9, zmm5, zmm30, zmm9	;; R2Ea = R2Ea + .846/.975(r3-r6)			; 29-32		n 33
	zfmaddpd zmm1, zmm14, zmm31, zmm1	;; R6Aa = R6Aa + .678/.975(r4-r5)			; 29-32		n 36

	zfnmaddpd zmm7, zmm12, zmm31, zmm7	;; R3Da = R3Da - .678/.975(r4+r5)			; 30-33		n 34
	zfmaddpd zmm3, zmm6, zmm30, zmm3	;; R79a = R79a + .846/.975(r3+r6)			; 30-33		n 34

	zfmaddpd zmm22, zmm12, zmm30, zmm22	;; R5Ba = R5Ba + .846/.975(r4+r5)			; 31-34		n 35
	zfmaddpd zmm21, zmm26, zmm10, zmm21	;; R1 = r1a+r1b + 1/.975*sum				; 31-34

	zfnmaddpd zmm19, zmm14, zmm30, zmm19	;; R4Ca = R4Ca - .846/.975(r4-r5)			; 32-35		n 36
	zfmaddpd zmm16, zmm8, zmm28, zmm16	;; R6Ab = R6Ab + .434/.975(i4+i5)			; 32-35		n 36

	vaddpd	zmm0, zmm9, zmm11		;; R2 = R2Ea + R2Eb					; 33-36
	vsubpd	zmm2, zmm9, zmm11		;; R14 = R2Ea - R2Eb					; 33-36

	vsubpd	zmm4, zmm3, zmm13		;; R9 = R79a - R79b					; 34-37
	vaddpd	zmm5, zmm7, zmm20		;; R3 = R3Da + R3Db					; 34-37

	vaddpd	zmm3, zmm3, zmm13		;; R7 = R79a + R79b					; 35-38
	vaddpd	zmm6, zmm22, zmm17		;; R5 = R5Ba + R5Bb					; 35-38
	zstore	[srcreg+0*d1], zmm21		;; Save R1						; 35

	vsubpd	zmm8, zmm19, zmm23		;; R12 = R4Ca - R4Cb					; 36-39
	vaddpd	zmm9, zmm1, zmm16		;; R6 = R6Aa + R6Ab					; 36-39

	vsubpd	zmm1, zmm1, zmm16		;; R10 = R6Aa - R6Ab					; 37-40
	vaddpd	zmm10, zmm19, zmm23		;; R4 = R4Ca + R4Cb					; 37-40
	zstore	[srcreg+1*d1], zmm0		;; Save R2						; 37

	vsubpd	zmm0, zmm7, zmm20		;; R13 = R3Da - R3Db					; 38-41
	vsubpd	zmm7, zmm22, zmm17		;; R11 = R5Ba - R5Bb					; 38-41
	zstore	[srcreg+6*d1+64], zmm2		;; Save R14						; 37+1

	zstore	[srcreg+2*d1], zmm5		;; Save R3						; 38+1
	zstore	[srcreg+1*d1+64], zmm4		;; Save R9						; 38+2
	zstore	[srcreg+4*d1], zmm6		;; Save R5						; 39+2
	zstore	[srcreg+6*d1], zmm3		;; Save R7						; 39+3
	zstore	[srcreg+4*d1+64], zmm8		;; Save R12						; 40+3
	zstore	[srcreg+5*d1], zmm9		;; Save R6						; 40+4
	zstore	[srcreg+3*d1], zmm10		;; Save R4						; 41+4
	zstore	[srcreg+2*d1+64], zmm1		;; Save R10						; 41+5
	zstore	[srcreg+5*d1+64], zmm0		;; Save R13						; 42+5
	zstore	[srcreg+3*d1+64], zmm7		;; Save R11						; 42+6
	bump	srcreg, srcinc
	ENDM

;;
;; ************************************* fourteen-reals-seven-complex-fft variants ******************************************
;;

;; Macro to do one fourteen_reals_fft and seven seven_complex_djbfft.  The fourteen-reals operation is done in the lower double of the ZMM register.
;; The seven-complex is done in the high doubles of the ZMM register.   This is REALLY funky, as we do both at the same time within the full zmm register
;; whenever possible.  The fourteen-reals outputs:
;; R1a= (r1+r8)     +((r2+r9)+(r7+r14))     +((r3+r10)+(r6+r13))     +((r4+r11)+(r5+r12))
;; R2=  (r1-r8) +.901((r2-r9)-(r7-r14)) +.623((r3-r10)-(r6-r13)) +.223((r4-r11)-(r5-r12))
;; R3=  (r1+r8) +.623((r2+r9)+(r7+r14)) -.223((r3+r10)+(r6+r13)) -.901((r4+r11)+(r5+r12))
;; R4=  (r1-r8) +.223((r2-r9)-(r7-r14)) -.901((r3-r10)-(r6-r13)) -.623((r4-r11)-(r5-r12))
;; R5=  (r1+r8) -.223((r2+r9)+(r7+r14)) -.901((r3+r10)+(r6+r13)) +.623((r4+r11)+(r5+r12))
;; R6=  (r1-r8) -.623((r2-r9)-(r7-r14)) -.223((r3-r10)-(r6-r13)) +.901((r4-r11)-(r5-r12))
;; R7=  (r1+r8) -.901((r2+r9)+(r7+r14)) +.623((r3+r10)+(r6+r13)) -.223((r4+r11)+(r5+r12))
;; R1b= (r1-r8)     -((r2-r9)-(r7-r14))     +((r3-r10)-(r6-r13))     -((r4-r11)-(r5-r12))
;; I2=          +.434((r2-r9)+(r7-r14)) +.782((r3-r10)+(r6-r13)) +.975((r4-r11)+(r5-r12))
;; I3=          +.782((r2+r9)-(r7+r14)) +.975((r3+r10)-(r6+r13)) +.434((r4+r11)-(r5+r12))
;; I4=          +.975((r2-r9)+(r7-r14)) +.434((r3-r10)+(r6-r13)) -.782((r4-r11)+(r5-r12))
;; I5=          +.975((r2+r9)-(r7+r14)) -.434((r3+r10)-(r6+r13)) -.782((r4+r11)-(r5+r12))
;; I6=          +.782((r2-r9)+(r7-r14)) -.975((r3-r10)+(r6-r13)) +.434((r4-r11)+(r5-r12))
;; I7=          +.434((r2+r9)-(r7+r14)) -.782((r3+r10)-(r6+r13)) +.975((r4+r11)-(r5+r12))

;; The cos rows share a base.  In the seven-complex lanes base = r1 - .223*sum, as in the seven-complex macro above.  The fourteen-reals
;; lane computes its rows in a different order (R7, R3, R5 in the R27, R36, R45 slots), so there base = r1+ + .623*sum zeroes the same
;; term in each slot.  The per-lane constants are T = -.223 (7 times) .623, P = .846 (7 times) -1.524, Q = -.678 (7 times) -.846, all /.975:
;; R27 = base + P*r2+ + Q*r4+,  R36 = base + Q*r3+ + P*r4+,  R45 = base + Q*r2+ + P*r3+.  The odd fourteen-reals rows R2, R6, R4 come out
;; of the I27, I36, I45 slots the same way.

zr7_fourteen_reals_seven_complex_djbfft_preload MACRO
	mov	r9d, 11111110b			;; We're pretty sure r9 is safe to use
	kmovw	k7, r9d				;; Set k7 to 11111110b
	knotw	k6, k7				;; Set k6 to 00000001b
	vzero	zmm0
	vbroadcastsd zmm28, ZMM_ONE
	vsubpd	zmm28 {k6}, zmm0, zmm28		;; 1 (7 times)			-1
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm27, ZMM_P623_P975	;; .623/.975
	vaddpd	zmm1, zmm30, zmm31		;; 1.524/.975 = (.623+.901)/.975
	vsubpd	zmm29, zmm0, zmm29		;; -.223/.975
	vblendmpd zmm29 {k6}, zmm29, zmm27	;; -.223/.975 (7 times)		.623/.975
	vsubpd	zmm31, zmm0, zmm31		;; -.678/.975
	vsubpd	zmm31 {k6}, zmm0, zmm30		;; -.678/.975 (7 times)		-.846/.975
	vsubpd	zmm30 {k6}, zmm0, zmm1		;; .846/.975 (7 times)		-1.524/.975
	vbroadcastsd zmm27, ZMM_P1_P975		;; 1/.975
	vbroadcastsd zmm26, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm25, ZMM_P782_P975	;; .782/.975
	ENDM

zr7_fourteen_reals_seven_complex_djbfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt
						;; Seven complex comments	Fourteen-reals comments
	vmovapd	zmm0, [srcreg+1*d1+64]		;; I2					r2- = R2-R9
	vmovapd	zmm1, [srcreg+6*d1+64]		;; I7					r7- = R7-R14
	vmovapd	zmm2, [srcreg+5*d1+64]		;; I6					r6- = R6-R13
	vmovapd	zmm3, [srcreg+2*d1+64]		;; I3					r3- = R3-R10
	zfmaddpd zmm4, zmm0, zmm28, zmm1	;; i2+ = 1*I2+I7			-r2-- = -1*r2- + r7-	; 1-4		n 5
	zfmaddpd zmm5, zmm2, zmm28, zmm3	;; i3+ = I3+1*I6			r3-- = r3- + -1*r6-	; 1-4		n 5

	vmovapd	zmm6, [srcreg+1*d1]		;; R2					r2+ = R2+R9
	vmovapd	zmm7, [srcreg+6*d1]		;; R7					r7+ = R7+R14
	vmovapd	zmm8, [srcreg+3*d1+64]		;; I4					r4- = R4-R11
	vmovapd	zmm9, [srcreg+4*d1+64]		;; I5					r5- = R5-R12
	vaddpd	zmm10, zmm6, zmm7		;; r2+ = R2+R7				r2++ = r2+ + r7+	; 2-5		n 7
	zfmaddpd zmm11, zmm8, zmm28, zmm9	;; i4+ = 1*I4+I5			-r4-- = -1*r4- + r5-	; 2-5		n 9

	vmovapd	zmm12, [srcreg+2*d1]		;; R3					r3+ = R3+R10
	vmovapd	zmm13, [srcreg+5*d1]		;; R6					r6+ = R6+R13
	vmovapd	zmm14, [srcreg+3*d1]		;; R4					r4+ = R4+R11
	vmovapd	zmm15, [srcreg+4*d1]		;; R5					r5+ = R5+R12
	vaddpd	zmm16, zmm12, zmm13		;; r3+ = R3+R6				r3++ = r3+ + r6+	; 3-6		n 7
	vaddpd	zmm17, zmm14, zmm15		;; r4+ = R4+R5				r4++ = r4+ + r5+	; 3-6		n 11

	vmovapd	zmm18, [srcreg+0*d1+64]		;; i1					r1- = r1-r8
	vmulpd	zmm19, zmm18, zmm27		;; i1x = i1/.975			r1-x = r1-/.975		; 4-7		n 13
	vsubpd	zmm14, zmm14, zmm15		;; r4- = R4-R5				r4+- = r4+ - r5+	; 4-7		n 9

	vaddpd	zmm15, zmm4, zmm5		;; isum = i2+ + i3+			dif = -r2-- + r3--	; 5-8		n 9
	vsubpd	zmm12, zmm12, zmm13		;; r3- = R3-R6				r3+- = r3+ - r6+	; 5-8		n 9

	vmovapd	zmm13, [srcreg+0*d1]		;; r1					r1+ = r1+r8
	vmulpd	zmm20, zmm13, zmm27		;; r1x = r1/.975			r1+x = r1+/.975		; 6-9		n 15
	vsubpd	zmm6, zmm6, zmm7		;; r2- = R2-R7				r2+- = r2+ - r7+	; 6-9		n 10

	vaddpd	zmm7, zmm10, zmm16		;; rsum = r2+ + r3+			sum = r2++ + r3++	; 7-10		n 11
	zfmsubpd zmm2, zmm3, zmm28, zmm2	;; i3- = 1*I3-I6			-r3-+ = -1*r3- - r6-	; 7-10		n 12

	zfnmaddpd zmm0, zmm1, zmm28, zmm0	;; i2- = I2-1*I7			r2-+ = r2- - -1*r7-	; 8-11		n 12
	zfnmaddpd zmm8, zmm9, zmm28, zmm8	;; i4- = I4-1*I5			r4-+ = r4- - -1*r5-	; 8-11		n 12

	vaddpd	zmm1, zmm15, zmm11		;; isum = isum + i4+			dif = dif + -r4--	; 9-12		n 13
	zfmaddpd zmm3, zmm14, zmm26, zmm12	;; i27tmp = .434/.975r4- + r3-		I3 = .434/.975r4+- + r3+- ; 9-12	n 13

	L1prefetchw srcreg+srcinc+0*d1, L1pt
	zfmsubpd zmm9, zmm12, zmm26, zmm6	;; i36tmp = .434/.975r3- - r2-		negI5 = .434/.975r3+- - r2+- ; 10-13	n 14
	zfmaddpd zmm15, zmm6, zmm26, zmm14	;; i45tmp = .434/.975r2- + r4-		I7 = .434/.975r2+- + r4+- ; 10-13	n 14

	L1prefetchw srcreg+srcinc+0*d1+64, L1pt
	vaddpd	zmm7, zmm7, zmm17		;; rsum = rsum + r4+			sum = sum + r4++	; 11-14		n 15

	L1prefetchw srcreg+srcinc+1*d1, L1pt
	zfmsubpd zmm21, zmm2, zmm26, zmm0	;; r36tmp = .434/.975i3- - i2-		negI4 = .434/.975*-r3-+ - r2-+ ; 12-15	n 16
	zfmaddpd zmm22, zmm0, zmm26, zmm8	;; r45tmp = .434/.975i2- + i4-		I2 = .434/.975r2-+ + r4-+ ; 12-15	n 16

	L1prefetchw srcreg+srcinc+1*d1+64, L1pt
	zfmaddpd zmm19, zmm1, zmm29, zmm19	;; ibase = i1x - .223/.975*isum		base = r1-x + .623/.975*dif ; 13-16	n 17
	zfmaddpd zmm3, zmm6, zmm25, zmm3	;; i27tmp = i27tmp + .782/.975r2-	I3 = I3 + .782/.975r2+-	; 13-16		n 18

	L1prefetchw srcreg+srcinc+6*d1, L1pt
	zfnmaddpd zmm15, zmm12, zmm25, zmm15	;; i45tmp = i45tmp - .782/.975r3-	I7 = I7 - .782/.975r3+-	; 14-17		n 20
	zfmaddpd zmm9, zmm14, zmm25, zmm9	;; i36tmp = i36tmp + .782/.975r4-	negI5 = negI5 + .782/.975r4+- ; 14-17	n 18

	L1prefetchw srcreg+srcinc+6*d1+64, L1pt
	zfmaddpd zmm20, zmm7, zmm29, zmm20	;; rbase = r1x - .223/.975*rsum		base = r1+x + .623/.975*sum ; 15-18	n 19
	zfmaddpd zmm6, zmm8, zmm26, zmm2	;; r27tmp = .434/.975i4- + i3-		I6 = .434/.975r4-+ + -r3-+ ; 15-18	n 24

	L1prefetchw srcreg+srcinc+2*d1, L1pt
	zfnmaddpd zmm22, zmm2, zmm25, zmm22	;; r45tmp = r45tmp - .782/.975i3-	I2 = I2 - .782/.975*-r3-+ ; 16-19	n 32
	zfmaddpd zmm21, zmm8, zmm25, zmm21	;; r36tmp = r36tmp + .782/.975i4-	negI4 = negI4 + .782/.975r4-+ ; 16-19	n 32

	L1prefetchw srcreg+srcinc+2*d1+64, L1pt
	zfmaddpd zmm2, zmm4, zmm31, zmm19	;; I45 = ibase - .678/.975i2+		R4 = base - .846/.975-r2-- ; 17-20	n 21
	zfmaddpd zmm8, zmm5, zmm31, zmm19	;; I36 = ibase - .678/.975i3+		R6 = base - .846/.975r3-- ; 17-20	n 21

	L1prefetchw srcreg+srcinc+5*d1, L1pt
	vmovapd	zmm12, [screg+1*128]		;; sine*.975 for R3/I3
	zfmaddpd zmm19, zmm4, zmm30, zmm19	;; I27 = ibase + .846/.975i2+		R2 = base - 1.524/.975-r2-- ; 18-21	n 22
	vmovapd	zmm4, zmm9			;; copy (no clocks)
	vmulpd	zmm4 {k6}, zmm3, zmm12		;; blend in i36tmp			I3*sine3		; 18-21		n 29

	L1prefetchw srcreg+srcinc+5*d1+64, L1pt
	zfmaddpd zmm14, zmm10, zmm30, zmm20	;; R27 = rbase + .846/.975r2+		R7 = base - 1.524/.975r2++ ; 19-22	n 23
	zfmaddpd zmm10, zmm10, zmm31, zmm20	;; R45 = rbase - .678/.975r2+		R5 = base - .846/.975r2++ ; 19-22	n 23

	L1prefetchw srcreg+srcinc+3*d1, L1pt
	vmovapd	zmm23, [screg+5*128]		;; sine*.975 for R7/I7
	zfmaddpd zmm20, zmm16, zmm31, zmm20	;; R36 = rbase - .678/.975r3+		R3 = base - .846/.975r3++ ; 20-23	n 24
	vmulpd	zmm3 {k6}, zmm15, zmm23		;; blend in i27tmp			I7*sine7		; 20-23		n 30

	L1prefetchw srcreg+srcinc+3*d1+64, L1pt
	zfmaddpd zmm2, zmm5, zmm30, zmm2	;; I45 = I45 + .846/.975i3+		R4 = R4 - 1.524/.975r3-- ; 21-24	n 25
	zfmaddpd zmm8, zmm11, zmm30, zmm8	;; I36 = I36 + .846/.975i4+		R6 = R6 - 1.524/.975-r4-- ; 21-24	n 25

	L1prefetchw srcreg+srcinc+4*d1, L1pt
	vmovapd	zmm5, [screg+3*128]		;; sine*.975 for R5/I5
	zfmaddpd zmm19, zmm11, zmm31, zmm19	;; I27 = I27 - .678/.975i4+		R2 = R2 - .846/.975-r4-- ; 22-25	n 26
	vmulpd	zmm15 {k6}, zmm9, zmm5		;; blend in i45tmp			negI5*sine5		; 22-25		n 29

	L1prefetchw srcreg+srcinc+4*d1+64, L1pt
	zfmaddpd zmm10, zmm16, zmm30, zmm10	;; R45 = R45 + .846/.975r3+		R5 = R5 - 1.524/.975r3++ ; 23-26	n 27
	zfmaddpd zmm14, zmm17, zmm31, zmm14	;; R27 = R27 - .678/.975r4+		R7 = R7 - .846/.975r4++	; 23-26		n 27

	zfmaddpd zmm20, zmm17, zmm30, zmm20	;; R36 = R36 + .846/.975r4+		R3 = R3 - 1.524/.975r4++ ; 24-27	n 28
	zfmaddpd zmm6, zmm0, zmm25, zmm6	;; r27tmp = r27tmp + .782/.975i2-	I6 = I6 + .782/.975r2-+	; 24-27		n 31

	vmovapd	zmm0, [screg+4*128]		;; sine*.975 for R6/I6
	vmovapd	zmm9, [screg+2*128]		;; sine*.975 for R4/I4
	vmulpd	zmm8, zmm8, zmm0		;; I36*sine6				R6*sine6		; 25-28		n 29
	vmulpd	zmm2, zmm2, zmm9		;; I45*sine4				R4*sine4		; 25-28		n 29

	vmovapd	zmm11, [screg+0*128]		;; sine*.975 for R2/I2
	vmulpd	zmm16, zmm19, zmm11		;; I27*sine2				R2*sine2		; 26-29		n 30
	vaddpd	zmm1, zmm18, zmm1		;; I1 = i1 + isum			R1b = r1- + dif		; 26-29

	vmulpd	zmm10, zmm10, zmm5		;; R45*sine5				R5*sine5		; 27-30		n 32
	vmulpd	zmm14, zmm14, zmm23		;; R27*sine7				R7*sine7		; 27-30		n 31

	vmulpd	zmm17, zmm20, zmm12		;; R36*sine3				R3*sine3		; 28-31		n 32
	vaddpd	zmm7, zmm13, zmm7		;; R1 = r1 + rsum			R1a = r1+ + sum		; 28-31

	zfmaddpd zmm13, zmm4, zmm0, zmm8	;; I6 = I36 + i36tmp*sine6		not important		; 29-32		n 33
	zfnmsubpd zmm18, zmm15, zmm9, zmm2	;; -I4 = -(I45 + i45tmp*sine4)		not important		; 29-32		n 37

	zfmaddpd zmm19, zmm3, zmm11, zmm16	;; I2 = I27 + i27tmp*sine2		not important		; 30-33		n 34
	zfmsubpd zmm4 {k7}, zmm4, zmm0, zmm8	;; I3 = -(I36 - i36tmp*sine6)		blend in I3*sine3	; 30-33		n 36
	zstore	[srcreg+64], zmm1		;; Save I1							; 30

	vmovapd	zmm1, zmm14			;; copy (no clocks)
	zfmaddpd zmm1 {k7}, zmm6, zmm23, zmm1	;; R7 = R27 + r27tmp*sine7		blend in R7*sine7	; 31-34		n 35
	zfmsubpd zmm3 {k7}, zmm3, zmm11, zmm16	;; I7 = -(I27 - i27tmp*sine2)		blend in I7*sine7	; 31-34		n 35

	vmovapd	zmm20, zmm10			;; copy (no clocks)
	zfmaddpd zmm20 {k7}, zmm22, zmm5, zmm20	;; R5 = R45 + r45tmp*sine5		blend in R5*sine5	; 32-35		n 38
	vmovapd	zmm24, zmm17			;; copy (no clocks)
	zfmaddpd zmm24 {k7}, zmm21, zmm12, zmm24 ;; R3 = R36 + r36tmp*sine3		blend in R3*sine3	; 32-35		n 36
	zstore	[srcreg], zmm7			;; Save R1							; 32

	vmulpd	zmm13 {k6}, zmm6, zmm0		;; blend in I6				I6*sine6		; 33-36		n 41
	zfnmaddpd zmm15 {k7}, zmm15, zmm9, zmm2	;; -I5 = I45 - i45tmp*sine4		blend in -I5*sine5	; 33-36		n 38

	vmulpd	zmm19 {k6}, zmm22, zmm11	;; blend in I2				I2*sine2		; 34-37		n 41
	zfmsubpd zmm10, zmm22, zmm5, zmm10	;; R4 = -(R45 - r45tmp*sine5)		not important		; 34-37		n 40

	vmovapd	zmm0, [screg+5*128+64]		;; cosine/sine for R7/I7
	zfmsubpd zmm5, zmm1, zmm0, zmm3		;; A7 = R7 * cosine/sine - I7					; 35-38
	zfmsubpd zmm14, zmm6, zmm23, zmm14	;; R2 = -(R27 - r27tmp*sine7)		not important		; 35-38		n 39

	vmovapd	zmm6, [screg+1*128+64]		;; cosine/sine for R3/I3
	zfmsubpd zmm7, zmm24, zmm6, zmm4	;; A3 = R3 * cosine/sine - I3					; 36-39
	zfmsubpd zmm17, zmm21, zmm12, zmm17	;; R6 = -(R36 - r36tmp*sine3)		not important		; 36-39		n 40

	vmulpd	zmm18 {k6}, zmm21, zmm9		;; blend in -I4				negI4*sine4		; 37-40		n 42
	zfmaddpd zmm1, zmm3, zmm0, zmm1		;; B7 = I7 * cosine/sine + R7					; 37-40

	vmovapd	zmm0, [screg+3*128+64]		;; cosine/sine for R5/I5
	zfnmaddpd zmm3, zmm15, zmm0, zmm20	;; B5 = -(-I5) * cosine/sine + R5				; 38-41
	zfmaddpd zmm24, zmm4, zmm6, zmm24	;; B3 = I3 * cosine/sine + R3					; 38-41

	vblendmpd zmm4 {k6}, zmm14, zmm16	;; R2					R2			; 39		n 41
	zfmaddpd zmm15, zmm20, zmm0, zmm15	;; A5 = R5 * cosine/sine + (-I5)				; 39-42
	zstore	[srcreg+6*d1], zmm5		;; Save R7							; 39

	vblendmpd zmm0 {k6}, zmm17, zmm8	;; R6					R6			; 40		n 41
	vblendmpd zmm2 {k6}, zmm10, zmm2	;; R4					R4			; 40		n 42
	zstore	[srcreg+2*d1], zmm7		;; Save R3							; 40

	vmovapd	zmm5, [screg+4*128+64]		;; cosine/sine for R6/I6
	vmovapd	zmm6, [screg+0*128+64]		;; cosine/sine for R2/I2
	zfmaddpd zmm7, zmm13, zmm5, zmm0	;; B6 = I6 * cosine/sine + R6					; 41-44
	zfmsubpd zmm8, zmm4, zmm6, zmm19	;; A2 = R2 * cosine/sine - I2					; 41-44
	zstore	[srcreg+6*d1+64], zmm1		;; Save I7							; 41

	vmovapd	zmm1, [screg+2*128+64]		;; cosine/sine for R4/I4
	bump	screg, scinc
	zfnmaddpd zmm9, zmm18, zmm1, zmm2	;; B4 = -(-I4) * cosine/sine + R4				; 42-45
	zfmsubpd zmm13, zmm0, zmm5, zmm13	;; A6 = R6 * cosine/sine - I6					; 42-45
	zstore	[srcreg+2*d1+64], zmm24		;; Save I3							; 42

	zfmaddpd zmm4, zmm19, zmm6, zmm4	;; B2 = I2 * cosine/sine + R2					; 43-46
	zfmaddpd zmm18, zmm2, zmm1, zmm18	;; A4 = R4 * cosine/sine + (-I4)				; 43-46
	zstore	[srcreg+4*d1+64], zmm3		;; Save I5							; 42+1

	zstore	[srcreg+4*d1], zmm15		;; Save R5							; 43+1
	zstore	[srcreg+1*d1], zmm8		;; Save R2							; 45
	zstore	[srcreg+5*d1+64], zmm7		;; Save I6							; 45+1
	zstore	[srcreg+5*d1], zmm13		;; Save R6							; 46+1
	zstore	[srcreg+3*d1+64], zmm9		;; Save I4							; 46+2
	zstore	[srcreg+1*d1+64], zmm4		;; Save I2							; 47+2
	zstore	[srcreg+3*d1], zmm18		;; Save R4							; 47+3
	bump	srcreg, srcinc
	ENDM


;;
;; ************************************* fourteen-reals-seven-complex-unfft variants ******************************************
;;

;; Macro to do one fourteen_reals_unfft and seven seven_complex_djbunfft.  The fourteen-reals operation is done in the lower double of the ZMM register.
;; The seven-complex is done in the high doubles of the ZMM register.   This is REALLY funky, as we do both at the same time within the full zmm register
;; whenever possible.  A traditional fourteen-real unfft result is:
;; R1 = r1a+r1b  +    (r2+r7) +    (r3+r6) +    (r4+r5)
;; R8 = r1a-r1b  -    (r2-r7) +    (r3-r6) -    (r4-r5)
;; R2 = r1a-r1b  +.901(r2-r7) +.623(r3-r6) +.223(r4-r5) + (+.434(i2+i7) +.782(i3+i6) +.975(i4+i5))
;; R14= r1a-r1b  +.901(r2-r7) +.623(r3-r6) +.223(r4-r5) - (+.434(i2+i7) +.782(i3+i6) +.975(i4+i5))
;; R3 = r1a+r1b  +.623(r2+r7) -.223(r3+r6) -.901(r4+r5) + (+.782(i2-i7) +.975(i3-i6) +.434(i4-i5))
;; R13= r1a+r1b  +.623(r2+r7) -.223(r3+r6) -.901(r4+r5) - (+.782(i2-i7) +.975(i3-i6) +.434(i4-i5))
;; R4 = r1a-r1b  +.223(r2-r7) -.901(r3-r6) -.623(r4-r5) + (+.975(i2+i7) +.434(i3+i6) -.782(i4+i5))
;; R12= r1a-r1b  +.223(r2-r7) -.901(r3-r6) -.623(r4-r5) - (+.975(i2+i7) +.434(i3+i6) -.782(i4+i5))
;; R5 = r1a+r1b  -.223(r2+r7) -.901(r3+r6) +.623(r4+r5) + (+.975(i2-i7) -.434(i3-i6) -.782(i4-i5))
;; R11= r1a+r1b  -.223(r2+r7) -.901(r3+r6) +.623(r4+r5) - (+.975(i2-i7) -.434(i3-i6) -.782(i4-i5))
;; R6 = r1a-r1b  -.623(r2-r7) -.223(r3-r6) +.901(r4-r5) + (+.782(i2+i7) -.975(i3+i6) +.434(i4+i5))
;; R10= r1a-r1b  -.623(r2-r7) -.223(r3-r6) +.901(r4-r5) - (+.782(i2+i7) -.975(i3+i6) +.434(i4+i5))
;; R7 = r1a+r1b  -.901(r2+r7) +.623(r3+r6) -.223(r4+r5) + (+.434(i2-i7) -.782(i3-i6) +.975(i4-i5))
;; R9 = r1a+r1b  -.901(r2+r7) +.623(r3+r6) -.223(r4+r5) - (+.434(i2-i7) -.782(i3-i6) +.975(i4-i5))
;; But we don't want to perform the full fourteen real unfft, instead returning pairs that still need adding & subtracting:
;; (R1 + R8) / 2 =  r1a + r3 + r5 + r7						Store in R1
;; (R2 + R9) / 2 =  r1a -.901r7 +.623r3 -.223r5 +.434i7 +.782i3 +.975i5		Store in R2
;; (R3 + R10)/ 2 =  r1a +.623r7 -.223r3 -.901r5 -.782i7 +.975i3 -.434i5		Store in R3
;; (R4 + R11)/ 2 =  r1a -.223r7 -.901r3 +.623r5 +.975i7 +.434i3 -.782i5		Store in R4
;; (R5 + R12)/ 2 =  r1a -.223r7 -.901r3 +.623r5 -.975i7 -.434i3 +.782i5		Store in R5
;; (R6 + R13)/ 2 =  r1a +.623r7 -.223r3 -.901r5 +.782i7 -.975i3 +.434i5		Store in R6
;; (R7 + R14)/ 2 =  r1a -.901r7 +.623r3 -.223r5 -.434i7 -.782i3 -.975i5		Store in R7
;; (R1 - R8) / 2 =  r1b + r2 + r4 + r6						Store in R8  aka I1
;; (R2 - R9) / 2 = -r1b +.901r2 -.623r6 +.223r4 +.434i2 +.782i6 +.975i4		Store in R9  aka I2
;; (R3 - R10)/ 2 =  r1b +.623r2 -.223r6 -.901r4 +.782i2 -.975i6 +.434i4		Store in R10 aka I3
;; (R4 - R11)/ 2 = -r1b +.223r2 +.901r6 -.623r4 +.975i2 +.434i6 -.782i4		Store in R11 aka I4
;; (R5 - R12)/ 2 =  r1b -.223r2 -.901r6 +.623r4 +.975i2 +.434i6 -.782i4		Store in R12 aka I5
;; (R6 - R13)/ 2 = -r1b -.623r2 +.223r6 +.901r4 +.782i2 -.975i6 +.434i4		Store in R13 aka I6
;; (R7 - R14)/ 2 =  r1b -.901r2 +.623r6 -.223r4 +.434i2 +.782i6 +.975i4		Store in R14 aka I7

;; The cos rows share a base, as in the seven-complex unfft macro above (both lanes use the same constants here):
;; R27 = base + .846(r2+r7) - .678(r4+r5),  R36 = base - .678(r3+r6) + .846(r4+r5),  R45 = base - .678(r2+r7) + .846(r3+r6),  base = r1 - .223*sum.

zr7_fourteen_reals_seven_complex_djbunfft_preload MACRO
	mov	r9d, 11111110b			;; We're pretty sure r9 is safe to use
	kmovw	k7, r9d				;; Set k7 to 11111110b
	knotw	k6, k7				;; Set k6 to 00000001b
	vbroadcastsd zmm31, ZMM_P678_P975	;; .678/.975 = (.901-.223)/.975
	vbroadcastsd zmm30, ZMM_P846_P975	;; .846/.975 = (.623+.223)/.975
	vbroadcastsd zmm29, ZMM_P223_P975	;; .223/.975
	vbroadcastsd zmm28, ZMM_P434_P975	;; .434/.975
	vbroadcastsd zmm27, ZMM_P782_P975	;; .782/.975
	vbroadcastsd zmm26, ZMM_P1_P975		;; 1/.975
	vzero	zmm25
	ENDM

zr7_fourteen_reals_seven_complex_djbunfft MACRO srcreg,srcinc,d1,screg,scinc,maxrpt,L1pt
						;; Seven complex comments	Fourteen-reals comments
	vmovapd	zmm0, [srcreg+3*d1]		;; R4
	vmovapd	zmm1, [screg+2*128+64]		;; cosine4/sine4
	vmovapd	zmm2, [srcreg+3*d1+64]		;; I4
	vmovapd	zmm3, [srcreg+2*d1]		;; R3
	vmovapd	zmm4, [screg+1*128+64]		;; cosine3/sine3
	vmovapd	zmm5, [srcreg+2*d1+64]		;; I3
	zfmaddpd zmm6, zmm0, zmm1, zmm2		;; A4 = R4 * cosine4/sine4 + I4					; 1-4		n 5
	zfmaddpd zmm7, zmm3, zmm4, zmm5		;; A3 = R3 * cosine3/sine3 + I3					; 1-4		n 10

	vmovapd	zmm8, [srcreg+6*d1+64]		;; I7
	vmovapd	zmm9, [screg+5*128+64]		;; cosine7/sine7
	vmovapd	zmm10, [srcreg+6*d1]		;; R7
	vmovapd	zmm11, [srcreg+1*d1+64]		;; I2
	vmovapd	zmm12, [screg+0*128+64]		;; cosine2/sine2
	vmovapd	zmm13, [srcreg+1*d1]		;; R2
	zfmsubpd zmm14, zmm8, zmm9, zmm10	;; B7 = I7 * cosine7/sine7 - R7					; 2-5		n 6
	zfmsubpd zmm15, zmm11, zmm12, zmm13	;; B2 = I2 * cosine2/sine2 - R2					; 2-5		n 9

	vmovapd	zmm16, [srcreg+5*d1]		;; R6
	vmovapd	zmm17, [screg+4*128+64]		;; cosine6/sine6
	vmovapd	zmm18, [srcreg+5*d1+64]		;; I6
	zfmsubpd zmm3, zmm5, zmm4, zmm3		;; B3 = I3 * cosine3/sine3 - R3					; 3-6		n 9
	zfmaddpd zmm4, zmm16, zmm17, zmm18	;; A6 = R6 * cosine6/sine6 + I6					; 3-6		n 8

	vmovapd	zmm5, [srcreg+4*d1]		;; R5
	vmovapd	zmm19, [screg+3*128+64]		;; cosine5/sine5
	vmovapd	zmm20, [srcreg+4*d1+64]		;; I5
	zfmsubpd zmm16, zmm18, zmm17, zmm16	;; B6 = I6 * cosine6/sine6 - R6					; 4-7		n 8
	zfmaddpd zmm17, zmm5, zmm19, zmm20	;; A5 = R5 * cosine5/sine5 + I5					; 4-7		n 12

	vmovapd	zmm18, [screg+2*128]		;; sine4
	zfmsubpd zmm5, zmm20, zmm19, zmm5	;; B5 = I5 * cosine5/sine5 - R5					; 5-8		n 10
	vmulpd	zmm6, zmm6, zmm18		;; A4 = A4 * sine4 (R4)						; 5-8		n 13

	vmovapd	zmm19, [screg+5*128]		;; sine7
	vmulpd	zmm14, zmm14, zmm19		;; B7 = B7 * sine7 (I7)						; 6-9		n 13
	zfmsubpd zmm0, zmm2, zmm1, zmm0		;; B4 = I4 * cosine4/sine4 - R4					; 6-9		n 12

	zfmaddpd zmm8, zmm10, zmm9, zmm8	;; A7 = R7 * cosine7/sine7 + I7					; 7-10		n 11
	zfmaddpd zmm11, zmm13, zmm12, zmm11	;; A2 = R2 * cosine2/sine2 + I2					; 7-10		n 11

	vmovapd	zmm1, [screg+4*128]		;; sine6
	vmulpd	zmm2, zmm16, zmm1		;; B6 = B6 * sine6 (I6)						; 8-11		n 13
	vmulpd	zmm1, zmm4, zmm1		;; A6 = A6 * sine6 (R6)						; 8-11		n 13

	vmovapd	zmm4, [screg+1*128]		;; sine3
	vmovapd	zmm9, [screg+0*128]		;; sine2
	vmulpd	zmm3, zmm3, zmm4		;; B3 = B3 * sine3 (I3)						; 9-12		n 13
	vmulpd	zmm10, zmm15, zmm9		;; B2 = B2 * sine2 (I2)						; 9-12		n 13

	vmovapd	zmm12, [screg+3*128]		;; sine5
	bump	screg, scinc
	vmulpd	zmm5, zmm5, zmm12		;; B5 = B5 * sine5 (I5)						; 10-13		n 14
	vmulpd	zmm4, zmm7, zmm4		;; A3 = A3 * sine3 (R3)						; 10-13		n 15

	L1prefetchw srcreg+srcinc+1*d1, L1pt
	vmulpd	zmm7, zmm8, zmm19		;; A7 = A7 * sine7 (R7)						; 11-14		n 15
	vmulpd	zmm8, zmm11, zmm9		;; A2 = A2 * sine2 (R2)						; 11-14		n 15

	L1prefetchw srcreg+srcinc+1*d1+64, L1pt
	vmulpd	zmm9, zmm17, zmm12		;; A5 = A5 * sine5 (R5)						; 12-15		n 16
	vmulpd	zmm0, zmm0, zmm18		;; B4 = B4 * sine4 (I4)						; 12-15		n 16

	L1prefetchw srcreg+srcinc+6*d1, L1pt
	vmovapd	zmm11, zmm1			;; copy (no clocks)
	vaddpd	zmm11 {k7}, zmm10, zmm14	;; i2+ = i2+i7				blend in r6		; 13-16		n 17
	vmovapd	zmm12, zmm6			;; copy (no clocks)
	vaddpd	zmm12 {k7}, zmm3, zmm2		;; i3+ = i3+i6				blend in r4		; 13-16		n 17

	L1prefetchw srcreg+srcinc+6*d1+64, L1pt
	vmovapd	zmm13, zmm3			;; copy (no clocks)
	vsubpd	zmm13 {k7}, zmm10, zmm14	;; i2- = i2-i7				blend in i3		; 14-17		n 19
	vmovapd	zmm15, zmm5			;; copy (no clocks)
	vsubpd	zmm15 {k7}, zmm3, zmm2		;; i3- = i3-i6				blend in i5		; 14-17		n 19

	L1prefetchw srcreg+srcinc+2*d1, L1pt
	vmovapd	zmm3, zmm4			;; copy (no clocks)
	vaddpd	zmm3 {k7}, zmm8, zmm7		;; r2+ = r2+r7				blend in r3		; 15-18		n 20
	vsubpd	zmm2 {k7}, zmm8, zmm7		;; r2- = r2-r7				blend in i6		; 15-18		n 22

	L1prefetchw srcreg+srcinc+2*d1+64, L1pt
	vmovapd	zmm16, zmm9			;; copy (no clocks)
	vaddpd	zmm16 {k7}, zmm4, zmm1		;; r3+ = r3+r6				blend in r5		; 16-19		n 20
	vaddpd	zmm8 {k7}, zmm0, zmm5		;; i4+ = i4+i5				blend in r2		; 16-19		n 21

	L1prefetchw srcreg+srcinc+5*d1, L1pt
	vaddpd	zmm7 {k7}, zmm6, zmm9		;; r4+ = r4+r5				blend in r7		; 17-20		n 24
	vaddpd	zmm17, zmm11, zmm12		;; isum = i2+ + i3+			isum = r6 + r4		; 17-20		n 21

	L1prefetchw srcreg+srcinc+5*d1+64, L1pt
	vsubpd	zmm10 {k7}, zmm6, zmm9		;; r4- = r4-r5				blend in i2		; 18-21		n 22
	vmovapd	zmm6, zmm0			;; copy (no clocks)
	vsubpd	zmm6 {k7}, zmm4, zmm1		;; r3- = r3-r6				blend in i4		; 18-21		n 22

	L1prefetchw srcreg+srcinc+3*d1, L1pt
	vsubpd	zmm14 {k7}, zmm0, zmm5		;; i4- = i4-i5				blend in i7		; 19-22		n 23
	zfmsubpd zmm0, zmm15, zmm28, zmm13	;; r36tmp = .434/.975i3- - i2-		r36tmp = .434/.975i5 - i3 ; 19-22	n 25

	L1prefetchw srcreg+srcinc+3*d1+64, L1pt
	vaddpd	zmm1, zmm3, zmm16		;; rsum = r2+ + r3+			rsum = r3 + r5		; 20-23		n 24

	L1prefetchw srcreg+srcinc+4*d1, L1pt
	vaddpd	zmm4, zmm17, zmm8		;; isum = isum + i4+			isum = isum + r2	; 21-24		n 25

	L1prefetchw srcreg+srcinc+4*d1+64, L1pt
	zfmaddpd zmm5, zmm2, zmm28, zmm10	;; i45tmp = .434/.975r2- + r4-		i45tmp = .434/.975i6 + i2 ; 22-25	n 26
	zfmaddpd zmm9, zmm10, zmm28, zmm6	;; i27tmp = .434/.975r4- + r3-		i27tmp = .434/.975i2 + i4 ; 22-25	n 26

	L1prefetchw srcreg+srcinc+0*d1, L1pt
	zfmsubpd zmm17, zmm6, zmm28, zmm2	;; i36tmp = .434/.975r3- - r2-		i36tmp = .434/.975i4 - i6 ; 23-26	n 27
	zfmaddpd zmm18, zmm13, zmm28, zmm14	;; r45tmp = .434/.975i2- + i4-		r45tmp = .434/.975i3 + i7 ; 23-26	n 27

	L1prefetchw srcreg+srcinc+0*d1+64, L1pt
	vaddpd	zmm1, zmm1, zmm7		;; rsum = rsum + r4+			rsum = rsum + r7	; 24-27		n 28
	zfmaddpd zmm19, zmm14, zmm28, zmm15	;; r27tmp = .434/.975i4- + i3-		r27tmp = .434/.975i7 + i5 ; 24-27	n 28

	vmovapd	zmm20, [srcreg+64]		;; I1					R1b
	zfnmaddpd zmm21, zmm4, zmm29, zmm20	;; ibase = i1 - .223/.975*isum		ibase = r1b - .223/.975*isum ; 25-28	n 29
	zfmaddpd zmm0, zmm14, zmm27, zmm0	;; r36tmp = r36tmp + .782/.975i4-	r36tmp = r36tmp + .782/.975i7 ; 25-28	n 44

	zfnmaddpd zmm5, zmm6, zmm27, zmm5	;; i45tmp = i45tmp - .782/.975r3-	i45tmp = i45tmp - .782/.975i4 ; 26-29	n 38
	zfmaddpd zmm9, zmm2, zmm27, zmm9	;; i27tmp = i27tmp + .782/.975r2-	i27tmp = i27tmp + .782/.975i6 ; 26-29	n 39

	zfmaddpd zmm17, zmm10, zmm27, zmm17	;; i36tmp = i36tmp + .782/.975r4-	i36tmp = i36tmp + .782/.975i2 ; 27-30	n 37
	zfnmaddpd zmm18, zmm15, zmm27, zmm18	;; r45tmp = r45tmp - .782/.975i3-	r45tmp = r45tmp - .782/.975i5 ; 27-30	n 42

	vmovapd	zmm2, [srcreg]			;; R1					R1a
	zfnmaddpd zmm6, zmm1, zmm29, zmm2	;; rbase = r1 - .223/.975*rsum		rbase = r1a - .223/.975*rsum ; 28-31	n 32
