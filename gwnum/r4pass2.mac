	bump	rsi, -2*4*dist128-4*dist128 ;; Restore source pointer

;; Do FFT levels 5,6
;; Values 0-511 is real data, 512-12287 is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0	+6K	256	+6K	512	+6K	768	+6K
