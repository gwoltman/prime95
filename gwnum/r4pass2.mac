b3b:	r5_nf5cl_2sc_five_complex_djbfft rsi, 64, dist128, rdi, 128*3*XMM_SCD1, rbx, 128*6*XMM_SCD1
	bump	rdi, 3*XMM_SCD1		;; Next sin/cos data
	bump	rbx, 6*XMM_SCD1		;; Next sin/cos data
