; Author:  George Woltman
; Email: woltman@alum.mit.edu
;
; These macros efficiently implement the normalization to integers
; and multiplication by two-to-phi powers using SSE2 instructions.
;


; These macros implement the variants of the normalization routines
; in a non-pipelined way.  It is simply too much work to hand optimize
; all normalization variants.

; Compute the convolution error and if greater than MAXERR, set MAXERR

brute_force_error_check MACRO xmmreg, tmpreg, errreg
	movapd	tmpreg, XMM_BIGVAL	;; Convert to an integer
	addpd	tmpreg, xmmreg
	subpd	tmpreg, XMM_BIGVAL
	subpd	tmpreg, xmmreg		;; This is the convolution error
	andpd	tmpreg, XMM_ABSVAL	;; Compute absolute value
	maxpd	errreg, tmpreg		;; Compute maximum error
	ENDM

; Multiply the FFT result by a small constant.  Since we are worried that
; the FFT data times a small constant will overflow 51 bits, we split
; the FFT data into two pieces before multiplying by the constant.

brute_force_mul_by_const MACRO xmmreg, xmmreg2
	movapd	xmmreg2, XMM_BIGBIGVAL
	addpd	xmmreg2, xmmreg		;; Round to nearest multiple of 2^25
	addpd	xmmreg, XMM_BIGVAL	;; Round to an integer
	subpd	xmmreg2, XMM_BIGBIGVAL
	subpd	xmmreg, XMM_BIGVAL
	subpd	xmmreg, xmmreg2		;; xmmreg now contains low 25 bits
	mulpd	xmmreg2, XMM_MULCONST	;; Multiply by the small constant
	mulpd	xmmreg, XMM_MULCONST
	ENDM


;
; Now for the actual normalization macros!
;


; For 1D macros, these registers are set on input:
; xmm7 = sumout
; xmm6 = MAXERR
; xmm3 = carry #2
; xmm2 = carry #1
; esi = pointer to the FFT data values
; ebp = pointer two-to-phi multipliers
; edi = pointer to array of big vs. little flags
; ecx = big vs. little word flag #2
; eax = big vs. little word flag #1


; *************** 1D macro ******************
; A pipelined version of this code:
;	mov	al, [edi]		;; Load big vs. little flags
;	movapd	xmm0, [esi+0*dist1]	;; Load values
;	addpd	sumout, xmm0		;; sumout += values
;	mulpd	xmm0, [ebp+0]		;; Mul values1 by two-to-minus-phi
;	addpd	xmm0, xmm4		;; x = values + carry
;	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
;	addpd	xmm2, xmm0		;; y = top bits of x
;	movapd	xmm6, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
;	addpd	xmm6, xmm2		;; z = y - (maximum * BIGVAL - BIGVAL)
;	subpd	xmm0, xmm6		;; rounded value = x - z
;	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y
;	mulpd	xmm0, [ebp+16]		;; new value = val * two-to-phi
;	movapd	[esi+0*dist1], xmm0	;; Save new value

xnorm_1d MACRO ttp, zero, echk, const
ttp	mov	al, [edi]		;; Load big vs. little flags
ttp	mov	cl, [edi+2]
	movapd	xmm0, [esi]		;; Load values1
	unpcklpd xmm0, [esi+16]
	addpd	xmm7, xmm0		;; sumout += values1
	mulpd	xmm0, [ebp]		;; Mul values1 by two-to-minus-phi
echk	brute_force_error_check xmm0, xmm4, xmm6
const	brute_force_mul_by_const xmm0, xmm4
	movapd	xmm1, [esi+32]		;; Load values2
	unpcklpd xmm1, [esi+48]
	addpd	xmm7, xmm1		;; sumout += values2
	mulpd	xmm1, [ebp+64]		;; Mul values2 by two-to-minus-phi
echk	brute_force_error_check xmm1, xmm5, xmm6
const	brute_force_mul_by_const xmm1, xmm5
	addpd	xmm2, xmm0		;; x1 = values + carry
	addpd	xmm3, xmm1		;; x2 = values + carry
	movapd	xmm0, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm0, xmm2		;; y1 = top bits of x
	movapd	xmm1, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm1, xmm3		;; y2 = top bits of x
const	addpd	xmm4, xmm0		;; Add in upper mul-by-const bits
const	mulpd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const movapd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const mulpd	xmm4, xmm0		;; next carry = shifted y1
	subpd	xmm0, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
const	addpd	xmm5, xmm1		;; Add in upper mul-by-const bits
const	mulpd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const movapd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const mulpd	xmm5, xmm1		;; next carry = shifted y2
	subpd	xmm1, XMM_LIMIT_BIGMAX[ecx];; z2 = y2 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm2, xmm0		;; rounded value = x1 - z1
	subpd	xmm3, xmm1		;; rounded value = x2 - z2
ttp	mulpd	xmm2, [ebp+16]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm3, [ebp+80]		;; new value2 = val * two-to-phi
ttp	mov	al, [edi+1]		;; Load big vs. little flags
ttp	mov	cl, [edi+3]
	movapd	xmm0, [esi]		;; Load values1
	unpckhpd xmm0, [esi+16]
	addpd	xmm7, xmm0		;; sumout += values1
	mulpd	xmm0, [ebp+32]		;; Mul values1 by two-to-minus-phi
	movapd	[esi], xmm2		;; Save previous value1
echk	brute_force_error_check xmm0, xmm2, xmm6
const	brute_force_mul_by_const xmm0, xmm2
	movapd	xmm1, [esi+32]		;; Load values2
	unpckhpd xmm1, [esi+48]
	addpd	xmm7, xmm1		;; sumout += values2
	mulpd	xmm1, [ebp+96]		;; Mul values2 by two-to-minus-phi
zero	xorpd	xmm3, xmm3
	movapd	[esi+32], xmm3		;; Save previous value2
echk	brute_force_error_check xmm1, xmm3, xmm6
const	brute_force_mul_by_const xmm1, xmm3
	addpd	xmm0, xmm4		;; x1 = values + carry
	addpd	xmm1, xmm5		;; x2 = values + carry
	movapd	xmm4, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm4, xmm0		;; y1 = top bits of x
	movapd	xmm5, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y2 = top bits of x
const	addpd	xmm2, xmm4		;; Add in upper mul-by-const bits
const	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const movapd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const mulpd	xmm2, xmm4		;; next carry = shifted y1
	subpd	xmm4, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
const	addpd	xmm3, xmm5		;; Add in upper mul-by-const bits
const	mulpd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const movapd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const mulpd	xmm3, xmm5		;; next carry = shifted y2
	subpd	xmm5, XMM_LIMIT_BIGMAX[ecx];; z2 = y2 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
ttp	mulpd	xmm0, [ebp+48]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebp+112]		;; new value2 = val * two-to-phi
	movapd	[esi+16], xmm0		;; Save new value1
zero	xorpd	xmm1, xmm1
	movapd	[esi+48], xmm1		;; Save new value2
	ENDM


; This is the normalization routine when we are computing modulo k*2^n+c
; with a zero-padded 2^2n FFT.  We do this by multiplying the lower FFT
; word by k and adding in the upper word by -c.  Of course, this is made
; very tedious because we have to carefully avoid any loss of precision.
;
; xmm7 = sumout
; xmm6 = MAXERR
; xmm3 = carry #2 (previous high FFT data - not yet mul'ed by K)
; xmm2 = carry #1 (traditional carry)
; esi = pointer to the FFT data values
; ebp = pointer two-to-phi multipliers
; edi = pointer to array of big vs. little flags
; eax = big vs. little word flag #1

xnorm_1d_zpad MACRO ttp, echk, const
ttp	mov	al, [edi]		;; Load big vs. little flags
	movapd	xmm0, [esi]		;; Load values1
	unpcklpd xmm0, [esi+16]
	addpd	xmm7, xmm0		;; sumout += values1
	mulpd	xmm0, [ebp]		;; Mul values1 by two-to-minus-phi

	addpd	xmm0, xmm3		;; Add in previous high FFT data

	movapd	xmm3, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm3, xmm0		;; Round to multiple of big word
	subpd	xmm3, XMM_BIGBIGVAL

	movapd	xmm4, XMM_BIGVAL	;; Round to an integer
	addpd	xmm4, xmm0
	subpd	xmm4, XMM_BIGVAL

echk	subpd	xmm0, xmm4		;; This is the convolution error
echk	andpd	xmm0, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm0		;; Compute maximum error

	subpd	xmm4, xmm3		;; xmm4 now contains low bigword bits

	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; Saved shifted FFT hi data

no const movapd	xmm0, XMM_K_LO
const	movapd	xmm0, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm0, xmm4

no const mulpd	xmm4, XMM_K_HI
const	mulpd	xmm4, XMM_K_TIMES_MULCONST_HI

	addpd	xmm0, xmm2		;; x1 = values + carry

	movapd	xmm1, [esi+32]		;; Load values2
	unpcklpd xmm1, [esi+48]
	addpd	xmm7, xmm1		;; sumout += values2
	mulpd	xmm1, [ebp]		;; Mul values2 by two-to-minus-phi

	movapd	xmm5, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm5, xmm1		;; Round to multiple of big word
	subpd	xmm5, XMM_BIGBIGVAL	;; 

	movapd	xmm2, XMM_BIGVAL	;; Round to an integer
	addpd	xmm2, xmm1
	subpd	xmm2, XMM_BIGVAL

echk	subpd	xmm1, xmm2		;; This is the convolution error
echk	andpd	xmm1, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm1		;; Compute maximum error

	subpd	xmm2, xmm5		;; xmm2 now contains low bigword bits

no const mulpd	xmm2, XMM_MINUS_CARG
const	mulpd	xmm2, XMM_MINUS_CARG_TIMES_MULCONST
no const mulpd	xmm5, XMM_MINUS_CARG
const	mulpd	xmm5, XMM_MINUS_CARG_TIMES_MULCONST

	addpd	xmm0, xmm2		;; Add upper FFT word to lower FFT word
	addpd	xmm4, xmm5		;; Add upper FFT word to lower FFT word

	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	addpd	xmm4, xmm2		;; Add in upper mul-by-const bits
	mulpd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm2, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm2		;; rounded value = x1 - z1
ttp	mulpd	xmm0, [ebp+16]		;; new value1 = val * two-to-phi

ttp	mov	al, [edi+1]		;; Load big vs. little flags
	movapd	xmm5, [esi]		;; Load values1
	unpckhpd xmm5, [esi+16]
	movapd	[esi], xmm0		;; Save previous value1
	addpd	xmm7, xmm5		;; sumout += values1
	mulpd	xmm5, [ebp+32]		;; Mul values1 by two-to-minus-phi

	addpd	xmm5, xmm3		;; Add in previous high FFT data

	movapd	xmm3, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm3, xmm5		;; Round to multiple of big word
	subpd	xmm3, XMM_BIGBIGVAL

	movapd	xmm2, XMM_BIGVAL	;; Round to an integer
	addpd	xmm2, xmm5
	subpd	xmm2, XMM_BIGVAL

echk	subpd	xmm5, xmm2		;; This is the convolution error
echk	andpd	xmm5, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm5		;; Compute maximum error

	subpd	xmm2, xmm3		;; xmm2 now contains low bigword bits

	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; Saved shifted FFT hi data

no const movapd	xmm0, XMM_K_LO
const	movapd	xmm0, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm0, xmm2

no const mulpd	xmm2, XMM_K_HI
const	mulpd	xmm2, XMM_K_TIMES_MULCONST_HI

	addpd	xmm0, xmm4		;; x1 = values + carry

	movapd	xmm1, [esi+32]		;; Load values2
	unpckhpd xmm1, [esi+48]
	addpd	xmm7, xmm1		;; sumout += values2
	mulpd	xmm1, [ebp+32]		;; Mul values2 by two-to-minus-phi

	movapd	xmm5, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm5, xmm1		;; Round to multiple of big word
	subpd	xmm5, XMM_BIGBIGVAL	;; 

	movapd	xmm4, XMM_BIGVAL	;; Round to an integer
	addpd	xmm4, xmm1
	subpd	xmm4, XMM_BIGVAL

echk	subpd	xmm1, xmm4		;; This is the convolution error
echk	andpd	xmm1, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm1		;; Compute maximum error

	subpd	xmm4, xmm5		;; xmm4 now contains low bigword bits

no const mulpd	xmm4, XMM_MINUS_CARG
const	mulpd	xmm4, XMM_MINUS_CARG_TIMES_MULCONST
no const mulpd	xmm5, XMM_MINUS_CARG
const	mulpd	xmm5, XMM_MINUS_CARG_TIMES_MULCONST

	addpd	xmm0, xmm4		;; Add upper FFT word to lower FFT word
	addpd	xmm2, xmm5		;; Add upper FFT word to lower FFT word

	movapd	xmm4, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm4, xmm0		;; y1 = top bits of x
	addpd	xmm2, xmm4		;; Add in upper mul-by-const bits
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm4, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
ttp	mulpd	xmm0, [ebp+48]		;; new value1 = val * two-to-phi

	movapd	[esi+16], xmm0		;; Save new value1
	subpd	xmm1, xmm1		;; new value2 = zero
	movapd	[esi+32], xmm1		;; Zero previous value2
	movapd	[esi+48], xmm1		;; Zero current value2
	ENDM


; *************** 1D followup macros ******************
; This macro finishes the normalize process by adding the final
; carry from the first pass back into the lower two data values.
; xmm2,xmm3 = carries
; ebx = pointer to the FFT data values
; edx = pointer two-to-power multipliers
; edi = big vs. litle array pointer
; NOTE: If RATIONAL_FFT we could eliminate 8 multiplies.

xnorm012_1d_mid MACRO zero
	mov	al, [edi]		;; Load big vs. little flags
	mov	cl, [edi+2]
	_movsd	xmm0, [ebx+8]		;; Load values1
	mulsd	xmm0, [edx+8]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [ebx+40]		;; Load values2
	mulsd	xmm1, [edx+72]		;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	movlpd	xmm3, XMM_LIMIT_BIGMAX[ecx+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx+8];; next carry = shifted y2
	mulsd	xmm0, [edx+24]		;; new value1 = val * two-to-phi
	mulsd	xmm1, [edx+88]		;; new value2 = val * two-to-phi
	_movsd	[ebx+8], xmm0		;; Save new value1
zero	subsd	xmm1, xmm1
	_movsd	[ebx+40], xmm1		;; Save new value2

	mov	al, [edi+1]		;; Load big vs. little flags
	mov	cl, [edi+3]
	_movsd	xmm0, [ebx+24]		;; Load values1
	mulsd	xmm0, [edx+40]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [ebx+56]		;; Load values2
	mulsd	xmm1, [edx+104]		;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	movlpd	xmm3, XMM_LIMIT_BIGMAX[ecx+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx+8];; next carry = shifted y2
	mulsd	xmm0, [edx+56]		;; new value1 = val * two-to-phi
	mulsd	xmm1, [edx+120]		;; new value2 = val * two-to-phi
	_movsd	[ebx+24], xmm0		;; Save new value1
zero	subsd	xmm1, xmm1
	_movsd	[ebx+56], xmm1		;; Save new value2

	mov	al, [edi+4]		;; Load big vs. little flags
	mov	cl, [edi+6]
	_movsd	xmm0, [ebx+64+8]	;; Load values1
	mulsd	xmm0, [edx+128+8]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [ebx+64+40]	;; Load values2
	mulsd	xmm1, [edx+128+72]	;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	movlpd	xmm3, XMM_LIMIT_BIGMAX[ecx+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx+8];; next carry = shifted y2
	mulsd	xmm0, [edx+128+24]	;; new value1 = val * two-to-phi
	mulsd	xmm1, [edx+128+88]	;; new value2 = val * two-to-phi
	_movsd	[ebx+64+8], xmm0	;; Save new value1
zero	subsd	xmm1, xmm1
	_movsd	[ebx+64+40], xmm1	;; Save new value2

	_movsd	xmm0, [ebx+64+24]	;; Load values1
	_movsd	xmm1, [ebx+64+56]	;; Load values2
	subsd	xmm2, XMM_BIGVAL	;; Remove integer rounding constant
	subsd	xmm3, XMM_BIGVAL	;; Remove integer rounding constant
	mulsd	xmm2, [edx+128+56]	;; carry *= two-to-phi
	mulsd	xmm3, [edx+128+120]	;; carry *= two-to-phi
	addsd	xmm0, xmm2		;; value1 = values + carry
	addsd	xmm1, xmm3		;; value2 = values + carry
	_movsd	[ebx+64+24], xmm0	;; Save new value1
zero	subsd	xmm1, xmm1
	_movsd	[ebx+64+56], xmm1	;; Save new value2

	shufpd	xmm2, xmm2, 1		;; Rotate carry
	movhpd	xmm2, XMM_BIGVAL
	shufpd	xmm3, xmm3, 1		;; Rotate carry
	movhpd	xmm3, XMM_BIGVAL
	ENDM

; This macro is similar to the above, but is for the zero padding case.
; xmm2 = carry #1 (traditional carry)
; xmm3 = carry #2 (previous high FFT data - not yet mul'ed by K)
; ebx = pointer to the FFT data values
; edx = pointer two-to-power multipliers
; edi = big vs. litle array pointer

xnorm012_1d_mid_zpad MACRO const
	mov	al, [edi]		;; Load big vs. little flags
	_movsd	xmm0, [ebx+8]		;; Load values1
	mulsd	xmm0, [edx+8]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values1 + carry
no const _movsd	xmm1, XMM_K_LO		;; Calc high FFT carry times k
const	_movsd	xmm1, XMM_K_TIMES_MULCONST_LO
	mulsd	xmm1, xmm3
	addsd	xmm0, xmm1		;; x1 = x1 + high_FFT_carry * k_lo
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(max*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	mulsd	xmm3, XMM_LIMIT_INVERSE[eax+8];; shift high_fft_carry
	mulsd	xmm0, [edx+24]		;; new value1 = val * two-to-phi
	_movsd	[ebx+8], xmm0		;; Save new value1

no const _movsd	xmm4, XMM_K_HI_1	;; Mul high_FFT_carry by k_hi
const	_movsd	xmm4, XMM_K_TIMES_MULCONST_HI_1
	mulsd	xmm4, xmm3
no const mulsd	xmm3, XMM_K_HI_2
const	mulsd	xmm3, XMM_K_TIMES_MULCONST_HI_2
	addsd	xmm2, xmm4		;; Carry += high_FFT_carry * lo(k_hi)

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, [ebx+24]		;; Load values1
	mulsd	xmm0, [edx+40]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(max*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	addsd	xmm2, xmm3		;; Add in high_FFT_carry * hi(k_hi)
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	mulsd	xmm0, [edx+56]		;; new value1 = val * two-to-phi
	_movsd	[ebx+24], xmm0		;; Save new value1

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, [ebx+64+8]	;; Load values1
	mulsd	xmm0, [edx+128+8]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	movlpd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(max*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y1
	mulsd	xmm0, [edx+128+24]	;; new value1 = val * two-to-phi
	_movsd	[ebx+64+8], xmm0	;; Save new value1

	_movsd	xmm0, [ebx+64+24]	;; Load values1
	subsd	xmm2, XMM_BIGVAL	;; Remove integer rounding constant
	mulsd	xmm2, [edx+128+56]	;; carry *= two-to-phi
	addsd	xmm0, xmm2		;; value1 = values + carry
	_movsd	[ebx+64+24], xmm0	;; Save new value1

	shufpd	xmm2, xmm2, 1		;; Rotate carry
	movhpd	xmm2, XMM_BIGVAL
	subsd	xmm3, xmm3
	shufpd	xmm3, xmm3, 1		;; Rotate carry
	ENDM


; We could take advantage of the fact that the first two-to-phi multiplier
; and the first two-to-minus-phi multiplier are one.  We also know
; the first data value is a big word (eax would be 48).
; xmm2,xmm3 = carries
; esi = pointer to the FFT data values
; ebp = pointer two-to-power multipliers
; edi = big vs. litle array pointer
; NOTE: If RATIONAL_FFT we could eliminate 8 multiplies.

xnorm012_1d MACRO zero
	mov	al, [edi]		;; Load big vs. little flags
	mov	cl, [edi+2]
	subsd	xmm3, XMM_BIGVAL
	mulsd	xmm3, XMM_MINUS_CARG	;; Adjust wrap-around carry
	addsd	xmm3, XMM_BIGVAL
	_movsd	xmm0, [esi]		;; Load values1
	mulsd	xmm0, [ebp]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [esi+32]		;; Load values2
	mulsd	xmm1, [ebp+64]		;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm3		;; x1 = values + carry
	addsd	xmm1, xmm2		;; x2 = values + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
	mulsd	xmm0, [ebp+16]		;; new value1 = val * two-to-phi
	mulsd	xmm1, [ebp+80]		;; new value2 = val * two-to-phi
	_movsd	[esi], xmm0		;; Save previous value1
zero	subsd	xmm1, xmm1
	_movsd	[esi+32], xmm1		;; Save previous value2

	mov	al, [edi+1]		;; Load big vs. little flags
	mov	cl, [edi+3]
	_movsd	xmm0, [esi+16]		;; Load values1
	mulsd	xmm0, [ebp+32]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [esi+48]		;; Load values2
	mulsd	xmm1, [ebp+96]		;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
	mulsd	xmm0, [ebp+48]		;; new value1 = val * two-to-phi
	mulsd	xmm1, [ebp+112]		;; new value2 = val * two-to-phi
	_movsd	[esi+16], xmm0		;; Save previous value1
zero	subsd	xmm1, xmm1
	_movsd	[esi+48], xmm1		;; Save previous value2

	mov	al, [edi+4]		;; Load big vs. little flags
	mov	cl, [edi+6]
	_movsd	xmm0, [esi+64]		;; Load values1
	mulsd	xmm0, [ebp+128]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	_movsd	xmm1, [esi+64+32]	;; Load values2
	mulsd	xmm1, [ebp+128+64]	;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm3, xmm1		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	_movsd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subsd	xmm1, xmm5		;; rounded value = x2 - z2
	mulsd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
	mulsd	xmm0, [ebp+128+16]	;; new value1 = val * two-to-phi
	mulsd	xmm1, [ebp+128+80]	;; new value2 = val * two-to-phi
	_movsd	[esi+64], xmm0		;; Save previous value1
zero	subsd	xmm1, xmm1
	_movsd	[esi+64+32], xmm1	;; Save previous value2

	_movsd	xmm0, [esi+64+16]	;; Load values1
	_movsd	xmm1, [esi+64+48]	;; Load values2
	subsd	xmm2, XMM_BIGVAL	;; Remove integer rounding constant
	subsd	xmm3, XMM_BIGVAL	;; Remove integer rounding constant
	mulsd	xmm2, [ebp+128+48]	;; carry *= two-to-phi
	mulsd	xmm3, [ebp+128+112]	;; carry *= two-to-phi
	addsd	xmm0, xmm2		;; value1 = values + carry
	addsd	xmm1, xmm3		;; value2 = values + carry
	_movsd	[esi+64+16], xmm0	;; Save new value1
zero	subsd	xmm1, xmm1
	_movsd	[esi+64+48], xmm1	;; Save new value2
	ENDM

; This macro is similar to the above, but is for the zero padding case.
; xmm2 = carry #1 (traditional carry)
; xmm3 = carry #2 (previous high FFT data - not yet mul'ed by K)
; esi = pointer to the FFT data values
; ebp = pointer two-to-power multipliers
; edi = big vs. litle array pointer
; NOTE: If RATIONAL_FFT we could eliminate 8 multiplies.

xnorm012_1d_zpad MACRO const
	LOCAL	smallk, mediumk, div_k_done, funnyaddr1, funny1done
	LOCAL	funnyaddr2, funny2done

	;; Strip BIGVAL from the traditional carry, we'll add the traditional
	;; carry in later when we are working on the ZPAD0 - ZPAD6 values.
	subsd	xmm2, XMM_BIGVAL	;; Integerize traditional carry

	;; Rather than calculate high FFT carry times k and then later dividing
	;; by k, we multiply FFT high carry by const and we'll add it
	;; to the lower FFT data later (after multiplying by -CARG).
const	mulsd	xmm3, XMM_MULCONST

	;; Multiply ZPAD0 through ZPAD6 by const * -CARG.  This, in essense,
	;; wraps this data from above the FFT data area to the halfway point.
	;; Later on we'll divide this by K to decide which data needs wrapping
	;; all the way down to the bottom of the FFT data.

	;; NOTE that ZPAD0's column multiplier is 1.0.  Also, ZPAD6 will not
	;; be bigger than a big word.  We must be careful to handle CARG's up
	;; to about 30 bits

	mov	al, [edi]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD0		;; Load values1
	addsd	xmm0, _ADDIN_VALUE	;; Add in the requested value
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm2		;; Add in traditional carry
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD0, xmm0

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD1		;; Load values1
	mulsd	xmm0, [ebp+32]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD1, xmm0

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD2		;; Load values1
	mulsd	xmm0, [ebp+128]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD2, xmm0

	mov	al, [edi+5]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD3		;; Load values1
	mulsd	xmm0, [ebp+128+32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD3, xmm0

	cmp	_FFTLEN, 80		;; Length 80 and 112 have different
	je	funnyaddr1		;; memory addresses for the fourth
	cmp	_FFTLEN, 112		;; and higher data elements
	je	funnyaddr1

	mov	al, [edi+8]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD4		;; Load values1
	mulsd	xmm0, [ebp+256]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD4, xmm0

	mov	al, [edi+9]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD5		;; Load values1
	mulsd	xmm0, [ebp+256+32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD5, xmm0

	_movsd	xmm0, XMM_ZPAD6		;; Load values1
	mulsd	xmm0, [ebp+384]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	XMM_ZPAD6, xmm0
	jmp	funny1done

	;; Same as the above but with different addresses required by
	;; the length 80 and 112 FFT lengths

funnyaddr1:
	mov	al, [edi]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD4		;; Load values1
	mulsd	xmm0, [ebp+8]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax+8];; Saved shifted high ZPAD data
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax+8];; Shift high ZPAD data
	_movsd	XMM_ZPAD4, xmm0

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD5		;; Load values1
	mulsd	xmm0, [ebp+32+8]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax+8];; Shift high ZPAD data
	_movsd	XMM_ZPAD5, xmm0

	_movsd	xmm0, XMM_ZPAD6		;; Load values1
	mulsd	xmm0, [ebp+128+8]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	XMM_ZPAD6, xmm0
funny1done:

	;; Divide the zpad data by k.  Store the integer part in XMM_TMP
	;; and the remainder in XMM_ZPAD0.  Later we will wrap the integer part
	;; down to the bottom of the FFT data area (and multiply by -CARG).
	;; And we will store the remainder in the upper half of the FFT
	;; data area.

	;; Note there are three cases to handle.  K is smaller than a big word.
	;; K is between one and 2 big words in size.  And K is more than
	;; 2 big words in size.

	cmp	_ZPAD_TYPE, 2		;; Are we dealing with case 1,2,or 3
	jl	smallk			;; One word case
	je	mediumk			;; Two word case

	;; This case does the divide by k where k is three words

	_movsd	xmm0, XMM_ZPAD6		;; Load zpad word (high bits)
	_movsd	xmm1, XMM_ZPAD5		;; Load zpad word (middle bits)
	_movsd	xmm2, XMM_ZPAD4		;; Load zpad word (low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K6	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K6_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K6_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K6_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP5, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT6	;; Shift previous zpad word
	addsd	xmm1, xmm0		;; Add to create new high zpad bits
	_movsd	xmm0, XMM_ZPAD3		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT5	;; Combine high and medium bits
	mulsd	xmm5, xmm1
	addsd	xmm5, xmm2
	_movsd	xmm4, _ZPAD_INVERSE_K5	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K5_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K5_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K5_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP4, xmm4		;; Save word of zpad / k

	mulsd	xmm1, _ZPAD_SHIFT5	;; Shift previous zpad word
	addsd	xmm2, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD2		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT4	;; Combine high and medium bits
	mulsd	xmm5, xmm2
	addsd	xmm5, xmm0
	_movsd	xmm4, _ZPAD_INVERSE_K4	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K4_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K4_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K4_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP3, xmm4		;; Save word of zpad / k

	mulsd	xmm2, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, xmm2		;; Add to create new high zpad bits
	_movsd	xmm2, XMM_ZPAD1		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT3	;; Combine high and medium bits
	mulsd	xmm5, xmm0
	addsd	xmm5, xmm1
	_movsd	xmm4, _ZPAD_INVERSE_K3	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K3_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K3_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K3_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP2, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm1, xmm0		;; Add to create new high zpad bits
	_movsd	xmm0, XMM_ZPAD0		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT2	;; Combine high and medium bits
	mulsd	xmm5, xmm1
	addsd	xmm5, xmm2
	_movsd	xmm4, _ZPAD_INVERSE_K2	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K2_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K2_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K2_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP1, xmm4		;; Save word of zpad / k

	mulsd	xmm1, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm2, xmm1		;; Add to create new high zpad bits
	mulsd	xmm2, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, xmm2		;; Add to create new high zpad bits
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder of zpad / k

	subsd	xmm1, xmm1		;; Zero words that other cases set
	_movsd	XMM_TMP6, xmm1
	
	jmp	div_k_done

	;; This case does the divide by k where k is two words
mediumk:
	_movsd	xmm0, XMM_ZPAD6		;; Load zpad word (high bits)
	_movsd	xmm1, XMM_ZPAD5		;; Load zpad word (low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K6	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K6_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K6_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP6, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT6	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD4		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K5	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K5_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K5_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP5, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT5	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD3		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K4	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K4_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K4_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP4, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD2		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K3	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K3_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K3_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP3, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD1		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K2	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K2_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K2_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP2, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD0		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K1_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K1_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP1, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder of zpad / k

	jmp	div_k_done

	;; This case does the divide by k where k is one word
	;; Assume ZPAD5 and ZPAD6 are zero.
smallk:	_movsd	xmm0, XMM_ZPAD4		;; Load zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP5, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD3		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP4, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD2		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP3, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD1		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP2, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD0		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP1, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder

	subsd	xmm1, xmm1		;; Zero words that other cases set
	_movsd	XMM_TMP6, xmm1
	
div_k_done:

	;; Now normalize the data above the halfway point.  Remember that the
	;; column two-to-phi multiplier for the first value will be 1.0.

	mov	al, [edi]		;; First word 
	_movsd	xmm0, XMM_ZPAD0		;; Load remainder of divide by k
	addsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	_movsd	[esi+32], xmm0		;; Save value1

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm0, xmm2		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm0		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm2, xmm4		;; rounded value = x2 - z2
	mulsd	xmm0, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	mulsd	xmm2, [ebp+48]		;; new value2 = val * two-to-phi
	_movsd	[esi+48], xmm2		;; Save value2

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y3 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z3 = y3-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x3 - z3
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y3
	mulsd	xmm0, [ebp+128+16]	;; new value3 = val * two-to-phi
	_movsd	[esi+64+32], xmm0	;; Save value3

	subsd	xmm2, XMM_BIGVAL	;; Remove integer rounding constant
	mulsd	xmm2, [ebp+128+48]	;; value4 = carry * two-to-phi
	_movsd	[esi+64+48], xmm2	;; Save new value4

	;; Mul the integer part of (ZPAD data divided by k) by -CARG in
	;; preparation for adding it into the lower FFT data area.
	;; Also add in the shifted high FFT carry at this time.

	;; Now add in and normalize the bottom FFT data.  Remember that the
	;; column two-to-phi multiplier for the first value will be 1.0.  We 
	;; must go 6 words deep in case k is 48-50 bits and CARG is 32 bits.

	mov	al, [edi]		;; First word 
	_movsd	xmm0, XMM_TMP1		;; Load remainder of divide by k
	addsd	xmm0, xmm3		;; Add in shifted high FFT carry
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	addsd	xmm0, XMM_BIGVAL
	addsd	xmm0, [esi]		;; Add in the FFT data
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	_movsd	[esi], xmm0		;; Save value1

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP2		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+16]		;; Load FFT data
	mulsd	xmm1, [ebp+32]		;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x2 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x2 - z2
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	mulsd	xmm0, [ebp+48]		;; new value2 = val * two-to-phi
	_movsd	[esi+16], xmm0		;; Save value2

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP3		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+64]		;; Load FFT data
	mulsd	xmm1, [ebp+128]		;; Mul values3 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x3 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y3 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z3 = y3-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x3 - z3
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y3
	mulsd	xmm0, [ebp+128+16]	;; new value3 = val * two-to-phi
	_movsd	[esi+64], xmm0		;; Save value3

	mov	al, [edi+5]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP4		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+64+16]	;; Load FFT data
	mulsd	xmm1, [ebp+128+32]	;; Mul values4 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x4 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y4 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z4 = y4-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x4 - z4
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y4
	mulsd	xmm0, [ebp+128+48]	;; new value4 = val * two-to-phi
	_movsd	[esi+64+16], xmm0	;; Save value4

	cmp	_FFTLEN, 80		;; Length 80 and 112 have different
	je	funnyaddr2		;; memory addresses for the fourth
	cmp	_FFTLEN, 112		;; and higher data elements
	je	funnyaddr2

	mov	al, [edi+8]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP5		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+128]		;; Load FFT data
	mulsd	xmm1, [ebp+256]		;; Mul values4 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x5 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y5 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z5 = y5-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x5 - z5
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y5
	mulsd	xmm0, [ebp+256+16]	;; new value5 = val * two-to-phi
	_movsd	[esi+128], xmm0		;; Save value5

	mov	al, [edi+9]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP6		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+128+16]	;; Load FFT data
	mulsd	xmm1, [ebp+256+32]	;; Mul values6 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x6 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y6 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z6 = y6-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x6 - z6
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y6
	mulsd	xmm0, [ebp+256+48]	;; new value6 = val * two-to-phi
	_movsd	[esi+128+16], xmm0	;; Save value6

	subsd	xmm2, XMM_BIGVAL	;; Remove rounding constant
	mulsd	xmm2, [ebp+384+16]	;; new value7 = val * two-to-phi
	addsd	xmm2, [esi+192]		;; Add in FFT data
	_movsd	[esi+192], xmm2		;; Save value7
	jmp	funny2done

	;; Same as the above but with different addresses required by
	;; the length 80 and 112 FFT lengths

funnyaddr2:
	mov	al, [edi]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP5		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+8]		;; Load FFT data
	mulsd	xmm1, [ebp+8]		;; Mul values5 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x5 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y5 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z5 = y5-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x5 - z5
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y5
	mulsd	xmm0, [ebp+16+8]	;; new value5 = val * two-to-phi
	_movsd	[esi+8], xmm0		;; Save value5

	mov	al, [edi+1]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP6		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+16+8]	;; Load FFT data
	mulsd	xmm1, [ebp+32+8]	;; Mul values6 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x6 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax+8];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y6 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax+8];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z6 = y6-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x6 - z6
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax+8];; next carry = shifted y6
	mulsd	xmm0, [ebp+48+8]	;; new value6 = val * two-to-phi
	_movsd	[esi+16+8], xmm0	;; Save value6

	subsd	xmm2, XMM_BIGVAL	;; Remove rounding constant
	mulsd	xmm2, [ebp+128+16+8]	;; new value7 = val * two-to-phi
	addsd	xmm2, [esi+64+8]	;; Add in FFT data
	_movsd	[esi+64+8], xmm2	;; Save value7
funny2done:

	ENDM



; For 2D macros, these registers are set on input:
; xmm7 = sumout
; xmm6 = maxerr
; ebp = pointer to carries
; edi = pointer to big/little flags
; esi = pointer to the FFT data
; ebx = pointer two-to-power column multipliers
; edx = pointer two-to-power group multipliers
; ecx = big vs. little word flag #2
; eax = big vs. little word flag #1


; *************** 2D macro ******************
; A pipelined version of this code:
;	mov	al, [edi]		;; Load big vs. little flags
;	movapd	xmm0, [esi+0*dist1]	;; Load values1
;	addpd	sumout, xmm0		;; sumout += values1
;	movapd	xmm2, [ebx]		;; col two-to-minus-phi
;	mulpd	xmm2, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
;	mulpd	xmm0, [edx]		;; Mul by grp two-to-minus-phi
;	mulpd	xmm0, xmm2		;; Mul by fudged col two-to-minus-phi
;	addpd	xmm0, [ebp+0*16]	;; x1 = values + carry
;	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
;	addpd	xmm2, xmm0		;; y1 = top bits of x
;	movapd	xmm6, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
;	addpd	xmm6, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
;	subpd	xmm0, xmm6		;; rounded value = x1 - z1
;	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
;	movapd	xmm4, [ebx]		;; col two-to-phi
;	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
;	mulpd	xmm0, [edx+0*32+16]	;; new value1 = val * grp two-to-phi
;	mulpd	xmm0, xmm4		;; new value1 *= fudged col two-to-phi
;	movapd	[esi+0*dist1], xmm0	;; Save new value1
;	movapd	[ebp+0*16], xmm2	;; Save carry
;

xnorm_2d MACRO ttp, zero, echk, const
ttp	mov	al, [edi+0]		;; Load big vs. little flags
ttp	mov	cl, [edi+1]		;; Load big vs. little flags
	movapd	xmm0, [esi+0*16]	;; Load values1
	addpd	xmm7, xmm0		;; sumout += values1
	movapd	xmm2, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm2, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm0, [edx+0*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm0, xmm2		;; Mul by fudged col two-to-minus-phi
echk	brute_force_error_check xmm0, xmm4, xmm6
const	brute_force_mul_by_const xmm0, xmm4
	movapd	xmm1, [esi+1*16]	;; Load values2
	addpd	xmm7, xmm1		;; sumout += values2
	movapd	xmm3, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm3, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm1, [edx+1*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm1, xmm3		;; Mul by fudged col two-to-minus-phi
echk	brute_force_error_check xmm1, xmm5, xmm6
const	brute_force_mul_by_const xmm1, xmm5
	addpd	xmm0, [ebp+0*16]	;; x1 = values + carry
	addpd	xmm1, [ebp+1*16]	;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y2 = top bits of x
const	addpd	xmm4, xmm2		;; Add in upper mul-by-const bits
const	mulpd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const movapd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const mulpd	xmm4, xmm2		;; next carry = shifted y1
	subpd	xmm2, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
const	addpd	xmm5, xmm3		;; Add in upper mul-by-const bits
const	mulpd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const movapd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const mulpd	xmm5, xmm3		;; next carry = shifted y2
	subpd	xmm3, XMM_LIMIT_BIGMAX[ecx];; z2 = y2 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm2		;; rounded value = x1 - z1
	subpd	xmm1, xmm3		;; rounded value = x2 - z2
ttp	movapd	xmm2, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [edx+0*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+0*16], xmm0	;; Save new value1
	movapd	[ebp+0*16], xmm4	;; Save carry
ttp	movapd	xmm3, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm1, [edx+1*32+16]	;; new value2 = val * grp two-to-phi
ttp	mulpd	xmm1, xmm3		;; new value2 *= fudged col two-to-phi
	movapd	[esi+1*16], xmm1	;; Save new value2
	movapd	[ebp+1*16], xmm5	;; Save carry

ttp	mov	al, [edi+2]		;; Load big vs. little flags
ttp	mov	cl, [edi+3]		;; Load big vs. little flags
	movapd	xmm0, [esi+2*16]	;; Load values1
	addpd	xmm7, xmm0		;; sumout += values1
	movapd	xmm2, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm2, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm0, [edx+2*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm0, xmm2		;; Mul by fudged col two-to-minus-phi
echk	brute_force_error_check xmm0, xmm4, xmm6
const	brute_force_mul_by_const xmm0, xmm4
	movapd	xmm1, [esi+3*16]	;; Load values2
	addpd	xmm7, xmm1		;; sumout += values2
	movapd	xmm3, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm3, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm1, [edx+3*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm1, xmm3		;; Mul by fudged col two-to-minus-phi
echk	brute_force_error_check xmm1, xmm5, xmm6
const	brute_force_mul_by_const xmm1, xmm5
	addpd	xmm0, [ebp+2*16]	;; x1 = values + carry
	addpd	xmm1, [ebp+3*16]	;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y2 = top bits of x
const	addpd	xmm4, xmm2		;; Add in upper mul-by-const bits
const	mulpd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const movapd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
no const mulpd	xmm4, xmm2		;; next carry = shifted y1
	subpd	xmm2, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
const	addpd	xmm5, xmm3		;; Add in upper mul-by-const bits
const	mulpd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const movapd	xmm5, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y2
no const mulpd	xmm5, xmm3		;; next carry = shifted y2
	subpd	xmm3, XMM_LIMIT_BIGMAX[ecx];; z2 = y2 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm2		;; rounded value = x1 - z1
	subpd	xmm1, xmm3		;; rounded value = x2 - z2
ttp	movapd	xmm2, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [edx+2*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm2		;; new value1 *= fudged col two-to-phi
zero	xorpd	xmm0, xmm0
	movapd	[esi+2*16], xmm0	;; Save new value1
	movapd	[ebp+2*16], xmm4	;; Save carry
ttp	movapd	xmm3, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm1, [edx+3*32+16]	;; new value2 = val * grp two-to-phi
ttp	mulpd	xmm1, xmm3		;; new value2 *= fudged col two-to-phi
zero	xorpd	xmm1, xmm1
	movapd	[esi+3*16], xmm1	;; Save new value2
	movapd	[ebp+3*16], xmm5	;; Save carry
	ENDM

;; NOTE: We'd rather store the high FFT carry without the XMM_BIGVAL added in,
;; but there is too much code that expects this (like add and subtract).

xnorm_2d_zpad MACRO ttp, echk, const
ttp	mov	al, [edi]		;; Load big vs. little flags
	movapd	xmm0, [esi]		;; Load values1
	addpd	xmm7, xmm0		;; sumout += values1
	movapd	xmm2, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm2, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm0, [edx+0*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm0, xmm2		;; Mul by fudged col two-to-minus-phi

	movapd	xmm3, [ebp+2*16]	;; Add in previous high FFT data
	subpd	xmm3, XMM_BIGVAL	;; Yuk.
	addpd	xmm0, xmm3

	movapd	xmm3, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm3, xmm0		;; Round to multiple of big word
	subpd	xmm3, XMM_BIGBIGVAL

	movapd	xmm4, XMM_BIGVAL	;; Round to an integer
	addpd	xmm4, xmm0
	subpd	xmm4, XMM_BIGVAL

echk	subpd	xmm0, xmm4		;; This is the convolution error
echk	andpd	xmm0, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm0		;; Compute maximum error

	subpd	xmm4, xmm3		;; xmm4 now contains low bigword bits

	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; Saved shifted FFT hi data
	addpd	xmm3, XMM_BIGVAL	;; Yuk.
	movapd	[ebp+2*16], xmm3

no const movapd	xmm0, XMM_K_LO
const	movapd	xmm0, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm0, xmm4

no const mulpd	xmm4, XMM_K_HI
const	mulpd	xmm4, XMM_K_TIMES_MULCONST_HI

	addpd	xmm0, [ebp+0*16]	;; x1 = values + carry

	movapd	xmm1, [esi+2*16]	;; Load values2
	addpd	xmm7, xmm1		;; sumout += values2
	movapd	xmm2, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm2, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm1, [edx+2*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm1, xmm2		;; Mul by fudged col two-to-minus-phi

	movapd	xmm5, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm5, xmm1		;; Round to multiple of big word
	subpd	xmm5, XMM_BIGBIGVAL	;; 

	movapd	xmm2, XMM_BIGVAL	;; Round to an integer
	addpd	xmm2, xmm1
	subpd	xmm2, XMM_BIGVAL

echk	subpd	xmm1, xmm2		;; This is the convolution error
echk	andpd	xmm1, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm1		;; Compute maximum error

	subpd	xmm2, xmm5		;; xmm2 now contains low bigword bits

no const mulpd	xmm2, XMM_MINUS_CARG
const	mulpd	xmm2, XMM_MINUS_CARG_TIMES_MULCONST
no const mulpd	xmm5, XMM_MINUS_CARG
const	mulpd	xmm5, XMM_MINUS_CARG_TIMES_MULCONST

	addpd	xmm0, xmm2		;; Add upper FFT word to lower FFT word
	addpd	xmm4, xmm5		;; Add upper FFT word to lower FFT word

	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	addpd	xmm4, xmm2		;; Add in upper mul-by-const bits
	mulpd	xmm4, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm2, XMM_LIMIT_BIGMAX[eax];; z1 = y1 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm2		;; rounded value = x1 - z1
ttp	movapd	xmm5, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm5, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [edx+0*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm5		;; new value1 *= fudged col two-to-phi
	movapd	[ebp+0*16], xmm4	;; Save carry
	movapd	[esi], xmm0		;; Save new value1

ttp	mov	al, [edi+1]		;; Load big vs. little flags
	movapd	xmm5, [esi+16]		;; Load values1
	addpd	xmm7, xmm5		;; sumout += values1
	movapd	xmm3, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm3, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm5, [edx+1*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm5, xmm3		;; Mul by fudged col two-to-minus-phi

	movapd	xmm3, [ebp+3*16]	;; Add in previous high FFT data
	subpd	xmm3, XMM_BIGVAL	;; Yuk.
	addpd	xmm5, xmm3

	movapd	xmm3, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm3, xmm5		;; Round to multiple of big word
	subpd	xmm3, XMM_BIGBIGVAL

	movapd	xmm2, XMM_BIGVAL	;; Round to an integer
	addpd	xmm2, xmm5
	subpd	xmm2, XMM_BIGVAL

echk	subpd	xmm5, xmm2		;; This is the convolution error
echk	andpd	xmm5, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm5		;; Compute maximum error

	subpd	xmm2, xmm3		;; xmm2 now contains low bigword bits

	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; Saved shifted FFT hi data
	addpd	xmm3, XMM_BIGVAL	;; Yuk.
	movapd	[ebp+3*16], xmm3

no const movapd	xmm0, XMM_K_LO
const	movapd	xmm0, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm0, xmm2

no const mulpd	xmm2, XMM_K_HI
const	mulpd	xmm2, XMM_K_TIMES_MULCONST_HI

	addpd	xmm0, [ebp+1*16]	;; x2 = values + carry

	movapd	xmm1, [esi+3*16]	;; Load high values2
	addpd	xmm7, xmm1		;; sumout += values2
	movapd	xmm5, [ebx]		;; col two-to-minus-phi
ttp	mulpd	xmm5, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
ttp	mulpd	xmm1, [edx+3*32]	;; Mul by grp two-to-minus-phi
	mulpd	xmm1, xmm5		;; Mul by fudged col two-to-minus-phi

	movapd	xmm5, XMM_BIGBIGVAL	;; Big word rounding constant
	addpd	xmm5, xmm1		;; Round to multiple of big word
	subpd	xmm5, XMM_BIGBIGVAL	;; 

	movapd	xmm4, XMM_BIGVAL	;; Round to an integer
	addpd	xmm4, xmm1
	subpd	xmm4, XMM_BIGVAL

echk	subpd	xmm1, xmm4		;; This is the convolution error
echk	andpd	xmm1, XMM_ABSVAL	;; Compute absolute value
echk	maxpd	xmm6, xmm1		;; Compute maximum error

	subpd	xmm4, xmm5		;; xmm4 now contains low bigword bits

no const mulpd	xmm4, XMM_MINUS_CARG
const	mulpd	xmm4, XMM_MINUS_CARG_TIMES_MULCONST
no const mulpd	xmm5, XMM_MINUS_CARG
const	mulpd	xmm5, XMM_MINUS_CARG_TIMES_MULCONST

	addpd	xmm0, xmm4		;; Add upper FFT word to lower FFT word
	addpd	xmm2, xmm5		;; Add upper FFT word to lower FFT word

	movapd	xmm4, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm4, xmm0		;; y2 = top bits of x
	addpd	xmm2, xmm4		;; Add in upper mul-by-const bits
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	subpd	xmm4, XMM_LIMIT_BIGMAX[eax];; z2 = y2 - (maximum*BIGVAL-BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x2 - z2
ttp	movapd	xmm3, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [edx+1*32+16]	;; new value2 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm3		;; new value2 *= fudged col two-to-phi
	movapd	[ebp+1*16], xmm2	;; Save carry
	movapd	[esi+1*16], xmm0	;; Save new value2

	subpd	xmm1, xmm1		;; new high values = zero
	movapd	[esi+2*16], xmm1	;; Zero high value1
	movapd	[esi+3*16], xmm1	;; Zero high value2
	ENDM


; *************** Top carry adjust macro ******************
; This macro corrects the carry out of the topmost word when k is not 1.
; The problem is the top carry is from 2^ceil(log2(k)+n) rather than at k*2^n.
; So we recompute the top carry by multiplying by 2^ceil(log2(k)) and then
; dividing by k.  The integer part is the new carry and the remainder is
; added back to the top word or two.

; The single-pass case, the top carry is in high word of xmm3
xnorm_top_carry_1d MACRO
	xnorm_top_carry_cmn esi, xmm3, 0
	ENDM

; The multi-pass case.  The top carry is loaded into xmm7 from the
; carries array.
xnorm_top_carry MACRO
	xnorm_top_carry_cmn esi, xmm7, 1
	ENDM

xnorm_top_carry_cmn MACRO srcreg, xreg, twopass
	LOCAL	kok
	cmp	_TOP_CARRY_NEEDS_ADJUSTING, 1 ;; Does top carry need work?
	jne	kok			;; Skip this code if K is 1

	IF twopass EQ 1			;; Two pass case - load the carry
	mov	edi, carries		;; Addr of the carries
	mov	eax, addcount1		;; Load count of carry rows
	shl	eax, 6			;; Compute addr of the high carries
	add	edi, eax
	_movsd	xreg, [edi-8]		;; Load very last carry
	ENDIF

	subsd	xreg, XMM_BIGVAL	;; Convert carry from int+BIGVAL state
	_movsd	xmm0, _CARRY_ADJUST1	;; Mul by 2^ceil(log2(k))
	mulsd	xmm0, xreg
	_movsd	xreg, _INVERSE_KARG	;; Divide by k
	mulsd	xreg, xmm0
	addsd	xreg, XMM_BIGVAL	;; Integer part of carry over k
	subsd	xreg, XMM_BIGVAL
	_movsd	xmm1, _KARG_HI		;; Calculate remainder (very carefully)
	mulsd	xmm1, xreg
	subsd	xmm0, xmm1
	_movsd	xmm1, _KARG_LO
	mulsd	xmm1, xreg
	subsd	xmm0, xmm1
	mulsd	xmm0, _CARRY_ADJUST2	;; Shift remainder
	_movsd	xmm1, XMM_BIGVAL	;; Integer part of shifted remainder
	addsd	xmm1, xmm0
	subsd	xmm1, XMM_BIGVAL
	subsd	xmm0, xmm1		;; Fractional part of shifted remainder
	mulsd	xmm1, _CARRY_ADJUST3	;; Weight integer part

	IF twopass EQ 1			;; Two pass scratch area case
	mov	eax, _HIGH_SCRATCH1_OFFSET ;; Add integer part to top word
	addsd	xmm1, [srcreg][eax]
	_movsd	[srcreg][eax], xmm1
	mulsd	xmm0, _CARRY_ADJUST4	;; Shift and weight fractional part
	mov	eax, _HIGH_SCRATCH2_OFFSET ;; Add fractional part to top-1 word
	addsd	xmm0, [srcreg][eax]
	_movsd	[srcreg][eax], xmm0
	ENDIF

	IF twopass EQ 2			;; Two pass FFT data case
	mov	eax, _HIGH_WORD1_OFFSET ;; Add integer part to top word
	addsd	xmm1, [srcreg][eax]
	_movsd	[srcreg][eax], xmm1
	mulsd	xmm0, _CARRY_ADJUST4	;; Shift and weight fractional part
	mov	eax, _HIGH_WORD2_OFFSET ;; Add fractional part to top-1 word
	addsd	xmm0, [srcreg][eax]
	_movsd	[srcreg][eax], xmm0
	ENDIF

	IF twopass EQ 0			;; Single pass case
	mov	eax, _HIGH_WORD1_OFFSET	;; Add integer part to top word
	addsd	xmm1, [srcreg][eax]
	_movsd	[srcreg][eax], xmm1
	mulsd	xmm0, _CARRY_ADJUST4	;; Shift fractional part
	_movsd	xmm1, XMM_BIGVAL	;; Integer part of shifted fractional
	addsd	xmm1, xmm0
	subsd	xmm1, XMM_BIGVAL
	subsd	xmm0, xmm1		;; Fractional part
	mulsd	xmm1, _CARRY_ADJUST5	;; Weight integer part
	mov	eax, _HIGH_WORD2_OFFSET	;; Add fractional part to top-1 word
	addsd	xmm1, [srcreg][eax]
	_movsd	[srcreg][eax], xmm1
	mulsd	xmm0, _CARRY_ADJUST6	;; Shift and weight fractional part
	mov	eax, _HIGH_WORD3_OFFSET	;; Add fractional part to top-2 word
	addsd	xmm0, [srcreg][eax]
	_movsd	[srcreg][eax], xmm0
	ENDIF

	addsd	xreg, XMM_BIGVAL	;; Restore carry to int+BIGVAL state

	IF twopass EQ 1
	_movsd	[edi-8], xreg		;; Save very last carry
	ENDIF
kok:
	ENDM

; *************** 2D followup macro ******************
; This macro finishes the normalize process by adding the final carries
; back into the appropriate FFT values.
; esi = pointer to carries
; ebp = pointer to FFT data
; edi = pointer to big/little flags
; ebx = pointer two-to-power column multipliers
; edx = pointer two-to-power group multipliers
; ecx = big vs. little word flag #2
; eax = big vs. little word flag #1

xnorm012_2d_part1 MACRO
	_movsd	xmm6, [ebx-40]		;; Load 2 carries from last row
	_movsd	xmm7, [ebx-8]		;; Second carry is very last carry
	subsd	xmm7, XMM_BIGVAL
	mulsd	xmm7, XMM_MINUS_CARG	;; Negate the carry
	addsd	xmm7, XMM_BIGVAL
	ENDM
xnorm012_2d_part2 MACRO
	_movsd	xmm0, xmm7		; Copy 2 carries from prev section
	_movsd	xmm2, xmm6
	_movsd	xmm1, [ebx-56]		; Load 2 carries from end this section
	_movsd	xmm3, [ebx-24]
	_movsd	xmm6, [ebx-8]		; Remember 2 carries for next section
	_movsd	xmm7, [ebx-40]
	ENDM
xnorm012_2d MACRO
	LOCAL	hard, done

	;; If k or c is more than one, then there will be fewer bits-per-word.
	;; This means the carry may need to be spread over 4 words instead
	;; of just 2.

	cmp	_SPREAD_CARRY_OVER_4_WORDS, 1;; Are there few bits per word?
	je	hard			;; Yes, go do it the hard way

	mov	al, [edi+0]		;; Load big vs. little flag
	mov	cl, [edi+4]
	movhpd	xmm0, [esi+0*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [edx+0*32+16]	;; mul by grp two-to-phi
	mulpd	xmm4, xmm0		;; low carry *= two-to-phi
	_movsd	xmm0, [esi+0*16+8]	;; Load carry for next row
	addpd	xmm4, [ebp+0*16]	;; Add low carry and FFT data
	movapd	[ebp+0*16], xmm4	;; Save FFT data
	movapd	xmm4, [ebx+48]		;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+0*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+4*16]	;; Add high carry and FFT data
	movapd	[ebp+4*16], xmm5	;; Save FFT data

	mov	al, [edi+1]		;; Load big vs. little flag
	mov	cl, [edi+5]
	movhpd	xmm1, [esi+1*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [edx+1*32+16]	;; mul by grp two-to-phi
	mulpd	xmm4, xmm1		;; low carry *= two-to-phi
	_movsd	xmm1, [esi+1*16+8]	;; Load carry for next row
	addpd	xmm4, [ebp+1*16]	;; Add low carry and FFT data
	movapd	[ebp+1*16], xmm4	;; Save FFT data
	movapd	xmm4, [ebx+48]		;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+1*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+5*16]	;; Add high carry and FFT data
	movapd	[ebp+5*16], xmm5	;; Save FFT data

	;; If we are zeroing the high words, we skip adding the carries
	;; into the high words.

	cmp	zero_fft, 1		;; Are we zeroing high words?
	je	done			;; Yes, skip high words

	mov	al, [edi+2]		;; Load big vs. little flag
	mov	cl, [edi+6]
	movhpd	xmm2, [esi+2*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm2		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm2, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [edx+2*32+16]	;; mul by grp two-to-phi
	mulpd	xmm4, xmm2		;; low carry *= two-to-phi
	_movsd	xmm2, [esi+2*16+8]	;; Load carry for next row
	addpd	xmm4, [ebp+2*16]	;; Add low carry and FFT data
	movapd	[ebp+2*16], xmm4	;; Save FFT data
	movapd	xmm4, [ebx+48]		;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+2*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+6*16]	;; Add high carry and FFT data
	movapd	[ebp+6*16], xmm5	;; Save FFT data

	mov	al, [edi+3]		;; Load big vs. little flag
	mov	cl, [edi+7]
	movhpd	xmm3, [esi+3*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm3		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm3, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [edx+3*32+16]	;; mul by grp two-to-phi
	mulpd	xmm4, xmm3		;; low carry *= two-to-phi
	_movsd	xmm3, [esi+3*16+8]	;; Load carry for next row
	addpd	xmm4, [ebp+3*16]	;; Add low carry and FFT data
	movapd	[ebp+3*16], xmm4	;; Save FFT data
	movapd	xmm4, [ebx+48]		;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+3*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+7*16]	;; Add high carry and FFT data
	movapd	[ebp+7*16], xmm5	;; Save FFT data
	jmp	done

;; Same as above, but spread carry over 4 words

hard:	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently

	mov	al, [edi+0]		;; Load big vs. little flag
	movhpd	xmm0, [esi+0*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	addpd	xmm0, [ebp+0*16]	;; Add low carry and FFT data
	movapd	[ebp+0*16], xmm0	;; Save FFT data

	mov	al, [edi+4]		;; Load big vs. little flag
	movapd	xmm0, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm0, xmm5		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm0		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm5, xmm4		;; low carry = x1 - z1
	mulpd	xmm0, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+0*32+16]	;; mul by grp two-to-phi
	mulpd	xmm5, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm5, [ebp+4*16]	;; Add low carry and FFT data
	movapd	[ebp+4*16], xmm5	;; Save FFT data

	mov	al, [edi+ecx]		;; Load big vs. little flag
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	mulpd	xmm0, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm0, [ebp+8*16]	;; Add low carry and FFT data
	movapd	[ebp+8*16], xmm0	;; Save FFT data

	mov	al, [edi+ecx+4]
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+0*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+12*16]	;; Add high carry and FFT data
	movapd	[ebp+12*16], xmm5	;; Save FFT data
	_movsd	xmm0, [esi+0*16+8]	;; Load carry for next row


	mov	al, [edi+1]		;; Load big vs. little flag
	movhpd	xmm1, [esi+1*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	addpd	xmm1, [ebp+1*16]	;; Add low carry and FFT data
	movapd	[ebp+1*16], xmm1	;; Save FFT data

	mov	al, [edi+5]		;; Load big vs. little flag
	movapd	xmm1, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm1, xmm5		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm1		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm5, xmm4		;; low carry = x1 - z1
	mulpd	xmm1, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+1*32+16]	;; mul by grp two-to-phi
	mulpd	xmm5, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm5, [ebp+5*16]	;; Add low carry and FFT data
	movapd	[ebp+5*16], xmm5	;; Save FFT data

	mov	al, [edi+ecx+1]		;; Load big vs. little flag
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	mulpd	xmm1, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm1, [ebp+9*16]	;; Add low carry and FFT data
	movapd	[ebp+9*16], xmm1	;; Save FFT data

	mov	al, [edi+ecx+5]
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+1*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+13*16]	;; Add high carry and FFT data
	movapd	[ebp+13*16], xmm5	;; Save FFT data
	_movsd	xmm1, [esi+1*16+8]	;; Load carry for next row


	mov	al, [edi+2]		;; Load big vs. little flag
	movhpd	xmm2, [esi+2*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm2		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm2, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	mulpd	xmm2, [edx+2*32+16]	;; mul by grp two-to-phi
	addpd	xmm2, [ebp+2*16]	;; Add low carry and FFT data
	movapd	[ebp+2*16], xmm2	;; Save FFT data

	mov	al, [edi+6]		;; Load big vs. little flag
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm5		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm5, xmm4		;; low carry = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+2*32+16]	;; mul by grp two-to-phi
	mulpd	xmm5, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm5, [ebp+6*16]	;; Add low carry and FFT data
	movapd	[ebp+6*16], xmm5	;; Save FFT data

	mov	al, [edi+ecx+2]		;; Load big vs. little flag
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm2		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm2, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm2, [edx+2*32+16]	;; mul by grp two-to-phi
	mulpd	xmm2, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm2, [ebp+10*16]	;; Add low carry and FFT data
	movapd	[ebp+10*16], xmm2	;; Save FFT data

	mov	al, [edi+ecx+6]
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+2*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+14*16]	;; Add high carry and FFT data
	movapd	[ebp+14*16], xmm5	;; Save FFT data
	_movsd	xmm2, [esi+2*16+8]	;; Load carry for next row


	mov	al, [edi+3]		;; Load big vs. little flag
	movhpd	xmm3, [esi+3*16]	;; Load high word of carry XMM reg
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm3		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm3, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	mulpd	xmm3, [edx+3*32+16]	;; mul by grp two-to-phi
	addpd	xmm3, [ebp+3*16]	;; Add low carry and FFT data
	movapd	[ebp+3*16], xmm3	;; Save FFT data

	mov	al, [edi+7]		;; Load big vs. little flag
	movapd	xmm3, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm5		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm5, xmm4		;; low carry = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+3*32+16]	;; mul by grp two-to-phi
	mulpd	xmm5, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm5, [ebp+7*16]	;; Add low carry and FFT data
	movapd	[ebp+7*16], xmm5	;; Save FFT data

	mov	al, [edi+ecx+3]		;; Load big vs. little flag
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm3		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm3, xmm4		;; low carry = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; high carry = shifted y1
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm3, [edx+3*32+16]	;; mul by grp two-to-phi
	mulpd	xmm3, xmm4		;; mul by fudged col two-to-phi
	addpd	xmm3, [ebp+11*16]	;; Add low carry and FFT data
	movapd	[ebp+11*16], xmm3	;; Save FFT data

	mov	al, [edi+ecx+7]
	subpd	xmm5, XMM_BIGVAL
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, [edx+3*32+16]	;; high carry *= grp two-to-phi
	mulpd	xmm5, xmm4		;; high carry *= fudged col two-to-phi
	addpd	xmm5, [ebp+15*16]	;; Add high carry and FFT data
	movapd	[ebp+15*16], xmm5	;; Save FFT data
	_movsd	xmm3, [esi+3*16+8]	;; Load carry for next row

done:	movapd	xmm4, XMM_BIGVAL
	movapd	[esi+0*16], xmm4	;; Clear carry
	movapd	[esi+1*16], xmm4
	movapd	[esi+2*16], xmm4
	movapd	[esi+3*16], xmm4
	ENDM


;; Significantly different cleanup code for zero-padded FFTs.
;; Note: The group multiplier should be 1.0 for the bottom FFT words and
;; the FFT words just above the half-way point.

xnorm012_2d_zpad_part1 MACRO const
	LOCAL	smallk, mediumk, div_k_done

	_movsd	xmm2, [ebx-40]		;; Load 2 carries from last row
	_movsd	xmm3, [ebx-8]		;; Second carry is very last carry

	;; Strip BIGVAL from the traditional carry, we'll add the traditional
	;; carry in later when we are working on the ZPAD0 - ZPAD6 values.
	subsd	xmm2, XMM_BIGVAL	;; Integerize traditional carry

	;; Rather than calculate high FFT carry times k and then later dividing
	;; by k, we multiply FFT high carry by const and we'll add it
	;; to the lower FFT data later (after multiplying by -CARG).  First
	;; strip off the XMM_BIGVAL.
	subsd	xmm3, XMM_BIGVAL
const	mulsd	xmm3, XMM_MULCONST

	;; Multiply ZPAD0 through ZPAD6 by const * -CARG.  This, in essense,
	;; wraps this data from above the FFT data area to the halfway point.
	;; Later on we'll divide this by K to decide which data needs wrapping
	;; all the way down to the bottom of the FFT data.

	;; NOTE that ZPAD0's column multiplier is 1.0.  Also, ZPAD6 will not
	;; be bigger than a big word.  We must be careful to handle CARG's up
	;; to about 30 bits

	mov	al, [edi]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD0		;; Load values1
	addsd	xmm0, _ADDIN_VALUE	;; Add in the requested value
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm2		;; Add in traditional carry
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD0, xmm0

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD1		;; Load values1
	mulsd	xmm0, [ebp+32]		;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD1, xmm0

	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD2		;; Load values1
	mulsd	xmm0, [ebp+2*32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD2, xmm0

	mov	al, [edi+ecx+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD3		;; Load values1
	mulsd	xmm0, [ebp+3*32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD3, xmm0

	mov	ecx, _BIGLIT_INCR4	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD4		;; Load values1
	mulsd	xmm0, [ebp+4*32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm1, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm1, xmm0		;; Round to multiple of big word
	subsd	xmm1, XMM_BIGBIGVAL
	subsd	xmm0, xmm1		;; xmm0 now contains low bigword bits
	mulsd	xmm1, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD4, xmm0

	mov	al, [edi+ecx+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_ZPAD5		;; Load values1
	mulsd	xmm0, [ebp+5*32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm2, xmm0		;; Round to multiple of big word
	subsd	xmm2, XMM_BIGBIGVAL
	subsd	xmm0, xmm2		;; xmm0 now contains low bigword bits
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; Saved shifted high ZPAD data
	addsd	xmm0, xmm1		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	xmm4, XMM_BIGBIGVAL	;; Big word rounding constant
	addsd	xmm4, xmm0		;; Round to multiple of big word
	subsd	xmm4, XMM_BIGBIGVAL
	subsd	xmm0, xmm4		;; xmm0 now contains low bigword bits
	mulsd	xmm4, XMM_LIMIT_INVERSE[eax];; Shift high ZPAD data
	_movsd	XMM_ZPAD5, xmm0

	_movsd	xmm0, XMM_ZPAD6		;; Load values1
	mulsd	xmm0, [ebp+6*32]	;; Mul values1 by two-to-minus-phi
	mulsd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, XMM_BIGVAL	;; Round to an integer
	subsd	xmm0, XMM_BIGVAL
	addsd	xmm0, xmm2		;; Add in shifted high ZPAD data
no const mulsd	xmm0, XMM_MINUS_CARG
const	mulsd	xmm0, XMM_MINUS_CARG_TIMES_MULCONST
	addsd	xmm0, xmm4		;; Add in high part of last calculation
	_movsd	XMM_ZPAD6, xmm0

	;; Divide the zpad data by k.  Store the integer part in XMM_TMP
	;; and the remainder in XMM_ZPAD0.  Later we will wrap the integer part
	;; down to the bottom of the FFT data area (and multiply by -CARG).
	;; And we will store the remainder in the upper half of the FFT
	;; data area.

	;; Note there are three cases to handle.  K is smaller than a big word.
	;; K is between one and 2 big words in size.  And K is more than
	;; 2 big words in size.

	cmp	_ZPAD_TYPE, 2		;; Are we dealing with case 1,2,or 3
	jl	smallk			;; One word case
	je	mediumk			;; Two word case

	;; This case does the divide by k where k is three words

	_movsd	xmm0, XMM_ZPAD6		;; Load zpad word (high bits)
	_movsd	xmm1, XMM_ZPAD5		;; Load zpad word (middle bits)
	_movsd	xmm2, XMM_ZPAD4		;; Load zpad word (low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K6	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K6_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K6_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K6_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP5, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT6	;; Shift previous zpad word
	addsd	xmm1, xmm0		;; Add to create new high zpad bits
	_movsd	xmm0, XMM_ZPAD3		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT5	;; Combine high and medium bits
	mulsd	xmm5, xmm1
	addsd	xmm5, xmm2
	_movsd	xmm4, _ZPAD_INVERSE_K5	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K5_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K5_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K5_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP4, xmm4		;; Save word of zpad / k

	mulsd	xmm1, _ZPAD_SHIFT5	;; Shift previous zpad word
	addsd	xmm2, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD2		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT4	;; Combine high and medium bits
	mulsd	xmm5, xmm2
	addsd	xmm5, xmm0
	_movsd	xmm4, _ZPAD_INVERSE_K4	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K4_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K4_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K4_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP3, xmm4		;; Save word of zpad / k

	mulsd	xmm2, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, xmm2		;; Add to create new high zpad bits
	_movsd	xmm2, XMM_ZPAD1		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT3	;; Combine high and medium bits
	mulsd	xmm5, xmm0
	addsd	xmm5, xmm1
	_movsd	xmm4, _ZPAD_INVERSE_K3	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K3_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K3_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K3_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP2, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm1, xmm0		;; Add to create new high zpad bits
	_movsd	xmm0, XMM_ZPAD0		;; Load zpad word (new low bits)
	_movsd	xmm5, _ZPAD_SHIFT2	;; Combine high and medium bits
	mulsd	xmm5, xmm1
	addsd	xmm5, xmm2
	_movsd	xmm4, _ZPAD_INVERSE_K2	;; Load shifted 1/k
	mulsd	xmm4, xmm5		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K2_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K2_MID	;; Load middle bits of k
	mulsd	xmm5, xmm4
	subsd	xmm2, xmm5		;; Calculate middle bits of remainder
	_movsd	xmm5, _ZPAD_K2_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP1, xmm4		;; Save word of zpad / k

	mulsd	xmm1, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm2, xmm1		;; Add to create new high zpad bits
	mulsd	xmm2, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, xmm2		;; Add to create new high zpad bits
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder of zpad / k

	subsd	xmm1, xmm1		;; Zero words that other cases set
	_movsd	XMM_TMP6, xmm1
	
	jmp	div_k_done

	;; This case does the divide by k where k is two words
mediumk:
	_movsd	xmm0, XMM_ZPAD6		;; Load zpad word (high bits)
	_movsd	xmm1, XMM_ZPAD5		;; Load zpad word (low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K6	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K6_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K6_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP6, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT6	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD4		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K5	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K5_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K5_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP5, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT5	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD3		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K4	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K4_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K4_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP4, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD2		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K3	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K3_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K3_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP3, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD1		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K2	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K2_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K2_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP2, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	xmm1, XMM_ZPAD0		;; Load zpad word (new low bits)
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load shifted 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD by shifted 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer
	subsd	xmm4, XMM_BIGVAL
	_movsd	xmm5, _ZPAD_K1_HI	;; Load high bits of k
	mulsd	xmm5, xmm4
	subsd	xmm0, xmm5		;; Calculate high bits of remainder
	_movsd	xmm5, _ZPAD_K1_LO	;; Load low bits of k
	mulsd	xmm5, xmm4
	subsd	xmm1, xmm5		;; Calculate low bits of remainder
	_movsd	XMM_TMP1, xmm4		;; Save word of zpad / k

	mulsd	xmm0, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, xmm1		;; Add to create new high zpad bits
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder of zpad / k

	jmp	div_k_done

	;; This case does the divide by k where k is one word
	;; Assume ZPAD5 and ZPAD6 are zero.
smallk:	_movsd	xmm0, XMM_ZPAD4		;; Load zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP5, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT4	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD3		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP4, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT3	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD2		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP3, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT2	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD1		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP2, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4

	mulsd	xmm0, _ZPAD_SHIFT1	;; Shift previous zpad word
	addsd	xmm0, XMM_ZPAD0		;; Add in zpad data
	_movsd	xmm4, _ZPAD_INVERSE_K1	;; Load by 1/k
	mulsd	xmm4, xmm0		;; Mul ZPAD data by 1/k
	addsd	xmm4, XMM_BIGVAL	;; Round to integer	
	subsd	xmm4, XMM_BIGVAL
	_movsd	XMM_TMP1, xmm4		;; Save integer part
	mulsd	xmm4, _ZPAD_K1_LO	;; Compute remainder
	subsd	xmm0, xmm4
	_movsd	XMM_ZPAD0, xmm0		;; Save remainder

	subsd	xmm1, xmm1		;; Zero words that other cases set
	_movsd	XMM_TMP6, xmm1
	
div_k_done:

	;; Now normalize the data above the halfway point.  Remember that the
	;; column two-to-phi multiplier for the first value will be 1.0.

	mov	al, [edi]		;; First word 
	_movsd	xmm0, XMM_ZPAD0		;; Load remainder of divide by k
	addsd	xmm0, XMM_BIGVAL
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	_movsd	[esi+0*64+32], xmm0	;; Save value1

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm0, xmm2		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm0		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm2, xmm4		;; rounded value = x2 - z2
	mulsd	xmm0, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	mulsd	xmm2, [ebp+1*32+16]	;; new value2 = val * two-to-phi
	_movsd	[esi+1*64+32], xmm2	;; Save value2

	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flags
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y3 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z3 = y3-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x3 - z3
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y3
	mulsd	xmm0, [ebp+2*32+16]	;; new value3 = val * two-to-phi
	_movsd	[esi+2*64+32], xmm0	;; Save value3

	subsd	xmm2, XMM_BIGVAL	;; Remove integer rounding constant
	mulsd	xmm2, [ebp+3*32+16]	;; value4 = carry * two-to-phi
	_movsd	[esi+3*64+32], xmm2	;; Save new value4

	;; Mul the integer part of (ZPAD data divided by k) by -CARG in
	;; preparation for adding it into the lower FFT data area.
	;; Also add in the shifted high FFT carry at this time.

	;; Now add in and normalize the bottom FFT data.  Remember that the
	;; column two-to-phi multiplier for the first value will be 1.0.  We 
	;; must go 6 words deep in case k is 48-50 bits and CARG is 32 bits.

	mov	al, [edi]		;; First word 
	_movsd	xmm0, XMM_TMP1		;; Load remainder of divide by k
	addsd	xmm0, xmm3		;; Add in shifted high FFT carry
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	addsd	xmm0, XMM_BIGVAL
	addsd	xmm0, [esi+0*64]	;; Add in the FFT data
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y1 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x1 - z1
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	_movsd	[esi+0*64], xmm0	;; Save value1

	mov	al, [edi+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP2		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+1*64]	;; Load FFT data
	mulsd	xmm1, [ebp+1*32]	;; Mul values2 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x2 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y2 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x2 - z2
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
	mulsd	xmm0, [ebp+1*32+16]	;; new value2 = val * two-to-phi
	_movsd	[esi+1*64], xmm0	;; Save value2

	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP3		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+2*64]	;; Load FFT data
	mulsd	xmm1, [ebp+2*32]	;; Mul values3 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x3 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y3 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z3 = y3-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x3 - z3
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y3
	mulsd	xmm0, [ebp+2*32+16]	;; new value3 = val * two-to-phi
	_movsd	[esi+2*64], xmm0	;; Save value3

	mov	al, [edi+ecx+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP4		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+3*64]	;; Load FFT data
	mulsd	xmm1, [ebp+3*32]	;; Mul values4 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x4 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y4 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z4 = y4-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x4 - z4
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y4
	mulsd	xmm0, [ebp+3*32+16]	;; new value4 = val * two-to-phi
	_movsd	[esi+3*64], xmm0	;; Save value4

	mov	ecx, _BIGLIT_INCR4	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP5		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+4*64]	;; Load FFT data
	mulsd	xmm1, [ebp+4*32]	;; Mul values4 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x4 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y4 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z4 = y4-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x4 - z4
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y4
	mulsd	xmm0, [ebp+4*32+16]	;; new value4 = val * two-to-phi
	_movsd	[esi+4*64], xmm0	;; Save value4

	mov	al, [edi+ecx+4]		;; Load big vs. little flags
	_movsd	xmm0, XMM_TMP6		;; Load remainder of divide by k
	mulsd	xmm0, XMM_MINUS_CARG	;; Mul by -CARG
	_movsd	xmm1, [esi+5*64]	;; Load FFT data
	mulsd	xmm1, [ebp+5*32]	;; Mul values5 by two-to-minus-phi
	mulsd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addsd	xmm0, xmm1		;; Add in the FFT data
	addsd	xmm0, xmm2		;; x5 = value + carry
	_movsd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addsd	xmm2, xmm0		;; y5 = top bits of x
	_movsd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addsd	xmm4, xmm2		;; z5 = y5-(maximum * BIGVAL - BIGVAL)
	subsd	xmm0, xmm4		;; rounded value = x5 - z5
	mulsd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y5
	mulsd	xmm0, [ebp+5*32+16]	;; new value5 = val * two-to-phi
	_movsd	[esi+5*64], xmm0	;; Save value5

	subsd	xmm2, XMM_BIGVAL	;; Remove rounding constant
	mulsd	xmm2, [ebp+6*32+16]	;; new value6 = val * two-to-phi
	addsd	xmm2, [esi+6*64]	;; Add in FFT data
	_movsd	[esi+6*64], xmm2	;; Save value6

	_movsd	xmm6, XMM_BIGVAL	;; Clear 2 carries from last row
	_movsd	xmm7, XMM_BIGVAL
	ENDM
xnorm012_2d_zpad_part2 MACRO
	_movsd	xmm0, xmm7		; Copy 2 carries from prev section
	_movsd	xmm2, xmm6
	_movsd	xmm1, [ebx-56]		; Load 2 carries from end this section
	_movsd	xmm3, [ebx-24]
	_movsd	xmm6, [ebx-8]		; Remember 2 carries for next section
	_movsd	xmm7, [ebx-40]
	ENDM
xnorm012_2d_zpad MACRO const
	mov	al, [edi+0]		;; Load big vs. little flag
	movhpd	xmm0, [esi+0*16]	;; Load high word of carry XMM reg
	movhpd	xmm2, [esi+2*16]	;; Load high word of FFT hi data carry
	subpd	xmm2, XMM_BIGVAL	;; Yuk
	movapd	xmm4, [ebp+0*64]	;; Load FFT data
	mulpd	xmm4, [edx+0*32]	;; mul by grp two-to-minus-phi
	addpd	xmm0, xmm4		;; x1 = values1 + carry
no const movapd	xmm5, XMM_K_LO		;; Calc high FFT carry times k
const	movapd	xmm5, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm5, xmm2
	addpd	xmm0, xmm5		;; x1 = x1 + high_FFT_carry * k_lo
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; shift high_fft_carry
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	movapd	[ebp+0*64], xmm0	;; Save FFT data

no const movapd	xmm4, XMM_K_HI_1	;; Mul high_fft_carry by k_hi
const	movapd	xmm4, XMM_K_TIMES_MULCONST_HI_1
	mulpd	xmm4, xmm2
no const mulpd	xmm2, XMM_K_HI_2
const	mulpd	xmm2, XMM_K_TIMES_MULCONST_HI_2
	addpd	xmm5, xmm4		;; Carry += high_FFT_carry * lo(k_hi)

	mov	al, [edi+4]		;; Load big vs. little flag
	movapd	xmm0, [ebp+1*64]	;; Load FFT data
	mulpd	xmm0, [edx+0*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+1*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm0, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; x1 = x1 - z1
	addpd	xmm5, xmm2		;; Add in high_FFT_carry * hi(k_hi)
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+1*64], xmm0	;; Save FFT data

	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flag
	movapd	xmm0, [ebp+2*64]	;; Load FFT data
	mulpd	xmm0, [edx+0*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+2*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm0, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+2*64], xmm0	;; Save FFT data

	mov	al, [edi+ecx+4]		;; Load big vs. little flag
	movapd	xmm0, [ebp+3*64]	;; Load FFT data
	mulpd	xmm0, [edx+0*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+3*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm0, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm0		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm0, [edx+0*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm0, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+3*64], xmm0	;; Save FFT data

	mov	ecx, _BIGLIT_INCR4	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx]		;; Load big vs. little flag
	subpd	xmm5, XMM_BIGVAL	;; Remove rounding const from carry
	mulpd	xmm5, [edx+0*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+4*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, xmm4		;; data *= fudged col two-to-phi
	addpd	xmm5, [ebp+4*64]	;; Load FFT data
	movapd	[ebp+4*64], xmm5	;; Save FFT data

	_movsd	xmm0, [esi+0*16+8]	;; Load carry for next row
	_movsd	xmm2, [esi+2*16+8]	;; Load carry for next row


	mov	al, [edi+1]		;; Load big vs. little flag
	movhpd	xmm1, [esi+1*16]	;; Load high word of carry XMM reg
	movhpd	xmm3, [esi+3*16]	;; Load high word of FFT hi data carry
	subpd	xmm3, XMM_BIGVAL	;; Yuk
	movapd	xmm4, [ebp+0*64+16]	;; Load FFT data
	mulpd	xmm4, [edx+1*32]	;; mul by grp two-to-minus-phi
	addpd	xmm1, xmm4		;; x1 = values1 + carry
no const movapd	xmm5, XMM_K_LO		;; Calc high FFT carry times k
const	movapd	xmm5, XMM_K_TIMES_MULCONST_LO
	mulpd	xmm5, xmm3
	addpd	xmm1, xmm5		;; x1 = x1 + high_FFT_carry * k_lo
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; shift high_fft_carry
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	movapd	[ebp+0*64+16], xmm1	;; Save FFT data

no const movapd	xmm4, XMM_K_HI_1	;; Mul high_FFT_carry by k_hi
const	movapd	xmm4, XMM_K_TIMES_MULCONST_HI_1
	mulpd	xmm4, xmm3
no const mulpd	xmm3, XMM_K_HI_2
const	mulpd	xmm3, XMM_K_TIMES_MULCONST_HI_2
	addpd	xmm5, xmm4		;; Carry += high_FFT_carry * lo(k_hi)

	mov	al, [edi+5]		;; Load big vs. little flag
	movapd	xmm1, [ebp+1*64+16]	;; Load FFT data
	mulpd	xmm1, [edx+1*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+1*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm1, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; x1 = x1 - z1
	addpd	xmm5, xmm3		;; Add in high_FFT_carry * hi(k_hi)
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+1*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+1*64+16], xmm1	;; Save FFT data

	mov	ecx, _BIGLIT_INCR2	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx+1]		;; Load big vs. little flag
	movapd	xmm1, [ebp+2*64+16]	;; Load FFT data
	mulpd	xmm1, [edx+1*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+2*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm1, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+2*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+2*64+16], xmm1	;; Save FFT data

	mov	al, [edi+ecx+5]		;; Load big vs. little flag
	movapd	xmm1, [ebp+3*64+16]	;; Load FFT data
	mulpd	xmm1, [edx+1*32]	;; mul by grp two-to-minus-phi
	movapd	xmm4, [ebx+3*32]	;; col two-to-minus-phi
	mulpd	xmm4, XMM_TTMP_FUDGE[eax];; mul by fudge two-to-minus-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-minus-phi
	mulpd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm1, xmm5		;; x1 = values1 + carry
	movapd	xmm5, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm5, xmm1		;; y1 = top bits of carry
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm5		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm1, xmm4		;; x1 = x1 - z1
	mulpd	xmm5, XMM_LIMIT_INVERSE[eax];; carry = shifted y1
	mulpd	xmm1, [edx+1*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+3*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm1, xmm4		;; data *= fudged col two-to-phi
	movapd	[ebp+3*64+16], xmm1	;; Save FFT data

	mov	ecx, _BIGLIT_INCR4	;; Different clm values step through
					;; big/lit array differently
	mov	al, [edi+ecx+1]		;; Load big vs. little flag
	subpd	xmm5, XMM_BIGVAL	;; Remove rounding const from carry
	mulpd	xmm5, [edx+1*32+16]	;; mul by grp two-to-phi
	movapd	xmm4, [ebx+4*32+16]	;; col two-to-phi
	mulpd	xmm4, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
	mulpd	xmm5, xmm4		;; data *= fudged col two-to-phi
	addpd	xmm5, [ebp+4*64+16]	;; Load FFT data
	movapd	[ebp+4*64+16], xmm5	;; Save FFT data

	_movsd	xmm1, [esi+1*16+8]	;; Load carry for next row
	_movsd	xmm3, [esi+3*16+8]	;; Load carry for next row

	movapd	xmm4, XMM_BIGVAL
	movapd	[esi+0*16], xmm4	;; Clear carry
	movapd	[esi+1*16], xmm4
	movapd	[esi+2*16], xmm4
	movapd	[esi+3*16], xmm4
	ENDM


; *************** 1D normalized add/sub macro ******************
; This macro adds or subtracts, then "normalizes" eight FFT
; data values.  This involves multiplying the summed values by
; two-to-minus-phi.  Rounding the value to an integer.  Making sure
; the integer is smaller than the maximum allowable integer, generating
; a carry if necessary. Finally, the value is multiplied by two-to-phi
; and stored.
; xmm3 = carry #2
; xmm2 = carry #1
; ecx = pointer to the first number
; edx = pointer to the second number
; esi = pointer to destination
; ebp = pointer two-to-phi multipliers
; edi = pointer to array of big vs. little flags
; ebx = big vs. little word flag #2
; eax = big vs. little word flag #1
; A pipelined version of this code:
;	mov	al, [edi]		;; Load big vs. little flags
;	movapd	xmm0, [edx+0*dist1]	;; Load second number
;	fop	xmm0, [ecx]		;; Add/sub first number
;	mulpd	xmm0, [ebp+0]		;; Mul values1 by two-to-minus-phi
;	addpd	xmm0, xmm4		;; x = values + carry
;	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
;	addpd	xmm2, xmm0		;; y = top bits of x
;	movapd	xmm6, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
;	addpd	xmm6, xmm2		;; z = y - (maximum * BIGVAL - BIGVAL)
;	subpd	xmm0, xmm6		;; rounded value = x - z
;	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y
;	mulpd	xmm0, [ebp+16]		;; new value = val * two-to-phi
;	movapd	[esi+0*dist1], xmm0	;; Save new value

xnorm_op_1d MACRO fop, ttp
ttp	mov	al, [edi]		;; Load big vs. little flags
ttp	mov	bl, [edi+2]
	movapd	xmm0, [edx]		;; Load second number
	fop	xmm0, [ecx]		;; Add/sub first number
ttp	mulpd	xmm0, [ebp]		;; Mul values1 by two-to-minus-phi
ttp	mulpd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	movapd	xmm1, [edx+32]		;; Load second number
	fop	xmm1, [ecx+32]		;; Add/sub first number
ttp	mulpd	xmm1, [ebp+64]		;; Mul values2 by two-to-minus-phi
ttp	mulpd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm0, xmm2		;; x1 = values + carry
	addpd	xmm1, xmm3		;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ebx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ebx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm3, XMM_LIMIT_INVERSE[ebx];; next carry = shifted y2
ttp	mulpd	xmm0, [ebp+16]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebp+80]		;; new value2 = val * two-to-phi
	movapd	[esi], xmm0		;; Save value1
	movapd	[esi+32], xmm1		;; Save value2
ttp	mov	al, [edi+1]		;; Load big vs. little flags
ttp	mov	bl, [edi+3]
	movapd	xmm0, [edx+16]		;; Load values1
	fop	xmm0, [ecx+16]		;; Add/sub first number
ttp	mulpd	xmm0, [ebp+32]		;; Mul values1 by two-to-minus-phi
ttp	mulpd	xmm0, XMM_NORM012_FF	;; Mul by FFTLEN/2
	movapd	xmm1, [edx+48]		;; Load values2
	fop	xmm1, [ecx+48]		;; Add/sub first number
ttp	mulpd	xmm1, [ebp+96]		;; Mul values2 by two-to-minus-phi
ttp	mulpd	xmm1, XMM_NORM012_FF	;; Mul by FFTLEN/2
	addpd	xmm0, xmm2		;; x1 = values + carry
	addpd	xmm1, xmm3		;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ebx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ebx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm3, XMM_LIMIT_INVERSE[ebx];; next carry = shifted y2
ttp	mulpd	xmm0, [ebp+48]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebp+112]		;; new value2 = val * two-to-phi
	movapd	[esi+16], xmm0		;; Save new value1
	movapd	[esi+48], xmm1		;; Save new value2
ttp	lea	edi, [edi+4]		;; Next flags ptr
	lea	ecx, [ecx+64]		;; Next src ptr
	lea	edx, [edx+64]		;; Next src ptr
ttp	lea	ebp, [ebp+128]		;; Next two-to-phi ptr
	lea	esi, [esi+64]		;; Next dest ptr
	ENDM


; This macro finishes the normalize process by adding the final
; carry from the first pass back into the lower two data values.
; xmm2,xmm3 = carries
; eax = pointer to the FFT data values
; ebx = pointer two-to-power multipliers

xnorm_op_1d_mid_cleanup MACRO
	_movsd	xmm0, [eax+8]		;; Load values1
	_movsd	xmm1, [eax+40]		;; Load values2
	subsd	xmm2, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm3, XMM_BIGVAL
	mulsd	xmm2, [ebx+24]		;; carry1 *= two-to-phi
	mulsd	xmm3, [ebx+88]		;; carry2 *= two-to-phi
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	_movsd	[eax+8], xmm0		;; Save new value1
	_movsd	[eax+40], xmm1		;; Save new value2
	shufpd	xmm2, xmm2, 1		;; Rotate carry
	movhpd	xmm2, XMM_BIGVAL
	shufpd	xmm3, xmm3, 1		;; Rotate carry
	movhpd	xmm3, XMM_BIGVAL
	ENDM

xnorm_op_1d_cleanup MACRO
	xnorm_top_carry_cmn esi, xmm3, 0 ;; Adjust top carry if necessary
	_movsd	xmm0, [esi]		;; Load values1
	_movsd	xmm1, [esi+32]		;; Load values2
	subsd	xmm3, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm2, XMM_BIGVAL
	mulsd	xmm3, XMM_MINUS_CARG	;; Mul wrap-around carry by -CARG
	mulsd	xmm3, [ebx+16]		;; carry *= two-to-phi
	mulsd	xmm2, [ebx+80]		;; carry *= two-to-phi
	addsd	xmm0, xmm3		;; value1 = values + carry
	addsd	xmm1, xmm2		;; value2 = values + carry
	_movsd	[esi], xmm0		;; Save new value1
	_movsd	[esi+32], xmm1		;; Save new value2
	ENDM


; *************** 1D normalized add/sub macro ******************
; This macro adds and subtracts, then "normalizes" eight FFT
; data values.  This involves multiplying the sum values by
; two-to-minus-phi.  Adding, subtracting and rounding the value to an
; integer.  Make sure the integer is smaller than the maximum allowable
; integer, generating carries if necessary.  Finally, the values are
; multiplied by two-to-phi and stored.
; xmm7 = sub carry #2
; xmm6 = sub carry #1
; xmm3 = add carry #2
; xmm2 = add carry #1
; ecx = pointer to the first number
; edx = pointer to the second number
; esi = pointer to destination #1
; ebp = pointer to destination #2
; ebx = pointer two-to-phi multipliers
; edi = pointer to array of big vs. little flags
; eax = big vs. little word flag #1

xnorm_addsub_1d MACRO ttp
ttp	mov	al, [edi]		;; Load big vs. little flags
	movapd	xmm0, [ecx]		;; Load first number
	addpd	xmm0, [edx]		;; Add second number
ttp	movapd	xmm5, [ebx]		;; Load fudged two-to-minus-phi
ttp	mulpd	xmm5, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm5		;; Mul values1 by two-to-minus-phi
	movapd	xmm1, [ecx]		;; Load first number
	subpd	xmm1, [edx]		;; Sub second number
ttp	mulpd	xmm1, xmm5		;; Mul values2 by two-to-minus-phi
	addpd	xmm0, xmm2		;; x1 = values + carry
	addpd	xmm1, xmm6		;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm6, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm6, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm6		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm6, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
ttp	mulpd	xmm0, [ebx+16]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebx+16]		;; new value2 = val * two-to-phi
	movapd	[esi], xmm0		;; Save value1
	movapd	[ebp], xmm1		;; Save value2

ttp	mov	al, [edi+2]		;; Load big vs. little flags
	movapd	xmm0, [ecx+32]		;; Load first number
	addpd	xmm0, [edx+32]		;; Add second number
ttp	movapd	xmm5, [ebx+64]		;; Load fudged two-to-minus-phi
ttp	mulpd	xmm5, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm5		;; Mul values1 by two-to-minus-phi
	movapd	xmm1, [ecx+32]		;; Load first number
	subpd	xmm1, [edx+32]		;; Sub second number
ttp	mulpd	xmm1, xmm5		;; Mul values2 by two-to-minus-phi
	addpd	xmm0, xmm3		;; x1 = values + carry
	addpd	xmm1, xmm7		;; x2 = values + carry
	movapd	xmm3, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm0		;; y1 = top bits of x
	movapd	xmm7, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm7, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm7		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm7, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
ttp	mulpd	xmm0, [ebx+80]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebx+80]		;; new value2 = val * two-to-phi
	movapd	[esi+32], xmm0		;; Save value1
	movapd	[ebp+32], xmm1		;; Save value2

ttp	mov	al, [edi+1]		;; Load big vs. little flags
	movapd	xmm0, [ecx+16]		;; Load first number
	addpd	xmm0, [edx+16]		;; Add second number
ttp	movapd	xmm5, [ebx+32]		;; Load fudged two-to-minus-phi
ttp	mulpd	xmm5, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm5		;; Mul values1 by two-to-minus-phi
	movapd	xmm1, [ecx+16]		;; Load first number
	subpd	xmm1, [edx+16]		;; Sub second number
ttp	mulpd	xmm1, xmm5		;; Mul values2 by two-to-minus-phi
	addpd	xmm0, xmm2		;; x1 = values + carry
	addpd	xmm1, xmm6		;; x2 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm6, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm6, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm6		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm6, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
ttp	mulpd	xmm0, [ebx+48]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebx+48]		;; new value2 = val * two-to-phi
	movapd	[esi+16], xmm0		;; Save value1
	movapd	[ebp+16], xmm1		;; Save value2

ttp	mov	al, [edi+3]		;; Load big vs. little flags
	movapd	xmm0, [ecx+48]		;; Load first number
	addpd	xmm0, [edx+48]		;; Add second number
ttp	movapd	xmm5, [ebx+96]		;; Load fudged two-to-minus-phi
ttp	mulpd	xmm5, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm5		;; Mul values1 by two-to-minus-phi
	movapd	xmm1, [ecx+48]		;; Load first number
	subpd	xmm1, [edx+48]		;; Sub second number
ttp	mulpd	xmm1, xmm5		;; Mul values2 by two-to-minus-phi
	addpd	xmm0, xmm3		;; x1 = values + carry
	addpd	xmm1, xmm7		;; x2 = values + carry
	movapd	xmm3, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm0		;; y1 = top bits of x
	movapd	xmm7, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm7, xmm1		;; y2 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm7		;; z2 = y2-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	subpd	xmm1, xmm5		;; rounded value = x2 - z2
	mulpd	xmm7, XMM_LIMIT_INVERSE[eax];; next carry = shifted y2
ttp	mulpd	xmm0, [ebx+112]		;; new value1 = val * two-to-phi
ttp	mulpd	xmm1, [ebx+112]		;; new value2 = val * two-to-phi
	movapd	[esi+48], xmm0		;; Save value1
	movapd	[ebp+48], xmm1		;; Save value2

ttp	lea	edi, [edi+4]		;; Next flags ptr
	lea	ecx, [ecx+64]		;; Next src ptr
	lea	edx, [edx+64]		;; Next src ptr
ttp	lea	ebx, [ebx+128]		;; Next two-to-phi ptr
	lea	esi, [esi+64]		;; Next dest ptr
	lea	ebp, [ebp+64]		;; Next dest ptr
	ENDM

; This macro finishes the normalize process by adding the final
; carry from the first pass back into the lower two data values.
; xmm2,xmm3 = carries #1
; xmm6,xmm7 = carries #2
; eax = pointer to the FFT data values #1
; top of stack = pointer to the FFT destination #1 and #2
; ebx = pointer two-to-power multipliers

xnorm_addsub_1d_mid_cleanup MACRO
	pop	eax			;; Restore dest #1 pointer
	_movsd	xmm0, [eax+8]		;; Load values1
	_movsd	xmm1, [eax+40]		;; Load values2
	subsd	xmm2, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm3, XMM_BIGVAL
	mulsd	xmm2, [ebx+24]		;; carry1 *= two-to-phi
	mulsd	xmm3, [ebx+88]		;; carry2 *= two-to-phi
	addsd	xmm0, xmm2		;; x1 = values + carry
	addsd	xmm1, xmm3		;; x2 = values + carry
	_movsd	[eax+8], xmm0		;; Save new value1
	_movsd	[eax+40], xmm1		;; Save new value2
	shufpd	xmm2, xmm2, 1		;; Rotate carry
	movhpd	xmm2, XMM_BIGVAL
	shufpd	xmm3, xmm3, 1		;; Rotate carry
	movhpd	xmm3, XMM_BIGVAL

	pop	eax			;; Get FFT data pointer #2
	_movsd	xmm0, [eax+8]		;; Load values1
	_movsd	xmm1, [eax+40]		;; Load values2
	subsd	xmm6, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm7, XMM_BIGVAL
	mulsd	xmm6, [ebx+24]		;; carry1 *= two-to-phi
	mulsd	xmm7, [ebx+88]		;; carry2 *= two-to-phi
	addsd	xmm0, xmm6		;; x1 = values + carry
	addsd	xmm1, xmm7		;; x2 = values + carry
	_movsd	[eax+8], xmm0		;; Save new value1
	_movsd	[eax+40], xmm1		;; Save new value2
	shufpd	xmm6, xmm6, 1		;; Rotate carry
	movhpd	xmm6, XMM_BIGVAL
	shufpd	xmm7, xmm7, 1		;; Rotate carry
	movhpd	xmm7, XMM_BIGVAL
	ENDM

; esi = pointer to the FFT data values #1
; ebp = pointer to the FFT data values #2

xnorm_addsub_1d_cleanup MACRO
	xnorm_top_carry_cmn esi, xmm3, 0;; Adjust top carry if necessary
	xnorm_top_carry_cmn ebp, xmm7, 0;; Adjust top carry if necessary

	_movsd	xmm0, [esi]		;; Load values1
	_movsd	xmm1, [esi+32]		;; Load values2
	subsd	xmm3, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm2, XMM_BIGVAL
	mulsd	xmm3, XMM_MINUS_CARG	;; Mul wrap-around carry by -CARG
	mulsd	xmm3, [ebx+16]		;; carry *= two-to-phi
	mulsd	xmm2, [ebx+80]		;; carry *= two-to-phi
	addsd	xmm0, xmm3		;; value1 = values + carry
	addsd	xmm1, xmm2		;; value2 = values + carry
	_movsd	[esi], xmm0		;; Save new value1
	_movsd	[esi+32], xmm1		;; Save new value2

	_movsd	xmm0, [ebp]		;; Load values1
	_movsd	xmm1, [ebp+32]		;; Load values2
	subsd	xmm7, XMM_BIGVAL	;; Remove BIGVAL from carries
	subsd	xmm6, XMM_BIGVAL
	mulsd	xmm7, XMM_MINUS_CARG	;; Mul wrap-around carry by -CARG
	mulsd	xmm7, [ebx+16]		;; carry *= two-to-phi
	mulsd	xmm6, [ebx+80]		;; carry *= two-to-phi
	addsd	xmm0, xmm7		;; value1 = values + carry
	addsd	xmm1, xmm6		;; value2 = values + carry
	_movsd	[ebp], xmm0		;; Save new value1
	_movsd	[ebp+32], xmm1		;; Save new value2
	ENDM



; *************** 2D normalized add/sub macro ******************
; This macro adds or subtracts, then "normalizes" eight FFT
; data values.  This involves multiplying the summed values by
; two-to-minus-phi.  Rounding the value to an integer.  Making sure
; the integer is smaller than the maximum allowable integer, generating
; a carry if necessary. Finally, the value is multiplied by two-to-phi
; and stored.
; ecx = pointer to the first number
; edx = pointer to the second number
; esi = pointer to destination
; edi = pointer to array of big vs. little flags
; ebx = pointer to two-to-phi column multipliers
; ebp = pointer two-to-phi group multipliers
; XMM_TMP1,XMM_TMP2,XMM_TMP3,XMM_TMP4 = carries
; A pipelined version of this code:
;	movapd	xmm0, [edx]		;; Load second number
;	fop	xmm0, [ecx]		;; Add/sub first number
;	push	ecx
;	sub	ecx, ecx
;	mov	cl, [edi]		;; Load big vs. little flags
;	movapd	xmm2, [ebx]		;; col two-to-minus-phi
;	mulpd	xmm2, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
;	mulpd	xmm0, [eax]		;; Mul by grp two-to-minus-phi
;	mulpd	xmm0, xmm2		;; Mul by fudged col two-to-minus-phi
;	addpd	xmm0, [ebp+0*16]	;; x1 = values + carry
;	movapd	xmm2, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
;	addpd	xmm2, xmm0		;; y1 = top bits of x
;	movapd	xmm6, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
;	addpd	xmm6, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
;	subpd	xmm0, xmm6		;; rounded value = x1 - z1
;	mulpd	xmm2, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
;	movapd	xmm4, [ebx]		;; col two-to-phi
;	mulpd	xmm4, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
;	mulpd	xmm0, [eax+0*32+16]	;; new value1 = val * grp two-to-phi
;	mulpd	xmm0, xmm4		;; new value1 *= fudged col two-to-phi
;	movapd	[esi+0*dist1], xmm0	;; Save new value1
;	movapd	[ebp+0*16], xmm2	;; Save carry
;	pop	ecx

xnorm_op_2d MACRO fop, ttp
	movapd	xmm0, [edx]		;; Load second number
	fop	xmm0, [ecx]		;; Add/sub first number
ttp	movapd	xmm2, [ebx]		;; Col two-to-minus-phi
ttp	mulpd	xmm2, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm2		;; Mul values1 by col two-to-minus-phi
	movapd	xmm1, [edx+16]		;; Load second number
	fop	xmm1, [ecx+16]		;; Add/sub first number
ttp	mulpd	xmm1, xmm2		;; Mul values2 by col two-to-minus-phi
	movapd	xmm6, [edx+32]		;; Load second number
	fop	xmm6, [ecx+32]		;; Add/sub first number
ttp	mulpd	xmm6, xmm2		;; Mul values3 by col two-to-minus-phi
	movapd	xmm7, [edx+48]		;; Load second number
	fop	xmm7, [ecx+48]		;; Add/sub first number
ttp	mulpd	xmm7, xmm2		;; Mul values4 by col two-to-minus-phi
	push	edx
	sub	edx, edx		;; Clear big/lit flags
ttp	mov	al, [edi]		;; Load big vs. little flags
ttp	mov	dl, [edi+1]
ttp	mulpd	xmm0, [ebp+0*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm0, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
	addpd	xmm0, XMM_TMP1		;; x1 = values + carry
ttp	mulpd	xmm1, [ebp+1*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm1, XMM_TTMP_FUDGE[edx];; Mul by fudge two-to-minus-phi
	addpd	xmm1, XMM_TMP2		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[edx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[edx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	movapd	XMM_TMP1, xmm2		;; Save carry
	subpd	xmm1, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[edx];; next carry = shifted y1
	movapd	XMM_TMP2, xmm3		;; Save carry
ttp	movapd	xmm2, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [ebp+0*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+0*16], xmm0	;; Save new value1
ttp	movapd	xmm3, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[edx];; mul by fudge two-to-phi
ttp	mulpd	xmm1, [ebp+1*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm1, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[esi+1*16], xmm1	;; Save new value1

ttp	mov	al, [edi+2]		;; Load big vs. little flags
ttp	mov	dl, [edi+3]
ttp	mulpd	xmm6, [ebp+2*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm6, XMM_TTMP_FUDGE[eax];; Mul by fudge two-to-minus-phi
	addpd	xmm6, XMM_TMP3		;; x1 = values + carry
ttp	mulpd	xmm7, [ebp+3*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm7, XMM_TTMP_FUDGE[edx];; Mul by fudge two-to-minus-phi
	addpd	xmm7, XMM_TMP4		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[eax];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm6		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[edx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm7		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[eax];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[edx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm6, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[eax];; next carry = shifted y1
	movapd	XMM_TMP3, xmm2		;; Save carry
	subpd	xmm7, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[edx];; next carry = shifted y1
	movapd	XMM_TMP4, xmm3		;; Save carry
ttp	movapd	xmm2, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[eax];; mul by fudge two-to-phi
ttp	mulpd	xmm6, [ebp+2*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm6, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+2*16], xmm6	;; Save new value1
ttp	movapd	xmm3, [ebx+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[edx];; mul by fudge two-to-phi
ttp	mulpd	xmm7, [ebp+3*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm7, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[esi+3*16], xmm7	;; Save new value1
	pop	edx
ttp	lea	edi, [edi+4]		;; Next flags ptr
ttp	lea	ebx, [ebx+32]		;; Next column two-to-phi ptr
	lea	esi, [esi+64]		;; Next dest ptr
	lea	edx, [edx+64]		;; Next src ptr
	lea	ecx, [ecx+64]		;; Next src ptr
	ENDM

; *************** 2D followup macros ******************
; This macro finishes the normalize add/sub process by adding four carries
; from the end of a block back to the start of the block.  The remaining
; four carries are rotated for starting the next block.

xnorm_op_2d_blk MACRO srcreg, screg, carry1, carry2, carry3, carry4
	movapd	xmm2, XMM_BIGVAL

	movapd	xmm0, carry1		;; Load carries
	subsd	xmm0, xmm2
	mulsd	xmm0, [screg+0*32+24]	;; mul by grp two-to-phi
	addsd	xmm0, [srcreg+0*16+8]	;; Add in FFT data
	_movsd	[srcreg+0*16+8], xmm0	;; Save FFT word
	shufpd	xmm0, xmm2, 1
	movapd	carry1, xmm0		;; Save carries for start of next blk

	movapd	xmm0, carry2		;; Load carries
	subsd	xmm0, xmm2
	mulsd	xmm0, [screg+1*32+24]	;; mul by grp two-to-phi
	addsd	xmm0, [srcreg+1*16+8]	;; Add in FFT data
	_movsd	[srcreg+1*16+8], xmm0	;; Save FFT word
	shufpd	xmm0, xmm2, 1
	movapd	carry2, xmm0		;; Save carries for start of next blk

	movapd	xmm0, carry3		;; Load carries
	subsd	xmm0, xmm2
	mulsd	xmm0, [screg+2*32+24]	;; mul by grp two-to-phi
	addsd	xmm0, [srcreg+2*16+8]	;; Add in FFT data
	_movsd	[srcreg+2*16+8], xmm0	;; Save FFT word
	shufpd	xmm0, xmm2, 1
	movapd	carry3, xmm0		;; Save carries for start of next blk

	movapd	xmm0, carry4		;; Load carries
	subsd	xmm0, xmm2
	mulsd	xmm0, [screg+3*32+24]	;; mul by grp two-to-phi
	addsd	xmm0, [srcreg+3*16+8]	;; Add in FFT data
	_movsd	[srcreg+3*16+8], xmm0	;; Save FFT word
	shufpd	xmm0, xmm2, 1
	movapd	carry4, xmm0		;; Save carries for start of next blk
	ENDM

; This macro finishes the normalize add/sub process by adding two carries
; from the end of a section back to the start of the section.  The remaining
; two carries are rotated for starting the next section.
; eax = pointer to FFT data
; ebx = pointer two-to-power group multipliers

xnorm_op_2d_sec MACRO carry1, carry2, carry3, carry4
	movapd	xmm2, XMM_BIGVAL

	_movsd	xmm0, carry1		;; Load carry
	subsd	xmm0, xmm2
	mulsd	xmm0, [ebx+1*32+16]	;; mul by grp two-to-phi
	addsd	xmm0, [eax+1*16]	;; Add in FFT data
	_movsd	[eax+1*16], xmm0	;; Save FFT word

	movapd	xmm1, carry2
	movapd	carry1, xmm1
	movapd	carry2, xmm2		;; Save carries for start of next sec

	_movsd	xmm0, carry3		;; Load carry
	subsd	xmm0, xmm2
	mulsd	xmm0, [ebx+3*32+16]	;; mul by grp two-to-phi
	addsd	xmm0, [eax+3*16]	;; Add in FFT data
	_movsd	[eax+3*16], xmm0	;; Save FFT word

	movapd	xmm1, carry4
	movapd	carry3, xmm1
	movapd	carry4, xmm2		;; Save carries for start of next sec
	ENDM


; This macro finishes the normalize add/sub process by adding the final
; two carries back into the appropriate FFT values at the start of the fft.
; esi = pointer to FFT data
; ebp = pointer two-to-power group multipliers
; xmm6 = non-wraparound carry
; xmm7 = wraparound carry

xnorm_op_2d_fft MACRO
	_movsd	xmm2, XMM_BIGVAL

	subsd	xmm7, xmm2		;; Remove XMM_BIGVAL
	mulsd	xmm7, XMM_MINUS_CARG	;; mul wrap around carry by minus carg
	mulsd	xmm7, [ebp+0*32+16]	;; mul by grp two-to-phi
	addsd	xmm7, [esi+0*16]	;; Add in FFT data
	_movsd	[esi+0*16], xmm7	;; Save FFT word

	subsd	xmm6, xmm2		;; Remove XMM_BIGVAL
	mulsd	xmm6, [ebp+2*32+16]	;; mul by grp two-to-phi
	addsd	xmm6, [esi+2*16]	;; Add in FFT data
	_movsd	[esi+2*16], xmm6	;; Save FFT word
	ENDM


; *************** 2D normalized add & sub macro ******************
; This macro adds and subtracts, then "normalizes" eight FFT
; data values.  This involves multiplying the summed values by
; two-to-minus-phi.  Rounding the value to an integer.  Making sure
; the integer is smaller than the maximum allowable integer, generating
; a carry if necessary. Finally, the value is multiplied by two-to-phi
; and stored.
; ecx = pointer to the first number
; edx = pointer to the second number
; esi = pointer to destination #1
; ebp = pointer to destination #2
; ebx = pointer two-to-phi group multipliers
; edi = pointer to array of big vs. little flags
; eax = pointer to two-to-phi column multipliers
; XMM_TMP1,XMM_TMP2,XMM_TMP3,XMM_TMP4 = addition carries
; XMM_TMP5,XMM_TMP6,XMM_TMP7,XMM_TMP8 = subtraction carries

xnorm_addsub_2d MACRO ttp
	movapd	xmm1, [ecx+0*16]	;; Load first number
	movapd	xmm0, [edx+0*16]	;; Load second number
	subpd	xmm1, xmm0		;; first - second number
	addpd	xmm0, [ecx+0*16]	;; first + second number
ttp	movapd	xmm2, [eax]		;; Col two-to-minus-phi
ttp	mulpd	xmm2, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm2		;; Mul values1 by col two-to-minus-phi
ttp	mulpd	xmm1, xmm2		;; Mul values1 by col two-to-minus-phi

	movapd	xmm7, [ecx+1*16]	;; Load first number
	movapd	xmm6, [edx+1*16]	;; Load second number
	subpd	xmm7, xmm6		;; first - second number
	addpd	xmm6, [ecx+1*16]	;; first + second number
ttp	mulpd	xmm6, xmm2		;; Mul values1 by col two-to-minus-phi
ttp	mulpd	xmm7, xmm2		;; Mul values1 by col two-to-minus-phi

	push	ecx
	sub	ecx, ecx		;; Clear big/lit flag

ttp	mov	cl, [edi+0]		;; Load big vs. little flags
ttp	mulpd	xmm0, [ebx+0*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm0, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm0, XMM_TMP1		;; x1 = values + carry
ttp	mulpd	xmm1, [ebx+0*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm1, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm1, XMM_TMP5		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP1, xmm2		;; Save carry
	subpd	xmm1, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP5, xmm3		;; Save carry
ttp	movapd	xmm2, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [ebx+0*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+0*16], xmm0	;; Save new value1
ttp	movapd	xmm3, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm1, [ebx+0*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm1, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[ebp+0*16], xmm1	;; Save new value1

ttp	mov	cl, [edi+1]		;; Load big vs. little flags
ttp	mulpd	xmm6, [ebx+1*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm6, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm6, XMM_TMP2		;; x1 = values + carry
ttp	mulpd	xmm7, [ebx+1*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm7, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm7, XMM_TMP6		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm6		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm7		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm6, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP2, xmm2		;; Save carry
	subpd	xmm7, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP6, xmm3		;; Save carry
ttp	movapd	xmm2, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm6, [ebx+1*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm6, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+1*16], xmm6	;; Save new value1
ttp	movapd	xmm3, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm7, [ebx+1*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm7, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[ebp+1*16], xmm7	;; Save new value1

	pop	ecx

	movapd	xmm1, [ecx+2*16]	;; Load first number
	movapd	xmm0, [edx+2*16]	;; Load second number
	subpd	xmm1, xmm0		;; first - second number
	addpd	xmm0, [ecx+2*16]	;; first + second number
ttp	movapd	xmm2, [eax]		;; Col two-to-minus-phi
ttp	mulpd	xmm2, XMM_NORM012_FF	;; Mul by FFTLEN/2
ttp	mulpd	xmm0, xmm2		;; Mul values1 by col two-to-minus-phi
ttp	mulpd	xmm1, xmm2		;; Mul values1 by col two-to-minus-phi

	movapd	xmm7, [ecx+3*16]	;; Load first number
	movapd	xmm6, [edx+3*16]	;; Load second number
	subpd	xmm7, xmm6		;; first - second number
	addpd	xmm6, [ecx+3*16]	;; first + second number
ttp	mulpd	xmm6, xmm2		;; Mul values1 by col two-to-minus-phi
ttp	mulpd	xmm7, xmm2		;; Mul values1 by col two-to-minus-phi

	push	ecx
	sub	ecx, ecx		;; Clear big/lit flag

ttp	mov	cl, [edi+2]		;; Load big vs. little flags
ttp	mulpd	xmm0, [ebx+2*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm0, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm0, XMM_TMP3		;; x1 = values + carry
ttp	mulpd	xmm1, [ebx+2*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm1, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm1, XMM_TMP7		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm0		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm1		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm0, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP3, xmm2		;; Save carry
	subpd	xmm1, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP7, xmm3		;; Save carry
ttp	movapd	xmm2, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm0, [ebx+2*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm0, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+2*16], xmm0	;; Save new value1
ttp	movapd	xmm3, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm1, [ebx+2*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm1, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[ebp+2*16], xmm1	;; Save new value1

ttp	mov	cl, [edi+3]		;; Load big vs. little flags
ttp	mulpd	xmm6, [ebx+3*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm6, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm6, XMM_TMP4		;; x1 = values + carry
ttp	mulpd	xmm7, [ebx+3*32]	;; Mul by grp two-to-minus-phi
ttp	mulpd	xmm7, XMM_TTMP_FUDGE[ecx];; Mul by fudge two-to-minus-phi
	addpd	xmm7, XMM_TMP8		;; x1 = values + carry
	movapd	xmm2, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm2, xmm6		;; y1 = top bits of x
	movapd	xmm3, XMM_LIMIT_BIGMAX[ecx];; Load maximum * BIGVAL - BIGVAL
	addpd	xmm3, xmm7		;; y1 = top bits of x
	movapd	xmm4, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm4, xmm2		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	movapd	xmm5, XMM_LIMIT_BIGMAX_NEG[ecx];; Load -(maximum*BIGVAL-BIGVAL)
	addpd	xmm5, xmm3		;; z1 = y1-(maximum * BIGVAL - BIGVAL)
	subpd	xmm6, xmm4		;; rounded value = x1 - z1
	mulpd	xmm2, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP4, xmm2		;; Save carry
	subpd	xmm7, xmm5		;; rounded value = x1 - z1
	mulpd	xmm3, XMM_LIMIT_INVERSE[ecx];; next carry = shifted y1
	movapd	XMM_TMP8, xmm3		;; Save carry
ttp	movapd	xmm2, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm2, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm6, [ebx+3*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm6, xmm2		;; new value1 *= fudged col two-to-phi
	movapd	[esi+3*16], xmm6	;; Save new value1
ttp	movapd	xmm3, [eax+16]		;; col two-to-phi
ttp	mulpd	xmm3, XMM_TTP_FUDGE[ecx];; mul by fudge two-to-phi
ttp	mulpd	xmm7, [ebx+3*32+16]	;; new value1 = val * grp two-to-phi
ttp	mulpd	xmm7, xmm3		;; new value1 *= fudged col two-to-phi
	movapd	[ebp+3*16], xmm7	;; Save new value1

	pop	ecx

	lea	edx, [edx+64]		;; Next src ptr
	lea	ecx, [ecx+64]		;; Next src ptr
ttp	lea	edi, [edi+4]		;; Next flags ptr
ttp	lea	eax, [eax+32]		;; Next column two-to-phi ptr
	lea	esi, [esi+64]		;; Next dest ptr
	lea	ebp, [ebp+64]		;; Next dest ptr
	ENDM

;;
;; Macro to copy and possibly zero 4 or 8 doubles
;;

xcopyzero MACRO
	xcopyz	0, xmm0, [esi]		;; Load and copy first doubles
	movapd	[edi], xmm0		;; Save first doubles
	xcopyz	1, xmm1, [esi+16]	;; Load and copy second doubles
	movapd	[edi+16], xmm1		;; Save second doubles
	movapd	xmm2, [esi+32]		;; Load and copy third doubles
	movapd	[edi+32], xmm2		;; Save third doubles
	movapd	xmm3, [esi+48]		;; Load and copy fourth doubles
	movapd	[edi+48], xmm3		;; Save fourth doubles
	ENDM

xcopyz MACRO col, xmmreg, mem
	LOCAL	z_two, zdone
	cmp	ecx, _COPYZERO+col*8+4	;; Check higher pointer
	jl	short z_two		;; Jump if zeroing both
	movapd	xmmreg, mem		;; Load the doubles
	cmp	ecx, _COPYZERO+col*8	;; Check lower pointer
	jge	short zdone		;; Jump if no zeroing
	subsd	xmmreg, xmmreg		;; Clear just one double
	jmp	short zdone
z_two:	subpd	xmmreg, xmmreg
zdone:
	ENDM
