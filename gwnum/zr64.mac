	vshuff64x2 zmm18, zmm18, zmm1, 01000100b;; R6_3 R5_3 R2_3 R1_3 R6_1 R5_1 R2_1 R1_1 (R24L)	; 134-136	n 143

	zfmaddpd zmm8, zmm20, zmm31, zmm14	;; I24H + I68H * SQRTHALF (final I24H)			; 133-136	n 138	r133
