	vshufpd	zmm17, zmm17, zmm4, 11111111b	;; I8_1 I7_1 I4_1 I3_1 I6_1 I5_1 I2_1 I1_1 (I2+I6 = new I2) ; 69	n 71
	vshufpd	zmm3, zmm3, zmm16, 11111111b	;; I8_3 I7_3 I4_3 I3_3 I6_3 I5_3 I2_3 I1_3 (I4+I8 = new I4) ; 70	n 71

	vaddpd	zmm8, zmm7, zmm10		;; I1 + I3 (newer I1)					; 69-72		n 75
	vsubpd	zmm7, zmm7, zmm10		;; I1 - I3 (newer I3)					; 70-73		n 88

	vshuff64x2 zmm4, zmm18, zmm13, 10001000b;; R8_5 R8_4 R4_5 R4_4 R6_5 R6_4 R2_5 R2_4 (r26/48-)	; 71-73		n 75
	vshuff64x2 zmm18, zmm18, zmm13, 11011101b;; R8_7 R8_6 R4_7 R4_6 R6_7 R6_6 R2_7 R2_6		; 72-74		n 78

	vaddpd	zmm16, zmm17, zmm3		;; I2 + I4 (newer I2)					; 71-74		n 75
	vsubpd	zmm17, zmm17, zmm3		;; I2 - I4 (newer I4)					; 72-75		n 86

	vshuff64x2 zmm10, zmm6, zmm9, 11011101b	;; I8_7	I8_6 I4_7 I4_6 I6_7 I6_6 I2_7 I2_6 (i26/48-)	; 73-75		n 76
	vshuff64x2 zmm6, zmm6, zmm9, 10001000b	;; I8_5 I8_4 I4_5 I4_4 I6_5 I6_4 I2_5 I2_4		; 74-76		n 77

	vaddpd	zmm13, zmm19, zmm5		;; R1 + R2 (final R1)					; 73-76
	vsubpd	zmm19, zmm19, zmm5		;; R1 - R2 (final R2)					; 74-77

	vshufpd	zmm3, zmm15, zmm4, 11111111b	;; R8_5 R7_5 R4_5 R3_5 R6_5 R5_5 R2_5 R1_5 (R2-R6 = new R6) ; 75	n 77
	vshufpd	zmm9, zmm0, zmm10, 11111111b	;; I8_7	I7_7 I4_7 I3_7 I6_7 I5_7 I2_7 I1_7 (I4-I8 = new I8) ; 76	n 77

	vaddpd	zmm5, zmm8, zmm16		;; I1 + I2 (final I1)					; 75-78		n 
	vsubpd	zmm8, zmm8, zmm16		;; I1 - I2 (final I2)					; 76-79		n 

	vshufpd	zmm16, zmm20, zmm6, 11111111b	;; I8_5 I7_5 I4_5 I3_5 I6_5 I5_5 I2_5 I1_5 (I2-I6 = new I6) ; 77	n 79
	vshufpd	zmm1, zmm14, zmm18, 11111111b	;; R8_7	R7_7 R4_7 R3_7 R6_7 R5_7 R2_7 R1_7 (R4-R8 = new R8) ; 78	n 79

	vsubpd	zmm12, zmm3, zmm9		;; R6 - I8 (new2 R6)					; 77-80		n 84
	vaddpd	zmm3, zmm3, zmm9		;; R6 + I8 (new2 R8)					; 78-81		n 85
	zstore	[srcreg], zmm13			;; Save R1						; 77
	zstore	[srcreg+d1], zmm19		;; Save R2						; 78

	vshufpd	zmm20, zmm20, zmm6, 00000000b	;; I8_4 I7_4 I4_4 I3_4 I6_4 I5_4 I2_4 I1_4 (I1-I5 = new I5) ; 79	n 81
	vshufpd	zmm14, zmm14, zmm18, 00000000b	;; R8_6	R7_6 R4_6 R3_6 R6_6 R5_6 R2_6 R1_6 (R3-R7 = new R7) ; 80	n 81

	vaddpd	zmm9, zmm16, zmm1		;; I6 + R8 (new2 I6)					; 79-82		n 84
	vsubpd	zmm16, zmm16, zmm1		;; I6 - R8 (new2 I8)					; 80-83		n 85
	zstore	[srcreg+64], zmm5		;; Save I1						; 79
	zstore	[srcreg+d1+64], zmm8		;; Save I2						; 80

	vshufpd	zmm15, zmm15, zmm4, 00000000b	;; R8_4 R7_4 R4_4 R3_4 R6_4 R5_4 R2_4 R1_4 (R1-R5 = new R5) ; 81	n 83
	vshufpd	zmm0, zmm0, zmm10, 00000000b	;; I8_6	I7_6 I4_6 I3_6 I6_6 I5_6 I2_6 I1_6 (I3-I7 = new I7) ; 82	n 83

	vaddpd	zmm6, zmm20, zmm14		;; I5 + R7 (newer I5)					; 81-84		n 88
	vsubpd	zmm20, zmm20, zmm14		;; I5 - R7 (newer I7)					; 82-85		n 89

	vsubpd	zmm18, zmm15, zmm0		;; R5 - I7 (newer R5)					; 83-86		n 90
	vaddpd	zmm15, zmm15, zmm0		;; R5 + I7 (newer R7)					; 83-86		n 91

	vaddpd	zmm4, zmm12, zmm9		;; I6 = R6 + I6 (newer I6/SQRTHALF)			; 84-87		n 88
	vsubpd	zmm12, zmm12, zmm9		;; R6 = R6 - I6 (newer R6/SQRTHALF)			; 84-87		n 90

	vsubpd	zmm10, zmm3, zmm16		;; R8 = R8 - I8 (newer R8/SQRTHALF)			; 85-88		n 89
	vaddpd	zmm3, zmm3, zmm16		;; I8 = R8 + I8 (newer I8/SQRTHALF)			; 85-88		n 91

	vsubpd	zmm14, zmm11, zmm17		;; R3 - I4 (final R3)					; 86-89		n 
	vaddpd	zmm11, zmm11, zmm17		;; R3 + I4 (final R4)					; 86-89		n 

	vaddpd	zmm0, zmm7, zmm2		;; I3 + R4 (final I3)					; 87-90		n 
	vsubpd	zmm7, zmm7, zmm2		;; I3 - R4 (final I4)					; 87-90		n 

	zfmaddpd zmm9, zmm4, zmm31, zmm6	;; I5 + I6 * SQRTHALF (final I5)			; 88-91		n 
	zfnmaddpd zmm4, zmm4, zmm31, zmm6	;; I5 - I6 * SQRTHALF (final I6)			; 88-91		n 

	zfmaddpd zmm2, zmm10, zmm31, zmm20	;; I7 + R8 * SQRTHALF (final I7)			; 89-92		n 
	zfnmaddpd zmm10, zmm10, zmm31, zmm20	;; I7 - R8 * SQRTHALF (final I8)			; 89-92		n 

	zfmaddpd zmm6, zmm12, zmm31, zmm18	;; R5 + R6 * SQRTHALF (final R5)			; 90-93		n 
	zfnmaddpd zmm12, zmm12, zmm31, zmm18	;; R5 - R6 * SQRTHALF (final R6)			; 90-93		n 

	zfnmaddpd zmm16, zmm3, zmm31, zmm15	;; R7 - I8 * SQRTHALF (final R7)			; 91-94		n 
	zfmaddpd zmm3, zmm3, zmm31, zmm15	;; R7 + I8 * SQRTHALF (final R8)			; 91-94		n 

	bump	screg, scinc
	zstore	[srcreg+d2], zmm14		;; Save R3						; 90
	zstore	[srcreg+d2+d1], zmm11		;; Save R4						; 90+1
	zstore	[srcreg+d2+64], zmm0		;; Save I3						; 91+1
	zstore	[srcreg+d2+d1+64], zmm7		;; Save I4						; 91+2
	zstore	[srcreg+d4+64], zmm9		;; Save I5						; 92+2
	zstore	[srcreg+d4+d1+64], zmm4		;; Save I6						; 92+3
	zstore	[srcreg+d4+d2+64], zmm2		;; Save I7						; 93+3
	zstore	[srcreg+d4+d2+d1+64], zmm10	;; Save I8						; 93+4
	zstore	[srcreg+d4], zmm6		;; Save R5						; 94+4
	zstore	[srcreg+d4+d1], zmm12		;; Save R6						; 94+5
	zstore	[srcreg+d4+d2], zmm16		;; Save R7						; 95+5
	zstore	[srcreg+d4+d2+d1], zmm3		;; Save R8						; 95+6
	bump	srcreg, srcinc
	ENDM

zr64_sixtyfour_complex_with_square_preload MACRO
	zr64_64c_square_cmn_preload
	ENDM
zr64_sixtyfour_complex_with_square MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	zr64_64c_square_cmn srcreg,0,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	ENDM
zr64f_sixtyfour_complex_with_square_preload MACRO
	zr64_64c_square_cmn_preload
	ENDM
zr64f_sixtyfour_complex_with_square MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	zr64_64c_square_cmn srcreg,rbx,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

zr64_64c_square_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	vbroadcastsd zmm30, ZMM_TWO
	ENDM
zr64_64c_square_cmn MACRO srcreg,srcoff,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm1, [srcreg+srcoff+d1]	;; R2
	vmovapd	zmm2, [srcreg+srcoff+d4+d1]	;; R6
	vsubpd	zmm0, zmm1, zmm2		;; R2 - R6 (new R6)					; 1-4		n 9
	vaddpd	zmm1, zmm1, zmm2		;; R2 + R6 (new R2)					; 1-4		n 11

	vmovapd	zmm3, [srcreg+srcoff+d2+d1+64]	;; I4
	vmovapd	zmm4, [srcreg+srcoff+d4+d2+d1+64] ;; I8
	vsubpd	zmm2, zmm3, zmm4		;; I4 - I8 (new I8)					; 2-5		n 9
	vaddpd	zmm3, zmm3, zmm4		;; I4 + I8 (new I4)					; 2-5		n 12

	vmovapd	zmm5, [srcreg+srcoff+d2+d1]	;; R4
	vmovapd	zmm6, [srcreg+srcoff+d4+d2+d1]	;; R8
	vsubpd	zmm4, zmm5, zmm6		;; R4 - R8 (new R8)					; 3-6		n 10
	vaddpd	zmm5, zmm5, zmm6		;; R4 + R8 (new R4)					; 3-6		n 11

	vmovapd	zmm7, [srcreg+srcoff+d1+64]	;; I2
	vmovapd	zmm8, [srcreg+srcoff+d4+d1+64]	;; I6
	vsubpd	zmm6, zmm7, zmm8		;; I2 - I6 (new I6)					; 4-7		n 10
	vaddpd	zmm7, zmm7, zmm8		;; I2 + I6 (new I2)					; 4-7		n 12

	vmovapd	zmm9, [srcreg+srcoff]		;; R1
	vmovapd	zmm10, [srcreg+srcoff+d4]	;; R5
	vaddpd	zmm8, zmm9, zmm10		;; R1 + R5 (new R1)					; 5-8		n 13
	vsubpd	zmm9, zmm9, zmm10		;; R1 - R5 (new R5)					; 5-8		n 16

	vmovapd	zmm11, [srcreg+srcoff+d2]	;; R3
	vmovapd	zmm12, [srcreg+srcoff+d4+d2]	;; R7
	vaddpd	zmm10, zmm11, zmm12		;; R3 + R7 (new R3)					; 6-9		n 13
	vsubpd	zmm11, zmm11, zmm12		;; R3 - R7 (new R7)					; 6-9		n 15

	vmovapd	zmm13, [srcreg+srcoff+64]	;; I1
	vmovapd	zmm14, [srcreg+srcoff+d4+64]	;; I5
	vaddpd	zmm12, zmm13, zmm14		;; I1 + I5 (new I1)					; 7-10		n 14
	vsubpd	zmm13, zmm13, zmm14		;; I1 - I5 (new I5)					; 7-10		n 15

	vmovapd	zmm15, [srcreg+srcoff+d2+64]	;; I3
	vmovapd	zmm16, [srcreg+srcoff+d4+d2+64]	;; I7
	vaddpd	zmm14, zmm15, zmm16		;; I3 + I7 (new I3)					; 8-11		n 14
	vsubpd	zmm15, zmm15, zmm16		;; I3 - I7 (new I7)					; 8-11		n 16

	L1prefetchw srcreg+L1pd, L1pt
	vsubpd	zmm16, zmm0, zmm2		;; R6 - I8 (new2 R6)					; 9-12		n 17
	vaddpd	zmm0, zmm0, zmm2		;; R6 + I8 (new2 R8)					; 9-12		n 18

	L1prefetchw srcreg+64+L1pd, L1pt
	vaddpd	zmm2, zmm6, zmm4		;; I6 + R8 (new2 I6)					; 10-13		n 17
	vsubpd	zmm6, zmm6, zmm4		;; I6 - R8 (new2 I8)					; 10-13		n 18

	L1prefetchw srcreg+d1+L1pd, L1pt
	vsubpd	zmm4, zmm1, zmm5		;; R2 - R4 (newer R4)					; 11-14		n 19
	vaddpd	zmm1, zmm1, zmm5		;; R2 + R4 (newer R2)					; 11-14		n 20

	L1prefetchw srcreg+d1+64+L1pd, L1pt
	vsubpd	zmm5, zmm7, zmm3		;; I2 - I4 (newer I4)					; 12-15		n 19 
	vaddpd	zmm7, zmm7, zmm3		;; I2 + I4 (newer I2)					; 12-15		n 21

	L1prefetchw srcreg+d2+L1pd, L1pt
	vaddpd	zmm3, zmm8, zmm10		;; R1 + R3 (newer R1)					; 13-16		n 20
	vsubpd	zmm8, zmm8, zmm10		;; R1 - R3 (newer R3)					; 13-16		n 27

	L1prefetchw srcreg+d2+64+L1pd, L1pt
	vaddpd	zmm10, zmm12, zmm14		;; I1 + I3 (newer I1)					; 14-17		n 21
	vsubpd	zmm12, zmm12, zmm14		;; I1 - I3 (newer I3)					; 14-17		n 28

	L1prefetchw srcreg+d2+d1+L1pd, L1pt
	vaddpd	zmm14, zmm13, zmm11		;; I5 + R7 (newer I5)					; 15-18		n 22
	vsubpd	zmm13, zmm13, zmm11		;; I5 - R7 (newer I7)					; 15-18		n 24

	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	vsubpd	zmm11, zmm9, zmm15		;; R5 - I7 (newer R5)					; 16-19		n 23
	vaddpd	zmm9, zmm9, zmm15		;; R5 + I7 (newer R7)					; 16-19		n 25

	L1prefetchw srcreg+d4+L1pd, L1pt
	vaddpd	zmm15, zmm16, zmm2		;; I6 = R6 + I6 (newer I6/SQRTHALF)			; 17-20		n 22
	vsubpd	zmm16, zmm16, zmm2		;; R6 = R6 - I6 (newer R6/SQRTHALF)			; 17-20		n 23

	L1prefetchw srcreg+d4+64+L1pd, L1pt
	vsubpd	zmm2, zmm0, zmm6		;; R8 = R8 - I8 (newer R8/SQRTHALF)			; 18-21		n 24
	vaddpd	zmm0, zmm0, zmm6		;; I8 = R8 + I8 (newer I8/SQRTHALF)			; 18-21		n 25

	vmovapd zmm21, [screg+1*128]		;; sine for R3/I3 and R4/I4
	vmulpd	zmm5, zmm5, zmm21		;; I4S = I4 * sine (newer I4*sine)			; 19-22		n 27
	vmulpd	zmm4, zmm4, zmm21		;; R4S = R4 * sine (newer R4*sine)			; 19-22		n 28

	L1prefetchw srcreg+d4+d1+L1pd, L1pt
	vsubpd	zmm6, zmm3, zmm1		;; R1 - R2 (newest R2)					; 20-23		n 31
	vaddpd	zmm3, zmm3, zmm1		;; R1 + R2 (final R1)					; 20-23		n 35

	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
	vsubpd	zmm1, zmm10, zmm7		;; I1 - I2 (newest I2)					; 21-24		n 31
	vaddpd	zmm10, zmm10, zmm7		;; I1 + I2 (final I1)					; 21-24		n 37

	L1prefetchw srcreg+d4+d2+L1pd, L1pt
	zfmaddpd zmm7, zmm16, zmm31, zmm11	;; R5 + R6 * SQRTHALF (newest R5)			; 22-25		n 26
	zfmaddpd zmm17, zmm15, zmm31, zmm14	;; I5 + I6 * SQRTHALF (newest I5)			; 22-25		n 26

	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
	zfnmaddpd zmm16, zmm16, zmm31, zmm11	;; R5 - R6 * SQRTHALF (newest R6)			; 23-26		n 32
	zfnmaddpd zmm15, zmm15, zmm31, zmm14	;; I5 - I6 * SQRTHALF (newest I6)			; 23-25		n 32

	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	zfmaddpd zmm11, zmm2, zmm31, zmm13	;; I7 + R8 * SQRTHALF (newest I7)			; 24-27		n 29
	zfnmaddpd zmm14, zmm0, zmm31, zmm9	;; R7 - I8 * SQRTHALF (newest R7)			; 24-27		n 29

	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt
	zfnmaddpd zmm2, zmm2, zmm31, zmm13	;; I7 - R8 * SQRTHALF (newest I8)			; 25-28		n 35
	zfmaddpd zmm0, zmm0, zmm31, zmm9	;; R7 + I8 * SQRTHALF (newest R8)			; 25-28		n 35

	vmovapd zmm22, [screg+0*128+64]		;; cosine/sine for R5/I5 and R8/I8
	zfmsubpd zmm13, zmm7, zmm22, zmm17	;; A5 = R5 * cosine/sine - I5				; 26-29		n 30
	zfmaddpd zmm17, zmm17, zmm22, zmm7	;; B5 = I5 * cosine/sine + R5				; 26-29		n 30

	zfmsubpd zmm9, zmm8, zmm21, zmm5	;; R3*sine - I4S (newest R3*sine)			; 27-30		n 33
	zfmaddpd zmm8, zmm8, zmm21, zmm5	;; R3*sine + I4S (newest R4*sine)			; 27-30		n 41

	zfmaddpd zmm5, zmm12, zmm21, zmm4	;; I3*sine + R4S (newest I3*sine)			; 28-31		n 33
	zfmsubpd zmm12, zmm12, zmm21, zmm4	;; I3*sine - R4S (newest I4*sine)			; 28-31		n 41

	vmovapd zmm23, [screg+2*128+64]		;; cosine/sine for R7/I7 and R6/I6
	zfmsubpd zmm7, zmm14, zmm23, zmm11	;; A7 = R7 * cosine/sine - I7				; 29-32		n 34
	zfmaddpd zmm11, zmm11, zmm23, zmm14	;; B7 = I7 * cosine/sine + R7				; 29-32		n 34

	vmovapd zmm24, [screg+0*128]		;; sine for R5/I5 and R8/I8
	vmulpd	zmm13, zmm13, zmm24		;; A5 = A5 * sine (final R5)				; 30-33		n 35
	vmulpd	zmm17, zmm17, zmm24		;; B5 = B5 * sine (final I5)				; 30-33		n 37

	vmovapd zmm25, [screg+3*128+64]		;; cosine/sine for R2/I2
	zfmsubpd zmm4, zmm6, zmm25, zmm1	;; A2 = R2 * cosine/sine - I2				; 31-34		n 37
	zfmaddpd zmm1, zmm1, zmm25, zmm6	;; B2 = I2 * cosine/sine + R2				; 31-34		n 38

	zfmaddpd zmm6, zmm16, zmm23, zmm15	;; A6 = R6 * cosine/sine + I6				; 32-35		n 39
	zfmsubpd zmm15, zmm15, zmm23, zmm16	;; B6 = I6 * cosine/sine - R6				; 32-35		n 40

	vmovapd zmm26, [screg+1*128+64]		;; cosine/sine for R3/I3 and R4/I4
	zfmsubpd zmm16, zmm9, zmm26, zmm5	;; R3 * cosine/sine - I3 (final R3)			; 33-36		n 39
	zfmaddpd zmm5, zmm5, zmm26, zmm9	;; I3 * cosine/sine + R3 (final I3)			; 33-36		n 41

	vmovapd zmm27, [screg+2*128]		;; sine for R7/I7 and R6/I6
	vmulpd	zmm7, zmm7, zmm27		;; A7 = A7 * sine (final R7)				; 34-37		n 39
	vmulpd	zmm11, zmm11, zmm27		;; B7 = B7 * sine (final I7)				; 34-37		n 41

