	vaddpd	zmm11, zmm4, zmm15		;; I13L + I57L (final I13L)				; 131-134	n 137
	vsubpd	zmm4, zmm4, zmm15		;; I13L - I57L (final I57L)				; 132-135	n 137

	vshuff64x2 zmm15, zmm6, zmm16, 01000100b;; R6_7 R5_7 R2_7 R1_7 R6_5 R5_5 R2_5 R1_5 (R68L)	; 133-135	n 137
	vshuff64x2 zmm8, zmm0, zmm2, 01000100b	;; R6_3 R5_3 R2_3 R1_3 R6_1 R5_1 R2_1 R1_1 (R24L)	; 134-136	n 137

	vaddpd	zmm7, zmm10, zmm17		;; R13L + R57L (final R13L)				; 133-136	n 139
	vsubpd	zmm10, zmm10, zmm17		;; R13L - R57L (final R57L)				; 134-137	n 139

	vshuff64x2 zmm0, zmm0, zmm2, 11101110b	;; R8_3 R7_3 R4_3 R3_3 R8_1 R7_1 R4_1 R3_1 (R24H)	; 135-137	n 145
	vshuff64x2 zmm6, zmm6, zmm16, 11101110b	;; R8_7 R7_7 R4_7 R3_7 R8_5 R7_5 R4_5 R3_5 (R68H)	; 136-138	n 145

	zfmaddpd zmm17, zmm14, zmm31, zmm1	;; I24L + I68L * SQRTHALF (final I24L)			; 135-138	n 141
	zfnmaddpd zmm14, zmm14, zmm31, zmm1	;; I24L - I68L * SQRTHALF (final I68L)			; 136-139	n 141

	;; shuffle the four aparts
	vshuff64x2 zmm16, zmm11, zmm4, 11011101b;; I6_6 I5_6 I6_4 I5_4 I6_2 I5_2 I6_0 I5_0		; 137-139	n 145
	vshuff64x2 zmm11, zmm11, zmm4, 10001000b;; I2_6 I1_6 I2_4 I1_4 I2_2 I1_2 I2_0 I1_0		; 138-140	n 149

	zfmaddpd zmm2, zmm15, zmm31, zmm8	;; R24L + R68L * SQRTHALF (final R24L)			; 137-140	n 143
	zfnmaddpd zmm15, zmm15, zmm31, zmm8	;; R24L - R68L * SQRTHALF (final R68L)			; 138-141	n 143

	vshuff64x2 zmm1, zmm7, zmm10, 11011101b	;; R6_6 R5_6 R6_4 R5_4 R6_2 R5_2 R6_0 R5_0		; 139-141	n 146
	vshuff64x2 zmm7, zmm7, zmm10, 10001000b;; R2_6 R1_6 R2_4 R1_4 R2_2 R1_2 R2_0 R1_0		; 140-142	n 150

	vaddpd	zmm4, zmm9, zmm13		;; I13H + I57H (final I13H)				; 139-142	n 153
	vsubpd	zmm9, zmm9, zmm13		;; I13H - I57H (final I57H)				; 140-143	n 153

	vshuff64x2 zmm10, zmm17, zmm14, 11011101b;; I6_7 I5_7 I6_5 I5_5 I6_3 I5_3 I6_1 I5_1		; 141-143	n 145
	vshuff64x2 zmm17, zmm17, zmm14, 10001000b;; I2_7 I1_7 I2_5 I1_5 I2_3 I1_3 I2_1 I1_1		; 142-144	n 149

	vaddpd	zmm13, zmm20, zmm3		;; R13H + R57H (final R13H)				; 141-144	n 157
	vsubpd	zmm20, zmm20, zmm3		;; R13H - R57H (final R57H)				; 142-145	n 157

	vshuff64x2 zmm14, zmm2, zmm15, 11011101b;; R6_7 R5_7 R6_5 R5_5 R6_3 R5_3 R6_1 R5_1		; 143-145	n 146
	vshuff64x2 zmm2, zmm2, zmm15, 10001000b;; R2_7 R1_7 R2_5 R1_5 R2_3 R1_3 R2_1 R1_1		; 144-146	n 150

	zfmaddpd zmm3, zmm5, zmm31, zmm12	;; I24H + I68H * SQRTHALF (final I24H)			; 143-146	n 155
	zfnmaddpd zmm5, zmm5, zmm31, zmm12	;; I24H - I68H * SQRTHALF (final I68H)			; 144-147	n 155

	;; shufpd the one aparts
	vshufpd	zmm15, zmm16, zmm10, 00000000b	;; I5_7 I5_6 I5_5 I5_4 I5_3 I5_2 I5_1 I5_0 (next I5)	; 145		n 147
	vshufpd	zmm12, zmm1, zmm14, 00000000b	;; R5_7 R5_6 R5_5 R5_4 R5_3 R5_2 R5_1 R5_0 (next R5)	; 146		n 147

	zfmaddpd zmm8, zmm6, zmm31, zmm0	;; R24H + R68H * SQRTHALF (final R24H)			; 145-148	n 159
	zfnmaddpd zmm6, zmm6, zmm31, zmm0	;; R24H - R68H * SQRTHALF (final R68H)			; 146-149	n 159

	vshufpd	zmm16, zmm16, zmm10, 11111111b	;; I6_7 I6_6 I6_5 I6_4 I6_3 I6_2 I6_1 I6_0 (next I6)	; 147		n 149
	vshufpd	zmm1, zmm1, zmm14, 11111111b	;; R6_7 R6_6 R6_5 R6_4 R6_3 R6_2 R6_1 R6_0 (next R6)	; 148		n 149

	zfmaddpd zmm0, zmm12, zmm22, zmm15	;; A5 = R5 * cosine/sine + I5				; 147-150	n 153
	zfmsubpd zmm15, zmm15, zmm22, zmm12	;; B5 = I5 * cosine/sine - R5				; 148-151	n 154

	vshufpd	zmm10, zmm11, zmm17, 11111111b	;; I2_7 I2_6 I2_5 I2_4 I2_3 I2_2 I2_1 I2_0 (next I2)	; 149		n 151
	vshufpd	zmm14, zmm7, zmm2, 11111111b	;; R2_7 R2_6 R2_5 R2_4 R2_3 R2_2 R2_1 R2_0 (next R2)	; 150		n 151

	zfmsubpd zmm12, zmm1, zmm23, zmm16	;; A6 = R6 * cosine/sine - I6 (first R6/sine)		; 149-152	n 159
	zfmaddpd zmm16, zmm16, zmm23, zmm1	;; B6 = I6 * cosine/sine + R6 (first I6/sine)		; 150-153	n 161

	vshufpd	zmm11, zmm11, zmm17, 00000000b	;; I1_7 I1_6 I1_5 I1_4 I1_3 I1_2 I1_1 I1_0 (next I1)	; 151		n 155
	vshufpd	zmm7, zmm7, zmm2, 00000000b	;; R1_7 R1_6 R1_5 R1_4 R1_3 R1_2 R1_1 R1_0 (next R1)	; 152		n 157

	zfmsubpd zmm1, zmm10, zmm25, zmm14	;; B2 = I2 * cosine/sine - R2 (first I2/sine)		; 151-154	n 155
	zfmaddpd zmm14, zmm14, zmm25, zmm10	;; A2 = R2 * cosine/sine + I2 (first R2/sine)		; 152-155	n 157

	vshuff64x2 zmm17, zmm4, zmm9, 11011101b	;; I8_6 I7_6 I8_4 I7_4 I8_2 I7_2 I8_0 I7_0		; 153-155	n 161
	vshuff64x2 zmm4, zmm4, zmm9, 10001000b	;; I4_6 I3_6 I4_4 I3_4 I4_2 I3_2 I4_0 I3_0		; 154-156	n 165

	vmulpd	zmm0, zmm0, zmm24		;; A5 = A5 * sine (first R5)				; 153-156	n 159
	vmulpd	zmm15, zmm15, zmm24		;; B5 = B5 * sine (first I5)				; 154-157	n 161

	vshuff64x2 zmm2, zmm3, zmm5, 11011101b;; I8_7 I7_7 I8_5 I7_5 I8_3 I7_3 I8_1 I7_1		; 155-157	n 161
	vshuff64x2 zmm3, zmm3, zmm5, 10001000b;; I4_7 I3_7 I4_5 I3_5 I4_3 I3_3 I4_1 I3_1		; 156-158	n 165

	zfmaddpd zmm10, zmm1, zmm28, zmm11	;; I1 + I2 * sine (new I1)				; 155-158	n 180
	zfnmaddpd zmm1, zmm1, zmm28, zmm11	;; I1 - I2 * sine (new I2)				; 156-159	n 182

	vshuff64x2 zmm9, zmm13, zmm20, 11011101b;; R8_6 R7_6 R8_4 R7_4 R8_2 R7_2 R8_0 R7_0		; 157-159	n 162
	vshuff64x2 zmm13, zmm13, zmm20, 10001000b;; R4_6 R3_6 R4_4 R3_4 R4_2 R3_2 R4_0 R3_0		; 158-160	n 166

	zfmaddpd zmm5, zmm14, zmm28, zmm7	;; R1 + R2 * sine (new R1)				; 157-160	n 179
	zfnmaddpd zmm14, zmm14, zmm28, zmm7	;; R1 - R2 * sine (new R2)				; 158-161	n 181

	vshuff64x2 zmm11, zmm8, zmm6, 11011101b;; R8_7 R7_7 R8_5 R7_5 R8_3 R7_3 R8_1 R7_1		; 159-161	n 162
	vshuff64x2 zmm8, zmm8, zmm6, 10001000b;; R4_7 R3_7 R4_5 R3_5 R4_3 R3_3 R4_1 R3_1		; 160-162	n 166

	zfnmaddpd zmm20, zmm12, zmm27, zmm0	;; R5 - R6 * sine (new R6)				; 159-162	n 175
	zfmaddpd zmm12, zmm12, zmm27, zmm0	;; R5 + R6 * sine (new R5)				; 160-163	n 178

	vshufpd	zmm6, zmm17, zmm2, 11111111b	;; I8_7 I8_6 I8_5 I8_4 I8_3 I8_2 I8_1 I8_0 (next I8)	; 161		n 163
	vshufpd	zmm7, zmm9, zmm11, 11111111b	;; R8_7 R8_6 R8_5 R8_4 R8_3 R8_2 R8_1 R8_0 (next R8)	; 162		n 163

	zfnmaddpd zmm0, zmm16, zmm27, zmm15	;; I5 - I6 * sine (new I6)				; 161-164	n 175
	zfmaddpd zmm16, zmm16, zmm27, zmm15	;; I5 + I6 * sine (new I5)				; 162-165	n 177

	vshufpd	zmm17, zmm17, zmm2, 00000000b	;; I7_7 I7_6 I7_5 I7_4 I7_3 I7_2 I7_1 I7_0 (next I7)	; 163		n 165
	vshufpd	zmm9, zmm9, zmm11, 00000000b	;; R7_7 R7_6 R7_5 R7_4 R7_3 R7_2 R7_1 R7_0 (next R7)	; 164		n 165

	zfmsubpd zmm15, zmm7, zmm22, zmm6	;; A8 = R8 * cosine/sine - I8				; 163-166	n 167
	zfmaddpd zmm6, zmm6, zmm22, zmm7	;; B8 = I8 * cosine/sine + R8				; 164-167	n 168

	vshufpd	zmm2, zmm4, zmm3, 00000000b	;; I3_7 I3_6 I3_5 I3_4 I3_3 I3_2 I3_1 I3_0 (next I3)	; 165		n 169
	vshufpd	zmm7, zmm13, zmm8, 00000000b	;; R3_7 R3_6 R3_5 R3_4 R3_3 R3_2 R3_1 R3_0 (next R3)	; 166		n 169

	zfmaddpd zmm11, zmm9, zmm23, zmm17	;; A7 = R7 * cosine/sine + I7 (first R7/sine)		; 165-168	n 171
	zfmsubpd zmm17, zmm17, zmm23, zmm9	;; B7 = I7 * cosine/sine - R7 (first I7/sine)		; 166-169	n 172

	vshufpd	zmm4, zmm4, zmm3, 11111111b	;; I4_7 I4_6 I4_5 I4_4 I4_3 I4_2 I4_1 I4_0 (next I4)	; 167		n 169
	vshufpd	zmm13, zmm13, zmm8, 11111111b	;; R4_7 R4_6 R4_5 R4_4 R4_3 R4_2 R4_1 R4_0 (next R4)	; 168		n 169

	vmulpd	zmm15, zmm15, zmm24		;; A8 = A8 * sine (first R8)				; 167-170 	n 171
	vmulpd	zmm6, zmm6, zmm24		;; B8 = B8 * sine (first I8)				; 168-171	n 172

	zfmaddpd zmm9, zmm7, zmm26, zmm2	;; A3 = R3 * cosine/sine + I3 (first R3/sine)		; 169-172	n 173
	zfmsubpd zmm3, zmm13, zmm26, zmm4	;; A4 = R4 * cosine/sine - I4 (first R4/sine)		; 169-172	n 173

	zfmsubpd zmm2, zmm2, zmm26, zmm7	;; B3 = I3 * cosine/sine - R3 (first I3/sine)		; 170-173	n 174
	zfmaddpd zmm4, zmm4, zmm26, zmm13	;; B4 = I4 * cosine/sine + R4 (first I4/sine)		; 170-173	n 174

	zfnmaddpd zmm13, zmm11, zmm27, zmm15	;; R8 - R7 * sine (new I8)				; 171-174	n 176
	zfmaddpd zmm11, zmm11, zmm27, zmm15	;; R8 + R7 * sine (new R7)				; 171-174	n 178

	zfmsubpd zmm15, zmm17, zmm27, zmm6	;; I7 * sine - I8 (new R8)				; 172-175	n 176
	zfmaddpd zmm17, zmm17, zmm27, zmm6	;; I7 * sine + I8 (new I7)				; 172-175	n 177

	vaddpd	zmm6, zmm3, zmm9		;; R4/sine + R3/sine (new R3/sine)			; 173-176	n 179
	vsubpd	zmm3, zmm3, zmm9		;; R4/sine - R3/sine (new I4/sine)			; 173-176	n 182

	vaddpd	zmm9, zmm2, zmm4		;; I3/sine + I4/sine (new I3/sine)			; 174-177	n 180
	vsubpd	zmm2, zmm2, zmm4		;; I3/sine - I4/sine (new R4/sine)			; 174-177	n 181

	;; multiply R6/I6 by SQRTHALF - i*SQRTHALF
	vaddpd	zmm4, zmm20, zmm0		;; R6 = R6 + I6						; 175-178	n 183
	vsubpd	zmm20, zmm0, zmm20		;; I6 = I6 - R6						; 175-178	n 184

	;; multiply R8/I8 by SQRTHALF - i*SQRTHALF
	vaddpd	zmm0, zmm15, zmm13		;; R8 = R8 + I8						; 176-179	n 183
	vsubpd	zmm13, zmm13, zmm15		;; I8 = I8 - R8						; 176-179	n 184

	vaddpd	zmm15, zmm16, zmm17		;; I5 + I7 (newer I5)					; 177-180	n 186
	vsubpd	zmm16, zmm16, zmm17		;; I5 - I7 (newer R7)					; 177-180	n 187

	vaddpd	zmm17, zmm11, zmm12		;; R7 + R5 (newer R5)					; 178-181	n 185
	vsubpd	zmm11, zmm11, zmm12		;; R7 - R5 (newer I7)					; 178-181	n 188

	zfmaddpd zmm12, zmm6, zmm21, zmm5	;; R1 + R3 * sine (newer R1)				; 179-182	n 185
	zfnmaddpd zmm6, zmm6, zmm21, zmm5	;; R1 - R3 * sine (newer R3)				; 179-182	n 187

	zfmaddpd zmm5, zmm9, zmm21, zmm10	;; I1 + I3 * sine (newer I1)				; 180-183	n 186
	zfnmaddpd zmm9, zmm9, zmm21, zmm10	;; I1 - I3 * sine (newer I3)				; 180-183	n 188

	zfmaddpd zmm10, zmm2, zmm21, zmm14	;; R2 + R4 * sine (newer R2)				; 181-184	n 189
	zfnmaddpd zmm2, zmm2, zmm21, zmm14	;; R2 - R4 * sine (newer R4)				; 181-184	n 191

	zfmaddpd zmm14, zmm3, zmm21, zmm1	;; I2 + I4 * sine (newer I2)				; 182-185	n 190
	zfnmaddpd zmm3, zmm3, zmm21, zmm1	;; I2 - I4 * sine (newer I4)				; 182-185	n 192

	vaddpd	zmm1, zmm0, zmm4		;; R8 + R6 (newer R6/SQRTHALF)				; 183-186	n 189
	vsubpd	zmm0, zmm0, zmm4		;; R8 - R6 (newer I8/SQRTHALF)				; 183-186	n 192

	vaddpd	zmm4, zmm20, zmm13		;; I6 + I8 (newer I6/SQRTHALF)				; 184-187	n 190
	vsubpd	zmm20, zmm20, zmm13		;; I6 - I8 (newer R8/SQRTHALF)				; 184-187	n 191

	vsubpd	zmm13, zmm12, zmm17		;; R1 - R5 (final R5)					; 185-188
	vaddpd	zmm12, zmm12, zmm17		;; R1 + R5 (final R1)					; 185-188

	vsubpd	zmm17, zmm5, zmm15		;; I1 - I5 (final I5)					; 186-189
	vaddpd	zmm5, zmm5, zmm15		;; I1 + I5 (final I1)					; 186-189

	vaddpd	zmm15, zmm6, zmm16		;; R3 + R7 (final R3)					; 187-190
	vsubpd	zmm6, zmm6, zmm16		;; R3 - R7 (final R7)					; 187-190

	vaddpd	zmm16, zmm9, zmm11		;; I3 + I7 (final I3)					; 188-191
	vsubpd	zmm9, zmm9, zmm11		;; I3 - I7 (final I7)					; 188-191

	zfmaddpd zmm11, zmm1, zmm31, zmm10	;; R2 + R6 * SQRTHALF (final R2)			; 189-192
	zfnmaddpd zmm1, zmm1, zmm31, zmm10	;; R2 - R6 * SQRTHALF (final R6)			; 189-192
	zstore	[srcreg+d4], zmm13		;; Save R5						; 189

	zfmaddpd zmm10, zmm4, zmm31, zmm14	;; I2 + I6 * SQRTHALF (final I2)			; 190-193
	zfnmaddpd zmm4, zmm4, zmm31, zmm14	;; I2 - I6 * SQRTHALF (final I6)			; 190-193
	zstore	[srcreg], zmm12			;; Save R1						; 189+1

	zfnmaddpd zmm14, zmm20, zmm31, zmm2	;; R4 - R8 * SQRTHALF (final R8)			; 191-194
	zfmaddpd zmm20, zmm20, zmm31, zmm2	;; R4 + R8 * SQRTHALF (final R4)			; 191-194
	zstore	[srcreg+d4+64], zmm17		;; Save I5						; 190+1

	zfnmaddpd zmm2, zmm0, zmm31, zmm3	;; I4 - I8 * SQRTHALF (final I8)			; 192-195
	zfmaddpd zmm0, zmm0, zmm31, zmm3	;; I4 + I8 * SQRTHALF (final I4)			; 192-195
	zstore	[srcreg+64], zmm5		;; Save I1						; 190+2

	bump	screg, scinc
	zstore	[srcreg+d2], zmm15		;; Save R3						; 191+2
	zstore	[srcreg+d4+d2], zmm6		;; Save R7						; 191+3
	zstore	[srcreg+d2+64], zmm16		;; Save I3						; 192+3
	zstore	[srcreg+d4+d2+64], zmm9		;; Save I7						; 192+4
	zstore	[srcreg+d1], zmm11		;; Save R2						; 193+4
	zstore	[srcreg+d4+d1], zmm1		;; Save R6						; 193+5
	zstore	[srcreg+d1+64], zmm10		;; Save I2						; 194+5
	zstore	[srcreg+d4+d1+64], zmm4		;; Save I6						; 194+6
	zstore	[srcreg+d4+d2+d1], zmm14	;; Save R8						; 195+6
	zstore	[srcreg+d2+d1], zmm20		;; Save R4						; 195+7
	zstore	[srcreg+d4+d2+d1+64], zmm2	;; Save I8						; 196+7
	zstore	[srcreg+d2+d1+64], zmm0		;; Save I4						; 196+8
	bump	srcreg, srcinc
	ENDM


zr64f_sixtyfour_complex_with_mulf_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	ENDM
zr64f_sixtyfour_complex_with_mulf MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	;; Multiply the complex numbers
	vmovapd	zmm3, [srcreg][rbx]		;; R1
	vmovapd	zmm4, [srcreg+64][rbx]		;; I1
	vmovapd	zmm1, [srcreg+rbp]		;; MemR1
	vmulpd	zmm14, zmm3, zmm1		;; A1 = R1 * MemR1					; 92-95		n 96
	vmulpd	zmm0, zmm4, zmm1		;; B1 = I1 * MemR1					; 92-95		n 96

	vmovapd	zmm10, [srcreg+d1][rbx]		;; R2
	vmovapd	zmm15, [srcreg+d1+64][rbx]	;; I2
	vmovapd	zmm1, [srcreg+rbp+d1]		;; MemR2
	vmulpd	zmm9, zmm10, zmm1		;; A2 = R2 * MemR2					; 93-96		n 97
	vmulpd	zmm16, zmm15, zmm1		;; B2 = I2 * MemR2					; 93-96		n 97

	vmovapd	zmm12, [srcreg+d2][rbx]		;; R3
	vmovapd	zmm18, [srcreg+d2+d1][rbx]	;; R4
	vmovapd	zmm1, [srcreg+rbp+d2]		;; MemR3
	vmulpd	zmm13, zmm12, zmm1		;; A3 = R3 * MemR3					; 94-97		n 100
	vmovapd	zmm6, [srcreg+rbp+d2+d1]	;; MemR4
	vmulpd	zmm8, zmm18, zmm6		;; A4 = R4 * MemR4					; 94-97		n 100

	vmovapd	zmm19, [srcreg+d2+64][rbx]	;; I3
	vmovapd	zmm20, [srcreg+d2+d1+64][rbx]	;; I4
	vmulpd	zmm2, zmm19, zmm1		;; B3 = I3 * MemR3					; 95-98		n 101
	vmulpd	zmm5, zmm20, zmm6		;; B4 = I4 * MemR4					; 95-98		n 101

	vmovapd zmm1, [srcreg+rbp+64]		;; MemI1
	zfnmaddpd zmm14, zmm4, zmm1, zmm14	;; A1 - I1 * MemI1 (R1)					; 96-99		n 114
	zfmaddpd zmm0, zmm3, zmm1, zmm0		;; B1 + R1 * MemI1 (I1)					; 96-99		n 106

	vmovapd zmm1, [srcreg+rbp+d1+64]	;; MemI2
	zfnmaddpd zmm9, zmm15, zmm1, zmm9	;; A2 - I2 * MemI2 (R2)					; 97-100	n 114
	zfmaddpd zmm16, zmm10, zmm1, zmm16	;; B2 + R2 * MemI2 (I2)					; 97-100	n 106

	vmovapd	zmm3, [srcreg+d4+64][rbx]	;; I5
	vmovapd	zmm4, [srcreg+d4+d1+64][rbx]	;; I6
	vmovapd	zmm7, [srcreg+rbp+d4]		;; MemR5
	vmulpd	zmm1, zmm3, zmm7		;; B5 = I5 * MemR5					; 98-101	n 102
