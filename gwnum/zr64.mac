	zfnmaddpd zmm3, zmm3, zmm21, zmm1	;; I2 - I4 * sine (newer I4)				; 182-185	n 192

	vaddpd	zmm1, zmm0, zmm4		;; R8 + R6 (newer R6/SQRTHALF)				; 183-186	n 189
	vsubpd	zmm0, zmm0, zmm4		;; R8 - R6 (newer I8/SQRTHALF)				; 183-186	n 192

	vaddpd	zmm4, zmm20, zmm13		;; I6 + I8 (newer I6/SQRTHALF)				; 184-187	n 190
	vsubpd	zmm20, zmm20, zmm13		;; I6 - I8 (newer R8/SQRTHALF)				; 184-187	n 191

	zfnmaddpd zmm13, zmm17, zmm29, zmm12	;; R1 - SQRT2*R5 (final R5)				; 185-188
	zfmaddpd zmm12, zmm17, zmm29, zmm12	;; R1 + SQRT2*R5 (final R1)				; 185-188

	zfnmaddpd zmm17, zmm15, zmm29, zmm5	;; I1 - SQRT2*I5 (final I5)				; 186-189
	zfmaddpd zmm5, zmm15, zmm29, zmm5	;; I1 + SQRT2*I5 (final I1)				; 186-189

	zfmaddpd zmm15, zmm16, zmm29, zmm6	;; R3 + SQRT2*R7 (final R3)				; 187-190
	zfnmaddpd zmm6, zmm16, zmm29, zmm6	;; R3 - SQRT2*R7 (final R7)				; 187-190

	zfmaddpd zmm16, zmm11, zmm29, zmm9	;; I3 + SQRT2*I7 (final I3)				; 188-191
	zfnmaddpd zmm9, zmm11, zmm29, zmm9	;; I3 - SQRT2*I7 (final I7)				; 188-191

	vaddpd zmm11, zmm10, zmm1		;; R2 + R6 (final R2)					; 189-192
	vsubpd zmm1, zmm10, zmm1		;; R2 - R6 (final R6)					; 189-192
	zstore	[srcreg+d4], zmm13		;; Save R5						; 189

	vaddpd zmm10, zmm14, zmm4		;; I2 + I6 (final I2)					; 190-193
	vsubpd zmm4, zmm14, zmm4		;; I2 - I6 (final I6)					; 190-193
	zstore	[srcreg], zmm12			;; Save R1						; 189+1

	vsubpd zmm14, zmm2, zmm20		;; R4 - R8 (final R8)					; 191-194
	vaddpd zmm20, zmm2, zmm20		;; R4 + R8 (final R4)					; 191-194
	zstore	[srcreg+d4+64], zmm17		;; Save I5						; 190+1

	vsubpd zmm2, zmm3, zmm0			;; I4 - I8 (final I8)					; 192-195
	vaddpd zmm0, zmm3, zmm0			;; I4 + I8 (final I4)					; 192-195
	zstore	[srcreg+64], zmm5		;; Save I1						; 190+2

	bump	screg, scinc
	zstore	[srcreg+d2], zmm15		;; Save R3						; 191+2
	zstore	[srcreg+d4+d2], zmm6		;; Save R7						; 191+3
	zstore	[srcreg+d2+64], zmm16		;; Save I3						; 192+3
	zstore	[srcreg+d4+d2+64], zmm9		;; Save I7						; 192+4
	zstore	[srcreg+d1], zmm11		;; Save R2						; 193+4
	zstore	[srcreg+d4+d1], zmm1		;; Save R6						; 193+5
	zstore	[srcreg+d1+64], zmm10		;; Save I2						; 194+5
	zstore	[srcreg+d4+d1+64], zmm4		;; Save I6						; 194+6
	zstore	[srcreg+d4+d2+d1], zmm14	;; Save R8						; 195+6
	zstore	[srcreg+d2+d1], zmm20		;; Save R4						; 195+7
	zstore	[srcreg+d4+d2+d1+64], zmm2	;; Save I8						; 196+7
	zstore	[srcreg+d2+d1+64], zmm0		;; Save I4						; 196+8
	bump	srcreg, srcinc
	ENDM



zr64f_sixtyfour_complex_with_mulf_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	vbroadcastsd zmm29, ZMM_SQRT2
	ENDM
zr64f_sixtyfour_complex_with_mulf MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	;; Multiply the complex numbers
	vmovapd	zmm3, [srcreg][rbx]		;; R1
	vmovapd	zmm4, [srcreg+64][rbx]		;; I1
	vmovapd	zmm1, [srcreg+rbp]		;; MemR1
	vmulpd	zmm14, zmm3, zmm1		;; A1 = R1 * MemR1					; 92-95		n 96
	vmulpd	zmm0, zmm4, zmm1		;; B1 = I1 * MemR1					; 92-95		n 96

	vmovapd	zmm10, [srcreg+d1][rbx]		;; R2
	vmovapd	zmm15, [srcreg+d1+64][rbx]	;; I2
	vmovapd	zmm1, [srcreg+rbp+d1]		;; MemR2
	vmulpd	zmm9, zmm10, zmm1		;; A2 = R2 * MemR2					; 93-96		n 97
	vmulpd	zmm16, zmm15, zmm1		;; B2 = I2 * MemR2					; 93-96		n 97

	vmovapd	zmm12, [srcreg+d2][rbx]		;; R3
	vmovapd	zmm18, [srcreg+d2+d1][rbx]	;; R4
	vmovapd	zmm1, [srcreg+rbp+d2]		;; MemR3
	vmulpd	zmm13, zmm12, zmm1		;; A3 = R3 * MemR3					; 94-97		n 100
	vmovapd	zmm6, [srcreg+rbp+d2+d1]	;; MemR4
	vmulpd	zmm8, zmm18, zmm6		;; A4 = R4 * MemR4					; 94-97		n 100

	vmovapd	zmm19, [srcreg+d2+64][rbx]	;; I3
	vmovapd	zmm20, [srcreg+d2+d1+64][rbx]	;; I4
	vmulpd	zmm2, zmm19, zmm1		;; B3 = I3 * MemR3					; 95-98		n 101
	vmulpd	zmm5, zmm20, zmm6		;; B4 = I4 * MemR4					; 95-98		n 101

	vmovapd zmm1, [srcreg+rbp+64]		;; MemI1
	zfnmaddpd zmm14, zmm4, zmm1, zmm14	;; A1 - I1 * MemI1 (R1)					; 96-99		n 114
	zfmaddpd zmm0, zmm3, zmm1, zmm0		;; B1 + R1 * MemI1 (I1)					; 96-99		n 106

	vmovapd zmm1, [srcreg+rbp+d1+64]	;; MemI2
	zfnmaddpd zmm9, zmm15, zmm1, zmm9	;; A2 - I2 * MemI2 (R2)					; 97-100	n 114
	zfmaddpd zmm16, zmm10, zmm1, zmm16	;; B2 + R2 * MemI2 (I2)					; 97-100	n 106

	vmovapd	zmm3, [srcreg+d4+64][rbx]	;; I5
	vmovapd	zmm4, [srcreg+d4+d1+64][rbx]	;; I6
	vmovapd	zmm7, [srcreg+rbp+d4]		;; MemR5
	vmulpd	zmm1, zmm3, zmm7		;; B5 = I5 * MemR5					; 98-101	n 102
	vmovapd	zmm6, [srcreg+rbp+d4+d1]	;; MemR6
	vmulpd	zmm11, zmm4, zmm6		;; B6 = I6 * MemR6					; 98-101	n 102

	vmovapd	zmm15, [srcreg+d4][rbx]		;; R5
	vmovapd	zmm10, [srcreg+d4+d1][rbx]	;; R6
	vmulpd	zmm17, zmm15, zmm7		;; A5 = R5 * MemR5					; 99-102	n 103
	vmulpd	zmm7, zmm10, zmm6		;; A6 = R6 * MemR6					; 99-102	n 103

	vmovapd zmm6, [srcreg+rbp+d2+64]	;; MemI3
	zfnmaddpd zmm13, zmm19, zmm6, zmm13	;; A3 - I3 * MemI3 (R3)					; 100-103	n 115
	vmovapd zmm19, [srcreg+rbp+d2+d1+64]	;; MemI4
	zfnmaddpd zmm8, zmm20, zmm19, zmm8	;; A4 - I4 * MemI4 (R4)					; 100-103	n 115

	zfmaddpd zmm2, zmm12, zmm6, zmm2	;; B3 + R3 * MemI3 (I3)					; 101-104	n 107
	zfmaddpd zmm5, zmm18, zmm19, zmm5	;; B4 + R4 * MemI4 (I4)					; 101-104	n 107

	vmovapd zmm20, [srcreg+rbp+d4+64]	;; MemI5
	zfmaddpd zmm1, zmm15, zmm20, zmm1	;; B5 + R5 * MemI5 (I5)					; 102-105	n 111
	vmovapd zmm6, [srcreg+rbp+d4+d1+64]	;; MemI6
	zfmaddpd zmm11, zmm10, zmm6, zmm11	;; B6 + R6 * MemI6 (I6)					; 102-105	n 111

	zfnmaddpd zmm17, zmm3, zmm20, zmm17	;; A5 - I5 * MemI5 (R5)					; 103-106	n 110
	zfnmaddpd zmm7, zmm4, zmm6, zmm7	;; A6 - I6 * MemI6 (R6)					; 103-106	n 110

	vmovapd	zmm18, [srcreg+d4+d2][rbx]	;; R7
	vmovapd	zmm3, [srcreg+d4+d2+d1][rbx]	;; R8
	vmovapd	zmm12, [srcreg+rbp+d4+d2]	;; MemR7
	vmulpd	zmm19, zmm18, zmm12		;; A7 = R7 * MemR7					; 104-107	n 108
	vmovapd	zmm20, [srcreg+rbp+d4+d2+d1]	;; MemR8
	vmulpd	zmm4, zmm3, zmm20		;; A8 = R8 * MemR8					; 104-107	n 108

	vmovapd	zmm15, [srcreg+d4+d2+64][rbx]	;; I7
	vmovapd	zmm10, [srcreg+d4+d2+d1+64][rbx];; I8
	vmulpd	zmm6, zmm15, zmm12		;; B7 = I7 * MemR7					; 105-108	n 109
	vmulpd	zmm12, zmm10, zmm20		;; B8 = I8 * MemR8					; 105-108	n 109

	vaddpd	zmm20, zmm0, zmm16		;; I1 + I2 (new I1)					; 106-109	n 116
	vsubpd	zmm0, zmm0, zmm16		;; I1 - I2 (new I2)					; 106-109	n 123

	vaddpd	zmm16, zmm2, zmm5		;; I3 + I4 (new I3)					; 107-110	n 116
	vsubpd	zmm2, zmm2, zmm5		;; I3 - I4 (new R4)					; 107-110	n 129

	vmovapd zmm5, [srcreg+rbp+d4+d2+64]	;; MemI7
	zfnmaddpd zmm19, zmm15, zmm5, zmm19	;; A7 - I7 * MemI7 (R7)					; 108-111	n 112
	vmovapd zmm15, [srcreg+rbp+d4+d2+d1+64]	;; MemI8
	zfnmaddpd zmm4, zmm10, zmm15, zmm4	;; A8 - I8 * MemI8 (R8)					; 108-111	n 112

	zfmaddpd zmm6, zmm18, zmm5, zmm6	;; B7 + R7 * MemI7 (I7)					; 109-112	n 113
	zfmaddpd zmm12, zmm3, zmm15, zmm12	;; B8 + R8 * MemI8 (I8)					; 109-112	n 113

	L1prefetchw srcreg+L1pd, L1pt
	vaddpd	zmm10, zmm17, zmm7		;; R5 + R6 (new R5)					; 110-113	n 117
	vsubpd	zmm17, zmm17, zmm7		;; R5 - R6 (new R6)					; 110-113	n 119

	L1prefetchw srcreg+64+L1pd, L1pt
	vaddpd	zmm5, zmm1, zmm11		;; I5 + I6 (new I5)					; 111-114	n 118
	vsubpd	zmm1, zmm1, zmm11		;; I5 - I6 (new I6)					; 111-114	n 119

	L1prefetchw srcreg+d1+L1pd, L1pt
	vaddpd	zmm3, zmm4, zmm19		;; R8 + R7 (new R7)					; 112-115	n 117
	vsubpd	zmm4, zmm4, zmm19		;; R8 - R7 (new I8)					; 112-115	n 120

	L1prefetchw srcreg+d1+64+L1pd, L1pt
	vaddpd	zmm7, zmm6, zmm12		;; I7 + I8 (new I7)					; 113-116	n 118
	vsubpd	zmm6, zmm6, zmm12		;; I7 - I8 (new R8)					; 113-116	n 120

	L1prefetchw srcreg+d2+L1pd, L1pt
	vaddpd	zmm11, zmm14, zmm9		;; R1 + R2 (new R1)					; 114-117	n 121
	vsubpd	zmm14, zmm14, zmm9		;; R1 - R2 (new R2)					; 114-117	n 129

	L1prefetchw srcreg+d2+64+L1pd, L1pt
 	vaddpd	zmm15, zmm8, zmm13		;; R4 + R3 (new R3)					; 115-118	n 121
	vsubpd	zmm8, zmm8, zmm13		;; R4 - R3 (new I4)					; 115-118	n 123

	L1prefetchw srcreg+d2+d1+L1pd, L1pt
	vaddpd	zmm9, zmm20, zmm16		;; I1 + I3 (newer I1)					; 116-119	n 121
	vsubpd	zmm20, zmm20, zmm16		;; I1 - I3 (newer I3)					; 116-119	n 121

	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	vsubpd	zmm12, zmm3, zmm10		;; R7 - R5 (newer I7)					; 117-120	n 123
	vaddpd	zmm3, zmm3, zmm10		;; R7 + R5 (newer R5)					; 117-120	n 125

	L1prefetchw srcreg+d4+L1pd, L1pt
	vaddpd	zmm13, zmm5, zmm7		;; I5 + I7 (newer I5)					; 118-121	n 123
	vsubpd	zmm5, zmm5, zmm7		;; I5 - I7 (newer R7)					; 118-121	n 125

	;; multiply R6/I6 by SQRTHALF - i*SQRTHALF
	L1prefetchw srcreg+d4+64+L1pd, L1pt
	vsubpd	zmm16, zmm1, zmm17		;; I6 = I6 - R6						; 119-122	n 125
	vaddpd	zmm1, zmm17, zmm1		;; R6 = R6 + I6						; 119-122	n 127

	;; multiply R8/I8 by SQRTHALF - i*SQRTHALF
	L1prefetchw srcreg+d4+d1+L1pd, L1pt
	vsubpd	zmm10, zmm4, zmm6		;; I8 = I8 - R8						; 120-123	n 125
	vaddpd	zmm6, zmm6, zmm4		;; R8 = R8 + I8						; 120-123	n 127

	;; shuffle inputs are:
	;; R1 = R8_0 R7_0 R4_0 R3_0 R6_0 R5_0 R2_0 R1_0	goal new R1 is  R1_7 R1_6 R1_5 R1_4 R1_3 R1_2 R1_1 R1_0
	;; R2 = R8_1 R7_1 R4_1 R3_1 R6_1 R5_1 R2_1 R1_1	goal new R2 is  R2_7 R2_6 R2_5 R2_4 R2_3 R2_2 R2_1 R2_0, etc.
	;; I1 = I8_0 I7_0 I4_0 I3_0 I6_0 I5_0 I2_0 I1_0	goal new I1 is  I1_7 I1_6 I1_5 I1_4 I1_3 I1_2 I1_1 I1_0, etc.
	;; shuffle the two aparts		(can be done before last FFT level!)
	vshuff64x2 zmm4, zmm9, zmm20, 01000100b	;; I6_2 I5_2 I2_2 I1_2 I6_0 I5_0 I2_0 I1_0 (I13L)	; 121-123	n 131
	vshuff64x2 zmm9, zmm9, zmm20, 11101110b;; I8_2 I7_2 I4_2 I3_2 I8_0 I7_0 I4_0 I3_0 (I13H)	; 122-124	n 139

	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
	vaddpd	zmm20, zmm11, zmm15		;; R1 + R3 (newer R1)					; 121-124	n 127
	vsubpd	zmm11, zmm11, zmm15		;; R1 - R3 (newer R3)					; 122-125	n 127

	vshuff64x2 zmm15, zmm13, zmm12, 01000100b;; I6_6 I5_6 I2_6 I1_6 I6_4 I5_4 I2_4 I1_4 (I57L)	; 123-125	n 131
	vshuff64x2 zmm13, zmm13, zmm12, 11101110b;; I8_6 I7_6 I4_6 I3_6 I8_4 I7_4 I4_4 I3_4 (I57H)	; 124-126	n 139

	L1prefetchw srcreg+d4+d2+L1pd, L1pt
 	vaddpd	zmm12, zmm0, zmm8		;; I2 + I4 (newer I2)					; 123-126	n 129
	vsubpd	zmm0, zmm0, zmm8		;; I2 - I4 (newer I4)					; 124-127	n 129

	vshuff64x2 zmm17, zmm3, zmm5, 01000100b	;; R6_6 R5_6 R2_6 R1_6 R6_4 R5_4 R2_4 R1_4 (R57L)	; 125-127	n 133
	vshuff64x2 zmm3, zmm3, zmm5, 11101110b	;; R8_6 R7_6 R4_6 R3_6 R8_4 R7_4 R4_4 R3_4 (R57H)	; 126-128	n 141

	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
	vaddpd	zmm5, zmm16, zmm10		;; I6 + I8 (newer I6/SQRTHALF)				; 125-128	n 131
	vsubpd	zmm16, zmm16, zmm10		;; I6 - I8 (newer R8/SQRTHALF)				; 126-129	n 133

	vshuff64x2 zmm10, zmm20, zmm11, 01000100b;; R6_2 R5_2 R2_2 R1_2 R6_0 R5_0 R2_0 R1_0 (R13L)	; 127-129	n 133
	vshuff64x2 zmm20, zmm20, zmm11, 11101110b;; R8_2 R7_2 R4_2 R3_2 R8_0 R7_0 R4_0 R3_0 (R13H)	; 128-130	n 141

	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	vsubpd	zmm11, zmm6, zmm1		;; R8 - R6 (newer I8/SQRTHALF)				; 127-130	n 131
	vaddpd	zmm6, zmm6, zmm1		;; R8 + R6 (newer R6/SQRTHALF)				; 128-131	n 133

	vshuff64x2 zmm1, zmm12, zmm0, 01000100b;; I6_3 I5_3 I2_3 I1_3 I6_1 I5_1 I2_1 I1_1 (I24L)	; 129-131	n 135
	vshuff64x2 zmm12, zmm12, zmm0, 11101110b;; I8_3 I7_3 I4_3 I3_3 I8_1 I7_1 I4_1 I3_1 (I24H)	; 130-132	n 143

	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt
	vaddpd	zmm0, zmm14, zmm2		;; R2 + R4 (newer R2)					; 129-132	n 134
	vsubpd	zmm2, zmm14, zmm2		;; R2 - R4 (newer R4)					; 130-133	n 134

	vshuff64x2 zmm14, zmm5, zmm11, 01000100b;; I6_7 I5_7 I2_7 I1_7 I6_5 I5_5 I2_5 I1_5 (I68L)	; 131-133	n 135
	vshuff64x2 zmm5, zmm5, zmm11, 11101110b	;; I8_7 I7_7 I4_7 I3_7 I8_5 I7_5 I4_5 I3_5 (I68H)	; 132-134	n 143

	vaddpd	zmm11, zmm4, zmm15		;; I13L + I57L (final I13L)				; 131-134	n 137
	vsubpd	zmm4, zmm4, zmm15		;; I13L - I57L (final I57L)				; 132-135	n 137

	vshuff64x2 zmm15, zmm6, zmm16, 01000100b;; R6_7 R5_7 R2_7 R1_7 R6_5 R5_5 R2_5 R1_5 (R68L)	; 133-135	n 137
	vshuff64x2 zmm8, zmm0, zmm2, 01000100b	;; R6_3 R5_3 R2_3 R1_3 R6_1 R5_1 R2_1 R1_1 (R24L)	; 134-136	n 137

	vaddpd	zmm7, zmm10, zmm17		;; R13L + R57L (final R13L)				; 133-136	n 139
	vsubpd	zmm10, zmm10, zmm17		;; R13L - R57L (final R57L)				; 134-137	n 139

	vshuff64x2 zmm0, zmm0, zmm2, 11101110b	;; R8_3 R7_3 R4_3 R3_3 R8_1 R7_1 R4_1 R3_1 (R24H)	; 135-137	n 145
	vshuff64x2 zmm6, zmm6, zmm16, 11101110b	;; R8_7 R7_7 R4_7 R3_7 R8_5 R7_5 R4_5 R3_5 (R68H)	; 136-138	n 145

	zfmaddpd zmm17, zmm14, zmm31, zmm1	;; I24L + I68L * SQRTHALF (final I24L)			; 135-138	n 141
	zfnmaddpd zmm14, zmm14, zmm31, zmm1	;; I24L - I68L * SQRTHALF (final I68L)			; 136-139	n 141

	;; shuffle the four aparts
	vshuff64x2 zmm16, zmm11, zmm4, 11011101b;; I6_6 I5_6 I6_4 I5_4 I6_2 I5_2 I6_0 I5_0		; 137-139	n 145
	vshuff64x2 zmm11, zmm11, zmm4, 10001000b;; I2_6 I1_6 I2_4 I1_4 I2_2 I1_2 I2_0 I1_0		; 138-140	n 149

	zfmaddpd zmm2, zmm15, zmm31, zmm8	;; R24L + R68L * SQRTHALF (final R24L)			; 137-140	n 143
	zfnmaddpd zmm15, zmm15, zmm31, zmm8	;; R24L - R68L * SQRTHALF (final R68L)			; 138-141	n 143

	vshuff64x2 zmm1, zmm7, zmm10, 11011101b	;; R6_6 R5_6 R6_4 R5_4 R6_2 R5_2 R6_0 R5_0		; 139-141	n 146
	vshuff64x2 zmm7, zmm7, zmm10, 10001000b;; R2_6 R1_6 R2_4 R1_4 R2_2 R1_2 R2_0 R1_0		; 140-142	n 150

	vaddpd	zmm4, zmm9, zmm13		;; I13H + I57H (final I13H)				; 139-142	n 153
	vsubpd	zmm9, zmm9, zmm13		;; I13H - I57H (final I57H)				; 140-143	n 153

	vshuff64x2 zmm10, zmm17, zmm14, 11011101b;; I6_7 I5_7 I6_5 I5_5 I6_3 I5_3 I6_1 I5_1		; 141-143	n 145
	vshuff64x2 zmm17, zmm17, zmm14, 10001000b;; I2_7 I1_7 I2_5 I1_5 I2_3 I1_3 I2_1 I1_1		; 142-144	n 149

	vaddpd	zmm13, zmm20, zmm3		;; R13H + R57H (final R13H)				; 141-144	n 157
	vsubpd	zmm20, zmm20, zmm3		;; R13H - R57H (final R57H)				; 142-145	n 157

