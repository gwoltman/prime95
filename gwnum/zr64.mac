;;
;; Macros for an AVX-512 radix-64 final step in pass 2 of an FFT.  This is simply an eight-complex
;; forward FFT, swizzle, eight-complex-with-square, swizzle, eight-complex inverse FFT.  No
;; floating point operations are saved, but we do eliminate 32 loads and 32 stores as well as
;; perform the maximum amount of work while data is in registers and we reduce L1 cache thrashing.
;;


;;; BUG is scinc always zero???  Can we preload some of the sin/cos values??  Can we in any way reduce operations
;;; because we know what the sin/cos values are??  pre-swizzle them and use some FMA instructions??


zr64_sixtyfour_complex_fft_final_preload MACRO
	zr64_64c_fft_cmn_preload
	ENDM
zr64_sixtyfour_complex_fft_final MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	zr64_64c_fft_cmn srcreg,0,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	ENDM
zr64f_sixtyfour_complex_fft_final_preload MACRO
	zr64_64c_fft_cmn_preload
	ENDM
zr64f_sixtyfour_complex_fft_final MACRO srcreg,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	zr64_64c_fft_cmn srcreg,rbx,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	ENDM

zr64_64c_fft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	ENDM
zr64_64c_fft_cmn MACRO srcreg,srcoff,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm1, [srcreg+srcoff+d1]	;; R2
	vmovapd	zmm2, [srcreg+srcoff+d4+d1]	;; R6
	vsubpd	zmm0, zmm1, zmm2		;; R2 - R6 (new R6)					; 1-4		n 9
	vaddpd	zmm1, zmm1, zmm2		;; R2 + R6 (new R2)					; 1-4		n 11

	vmovapd	zmm3, [srcreg+srcoff+d2+d1+64]	;; I4
	vmovapd	zmm4, [srcreg+srcoff+d4+d2+d1+64] ;; I8
	vsubpd	zmm2, zmm3, zmm4		;; I4 - I8 (new I8)					; 2-5		n 9
	vaddpd	zmm3, zmm3, zmm4		;; I4 + I8 (new I4)					; 2-5		n 12

	vmovapd	zmm5, [srcreg+srcoff+d2+d1]	;; R4
	vmovapd	zmm6, [srcreg+srcoff+d4+d2+d1]	;; R8
	vsubpd	zmm4, zmm5, zmm6		;; R4 - R8 (new R8)					; 3-6		n 10
	vaddpd	zmm5, zmm5, zmm6		;; R4 + R8 (new R4)					; 3-6		n 11

	vmovapd	zmm7, [srcreg+srcoff+d1+64]	;; I2
	vmovapd	zmm8, [srcreg+srcoff+d4+d1+64]	;; I6
	vsubpd	zmm6, zmm7, zmm8		;; I2 - I6 (new I6)					; 4-7		n 10
	vaddpd	zmm7, zmm7, zmm8		;; I2 + I6 (new I2)					; 4-7		n 12

	vmovapd	zmm9, [srcreg+srcoff]		;; R1
	vmovapd	zmm10, [srcreg+srcoff+d4]	;; R5
	vaddpd	zmm8, zmm9, zmm10		;; R1 + R5 (new R1)					; 5-8		n 13
	vsubpd	zmm9, zmm9, zmm10		;; R1 - R5 (new R5)					; 5-8		n 16

	vmovapd	zmm11, [srcreg+srcoff+d2]	;; R3
	vmovapd	zmm12, [srcreg+srcoff+d4+d2]	;; R7
	vaddpd	zmm10, zmm11, zmm12		;; R3 + R7 (new R3)					; 6-9		n 13
	vsubpd	zmm11, zmm11, zmm12		;; R3 - R7 (new R7)					; 6-9		n 15

	vmovapd	zmm13, [srcreg+srcoff+64]	;; I1
	vmovapd	zmm14, [srcreg+srcoff+d4+64]	;; I5
	vaddpd	zmm12, zmm13, zmm14		;; I1 + I5 (new I1)					; 7-10		n 14
	vsubpd	zmm13, zmm13, zmm14		;; I1 - I5 (new I5)					; 7-10		n 15

	vmovapd	zmm15, [srcreg+srcoff+d2+64]	;; I3
	vmovapd	zmm16, [srcreg+srcoff+d4+d2+64]	;; I7
	vaddpd	zmm14, zmm15, zmm16		;; I3 + I7 (new I3)					; 8-11		n 14
	vsubpd	zmm15, zmm15, zmm16		;; I3 - I7 (new I7)					; 8-11		n 16

	L1prefetchw srcreg+L1pd, L1pt
	vsubpd	zmm16, zmm0, zmm2		;; R6 - I8 (new2 R6)					; 9-12		n 17
	vaddpd	zmm0, zmm0, zmm2		;; R6 + I8 (new2 R8)					; 9-12		n 18

	L1prefetchw srcreg+64+L1pd, L1pt
	vaddpd	zmm2, zmm6, zmm4		;; I6 + R8 (new2 I6)					; 10-13		n 17
	vsubpd	zmm6, zmm6, zmm4		;; I6 - R8 (new2 I8)					; 10-13		n 18

	L1prefetchw srcreg+d1+L1pd, L1pt
	vsubpd	zmm4, zmm1, zmm5		;; R2 - R4 (newer R4)					; 11-14		n 19
	vaddpd	zmm1, zmm1, zmm5		;; R2 + R4 (newer R2)					; 11-14		n 20

	L1prefetchw srcreg+d1+64+L1pd, L1pt
	vsubpd	zmm5, zmm7, zmm3		;; I2 - I4 (newer I4)					; 12-15		n 19 
	vaddpd	zmm7, zmm7, zmm3		;; I2 + I4 (newer I2)					; 12-15		n 21

	L1prefetchw srcreg+d2+L1pd, L1pt
	vaddpd	zmm3, zmm8, zmm10		;; R1 + R3 (newer R1)					; 13-16		n 20
	vsubpd	zmm8, zmm8, zmm10		;; R1 - R3 (newer R3)					; 13-16		n 27

	L1prefetchw srcreg+d2+64+L1pd, L1pt
	vaddpd	zmm10, zmm12, zmm14		;; I1 + I3 (newer I1)					; 14-17		n 21
	vsubpd	zmm12, zmm12, zmm14		;; I1 - I3 (newer I3)					; 14-17		n 28

	L1prefetchw srcreg+d2+d1+L1pd, L1pt
	vaddpd	zmm14, zmm13, zmm11		;; I5 + R7 (newer I5)					; 15-18		n 22
	vsubpd	zmm13, zmm13, zmm11		;; I5 - R7 (newer I7)					; 15-18		n 24

	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	vsubpd	zmm11, zmm9, zmm15		;; R5 - I7 (newer R5)					; 16-19		n 23
	vaddpd	zmm9, zmm9, zmm15		;; R5 + I7 (newer R7)					; 16-19		n 25

	L1prefetchw srcreg+d4+L1pd, L1pt
	vaddpd	zmm15, zmm16, zmm2		;; I6 = R6 + I6 (newer I6/SQRTHALF)			; 17-20		n 22
	vsubpd	zmm16, zmm16, zmm2		;; R6 = R6 - I6 (newer R6/SQRTHALF)			; 17-20		n 23

	L1prefetchw srcreg+d4+64+L1pd, L1pt
	vsubpd	zmm2, zmm0, zmm6		;; R8 = R8 - I8 (newer R8/SQRTHALF)			; 18-21		n 24
	vaddpd	zmm0, zmm0, zmm6		;; I8 = R8 + I8 (newer I8/SQRTHALF)			; 18-21		n 25

	vmovapd zmm21, [screg+1*128]		;; sine for R3/I3 and R4/I4
	vmulpd	zmm5, zmm5, zmm21		;; I4S = I4 * sine (newer I4*sine)			; 19-22		n 27
	vmulpd	zmm4, zmm4, zmm21		;; R4S = R4 * sine (newer R4*sine)			; 19-22		n 28

	L1prefetchw srcreg+d4+d1+L1pd, L1pt
	vsubpd	zmm6, zmm3, zmm1		;; R1 - R2 (newest R2)					; 20-23		n 31
	vaddpd	zmm3, zmm3, zmm1		;; R1 + R2 (final R1)					; 20-23		n 35

	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
	vsubpd	zmm1, zmm10, zmm7		;; I1 - I2 (newest I2)					; 21-24		n 31
	vaddpd	zmm10, zmm10, zmm7		;; I1 + I2 (final I1)					; 21-24		n 37

	L1prefetchw srcreg+d4+d2+L1pd, L1pt
	zfmaddpd zmm7, zmm16, zmm31, zmm11	;; R5 + R6 * SQRTHALF (newest R5)			; 22-25		n 26
	zfmaddpd zmm17, zmm15, zmm31, zmm14	;; I5 + I6 * SQRTHALF (newest I5)			; 22-25		n 26

	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
	zfnmaddpd zmm16, zmm16, zmm31, zmm11	;; R5 - R6 * SQRTHALF (newest R6)			; 23-26		n 32
	zfnmaddpd zmm15, zmm15, zmm31, zmm14	;; I5 - I6 * SQRTHALF (newest I6)			; 23-25		n 32

	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	zfmaddpd zmm11, zmm2, zmm31, zmm13	;; I7 + R8 * SQRTHALF (newest I7)			; 24-27		n 29
	zfnmaddpd zmm14, zmm0, zmm31, zmm9	;; R7 - I8 * SQRTHALF (newest R7)			; 24-27		n 29

	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt
	zfnmaddpd zmm2, zmm2, zmm31, zmm13	;; I7 - R8 * SQRTHALF (newest I8)			; 25-28		n 35
	zfmaddpd zmm0, zmm0, zmm31, zmm9	;; R7 + I8 * SQRTHALF (newest R8)			; 25-28		n 35

	vmovapd zmm22, [screg+0*128+64]		;; cosine/sine for R5/I5 and R8/I8
	zfmsubpd zmm13, zmm7, zmm22, zmm17	;; A5 = R5 * cosine/sine - I5				; 26-29		n 30
	zfmaddpd zmm17, zmm17, zmm22, zmm7	;; B5 = I5 * cosine/sine + R5				; 26-29		n 30

	zfmsubpd zmm9, zmm8, zmm21, zmm5	;; R3*sine - I4S (newest R3*sine)			; 27-30		n 33
	zfmaddpd zmm8, zmm8, zmm21, zmm5	;; R3*sine + I4S (newest R4*sine)			; 27-30		n 41

	zfmaddpd zmm5, zmm12, zmm21, zmm4	;; I3*sine + R4S (newest I3*sine)			; 28-31		n 33
	zfmsubpd zmm12, zmm12, zmm21, zmm4	;; I3*sine - R4S (newest I4*sine)			; 28-31		n 41

	vmovapd zmm23, [screg+2*128+64]		;; cosine/sine for R7/I7 and R6/I6
	zfmsubpd zmm7, zmm14, zmm23, zmm11	;; A7 = R7 * cosine/sine - I7				; 29-32		n 34
	zfmaddpd zmm11, zmm11, zmm23, zmm14	;; B7 = I7 * cosine/sine + R7				; 29-32		n 34

	vmovapd zmm24, [screg+0*128]		;; sine for R5/I5 and R8/I8
	vmulpd	zmm13, zmm13, zmm24		;; A5 = A5 * sine (final R5)				; 30-33		n 35
	vmulpd	zmm17, zmm17, zmm24		;; B5 = B5 * sine (final I5)				; 30-33		n 37

	vmovapd zmm25, [screg+3*128+64]		;; cosine/sine for R2/I2
	zfmsubpd zmm4, zmm6, zmm25, zmm1	;; A2 = R2 * cosine/sine - I2				; 31-34		n 37
	zfmaddpd zmm1, zmm1, zmm25, zmm6	;; B2 = I2 * cosine/sine + R2				; 31-34		n 38

	zfmaddpd zmm6, zmm16, zmm23, zmm15	;; A6 = R6 * cosine/sine + I6				; 32-35		n 39
	zfmsubpd zmm15, zmm15, zmm23, zmm16	;; B6 = I6 * cosine/sine - R6				; 32-35		n 40

	vmovapd zmm26, [screg+1*128+64]		;; cosine/sine for R3/I3 and R4/I4
	zfmsubpd zmm16, zmm9, zmm26, zmm5	;; R3 * cosine/sine - I3 (final R3)			; 33-36		n 39
	zfmaddpd zmm5, zmm5, zmm26, zmm9	;; I3 * cosine/sine + R3 (final I3)			; 33-36		n 41

	vmovapd zmm27, [screg+2*128]		;; sine for R7/I7 and R6/I6
	vmulpd	zmm7, zmm7, zmm27		;; A7 = A7 * sine (final R7)				; 34-37		n 39
	vmulpd	zmm11, zmm11, zmm27		;; B7 = B7 * sine (final I7)				; 34-37		n 41

	;; Swap the four aparts
	vshuff64x2 zmm14, zmm3, zmm13, 01000100b;; R5_3 R5_2 R5_1 R5_0 R1_3 R1_2 R1_1 R1_0		; 35-37		n 45
	vshuff64x2 zmm3, zmm3, zmm13, 11101110b	;; R5_7	R5_6 R5_5 R5_4 R1_7 R1_6 R1_5 R1_4		; 36-38		n 45

	zfmaddpd zmm9, zmm0, zmm22, zmm2	;; A8 = R8 * cosine/sine + I8				; 35-38		n 42
	zfmsubpd zmm2, zmm2, zmm22, zmm0	;; B8 = I8 * cosine/sine - R8				; 36-39		n 44

	vshuff64x2 zmm0, zmm10, zmm17, 01000100b;; I5_3 I5_2 I5_1 I5_0 I1_3 I1_2 I1_1 I1_0		; 37-39		n 49
	vshuff64x2 zmm10, zmm10, zmm17, 11101110b;; I5_7 I5_6 I5_5 I5_4 I1_7 I1_6 I1_5 I1_4		; 38-40		n 49

	vmovapd zmm28, [screg+3*128]		;; sine for R2/I2
	vmulpd	zmm4, zmm4, zmm28		;; A2 = A2 * sine (final R2)				; 37-40		n 43
	vmulpd	zmm1, zmm1, zmm28		;; B2 = B2 * sine (final I2)				; 38-41		n 45

	vshuff64x2 zmm17, zmm16, zmm7, 01000100b;; R7_3 R7_2 R7_1 R7_0 R3_3 R3_2 R3_1 R3_0		; 39-41		n 46
	vshuff64x2 zmm16, zmm16, zmm7, 11101110b;; R7_7 R7_6 R7_5 R7_4 R3_7 R3_6 R3_5 R3_4		; 40-42		n 46

	vmulpd	zmm6, zmm6, zmm27		;; A6 = A6 * sine (final R6)				; 39-42		n 43
	vmulpd	zmm15, zmm15, zmm27		;; B6 = B6 * sine (final I6)				; 40-43		n 45

	vshuff64x2 zmm7, zmm5, zmm11, 01000100b	;; I7_3 I7_2 I7_1 I7_0 I3_3 I3_2 I3_1 I3_0		; 41-43		n 50
	vshuff64x2 zmm5, zmm5, zmm11, 11101110b	;; I7_7	I7_6 I7_5 I7_4 I3_7 I3_6 I3_5 I3_4		; 42-44		n 50

	zfmaddpd zmm11, zmm8, zmm26, zmm12	;; R4 * cosine/sine + I4 (final R4)			; 41-44		n 47
	vmulpd	zmm9, zmm9, zmm24		;; A8 = A8 * sine (final R8)				; 42-45		n 47

	vshuff64x2 zmm18, zmm4, zmm6, 01000100b	;; R6_3 R6_2 R6_1 R6_0 R2_3 R2_2 R2_1 R2_0		; 43-45		n 53
	vshuff64x2 zmm4, zmm4, zmm6, 11101110b	;; R6_7	R6_6 R6_5 R6_4 R2_7 R2_6 R2_5 R2_4		; 44-46		n 53

	zfmsubpd zmm12, zmm12, zmm26, zmm8	;; I4 * cosine/sine - R4 (final I4)			; 43-46		n 49
	vmulpd	zmm2, zmm2, zmm24		;; B8 = B8 * sine (final I8)				; 44-47		n 49

	vshuff64x2 zmm6, zmm1, zmm15, 01000100b	;; I6_3 I6_2 I6_1 I6_0 I2_3 I2_2 I2_1 I2_0		; 45-47		n 55
	vshuff64x2 zmm1, zmm1, zmm15, 11101110b	;; I6_7	I6_6 I6_5 I6_4 I2_7 I2_6 I2_5 I2_4		; 46-48		n 55

	vaddpd	zmm8, zmm14, zmm3		;; add r1/r5 4-aparts					; 45-48		n 51
	vaddpd	zmm15, zmm17, zmm16		;; add r3/r7 4-aparts					; 46-49		n 51

	vshuff64x2 zmm13, zmm11, zmm9, 01000100b;; R8_3 R8_2 R8_1 R8_0 R4_3 R4_2 R4_1 R4_0		; 47-49		n 54
	vshuff64x2 zmm11, zmm11, zmm9, 11101110b;; R8_7 R8_6 R8_5 R8_4 R4_7 R4_6 R4_5 R4_4		; 48-50		n 54

	vsubpd	zmm14, zmm14, zmm3		;; sub r1/r5 4-aparts					; 47-50		n 53
	vsubpd	zmm17, zmm17, zmm16		;; sub r3/r7 4-aparts					; 48-51		n 53

	vshuff64x2 zmm9, zmm12, zmm2, 01000100b	;; I8_3 I8_2 I8_1 I8_0 I4_3 I4_2 I4_1 I4_0		; 49-51		n 56
	vshuff64x2 zmm12, zmm12, zmm2, 11101110b;; I8_7	I8_6 I8_5 I8_4 I4_7 I4_6 I4_5 I4_4		; 50-52		n 56

	vaddpd	zmm3, zmm0, zmm10		;; add i1/i5 4-aparts					; 49-52		n 55
	vaddpd	zmm16, zmm7, zmm5		;; add i3/i7 4-aparts					; 50-53		n 55

	;; Swap the two aparts
	vshuff64x2 zmm2, zmm8, zmm15, 10001000b	;; R7_1 R7_0 R3_1 R3_0 R5_1 R5_0 R1_1 R1_0 (r15/37+)	; 51-53		n 63
	vshuff64x2 zmm8, zmm8, zmm15, 11011101b	;; R7_3 R7_2 R3_3 R3_2 R5_3 R5_2 R1_3 R1_2		; 52-54		n 64

	vsubpd	zmm0, zmm0, zmm10		;; sub i1/i5 4-aparts					; 51-54		n 57
	vsubpd	zmm7, zmm7, zmm5		;; sub i3/i7 4-aparts					; 52-55		n 57

	vshuff64x2 zmm15, zmm14, zmm17, 10001000b;; R7_5 R7_4 R3_5 R3_4 R5_5 R5_4 R1_5 R1_4 (r15/37-)	; 53-55		n 75
	vshuff64x2 zmm14, zmm14, zmm17, 11011101b;; R7_7 R7_6 R3_7 R3_6 R5_7 R5_6 R1_7 R1_6		; 54-56		n 78

	vaddpd	zmm10, zmm18, zmm4		;; add r2/r6 4-aparts					; 53-56		n 59
	vaddpd	zmm5, zmm13, zmm11		;; add r4/r8 4-aparts					; 54-57		n 59

	vshuff64x2 zmm17, zmm3, zmm16, 10001000b;; I7_1 I7_0 I3_1 I3_0 I5_1 I5_0 I1_1 I1_0 (i15/37+)	; 55-57		n 67
	vshuff64x2 zmm3, zmm3, zmm16, 11011101b	;; I7_3 I7_2 I3_3 I3_2 I5_3 I5_2 I1_3 I1_2		; 56-58		n 68

	vaddpd	zmm16, zmm6, zmm1		;; add i2/i6 4-aparts					; 55-58		n 61  
	vaddpd	zmm19, zmm9, zmm12		;; add i4/i8 4-aparts					; 56-59		n 61

	vshuff64x2 zmm20, zmm0, zmm7, 10001000b	;; I7_5 I7_4 I3_5 I3_4 I5_5 I5_4 I1_5 I1_4 (i15/37-)	; 57-59		n 77
	vshuff64x2 zmm0, zmm0, zmm7, 11011101b	;; I7_7 I7_6 I3_7 I3_6 I5_7 I5_6 I1_7 I1_6		; 58-60		n 76

	vsubpd	zmm18, zmm18, zmm4		;; sub r2/r6 4-aparts					; 57-60		n 71
	vsubpd	zmm13, zmm13, zmm11		;; sub r4/r8 4-aparts					; 58-61		n 71

	vshuff64x2 zmm7, zmm10, zmm5, 10001000b	;; R8_1 R8_0 R4_1 R4_0 R6_1 R6_0 R2_1 R2_0 (r26/48+)	; 59-61		n 63
	vshuff64x2 zmm10, zmm10, zmm5, 11011101b;; R8_3 R8_2 R4_3 R4_2 R6_3 R6_2 R2_3 R2_2		; 60-62		n 64

	vsubpd	zmm6, zmm6, zmm1		;; sub i2/i6 4-aparts					; 59-62		n 73
	vsubpd	zmm9, zmm9, zmm12		;; sub i4/i8 4-aparts					; 60-63		n 73

	vshuff64x2 zmm4, zmm16, zmm19, 10001000b;; I8_1 I8_0 I4_1 I4_0 I6_1 I6_0 I2_1 I2_0 (i26/48+)	; 61-63		n 67
	vshuff64x2 zmm16, zmm16, zmm19, 11011101b;; I8_3 I8_2 I4_3 I4_2 I6_3 I6_2 I2_3 I2_2		; 62-64		n 68

	;; Swap the one aparts
	vshufpd	zmm11, zmm2, zmm7, 00000000b	;; R8_0 R7_0 R4_0 R3_0 R6_0 R5_0 R2_0 R1_0 (R1+R5 = new R1) ; 63	n 65
	vshufpd	zmm5, zmm8, zmm10, 00000000b	;; R8_2 R7_2 R4_2 R3_2 R6_2 R5_2 R2_2 R1_2 (R3+R7 = new R3) ; 64	n 65
	vshufpd	zmm2, zmm2, zmm7, 11111111b	;; R8_1 R7_1 R4_1 R3_1 R6_1 R5_1 R2_1 R1_1 (R2+R6=  new R2) ; 65	n 67
	vshufpd	zmm8, zmm8, zmm10, 11111111b	;; R8_3 R7_3 R4_3 R3_3 R6_3 R5_3 R2_3 R1_3 (R4+R8 = new R4) ; 66	n 67

	vaddpd	zmm19, zmm11, zmm5		;; R1 + R3 (newer R1)					; 65-68		n 75
	vsubpd	zmm11, zmm11, zmm5		;; R1 - R3 (newer R3)					; 66-69		n 86

	vshufpd	zmm7, zmm17, zmm4, 00000000b	;; I8_0 I7_0 I4_0 I3_0 I6_0 I5_0 I2_0 I1_0 (I1+I5 = new I1) ; 67	n 69
	vshufpd	zmm10, zmm3, zmm16, 00000000b	;; I8_2 I7_2 I4_2 I3_2 I6_2 I5_2 I2_2 I1_2 (I3+I7 = new I3) ; 68	n 69

	vaddpd	zmm5, zmm2, zmm8		;; R2 + R4 (newer R2)					; 67-70		n 75
