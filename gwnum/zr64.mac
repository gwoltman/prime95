	ENDM
zr64f_hundredtwentyeight_real_with_square MACRO srcreg,srcinc,d1,d2,d4,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	zr8f_2sc_sixteen_reals_fft_preload
	zr8f_2sc_sixteen_reals_fft srcreg,0,d1,d2,d4,screg1,0,screg2,0,1
	zr8s_sixteen_reals_eight_complex_with_square_preload
	zr8s_sixteen_reals_eight_complex_with_square srcreg,0,d1,d2,d4,1
	zr8_2sc_plusminus_sixteen_reals_unfft_preload
	zr8_2sc_plusminus_sixteen_reals_unfft srcreg,srcinc,d1,d2,d4,screg1,scinc1,screg2,scinc2,1,L1pt,L1pd
