	zr8_2sc_sixteen_reals_fft_preload
	zr8_2sc_sixteen_reals_fft srcreg,0,d1,d2,d4,screg1,scinc1,screg2,scinc2
	zr8s_sixteen_reals_eight_complex_fft_final_preload
	zr8s_sixteen_reals_eight_complex_fft_final srcreg,srcinc,d1,d2,d4,1,L1pt,L1pd
	ENDM
