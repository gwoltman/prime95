	ENDM





;; special version of sixteen reals unfft to overcome deficiency in zr8s_sixteen_reals_eight_complex_with_(square,mult,mulf).
;; when we fix those macros to do the full four levels of inverse FFT we can delete this macro.

;; Uses two sin/cos ptrs.  Used in last levels of 2nd pass in a two-pass FFT
zr8_2sc_plusminus_sixteen_reals_unfft_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	vbroadcastsd zmm30, ZMM_P924_P383
	vbroadcastsd zmm29, ZMM_P383
	ENDM

zr8_2sc_plusminus_sixteen_reals_unfft MACRO srcreg,srcinc,d1,d2,d4,screg1,scinc1,screg2,scinc2,maxrpt,L1pt,L1pd
	vmovapd	zmm16, [srcreg]			;; R1
	vmovapd	zmm8, [srcreg+64]		;; R9
	vaddpd	zmm0, zmm16, zmm8		;; R1+R9
	vsubpd	zmm8, zmm16, zmm8		;; R1-R9

	vmovapd	zmm1, [srcreg+d1]		;; R2
	vmovapd	zmm2, [srcreg+d2]		;; R3
	vmovapd	zmm3, [srcreg+d2+d1]		;; R4
	vmovapd	zmm4, [srcreg+d4]		;; R5
	vmovapd	zmm5, [srcreg+d4+d1]		;; R6
	vmovapd	zmm6, [srcreg+d4+d2]		;; R7
	vmovapd	zmm7, [srcreg+d4+d2+d1]		;; R8

	vmovapd	zmm9, [srcreg+d1+64]		;; I2
	vmovapd	zmm10, [srcreg+d2+64]		;; I3
	vmovapd	zmm11, [srcreg+d2+d1+64]	;; I4
	vmovapd	zmm12, [srcreg+d4+64]		;; I5
	vmovapd	zmm13, [srcreg+d4+d1+64]	;; I6
	vmovapd	zmm14, [srcreg+d4+d2+64]	;; I7
	vmovapd	zmm15, [srcreg+d4+d2+d1+64]	;; I8

	vmovapd	zmm28, [screg2+0*128+64]	;; cosine/sine for R3/I3 (w^2 = complex w^1)
	zfmaddpd zmm16, zmm2, zmm28, zmm10	;; A3 = R3 * cosine/sine + I3				; 1-4		n 5
	zfmsubpd zmm10, zmm10, zmm28, zmm2	;; B3 = I3 * cosine/sine - R3				; 1-4		n 5

	vmovapd	zmm28, [screg1+0*128+64]	;; cosine/sine for R2/I2 (w^1)
	zfmaddpd zmm2, zmm1, zmm28, zmm9	;; A2 = R2 * cosine/sine + I2				; 2-5		n 7
	zfmsubpd zmm9, zmm9, zmm28, zmm1	;; B2 = I2 * cosine/sine - R2				; 2-5		n 7

	vmovapd	zmm28, [screg1+1*128+64]	;; cosine/sine for R4/I4 (w^3)
	zfmaddpd zmm1, zmm3, zmm28, zmm11	;; A4 = R4 * cosine/sine + I4				; 3-6		n 9
	zfmsubpd zmm11, zmm11, zmm28, zmm3	;; B4 = I4 * cosine/sine - R4				; 3-6		n 9

	vmovapd	zmm28, [screg2+2*128+64]	;; cosine/sine for R7/I7 (w^6 = complex w^3)
	zfmaddpd zmm3, zmm6, zmm28, zmm14	;; A7 = R7 * cosine/sine + I7				; 4-7		n 11
	zfmsubpd zmm14, zmm14, zmm28, zmm6	;; B7 = I7 * cosine/sine - R7				; 4-7		n 12

	vmovapd	zmm28, [screg2+0*128]		;; sine for R3/I3
	vmulpd	zmm16, zmm16, zmm28		;; R3 = A3 * sine					; 5-8		n 11
	vmulpd	zmm10, zmm10, zmm28		;; I3 = B3 * sine					; 5-8		n 12

	vmovapd	zmm28, [screg1+3*128+64]	;; cosine/sine for R8/I8 (w^7)
	zfmaddpd zmm6, zmm7, zmm28, zmm15	;; A8 = R8 * cosine/sine + I8				; 6-9		n 13
	zfmsubpd zmm15, zmm15, zmm28, zmm7	;; B8 = I8 * cosine/sine - R8				; 6-9		n 14

	vmovapd	zmm28, [screg1+0*128]		;; sine for R2/I2
	vmulpd	zmm2, zmm2, zmm28		;; R2 = A2 * sine					; 7-10		n 13
	vmulpd	zmm9, zmm9, zmm28		;; I2 = B2 * sine					; 7-10		n 14

	vmovapd	zmm28, [screg1+2*128+64]	;; cosine/sine for R6/I6 (w^5)
	zfmaddpd zmm7, zmm5, zmm28, zmm13	;; A6 = R6 * cosine/sine + I6				; 8-11		n 15
	zfmsubpd zmm13, zmm13, zmm28, zmm5	;; B6 = I6 * cosine/sine - R6				; 8-11		n 16

	vmovapd	zmm28, [screg1+1*128]		;; sine for R4/I4
	vmulpd	zmm1, zmm1, zmm28		;; R4 = A4 * sine					; 9-12		n 15
	vmulpd	zmm11, zmm11, zmm28		;; I4 = B4 * sine					; 9-12		n 16

	vmovapd	zmm28, [screg2+1*128+64]	;; cosine/sine for R5/I5 (w^4 = complex w^2)
	zfmaddpd zmm5, zmm4, zmm28, zmm12	;; A5 = R5 * cosine/sine + I5				; 10-13		n 17
	zfmsubpd zmm12, zmm12, zmm28, zmm4	;; B5 = I5 * cosine/sine - R5				; 10-13		n 18

	vmovapd	zmm28, [screg2+2*128]		;; sine for R7/I7
	zfnmaddpd zmm4, zmm3, zmm28, zmm16	;; R3-(R7 = A7 * sine)					; 11-14		n 19
	zfmaddpd zmm3, zmm3, zmm28, zmm16	;; R3+(R7 = A7 * sine)					; 11-14		n 22

	zfmaddpd zmm16, zmm14, zmm28, zmm10	;; I3+(I7 = B7 * sine)					; 12-15		n 19
	zfnmaddpd zmm14, zmm14, zmm28, zmm10	;; I3-(I7 = B7 * sine)					; 12-15		n 23

	vmovapd	zmm28, [screg1+3*128]		;; sine for R8/I8
	zfmaddpd zmm10, zmm6, zmm28, zmm2	;; R2+(R8 = A8 * sine)					; 13-16		n 20
	zfnmaddpd zmm6, zmm6, zmm28, zmm2	;; R2-(R8 = A8 * sine)					; 13-16		n 24

	L1prefetchw srcreg+L1pd, L1pt
	zfnmaddpd zmm2, zmm15, zmm28, zmm9	;; I2-(I8 = B8 * sine)					; 14-17		n 21
	zfmaddpd zmm15, zmm15, zmm28, zmm9	;; I2+(I8 = B8 * sine)					; 14-17		n 25

	vmovapd	zmm28, [screg1+2*128]		;; sine for R6/I6
	zfmaddpd zmm9, zmm7, zmm28, zmm1	;; R4+(R6 = A6 * sine)					; 15-18		n 20
	zfnmaddpd zmm7, zmm7, zmm28, zmm1	;; R4-(R6 = A6 * sine)					; 15-18		n 25

	L1prefetchw srcreg+d1+L1pd, L1pt
	zfnmaddpd zmm1, zmm13, zmm28, zmm11	;; I4-(I6 = B6 * sine)					; 16-19		n 21
	zfmaddpd zmm13, zmm13, zmm28, zmm11	;; I4+(I6 = B6 * sine)					; 16-19		n 24

	vmovapd	zmm28, [screg2+1*128]		;; sine for R5/I5
	zfmaddpd zmm11, zmm5, zmm28, zmm0	;; r1++ = (r1+r9) + r5*sine				; 17-20		n 22
	zfnmaddpd zmm5, zmm5, zmm28, zmm0	;; r1+- = (r1+r9) - r5*sine				; 17-20		n 23
	zfmaddpd zmm0, zmm12, zmm28, zmm8	;; r1-+ = (r1-r9) + i5*sine				; 18-21		n 29
	zfnmaddpd zmm12, zmm12, zmm28, zmm8	;; r1-- = (r1-r9) - i5*sine				; 18-21		n 31

	vaddpd	zmm8, zmm4, zmm16		;; r3-+ = (r3-r7) + (i3+i7)				; 19-22		n 29
	vsubpd	zmm4, zmm4, zmm16		;; r3-- = (r3-r7) - (i3+i7)				; 19-22		n 31

	L1prefetchw srcreg+d2+L1pd, L1pt
	vaddpd	zmm16, zmm10, zmm9		;; r2++ = (r2+r8) + (r4+r6)				; 20-23		n 26
	vsubpd	zmm10, zmm10, zmm9		;; r2+- = (r2+r8) - (r4+r6)				; 20-23		n 28
	vsubpd	zmm9, zmm2, zmm1		;; i2-- = (i2-i8) - (i4-i6)				; 21-24		n 27
	vaddpd	zmm2, zmm2, zmm1		;; i2-+ = (i2-i8) + (i4-i6)				; 21-24		n 28

	L1prefetchw srcreg+d4+L1pd, L1pt
	vaddpd	zmm1, zmm11, zmm3		;; r1+++ = (r1++) + (r3+r7)				; 22-25		n 26
	vsubpd	zmm11, zmm11, zmm3		;; r1++- = (r1++) - (r3+r7)				; 22-25		n 27

	vaddpd	zmm3, zmm5, zmm14		;; r1+-+ = (r1+-) + (i3-i7)				; 23-26		n 33
	vsubpd	zmm5, zmm5, zmm14		;; r1+-- = (r1+-) - (i3-i7)				; 23-26		n 34

	L1prefetchw srcreg+d2+d1+L1pd, L1pt
	vaddpd	zmm14, zmm6, zmm13		;; r2-+ = (r2-r8) + (i4+i6)				; 24-27		n 30
	vsubpd	zmm6, zmm6, zmm13		;; r2-- = (r2-r8) - (i4+i6)				; 24-27		n 32
	vaddpd	zmm13, zmm15, zmm7		;; i2++ = (i2+i8) + (r4-r6)				; 25-28		n 30
	vsubpd	zmm15, zmm15, zmm7		;; i2+- = (i2+i8) - (r4-r6)				; 25-28		n 32

	vaddpd	zmm7, zmm1, zmm16		;; R1 = (r1+++) + (r2++)				; 26-29
	vsubpd	zmm1, zmm1, zmm16		;; R9 = (r1+++) - (r2++)				; 26-29
	vaddpd	zmm16, zmm11, zmm9		;; R5  = (r1++-) + (i2--)				; 27-30
	vsubpd	zmm11, zmm11, zmm9		;; R13 = (r1++-) - (i2--)				; 27-30
	zstore	[srcreg], zmm7			;; Save R1						; 30
	zstore	[srcreg+64], zmm1		;; Save R9						; 30+1
	zstore	[srcreg+d4], zmm16		;; Save R5						; 31+1
	zstore	[srcreg+d4+64], zmm11		;; Save R13						; 31+2

	vaddpd	zmm9, zmm10, zmm2		;; r2+-+ = (r2+-) + (i2-+)				; 28-31		n 33
	vsubpd	zmm10, zmm10, zmm2		;; r2+-- = (r2+-) - (i2-+)				; 28-31		n 34

	zfmaddpd zmm2, zmm8, zmm31, zmm0	;; r2_10o = (r1-+) + .707(r3-+)				; 29-32		n 35
	zfnmaddpd zmm8, zmm8, zmm31, zmm0	;; r6_14o = (r1-+) - .707(r3-+)				; 29-32		n 36

	zfmaddpd zmm0, zmm14, zmm30, zmm13	;; r2_10e/.383 = .924/.383(r2-+) + (i2++)		; 30-33		n 35
	zfmsubpd zmm13, zmm13, zmm30, zmm14	;; r6_14e/.383 = .924/.383(i2++) - (r2-+)		; 30-33		n 36

	zfnmaddpd zmm14, zmm4, zmm31, zmm12	;; r4_12o = (r1--) - .707(r3--)				; 31-34		n 37
	zfmaddpd zmm4, zmm4, zmm31, zmm12	;; r8_16o = (r1--) + .707(r3--)				; 31-34		n 38

	zfmaddpd zmm12, zmm15, zmm30, zmm6	;; r4_12e/.383 = .924/.383(i2+-) + (r2--)		; 32-35		n 37
	zfnmaddpd zmm6, zmm6, zmm30, zmm15	;; r8_16e/.383 = (i2+-) - .924/.383(r2--)		; 32-35		n 38

	L1prefetchw srcreg+d4+d1+L1pd, L1pt
	zfmaddpd zmm15, zmm9, zmm31, zmm3	;; R3  = (r1+-+) + .707(r2+-+)				; 33-36
	zfnmaddpd zmm9, zmm9, zmm31, zmm3	;; R11 = (r1+-+) - .707(r2+-+)				; 33-36
	zfnmaddpd zmm3, zmm10, zmm31, zmm5	;; R7  = (r1+--) - .707(r2+--)				; 34-37
	zfmaddpd zmm10, zmm10, zmm31, zmm5	;; R15 = (r1+--) + .707(r2+--)				; 34-37
	zstore	[srcreg+d2], zmm15		;; Save R3						; 37
	zstore	[srcreg+d2+64], zmm9		;; Save R11						; 37+1
	zstore	[srcreg+d4+d2], zmm3		;; Save R7						; 38+1
	zstore	[srcreg+d4+d2+64], zmm10	;; Save R15						; 38+2

	zfmaddpd zmm5, zmm0, zmm29, zmm2	;; R2  = r2_10o + .383*r2_10e				; 35-38
	zfnmaddpd zmm0, zmm0, zmm29, zmm2	;; R10 = r2_10o - .383*r2_10e				; 35-38

	zfmaddpd zmm2, zmm13, zmm29, zmm8	;; R6  = r6_14o + .383*r6_14e				; 36-39
	zfnmaddpd zmm13, zmm13, zmm29, zmm8	;; R14 = r6_14o - .383*r6_14e				; 36-39

	zfmaddpd zmm8, zmm12, zmm29, zmm14	;; R4  = r4_12o + .383*r4_12e				; 37-40
	zfnmaddpd zmm12, zmm12, zmm29, zmm14	;; R12 = r4_12o - .383*r4_12e				; 37-40

	zfmaddpd zmm14, zmm6, zmm29, zmm4	;; R8  = r8_16o + .383*r8_16e				; 38-41
	zfnmaddpd zmm6, zmm6, zmm29, zmm4	;; R16 = r8_16o - .383*r8_16e				; 38-41

	L1prefetchw srcreg+d4+d2+L1pd, L1pt
	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	L1prefetchw srcreg+64+L1pd, L1pt
	L1prefetchw srcreg+d1+64+L1pd, L1pt
	L1prefetchw srcreg+d2+64+L1pd, L1pt
	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	L1prefetchw srcreg+d4+64+L1pd, L1pt
	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt

	bump	screg1, scinc1
	bump	screg2, scinc2
	zstore	[srcreg+d1], zmm5		;; Save R2						; 39+2
	zstore	[srcreg+d1+64], zmm0		;; Save R10						; 39+3
	zstore	[srcreg+d4+d1], zmm2		;; Save R6						; 40+3
	zstore	[srcreg+d4+d1+64], zmm13	;; Save R14						; 40+4
	zstore	[srcreg+d2+d1], zmm8		;; Save R4						; 41+4
	zstore	[srcreg+d2+d1+64], zmm12	;; Save R12						; 41+5
	zstore	[srcreg+d4+d2+d1], zmm14	;; Save R8						; 42+5
	zstore	[srcreg+d4+d2+d1+64], zmm6	;; Save R16						; 42+6
	bump	srcreg, srcinc
	ENDM






;;*******************************************************************************
;; In theory, these macros should reduce roundoff error, in practice they did not
;;*******************************************************************************

IFDEF TRY_SQRT2_TO_REDUCE_ROUNDOFF

zr64_64c_fft_cmn_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
	vbroadcastsd zmm29, ZMM_SQRT2
	ENDM
zr64_64c_fft_cmn MACRO srcreg,srcoff,srcinc,d1,d2,d4,screg,scinc,maxrpt,L1pt,L1pd
	vmovapd	zmm1, [srcreg+srcoff+d1]	;; R2
	vmovapd	zmm2, [srcreg+srcoff+d4+d1]	;; R6
	vsubpd	zmm0, zmm1, zmm2		;; R2 - R6 (new R6)					; 1-4		n 9
	vaddpd	zmm1, zmm1, zmm2		;; R2 + R6 (new R2)					; 1-4		n 11

	vmovapd	zmm3, [srcreg+srcoff+d2+d1+64]	;; I4
	vmovapd	zmm4, [srcreg+srcoff+d4+d2+d1+64] ;; I8
	vsubpd	zmm2, zmm3, zmm4		;; I4 - I8 (new I8)					; 2-5		n 9
	vaddpd	zmm3, zmm3, zmm4		;; I4 + I8 (new I4)					; 2-5		n 12

	vmovapd	zmm5, [srcreg+srcoff+d2+d1]	;; R4
	vmovapd	zmm6, [srcreg+srcoff+d4+d2+d1]	;; R8
	vsubpd	zmm4, zmm5, zmm6		;; R4 - R8 (new R8)					; 3-6		n 10
	vaddpd	zmm5, zmm5, zmm6		;; R4 + R8 (new R4)					; 3-6		n 11

	vmovapd	zmm7, [srcreg+srcoff+d1+64]	;; I2
	vmovapd	zmm8, [srcreg+srcoff+d4+d1+64]	;; I6
	vsubpd	zmm6, zmm7, zmm8		;; I2 - I6 (new I6)					; 4-7		n 10
	vaddpd	zmm7, zmm7, zmm8		;; I2 + I6 (new I2)					; 4-7		n 12

	vmovapd	zmm9, [srcreg+srcoff]		;; R1
	vmovapd	zmm10, [srcreg+srcoff+d4]	;; R5
	vaddpd	zmm8, zmm9, zmm10		;; R1 + R5 (new R1)					; 5-8		n 13
	vsubpd	zmm9, zmm9, zmm10		;; R1 - R5 (new R5)					; 5-8		n 16

	vmovapd	zmm11, [srcreg+srcoff+d2]	;; R3
	vmovapd	zmm12, [srcreg+srcoff+d4+d2]	;; R7
	vaddpd	zmm10, zmm11, zmm12		;; R3 + R7 (new R3)					; 6-9		n 13
	vsubpd	zmm11, zmm11, zmm12		;; R3 - R7 (new R7)					; 6-9		n 15

	vmovapd	zmm13, [srcreg+srcoff+64]	;; I1
	vmovapd	zmm14, [srcreg+srcoff+d4+64]	;; I5
	vaddpd	zmm12, zmm13, zmm14		;; I1 + I5 (new I1)					; 7-10		n 14
	vsubpd	zmm13, zmm13, zmm14		;; I1 - I5 (new I5)					; 7-10		n 15

	vmovapd	zmm15, [srcreg+srcoff+d2+64]	;; I3
	vmovapd	zmm16, [srcreg+srcoff+d4+d2+64]	;; I7
	vaddpd	zmm14, zmm15, zmm16		;; I3 + I7 (new I3)					; 8-11		n 14
	vsubpd	zmm15, zmm15, zmm16		;; I3 - I7 (new I7)					; 8-11		n 16

	L1prefetchw srcreg+L1pd, L1pt
	vsubpd	zmm16, zmm0, zmm2		;; R6 - I8 (new2 R6)					; 9-12		n 17
	vaddpd	zmm0, zmm0, zmm2		;; R6 + I8 (new2 R8)					; 9-12		n 18

	L1prefetchw srcreg+64+L1pd, L1pt
	vaddpd	zmm2, zmm6, zmm4		;; I6 + R8 (new2 I6)					; 10-13		n 17
	vsubpd	zmm6, zmm6, zmm4		;; I6 - R8 (new2 I8)					; 10-13		n 18

	L1prefetchw srcreg+d1+L1pd, L1pt
	vsubpd	zmm4, zmm1, zmm5		;; R2 - R4 (newer R4)					; 11-14		n 19
	vaddpd	zmm1, zmm1, zmm5		;; R2 + R4 (newer R2)					; 11-14		n 20

	L1prefetchw srcreg+d1+64+L1pd, L1pt
	vsubpd	zmm5, zmm7, zmm3		;; I2 - I4 (newer I4)					; 12-15		n 19 
	vaddpd	zmm7, zmm7, zmm3		;; I2 + I4 (newer I2)					; 12-15		n 21

	L1prefetchw srcreg+d2+L1pd, L1pt
	vaddpd	zmm3, zmm8, zmm10		;; R1 + R3 (newer R1)					; 13-16		n 20
	vsubpd	zmm8, zmm8, zmm10		;; R1 - R3 (newer R3)					; 13-16		n 27

	L1prefetchw srcreg+d2+64+L1pd, L1pt
	vaddpd	zmm10, zmm12, zmm14		;; I1 + I3 (newer I1)					; 14-17		n 21
	vsubpd	zmm12, zmm12, zmm14		;; I1 - I3 (newer I3)					; 14-17		n 28

	L1prefetchw srcreg+d2+d1+L1pd, L1pt
	vaddpd	zmm14, zmm13, zmm11		;; I5 + R7 (newer I5)					; 15-18		n 22
	vsubpd	zmm13, zmm13, zmm11		;; I5 - R7 (newer I7)					; 15-18		n 24

	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
	vsubpd	zmm11, zmm9, zmm15		;; R5 - I7 (newer R5)					; 16-19		n 23
	vaddpd	zmm9, zmm9, zmm15		;; R5 + I7 (newer R7)					; 16-19		n 25

	L1prefetchw srcreg+d4+L1pd, L1pt
	vaddpd	zmm15, zmm16, zmm2		;; I6 = R6 + I6 (newer I6/SQRTHALF)			; 17-20		n 22
	vsubpd	zmm16, zmm16, zmm2		;; R6 = R6 - I6 (newer R6/SQRTHALF)			; 17-20		n 23

	L1prefetchw srcreg+d4+64+L1pd, L1pt
	vsubpd	zmm2, zmm0, zmm6		;; R8 = R8 - I8 (newer R8/SQRTHALF)			; 18-21		n 24
	vaddpd	zmm0, zmm0, zmm6		;; I8 = R8 + I8 (newer I8/SQRTHALF)			; 18-21		n 25

	vmovapd zmm21, [screg+1*128]		;; sine for R3/I3 and R4/I4
	vmulpd	zmm5, zmm5, zmm21		;; I4S = I4 * sine (newer I4*sine)			; 19-22		n 27
	vmulpd	zmm4, zmm4, zmm21		;; R4S = R4 * sine (newer R4*sine)			; 19-22		n 28

	L1prefetchw srcreg+d4+d1+L1pd, L1pt
	vsubpd	zmm6, zmm3, zmm1		;; R1 - R2 (newest R2)					; 20-23		n 31
	vaddpd	zmm3, zmm3, zmm1		;; R1 + R2 (final R1)					; 20-23		n 35

	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
	vsubpd	zmm1, zmm10, zmm7		;; I1 - I2 (newest I2)					; 21-24		n 31
	vaddpd	zmm10, zmm10, zmm7		;; I1 + I2 (final I1)					; 21-24		n 37

	L1prefetchw srcreg+d4+d2+L1pd, L1pt
	zfmaddpd zmm7, zmm11, zmm29, zmm16	;; SQRT2*R5 + R6 (newest R5)				; 22-25		n 26
	zfmaddpd zmm17, zmm14, zmm29, zmm15	;; SQRT2*I5 + I6 (newest I5)				; 22-25		n 26

	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
	zfmsubpd zmm16, zmm11, zmm29, zmm16	;; SQRT2*R5 - R6 (newest R6)				; 23-26		n 32
	zfmsubpd zmm15, zmm14, zmm29, zmm15	;; SQRT2*I5 - I6 (newest I6)				; 23-25		n 32

	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	zfmaddpd zmm11, zmm13, zmm29, zmm2	;; SQRT2*I7 + R8 (newest I7)				; 24-27		n 29
	zfmsubpd zmm14, zmm9, zmm29, zmm0	;; SQRT2*R7 - I8 (newest R7)				; 24-27		n 29

	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt
	zfmsubpd zmm2, zmm13, zmm29, zmm2	;; SQRT2*I7 - R8 (newest I8)				; 25-28		n 35
	zfmaddpd zmm0, zmm9, zmm29, zmm0	;; SQRT2*R7 + I8 (newest R8)				; 25-28		n 35

	vmovapd zmm22, [screg+0*128+64]		;; cosine/sine for R5/I5 and R8/I8
	zfmsubpd zmm13, zmm7, zmm22, zmm17	;; A5 = R5 * cosine/sine - I5				; 26-29		n 30
	zfmaddpd zmm17, zmm17, zmm22, zmm7	;; B5 = I5 * cosine/sine + R5				; 26-29		n 30

	zfmsubpd zmm9, zmm8, zmm21, zmm5	;; R3*sine - I4S (newest R3*sine)			; 27-30		n 33
	zfmaddpd zmm8, zmm8, zmm21, zmm5	;; R3*sine + I4S (newest R4*sine)			; 27-30		n 41

	zfmaddpd zmm5, zmm12, zmm21, zmm4	;; I3*sine + R4S (newest I3*sine)			; 28-31		n 33
	zfmsubpd zmm12, zmm12, zmm21, zmm4	;; I3*sine - R4S (newest I4*sine)			; 28-31		n 41

	vmovapd zmm23, [screg+2*128+64]		;; cosine/sine for R7/I7 and R6/I6
	zfmsubpd zmm7, zmm14, zmm23, zmm11	;; A7 = R7 * cosine/sine - I7				; 29-32		n 34
	zfmaddpd zmm11, zmm11, zmm23, zmm14	;; B7 = I7 * cosine/sine + R7				; 29-32		n 34

	vmovapd zmm24, [screg+0*128]		;; .707*sine for R5/I5 and R8/I8
	vmulpd	zmm13, zmm13, zmm24		;; A5 = A5 * .707*sine (final R5)			; 30-33		n 35
	vmulpd	zmm17, zmm17, zmm24		;; B5 = B5 * .707*sine (final I5)			; 30-33		n 37

	vmovapd zmm25, [screg+3*128+64]		;; cosine/sine for R2/I2
	zfmsubpd zmm4, zmm6, zmm25, zmm1	;; A2 = R2 * cosine/sine - I2				; 31-34		n 37
	zfmaddpd zmm1, zmm1, zmm25, zmm6	;; B2 = I2 * cosine/sine + R2				; 31-34		n 38

	zfmaddpd zmm6, zmm16, zmm23, zmm15	;; A6 = R6 * cosine/sine + I6				; 32-35		n 39
	zfmsubpd zmm15, zmm15, zmm23, zmm16	;; B6 = I6 * cosine/sine - R6				; 32-35		n 40

	vmovapd zmm26, [screg+1*128+64]		;; cosine/sine for R3/I3 and R4/I4
	zfmsubpd zmm16, zmm9, zmm26, zmm5	;; R3 * cosine/sine - I3 (final R3)			; 33-36		n 39
	zfmaddpd zmm5, zmm5, zmm26, zmm9	;; I3 * cosine/sine + R3 (final I3)			; 33-36		n 41

	vmovapd zmm27, [screg+2*128]		;; .707*sine for R7/I7 and R6/I6
	vmulpd	zmm7, zmm7, zmm27		;; A7 = A7 * .707*sine (final R7)			; 34-37		n 39
	vmulpd	zmm11, zmm11, zmm27		;; B7 = B7 * .707*sine (final I7)			; 34-37		n 41

	;; Swap the four aparts
	vshuff64x2 zmm14, zmm3, zmm13, 01000100b;; R5_3 R5_2 R5_1 R5_0 R1_3 R1_2 R1_1 R1_0		; 35-37		n 45
	vshuff64x2 zmm3, zmm3, zmm13, 11101110b	;; R5_7	R5_6 R5_5 R5_4 R1_7 R1_6 R1_5 R1_4		; 36-38		n 45

	zfmaddpd zmm9, zmm0, zmm22, zmm2	;; A8 = R8 * cosine/sine + I8				; 35-38		n 42
	zfmsubpd zmm2, zmm2, zmm22, zmm0	;; B8 = I8 * cosine/sine - R8				; 36-39		n 44

	vshuff64x2 zmm0, zmm10, zmm17, 01000100b;; I5_3 I5_2 I5_1 I5_0 I1_3 I1_2 I1_1 I1_0		; 37-39		n 49
	vshuff64x2 zmm10, zmm10, zmm17, 11101110b;; I5_7 I5_6 I5_5 I5_4 I1_7 I1_6 I1_5 I1_4		; 38-40		n 49

	vmovapd zmm28, [screg+3*128]		;; sine for R2/I2
	vmulpd	zmm4, zmm4, zmm28		;; A2 = A2 * sine (final R2)				; 37-40		n 43
