;
; These macros do the second pass of a modified radix-4 2 pass FFTs using SSE2 instructions.
;

INCLUDE r4pass2.mac

r4spm_pass2_12_levels_real MACRO
	r4_pass2_12_levels_real
	ENDM

; *************** radix4-pass2-12-levels-complex macro ******************
; This macro takes 2 groups of 4096 complex values and
; performs the final 12 levels of a standard radix-4 FFT, squares the
; results, and does the first 12 levels of the inverse FFT.

r4spm_pass2_12_levels_complex MACRO
	r4_pass2_12_levels_complex
	ENDM

