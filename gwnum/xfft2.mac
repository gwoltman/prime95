; These macros perform the medium-sized 2 pass FFTs using SSE2 instructions.
;

; ********************************************************
; ********************************************************
; ********************  FFT MACROS  **********************
; ********************************************************
; ********************************************************

;; When doing zero-padded FFTs, the 7 words around the halfway point must
;; be copied for later processing.  This macro does that before a typical
;; forward FFT.

xcopy_7_words MACRO
	LOCAL	nozpad
	cmp	_ZERO_PADDED_FFT, 0	;; Is this a zero-padded FFT?
	je	short nozpad		;; No, skip 7 word copy
	_movsd	xmm0, [rsi+rbx+32]	;; Copy 1st word above half-way point
	_movsd	[rsi-40], xmm0
	_movsd	xmm1, [rsi+rbx+96]	;; Copy 2nd word
	_movsd	[rsi-48], xmm1
	_movsd	xmm2, [rsi+rbx+160]	;; Copy 3rd word
	_movsd	[rsi-56], xmm2
	_movsd	xmm3, [rsi+rbx+224]	;; Copy 4th word
	_movsd	[rsi-64], xmm3
	mov	eax, _HIGH_WORD1_OFFSET	;; Copy 1st word below half-way
	add	rax, rsi
	_movsd	xmm0, [rax+rbx]
	_movsd	[rsi-72], xmm0
	mov	eax, _HIGH_WORD2_OFFSET	;; Copy 2nd word below
	add	rax, rsi
	_movsd	xmm1, [rax+rbx]
	_movsd	[rsi-80], xmm1
	mov	eax, _HIGH_WORD3_OFFSET	;; Copy 3rd word below
	add	rax, rsi
	_movsd	xmm2, [rax+rbx]
	_movsd	[rsi-88], xmm2
nozpad:
	ENDM
;; When POSTFFT is set, we must copy the 7 words at two different spots.
;; These two macros copy the four values above the half-way point after
;; carries have been propagated and copy the three words just below the
;; half-way point right after the last NORMRTN has been called.
xcopy_4_words MACRO
	LOCAL	nozpad
	cmp	_ZERO_PADDED_FFT, 0	;; Is this a zero-padded FFT?
	je	short nozpad		;; No, skip 4 word copy
	_movsd	xmm0, [rsi+32]		;; Copy 1st word above half-way point
	_movsd	[rsi-40], xmm0
	_movsd	xmm1, [rsi+96]		;; Copy 2nd word
	_movsd	[rsi-48], xmm1
	_movsd	xmm2, [rsi+160]		;; Copy 3rd word
	_movsd	[rsi-56], xmm2
	_movsd	xmm3, [rsi+224]		;; Copy 4th word
	_movsd	[rsi-64], xmm3
nozpad:
	ENDM
xcopy_3_words MACRO clm			;; Assumes clm >= 2
	LOCAL	nozpad
	cmp	_ZERO_PADDED_FFT, 0	;; Is this a zero-padded FFT?
	je	short nozpad		;; No, skip 3 word copy
	cmp	edx, 1			;; Only copy on last inverse FFT pass
	jne	short nozpad		;; Jump if delaying
	mov	rdi, _DESTARG		;; Load destination pointer
	mov	eax, _HIGH_WORD1_OFFSET	;; Copy 1st word below half-way
	_movsd	xmm0, [rdi+rax]
	_movsd	[rdi-72], xmm0
	mov	eax, _HIGH_WORD2_OFFSET	;; Copy 2nd word below
	_movsd	xmm1, [rdi+rax]
	_movsd	[rdi-80], xmm1
	mov	eax, _HIGH_WORD3_OFFSET	;; Copy 3rd word below
	_movsd	xmm2, [rdi+rax]
	_movsd	[rdi-88], xmm2
nozpad:
	ENDM

;; When doing zero-padded FFTs, the multiplied 7 words around the halfway point
;; must be subtracted from the bottom of the FFT.  This must be done before
;; normalization multiplies the FFT data by k.  This macro does that.

xsub_7_words MACRO clm
	LOCAL	nozpad, zlp
	cmp	_ZERO_PADDED_FFT, 0	;; Is this a zero-padded FFT?
	je	short nozpad		;; No, skip 7 word subtract
	cmp	edx, 512/8/clm-4/clm	;; Only do this on the iteration
	jle	short nozpad		;; that worked on these FFT data items
	mov	rdi, zpad_addr		;; Addr of next zpad element to process
	_movsd	xmm7, XMM_SUMOUT	;; Load sumout for patching
zlp:	_movsd	xmm0, [rsi]		;; Load FFT word
	_movsd	xmm1, [rdi]		;; Load ZPAD data
	mulsd	xmm1, XMM_NORM012_FF	;; Scale by FFTLEN/2
	subsd	xmm0, xmm1
	addsd	xmm7, xmm1		;; Adjust sumout
	_movsd	[rsi], xmm0
	lea	rsi, [rsi+64]		;; Bump pointers
	lea	rdi, [rdi+8]
	add	al, 256/(2*clm)		;; Iterate 2*clm (up to 8) times
	jnc	short zlp		;; Loop if necessary
	lea	rsi, [rsi-2*clm*64]	;; Restore source ptr
	_movsd	XMM_SUMOUT, xmm7	;; Store patched sumout
	mov	zpad_addr, rdi
nozpad:
	ENDM


; WARNING, WARNING, WARNING:  This file was copied from xfft3.mac.
; Rather than re-comment everything, all memory layouts should just be
; divided by 8!!!!


;; Perform a 40K-element FFT.  This is done in two passes.  Pass 1
;; does 5 levels, pass 2 uses common code to perform the last 11 levels.

xfft5K MACRO
	LOCAL	b0b, b1b, b2b, b3b
	LOCAL	c0b, c1b, c2b, c3b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 4 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	...

;; Do 2 eight_reals_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

c2b:	x1cl_half_eight_reals_unfft_2 rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	c2b

;; Do 8 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 4 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
c3b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*2*blkdst-blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	16K	24K	32K
;;	10K
;;	...
;;	14K

;; Do 8 five_reals_last_unfft macros
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 40 data values

	xfive_reals_unfft_preload	;; Preload consts for five real macros
c1b:	x5cl_five_reals_last_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	16K	24K	32K
;;	10K
;;	...
;;	14K

;; Do 16 five_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 8K
;;	do 2 iterations each processing 40 data values

b0b:
	sub	eax, eax		;; 1 iteration of 2
	xfive_reals_fft_preload		;; Preload consts for five real macros
b1b:	x5cl_five_reals_first_fft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-7K is real data, 16K-39K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	4K	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b

;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
b3b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64-blkdst];; Restore source pointer

;; Work on next 4 sets of 20 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 48K-element FFT.  This is done in two passes.  Pass 1
;; does 5 levels, pass 2 uses common code to perform the last 11 levels.

xfft6K MACRO
	LOCAL	b0b, b1b, b2b, b3b
	LOCAL	c0b, c1b, c2b, c3b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 5 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c2b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	c2b

;; Do 8 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 4 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
c3b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K

;; Do 16 six_reals_last_unfft macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 24 data values

	mov	al, 2			;; Load loop counter
	xsix_reals_unfft_preload
c1b:	x3cl_six_reals_last_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K

;; Do 16 six_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 8K
;;	do 4 iterations each processing 24 data values

b0b:
	mov	eax, 2			;; 2 iterations of 2
	xsix_reals_fft_preload
b1b:	x3cl_six_reals_first_fft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-47K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

b2b:	x2cl_eight_reals_fft_2 rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b2b

;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
b3b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64-2*blkdst];; Restore source pointer

;; Work on next 4 sets of 24 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 56K-element FFT.  This is done in two passes.  Pass 1
;; does 5 levels, pass 2 uses common code to perform the last 11 levels.

xfft7K MACRO
	LOCAL	b0b, b1b, b2b, b3a, b3b
	LOCAL	c0b, c1b, c2b, c3b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 6 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	10K
;;	24K
;;	...

;; Do 2 eight_reals_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c2b:	x1cl_half_eight_reals_unfft_2 rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	c2b

;; Do 12 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 6 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 3			;; 3 iterations of 2
c3b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*2*blkdst-blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	10K
;;	24K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	10K
;;	24K	32K	40K	48K
;;	26K
;;	...
;;	30K

;; Do 16 seven_reals_last_unfft macros
;;	distance between fft data elements is 8K
;;	do 2 macros each processing 56 data values

	xseven_reals_unfft_preload
c1b:	x7cl_seven_reals_last_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+5*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	10K
;;	24K	32K	40K	48K
;;	26K
;;	...
;;	30K

;; Do 16 seven_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 8K
;;	do 2 iterations each processing 56 data values

b0b:
	sub	eax, eax
	xseven_reals_fft_preload
b1b:	x7cl_seven_reals_first_fft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-55K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	12K	16K	20K
;;	10K
;;	24K	32K	40K	48K
;;	26K
;;	...
;;	30K
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b

;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
b3a:	x2cl_four_complex_fft rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3a			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b3a

;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
b3b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64-3*blkdst];; Restore source pointer

;; Work on next 4 sets of 28 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 64K-element FFT.  This is done in two passes.  Pass 1
;; does 5 levels, pass 2 uses common code to perform the last 11 levels.

xfft8K MACRO
	LOCAL	b0b, b1b, b2b, b3b
	LOCAL	c0b, c1b, c2b, c3b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 7 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c2b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	c2b

;; Do 12 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 6 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 3			;; 3 iterations of 2
c3b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K

;; Do 16 eight_reals_last_unfft macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; Load loop counter
c1b:	x4cl_eight_reals_last_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	4K	...
;;	6K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 8K
;;	do 8 iterations each processing 16 data values

b0b:
	mov	eax, 4			;; 4 iterations of 2
b1b:	x2cl_eight_reals_first_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+6*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-63K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	4K	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b2b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b2b

;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
b3b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64-4*blkdst];; Restore source pointer

;; Work on next 4 sets of 32 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 80K-element FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft10K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 9 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...

;; Do 2 eight_reals_unfft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

c4b:	x1cl_eight_reals_unfft_1 rsi, 64
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 36 two_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 18 macros each processing 8 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 9			;; 9 iterations of 2
c5b:	x1cl_two_complex_unfft rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-10*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	...

;; Do 4 eight_reals_unfft_2 macros
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 16 data values

c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	c2b

;; Do 16 four_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
c3b:	x4cl_four_complex_unfft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*4*blkdst-2*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	32K	48K	64K
;;	18K
;;	...
;;	30K

;; Do 32 five_reals_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 40 data values

	mov	al, 2			;; Load loop counter
	xfive_reals_unfft_preload	;; Preload consts for five real macros
c1b:	x5cl_five_reals_last_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	32K	48K	64K
;;	18K
;;	...
;;	30K

;; Do 32 five_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 40 data values

b0b:
	mov	eax, 2			;; 2 iterations of 2
	xfive_reals_fft_preload		;; Preload consts for five real macros
b1b:	x5cl_five_reals_first_fft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+3*blkdst]
	prefetcht1 [rsi-128+5*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-127K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	32K	48K	64K
;;	18K
;;	...
;;	30K
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft_2 macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 8 data values

	mov	al, 2			;; 2 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst-2*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-3K is real data, 4K-7K is semi-real data, 8K-127K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x2cl_eight_reals_fft_1 rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 32 two_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 8 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 4			;; 4 iterations of 2
b5b:	x2cl_two_complex_fft rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-5*2*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 40 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 96K-element FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft12K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 11 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...

;; Do 2 eight_reals_unfft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

c4b:	x1cl_eight_reals_unfft_1 rsi, 64
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 22 two_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 22 macros each processing 8 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 11			;; 11 iterations of 2
c5b:	x1cl_two_complex_unfft rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-12*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft_2 macros
;; Do 4 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values

c2b:	x4cl_eight_reals_unfft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c2b

;; Do 16 four_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
c3b:	x4cl_four_complex_unfft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K

;; Do 32 six_reals_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 24 data values

	mov	al, 4			;; Load loop counter
	xsix_reals_unfft_preload
c1b:	x3cl_six_reals_last_unfft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K

;; Do 32 six_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 8 iterations each processing 24 data values

b0b:
	mov	eax, 4			;; 4 iterations of 2
	xsix_reals_fft_preload
b1b:	x3cl_six_reals_first_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+5*blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-95K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft_2 macros
;; Do 4 nop_two_two_complex_fft_2 macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2
b2b:	x2cl_eight_reals_fft_2 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst-4*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-3K is real data, 4K-7K is semi-real data, 8K-95K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x2cl_eight_reals_fft_1 rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 40 two_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 10 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 5			;; 5 iterations of 2
b5b:	x2cl_two_complex_fft rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-6*2*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 48 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 96K-element all-complex FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft12Kp MACRO
	LOCAL	b0b, b1b, b2b, b3b, b5b, c0b, c1b, c3b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	short pass2		;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 12 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels_p
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 12 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 6 macros each processing 16 data values

c0b:	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 6			;; 6 iterations of 2*clm
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-6*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 24 two_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 6 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 3*256+2		;; 3 iters of 2 iters of 2*clm
c3b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	...
;;	22K

;; Do 8 three_complex_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 24 data values

	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	al, 4			;; 4 iterations of 2*clm
c1b:	x3cl_three_complex_last_unfft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+192]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	24K	48K	72K
;;	...
;;	22K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K

;; Do 32 three_complex_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 8 iterations each processing 24 data values

b0b:	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	eax, 4			;; 4 iterations of 2*clm
b1b:	x3cl_three_complex_first_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+5*blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+192]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Do FFT levels 4
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 24 two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 6 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2*clm
b2b:	x2cl_two_complex_fft_in_place rsi, 64, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sin/cos pointer
	mov	al, 4			;; 4 iterations of 2*clm
b3b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-4*blkdst];; Restore source pointer

;; Do FFT levels 5,6
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 12 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 6 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 3			;; 3 iterations of 2*clm
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-3*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 48 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 112K-element FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft14K MACRO
	LOCAL	b0b, b1b, b2b, b3a, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 13 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...

;; Do 2 eight_reals_unfft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

c4b:	x1cl_eight_reals_unfft_1 rsi, 64
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 52 two_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 26 macros each processing 8 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 13			;; 13 iterations of 2
c5b:	x1cl_two_complex_unfft rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-14*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	...

;; Do 4 eight_reals_unfft_2 macros
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 16 data values

c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	c2b

;; Do 24 four_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 6 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 3			;; 3 iterations of 2
c3b:	x4cl_four_complex_unfft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*4*blkdst-2*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K
;;	48K	64K	80K	96K
;;	50K
;;	...
;;	62K

;; Do 32 seven_reals_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 4 macros each processing 56 data values

	mov	al, 2			;; Load loop counter
	xseven_reals_unfft_preload
c1b:	x7cl_seven_reals_last_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+10*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K
;;	48K	64K	80K	96K
;;	50K
;;	...
;;	62K

;; Do 32 seven_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 4 iterations each processing 56 data values

b0b:
	mov	eax, 2			;; 2 iterations of 2
	xseven_reals_fft_preload
b1b:	x7cl_seven_reals_first_fft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-127K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	24K	32K	40K
;;	18K
;;	...
;;	22K
;;	48K	64K	80K	96K
;;	50K
;;	...
;;	62K
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft_2 macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 8 data values

	mov	al, 2			;; 2 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
b3a:	x2cl_four_complex_fft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3a			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	b3a
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3a			;; Iterate if necessary

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 2			;; 2 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst-6*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-3K is real data, 4K-7K is semi-real data, 8K-111K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x2cl_eight_reals_fft_1 rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 48 two_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 12 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 6			;; 6 iterations of 2
b5b:	x2cl_two_complex_fft rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-7*2*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 56 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 128K-element FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft16K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 15 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...

;; Do 2 eight_reals_unfft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 8 data values

c4b:	x1cl_eight_reals_unfft_1 rsi, 64
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 60 two_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 30 macros each processing 8 data values

	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 15			;; 15 iterations of 2
c5b:	x1cl_two_complex_unfft rsi, 64
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+3*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 4 eight_reals_unfft_2 macros
;; Do 4 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 4K
;;	do 2 macros each processing 32 data values

c2b:	x4cl_eight_reals_unfft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c2b

;; Do 24 four_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 6 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 3			;; 3 iterations of 2
c3b:	x4cl_four_complex_unfft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K

;; Do 32 eight_reals_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values

	mov	al, 4			;; Load loop counter
c1b:	x4cl_eight_reals_last_unfft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 32 eight_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 16 iterations each processing 16 data values

b0b:
	mov	eax, 8			;; 8 iterations of 2
b1b:	x2cl_eight_reals_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+12*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-127K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 4 eight_reals_fft_2 macros
;; Do 4 nop_two_two_complex_fft_2 macros
;; Do 8 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 2			;; 2 iterations of 2
b2b:	x4cl_eight_reals_fft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 4K
;;	do 4 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 2			;; 2 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst-8*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-3K is real data, 4K-7K is semi-real data, 8K-127K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_1 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x2cl_eight_reals_fft_1 rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 56 two_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 14 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 7			;; 7 iterations of 2
b5b:	x2cl_two_complex_fft rsi, 64, blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-8*2*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 64 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 128K-element all-complex FFT.  This is done in two passes.  Pass 1
;; does 6 levels, pass 2 uses common code to perform the last 11 levels.

xfft16Kp MACRO
	LOCAL	b0b, b1b, b3b, b5b, c0b, c1b, c3b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0	;; Test FFT-started flag
	jne	short pass2		;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 16 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels_p
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 16 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 8 macros each processing 16 data values

c0b:	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2*clm
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+3*blkdst]
	prefetcht1 [rsi-128+4*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-8*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 32 two_complex_unfft macros
;;	distance between fft data elements is 4K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2*clm
	mov	eax, 4*256+2		;; 4 iters of 2 iters of 2*clm
c3b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K

;; Do 32 four_complex_last_unfft macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values

	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	al, 4			;; Load loop counter
c1b:	x4cl_four_complex_last_unfft rsi, 64, 4*blkdst, 8*blkdst, 4*128
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+128]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 32 four_complex_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 16K
;;	do 16 iterations each processing 16 data values

b0b:
	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	eax, 8			;; 8 iterations of 2
b1b:	x2cl_four_complex_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+12*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+128]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 32 two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 256*2+4		;; 2 iters of 4 iters of 2*clm
b3b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sin/cos pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-2*8*blkdst]	;; Restore source pointer

;; Do FFT levels 5,6
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2*clm
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 64 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 160K-element FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft20K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 19 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c4b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 72 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 18 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 9			;; 9 iterations of 2
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-10*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	...

;; Do 8 eight_reals_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 32 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 2*256+2		;; 2 iterations of 2 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*8*blkdst-4*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	64K	96K	128K
;;	34K
;;	...
;;	62K

;; Do 64 five_reals_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 40 data values

	mov	al, 4			;; Load loop counter
	xfive_reals_unfft_preload	;; Preload consts for five real macros
c1b:	x5cl_five_reals_last_unfft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	64K	96K	128K
;;	34K
;;	...
;;	62K

;; Do 64 five_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 8 iterations each processing 40 data values

b0b:
	mov	eax, 4			;; 4 iterations of 2
	xfive_reals_fft_preload		;; Preload consts for five real macros
b1b:	x5cl_five_reals_first_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+5*blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	prefetcht1 [rsi-128+13*blkdst]
	prefetcht1 [rsi-128+17*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-31K is real data, 32K-159K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	64K	96K	128K
;;	34K
;;	...
;;	62K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_2 macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 8 data values

	mov	al, 4			;; 4 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-4*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-159K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 4			;; 4 iterations of 2
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-5*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 80 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 192K-element FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft24K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 23 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c4b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 44 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 22 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 11			;; 11 iterations of 2
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-12*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 32 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 2*256+2		;; 2 iterations of 2 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K

;; Do 64 six_reals_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 24 data values

	mov	al, 8			;; Load loop counter
	xsix_reals_unfft_preload
c1b:	x3cl_six_reals_last_unfft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K

;; Do 64 six_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 16 iterations each processing 24 data values

b0b:
	mov	eax, 8			;; 8 iterations of 2
	xsix_reals_fft_preload
b1b:	x3cl_six_reals_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	prefetcht1 [rsi-128+17*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-191K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_2 macros
;; Do 8 nop_two_two_complex_fft_2 macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	al, 4			;; 4 iterations of 2
b2b:	x2cl_eight_reals_fft_2 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-8*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-191K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 40 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 10 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 5			;; 5 iterations of 2
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-6*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 96 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 192K-element all-complex FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft24Kp MACRO
	LOCAL	b0b, b1b, b2b, b3b, b5b, c0b, c1b, c3b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	short pass2		;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 24 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels_p
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 48 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 12 macros each processing 16 data values

c0b:	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 12			;; 12 iterations of 2*clm
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-12*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 48 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 12 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 3*256+2		;; 3 iterations of 2 iters of 2*clm
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	...
;;	46K

;; Do 64 three_complex_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 24 data values

	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	al, 8			;; 8 iterations of 2*clm
c1b:	x3cl_three_complex_last_unfft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+192]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	48K	96K	144K
;;	...
;;	46K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K

;; Do 64 three_complex_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 16 iterations each processing 24 data values

b0b:	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	eax, 8			;; 8 iterations of 2*clm
b1b:	x3cl_three_complex_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+blkdst]
	prefetcht1 [rsi-128+9*blkdst]
	prefetcht1 [rsi-128+17*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+192]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 48 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2*clm
b2b:	x2cl_four_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sin/cos pointer
	mov	al, 4			;; 4 iterations of 2*clm
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-8*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 48 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 12 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 6			;; 6 iterations of 2*clm
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-6*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 96 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 224K-element FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft28K MACRO
	LOCAL	b0b, b1b, b2b, b3a, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 27 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c4b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 52 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 26 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 13			;; 13 iterations of 2
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-14*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	...

;; Do 8 eight_reals_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 48 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 12 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 3*256+2		;; 3 iterations of 2 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*8*blkdst-4*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K
;;	96K	128K	160K	192K
;;	98K
;;	...
;;	126K

;; Do 64 seven_reals_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 8 macros each processing 56 data values

	mov	al, 4			;; Load loop counter
	xseven_reals_unfft_preload
c1b:	x7cl_seven_reals_last_unfft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+20*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K
;;	96K	128K	160K	192K
;;	98K
;;	...
;;	126K

;; Do 64 seven_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 8 iterations each processing 56 data values

b0b:
	mov	eax, 4			;; 4 iterations of 2
	xseven_reals_fft_preload
b1b:	x7cl_seven_reals_first_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+10*blkdst]
	prefetcht1 [rsi-128+14*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+22*blkdst]
	prefetcht1 [rsi-128+26*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-223K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	48K	64K	80K
;;	34K
;;	...
;;	46K
;;	96K	128K	160K	192K
;;	98K
;;	...
;;	126K
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_2 macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 8 data values

	mov	al, 4			;; 4 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b3a:	x2cl_four_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3a			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b3a
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3a			;; Iterate if necessary

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 4			;; 4 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-12*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-223K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 48 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 12 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 6			;; 6 iterations of 2
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-7*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 112 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 256K-element FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft32K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 31 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c4b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c4b			;; Iterate if necessary

;; Do 60 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 30 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 15			;; 15 iterations of 2
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-16*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 48 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 12 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 3*256+2		;; 3 iterations of 2 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K

;; Do 64 eight_reals_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values

	mov	al, 8			;; Load loop counter
c1b:	x4cl_eight_reals_last_unfft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...

;; Do 64 eight_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 32 iterations each processing 16 data values

b0b:
	mov	eax, 16			;; 16 iterations of 2
b1b:	x2cl_eight_reals_first_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+20*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-255K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_2 macros
;; Do 8 nop_two_two_complex_fft_2 macros
;; Do 16 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b2b:	x4cl_eight_reals_fft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 4			;; 4 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst-16*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-255K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b4b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b4b

;; Do 56 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 14 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 7			;; 7 iterations of 2
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-8*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 128 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 256K-element all-complex FFT.  This is done in two passes.  Pass 1
;; does 7 levels, pass 2 uses common code to perform the last 11 levels.

xfft32Kp MACRO
	LOCAL	b0b, b1b, b3b, b5b, c0b, c1b, c3b, c5b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0;; Test FFT-started flag
	jne	short pass2		;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 32 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels_p
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 64 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 32 macros each processing 16 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 16			;; 16 iterations of 2
c5b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-16*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 64 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 16 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 4*256+2		;; 4 iterations of 2 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K

;; Do 64 four_complex_last_unfft macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values

	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	al, 8			;; Load loop counter
c1b:	x4cl_four_complex_last_unfft rsi, 64, 8*blkdst, 16*blkdst, 8*128
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	lea	rdi, [rdi+128]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...

;; Do 64 four_complex_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 32K
;;	do 32 iterations each processing 16 data values

b0b:
	mov	rdi, plus1_premults	;; Address of premultiplier table
	mov	eax, 16			;; 16 iterations of 2
b1b:	x2cl_four_complex_first_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+20*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	lea	rdi, [rdi+128]		;; Next premultiplier pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 2*256+4		;; 2 iterations 4 iters of 2*clm
b3b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256
	mov	al, 4
	jnz	b3b
	lea	rsi, [rsi-2*16*blkdst]	;; Restore source pointer

;; Do FFT levels 6,7
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 16 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2
b5b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-8*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 128 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 320K-element FFT.  This is done in two passes.  Pass 1
;; does 8 levels, pass 2 uses common code to perform the last 11 levels.

xfft40K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 39 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 76 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 38 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 19			;; 19 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-20*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 8 eight_reals_unfft_1 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x2cl_eight_reals_unfft_1 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 72 two_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 36 macros each processing 16 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 9*256+2		;; 9 iterations of 2 iters of 2
c5b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-10*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	...

;; Do 16 eight_reals_unfft_2 macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 16 data values

	mov	al, 4			;; 4 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 64 four_complex_unfft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 2*256+4		;; 2 iterations of 4 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*16*blkdst-8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	128K	192K	256K
;;	66K
;;	...
;;	126K

;; Do 128 five_reals_last_unfft macros
;;	distance between fft data elements is 64K
;;	do 16 macros each processing 40 data values

	mov	al, 8			;; 8 iterations of 2
	xfive_reals_unfft_preload	;; Preload consts for five real macros
c1b:	x5cl_five_reals_last_unfft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	128K	192K	256K
;;	66K
;;	...
;;	126K

;; Do 128 five_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 64K
;;	do 16 iterations each processing 40 data values

b0b:
	mov	eax, 8			;; 8 iterations of 2
	xfive_reals_fft_preload		;; Preload consts for five real macros
b1b:	x5cl_five_reals_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+10*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+26*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-63K is real data, 64K-319K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	128K	192K	256K
;;	66K
;;	...
;;	126K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 8 data values

	mov	al, 8			;; 8 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst-8*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-319K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_1 macros
;; Do 8 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x2cl_eight_reals_fft_1 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 64 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 32 macros each processing 16 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 4*256+4		;; 4 iterations of 4 iters of 2
b5b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-5*8*blkdst]	;; Restore source pointer

;; Do FFT levels 7,8
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-319K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 72 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 18 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 9			;; 9 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-10*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 160 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 384K-element FFT.  This is done in two passes.  Pass 1
;; does 8 levels, pass 2 uses common code to perform the last 11 levels.

xfft48K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 47 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 92 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 46 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 23			;; 23 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-24*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 8 eight_reals_unfft_1 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x2cl_eight_reals_unfft_1 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 88 two_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 44 macros each processing 16 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 11*256+2		;; 11 iterations of 2 iters of 2
c5b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-12*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft_2 macros
;; Do 16 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values

	mov	al, 4			;; 4 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 64 four_complex_unfft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 2*256+4		;; 2 iterations of 4 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*16*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K

;; Do 128 six_reals_last_unfft macros
;;	distance between fft data elements is 64K
;;	do 32 macros each processing 24 data values

	mov	al, 16			;; 16 iterations of 2
	xsix_reals_unfft_preload
c1b:	x3cl_six_reals_last_unfft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K

;; Do 128 six_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 64K
;;	do 32 iterations each processing 24 data values

b0b:
	mov	eax, 16			;; 16 iterations of 2
	xsix_reals_fft_preload
b1b:	x3cl_six_reals_first_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-63K is real data, 64K-127K is semi-real data, and
;; 128K-383K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 nop_two_two_complex_fft_2 macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 16 data values

	mov	al, 8			;; 8 iterations of 2
b2b:	x2cl_eight_reals_fft_2 rsi, 64, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+16*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst];; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst-16*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-383K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_1 macros
;; Do 8 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x2cl_eight_reals_fft_1 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 80 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 40 macros each processing 16 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 5*256+4		;; 5 iterations of 4 iters of 2
b5b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-6*8*blkdst]	;; Restore source pointer

;; Do FFT levels 7,8
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-383K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 88 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 22 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 11			;; 11 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-12*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 192 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 448K-element FFT.  This is done in two passes.  Pass 1
;; does 8 levels, pass 2 uses common code to perform the last 11 levels.

xfft56K MACRO
	LOCAL	b0b, b1b, b2b, b3a, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 55 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 108 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 54 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 27			;; 27 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-28*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 8 eight_reals_unfft_1 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x2cl_eight_reals_unfft_1 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 104 two_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 52 macros each processing 16 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 13*256+2		;; 13 iterations of 2 iters of 2
c5b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-14*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	...

;; Do 16 eight_reals_unfft_2 macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 16 data values

	mov	al, 4			;; 4 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 96 four_complex_unfft macros
;;	distance between fft data elements is 16K
;;	do 24 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 3*256+4		;; 3 iterations of 4 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*16*blkdst-8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K
;;	192K	256K	320K	384K
;;	194K
;;	...
;;	254K

;; Do 128 seven_reals_last_unfft macros
;;	distance between fft data elements is 64K
;;	do 16 macros each processing 56 data values

	mov	al, 8			;; 8 iterations of 2
	xseven_reals_unfft_preload
c1b:	x7cl_seven_reals_last_unfft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+40*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K
;;	192K	256K	320K	384K
;;	194K
;;	...
;;	254K

;; Do 128 seven_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 64K
;;	do 16 iterations each processing 56 data values

b0b:
	mov	eax, 8			;; 8 iterations of 2
	xseven_reals_fft_preload
b1b:	x7cl_seven_reals_first_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+10*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+26*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	prefetcht1 [rsi-128+42*blkdst]
	prefetcht1 [rsi-128+50*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-63K is real data, 64K-447K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	96K	128K	160K
;;	66K
;;	...
;;	94K
;;	192K	256K	320K	384K
;;	194K
;;	...
;;	254K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 8 data values

	mov	al, 8			;; 8 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 16 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2
b3a:	x2cl_four_complex_fft rsi, 64, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3a			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	b3a
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3a			;; Iterate if necessary

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 8			;; 8 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst-24*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-447K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_1 macros
;; Do 8 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x2cl_eight_reals_fft_1 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 96 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 48 macros each processing 16 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 6*256+4		;; 6 iterations of 4 iters of 2
b5b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-7*8*blkdst]	;; Restore source pointer

;; Do FFT levels 7,8
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-447K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 104 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 26 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 13			;; 13 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-14*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 224 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 512K-element FFT.  This is done in two passes.  Pass 1
;; does 8 levels, pass 2 uses common code to perform the last 11 levels.

xfft64K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 63 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 124 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 62 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 31			;; 31 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-32*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...

;; Do 8 eight_reals_unfft_1 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 16 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x2cl_eight_reals_unfft_1 rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 120 two_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 60 macros each processing 16 data values

	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 15*256+2		;; 15 iterations of 2 iters of 2
c5b:	x2cl_two_complex_unfft rsi, 64, 2*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-16*4*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	...
;;	...

;; Do 16 eight_reals_unfft_2 macros
;; Do 16 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 16K
;;	do 8 macros each processing 32 data values

	mov	al, 4			;; 4 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 96 four_complex_unfft macros
;;	distance between fft data elements is 16K
;;	do 24 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 3*256+4		;; 3 iterations of 4 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*16*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	2K	...
;;	...
;;	126K

;; Do 128 eight_reals_last_unfft macros
;;	distance between fft data elements is 64K
;;	do 32 macros each processing 32 data values

	mov	al, 16			;; Load loop counter
c1b:	x4cl_eight_reals_last_unfft rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	2K	...
;;	...
;;	126K
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K	...
;;	256K	...
;;	...

;; Do 128 eight_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 64K
;;	do 64 iterations each processing 16 data values

b0b:
	mov	eax, 32			;; 32 iterations of 2
b1b:	x2cl_eight_reals_first_fft rsi, 64, 32*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+36*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-32*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-63K is real data, 64K-127K is semi-real data, 128K-511K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K	...
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 nop_two_two_complex_fft_2 macros
;; Do 32 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 8			;; 8 iterations of 2
b2b:	x4cl_eight_reals_fft_2 rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 16K
;;	do 16 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 8			;; 8 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst-32*blkdst];; Restore source pointer

;; Do FFT levels 6
;; Values 0K-15K is real data, 16K-31K is semi-real data, 32K-511K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 8 eight_reals_fft_1 macros
;; Do 8 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 16 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x2cl_eight_reals_fft_1 rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 112 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 56 macros each processing 16 data values

	lea	rsi, [rsi-4*blkdst+8*blkdst];; Load source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 7*256+4		;; 7 iterations of 4 iters of 2
b5b:	x2cl_two_complex_fft rsi, 64, 4*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-8*8*blkdst]	;; Restore source pointer

;; Do FFT levels 7,8
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-511K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 120 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 30 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 15			;; 15 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-16*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 256 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 640K-element FFT.  This is done in two passes.  Pass 1
;; does 9 levels, pass 2 uses common code to perform the last 11 levels.

xfft80K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 79 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 156 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 78 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 39			;; 39 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-40*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 144 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 36 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 9*256+2		;; 9 iterations of 2 iters of 2
c5b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-10*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	...

;; Do 32 eight_reals_unfft_2 macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 16 data values

	mov	al, 8			;; 8 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 128 four_complex_unfft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+16*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 2*256+8		;; 2 iterations of 8 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 8			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-2*32*blkdst-16*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	256K	384K	512K
;;	130K
;;	...
;;	254K

;; Do 256 five_reals_last_unfft macros
;;	distance between fft data elements is 128K
;;	do 32 macros each processing 40 data values

	mov	al, 16			;; Load loop counter
	xfive_reals_unfft_preload	;; Preload consts for five real macros
c1b:	x5cl_five_reals_last_unfft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	prefetcht1 [rsi-128+clm*128+64*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	256K	384K	512K
;;	130K
;;	...
;;	254K

;; Do 256 five_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 128K
;;	do 32 iterations each processing 40 data values

b0b:
	mov	eax, 16			;; 16 iterations of 2
	xfive_reals_fft_preload		;; Preload consts for five real macros
b1b:	x5cl_five_reals_first_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	prefetcht1 [rsi-128+50*blkdst]
	prefetcht1 [rsi-128+66*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-127K is real data, 128K-639K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	256K	384K	512K
;;	130K
;;	...
;;	254K
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft_2 macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 8 data values

	mov	al, 16			;; 16 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 128 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 16			;; 16 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst-16*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-639K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x4cl_eight_reals_fft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 128 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Load source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 4*256+4		;; 4 iterations of 4 iters of 2
b5b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-5*16*blkdst]	;; Restore source pointer

;; Do FFT levels 8,9
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-619K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 152 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 38 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 19			;; 19 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-20*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 320 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 768K-element FFT.  This is done in two passes.  Pass 1
;; does 9 levels, pass 2 uses common code to perform the last 11 levels.

xfft96K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 95 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 188 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 94 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 47			;; 47 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-48*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 176 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 44 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 11*256+2		;; 11 iterations of 2 iters of 2
c5b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-12*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	30K
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft_2 macros
;; Do 32 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values

	mov	al, 8			;; 8 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 128 four_complex_unfft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 2*256+8		;; 2 iterations of 8 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 8			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*32*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	30K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;;	256K	384K	512K	640K
;;	258K
;;	...
;;	382K

;; Do 256 six_reals_last_unfft macros
;;	distance between fft data elements is 128K
;;	do 64 macros each processing 24 data values

	mov	al, 32			;; Load loop counter
	xsix_reals_unfft_preload
c1b:	x3cl_six_reals_last_unfft rsi, 64, 32*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+64*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-32*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;;	256K	384K	512K	640K
;;	258K
;;	...
;;	382K

;; Do 256 six_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 128K
;;	do 64 iterations each processing 24 data values

b0b:
	mov	eax, 32			;; 32 iterations of 2
	xsix_reals_fft_preload
b1b:	x3cl_six_reals_first_fft rsi, 64, 32*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	prefetcht1 [rsi-128+66*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-32*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-127K is real data, 128K-255K is semi-real data, and
;; 256K-767K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;;	256K	384K	512K	640K
;;	258K
;;	...
;;	382K
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K	...
;;	64K	...
;;	...

;; Do 32 eight_reals_fft_2 macros
;; Do 32 nop_two_two_complex_fft_2 macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 16 data values

	mov	al, 16			;; 16 iterations of 2
b2b:	x2cl_eight_reals_fft_2 rsi, 64, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 128 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-16*blkdst+32*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 16			;; 16 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst-32*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-767K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x4cl_eight_reals_fft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 160 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 40 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Load source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 5*256+4		;; 5 iterations of 4 iters of 2
b5b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-6*16*blkdst]	;; Restore source pointer

;; Do FFT levels 8,9
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-767K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 184 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 46 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 23			;; 23 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-24*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 384 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 896K-element FFT.  This is done in two passes.  Pass 1
;; does 9 levels, pass 2 uses common code to perform the last 11 levels.

xfft112K MACRO
	LOCAL	b0b, b1b, b2b, b3a, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 111 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 220 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 110 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 55			;; 55 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-56*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 208 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 52 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 13*256+2		;; 13 iterations of 2 iters of 2
c5b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-14*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	...

;; Do 32 eight_reals_unfft_2 macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 16 data values

	mov	al, 8			;; 8 iterations of 2
c2b:	x2cl_half_eight_reals_unfft_2 rsi, 64, 8*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 192 four_complex_unfft macros
;;	distance between fft data elements is 32K
;;	do 48 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+16*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 3*256+8		;; 3 iterations of 8 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 8			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-3*32*blkdst-16*blkdst];; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K
;;	384K	512K	640K	768K
;;	386K
;;	...
;;	510K

;; Do 256 seven_reals_last_unfft macros
;;	distance between fft data elements is 128K
;;	do 32 macros each processing 56 data values

	mov	al, 16			;; Load loop counter
	xseven_reals_unfft_preload
c1b:	x7cl_seven_reals_last_unfft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	prefetcht1 [rsi-128+clm*128+64*blkdst]
	prefetcht1 [rsi-128+clm*128+80*blkdst]
	prefetcht1 [rsi-128+clm*128+96*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input and output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K
;;	384K	512K	640K	768K
;;	386K
;;	...
;;	510K

;; Do 256 seven_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 128K
;;	do 32 iterations each processing 56 data values

b0b:	mov	eax, 16			;; 16 iterations of 2
	xseven_reals_fft_preload
b1b:	x7cl_seven_reals_first_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+2*blkdst]
	prefetcht1 [rsi-128+18*blkdst]
	prefetcht1 [rsi-128+34*blkdst]
	prefetcht1 [rsi-128+50*blkdst]
	prefetcht1 [rsi-128+66*blkdst]
	prefetcht1 [rsi-128+82*blkdst]
	prefetcht1 [rsi-128+98*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-127K is real data, 128K-895K is complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K
;;	128K	192K	256K	320K
;;	130K
;;	...
;;	190K
;;	384K	512K	640K	768K
;;	386K
;;	...
;;	510K
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft_2 macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 8 data values

	mov	al, 16			;; 16 iterations of 2
b2b:	x1cl_half_eight_reals_fft_2 rsi, 64
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 16 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 16			;; 16 iterations of 2
b3a:	x2cl_four_complex_fft rsi, 64, 16*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3a			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	add	cl, 256/clm
	jnc	b3a
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3a			;; Iterate if necessary

;; Do 128 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-16*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 16			;; 16 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst-48*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-895K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x4cl_eight_reals_fft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 192 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 48 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Load source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 6*256+4		;; 6 iterations of 4 iters of 2
b5b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-7*16*blkdst]	;; Restore source pointer

;; Do FFT levels 8,9
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-895K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 208 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 54 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 27			;; 27 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-28*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 448 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM


;; Perform a 1M-element FFT.  This is done in two passes.  Pass 1
;; does 9 levels, pass 2 uses common code to perform the last 11 levels.

xfft128K MACRO
	LOCAL	b0b, b1b, b2b, b3b, b4b, b5b, b6b, b7b
	LOCAL	c0b, c1b, c2b, c3b, c4b, c5b, c6b, c7b
	LOCAL	pass2, no_fft, fftdn, fftdn1

;; Call FFT code unless the FFT has already been started

	cmp	DWORD PTR [rsi-28][rbx], 0 ;; Test FFT-started flag
	jne	pass2			;; Jump is FFT already started
	mov	norm_ptr1, 0		;; Set FFT-ing flag
	mov	edx, 512/8/clm		;; Load loop counter
	sub	ecx, ecx
	xcopy_7_words
	jmp	b0b			;; Do the pass 1 fft

;; Do the last 11 FFT levels
;;	do 1 pass2_8_levels_real and 127 pass2_8_levels_complex

pass2:	mov	rbp, _SRCARG
	sub	rbp, rsi
	CALL_Y	xpass2_8_levels
	cmp	ffttype, 1		;; We're done if FFTing only
	je	gw_finish_fft_2

;; Do the inverse FFT

	subpd	xmm0, xmm0		;; Init SUMOUT
	movapd	XMM_SUMOUT, xmm0
	movlpd	xmm0, _MAXERR		;; Init maximum error
	movhpd	xmm0, _MAXERR
	movapd	XMM_MAXERR, xmm0
	mov	rdx, norm_biglit_array	;; Addr of the big/little flags array
	mov	norm_ptr1, rdx		;; Save ptr
	mov	rdx, norm_col_mults	;; Addr of the column multipliers
	mov	norm_ptr2, rdx		;; Save ptr
	sub	ecx, ecx

	mov	edx, 512/8/clm		;; Load loop counter
c0b:

;; Do inverse FFT levels 8,9
;; On input the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	10K	12K	14K
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...

;; Do 2 eight_reals_unfft_2 macros
;; Do 2 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 16 data values

c6b:	x2cl_eight_reals_unfft_2 rsi, 64, blkdst
	add	al, 256/2/clm		;; Test loop counter
	jnc	c6b			;; Iterate if necessary

;; Do 252 four_complex_unfft macros
;;	distance between fft data elements is 2K
;;	do 126 macros each processing 16 data values

	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	mov	rdi, sincos1		;; Load sin/cos pointer
	mov	eax, 63			;; 63 iterations of 2
c7b:	x2cl_four_complex_unfft rsi, 64, blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c7b			;; Iterate if necessary
	prefetcht1 [rsi-128+6*blkdst]
	prefetcht1 [rsi-128+7*blkdst]
	add	cl, 256/clm
	jnc	c7b
	lea	rsi, [rsi-2*clm*64+2*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c7b			;; Iterate if necessary
	lea	rsi, [rsi-64*2*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 6,7
;; On input the 64-byte cache lines hold these data values:
;;	0K	4K	8K	12K
;;	2K	...
;;	16K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...

;; Do 8 eight_reals_unfft_2 macros
;; Do 8 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 8K
;;	do 4 macros each processing 32 data values

	mov	al, 2			;; 2 iterations of 2 
c4b:	x4cl_eight_reals_unfft_2 rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c4b			;; Iterate if necessary

;; Do 240 four_complex_unfft macros
;;	distance between fft data elements is 8K
;;	do 60 macros each processing 32 data values

	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	eax, 15*256+2		;; 15 iterations of 2 iters of 2
c5b:	x4cl_four_complex_unfft rsi, 64, 2*blkdst, 4*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+6*blkdst]
	add	cl, 256/clm
	jnc	c5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-2*blkdst+8*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 2			;; Load middle loop counter
	jnz	c5b			;; Iterate if necessary
	lea	rsi, [rsi-16*8*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 4,5
;; On input the 64-byte cache lines hold these data values:
;;	0K	16K	32K	48K
;;	2K	...
;;	...
;;	14K
;;	64K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;;	256K	...
;;	...

;; Do 32 eight_reals_unfft_2 macros
;; Do 32 nop_two_two_complex_unfft_2 macros
;;	distance between fft data elements is 32K
;;	do 16 macros each processing 32 data values

	mov	al, 8			;; 8 iterations of 2
c2b:	x4cl_eight_reals_unfft_2 rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c2b			;; Iterate if necessary

;; Do 192 four_complex_unfft macros
;;	distance between fft data elements is 32K
;;	do 48 macros each processing 32 data values

	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	eax, 3*256+8		;; 3 iterations of 8 iters of 2
c3b:	x4cl_four_complex_unfft rsi, 64, 8*blkdst, 16*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+24*blkdst]
	add	cl, 256/clm
	jnc	c3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-8*blkdst+32*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 8			;; Reload middle counter
	jnz	c3b			;; Iterate if necessary
	lea	rsi, [rsi-4*32*blkdst]	;; Restore source pointer

;; Do inverse FFT levels 1,2,3
;; On input the 64-byte cache lines hold these data values:
;;	0K	64K	128K	192K
;;	2K	...
;;	...
;;	62K
;;	256K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	2K	...
;;	...
;;	254K

;; Do 256 eight_reals_last_unfft macros
;;	distance between fft data elements is 128K
;;	do 64 macros each processing 32 data values

	mov	al, 32			;; Load loop counter
c1b:	x4cl_eight_reals_last_unfft rsi, 64, 32*blkdst, 64*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	c1b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+64*blkdst]
	prefetcht1 [rsi-128+clm*128+96*blkdst]
	add	cl, 256/clm
	jnc	c1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	c1b			;; Iterate if necessary
	lea	rsi, [rsi-32*blkdst]	;; Restore source pointer

;; Normalize these values

	xsub_7_words clm
	mov	rax, _NORMRTN		;; Addr of normalization routine
	call	rax
	sub	eax, eax
	sub	ecx, ecx

;; Have we been given permission to start the FFT on the result?
;; If so, do so now while the data is in the L2 cache.

	cmp	_POSTFFT, 0		;; Test flag
	je	no_fft			;; Skip FFT code if flag not set
	cmp	edx, (512/8/clm-4/clm)	;; Delay fft for first 8 data sets
	jg	no_fft			;; Jump if delaying FFT
	xcopy_3_words clm

;; Do FFT levels 1,2,3
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	256K	512K	768K
;;	2K	...
;;	...
;;	254K
;; On output the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	2K	...
;;	...
;;	126K	...
;;	512K	...
;;	...

;; Do 256 eight_reals_first_fft macros (FFT levels 1,2,3)
;;	distance between fft data elements is 128K
;;	do 128 iterations each processing 16 data values

b0b:
	mov	eax, 64			;; 64 iterations of 2
b1b:	x2cl_eight_reals_first_fft rsi, 64, 64*blkdst
	add	al, 256/2		;; Test loop counter
	jnc	b1b			;; Iterate if necessary
	prefetcht1 [rsi-128+4*blkdst]
	prefetcht1 [rsi-128+68*blkdst]
	add	cl, 256/clm
	jnc	b1b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test loop counter
	jnz	b1b			;; Iterate if necessary
	lea	rsi, [rsi-64*blkdst]	;; Restore source pointer

;; Do FFT levels 4,5
;; Values 0K-127K is real data, 128K-255K is semi-real data, 256K-1023K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	128K	256K	384K
;;	2K	...
;;	...
;;	126K	...
;;	512K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...

;; Do 32 eight_reals_fft_2 macros
;; Do 32 nop_two_two_complex_fft_2 macros
;; Do 64 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	mov	al, 16			;; 16 iterations of 2
b2b:	x4cl_eight_reals_fft_2 rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b2b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	b2b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b2b			;; Iterate if necessary

;; Do 128 four_complex_fft macros
;;	distance between fft data elements is 32K
;;	do 32 macros each processing 32 data values

	lea	rsi, [rsi-16*blkdst+64*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 16			;; 16 iterations of 2
b3b:	x4cl_four_complex_fft rsi, 64, 16*blkdst, 32*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b3b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+16*blkdst]
	prefetcht1 [rsi-128+clm*128+32*blkdst]
	prefetcht1 [rsi-128+clm*128+48*blkdst]
	add	cl, 256/clm
	jnc	b3b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b3b			;; Iterate if necessary
	lea	rsi, [rsi-16*blkdst-64*blkdst];; Restore source pointer

;; Do FFT levels 6,7
;; Values 0K-31K is real data, 32K-63K is semi-real data, 64K-1023K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	32K	64K	96K
;;	2K	...
;;	...
;;	30K	...
;;	128K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...

;; Do 16 eight_reals_fft_2 macros
;; Do 16 two_two_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 8 macros each processing 32 data values

	mov	rdi, sincos2		;; Load sin/cos pointer
	mov	al, 4			;; 4 iterations of 2
b4b:	x4cl_eight_reals_fft_2 rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b4b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b4b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b4b			;; Iterate if necessary

;; Do 224 four_complex_fft macros
;;	distance between fft data elements is 8K
;;	do 56 macros each processing 32 data values

	lea	rsi, [rsi-4*blkdst+16*blkdst];; Load source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	eax, 7*256+4		;; 7 iterations of 4 iters of 2
b5b:	x4cl_four_complex_fft rsi, 64, 4*blkdst, 8*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b5b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+4*blkdst]
	prefetcht1 [rsi-128+clm*128+8*blkdst]
	prefetcht1 [rsi-128+clm*128+12*blkdst]
	add	cl, 256/clm
	jnc	b5b
	lea	rsi, [rsi-2*clm*64+blkdst]	;; Next source pointer
	sub	al, 1			;; Test middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-4*blkdst+16*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	eax, 256		;; Test outer loop counter
	mov	al, 4			;; Load middle loop counter
	jnz	b5b			;; Iterate if necessary
	lea	rsi, [rsi-8*16*blkdst]	;; Restore source pointer

;; Do FFT levels 8,9
;; Values 0K-7K is real data, 8K-15K is semi-real data, 16K-1023K is
;; complex data.
;;
;; On input the 64-byte cache lines hold these data values:
;;	0K	8K	16K	24K
;;	2K	...
;;	...
;;	6K	...
;;	32K	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0K	2K	4K	6K
;;	8K	...
;;	...

;; Do 2 eight_reals_fft_2 macros
;; Do 2 nop_two_two_complex_fft_2 macros
;; Do 4 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 2 macros each processing 32 data values

	mov	rdi, sincos1		;; Load sin/cos pointer
b6b:	x4cl_eight_reals_fft_2 rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b6b			;; Iterate if necessary
	add	cl, 256/clm
	jnc	b6b

;; Do 248 four_complex_fft macros
;;	distance between fft data elements is 2K
;;	do 62 macros each processing 32 data values

	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+XMM_SCD]	;; Next sine/cosine pointer
	mov	al, 31			;; 31 iterations of 2
b7b:	x4cl_four_complex_fft rsi, 64, blkdst, 2*blkdst
	add	al, 256/2		;; Test inner loop counter
	jnc	b7b			;; Iterate if necessary
	prefetcht1 [rsi-128+clm*128]
	prefetcht1 [rsi-128+clm*128+blkdst]
	prefetcht1 [rsi-128+clm*128+2*blkdst]
	prefetcht1 [rsi-128+clm*128+3*blkdst]
	add	cl, 256/clm
	jnc	b7b
	lea	rsi, [rsi-2*clm*64+4*blkdst];; Next source pointer
	lea	rdi, [rdi+2*XMM_SCD]	;; Next sine/cosine pointer
	sub	al, 1			;; Test outer loop counter
	jnz	b7b			;; Iterate if necessary
	lea	rsi, [rsi-32*4*blkdst]	;; Restore source pointer

;; Work on next 4 sets of 512 values

no_fft:	lea	rsi, [rsi+clm*128]	;; Next source pointer
	sub	edx, 1			;; Test loop counter
	jz	short fftdn		;; Jump if done looping
	cmp	norm_ptr1, 0		;; What was the loop start point?
	jne	c0b			;; Do inverse-FFT/norm/FFT iteration
	jmp	b0b			;; Do another FFT-only iteration
fftdn:	lea	rsi, [rsi-512/8*128]	;; Restore source pointer
	sub	ebx, ebx
	cmp	rsi, _DESTARG		;; If esi was not restored, then we 
	jne	short fftdn1		;; just finished skipped postfft data
	cmp	norm_ptr1, 0		;; What was the loop start point?
	je	pass2			;; FFT-only, go do pass 2

;; Split the carries into high and low carries (so they do not exceed
;; the desired number of bits per FFT word.  Then add the carries back to the
;; FFT data.

	call	gw_carries_2

;; Have we been given permission to start the FFT on the result?
;; If so, set loop to FFT the first few cache lines now that the carries
;; have been added in.

	cmp	_POSTFFT, 0		;; Test flag
	je	short fftdn1		;; Skip FFT code if flag not set
	mov	rsi, _DESTARG		;; Load FFT data address
	sub	ebx, ebx
	sub	ecx, ecx
	mov	edx, 4/clm		;; Do 8 previously skipped cache lines
	mov	norm_ptr1, 0		;; Set flag so only forward FFT is done
	xcopy_4_words
	jmp	b0b

;; Now add in the FFT'ed carries, cleanup and return

fftdn1:	jmp	gw_finish_mult_2
	ENDM
