	ENDM
znorm_1d_noconst_echk_ttp MACRO zero
	movzx	rdx, BYTE PTR [rdi]				;; Load index into compressed biglit table
	vmovapd	zmm16, [r10+0*128]				;; Inverse weight
	mov	rdx, [r12+rdx*4]				;; Load 8 big vs. little flags
	kmovw	k1, edx					; 1	;; Load 2 big vs. little flags (16-bit load - we use 8-bits)
	zfmaddpd zmm8, zmm16, [rsi], zmm0		; 1-4	;; x+RNDVAL = carry+RNDVAL + value*inv_weight
	shr	rdx, 16

	vmovapd	zmm17, [r10+1*128]				;; Inverse weight
	kmovw	k2, edx					; 2	;; Load 2 big vs. little flags (16-bit load - we use 8-bits)
	zfmaddpd zmm9, zmm17, [rsi+r13], zmm1		; 2-5	;; x+RNDVAL = carry+RNDVAL + value*inv_weight
	shr	rdx, 16

	vmovapd	zmm18, [r10+2*128]				;; Inverse weight
	kmovw	k3, edx					; 3	;; Load 2 big vs. little flags (16-bit load - we use 8-bits)
	zfmaddpd zmm10, zmm18, [rsi+2*r13], zmm2	; 3-6	;; x+RNDVAL = carry+RNDVAL + value*inv_weight
	shr	rdx, 16

	vmovapd	zmm19, [r10+3*128]				;; Inverse weight
	kmovw	k4, edx					; 4	;; Load 2 big vs. little flags (16-bit load - we use 8-bits)
	zfmaddpd zmm11, zmm19, [rsi+r14], zmm3		; 4-7	;; x+RNDVAL = carry+RNDVAL + value*inv_weight

	vmovapd	zmm20, [r10+0*128+64]				;; Inverse weight
	kshiftrw k5, k1, 8				; 5
	zfmaddpd zmm12, zmm20, [rsi+64], zmm4		; 5-8	;; x+RNDVAL = carry+RNDVAL + value*inv_weight

	vmovapd	zmm21, [r10+1*128+64]				;; Inverse weight
	kshiftrw k6, k2, 8				; 6
	zfmaddpd zmm13, zmm21, [rsi+r13+64], zmm5	; 6-9	;; x+RNDVAL = carry+RNDVAL + value*inv_weight

	vmovapd	zmm22, [r10+2*128+64]				;; Inverse weight
	kshiftrw k7, k3, 8				; 7
	zfmaddpd zmm14, zmm22, [rsi+2*r13+64], zmm6	; 7-10	;; x+RNDVAL = carry+RNDVAL + value*inv_weight

	vmovapd	zmm23, [r10+3*128+64]				;; Inverse weight
	zfmaddpd zmm15, zmm23, [rsi+r14+64], zmm7	; 4-7	;; x+RNDVAL = carry+RNDVAL + value*inv_weight

	vsubpd	zmm0, zmm8, zmm0			; 5-8	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm1, zmm9, zmm1			; 5-8	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm2, zmm10, zmm2			; 6-9	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm3, zmm11, zmm3			; 6-9	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm4, zmm12, zmm4			; 7-10	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm5, zmm13, zmm5			; 7-10	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm6, zmm14, zmm6			; 8-11	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)
	vsubpd	zmm7, zmm15, zmm7			; 8-11	;; tmp = x+RNDVAL - carry+RNDVAL = rnd(value*inv_weight)

	zfnmaddpd zmm0, zmm16, [rsi], zmm0		; 9-12	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm1, zmm17, [rsi+r13], zmm1		; 9-12	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm2, zmm18, [rsi+2*r13], zmm2 	; 10-13	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm3, zmm19, [rsi+r14], zmm3		; 10-13	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm4, zmm20, [rsi+64], zmm4		; 11-14	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm5, zmm21, [rsi+r13+64], zmm5	; 11-14 ;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm6, zmm22, [rsi+2*r13+64], zmm6 	; 12-15	;; err = rnd(value*inv_weight) - value*inv_weight
	zfnmaddpd zmm7, zmm23, [rsi+r14+64], zmm7	; 12-15 ;; err = rnd(value*inv_weight) - value*inv_weight

;; Let hardware prefetcher do the work
;;	L1prefetchw rsi+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+64+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+r13+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+r13+64+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+2*r13+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+2*r13+64+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+r14+128, L1PREFETCH_ALL
;;	L1prefetchw rsi+r14+64+128, L1PREFETCH_ALL

	vbroadcastsd zmm25, ZMM_ABSVAL
	vpandq	zmm0, zmm0, zmm25			; 13	;; err = abs(err)
	vpandq	zmm1, zmm1, zmm25			; 13	;; err = abs(err)
	vpandq	zmm2, zmm2, zmm25			; 14	;; err = abs(err)
	vpandq	zmm3, zmm3, zmm25			; 14	;; err = abs(err)
	vpandq	zmm4, zmm4, zmm25			; 15	;; err = abs(err)
	vpandq	zmm5, zmm5, zmm25			; 15	;; err = abs(err)
	vpandq	zmm6, zmm6, zmm25			; 16	;; err = abs(err)
	vpandq	zmm7, zmm7, zmm25			; 16	;; err = abs(err)

;; BUG - Is there a better grouping available (use regs zmm16 up and interleave with the / base FMA instructions
;; Use more maxerr accumulators?  IACA says we're OK, are we in real life?

