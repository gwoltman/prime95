	zfmaddpd zmm3, zmm19, zmm3, zmm30		; 20-23	;; y+RNDVAL = x / base + RNDVAL (next carry+RNDVAL)
;;	L1prefetchw rsi+r14+64+128, L1PREFETCH_ALL
