	zfmaddpd zmm2, zmm18, zmm2, zmm30		; 19-22	;; y+RNDVAL = x / base + RNDVAL (next carry+RNDVAL)
;;	L1prefetchw rsi+r14+128, L1PREFETCH_ALL
