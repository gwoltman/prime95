	zfmsubpd zmm9, zmm9, zmm30, zmm15	;; B3 = I3 * cosine/sine - R3 (first I3/sine)	; 7-10		n 16

	zfmsubpd zmm15, zmm3, zmm30, zmm10	;; A7 = R7 * cosine/sine - I7 (first R7/sine)	; 8-11		n 15
	zfmaddpd zmm10, zmm10, zmm30, zmm3	;; B7 = I7 * cosine/sine + R7 (first I7/sine)	; 8-11		n 16

	vaddpd	zmm3, zmm14, zmm8		;; R4/sine + R6/sine				; 9-12		n 17
	vsubpd	zmm14, zmm14, zmm8		;; R4/sine - R6/sine				; 9-12		n 18

	vmovapd zmm25, [screg+8*64+3*128]	;; sine for R5/I5
	vaddpd	zmm8, zmm12, zmm13		;; I4/sine + I6/sine				; 10-13		n 22
	vsubpd	zmm12, zmm12, zmm13		;; I4/sine - I6/sine				; 10-13		n 20

	zfmaddpd zmm13, zmm5, zmm29, zmm11	;; R2 + R8 * sine				; 11-14		n 17
	zfnmaddpd zmm5, zmm5, zmm29, zmm11	;; R2 - R8 * sine				; 11-14		n 18

	zfmaddpd zmm11, zmm6, zmm29, zmm4	;; I2 + I8 * sine				; 12-15		n 22
	zfnmaddpd zmm6, zmm6, zmm29, zmm4	;; I2 - I8 * sine				; 12-15		n 20

	vmovapd zmm26, [screg+8*64+1*128]	;; sine for R3/I3 and R7/I7
	zfmaddpd zmm4, zmm2, zmm25, zmm7	;; R1 + R5 * sine				; 13-16		n 23
	zfnmaddpd zmm2, zmm2, zmm25, zmm7	;; R1 - R5 * sine				; 13-16		n 26

	vmovapd zmm27, [screg+8*64+2*128]	;; sine for R4/I4 and R6/I6
	zfmaddpd zmm7, zmm0, zmm25, zmm1	;; I1 + I5 * sine				; 14-17		n 24
	zfnmaddpd zmm0, zmm0, zmm25, zmm1	;; I1 - I5 * sine				; 14-17		n 27

	vaddpd	zmm1, zmm16, zmm15		;; R3/sine + R7/sine				; 15-18		n 23
	vsubpd	zmm16, zmm16, zmm15		;; R3/sine - R7/sine				; 15-18		n 27

	vaddpd	zmm15, zmm9, zmm10		;; I3/sine + I7/sine				; 16-19		n 24
	vsubpd	zmm9, zmm9, zmm10		;; I3/sine - I7/sine				; 16-19		n 26

	zfmaddpd zmm10, zmm3, zmm27, zmm13	;; r2++ = (r2+r8) + (r4+r6) * sine		; 17-20		n 30
	zfnmaddpd zmm3, zmm3, zmm27, zmm13	;; r2+- = (r2+r8) - (r4+r6) * sine		; 17-20		n 28

	zfmaddpd zmm13, zmm14, zmm27, zmm5	;; r2-+ = (r2-r8) + (r4-r6) * sine		; 18-21		n 29
	zfnmaddpd zmm14, zmm14, zmm27, zmm5	;; r2-- = (r2-r8) - (r4-r6) * sine		; 19-22		n 33

	zfmaddpd zmm5, zmm12, zmm27, zmm6	;; i2-+ = (i2-i8) + (i4-i6) * sine		; 20-23		n 28
	zfnmaddpd zmm12, zmm12, zmm27, zmm6	;; i2-- = (i2-i8) - (i4-i6) * sine		; 21-24		n 32

	zfmaddpd zmm6, zmm8, zmm27, zmm11	;; i2++ = (i2+i8) + (i4+i6) * sine		; 22-25		n 31
	zfnmaddpd zmm8, zmm8, zmm27, zmm11	;; i2+- = (i2+i8) - (i4+i6) * sine		; 22-25		n 29

	zfmaddpd zmm11, zmm1, zmm26, zmm4	;; r1++ = (r1+r5) + (r3+r7) * sine		; 23-26		n 30
	zfnmaddpd zmm1, zmm1, zmm26, zmm4	;; r1+- = (r1+r5) - (r3+r7) * sine		; 23-26		n 32
	vmovapd zmm20, [screg+0*64]		;; premultiplier cosine/sine for R1/I1

	zfmaddpd zmm4, zmm15, zmm26, zmm7	;; i1++ = (i1+i5) + (i3+i7) * sine		; 24-27		n 31
	zfnmaddpd zmm15, zmm15, zmm26, zmm7	;; i1+- = (i1+i5) - (i3+i7) * sine		; 25-28		n 33
	vmovapd zmm19, [screg+2*64]		;; premultiplier cosine/sine for R3/I3
	vmovapd zmm18, [screg+4*64]		;; premultiplier cosine/sine for R5/I5

	zfmaddpd zmm7, zmm9, zmm26, zmm2	;; r1-+ = (r1-r5) + (i3-i7) * sine		; 26-29		n 34
	zfnmaddpd zmm9, zmm9, zmm26, zmm2	;; r1-- = (r1-r5) - (i3-i7) * sine		; 27-30		n 36
	vmovapd zmm25, [screg+6*64]		;; premultiplier cosine/sine for R7/I7

	zfmaddpd zmm2, zmm16, zmm26, zmm0	;; i1-+ = (i1-i5) + (r3-r7) * sine		; 27-30		n 37
	zfnmaddpd zmm16, zmm16, zmm26, zmm0	;; i1-- = (i1-i5) - (r3-r7) * sine		; 28-31		n 35
	vmovapd zmm24, [screg+1*64]		;; premultiplier cosine/sine for R2/I2

	vaddpd	zmm0, zmm3, zmm5		;; r2+-+ = (r2+-) + (i2-+)			; 28-31		n 34
	vsubpd	zmm3, zmm3, zmm5		;; r2+-- = (r2+-) - (i2-+)			; 29-32		n 36
	vmovapd zmm23, [screg+3*64]		;; premultiplier cosine/sine for R4/I4
	vmovapd zmm22, [screg+5*64]		;; premultiplier cosine/sine for R6/I6

	vaddpd	zmm5, zmm13, zmm8		;; r2-++ = (r2-+) + (i2+-)			; 29-32		n 37
	vsubpd	zmm13, zmm13, zmm8		;; r2-+- = (r2-+) - (i2+-)			; 30-33		n 35

	vmovapd zmm21, [screg+7*64]		;; premultiplier cosine/sine for R8/I8

	vaddpd	zmm8, zmm11, zmm10		;; R1 = (r1++) + (r2++)				; 30-33		n 38
	vsubpd	zmm11, zmm11, zmm10		;; R5 = (r1++) - (r2++)				; 31-34		n 40

	vaddpd	zmm10, zmm4, zmm6		;; I1 = (i1++) + (i2++)				; 31-34		n 38
	vsubpd	zmm4, zmm4, zmm6		;; I5 = (i1++) - (i2++)				; 32-35		n 40

	bump	screg, scinc

	vaddpd	zmm6, zmm1, zmm12		;; R3 = (r1+-) + (i2--)				; 32-35		n 39
	vsubpd	zmm1, zmm1, zmm12		;; R7 = (r1+-) - (i2--)				; 33-36		n 41

	vsubpd	zmm12, zmm15, zmm14		;; I3 = (i1+-) - (r2--)				; 33-36		n 39
	vaddpd	zmm15, zmm15, zmm14		;; I7 = (i1+-) + (r2--)				; 34-37		n 41

	zfmaddpd zmm14, zmm0, zmm31, zmm7	;; R2 = (r1-+) + .707*(r2+-+)			; 34-37		n 42
	zfnmaddpd zmm0, zmm0, zmm31, zmm7	;; R6 = (r1-+) - .707*(r2+-+)			; 35-38		n 44

	zfnmaddpd zmm7, zmm13, zmm31, zmm16	;; I2 = (i1--) - .707*(r2-+-)			; 35-38		n 42
	zfmaddpd zmm13, zmm13, zmm31, zmm16	;; I6 = (i1--) + .707*(r2-+-)			; 36-39		n 44

	zfnmaddpd zmm16, zmm3, zmm31, zmm9	;; R4 = (r1--) - .707*(r2+--)			; 36-39		n 43
	zfmaddpd zmm3, zmm3, zmm31, zmm9	;; R8 = (r1--) + .707*(r2+--)			; 37-40		n 45

	zfnmaddpd zmm9, zmm5, zmm31, zmm2	;; I4 = (i1-+) - .707*(r2-++)			; 37-40		n 43
	zfmaddpd zmm5, zmm5, zmm31, zmm2	;; I8 = (i1-+) + .707*(r2-++)			; 38-41		n 45

	zfmaddpd zmm2, zmm8, zmm20, zmm10	;; A1 = R1 * cosine + I1			; 38-41		n 46
	zfmsubpd zmm10, zmm10, zmm20, zmm8	;; B1 = I1 * cosine - R1			; 39-42		n 48

	zfmaddpd zmm8, zmm6, zmm19, zmm12	;; A3 = R3 * cosine + I3			; 39-42		n 47
	zfmsubpd zmm12, zmm12, zmm19, zmm6	;; B3 = I3 * cosine - R3			; 40-43		n 50

	zfmaddpd zmm6, zmm11, zmm18, zmm4	;; A5 = R5 * cosine + I5			; 40-43		n 49
	zfmsubpd zmm4, zmm4, zmm18, zmm11	;; B5 = I5 * cosine - R5			; 41-44		n 51

	zfmaddpd zmm11, zmm1, zmm25, zmm15	;; A7 = R7 * cosine + I7			; 41-44		n 51
	zfmsubpd zmm15, zmm15, zmm25, zmm1	;; B7 = I7 * cosine - R7			; 42-45		n 53

	zfmaddpd zmm1, zmm14, zmm24, zmm7	;; A2 = R2 * cosine + I2			; 42-45		n 52
	zfmsubpd zmm7, zmm7, zmm24, zmm14	;; B2 = I2 * cosine - R2			; 43-46		n 54

	zfmaddpd zmm14, zmm16, zmm23, zmm9	;; A4 = R4 * cosine + I4			; 43-46		n 54
	zfmsubpd zmm9, zmm9, zmm23, zmm16	;; B4 = I4 * cosine - R4			; 44-47		n 57

	zfmaddpd zmm16, zmm0, zmm22, zmm13	;; A6 = R6 * cosine + I6			; 44-47		n 55
	zfmsubpd zmm13, zmm13, zmm22, zmm0	;; B6 = I6 * cosine - R6			; 45-48		n 58

	zfmaddpd zmm0, zmm3, zmm21, zmm5	;; A8 = R8 * cosine + I8			; 45-48		n 56
	zfmsubpd zmm5, zmm5, zmm21, zmm3	;; B8 = I8 * cosine - R8			; 46-49		n 58

;	L1prefetchw srcreg+L1pd, L1pt
;	L1prefetchw srcreg+64+L1pd, L1pt
;	L1prefetchw srcreg+d1+L1pd, L1pt
;	L1prefetchw srcreg+d1+64+L1pd, L1pt
;;	L1prefetchw srcreg+d2+L1pd, L1pt
;	L1prefetchw srcreg+d2+64+L1pd, L1pt
;	L1prefetchw srcreg+d2+d1+L1pd, L1pt
;	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt
;	L1prefetchw srcreg+d4+L1pd, L1pt
;	L1prefetchw srcreg+d4+64+L1pd, L1pt
;	L1prefetchw srcreg+d4+d1+L1pd, L1pt
;	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt
;	L1prefetchw srcreg+d4+d2+L1pd, L1pt
;	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt
;	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
;	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt

	zstore	[srcreg], zmm2			;; Save R1					; 50
	zstore	[srcreg+d2], zmm8		;; Save R3					; 51
	zstore	[srcreg+64], zmm10		;; Save I1					; 52
	zstore	[srcreg+d4], zmm6		;; Save R5					; 53
	zstore	[srcreg+d2+64], zmm12		;; Save I3					; 54
	zstore	[srcreg+d4+d2], zmm11		;; Save R7					; 55
	zstore	[srcreg+d4+64], zmm4		;; Save I5					; 55+1
	zstore	[srcreg+d1], zmm1		;; Save R2					; 56+1
	zstore	[srcreg+d4+d2+64], zmm15	;; Save I7					; 57+1
	zstore	[srcreg+d1+64], zmm7		;; Save I2					; 58+1
	zstore	[srcreg+d2+d1], zmm14		;; Save R4					; 58+2
	zstore	[srcreg+d4+d1], zmm16		;; Save R6					; 59+2
	zstore	[srcreg+d4+d2+d1], zmm0		;; Save R8					; 60+2
	zstore	[srcreg+d2+d1+64], zmm9		;; Save I4					; 61+2
	zstore	[srcreg+d4+d1+64], zmm13	;; Save I6					; 62+2
	zstore	[srcreg+d4+d2+d1+64], zmm5	;; Save I8					; 62+3
	bump	srcreg, srcinc
	ENDM


zr8_eight_complex_fft_final_preload MACRO
	vbroadcastsd zmm31, ZMM_SQRTHALF
