# Assembler command lines, without and with listings

masm=ml /c /coff
#masm=ml /c /coff /Fl /Sf /Sa
masm64=ml64 /c /DX86_64
#masm64=ml64 /c /Fl /Sf /Sa /DX86_64

# The MSVC compiler I own does not have an optimizer, so compile critical
# routines with an older MSVC compiler that can optimize code

cl4=\msdev\bin\cl /I. /I C:\msdev\include\ /O2 /GF /W3 /MT /c
cl4d=\msdev\bin\cl /I. /I C:\msdev\include\ /DGDEBUG /GF /W3 /MT /Zi /c

# Use the latest C compiler even though it does not optimize code

cl=cl /I. /GF /W3 /MT /c
cld=cl /I. /GF /W3 /MT /DGDEBUG /Zi /c

# Compile C code

release\cpuid.obj: cpuid.c cpuid.h
    $(cl) /Forelease\cpuid.obj cpuid.c

debug\cpuid.obj: cpuid.c cpuid.h
    $(cld) /Fodebug\cpuid.obj cpuid.c

release\gwnum.obj: gwnum.c gwnum.h
    $(cl) /Forelease\gwnum.obj gwnum.c

debug\gwnum.obj: gwnum.c gwnum.h
    $(cld) /Fodebug\gwnum.obj gwnum.c

release\gwutil.obj: gwutil.c gwutil.h
    $(cl) /Forelease\gwutil.obj gwutil.c

debug\gwutil.obj: gwutil.c gwutil.h
    $(cld) /Fodebug\gwutil.obj gwutil.c

release\gwdbldbl.obj: gwdbldbl.cpp gwdbldbl.h
    $(cl) /I..\qd /Forelease\gwdbldbl.obj gwdbldbl.cpp

debug\gwdbldbl.obj: gwdbldbl.cpp gwdbldbl.h
    $(cld) /I..\qd /Fodebug\gwdbldbl.obj gwdbldbl.cpp

# Create optimized giants.obj

release\giants.obj: giants.c giants.h
    $(cl4) /Forelease\giants.obj giants.c

debug\giants.obj: giants.c giants.h
    $(cld) /Fodebug\giants.obj giants.c

# Create 32-bit object files

mult.obj: mult.asm mult.mac xmult.mac timeit.inc
    $(masm) mult.asm

mult1.obj: mult1.asm mult.mac fft1.mac
    $(masm) /DPPRO mult1.asm

mult1aux.obj: mult1aux.asm mult.mac normal.mac
    $(masm) mult1aux.asm

mult2.obj: mult2.asm mult.mac fft2.mac
    $(masm) /DPPRO mult2.asm

mult2p.obj: mult2.asm mult.mac fft2.mac
    $(masm) /DPPRO /DPFETCH /Fomult2p.obj mult2.asm

mult2a.obj: mult2a.asm mult.mac pass2.mac
    $(masm) /DPPRO mult2a.asm

mult2ap.obj: mult2a.asm mult.mac pass2.mac
    $(masm) /DPPRO /DPFETCH /Fomult2ap.obj mult2a.asm

mult2aux.obj: mult2aux.asm mult.mac normal.mac
    $(masm) mult2aux.asm

mult3.obj: mult3.asm mult.mac fft3.mac
    $(masm) /DPPRO mult3.asm

mult3p.obj: mult3.asm mult.mac fft3.mac
    $(masm) /DPPRO /DPFETCH /Fomult3p.obj mult3.asm

mult3a.obj: mult3a.asm mult.mac pass2.mac
    $(masm) /DPPRO mult3a.asm

mult3ap.obj: mult3a.asm mult.mac pass2.mac
    $(masm) /DPPRO /DPFETCH /Fomult3ap.obj mult3a.asm

mult4.obj: mult4.asm mult.mac fft4.mac
    $(masm) /DPPRO mult4.asm

mult4p.obj: mult4.asm mult.mac fft4.mac
    $(masm) /DPPRO /DPFETCH /Fomult4p.obj mult4.asm

gianthlp.obj: gianthlp.asm
    $(masm) gianthlp.asm

cpuidhlp.obj: cpuidhlp.asm
    $(masm) cpuidhlp.asm

xmult1.obj: xmult1.asm xmult.mac xlucas.mac xfft1.mac
    $(masm) xmult1.asm

xmult1ax.obj: xmult1ax.asm xmult.mac xnormal.mac
    $(masm) xmult1ax.asm

xmult2.obj: xmult2.asm xmult.mac xlucas.mac xfft2.mac xnormal.mac
    $(masm) xmult2.asm

xmult2a.obj: xmult2a.asm xmult.mac xpass2.mac xlucas.mac
    $(masm) xmult2a.asm

xmult2ax.obj: xmult2ax.asm xmult.mac xnormal.mac
    $(masm) xmult2ax.asm

xmult3.obj: xmult3.asm xmult.mac xlucas.mac xfft3.mac xnormal.mac
    $(masm) xmult3.asm

xmult3a.obj: xmult3a.asm xmult.mac xpass2.mac xlucas.mac
    $(masm) xmult3a.asm

xmult3ax.obj: xmult3ax.asm xmult.mac xnormal.mac
    $(masm) xmult3ax.asm

gwnum.lib: 
    del gwnum.lib
    lib /OUT:gwnum.lib release\*.obj *.obj

gwnumd.lib: 
    del gwnumd.lib
    lib /OUT:gwnumd.lib debug\*.obj *.obj

# Create 64-bit object files

amd64\xmult1.obj: xmult1.asm xmult.mac xlucas.mac xfft1.mac
    $(masm64) /Foamd64\xmult1.obj xmult1.asm

amd64\xmult1ax.obj: xmult1ax.asm xmult.mac xnormal.mac
    $(masm64) /Foamd64\xmult1ax.obj xmult1ax.asm

