;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...

;; Do 1024 eight_reals_unfft operations
;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 32 data values

	bump	rdi, -256*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-256*YMM_SCD2]
	loops_init_prefetch 768, 64, 2, rcx ;; 3 iterations of 256
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 4*dist64, 8*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2a			;; Test loop counter
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 256
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*dist64, 8*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*16*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12288	+1	+1	+1
;;	4	...
;;	...
;;	12284

;; Do 4096 six_reals_unfft operations
;;	distance between fft data elements is 4096
;;	do 1024 macros each processing 24 data values

	bump	rdi, -256*YMM_SCD2-1024*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (1568-768-384-512)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1024, 64, 2, rcx ;; 1024 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 16*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	16, c1b			;; Test loop counter

ypass2_12288_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-12288-complex macro ******************
; This macro takes 12288 complex values and performs the final 13.585 levels of a standard
; radix-4 FFT, squares the results, and does the first 13.585 levels of the inverse FFT.

yr4dwpn_pass2_12288_complex MACRO
	LOCAL	b1a, b1b, b2b, b3b, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2b, c3a, c3b, c4b, c4c, c4d, c5b, c5c, c5d, c6b, c6c, c6d
	LOCAL	ypass2_12288_complex_1, ypass2_12288_complex_2
	LOCAL	ypass2_12288_complex_3, ypass2_12288_complex_4
	LOCAL	ypass2_12288_complex_unfft, ypass2_12288_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3072 cache lines + 47 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12288_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12288	+1	+1	+1
;;	4	...
;;	...
;;	12284
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...

;; Do 4096 three_complex_fft operations
;;	distance between fft data elements is 4096
;;	do 1024 macros each processing 24 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 32 data values

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 768 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+1024*YMM_SCD1]
	mov	rdx, rbp
	loops_init_prefetch 3072, 64, 12, rcx ;; 1024 iterations or 768 iterations

	loops_set_prefetch 64, 12, rcx	;; prefetch 256 cache lines in this loop
b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, dist64, 16*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next sin/cos data
	loops	16, b1b, 3		;; Test loop counter
	bump	rsi, -16*dist64		;; Restore source pointer
	bump	rdi, -16*64*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 16*3			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 192 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, dist64, 4*dist64, 8*dist64, rbp
	bump	rbp, 64*YMM_SCD2	;; Next sin/cos data
	loops	4, b2b, 4		;; Test loop counter
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	bump	rbp, -4*64*YMM_SCD2	;; Restore sin/cos data
	loops	3, b2b			;; Test loop counter
	bump	rsi, -3*16*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sin/cos data
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b3b:	yr4_eb4cl_four_complex_djbfft rsi, 4*dist64, dist64, 2*dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, b3b			;; Loop 3 times
;;	bump	rsi, -3*4*4*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer

	bump	rsi, -3*4*4*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD1+1024*YMM_SCD1+256*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 768 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 768 macros each processing 32 data values

;; Do FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 768 macros each processing 32 data values

;; Do FFT levels 13,14 as well as inverse FFT levels 13,14
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 768 macros each processing 32 data values

;; Do inverse FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 768 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 768 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 768 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_12288_complex_1
	jg	ypass2_12288_complex_3

ypass2_12288_complex_2:
	start_timer 6
	loops_init_prefetch 768, 64, 2, rcx ;; 12 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b4b			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b6b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b6b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
b7b:	yr4_4cl_four_complex_with_square rsi, 64, 4*dist64, 8*dist64
	loops	64, b7b			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c6b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c6b			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c6b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c4b			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c4b			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64 ;; Next source pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	loops	3, b4b			;; Loop 3 times
	bump	rsi, -3*16*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_12288_complex_unfft


ypass2_12288_complex_1:
	start_timer 6
	bump	rcx, (3072+47-256-2*192-3*768-192)*64 ;; Move prefetch pointer along
	loops_init_prefetch 768, 64, 1, rcx ;; 12 iters of 256 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b4a			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b6a:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b6a			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b6a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
	yr4_4cl_four_complex_fft_final_preload
b7a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*dist64, 8*dist64
	loops	64, b7a			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer

	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	loops	3, b4a			;; Loop 3 times
	end_timer 6
	jmp	ypass2_12288_complex_done


ypass2_12288_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 768, 64, 2, rcx ;; 12 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b4c			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b6c:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b6c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
	yr4_4cl_four_complex_with_mult_preload
b7c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*dist64, 8*dist64
	loops	64, b7c			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 192 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c6c:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c6c			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c6c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c4c			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c4c			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64 ;; Next source pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	loops	3, b4c			;; Loop 3 times
	bump	rsi, -3*16*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_12288_complex_unfft


ypass2_12288_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 1024*YMM_SCD1+256*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 768, 64, 1, rcx ;; 12 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 384 cache lines in this loop
	yr4_4cl_four_complex_with_mulf_preload
b7d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*dist64, 8*dist64
	loops	64, b7d			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c6d:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c6d			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c6d			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 768 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c4d			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c4d			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64 ;; Next source pointer
	loops	4, b7d			;; Loop 4 times
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	loops	3, b7d			;; Loop 3 times
	bump	rsi, -3*16*dist64	;; Restore source pointer
	bump	rcx, (-384-3*768+256+2*192+384+4*192+2*384)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 768 macros each processing 32 data values

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...

;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12288	+1	+1	+1
;;	4	...
;;	...
;;	12284

;; Do 4096 three_complex_unfft operations
;;	distance between fft data elements is 4096
;;	do 1024 macros each processing 24 data values

ypass2_12288_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+1024*YMM_SCD1]
	mov	rdx, rbp
	bump	rcx, (3072+47-256-2*192-384-4*192-2*384-2*192-256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 3072, 64, 16, rcx ;; 1024 iterations or 768 iterations

	loops_set_prefetch 64, 16, rcx	;; prefetch 192 cache lines in this loop
c3a:	yr4_eb4cl_four_complex_djbunfft_preload
c3b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*dist64, dist64, 2*dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c3b			;; Loop 3 times
	bump	rsi, -3*4*4*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, dist64, 4*dist64, 8*dist64, rbp
	bump	rbp, 64*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, c2b, 4		;; Test loop counter
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	bump	rbp, -4*64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*16*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 12, rcx	;; prefetch 256 cache lines in this loop
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, dist64, 16*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next set of sin/cos data
	loops	16, c1b, 3		;; Test loop counter
;;	bump	rsi, -16*dist64		;; Restore source pointer
	bump	rdi, -16*64*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -16*dist64+64	;; Next source pointer
	loops	64, c3a			;; Loop 64 times
	end_timer 13

ypass2_12288_complex_done:
	ENDM


; *************** radix4-pass2-15360-real macro ******************
; This macro takes 30720 real values and performs the final 14.907 levels of the FFT.
; The results are squared, and the first 14.907 levels of the inverse FFT are done.

yr4dwpn_pass2_15360_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b, c6a, c6b
	LOCAL	ypass2_15360_real_1, ypass2_15360_real_2
	LOCAL	ypass2_15360_real_3, ypass2_15360_real_4
	LOCAL	ypass2_15360_real_unfft, ypass2_15360_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3840 cache lines + 59 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_15360_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	15360	+1	+1	+1
;;	4	...
;;	...
;;	15356
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...

;; Do 5120 six_reals_fft operations
;;	distance between fft data elements is 5120
;;	do 1280 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 1280, 64, 2, rcx ;; 1280 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 20*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	20, b1b			;; Test loop counter
	bump	rsi, -20*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 ten_reals_fft operations
;; Do 2048 five_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 40 data values

	loops_init_prefetch 768, 64, 2, rcx ;; 3 iters of 256
	yr5_5cl_ten_reals_fft_preload
b2a:	yr5_5cl_ten_reals_fft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b2a			;; Test loop counter
	bump	rsi, -4*dist64+20*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 256
	yr5_r5cl_five_complex_djbfft_preload
b2b:	yr5_r5cl_five_complex_djbfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*dist64+20*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD4	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*20*dist64	;; Restore source pointer
	bump	rdi, 256*YMM_SCD4	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 256 eight_reals_fft operations
;; Do 3584 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 960 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+64*YMM_SCD2]
	loops_init_prefetch 960, 64, 2, rcx ;; 15 iterations of 64
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b3a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 64
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b3b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr
	loops	15, b3b			;; Loop 15 times
	bump	rsi, -15*4*dist64	;; Restore source pointer
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 3776 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 960 macros each processing 32 data values

	loops_init_prefetch 960, 64, 2, rcx ;; 15 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b4a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 14 more iters of 64
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b4b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer
	loops	15, b4b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 3824 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 960 macros each processing 32 data values

	loops_init_prefetch 960, 64, 2, rcx ;; 60 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 59 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	15, b5b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 3836 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 960 macros each processing 32 data values

	loops_init_prefetch 960, 64, 4, rcx ;; 240 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b6a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b6a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 239 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b6b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b6b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	15, b6b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do FFT levels 13,14 as well as inverse FFT levels 13,14
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 3839 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 960 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_15360_real_1
	jg	ypass2_15360_real_3

ypass2_15360_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops_init_prefetch 960, 64, 4, rcx, 1, 64 ;; 959 more iterations
b7b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b7b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	15, b7b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer
	jmp	ypass2_15360_real_unfft

ypass2_15360_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, dist64, 2*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1920 cache lines
	loops_init_prefetch 960, 128, 1, rcx, 1, 64 ;; 959 more iterations
b7a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b7a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	15, b7a			;; Test loop counter
	jmp	ypass2_15360_real_done

ypass2_15360_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops_init_prefetch 960, 64, 4, rcx, 1, 64 ;; 959 more iterations
b7c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b7c			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	15, b7c			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer
	jmp	ypass2_15360_real_unfft

ypass2_15360_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops_init_prefetch 960, 128, 1, rcx, 1, 64 ;; 959 more iterations
b7d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b7d			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	15, b7d			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer
;;	bump	rcx, (-1918+640+384+3*480+2*240)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 3836 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 960 macros each processing 32 data values

ypass2_15360_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 64*YMM_SCD2+64*YMM_SCD2+256*YMM_SCD4+1280*YMM_SCD2
	loops_init_prefetch 960, 64, 4, rcx ;; 240 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c6a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c6a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 239 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c6b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c6b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c6b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	15, c6b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 3824 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 960 macros each processing 32 data values

	loops_init_prefetch 960, 64, 4, rcx ;; 60 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 59 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	15, c5b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 3776 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 960 macros each processing 32 data values

	bump	rcx, (3840+59-640-384-3*480-4*240-480)*64 ;; Move prefetch pointer along
	loops_init_prefetch 960, 64, 2, rcx ;; 15 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c4a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 64
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c4b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	15, c4b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 256 eight_reals_unfft operations
;; Do 3584 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 960 macros each processing 32 data values

	bump	rdi, -64*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-64*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1920 cache lines
	loops_init_prefetch 960, 64, 1, rcx ;; 15 iters of 64
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c3a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 64
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c3b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	15, c3b			;; Test loop counter
	bump	rsi, -15*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...

;; Do 1024 ten_reals_unfft operations
;; Do 2048 five_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 40 data values

	bump	rdi, -64*YMM_SCD2-256*YMM_SCD4 ;; Load sin/cos ptrs
	loops_init_prefetch 768, 64, 2, rcx ;; 3 iters of 256
	yr5_5cl_ten_reals_unfft_preload
c2a:	yr5_5cl_ten_reals_unfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2a			;; Test loop counter
	bump	rsi, -4*dist64+20*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 256
	yr5_r5cl_five_complex_djbunfft_preload
c2b:	yr5_r5cl_five_complex_djbunfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*dist64+20*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD4	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*20*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	15360	+1	+1	+1
;;	4	...
;;	...
;;	15356

;; Do 3072 six_reals_unfft operations
;;	distance between fft data elements is 3072
;;	do 1280 macros each processing 24 data values

	bump	rdi, -1280*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (3840+59-960-384-640)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1280, 64, 2, rcx ;; 1280 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 20*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	20, c1b			;; Test loop counter

ypass2_15360_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-15360-complex macro ******************
; This macro takes 15360 complex values and performs the final 13.907 levels of a standard
; radix-4 FFT, squares the results, and does the first 13.907 levels of the inverse FFT.

yr4dwpn_pass2_15360_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d, c6b, c6c, c6d
	LOCAL	ypass2_15360_complex_1, ypass2_15360_complex_2
	LOCAL	ypass2_15360_complex_3, ypass2_15360_complex_4
	LOCAL	ypass2_15360_complex_unfft, ypass2_15360_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3840 cache lines + 59 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_15360_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	15360	+1	+1	+1
;;	4	...
;;	...
;;	15356
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...

;; Do 5120 three_complex_fft operations
;;	distance between fft data elements is 5120
;;	do 1280 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 3072 five_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+1280*YMM_SCD1]
	loops_init_prefetch 3840, 64, 15, rcx ;; 1280 iterations or 768 iterations

b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 4*dist64, 20*dist64, rdi
	bump	rdi, 256*YMM_SCD1	;; Next sin/cos data
	loops	5, b1b, 3		;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer
	bump	rdi, -5*256*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 5*3			;; Back up loop counter

	yr5_5cl_five_complex_djbfft_preload
b2b:	yr5_5cl_five_complex_djbfft rsi, 20*dist64, 4*dist64, rbp
	loops	3, b2b, 5		;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -3*20*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b1a			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -256*YMM_SCD1+1280*YMM_SCD1+256*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 960 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 960 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 960 macros each processing 32 data values

;; Do FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 960 macros each processing 32 data values

;; Do FFT levels 13,14 as well as inverse FFT levels 13,14
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 960 macros each processing 32 data values

;; Do inverse FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 960 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 960 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 3840 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 960 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 3840 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 960 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_15360_complex_1
	jg	ypass2_15360_complex_3

ypass2_15360_complex_2:
	start_timer 6
	loops_init_prefetch 960, 64, 2, rcx ;; 15 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 480 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
;; Loop below reworked to avoid 4KB distances
;;b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
;;	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
;;	loops	64, b3b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
b3b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, dist64, 2*dist64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b4b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b6b:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b6b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, b6b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 240 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b7b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
;;	loops	64, b7b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b7b:	yr4_4cl_four_complex_with_square rsi, 4*64, dist64, 2*dist64
	loops	16, b7b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
