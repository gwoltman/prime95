; Author:  George Woltman
; Email: woltman@alum.mit.edu
;
; These macros do the second pass of a radix-4 2 pass FFT using AVX instructions.
;

;;
;; Estimated memory requirements for all-complex pass 2 macros:
;;
;; Pass 2 size:		48	64	192	256	320	768	1024	1280	1536	2048	2560	2304	3072	3840	4096	5120	6400	4608	6144	7680	8192	10240	12800	9216	12288	15360	16384	20480	25600
;;
;; FFT data:		<1K	1K	3K	4K	5K	12K	16K	20K	24K	32K	40K	36K	48K	60K	64K	80K	100K	72K	96K	120K	128K	160K	200K	144K	192K	240K	256K	320K	400K
;; Fixed sin/cos data:	<1K	<1K	2K	2K	3K	6K	9K	10K	13K	17K	21K	18K	26K	30K	34K	42K	50K	36K	49K	60K	65K	81K	100K	72K	98K	120K	130K	162K	200K
;;
;; Min L2 cache size:	2K	3K	8K	10K	13K	30K	41K	50K	61K	81K	101K	90K	122K	150K	162K	202K	250K	180K	241K	300K	321K	401K	500K	360K	482K	600K	644K	802K	1000K
;;
;; NOTE:  The total size is a minimum estimated efficient L2 cache size.
;; We double the data size as both the current data and next block data must
;; be in the cache at the same time.  The full formula is:
;;	(FFT data size) * 2 + fixed sin/cos data
;; ALSO NOTE:  The real sin/cos data is used only in the first FFT block, so the memory
;; requirements for real data aren't particularly interesting.
;;


;*********************************************************************************************
;			Macros derived from pass2-6-levels
;*********************************************************************************************


; *************** radix4-pass2-48-real macro ******************
; This macro takes 96 real values and performs the final 6.585 levels of the FFT.
; The results are squared, and the first 6.585 levels of the inverse FFT are done.

yr4dwpn_pass2_48_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_48_real_1, ypass2_48_real_2
	LOCAL	ypass2_48_real_3, ypass2_48_real_4
	LOCAL	ypass2_48_real_unfft, ypass2_48_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 12 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_48_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	48	+1	+1	+1
;;	4	...
;;	...
;;	44
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 16 six_reals_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 24 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 4, 64, 1, rcx
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 8 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 3 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+YMM_SCD2]

	yr4_s4cl_2sc_eight_reals_fft_preload
	yr4_s4cl_2sc_eight_reals_fft rsi, 4*64, 64, 2*64, rdi, rdx

	loops_init_prefetch 2, 64, 1, rcx ;; 2 more iters
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	2, b2b			;; Loop 2 times
	bump	rsi, -3*4*64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 11 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 3 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_48_real_1
	jg	ypass2_48_real_3

ypass2_48_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 4*64, 64, 2*64
	loops_init_prefetch 2, 128, 1, rcx ;; 2 more iterations
b3b:	yr4_4cl_four_complex_with_square rsi, 4*64, 64, 2*64
	loops	2, b3b			;; Test loop counter
	bump	rsi, -3*4*64		;; Restore source pointer
	jmp	ypass2_48_real_unfft

ypass2_48_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 4*64, 64, 2*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 6 cache lines
	loops_init_prefetch 2, 128, 1, rcx ;; 2 more iterations
b3a:	yr4_4cl_four_complex_fft_final rsi, 4*64, 64, 2*64
	loops	2, b3a			;; Test loop counter
	jmp	ypass2_48_real_done

ypass2_48_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops_init_prefetch 2, 128, 1, rcx ;; 2 more iterations
b3c:	yr4_4cl_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops	2, b3c			;; Test loop counter
	bump	rsi, -3*4*64		;; Restore source pointer
	jmp	ypass2_48_real_unfft

ypass2_48_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops_init_prefetch 2, 128, 1, rcx ;; 2 more iterations
b3d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops	2, b3d			;; Test loop counter
	bump	rsi, -3*4*64		;; Restore source pointer
;;	bump	rcx, (-4+4+2+4)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 1 eight_reals_unfft operations
;; Do 11 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 4 macros processing 32 data values

ypass2_48_real_unfft:
	mov	rdx, sincos3		;; Load sin/cos pointer
	bump	rdx, 4*YMM_SCD2
	lea	rdi, [rdx+YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 6 cache lines

	yr4_s4cl_2sc_eight_reals_unfft_preload
	yr4_s4cl_2sc_eight_reals_unfft rsi, 4*64, 64, 2*64, rdi, rdx

	loops_init_prefetch 2, 64, 1, rcx ;; 2 more iters
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	2, c2b			;; Test loop counter
	bump	rsi, -3*4*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	48	+1	+1	+1
;;	4	...
;;	...
;;	44

;; Do 16 six_reals_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros processing 24 data values

	bump	rdi, -YMM_SCD2-4*YMM_SCD2 ;; Load sin/cos ptr
;;	bump	rcx, (6-2-4)*64		;; Move prefetch pointer along
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	4, c1b			;; Test loop counter

ypass2_48_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-48-complex macro ******************
; This macro takes 48 complex values and performs the final 5.585 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 5.585 levels of the inverse FFT.

yr4dwpn_pass2_48_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_48_complex_1, ypass2_48_complex_2
	LOCAL	ypass2_48_complex_3, ypass2_48_complex_4
	LOCAL	ypass2_48_complex_unfft, ypass2_48_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 12 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_48_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	48	+1	+1	+1
;;	4	...
;;	...
;;	44
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 16 three_complex_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 4			;; 4 iterations
	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD1		;; Next sin/cos data
	loops	4, b1b			;; Test inner loop counter
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 12 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 3 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 3, 64, 1, rcx ;; 3 iters
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*4*64		;; Restore source pointer
	end_timer 6

;; Do FFT levels 5,6 as well as inverse FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 12 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 3 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_48_complex_1
	jg	ypass2_48_complex_3

ypass2_48_complex_2:
	start_timer 9
	loops_init_prefetch 3, 64, 1, rcx
b3b:	yr4_4cl_four_complex_with_square rsi, 4*64, 64, 2*64
	loops	3, b3b			;; Loop 3 times
	bump	rsi, -3*4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_48_complex_unfft

ypass2_48_complex_1:
	start_timer 9
	loops_init_prefetch 3, 128, 1, rcx
b3a:	yr4_4cl_four_complex_fft_final rsi, 4*64, 64, 2*64
	loops	3, b3a			;; Loop 3 times
	end_timer 9
	jmp	ypass2_48_complex_done

ypass2_48_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 3, 64, 1, rcx
b3c:	yr4_4cl_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops	3, b3c			;; Loop 3 times
	bump	rsi, -3*4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_48_complex_unfft

ypass2_48_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 3, 128, 1, rcx
b3d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops	3, b3d			;; Loop 3 times
	bump	rsi, -3*4*64		;; Restore source pointer
	end_timer 9

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 12 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 3 macros each processing 32 data values

ypass2_48_complex_unfft:
	start_timer 11
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 4*YMM_SCD1
	loops_init_prefetch 3, 64, 1, rcx ;; 3 iters
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	3, c2b			;; Loop 3 times
	bump	rsi, -3*4*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	48	+1	+1	+1
;;	4	...
;;	...
;;	44

;; Do 16 three_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 24 data values

	start_timer 14
	bump	rdi, -4*YMM_SCD1	;; Load sin/cos ptr
	bump	rcx, (12+0-3*3-4)*64	;; Move prefetch pointer along
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iters
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD1		;; Next set of sin/cos data
	loops	4, c1b			;; Test loop counter
	end_timer 14

ypass2_48_complex_done:
	ENDM


; *************** radix4-pass2-6-levels-real macro ******************
; This macro takes 128 real values and performs the final 7 levels of the FFT.
; The results are squared, and the first 7 levels of the inverse FFT are done.

yr4dwpn_pass2_6_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_6_levels_real_1, ypass2_6_levels_real_2
	LOCAL	ypass2_6_levels_real_3, ypass2_6_levels_real_4
	LOCAL	ypass2_6_levels_real_unfft, ypass2_6_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 16 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...

;; Do 16 eight_reals_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 32 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 4, 64, 1, rcx
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 12 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 4 macros each processing 32 data values

	loops_init_prefetch 4, 64, 1, rcx
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD3	;; Restore sin/cos ptr

;; Do FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 15 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 4 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_6_levels_real_1
	jg	ypass2_6_levels_real_3

ypass2_6_levels_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 4*64, 8*64
	loops_init_prefetch 4, 128, 1, rcx, 1, 4 ;; 3 more iterations
b3b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer
	jmp	ypass2_6_levels_real_unfft

ypass2_6_levels_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 4*64, 8*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 10 cache lines
	loops_init_prefetch 4, 128, 1, rcx, 1, 4 ;; 3 more iterations
b3a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b3a			;; Test loop counter
	jmp	ypass2_6_levels_real_done

ypass2_6_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops_init_prefetch 4, 128, 1, rcx, 1, 4 ;; 3 more iterations
b3c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b3c			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer
	jmp	ypass2_6_levels_real_unfft

ypass2_6_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops_init_prefetch 4, 128, 1, rcx, 1, 4 ;; 3 more iterations
b3d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b3d			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer
;;	bump	rcx, (-6+2*4-6)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...

;; Do 1 eight_reals_unfft operations
;; Do 15 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 4 macros processing 32 data values

ypass2_6_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 4*YMM_SCD3
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 10 cache lines
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*4*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60

;; Do 16 eight_reals_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros processing 32 data values

	bump	rdi, -4*YMM_SCD3-4*YMM_SCD3 ;; Load sin/cos pointer
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, c1b			;; Test loop counter

ypass2_6_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-6-levels-complex macro ******************
; This macro takes 64 complex values and performs the final 8 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 8 levels of the inverse FFT.

yr4dwpn_pass2_6_levels_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_6_levels_complex_1, ypass2_6_levels_complex_2
	LOCAL	ypass2_6_levels_complex_3, ypass2_6_levels_complex_4
	LOCAL	ypass2_6_levels_complex_unfft, ypass2_6_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 16 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6_levels_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...

;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 4			;; 4 iterations
	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	4, b1b			;; Test inner loop counter
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 4 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iters
	yr4_b4cl_four_complex_djbfft_preload
b2b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6 as well as inverse FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 16 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 4 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_6_levels_complex_1
	jg	ypass2_6_levels_complex_3

ypass2_6_levels_complex_2:
	start_timer 9
	loops_init_prefetch 4, 64, 1, rcx
b3b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_6_levels_complex_unfft

ypass2_6_levels_complex_1:
	start_timer 9
	loops_init_prefetch 4, 128, 1, rcx
b3a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b3a			;; Loop 4 times
	end_timer 9
	jmp	ypass2_6_levels_complex_done

ypass2_6_levels_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 4, 64, 1, rcx
b3c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b3c			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_6_levels_complex_unfft

ypass2_6_levels_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 4, 128, 1, rcx
b3d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b3d			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 9

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...

;; Do 16 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 4 macros each processing 32 data values

ypass2_6_levels_complex_unfft:
	start_timer 11
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 4*YMM_SCD2

	loops_init_prefetch 4, 64, 1, rcx ;; 4 iters
	yr4_b4cl_four_complex_djbunfft_preload
c2b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c2b			;; Loop 4 times
	bump	rsi, -4*4*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60

;; Do 16 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 32 data values

	start_timer 14
	mov	rdi, xsincos_complex	;; Load sin/cos pointer
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iters
	yr4_s4cl_four_complex_djbunfft_preload
c1b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	4, c1b			;; Test loop counter
	end_timer 14

ypass2_6_levels_complex_done:
	ENDM


; *************** radix4-pass2-80-real macro ******************
; This macro takes 160 real values and performs the final 7.322 levels of the FFT.
; The results are squared, and the first 7.322 levels of the inverse FFT are done.

yr4dwpn_pass2_80_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_80_real_1, ypass2_80_real_2
	LOCAL	ypass2_80_real_3, ypass2_80_real_4
	LOCAL	ypass2_80_real_unfft, ypass2_80_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 20 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_80_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	80	+1	+1	+1
;;	4	...
;;	...
;;	76
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 16 ten_reals_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 40 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 4, 64, 1, rcx
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 16 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 5 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+YMM_SCD2]

	yr4_s4cl_2sc_eight_reals_fft_preload
	yr4_s4cl_2sc_eight_reals_fft rsi, 4*64, 64, 2*64, rdi, rdx

	loops_init_prefetch 4, 128, 1, rcx ;; 4 more iters
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -5*4*64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 19 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 5 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_80_real_1
	jg	ypass2_80_real_3

ypass2_80_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 4*64, 64, 2*64
	loops_init_prefetch 4, 128, 1, rcx ;; 4 more iterations
b3b:	yr4_4cl_four_complex_with_square rsi, 4*64, 64, 2*64
	loops	4, b3b			;; Test loop counter
	bump	rsi, -5*4*64		;; Restore source pointer
	jmp	ypass2_80_real_unfft

ypass2_80_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 4*64, 64, 2*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 10 cache lines
	loops_init_prefetch 4, 128, 1, rcx ;; 4 more iterations
b3a:	yr4_4cl_four_complex_fft_final rsi, 4*64, 64, 2*64
	loops	4, b3a			;; Test loop counter
	jmp	ypass2_80_real_done

ypass2_80_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops_init_prefetch 4, 128, 1, rcx ;; 4 more iterations
b3c:	yr4_4cl_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops	4, b3c			;; Test loop counter
	bump	rsi, -5*4*64		;; Restore source pointer
	jmp	ypass2_80_real_unfft

ypass2_80_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops_init_prefetch 4, 128, 1, rcx ;; 4 more iterations
b3d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops	4, b3d			;; Test loop counter
	bump	rsi, -5*4*64		;; Restore source pointer
;;	bump	rcx, (-8+4+2*8)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 1 eight_reals_unfft operations
;; Do 19 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 4 macros processing 32 data values

ypass2_80_real_unfft:
	mov	rdx, sincos3		;; Load sin/cos pointer
	bump	rdx, 4*YMM_SCD4
	lea	rdi, [rdx+YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 10 cache lines

	yr4_s4cl_2sc_eight_reals_unfft_preload
	yr4_s4cl_2sc_eight_reals_unfft rsi, 4*64, 64, 2*64, rdi, rdx

	loops_init_prefetch 4, 64, 1, rcx ;; 4 more iters
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c2b			;; Test loop counter
	bump	rsi, -5*4*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	80	+1	+1	+1
;;	4	...
;;	...
;;	76

;; Do 16 ten_reals_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros processing 40 data values

	bump	rdi, -YMM_SCD2-4*YMM_SCD4 ;; Load sin/cos ptr
;;	bump	rcx, (10-4-4)*64	;; Move prefetch pointer along
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	4, c1b			;; Test loop counter

ypass2_80_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-80-complex macro ******************
; This macro takes 80 complex values and performs the final 6.322 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 6.322 levels of the inverse FFT.

yr4dwpn_pass2_80_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b3d, c1b, c2b
	LOCAL	ypass2_80_complex_1, ypass2_80_complex_2
	LOCAL	ypass2_80_complex_3, ypass2_80_complex_4
	LOCAL	ypass2_80_complex_unfft, ypass2_80_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 20 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_80_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	80	+1	+1	+1
;;	4	...
;;	...
;;	76
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 16 five_complex_fft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 4			;; 4 iterations
	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	4, b1b			;; Test inner loop counter
	bump	rsi, -4*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 20 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 5 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 5, 64, 1, rcx ;; 5 iters
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*4*64		;; Restore source pointer
	end_timer 6

;; Do FFT levels 5,6 as well as inverse FFT levels 5,6
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...

;; Do 20 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 5 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_80_complex_1
	jg	ypass2_80_complex_3

ypass2_80_complex_2:
	start_timer 9
	loops_init_prefetch 5, 64, 1, rcx
b3b:	yr4_4cl_four_complex_with_square rsi, 4*64, 64, 2*64
	loops	5, b3b			;; Loop 5 times
	bump	rsi, -5*4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_80_complex_unfft

ypass2_80_complex_1:
	start_timer 9
	loops_init_prefetch 5, 128, 1, rcx
b3a:	yr4_4cl_four_complex_fft_final rsi, 4*64, 64, 2*64
	loops	5, b3a			;; Loop 5 times
	end_timer 9
	jmp	ypass2_80_complex_done

ypass2_80_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 5, 64, 1, rcx
b3c:	yr4_4cl_four_complex_with_mult rsi, 4*64, 64, 2*64
	loops	5, b3c			;; Loop 5 times
	bump	rsi, -5*4*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_80_complex_unfft

ypass2_80_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 5, 128, 1, rcx
b3d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, 64, 2*64
	loops	5, b3d			;; Loop 5 times
	bump	rsi, -5*4*64		;; Restore source pointer
	end_timer 9

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+8	+8	+8	4	+8	+8	+8
;;	1	...
;;	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...

;; Do 20 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 5 macros each processing 32 data values

ypass2_80_complex_unfft:
	start_timer 11
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 4*YMM_SCD2
	loops_init_prefetch 5, 64, 1, rcx ;; 5 iters
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	5, c2b			;; Loop 5 times
	bump	rsi, -5*4*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	16	+1	+1	+1
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	80	+1	+1	+1
;;	4	...
;;	...
;;	76

;; Do 16 five_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 4 macros each processing 40 data values

	start_timer 14
	bump	rdi, -4*YMM_SCD2	;; Load sin/cos ptr
;;	bump	rcx, (20+0-3*5-4)*64	;; Move prefetch pointer along
	loops_init_prefetch 4, 64, 1, rcx ;; 4 iters
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 64, 4*64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	4, c1b			;; Test loop counter
	end_timer 14

ypass2_80_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-8-levels
;*********************************************************************************************


; *************** radix4-pass2-192-real macro ******************
; This macro takes 384 real values and performs the final 8.585 levels of the FFT.
; The results are squared, and the first 8.585 levels of the inverse FFT are done.

yr4dwpn_pass2_192_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b4c, b4d, c1b, c2a, c2b, c3a, c3b
	LOCAL	ypass2_192_real_1, ypass2_192_real_2
	LOCAL	ypass2_192_real_3, ypass2_192_real_4
	LOCAL	ypass2_192_real_unfft, ypass2_192_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch
					;; 48 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_192_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	192	+1	+1	+1
;;	4	...
;;	...
;;	188
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 64 six_reals_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 24 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init 16
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 32 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 12 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+4*YMM_SCD2]
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iterations of 4
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 4*64, 8*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	4, b2a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 4
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 44 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 12 macros each processing 32 data values

	bump	rdi, 4*YMM_SCD2		;; Load sin/cos ptr
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sin/cos pointer
	loops	3, b3b			;; Test loop counter
	bump	rsi, -12*4*64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 47 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 12 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_192_real_1
	jg	ypass2_192_real_3

ypass2_192_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 4*64, 8*64
	loops_init_prefetch 12, 64, 1, rcx, 1, 4 ;; 11 more iterations
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4b			;; Test loop counter
	bump	rsi, -3*16*64		;; Restore source pointer
	jmp	ypass2_192_real_unfft

ypass2_192_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 4*64, 8*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 26 cache lines
	loops_init_prefetch 12, 128, 1, rcx, 1, 4 ;; 11 more iterations
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4a			;; Test loop counter
	jmp	ypass2_192_real_done

ypass2_192_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops_init_prefetch 12, 64, 1, rcx, 1, 4 ;; 11 more iterations
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b4c			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4c			;; Test loop counter
	bump	rsi, -3*16*64		;; Restore source pointer
	jmp	ypass2_192_real_unfft

ypass2_192_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops_init_prefetch 12, 128, 1, rcx, 1, 4 ;; 11 more iterations
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b4d			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4d			;; Test loop counter
	bump	rsi, -3*16*64		;; Restore source pointer
;;	bump	rcx, (-22+3*12)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 44 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 12 macros processing 32 data values

ypass2_192_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 4*YMM_SCD2+4*YMM_SCD2+16*YMM_SCD2
;;	bump	rcx, (48+0-3*12-12)*64	;; Move prefetch pointer along
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -12*4*64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 32 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 12 macros processing 32 data values

	bump	rdi, -4*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-4*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 26 cache lines
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iterations of 4
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 4*64, 8*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 4
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*16*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	192	+1	+1	+1
;;	4	...
;;	...
;;	188

;; Do 64 six_reals_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros processing 24 data values

	bump	rdi, -4*YMM_SCD2-16*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (26-12-16)*64	;; Move prefetch pointer along
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	16, c1b			;; Test loop counter

ypass2_192_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-192-complex macro ******************
; This macro takes 192 complex values and performs the final 7.585 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 7.585 levels of the inverse FFT.

yr4dwpn_pass2_192_complex MACRO
	LOCAL	b1b, b2b, b3b, b4a, b4b, b4c, b4d, c1b, c2b, c3b
	LOCAL	ypass2_192_complex_1, ypass2_192_complex_2
	LOCAL	ypass2_192_complex_3, ypass2_192_complex_4
	LOCAL	ypass2_192_complex_unfft, ypass2_192_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 48 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_192_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	192	+1	+1	+1
;;	4	...
;;	...
;;	188
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 64 three_complex_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 16			;; 16 iterations
	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD1		;; Next sin/cos data
	loops	16, b1b			;; Test inner loop counter
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 12 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iters of 4
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 12 macros each processing 32 data values

	start_timer 7
	loops_init_prefetch 12, 64, 2, rcx ;; 3 iters of 4
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, b3b			;; Loop 3 times
	bump	rsi, -12*4*64		;; Restore source pointer
	end_timer 7

;; Do FFT levels 7,8 as well as inverse FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 48 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 12 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_192_complex_1
	jg	ypass2_192_complex_3

ypass2_192_complex_2:
	start_timer 9
	loops_init_prefetch 12, 64, 2, rcx
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4b			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_192_complex_unfft

ypass2_192_complex_1:
	start_timer 9
;;	bump	rcx, (48+0-12-6-24)*64	;; Move prefetch pointer along
	loops_init_prefetch 12, 128, 1, rcx
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4a			;; Loop 3 times
	end_timer 9
	jmp	ypass2_192_complex_done

ypass2_192_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 12, 64, 2, rcx
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4c			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_192_complex_unfft

ypass2_192_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 12, 128, 1, rcx
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	3, b4d			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer
;;	bump	rcx, (-24+12+2*6)*64	;; Move prefetch pointer to where squaring would be
	end_timer 9

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 48 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 12 macros each processing 32 data values

ypass2_192_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 16*YMM_SCD1+4*YMM_SCD2
	loops_init_prefetch 12, 64, 2, rcx ;; 3 iters of 4
	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, c3b			;; Loop 3 times
	bump	rsi, -12*4*64		;; Restore source pointer
	end_timer 10

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 48 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 12 macros each processing 32 data values

	start_timer 11
	bump	rdi, -4*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 12, 64, 1, rcx ;; 3 iters of 4
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Loop 3 times
	bump	rsi, -3*16*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	192	+1	+1	+1
;;	4	...
;;	...
;;	188

;; Do 64 three_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 24 data values

	start_timer 14
	bump	rdi, -16*YMM_SCD1	;; Load sin/cos ptr
	bump	rcx, (48+0-12-3*6-12-8)*64 ;; Move prefetch pointer along
	loops_init_prefetch 16, 64, 2, rcx ;; 16 iters
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD1		;; Next set of sin/cos data
	loops	16, c1b			;; Test loop counter
	end_timer 14

ypass2_192_complex_done:
	ENDM


; *************** radix4-pass2-8-levels-real macro ******************
; This macro takes 512 real values and performs the final 9 levels of the FFT.
; The results are squared, and the first 9 levels of the inverse FFT are done.

yr4dwpn_pass2_8_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b4a, b4b, b4c, b4d, c1b, c2b, c3a, c3b
	LOCAL	ypass2_8_levels_real_1, ypass2_8_levels_real_2
	LOCAL	ypass2_8_levels_real_3, ypass2_8_levels_real_4
	LOCAL	ypass2_8_levels_real_unfft, ypass2_8_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 64 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_8_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...

;; Do 64 eight_reals_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 32 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init 16
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 48 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 16 macros each processing 32 data values

	loops_init_prefetch 16, 64, 1, rcx
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos ptr

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 60 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 16 macros each processing 32 data values

	loops_init_prefetch 16, 64, 1, rcx ;; 4 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*4*64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 63 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 16 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_8_levels_real_1
	jg	ypass2_8_levels_real_3

ypass2_8_levels_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 16, 64, 1, rcx, 1, 16 ;; 15 more iterations
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b4b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer
	jmp	ypass2_8_levels_real_unfft

ypass2_8_levels_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 34 cache lines
	loops_init_prefetch 16, 128, 1, rcx, 1, 16 ;; 15 more iterations
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b4a			;; Test loop counter
	jmp	ypass2_8_levels_real_done

ypass2_8_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 16, 64, 1, rcx, 1, 16 ;; 15 more iterations
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b4c			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer
	jmp	ypass2_8_levels_real_unfft

ypass2_8_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 16, 128, 1, rcx, 1, 16 ;; 15 more iterations
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b4d			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer
;;	bump	rcx, (-32+3*16)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 60 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 16 macros processing 32 data values

ypass2_8_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD3
	loops_init_prefetch 16, 64, 1, rcx ;; 4 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 3 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*4*64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 48 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 16 macros processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 34 cache lines
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252

;; Do 64 eight_reals_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros processing 32 data values

	bump	rdi, -16*YMM_SCD3-16*YMM_SCD3 ;; Load sin/cos pointer
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	16, c1b			;; Test loop counter

ypass2_8_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-8-levels-complex macro ******************
; This macro takes 256 complex values and performs the final 8 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 8 levels of the inverse FFT.

yr4dwpn_pass2_8_levels_complex MACRO
	LOCAL	b1b, b2b, b3b, b4a, b4b, b4c, b4d, c1b, c2b, c3b
	LOCAL	ypass2_8_levels_complex_1, ypass2_8_levels_complex_2
	LOCAL	ypass2_8_levels_complex_3, ypass2_8_levels_complex_4
	LOCAL	ypass2_8_levels_complex_unfft, ypass2_8_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 64 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_8_levels_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 16			;; 16 iterations
	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b1b			;; Test inner loop counter
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 16 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iters
	yr4_b4cl_four_complex_djbfft_preload
b2b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2/4	;; Restore sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 16 macros each processing 32 data values

	start_timer 7
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iters
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b3b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	end_timer 7

;; Do FFT levels 7,8 as well as inverse FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 64 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 16 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_8_levels_complex_1
	jg	ypass2_8_levels_complex_3

ypass2_8_levels_complex_2:
	start_timer 9
	loops_init_prefetch 16, 64, 2, rcx
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b4b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_8_levels_complex_unfft

ypass2_8_levels_complex_1:
	start_timer 9
	loops_init_prefetch 16, 128, 1, rcx
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b4a			;; Loop 16 times
	end_timer 9
	jmp	ypass2_8_levels_complex_done

ypass2_8_levels_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 16, 64, 2, rcx
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b4c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_8_levels_complex_unfft

ypass2_8_levels_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 16, 128, 1, rcx
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b4d			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 9

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 16 macros each processing 32 data values

ypass2_8_levels_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 16*YMM_SCD2

	loops_init_prefetch 16, 64, 2, rcx ;; 16 iters
	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c3b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	end_timer 10

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 16 macros each processing 32 data values

	start_timer 11
	loops_init_prefetch 16, 64, 2, rcx ;; 16 iters
	yr4_b4cl_four_complex_djbunfft_preload
c2b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, c2b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252

;; Do 64 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 32 data values

	start_timer 14
	mov	rdi, xsincos_complex	;; Load sin/cos pointer
	loops_init_prefetch 16, 64, 2, rcx ;; 16 iters
	yr4_s4cl_four_complex_djbunfft_preload
c1b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	16, c1b			;; Test loop counter
	end_timer 14

ypass2_8_levels_complex_done:
	ENDM


; *************** radix4-pass2-320-real macro ******************
; This macro takes 640 real values and performs the final 9.322 levels of the FFT.
; The results are squared, and the first 9.322 levels of the inverse FFT are done.

yr4dwpn_pass2_320_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b4c, b4d, c1b, c2a, c2b, c3a, c3b
	LOCAL	ypass2_320_real_1, ypass2_320_real_2
	LOCAL	ypass2_320_real_3, ypass2_320_real_4
	LOCAL	ypass2_320_real_unfft, ypass2_320_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch
					;; 80 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_320_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	320	+1	+1	+1
;;	4	...
;;	...
;;	316
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 64 ten_reals_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 40 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init 16
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 64 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 20 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+4*YMM_SCD2]
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iterations of 4
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 4*64, 8*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	4, b2a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 4
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 76 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 20 macros each processing 32 data values

	bump	rdi, 4*YMM_SCD2		;; Load sin/cos ptr
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 4 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sin/cos pointer
	loops	5, b3b			;; Test loop counter
	bump	rsi, -20*4*64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 79 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 20 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_320_real_1
	jg	ypass2_320_real_3

ypass2_320_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 4*64, 8*64
	loops_init_prefetch 20, 64, 1, rcx, 1, 4 ;; 19 more iterations
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4b			;; Test loop counter
	bump	rsi, -5*16*64		;; Restore source pointer
	jmp	ypass2_320_real_unfft

ypass2_320_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 4*64, 8*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 42 cache lines
	loops_init_prefetch 20, 128, 1, rcx, 1, 4 ;; 19 more iterations
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4a			;; Test loop counter
	jmp	ypass2_320_real_done

ypass2_320_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops_init_prefetch 20, 64, 1, rcx, 1, 4 ;; 19 more iterations
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b4c			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4c			;; Test loop counter
	bump	rsi, -5*16*64		;; Restore source pointer
	jmp	ypass2_320_real_unfft

ypass2_320_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops_init_prefetch 20, 128, 1, rcx, 1, 4 ;; 19 more iterations
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b4d			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4d			;; Test loop counter
	bump	rsi, -5*16*64		;; Restore source pointer
;;	bump	rcx, (-38+3*20)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 76 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 20 macros processing 32 data values

ypass2_320_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 4*YMM_SCD2+4*YMM_SCD2+16*YMM_SCD4
;;	bump	rcx, (80+0-3*20-20)*64	;; Move prefetch pointer along
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rdi, -4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	5, c3b			;; Test loop counter
	bump	rsi, -20*4*64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 64 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 20 macros processing 32 data values

	bump	rdi, -4*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-4*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 42 cache lines
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iterations of 4
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 4*64, 8*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 4
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*16*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	320	+1	+1	+1
;;	4	...
;;	...
;;	316

;; Do 64 ten_reals_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros processing 40 data values

	bump	rdi, -4*YMM_SCD2-16*YMM_SCD4 ;; Load sin/cos ptr
;;	bump	rcx, (42-20-16)*64	;; Move prefetch pointer along
	loops_init_prefetch 16, 64, 1, rcx ;; 16 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	16, c1b			;; Test loop counter

ypass2_320_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-320-complex macro ******************
; This macro takes 320 complex values and performs the final 8.322 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 8.322 levels of the inverse FFT.

yr4dwpn_pass2_320_complex MACRO
	LOCAL	b1b, b2b, b3b, b4a, b4b, b4c, b4d, c1b, c2b, c3b
	LOCAL	ypass2_320_complex_1, ypass2_320_complex_2
	LOCAL	ypass2_320_complex_3, ypass2_320_complex_4
	LOCAL	ypass2_320_complex_unfft, ypass2_320_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 80 cache lines + 0 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_320_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	320	+1	+1	+1
;;	4	...
;;	...
;;	316
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 64 five_complex_fft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 16			;; 16 iterations
	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b1b			;; Test inner loop counter
	bump	rsi, -16*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 80 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 20 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iters of 4
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 80 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 20 macros each processing 32 data values

	start_timer 7
	loops_init_prefetch 20, 64, 2, rcx ;; 5 iters of 4
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, b3b			;; Loop 5 times
	bump	rsi, -20*4*64		;; Restore source pointer
	end_timer 7

;; Do FFT levels 7,8 as well as inverse FFT levels 7,8
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 80 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 20 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_320_complex_1
	jg	ypass2_320_complex_3

ypass2_320_complex_2:
	start_timer 9
	loops_init_prefetch 20, 64, 2, rcx
b4b:	yr4_4cl_four_complex_with_square rsi, 64, 4*64, 8*64
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4b			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_320_complex_unfft

ypass2_320_complex_1:
	start_timer 9
;;	bump	rcx, (80+0-20-10-40)*64	;; Move prefetch pointer along
	loops_init_prefetch 20, 128, 1, rcx
b4a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*64, 8*64
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4a			;; Loop 5 times
	end_timer 9
	jmp	ypass2_320_complex_done

ypass2_320_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 20, 64, 2, rcx
b4c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*64, 8*64
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4c			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_320_complex_unfft

ypass2_320_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 20, 128, 1, rcx
b4d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*64, 8*64
	loops	4, b4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	5, b4d			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer
;;	bump	rcx, (-40+20+2*10)*64	;; Move prefetch pointer to where squaring would be
	end_timer 9

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	4	+32	+32	+32
;;	8	...
;;	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...

;; Do 80 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 20 macros each processing 32 data values

ypass2_320_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 16*YMM_SCD2+4*YMM_SCD2
	loops_init_prefetch 20, 64, 2, rcx ;; 5 iters of 4
	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, c3b			;; Loop 5 times
	bump	rsi, -20*4*64		;; Restore source pointer
	end_timer 10

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+32	+32	+32	16	+32	+32	+32
;;	4	...
;;	...
;;	12	...
;;	1	...
;;	...
;;	128	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...

;; Do 80 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 20 macros each processing 32 data values

	start_timer 11
	bump	rdi, -4*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 20, 64, 1, rcx ;; 5 iters of 4
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Loop 5 times
	bump	rsi, -5*16*64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	64	+1	+1	+1
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	320	+1	+1	+1
;;	4	...
;;	...
;;	316

;; Do 64 five_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 16 macros each processing 40 data values

	start_timer 14
	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (80+0-20-3*10-20-8)*64 ;; Move prefetch pointer along
	loops_init_prefetch 16, 64, 2, rcx ;; 16 iters
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 64, 16*64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	16, c1b			;; Test loop counter
	end_timer 14

ypass2_320_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-10-levels
;*********************************************************************************************


; *************** radix4-pass2-768-real macro ******************
; This macro takes 1536 real values and performs the final 10.585 levels of the FFT.
; The results are squared, and the first 10.585 levels of the inverse FFT are done.

yr4dwpn_pass2_768_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_768_real_1, ypass2_768_real_2
	LOCAL	ypass2_768_real_3, ypass2_768_real_4
	LOCAL	ypass2_768_real_unfft, ypass2_768_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 192 cache lines + 2 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_768_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 six_reals_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 24 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 64, 64, 2, rcx ;; 64 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 128 four_complex_djbfft operations
;;	distance between fft data elements is 64
;;	do 48 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+16*YMM_SCD2]
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iterations of 16
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	16, b2a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b2b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 176 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 48 macros each processing 32 data values

	bump	rdi, 16*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer
	loops	3, b3b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 188 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 48 macros each processing 32 data values

	loops_init_prefetch 48, 64, 2, rcx ;; 12 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 11 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	3, b4b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 191 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 48 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_768_real_1
	jg	ypass2_768_real_3

ypass2_768_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 48, 64, 2, rcx, 1, 16 ;; 47 more iterations
b5b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	jmp	ypass2_768_real_unfft

ypass2_768_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 98 cache lines
	loops_init_prefetch 48, 128, 1, rcx, 1, 16 ;; 47 more iterations
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5a			;; Loop 3 times
	jmp	ypass2_768_real_done

ypass2_768_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 48, 64, 2, rcx, 1, 16 ;; 47 more iterations
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5c			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	jmp	ypass2_768_real_unfft

ypass2_768_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 48, 128, 1, rcx, 1, 16 ;; 47 more iterations
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5d			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
;;	bump	rcx, (-96+32+4*24)*64	;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 188 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 48 macros processing 32 data values

ypass2_768_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD2+16*YMM_SCD2+64*YMM_SCD2
	loops_init_prefetch 48, 64, 2, rcx ;; 12 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 11 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	3, c4b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 176 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 48 macros processing 32 data values

	bump	rcx, (192+2-32-5*24-48)*64 ;; Move prefetch pointer along
	loops_init_prefetch 48, 64, 1, rcx ;; 3 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 128 four_complex_djbunfft operations
;;	distance between fft data elements is 64
;;	do 48 macros processing 32 data values

	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-16*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 98 cache lines
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iterations of 16
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764

;; Do 256 six_reals_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros processing 24 data values

	bump	rdi, -16*YMM_SCD2-64*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (98-24-64)*64	;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 1, rcx ;; 64 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter

ypass2_768_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-768-complex macro ******************
; This macro takes 768 complex values and performs the final 9.585 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 9.585 levels of the inverse FFT.

yr4dwpn_pass2_768_complex MACRO
	LOCAL	b1b, b2b, b3b, b4b, b5a, b5b, b5c, b5d, c1b, c2b, c3b, c4b
	LOCAL	ypass2_768_complex_1, ypass2_768_complex_2
	LOCAL	ypass2_768_complex_3, ypass2_768_complex_4
	LOCAL	ypass2_768_complex_unfft, ypass2_768_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 192 cache lines + 2 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_768_complex_4

;; Do FFT levels 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 three_complex_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init 64			;; 64 iterations
	yr3_f3cl_three_complex_djbfft_preload
;; Loop below reworked to avoid 4KB distances
;;b1b:	yr3_f3cl_three_complex_djbfft rsi, 64, dist64, rdi
;;	bump	rdi, YMM_SCD1		;; Next sin/cos data
;;	loops	64, b1b			;; Test inner loop counter
;;	bump	rsi, -64*64		;; Restore source pointer
b1b:	yr3_f3cl_three_complex_djbfft rsi, 4*64, dist64, rdi
	bump	rdi, 4*YMM_SCD1		;; Next sin/cos data
	loops	16, b1b			;; Test inner loop counter
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD1+64*YMM_SCD1 ;; Next sin/cos data
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 48 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b2b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 48 macros each processing 32 data values

	start_timer 7
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iters of 16
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, b3b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 7

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 48 macros each processing 32 data values

	start_timer 8
	loops_init_prefetch 48, 64, 2, rcx ;; 12 iters of 4
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b4b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, b4b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 8

;; Do FFT levels 9,10 as well as inverse FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 48 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_768_complex_1
	jg	ypass2_768_complex_3

ypass2_768_complex_2:
	start_timer 9
	loops_init_prefetch 48, 64, 2, rcx
b5b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_768_complex_unfft

ypass2_768_complex_1:
	start_timer 9
;;	bump	rcx, (192+2-3*24-96)*64 ;; Move prefetch pointer along
	loops_init_prefetch 48, 128, 1, rcx
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5a			;; Loop 3 times
	end_timer 9
	jmp	ypass2_768_complex_done

ypass2_768_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 48, 64, 2, rcx
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5c			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_768_complex_unfft

ypass2_768_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 48, 128, 1, rcx
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	3, b5d			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
;;	bump	rcx, (-96+4*24)*64	;; Move prefetch pointer to where squaring would be
	end_timer 9

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 48 macros each processing 32 data values

ypass2_768_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 64*YMM_SCD1+16*YMM_SCD2
	loops_init_prefetch 48, 64, 2, rcx ;; 12 iters of 4
	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c4b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, c4b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 10

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 48 macros each processing 32 data values

	start_timer 11
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iters of 16
	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	3, c3b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 192 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 48 macros each processing 32 data values

	start_timer 12
	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 48, 64, 2, rcx ;; 3 iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Loop 3 times
	bump	rsi, -3*dist64		;; Restore source pointer
	end_timer 12

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764

;; Do 256 three_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 24 data values

	start_timer 14
	bump	rdi, -64*YMM_SCD1	;; Load sin/cos ptr
	bump	rcx, (192+2-7*24-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 2, rcx ;; 64 iters
	yr3_3cl_three_complex_djbunfft_preload
;; Loop below reworked to avoid 4KB distances
;;c1b:	yr3_3cl_three_complex_djbunfft rsi, 64, dist64, rdi
;;	bump	rdi, YMM_SCD1		;; Next set of sin/cos data
;;	loops	64, c1b			;; Test loop counter
c1b:	yr3_3cl_three_complex_djbunfft rsi, 4*64, dist64, rdi
	bump	rdi, 4*YMM_SCD1		;; Next set of sin/cos data
	loops	16, c1b			;; Test loop counter
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD1+YMM_SCD1 ;; Next set of sin/cos data
	loops	4, c1b			;; Test loop counter
	end_timer 14

ypass2_768_complex_done:
	ENDM


; *************** radix4-pass2-10-levels-real macro ******************
; This macro takes 2048 real values and performs the final 11 levels of the FFT.
; The results are squared, and the first 11 levels of the inverse FFT are done.

yr4dwpn_pass2_10_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_10_levels_real_1, ypass2_10_levels_real_2
	LOCAL	ypass2_10_levels_real_3, ypass2_10_levels_real_4
	LOCAL	ypass2_10_levels_real_unfft, ypass2_10_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 256 cache lines + 2*3 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_10_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...

;; Do 256 eight_reals_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 32 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 64, 64, 1, rcx
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rcx, 64			;; Skip pad bytes

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 192 four_complex_djbfft operations
;;	distance between fft data elements is 64
;;	do 64 macros each processing 32 data values

	loops_init_prefetch 64, 64, 1, rcx
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b2b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos ptr
	bump	rcx, 64			;; Skip pad bytes

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 240 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 64 macros each processing 32 data values

	loops_init_prefetch 64, 64, 2, rcx ;; 4 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*16*64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 252 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 64 macros each processing 32 data values

	loops_init_prefetch 64, 64, 2, rcx ;; 16 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 15 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b4b			;; Test loop counter
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rcx, 64			;; Skip pad bytes

;; Do FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 255 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 64 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_10_levels_real_1
	jg	ypass2_10_levels_real_3

ypass2_10_levels_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops_init_prefetch 64, 64, 2, rcx, 1, 64 ;; 63 more iterations
b5b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b5b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	jmp	ypass2_10_levels_real_unfft

ypass2_10_levels_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, dist64, 2*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 136 cache lines
	loops_init_prefetch 64, 128, 1, rcx, 1, 64 ;; 63 more iterations
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b5a			;; Test loop counter
	jmp	ypass2_10_levels_real_done

ypass2_10_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops_init_prefetch 64, 64, 2, rcx, 1, 64 ;; 63 more iterations
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b5c			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	jmp	ypass2_10_levels_real_unfft

ypass2_10_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops_init_prefetch 64, 128, 1, rcx, 1, 64 ;; 63 more iterations
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b5d			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rcx, (-128+2*64+3*32)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 252 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 64 macros processing 32 data values

ypass2_10_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 64*YMM_SCD3
;;	bump	rcx, (256+2*3-2*64-3*32-64)*64 ;; Move prefetch pointer back to where squaring would be
	loops_init_prefetch 64, 64, 1, rcx ;; 16 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 15 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c4b			;; Test loop counter
	bump	rsi, -16*4*64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 240 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 64 macros processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 136 cache lines
	loops_init_prefetch 64, 64, 8, rcx ;; 4 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 3 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*16*64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 192 four_complex_djbunfft operations
;;	distance between fft data elements is 64
;;	do 64 macros processing 32 data values

	loops_init_prefetch 64, 64, 1, rcx ;; 64 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c2b			;; Test loop counter
	bump	rsi, -16*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1K	+1	+1	+1
;;	4	...
;;	...
;;	1020

;; Do 256 eight_reals_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros processing 32 data values

	bump	rdi, -64*YMM_SCD3-64*YMM_SCD3 ;; Load sin/cos pointer
	bump	rcx, (136-8-64-64)*64	;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 1, rcx ;; 64 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter

ypass2_10_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-10-levels-complex macro ******************
; This macro takes 1024 complex values and performs the final 10 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 10 levels of the inverse FFT.

yr4dwpn_pass2_10_levels_complex MACRO
	LOCAL	b1b, b2b, b3b, b4b, b5a, b5b, b5c, b5d, c1b, c2b, c3b, c4b
	LOCAL	ypass2_10_levels_complex_1, ypass2_10_levels_complex_2
	LOCAL	ypass2_10_levels_complex_3, ypass2_10_levels_complex_4
	LOCAL	ypass2_10_levels_complex_unfft, ypass2_10_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 256 cache lines + 2*3 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_10_levels_complex_4

;; Do FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...

;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init_prefetch 64, 64, 2, rcx ;; 64 iterations
	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b1b			;; Test inner loop counter
	bump	rsi, -64*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 64 macros each processing 32 data values

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 64 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 64 macros each processing 32 data values

;; Do this 64 cache lines at a time to maximize accessing data
;; while it is in the L1 cache.

	start_timer 6
	mov	rbx, rdi
	mov	rbp, rdi
	loops_init_prefetch 64, 64, 2, rcx ;; 4 iters of 64 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b2b:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b2b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rbx
	bump	rbx, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rbx, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rbp
	loops	16, b4b			;; Loop 16 times

	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rbx, YMM_SCD2/4		;; Next sine/cosine pointer
	bump	rbp, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b2b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	end_timer 6

;; Do FFT levels 9,10 as well as inverse FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 256 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 64 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_10_levels_complex_1
	jg	ypass2_10_levels_complex_3

ypass2_10_levels_complex_2:
	start_timer 9
	loops_init_prefetch 64, 64, 2, rcx
b5b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b5b			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_10_levels_complex_unfft

ypass2_10_levels_complex_1:
	start_timer 9
;;	bump	rcx, (256+2*3-4*32-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 64, 128, 1, rcx
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b5a			;; Loop 64 times
	end_timer 9
	jmp	ypass2_10_levels_complex_done

ypass2_10_levels_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 64, 64, 2, rcx
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b5c			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_10_levels_complex_unfft

ypass2_10_levels_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 64, 128, 1, rcx
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b5d			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rcx, (-128+5*32)*64	;; Move prefetch pointer back to where squaring would be
	end_timer 9

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 64 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 64 macros each processing 32 data values

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;
;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 64 macros each processing 32 data values

;; Do this 64 cache lines at a time to maximize accessing data
;; while it is in the L1 cache.

ypass2_10_levels_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 64*YMM_SCD2
	mov	rbx, rdi
	mov	rbp, rdi
	loops_init_prefetch 64, 64, 2, rcx ;; 4 iters of 64 cache lines

	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rbp
	loops	16, c4b			;; Loop 16 times
	bump	rsi, -16*4*64		;; Restore source pointer
	loops_undo 16			;; Restore loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rbx
	bump	rbx, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rbx, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	loops_undo 4*4			;; Restore loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c2b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c2b			;; Loop 16 times

	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rbx, YMM_SCD2/4		;; Next sine/cosine pointer
	bump	rbp, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	end_timer 10

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1K	+1	+1	+1
;;	4	...
;;	...
;;	1020

;; Do 256 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 32 data values

	start_timer 14
	mov	rdi, xsincos_complex	;; Load sin/cos pointer
	bump	rcx, (256+2*3-8*32-8)*64 ;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 8, rcx ;; 64 iters
	yr4_s4cl_four_complex_djbunfft_preload
c1b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	64, c1b			;; Test loop counter
	end_timer 14

ypass2_10_levels_complex_done:
	ENDM


; *************** radix4-pass2-1280-real macro ******************
; This macro takes 2560 real values and performs the final 11.322 levels of the FFT.
; The results are squared, and the first 11.322 levels of the inverse FFT are done.

yr4dwpn_pass2_1280_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_1280_real_1, ypass2_1280_real_2
	LOCAL	ypass2_1280_real_3, ypass2_1280_real_4
	LOCAL	ypass2_1280_real_unfft, ypass2_1280_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 320 cache lines + 2*4 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_1280_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 ten_reals_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 40 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 64, 64, 8, rcx ;; 64 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 256 four_complex_djbfft operations
;;	distance between fft data elements is 64
;;	do 80 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+16*YMM_SCD2]
	loops_init_prefetch 80, 64, 1, rcx ;; 5 iterations of 16
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	16, b2a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b2b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 304 four_complex_djbfft operations
;;	distance between fft data elements is 16
;;	do 80 macros each processing 32 data values

	bump	rdi, 16*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 80, 64, 1, rcx ;; 5 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 4 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer
	loops	5, b3b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 316 four_complex_djbfft operations
;;	distance between fft data elements is 4
;;	do 80 macros each processing 32 data values

	loops_init_prefetch 80, 64, 1, rcx ;; 20 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 19 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	5, b4b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1 eight_reals_fft operations
;; Do 319 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 80 macros each processing 32 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_1280_real_1
	jg	ypass2_1280_real_3

ypass2_1280_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 80, 64, 2, rcx, 1, 16 ;; 79 more iterations
b5b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	jmp	ypass2_1280_real_unfft

ypass2_1280_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 162 cache lines
	loops_init_prefetch 80, 128, 1, rcx, 1, 16 ;; 79 more iterations
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5a			;; Loop 5 times
	jmp	ypass2_1280_real_done

ypass2_1280_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 80, 64, 2, rcx, 1, 16 ;; 79 more iterations
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5c			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	jmp	ypass2_1280_real_unfft

ypass2_1280_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 80, 128, 1, rcx, 1, 16 ;; 79 more iterations
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5d			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
;;	bump	rcx, (-128+8+3*80+40)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 316 four_complex_djbunfft operations
;;	distance between fft data elements is 4
;;	do 80 macros processing 32 data values

ypass2_1280_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD2+16*YMM_SCD2+64*YMM_SCD4
;;	bump	rcx, (320+2*4-8-3*80-40-40)*64 ;; Move prefetch pointer back to where squaring would be
	loops_init_prefetch 80, 64, 1, rcx ;; 20 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 19 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	5, c4b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 304 four_complex_djbunfft operations
;;	distance between fft data elements is 16
;;	do 80 macros processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 162 cache lines
	loops_init_prefetch 80, 64, 4, rcx ;; 5 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	5, c3b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 256 four_complex_djbunfft operations
;;	distance between fft data elements is 64
;;	do 80 macros processing 32 data values

	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-16*YMM_SCD2]
	loops_init_prefetch 80, 64, 1, rcx ;; 5 iterations of 16
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276

;; Do 256 ten_reals_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros processing 40 data values

	bump	rdi, -16*YMM_SCD2-64*YMM_SCD4 ;; Load sin/cos ptr
	bump	rcx, (162-20-80-64)*64	;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 1, rcx ;; 64 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter

ypass2_1280_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-1280-complex macro ******************
; This macro takes 1280 complex values and performs the final 10.322 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 10.322 levels of the inverse FFT.

yr4dwpn_pass2_1280_complex MACRO
	LOCAL	b1b, b2b, b3b, b4b, b5a, b5b, b5c, b5d, c1b, c2b, c3b, c4b
	LOCAL	ypass2_1280_complex_1, ypass2_1280_complex_2
	LOCAL	ypass2_1280_complex_3, ypass2_1280_complex_4
	LOCAL	ypass2_1280_complex_unfft, ypass2_1280_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 320 cache lines + 2*4 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_1280_complex_4

;; Do FFT levels 1,2 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 five_complex_fft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos data
	loops_init_prefetch 64, 64, 4, rcx ;; 64 iterations
	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b1b			;; Test inner loop counter
	bump	rsi, -64*64		;; Restore source pointer
	end_timer 4

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 80 macros each processing 32 data values

	start_timer 6
	loops_init_prefetch 80, 64, 2, rcx ;; 5 iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b2b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	end_timer 6

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 80 macros each processing 32 data values

	start_timer 7
	loops_init_prefetch 80, 64, 2, rcx ;; 5 iters of 16
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, b3b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 7

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 80 macros each processing 32 data values

	start_timer 8
	loops_init_prefetch 80, 64, 2, rcx ;; 20 iters of 4
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b4b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, b4b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 8

;; Do FFT levels 9,10 as well as inverse FFT levels 9,10
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 80 macros each processing 32 data values

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_1280_complex_1
	jg	ypass2_1280_complex_3

ypass2_1280_complex_2:
	start_timer 9
	loops_init_prefetch 80, 64, 2, rcx
b5b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_1280_complex_unfft

ypass2_1280_complex_1:
	start_timer 9
;;	bump	rcx, (320+4-16-3*40-160)*64 ;; Move prefetch pointer along
	loops_init_prefetch 80, 128, 1, rcx
b5a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5a			;; Loop 5 times
	end_timer 9
	jmp	ypass2_1280_complex_done

ypass2_1280_complex_3:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 80, 64, 2, rcx
b5c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5c			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 9
	jmp	ypass2_1280_complex_unfft

ypass2_1280_complex_4:
	start_timer 9
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 80, 128, 1, rcx
b5d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	5, b5d			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
;;	bump	rcx, (-160+16+4*40)*64	;; Move prefetch pointer to where squaring would be
	end_timer 9

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 80 macros each processing 32 data values

ypass2_1280_complex_unfft:
	start_timer 10
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	bump	rdi, 64*YMM_SCD2+16*YMM_SCD2
	loops_init_prefetch 80, 64, 2, rcx ;; 20 iters of 4
	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c4b			;; Loop 4 times
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, c4b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 10

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 80 macros each processing 32 data values

	start_timer 11
	loops_init_prefetch 80, 64, 2, rcx ;; 5 iters of 16
	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	5, c3b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 11

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 320 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 80 macros each processing 32 data values

	start_timer 12
	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 80, 64, 2, rcx ;; 5 iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c2b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Loop 5 times
	bump	rsi, -5*dist64		;; Restore source pointer
	end_timer 12

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276

;; Do 256 five_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 64 macros each processing 40 data values

	start_timer 14
	bump	rdi, -64*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (320+2*4-16-7*40-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 64, 64, 2, rcx ;; 64 iters
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next set of sin/cos data
	loops	64, c1b			;; Test loop counter
	end_timer 14

ypass2_1280_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-11-levels
;*********************************************************************************************


; *************** radix4-pass2-1536-real macro ******************
; This macro takes 3072 real values and performs the final 11.585 levels of the FFT.
; The results are squared, and the first 11.585 levels of the inverse FFT are done.

yr4dwpn_pass2_1536_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_1536_real_1, ypass2_1536_real_2
	LOCAL	ypass2_1536_real_3, ypass2_1536_real_4
	LOCAL	ypass2_1536_real_unfft, ypass2_1536_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 384 cache lines + 2*5 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_1536_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 six_reals_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 24 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 128, 64, 2, rcx ;; 128 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 256 four_complex_djbfft operations
;;	distance between fft data elements is 128
;;	do 96 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+32*YMM_SCD2]
	loops_init_prefetch 96, 64, 1, rcx ;; 3 iters of 32
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	32, b2a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 32
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	32, b2b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 352 four_complex_djbfft operations
;;	distance between fft data elements is 32
;;	do 96 macros each processing 32 data values

	bump	rdi, 32*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 96, 64, 2, rcx ;; 3 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b3a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b3a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b3b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer
	loops	3, b3b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 376 four_complex_djbfft operations
;;	distance between fft data elements is 8
;;	do 96 macros each processing 32 data values

	loops_init_prefetch 96, 64, 2, rcx ;; 12 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 11 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	3, b4b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 192 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 48 macros each processing 64 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_1536_real_1
	jg	ypass2_1536_real_3

ypass2_1536_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 48, 64, 1, rcx, 1, 16 ;; 47 more iterations
b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	3, b5b			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
	jmp	ypass2_1536_real_unfft

ypass2_1536_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 208 cache lines
	loops_init_prefetch 48, 128, 1, rcx, 1, 16 ;; 47 more iterations
b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	3, b5a			;; Loop 3 times
	jmp	ypass2_1536_real_done

ypass2_1536_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 48, 64, 1, rcx, 1, 16 ;; 47 more iterations
b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	3, b5c			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
	jmp	ypass2_1536_real_unfft

ypass2_1536_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 48, 128, 1, rcx, 1, 16 ;; 47 more iterations
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	3, b5d			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
;;	bump	rcx, (-96+64+96+2*96+47)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 376 four_complex_djbunfft operations
;;	distance between fft data elements is 8
;;	do 96 macros processing 32 data values

ypass2_1536_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 32*YMM_SCD2+32*YMM_SCD2+128*YMM_SCD2
	loops_init_prefetch 96, 64, 2, rcx ;; 12 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 11 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	3, c4b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 352 four_complex_djbunfft operations
;;	distance between fft data elements is 32
;;	do 96 macros processing 32 data values

	bump	rcx, (384+2*5-64-96-2*48-47-48-48)*64 ;; Move prefetch pointer along
	loops_init_prefetch 96, 64, 2, rcx ;; 3 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c3a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c3a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c3b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 256 four_complex_djbunfft operations
;;	distance between fft data elements is 128
;;	do 96 macros processing 32 data values

	bump	rdi, -32*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-32*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 208 cache lines
	loops_init_prefetch 96, 64, 1, rcx ;; 3 iterations of 32
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c2a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 32
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c2b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532

;; Do 512 six_reals_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros processing 24 data values

	bump	rdi, -32*YMM_SCD2-128*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (208-96-128)*64	;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter

ypass2_1536_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-1536-complex macro ******************
; This macro takes 1536 complex values and performs the final 10.585 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 10.585 levels of the inverse FFT.

yr4dwpn_pass2_1536_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d
	LOCAL	ypass2_1536_complex_1, ypass2_1536_complex_2
	LOCAL	ypass2_1536_complex_3, ypass2_1536_complex_4
	LOCAL	ypass2_1536_complex_unfft, ypass2_1536_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 384 cache lines + 5 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_1536_complex_4

;; Do FFT levels 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 three_complex_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 24 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 96 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+128*YMM_SCD1]
	loops_init_prefetch 384, 64, 12, rcx ;; 128 iterations or 96 iterations

b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 32*64, 2*dist64, rdi
	bump	rdi, 32*YMM_SCD1	;; Next sin/cos data
	loops	2, b1b, 3		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 4*3			;; Restore loop counter

	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rbp
	loops	3, b2b, 4		;; Test loop counter
;;	bump	rsi, -3*2*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -3*2*dist64+64	;; Next source pointer
	loops	32, b1a			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD1+128*YMM_SCD1+32*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 96 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 96 macros each processing 32 data values

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 192 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 48 macros each processing 64 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 96 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 96 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_1536_complex_1
	jg	ypass2_1536_complex_3

ypass2_1536_complex_2:
	start_timer 6
	loops_init_prefetch 96, 64, 2, rcx ;; 3 iters of 128 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5b:	yr8_8cl_eight_complex_with_square rsi, 4*64, 32*64, dist64, 64
	loops	8, b5b, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3b			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	3, b3b			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_1536_complex_unfft


ypass2_1536_complex_1:
	start_timer 6
;;	bump	rcx, (384+2*5-2*32-3*96)*64 ;; Move prefetch pointer along
	loops_init_prefetch 96, 64, 1, rcx ;; 3 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3a			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 96 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5a:	yr8_8cl_eight_complex_fft_final rsi, 4*64, 32*64, dist64, 64
	loops	8, b5a, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5a			;; Loop 2 times
;;	bump	rsi, -2*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	3, b3a			;; Loop 3 times
	end_timer 6
	jmp	ypass2_1536_complex_done


ypass2_1536_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 96, 64, 2, rcx ;; 3 iters of 128 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5c:	yr8_8cl_eight_complex_with_mult rsi, 4*64, 32*64, dist64, 64
	loops	8, b5c, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3c			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	3, b3c			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_1536_complex_unfft


ypass2_1536_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 128*YMM_SCD1+32*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 96, 64, 1, rcx ;; 3 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 96 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 4*64, 32*64, dist64, 64
	loops	8, b5d, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5d			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3d			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3d			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	3, b5d			;; Loop 3 times
	bump	rsi, -3*2*dist64	;; Restore source pointer
;;	bump	rcx, (-3*96+2*32+5*48)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 96 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532

;; Do 512 three_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 24 data values

ypass2_1536_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+128*YMM_SCD1]
	bump	rcx, (384+2*5-2*32-5*48-32-64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 384, 64, 6, rcx ;; 128 iterations or 96 iterations

	loops_set_prefetch 64, 12, rcx	;; prefetch 32 cache lines in this loop
c2a:	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rbp
	loops	3, c2b, 4		;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4			;; Restore loop counter

	loops_set_prefetch 64, 6, rcx	;; prefetch 64 cache lines in this loop
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 32*64, 2*dist64, rdi
	bump	rdi, 32*YMM_SCD1	;; Next set of sin/cos data
	loops	2, c1b, 3		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	32, c2a			;; Loop 32 times
	end_timer 13

ypass2_1536_complex_done:
	ENDM


; *************** radix4-pass2-11-levels-real macro ******************
; This macro takes 4096 real values and performs the final 12 levels of the FFT.
; The results are squared, and the first 12 levels of the inverse FFT are done.

yr4dwpn_pass2_11_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_11_levels_real_1, ypass2_11_levels_real_2
	LOCAL	ypass2_11_levels_real_3, ypass2_11_levels_real_4
	LOCAL	ypass2_11_levels_real_unfft, ypass2_11_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 512 cache lines + 7 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_11_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...

;; Do 512 eight_reals_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 384 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 128 macros each processing 32 data values

	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b2b			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sin/cos ptr

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 480 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 128 macros each processing 32 data values

	loops_init_prefetch 128, 64, 1, rcx ;; 4 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b3a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b3b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 504 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 128 macros each processing 32 data values

	loops_init_prefetch 128, 64, 2, rcx ;; 16 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 15 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 255 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 64 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_11_levels_real_1
	jg	ypass2_11_levels_real_3

ypass2_11_levels_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 64, 64, 8, rcx, 1, 32 ;; 63 more iterations
b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b5b			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	jmp	ypass2_11_levels_real_unfft

ypass2_11_levels_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 272 cache lines
	loops_init_prefetch 64, 128, 1, rcx, 1, 32 ;; 63 more iterations
b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b5a			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	jmp	ypass2_11_levels_real_done

ypass2_11_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 64, 64, 8, rcx, 1, 32 ;; 63 more iterations
b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b5c			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	jmp	ypass2_11_levels_real_unfft

ypass2_11_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 64, 128, 1, rcx, 1, 32 ;; 63 more iterations
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b5d			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b5d			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
;;	bump	rcx, (-128+3*128+64+8)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 504 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 128 macros each processing 32 data values

ypass2_11_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 128*YMM_SCD3
	bump	rcx, (512+7-3*128-64-8-64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 2, rcx ;; 16 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 15 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 480 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 128 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 272 cache lines
	loops_init_prefetch 128, 64, 8, rcx ;; 4 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c3a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 3 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c3b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 384 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 128 macros each processing 32 data values

	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, c2b			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044

;; Do 512 eight_reals_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 32 data values

	bump	rdi, -128*YMM_SCD3-128*YMM_SCD3 ;; Load sin/cos pointer
	bump	rcx, (272-16-128-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter

ypass2_11_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-11-levels-complex macro ******************
; This macro takes 2048 complex values and performs the final 11 levels of a standard
; radix-4 FFT, squares the results, and does the first 11 levels of the inverse FFT.

yr4dwpn_pass2_11_levels_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d
	LOCAL	ypass2_11_levels_complex_1, ypass2_11_levels_complex_2
	LOCAL	ypass2_11_levels_complex_3, ypass2_11_levels_complex_4
	LOCAL	ypass2_11_levels_complex_unfft, ypass2_11_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 512 cache lines + 7 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_11_levels_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 32 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 128 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	mov	rbp, rdi
	loops_init_prefetch 128, 64, 2, rcx ;; 128 iterations

	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, 32*64, 2*dist64, 4*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 4

;;BUG	yr4_eb4cl_four_complex_djbfft_preload - hope these are compatible
b2b:	yr4_eb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rbp
	bump	rbp, YMM_SCD2		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
;;	bump	rsi, -4*2*dist64	;; Restore source pointer

	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b1b			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2+128*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 128 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 128 macros each processing 32 data values

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 256 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 64 macros each processing 64 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 128 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 128 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_11_levels_complex_1
	jg	ypass2_11_levels_complex_3

ypass2_11_levels_complex_2:
	start_timer 6
	loops_init_prefetch 128, 64, 2, rcx ;; 4 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 8 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b5b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5b:	yr8_8cl_eight_complex_with_square rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b5b, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b5b			;; Loop 2 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_11_levels_complex_unfft


ypass2_11_levels_complex_1:
	start_timer 6
;;	bump	rcx, (512+7-2*64-3*128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 1, rcx ;; 4 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3a			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b3a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 128 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b5a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5a:	yr8_8cl_eight_complex_fft_final rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b5a, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b5a			;; Loop 4 times
;;	bump	rsi, -4*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+32*64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	end_timer 6
	jmp	ypass2_11_levels_complex_done


ypass2_11_levels_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 128, 64, 2, rcx ;; 4 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b3c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 8 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b5c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5c:	yr8_8cl_eight_complex_with_mult rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b5c, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c3c			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_11_levels_complex_unfft


ypass2_11_levels_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 128*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 128, 64, 1, rcx ;; 4 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 128 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b5d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b5d, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b5d			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3d			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b5d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
;;	bump	rcx, (-8-3*128+4*64+8+2*64)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 128 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044

;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 32 data values

ypass2_11_levels_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	mov	rbp, rdi
	bump	rcx, (512+7-4*64-8-2*64-2*64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 2, rcx ;; 128 iterations

	yr4_eb4cl_four_complex_djbunfft_preload
c2b:	yr4_eb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rbp
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*2*dist64	;; Restore source pointer
	loops_undo 4			;; Restore loop counter

;;BUG	yr4_s4cl_four_complex_djbunfft_preload  --- hmm, hope these are preloads are compatible
c1b:	yr4_s4cl_four_complex_djbunfft rsi, 32*64, 2*dist64, 4*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next set of sin/cos data
	loops	2, c1b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	32, c2b			;; Loop 32 times
	end_timer 13

ypass2_11_levels_complex_done:
	ENDM


; *************** radix4-pass2-2560-real macro ******************
; This macro takes 5120 real values and performs the final 12.322 levels of the FFT.
; The results are squared, and the first 12.322 levels of the inverse FFT are done.

yr4dwpn_pass2_2560_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b
	LOCAL	ypass2_2560_real_1, ypass2_2560_real_2
	LOCAL	ypass2_2560_real_3, ypass2_2560_real_4
	LOCAL	ypass2_2560_real_unfft, ypass2_2560_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 640 cache lines + 2*9 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_2560_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 ten_reals_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 40 data values

	mov	rdi, sincos3		;; Ptr to sin/cos data
	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 512 four_complex_djbfft operations
;;	distance between fft data elements is 128
;;	do 160 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+32*YMM_SCD2]
	loops_init_prefetch 160, 64, 1, rcx ;; 5 iterations of 32
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	32, b2a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 32
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	32, b2b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 608 four_complex_djbfft operations
;;	distance between fft data elements is 32
;;	do 160 macros each processing 32 data values

	bump	rdi, 32*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 160, 64, 2, rcx ;; 5 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b3a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b3a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 4 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b3b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer
	loops	5, b3b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 632 four_complex_djbfft operations
;;	distance between fft data elements is 8
;;	do 160 macros each processing 32 data values

	loops_init_prefetch 160, 64, 2, rcx ;; 20 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 19 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	5, b4b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1 sixteen_reals_fft operations
;; Do 319 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 80 macros each processing 64 data values

;; Execute the proper middle step

	cmp	ffttype, 2
	jl	ypass2_2560_real_1
	jg	ypass2_2560_real_3

ypass2_2560_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 80, 64, 1, rcx, 1, 16 ;; 79 more iterations
b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	5, b5b			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
	jmp	ypass2_2560_real_unfft

ypass2_2560_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 336 cache lines
	loops_init_prefetch 80, 128, 1, rcx, 1, 16 ;; 79 more iterations
b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	5, b5a			;; Loop 5 times
	jmp	ypass2_2560_real_done

ypass2_2560_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 80, 64, 1, rcx, 1, 16 ;; 79 more iterations
b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	5, b5c			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
	jmp	ypass2_2560_real_unfft

ypass2_2560_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 80, 128, 1, rcx, 1, 16 ;; 79 more iterations
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops	16, b5d			;; Loop 16 times
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	5, b5d			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
;;	bump	rcx, (-158+128+160+2*80+79)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 632 four_complex_djbunfft operations
;;	distance between fft data elements is 8
;;	do 160 macros processing 32 data values

ypass2_2560_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 32*YMM_SCD2+32*YMM_SCD2+128*YMM_SCD4
	bump	rcx, (640+2*9-128-160-2*80-79-160)*64 ;; Move prefetch pointer along
	loops_init_prefetch 160, 64, 1, rcx ;; 20 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 19 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	5, c4b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 608 four_complex_djbunfft operations
;;	distance between fft data elements is 32
;;	do 160 macros processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 336 cache lines
	loops_init_prefetch 160, 64, 2, rcx ;; 5 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c3a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c3a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c3b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer
	loops	5, c3b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 512 four_complex_djbunfft operations
;;	distance between fft data elements is 128
;;	do 160 macros processing 32 data values

	bump	rdi, -32*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-32*YMM_SCD2]
	loops_init_prefetch 160, 64, 1, rcx ;; 5 iterations of 32
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c2a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 32
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c2b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556

;; Do 512 ten_reals_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros processing 40 data values

	bump	rdi, -32*YMM_SCD2-128*YMM_SCD4 ;; Load sin/cos ptr
	bump	rcx, (336-80-160-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 128, 64, 1, rcx ;; 128 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter

ypass2_2560_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-2560-complex macro ******************
; This macro takes 2560 complex values and performs the final 11.322 levels of a standard
; mostly radix-4 FFT, squares the results, and does the first 11.322 levels of the inverse FFT.

yr4dwpn_pass2_2560_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b5d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d
	LOCAL	ypass2_2560_complex_1, ypass2_2560_complex_2
	LOCAL	ypass2_2560_complex_3, ypass2_2560_complex_4
	LOCAL	ypass2_2560_complex_unfft, ypass2_2560_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 640 cache lines + 2*9 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_2560_complex_4

;; Do FFT levels 1,2 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 five_complex_fft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 40 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 640 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 160 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+128*YMM_SCD2]
	loops_init_prefetch 640, 64, 5, rcx ;; 128 iterations or 160 iterations

	loops_set_prefetch 64, 5, rcx	;; prefetch 128 cache lines in this loop
b1a:	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 32*64, 2*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b1b, 5		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 4*5			;; Restore loop counter

	loops_set_prefetch 64, 20, rcx	;; prefetch 32 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rbp
	loops	5, b2b, 4		;; Test loop counter
;;	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -5*2*dist64+64	;; Next source pointer
	loops	32, b1a			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2+128*YMM_SCD2+32*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 640 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 160 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 640 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 160 macros each processing 32 data values

;; Do FFT levels 9,10,11 as well as inverse FFT levels 9,10,11
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 320 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 80 macros each processing 64 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 160 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 160 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_2560_complex_1
	jg	ypass2_2560_complex_3

ypass2_2560_complex_2:
	start_timer 6
	loops_init_prefetch 160, 64, 2, rcx ;; 5 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 20 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b5b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5b:	yr8_8cl_eight_complex_with_square rsi, 4*64, 32*64, dist64, 64
	loops	8, b5b, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3b			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	5, b3b			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_2560_complex_unfft


ypass2_2560_complex_1:
	start_timer 6
;;	bump	rcx, (640+2*9-128-32-3*160)*64 ;; Move prefetch pointer along
	loops_init_prefetch 160, 64, 1, rcx ;; 5 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 160 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3a			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 160 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 160 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b5a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5a:	yr8_8cl_eight_complex_fft_final rsi, 4*64, 32*64, dist64, 64
	loops	8, b5a, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5a			;; Loop 2 times
;;	bump	rsi, -2*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	5, b3a			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_2560_complex_done


ypass2_2560_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 160, 64, 2, rcx ;; 5 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b3c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b3c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 20 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b5c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5c:	yr8_8cl_eight_complex_with_mult rsi, 4*64, 32*64, dist64, 64
	loops	8, b5c, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 80 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3c			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	5, b3c			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_2560_complex_unfft


ypass2_2560_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 128*YMM_SCD2+32*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 160, 64, 1, rcx ;; 5 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 160 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b5d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b5d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b5d:	yr8_8cl_eight_complex_with_mulf rsi, 4*64, 32*64, dist64, 64
	loops	8, b5d, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b5d			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 160 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 160 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c3d			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	loops	2, c3d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c3d			;; Loop 2 times
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -2*dist64+2*dist64	;; Next source pointer
	loops	5, b5d			;; Loop 5 times
	bump	rsi, -5*2*dist64	;; Restore source pointer
;;	bump	rcx, (-3*160+128+32+2*80+10+2*80)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 640 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 160 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	1532

;; Do 512 five_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 128 macros each processing 40 data values

ypass2_2560_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+128*YMM_SCD2]
	bump	rcx, (640+2*9-128-32-2*80-20-2*80-32-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 20, rcx ;; 128 iterations or 160 iterations

	loops_set_prefetch 64, 20, rcx	;; prefetch 32 cache lines in this loop
c2a:	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rbp
	loops	5, c2b, 4		;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5*4			;; Restore loop counter

	loops_set_prefetch 64, 5, rcx	;; prefetch 128 cache lines in this loop
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 32*64, 2*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next set of sin/cos data
	loops	2, c1b, 5		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c1b			;; Test loop counter
;;	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*32*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	32, c2a			;; Loop 32 times
	end_timer 13

ypass2_2560_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-12-levels
;*********************************************************************************************


; *************** radix4-pass2-2304-real macro ******************
; This macro takes 4608 real values and performs the final 12.17 levels of the FFT.
; The results are squared, and the first 12.17 levels of the inverse FFT are done.

yr4dwpn_pass2_2304_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_2304_real_1, ypass2_2304_real_2
	LOCAL	ypass2_2304_real_3, ypass2_2304_real_4
 	LOCAL	ypass2_2304_real_unfft, ypass2_2304_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 576 cache lines + 8 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_2304_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2304	+1	+1	+1
;;	4	...
;;	...
;;	2300
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...

;; Do 768 six_reals_fft operations
;;	distance between fft data elements is 768
;;	do 192 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 192, 64, 2, rcx ;; 192 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 3*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	3, b1b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 six_reals_fft operations
;; Do 512 three_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 24 data values

	loops_init_prefetch 192, 64, 2, rcx ;; 3 iterations of 64
	yr3_3cl_six_reals_fft_preload
b2a:	yr3_3cl_six_reals_fft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+3*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 64
	yr3_r3cl_three_complex_djbfft_preload
b2b:	yr3_r3cl_three_complex_djbfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+3*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos pointer
	loops	3, b2b			;; Test loop counter
	bump	rsi, -3*3*dist64	;; Restore source pointer
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 144 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+16*YMM_SCD2]
	loops_init_prefetch 144, 64, 2, rcx ;; 9 iters of 16
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sin/cos ptr
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*dist64		;; Restore source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 560 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 144 macros each processing 32 data values

	loops_init_prefetch 144, 64, 2, rcx ;; 9 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 8 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer
	loops	9, b4b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 572 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 144 macros each processing 32 data values

	loops_init_prefetch 144, 64, 2, rcx ;; 36 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 35 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	9, b5b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 575 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 144 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_2304_real_1
	jg	ypass2_2304_real_3

ypass2_2304_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 144, 64, 4, rcx, 1, 16 ;; 143 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b6b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer
	jmp	ypass2_2304_real_unfft

ypass2_2304_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 288 cache lines
	loops_init_prefetch 144, 128, 1, rcx, 1, 16 ;; 143 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b6a			;; Test loop counter
	jmp	ypass2_2304_real_done

ypass2_2304_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 144, 64, 4, rcx, 1, 16 ;; 143 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b6c			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer
	jmp	ypass2_2304_real_unfft

ypass2_2304_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 144, 128, 1, rcx, 1, 16 ;; 143 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b6d			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer
;;	bump	rcx, (-288+2*96+3*72+36)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 572 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 192 macros each processing 32 data values

ypass2_2304_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD2+16*YMM_SCD2+64*YMM_SCD2+192*YMM_SCD2
	loops_init_prefetch 144, 64, 2, rcx ;; 36 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 35 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	9, c5b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 560 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 144 macros each processing 32 data values

	bump	rcx, (576+8-2*96-3*72-36-72-72)*64 ;; Move prefetch pointer along
	loops_init_prefetch 144, 64, 2, rcx ;; 9 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	9, c4b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 144 macros each processing 32 data values

	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-16*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 288 cache lines
	loops_init_prefetch 144, 64, 1, rcx ;; 9 iters of 16
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	9, c3b			;; Test loop counter
	bump	rsi, -9*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...

;; Do 256 six_reals_unfft operations
;; Do 512 three_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 24 data values

	bump	rdi, -16*YMM_SCD2-64*YMM_SCD2 ;; Load sin/cos ptrs
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 64
	yr3_3cl_six_reals_unfft_preload
c2a:	yr3_3cl_six_reals_unfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+3*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 64
	yr3_r3cl_three_complex_djbunfft_preload
c2b:	yr3_r3cl_three_complex_djbunfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+3*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*3*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2304	+1	+1	+1
;;	4	...
;;	...
;;	2300

;; Do 768 six_reals_unfft operations
;;	distance between fft data elements is 768
;;	do 192 macros each processing 24 data values

	bump	rdi, -192*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (288-144-96-48)*64 ;; Move prefetch pointer along
	loops_init_prefetch 192, 64, 4, rcx ;; 192 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 3*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	3, c1b			;; Test loop counter

ypass2_2304_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-2304-complex macro ******************
; This macro takes 2304 complex values and performs the final 11.17 levels of a standard
; radix-4 FFT, squares the results, and does the first 11.17 levels of the inverse FFT.

yr4dwpn_pass2_2304_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_2304_complex_1, ypass2_2304_complex_2
	LOCAL	ypass2_2304_complex_3, ypass2_2304_complex_4
	LOCAL	ypass2_2304_complex_unfft, ypass2_2304_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 576 cache lines + 8 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_2304_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2304	+1	+1	+1
;;	4	...
;;	...
;;	2300
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...

;; Do 768 three_complex_fft operations
;;	distance between fft data elements is 768
;;	do 192 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 768 three_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+192*YMM_SCD1]
	loops_init_prefetch 192, 64, 3, rcx ;; 192 iterations
	yr3_f3cl_three_complex_djbfft_preload

b1b:	yr3_f3cl_three_complex_djbfft rsi, dist64, 3*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next sin/cos data
	loops	3, b1b			;; Test loop counter
	bump	rsi, -3*dist64		;; Restore source pointer
	bump	rdi, -3*64*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 3

b2b:	yr3_3cl_three_complex_djbfft rsi, 3*dist64, dist64, rbp
	loops	3, b2b			;; Test loop counter
	bump	rbp, YMM_SCD1		;; Next sin/cos data

	bump	rsi, -3*3*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD1+192*YMM_SCD1+64*YMM_SCD1 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 144 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 144 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 144 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 144 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 144 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 576 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 144 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 576 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 144 macros each processing 32 data values

;; Do this 64 cache lines (4KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_2304_complex_1
	jg	ypass2_2304_complex_3

ypass2_2304_complex_2:
	start_timer 6
	loops_init_prefetch 144, 64, 2, rcx ;; 9 iters of 64 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 72 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_2304_complex_unfft


ypass2_2304_complex_1:
	start_timer 6
	bump	rcx, (576+8-2*64-144-36-2*144)*64 ;; Move prefetch pointer along
	loops_init_prefetch 144, 64, 1, rcx ;; 9 iters of 64 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5a			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
	yr4_4cl_four_complex_fft_final_preload
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b3a			;; Loop 9 times
	end_timer 6
	jmp	ypass2_2304_complex_done


ypass2_2304_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 144, 64, 2, rcx ;; 9 iters of 64 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 72 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
	yr4_4cl_four_complex_with_mult_preload
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b3c			;; Loop 9 times
	bump	rsi, -9*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_2304_complex_unfft


ypass2_2304_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 192*YMM_SCD1+64*YMM_SCD1
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 144, 64, 1, rcx ;; 9 iters of 64 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
	yr4_4cl_four_complex_with_mulf_preload
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5d			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 36 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	9, b6d			;; Loop 9 times
	bump	rsi, -9*dist64		;; Restore source pointer
	bump	rcx, (-2*144-36-144+2*64+72+5*36+72)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...

;; Do 768 three_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 24 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	768	+1	+1	+1
;;	4	...
;;	...
;;	764	...
;;	1536	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2304	+1	+1	+1
;;	4	...
;;	...
;;	2300

;; Do 768 three_complex_unfft operations
;;	distance between fft data elements is 768
;;	do 192 macros each processing 24 data values

ypass2_2304_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+192*YMM_SCD1]
	bump	rcx, (576+8-2*64-72-5*36-72-2*64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 192, 64, 3, rcx ;; 192 iterations
	yr3_3cl_three_complex_djbunfft_preload

c2b:	yr3_3cl_three_complex_djbunfft rsi, 3*dist64, dist64, rbp
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*3*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD1		;; Next sine/cosine pointer
	loops_undo 3			;; Restore loop counter

c1b:	yr3_3cl_three_complex_djbunfft rsi, dist64, 3*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next set of sin/cos data
	loops	3, c1b			;; Test loop counter
;;	bump	rsi, -3*dist64		;; Restore source pointer
	bump	rdi, -3*64*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -3*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	end_timer 13

ypass2_2304_complex_done:
	ENDM


; *************** radix4-pass2-3072-real macro ******************
; This macro takes 6144 real values and performs the final 12.585 levels of the FFT.
; The results are squared, and the first 12.585 levels of the inverse FFT are done.

yr4dwpn_pass2_3072_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_3072_real_1, ypass2_3072_real_2
	LOCAL	ypass2_3072_real_3, ypass2_3072_real_4
	LOCAL	ypass2_3072_real_unfft, ypass2_3072_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 768 cache lines + 11 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_3072_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 six_reals_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 256 eight_reals_fft operations
;; Do 512 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+64*YMM_SCD2]
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 64
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 64
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 704 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 192 macros each processing 32 data values

	bump	rdi, 64*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 64
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer
	loops	3, b3b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 752 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 192 macros each processing 32 data values

	loops_init_prefetch 192, 64, 2, rcx ;; 12 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 11 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	3, b4b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 764 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 192 macros each processing 32 data values

	loops_init_prefetch 192, 64, 2, rcx ;; 48 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 47 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b5b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	3, b5b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 767 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 192 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_3072_real_1
	jg	ypass2_3072_real_3

ypass2_3072_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops_init_prefetch 192, 64, 2, rcx, 1, 64 ;; 191 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b6b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	3, b6b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer
	jmp	ypass2_3072_real_unfft

ypass2_3072_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, dist64, 2*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 416 cache lines
	loops_init_prefetch 192, 128, 1, rcx, 1, 64 ;; 191 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b6a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	3, b6a			;; Test loop counter
	jmp	ypass2_3072_real_done

ypass2_3072_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops_init_prefetch 192, 64, 2, rcx, 1, 64 ;; 191 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b6c			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	3, b6c			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer
	jmp	ypass2_3072_real_unfft

ypass2_3072_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops_init_prefetch 192, 128, 1, rcx, 1, 64 ;; 191 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b6d			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	3, b6d			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer
;;	bump	rcx, (-384+128+5*96)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 764 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 192 macros each processing 32 data values

ypass2_3072_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 64*YMM_SCD2+64*YMM_SCD2+256*YMM_SCD2
	loops_init_prefetch 192, 64, 2, rcx ;; 48 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 47 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	3, c5b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 752 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 192 macros each processing 32 data values

	bump	rcx, (768+11-128-6*96-96)*64 ;; Move prefetch pointer along
	loops_init_prefetch 192, 64, 2, rcx ;; 12 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 11 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	3, c4b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 704 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 192 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 208 cache lines
	loops_init_prefetch 192, 64, 1, rcx ;; 3 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 64
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 256 eight_reals_unfft operations
;; Do 512 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 32 data values

	bump	rdi, -64*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-64*YMM_SCD2]
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 64
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 64
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068

;; Do 1024 six_reals_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 24 data values

	bump	rdi, -64*YMM_SCD2-256*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (416-192-96-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c1b			;; Test loop counter

ypass2_3072_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-3072-complex macro ******************
; This macro takes 3072 complex values and performs the final 11.585 levels of a standard
; radix-4 FFT, squares the results, and does the first 11.585 levels of the inverse FFT.

yr4dwpn_pass2_3072_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_3072_complex_1, ypass2_3072_complex_2
	LOCAL	ypass2_3072_complex_3, ypass2_3072_complex_4
	LOCAL	ypass2_3072_complex_unfft, ypass2_3072_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 768 cache lines + 11 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_3072_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 three_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 24 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+256*YMM_SCD1]
	loops_init_prefetch 768, 64, 12, rcx ;; 256 iterations or 192 iterations

b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, dist64, 4*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next sin/cos data
	loops	4, b1b, 3		;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 4*3

	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*dist64, dist64, 2*dist64, rbp
	loops	3, b2b, 4		;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -3*4*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD1+256*YMM_SCD1+64*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 192 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 192 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 192 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 192 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 192 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 192 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 768 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 192 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_3072_complex_1
	jg	ypass2_3072_complex_3

ypass2_3072_complex_2:
	start_timer 6
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 48 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 48 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
;;	loops	64, b6b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6b:	yr4_4cl_four_complex_with_square rsi, 4*64, dist64, 2*dist64
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 48 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5b			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	3, b3b			;; Loop 3 times
	bump	rsi, -3*4*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_3072_complex_unfft


ypass2_3072_complex_1:
	start_timer 6
	bump	rcx, (768+11-2*64-3*192-96)*64 ;; Move prefetch pointer along
	loops_init_prefetch 192, 64, 1, rcx ;; 3 iters of 256 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, b3a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
;;	loops	64, b6a			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6a:	yr4_4cl_four_complex_fft_final rsi, 4*64, dist64, 2*dist64
	loops	16, b6a			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6a			;; Loop 4 times
;;	bump	rsi, -4*64		;; Restore source pointer

	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	3, b3a			;; Loop 3 times
	end_timer 6
	jmp	ypass2_3072_complex_done


ypass2_3072_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
