;;	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, dist64, 2*dist64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -4*64+4*dist64	;; Next source pointer
	loops	25, b7d			;; Loop 25 times
	bump	rsi, -25*4*dist64	;; Restore source pointer
	bump	rcx, (-2*800-3*1600+2*256+2*800+4*400+3*800)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...

;; Do 5120 five_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 1280 macros each processing 40 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116	...
;;	10240	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	25600	+1	+1	+1
;;	4	...
;;	...
;;	25596

;; Do 5120 five_complex_unfft operations
;;	distance between fft data elements is 5120
;;	do 1280 macros each processing 40 data values

ypass2_25600_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+1280*YMM_SCD2]
	bump	rcx, (6400+99-2*256-2*800-4*400-3*800-2*256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1280, 64, 5, rcx ;; 1280 iterations

	yr5_5cl_five_complex_djbunfft_preload
c2b:	yr5_5cl_five_complex_djbunfft rsi, 20*dist64, 4*dist64, rbp
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*20*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5			;; Restore loop counter

;;	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 4*dist64, 20*dist64, rdi
	bump	rdi, 256*YMM_SCD2	;; Next set of sin/cos data
	loops	5, c1b			;; Test loop counter
;;	bump	rsi, -5*4*dist64	;; Restore source pointer
	bump	rdi, -5*256*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -5*4*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2b			;; Loop 4 times
	end_timer 13

ypass2_25600_complex_done:
	ENDM

