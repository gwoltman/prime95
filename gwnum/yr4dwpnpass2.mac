	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 48 cache lines in this loop
	yr4_4cl_four_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
;;	loops	64, b6c			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6c:	yr4_4cl_four_complex_with_mult rsi, 4*64, dist64, 2*dist64
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6c			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 48 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5c			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3c			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	3, b3c			;; Loop 3 times
	bump	rsi, -3*4*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_3072_complex_unfft


ypass2_3072_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 256*YMM_SCD1+64*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 192, 64, 1, rcx ;; 3 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 96 cache lines in this loop
	yr4_4cl_four_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
;;	loops	64, b6d			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, dist64, 2*dist64
	loops	16, b6d			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6d			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5d			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	3, b6d			;; Loop 3 times
	bump	rsi, -3*4*dist64	;; Restore source pointer
	bump	rcx, (-96-3*192+2*64+2*96+3*48+2*96)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 768 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068

;; Do 1024 three_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 24 data values

ypass2_3072_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+256*YMM_SCD1]
	bump	rcx, (768+11-2*64-2*96-3*48-2*96-2*64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 768, 64, 12, rcx ;; 256 iterations or 192 iterations

c2a:	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*dist64, dist64, 2*dist64, rbp
	loops	3, c2b, 4		;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4			;; Restore loop counter

	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, dist64, 4*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next set of sin/cos data
	loops	4, c1b, 3		;; Test loop counter
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	64, c2a			;; Loop 64 times
	end_timer 13

ypass2_3072_complex_done:
	ENDM


; *************** radix4-pass2-3840-real macro ******************
; This macro takes 7680 real values and performs the final 12.907 levels of the FFT.
; The results are squared, and the first 12.907 levels of the inverse FFT are done.

yr4dwpn_pass2_3840_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_3840_real_1, ypass2_3840_real_2
	LOCAL	ypass2_3840_real_3, ypass2_3840_real_4
 	LOCAL	ypass2_3840_real_unfft, ypass2_3840_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 960 cache lines + 14 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_3840_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3840	+1	+1	+1
;;	4	...
;;	...
;;	3836
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 1280 six_reals_fft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 320, 64, 2, rcx ;; 320 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 5*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	5, b1b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 ten_reals_fft operations
;; Do 512 five_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 40 data values

	loops_init_prefetch 192, 64, 2, rcx ;; 3 iterations of 64
	yr5_5cl_ten_reals_fft_preload
b2a:	yr5_5cl_ten_reals_fft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 64
	yr5_r5cl_five_complex_djbfft_preload
b2b:	yr5_r5cl_five_complex_djbfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sin/cos pointer
	loops	3, b2b			;; Test loop counter
	bump	rsi, -3*5*dist64	;; Restore source pointer
	bump	rdi, 64*YMM_SCD4	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 896 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 240 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+16*YMM_SCD2]
	loops_init_prefetch 240, 64, 2, rcx ;; 15 iters of 16
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sin/cos ptr
	loops	15, b3b			;; Loop 15 times
	bump	rsi, -15*dist64		;; Restore source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 944 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 240 macros each processing 32 data values

	loops_init_prefetch 240, 64, 2, rcx ;; 15 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 14 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer
	loops	15, b4b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 956 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 240 macros each processing 32 data values

	loops_init_prefetch 240, 64, 2, rcx ;; 60 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 59 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	15, b5b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 959 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 240 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_3840_real_1
	jg	ypass2_3840_real_3

ypass2_3840_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 240, 64, 2, rcx, 1, 16 ;; 239 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b6b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer
	jmp	ypass2_3840_real_unfft

ypass2_3840_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 480 cache lines
	loops_init_prefetch 240, 128, 1, rcx, 1, 16 ;; 239 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b6a			;; Test loop counter
	jmp	ypass2_3840_real_done

ypass2_3840_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 240, 64, 2, rcx, 1, 16 ;; 239 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b6c			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer
	jmp	ypass2_3840_real_unfft

ypass2_3840_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 240, 128, 1, rcx, 1, 16 ;; 239 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b6d			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer
;;	bump	rcx, (-478+160+96+4*120)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 956 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 240 macros each processing 32 data values

ypass2_3840_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD2+16*YMM_SCD2+64*YMM_SCD4+320*YMM_SCD2
	loops_init_prefetch 240, 64, 2, rcx ;; 60 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 59 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	15, c5b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 944 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 240 macros each processing 32 data values

	bump	rcx, (960+14-160-96-5*120-120)*64 ;; Move prefetch pointer along
	loops_init_prefetch 240, 64, 2, rcx ;; 15 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	15, c4b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 896 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 240 macros each processing 32 data values

	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-16*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 480 cache lines
	loops_init_prefetch 240, 64, 1, rcx ;; 15 iters of 16
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	15, c3b			;; Test loop counter
	bump	rsi, -15*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 256 ten_reals_unfft operations
;; Do 512 five_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 40 data values

	bump	rdi, -16*YMM_SCD2-64*YMM_SCD4 ;; Load sin/cos ptr
	loops_init_prefetch 192, 64, 2, rcx ;; 3 iters of 64
	yr5_5cl_ten_reals_unfft_preload
c2a:	yr5_5cl_ten_reals_unfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 64
	yr5_r5cl_five_complex_djbunfft_preload
c2b:	yr5_r5cl_five_complex_djbunfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*5*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3840	+1	+1	+1
;;	4	...
;;	...
;;	3836

;; Do 1280 six_reals_unfft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 24 data values

	bump	rdi, -320*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (480-240-96-160)*64 ;; Move prefetch pointer along
	loops_init_prefetch 320, 64, 2, rcx ;; 320 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 5*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	5, c1b			;; Test loop counter

ypass2_3840_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-3840-complex macro ******************
; This macro takes 3840 complex values and performs the final 11.907 levels of a standard
; radix-4 FFT, squares the results, and does the first 11.907 levels of the inverse FFT.

yr4dwpn_pass2_3840_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_3840_complex_1, ypass2_3840_complex_2
	LOCAL	ypass2_3840_complex_3, ypass2_3840_complex_4
	LOCAL	ypass2_3840_complex_unfft, ypass2_3840_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 960 cache lines + 14 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_3840_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3840	+1	+1	+1
;;	4	...
;;	...
;;	3836
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 1280 three_complex_fft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 768 five_complex_fft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+320*YMM_SCD1]
	loops_init_prefetch 960, 64, 15, rcx ;; 320 iterations or 192 iterations

b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, dist64, 5*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next sin/cos data
	loops	5, b1b, 3		;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer
	bump	rdi, -5*64*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 5*3

	yr5_5cl_five_complex_djbfft_preload
b2b:	yr5_5cl_five_complex_djbfft rsi, 5*dist64, dist64, rbp
	loops	3, b2b, 5		;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -3*5*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD1+320*YMM_SCD1+64*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 240 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 240 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 240 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 240 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 240 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 960 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 240 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 960 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 240 macros each processing 32 data values

;; Do this 64 cache lines (4KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_3840_complex_1
	jg	ypass2_3840_complex_3

ypass2_3840_complex_2:
	start_timer 6
	loops_init_prefetch 240, 64, 2, rcx ;; 15 iters of 64 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 60 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 60 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b3b			;; Loop 15 times
	bump	rsi, -15*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_3840_complex_unfft


ypass2_3840_complex_1:
	start_timer 6
;;	bump	rcx, (960+14-2*64-3*240-120)*64 ;; Move prefetch pointer along
	loops_init_prefetch 240, 64, 1, rcx ;; 15 iters of 64 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5a			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
	yr4_4cl_four_complex_fft_final_preload
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b3a			;; Loop 15 times
	end_timer 6
	jmp	ypass2_3840_complex_done


ypass2_3840_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 240, 64, 2, rcx ;; 15 iters of 64 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 60 cache lines in this loop
	yr4_4cl_four_complex_with_mult_preload
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 60 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b3c			;; Loop 15 times
	bump	rsi, -15*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_3840_complex_unfft


ypass2_3840_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 320*YMM_SCD1+64*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 240, 64, 1, rcx ;; 15 iters of 64 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 120 cache lines in this loop
	yr4_4cl_four_complex_with_mulf_preload
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5d			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	15, b6d			;; Loop 15 times
	bump	rsi, -15*dist64		;; Restore source pointer
;;	bump	rcx, (-120-3*240+2*64+3*120+2*60+2*120)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 768 five_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 192 macros each processing 40 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3840	+1	+1	+1
;;	4	...
;;	...
;;	3836

;; Do 1280 three_complex_unfft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 24 data values

ypass2_3840_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+320*YMM_SCD1]
	bump	rcx, (960+14-2*64-3*120-2*60-2*120-2*64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 960, 64, 15, rcx ;; 192 iterations or 320 iterations

c2a:	yr5_5cl_five_complex_djbunfft_preload
c2b:	yr5_5cl_five_complex_djbunfft rsi, 5*dist64, dist64, rbp
	loops	3, c2b, 5		;; Test loop counter
	bump	rsi, -3*5*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*5			;; Restore loop counter

	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, dist64, 5*dist64, rdi
	bump	rdi, 64*YMM_SCD1	;; Next set of sin/cos data
	loops	5, c1b, 3		;; Test loop counter
;;	bump	rsi, -5*dist64		;; Restore source pointer
	bump	rdi, -5*64*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -5*dist64+64	;; Next source pointer
	loops	64, c2a			;; Loop 64 times
	end_timer 13

ypass2_3840_complex_done:
	ENDM


; *************** radix4-pass2-12-levels-real macro ******************
; This macro takes 8192 real values and performs the final 13 levels of the FFT.
; The results are squared, and the first 13 levels of the inverse FFT are done.

yr4dwpn_pass2_12_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_12_levels_real_1, ypass2_12_levels_real_2
	LOCAL	ypass2_12_levels_real_3, ypass2_12_levels_real_4
	LOCAL	ypass2_12_levels_real_unfft, ypass2_12_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1024 cache lines + 15 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092
;; On output these are swizzled to:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...

;; Do 1024 eight_reals_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, 4*dist64, 8*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...

;; Do 256 eight_reals_fft operations
;; Do 768 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 256 macros each processing 32 data values

	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*dist64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -256*YMM_SCD3	;; Restore sin/cos ptr

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 960 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 256 macros each processing 32 data values

	loops_init_prefetch 256, 64, 2, rcx ;; 4 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*dist64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -64*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 64
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 4*dist64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -64*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 1008 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 256 macros each processing 32 data values

	loops_init_prefetch 256, 64, 2, rcx ;; 16 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*dist64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 15 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 4*dist64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 1020 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 256 macros each processing 32 data values

	loops_init_prefetch 256, 64, 2, rcx ;; 64 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 4*dist64, 64, 2*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 63 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 4*dist64, 64, 2*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*64*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b5b			;; Test loop counter
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 1023 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 256 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_12_levels_real_1
	jg	ypass2_12_levels_real_3

ypass2_12_levels_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 4*dist64, 8*dist64
	loops_init_prefetch 256, 64, 16, rcx, 1, 64 ;; 255 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 4*dist64, 8*dist64
	loops	64, b6b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b6b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	jmp	ypass2_12_levels_real_unfft

ypass2_12_levels_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 4*dist64, 8*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 544 cache lines
	loops_init_prefetch 256, 128, 1, rcx, 1, 64 ;; 255 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*dist64, 8*dist64
	loops	64, b6a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b6a			;; Test loop counter
	jmp	ypass2_12_levels_real_done

ypass2_12_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 4*dist64, 8*dist64
	loops_init_prefetch 256, 64, 16, rcx, 1, 64 ;; 255 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*dist64, 8*dist64
	loops	64, b6c			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b6c			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	jmp	ypass2_12_levels_real_unfft

ypass2_12_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 4*dist64, 8*dist64
	loops_init_prefetch 256, 128, 1, rcx, 1, 64 ;; 255 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*dist64, 8*dist64
	loops	64, b6d			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b6d			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
;;	bump	rcx, (-512+5*128+16)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 1020 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 256 macros each processing 32 data values

ypass2_12_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 256*YMM_SCD3
	loops_init_prefetch 256, 64, 2, rcx ;; 64 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*dist64, 64, 2*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 63 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 4*dist64, 64, 2*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test loop counter
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 1008 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 256 macros each processing 32 data values

	bump	rcx, (1024+15-5*128-16-128-256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 1, rcx ;; 16 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*dist64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 15 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 4*dist64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 1960 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 256 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 544 cache lines
	loops_init_prefetch 256, 64, 1, rcx ;; 4 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*dist64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -64*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 3 more iters of 64
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 4*dist64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -64*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...

;; Do 256 eight_reals_unfft operations
;; Do 768 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 256 macros each processing 32 data values

	loops_init_prefetch 256, 64, 1, rcx ;; 256 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 4*dist64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092

;; Do 1024 eight_reals_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 32 data values

	bump	rdi, -256*YMM_SCD3-256*YMM_SCD3 ;; Load sin/cos pointer
	bump	rcx, (544-2*256-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 8, rcx ;; 256 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, 4*dist64, 8*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c1b			;; Test loop counter

ypass2_12_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-12-levels-complex macro ******************
; This macro takes 4096 complex values and performs the final 12 levels of a standard
; radix-4 FFT, squares the results, and does the first 12 levels of the inverse FFT.

yr4dwpn_pass2_12_levels_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_12_levels_complex_1, ypass2_12_levels_complex_2
	LOCAL	ypass2_12_levels_complex_3, ypass2_12_levels_complex_4
	LOCAL	ypass2_12_levels_complex_unfft, ypass2_12_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1024 cache lines + 15 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12_levels_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...

;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 32 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...

;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 256 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	mov	rbp, rdi
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations

	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, dist64, 4*dist64, 8*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos data
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 4

;;BUG	yr4_eb4cl_four_complex_djbfft_preload - hope these are compatible
b2b:	yr4_eb4cl_four_complex_djbfft rsi, 4*dist64, dist64, 2*dist64, rbp
	bump	rbp, YMM_SCD2		;; Next sin/cos data
	loops	4, b2b			;; Test loop counter

	bump	rsi, -4*4*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2+256*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 256 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 256 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 256 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...

;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 256 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	4	+2K	+2K	+2K
;;	8	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 256 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	16	+2K	+2K	+2K
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 256 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	64	+2K	+2K	+2K
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;;
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 256 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_12_levels_complex_1
	jg	ypass2_12_levels_complex_3

ypass2_12_levels_complex_2:
	start_timer 6
	loops_init_prefetch 256, 64, 2, rcx ;; 4 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 16 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 4*dist64, 8*dist64
	loops	64, b6b			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5b			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_12_levels_complex_unfft


ypass2_12_levels_complex_1:
	start_timer 6
	bump	rcx, (1024+15-2*128-3*256-16)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 1, rcx ;; 4 iters of 256 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b3a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 16 cache lines in this loop
	yr4_4cl_four_complex_fft_final_preload
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 4*dist64, 8*dist64
	loops	64, b6a			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer

	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b3a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_12_levels_complex_done


ypass2_12_levels_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 256, 64, 2, rcx ;; 4 iters of 256 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, b3c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 16 cache lines in this loop
	yr4_4cl_four_complex_with_mult_preload
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 4*dist64, 8*dist64
	loops	64, b6c			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5c			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 64 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c3c			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64	;; Next source pointer
	loops	4, b3c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_12_levels_complex_unfft


ypass2_12_levels_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 256*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 256, 64, 1, rcx ;; 4 iters of 256 cache lines

	loops_set_prefetch 64, 16, rcx	;; prefetch 16 cache lines in this loop
	yr4_4cl_four_complex_with_mulf_preload
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 4*dist64, 8*dist64
	loops	64, b6d			;; Loop 64 times
	bump	rsi, -64*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5d			;; Loop 16 times
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*4*dist64	;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*4*dist64+dist64	;; Next source pointer
	loops	4, b6d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rcx, (-16-3*256+3*128+2*64+16+2*64+128)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	256	+2K	+2K	+2K
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...

;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 256 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092

;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 32 data values

ypass2_12_levels_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	mov	rbp, rdi
	bump	rcx, (1024+15-3*128-2*64-16-2*64-128-2*128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations

	yr4_eb4cl_four_complex_djbunfft_preload
c2b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*dist64, dist64, 2*dist64, rbp
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*4*dist64	;; Restore source pointer
	loops_undo 4			;; Restore loop counter

;;BUG	yr4_s4cl_four_complex_djbunfft_preload  --- hmm, hope these are preloads are compatible
c1b:	yr4_s4cl_four_complex_djbunfft rsi, dist64, 4*dist64, 8*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next set of sin/cos data
	loops	4, c1b			;; Test loop counter
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	end_timer 13

ypass2_12_levels_complex_done:
	ENDM


; *************** radix4-pass2-5120-real macro ******************
; This macro takes 10240 real values and performs the final 13.322 levels of the FFT.
; The results are squared, and the first 13.322 levels of the inverse FFT are done.

yr4dwpn_pass2_5120_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_5120_real_1, ypass2_5120_real_2
	LOCAL	ypass2_5120_real_3, ypass2_5120_real_4
	LOCAL	ypass2_5120_real_unfft, ypass2_5120_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1280 cache lines + 19 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_5120_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5016
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 ten_reals_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 40 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 256, 64, 2, rcx ;; 256 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 256 eight_reals_fft operations
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+64*YMM_SCD2]
	loops_init_prefetch 320, 64, 2, rcx ;; 5 iters of 64
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 64
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 1216 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 320 macros each processing 32 data values

	bump	rdi, 64*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 320, 64, 2, rcx ;; 5 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 4 more iters of 64
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer
	loops	5, b3b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 1264 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 320 macros each processing 32 data values

	loops_init_prefetch 320, 64, 2, rcx ;; 20 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 19 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	5, b4b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 1276 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 320 macros each processing 32 data values

	loops_init_prefetch 320, 64, 2, rcx ;; 80 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 79 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b5b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	5, b5b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 1279 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 320 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_5120_real_1
	jg	ypass2_5120_real_3

ypass2_5120_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops_init_prefetch 320, 64, 4, rcx, 1, 64 ;; 319 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b6b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	5, b6b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer
	jmp	ypass2_5120_real_unfft

ypass2_5120_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, dist64, 2*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 672 cache lines
	loops_init_prefetch 320, 128, 1, rcx, 1, 64 ;; 319 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b6a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	5, b6a			;; Test loop counter
	jmp	ypass2_5120_real_done

ypass2_5120_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops_init_prefetch 320, 64, 4, rcx, 1, 64 ;; 319 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b6c			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	5, b6c			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer
	jmp	ypass2_5120_real_unfft

ypass2_5120_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops_init_prefetch 320, 128, 1, rcx, 1, 64 ;; 319 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b6d			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	5, b6d			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer
;;	bump	rcx, (-638+128+4*160+80)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 1276 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 320 macros each processing 32 data values

ypass2_5120_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 64*YMM_SCD2+64*YMM_SCD2+256*YMM_SCD4
	loops_init_prefetch 320, 64, 2, rcx ;; 80 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 79 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c5b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	5, c5b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 1264 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 320 macros each processing 32 data values

	bump	rcx, (1280+19-128-4*160-80-160-320)*64 ;; Move prefetch pointer along
	loops_init_prefetch 320, 64, 1, rcx ;; 20 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 19 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	5, c4b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 1216 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 320 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 672 cache lines
	loops_init_prefetch 320, 64, 1, rcx ;; 5 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 64
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	5, c3b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 256 eight_reals_unfft operations
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 32 data values

	bump	rdi, -64*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-64*YMM_SCD2]
	loops_init_prefetch 320, 64, 1, rcx ;; 5 iters of 64
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 64
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116

;; Do 1024 ten_reals_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 40 data values

	bump	rdi, -64*YMM_SCD2-256*YMM_SCD4 ;; Load sin/cos ptr
	bump	rcx, (672-2*320-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 256, 64, 8, rcx ;; 256 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c1b			;; Test loop counter

ypass2_5120_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-5120-complex macro ******************
; This macro takes 5120 complex values and performs the final 12.322 levels of a standard
; radix-4 FFT, squares the results, and does the first 12.322 levels of the inverse FFT.

yr4dwpn_pass2_5120_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_5120_complex_1, ypass2_5120_complex_2
	LOCAL	ypass2_5120_complex_3, ypass2_5120_complex_4
	LOCAL	ypass2_5120_complex_unfft, ypass2_5120_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1280 cache lines + 19 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_5120_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 five_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 40 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+256*YMM_SCD2]
	loops_init_prefetch 1280, 64, 20, rcx ;; 256 iterations or 320 iterations

	loops_set_prefetch 64, 20, rcx	;; prefetch 64 cache lines in this loop
b1a:	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, dist64, 4*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos data
	loops	4, b1b, 5		;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 4*5

	loops_set_prefetch 64, 40, rcx	;; prefetch 32 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 4*dist64, dist64, 2*dist64, rbp
	loops	5, b2b, 4		;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -5*4*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2+256*YMM_SCD2+64*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 320 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 320 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 320 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 320 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 320 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 320 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1280 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 320 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_5120_complex_1
	jg	ypass2_5120_complex_3

ypass2_5120_complex_2:
	start_timer 6
	loops_init_prefetch 320, 64, 2, rcx ;; 5 iters of 256 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b3b:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5b			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	yr4_4cl_four_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
;;	loops	64, b6b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6b:	yr4_4cl_four_complex_with_square rsi, 4*64, dist64, 2*dist64
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5b			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3b			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	5, b3b			;; Loop 5 times
	bump	rsi, -5*4*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_5120_complex_unfft


ypass2_5120_complex_1:
	start_timer 6
	bump	rcx, (1280+19-64-32-4*320)*64 ;; Move prefetch pointer along
	loops_init_prefetch 320, 64, 1, rcx ;; 5 iters of 256 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b3a:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, b3a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5a			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	yr4_4cl_four_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
;;	loops	64, b6a			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6a:	yr4_4cl_four_complex_fft_final rsi, 4*64, dist64, 2*dist64
	loops	16, b6a			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6a			;; Loop 4 times
;;	bump	rsi, -4*64		;; Restore source pointer

	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	5, b3a			;; Loop 5 times
	end_timer 6
	jmp	ypass2_5120_complex_done


ypass2_5120_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 320, 64, 2, rcx ;; 5 iters of 256 cache lines

	yr4_b4cl_four_complex_djbfft_preload
b3c:	yr4_b4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, b3c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b5c			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	yr4_4cl_four_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
;;	loops	64, b6c			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6c:	yr4_4cl_four_complex_with_mult rsi, 4*64, dist64, 2*dist64
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6c			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5c			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3c			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	5, b3c			;; Loop 5 times
	bump	rsi, -5*4*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_5120_complex_unfft


ypass2_5120_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 256*YMM_SCD2+64*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 320, 64, 1, rcx ;; 5 iters of 256 cache lines

	yr4_4cl_four_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
;;	loops	64, b6d			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b6d:	yr4_4cl_four_complex_with_mulf rsi, 4*64, dist64, 2*dist64
	loops	16, b6d			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b6d			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c5d			;; Loop 16 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Restore loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

;;	yr4_b4cl_four_complex_djbunfft_preload
c3d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*dist64+4*dist64	;; Next source pointer
	loops	5, b6d			;; Loop 5 times
	bump	rsi, -5*4*dist64	;; Restore source pointer
	bump	rcx, (-4*320+64+32+7*160)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	252	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1280 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	5120	+1	+1	+1
;;	4	...
;;	...
;;	5116

;; Do 1024 five_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 256 macros each processing 40 data values

ypass2_5120_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+256*YMM_SCD2]
	bump	rcx, (1280+19-64-32-7*160-64-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1280, 64, 20, rcx ;; 256 iterations or 320 iterations

	loops_set_prefetch 64, 20, rcx	;; prefetch 64 cache lines in this loop
c2a:	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 4*dist64, dist64, 2*dist64, rbp
	loops	5, c2b, 4		;; Test loop counter
	bump	rsi, -5*4*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5*4			;; Restore loop counter

	loops_set_prefetch 64, 40, rcx	;; prefetch 32 cache lines in this loop
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, dist64, 4*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next set of sin/cos data
	loops	4, c1b, 5		;; Test loop counter
;;	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*64*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	64, c2a			;; Loop 64 times
	end_timer 13

ypass2_5120_complex_done:
	ENDM


; *************** radix4-pass2-6400-real macro ******************
; This macro takes 12800 real values and performs the final 13.644 levels of the FFT.
; The results are squared, and the first 13.644 levels of the inverse FFT are done.

yr4dwpn_pass2_6400_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_6400_real_1, ypass2_6400_real_2
	LOCAL	ypass2_6400_real_3, ypass2_6400_real_4
 	LOCAL	ypass2_6400_real_unfft, ypass2_6400_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1600 cache lines + 24 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6400_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6400	+1	+1	+1
;;	4	...
;;	...
;;	6396
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 1280 ten_reals_fft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 40 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 320, 64, 2, rcx ;; 320 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 5*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	5, b1b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 256 ten_reals_fft operations
;; Do 512 five_complex_fft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 40 data values

	loops_init_prefetch 320, 64, 4, rcx ;; 5 iterations of 64
	yr5_5cl_ten_reals_fft_preload
b2a:	yr5_5cl_ten_reals_fft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sin/cos pointer

	loops_reset			;; 4 more iters of 64
	yr5_r5cl_five_complex_djbfft_preload
b2b:	yr5_r5cl_five_complex_djbfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sin/cos pointer
	loops	5, b2b			;; Test loop counter
	bump	rsi, -5*5*dist64	;; Restore source pointer
	bump	rdi, 64*YMM_SCD4	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 400 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+16*YMM_SCD2]
	loops_init_prefetch 400, 64, 2, rcx ;; 25 iters of 16
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	16, b3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 16
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	16, b3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sin/cos ptr
	loops	25, b3b			;; Loop 25 times
	bump	rsi, -25*dist64		;; Restore source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 1584 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 400 macros each processing 32 data values

	loops_init_prefetch 400, 64, 2, rcx ;; 25 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 24 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sin/cos pointer
	loops	25, b4b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 1596 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 400 macros each processing 32 data values

	loops_init_prefetch 400, 64, 2, rcx ;; 100 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 99 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	25, b5b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 1659 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 400 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_6400_real_1
	jg	ypass2_6400_real_3

ypass2_6400_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, 16*64, 32*64
	loops_init_prefetch 400, 64, 2, rcx, 1, 16 ;; 399 more iterations
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b6b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer
	jmp	ypass2_6400_real_unfft

ypass2_6400_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, 16*64, 32*64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 800 cache lines
	loops_init_prefetch 400, 128, 1, rcx, 1, 16 ;; 399 more iterations
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b6a			;; Test loop counter
	jmp	ypass2_6400_real_done

ypass2_6400_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops_init_prefetch 400, 64, 2, rcx, 1, 16 ;; 399 more iterations
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b6c			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer
	jmp	ypass2_6400_real_unfft

ypass2_6400_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops_init_prefetch 400, 128, 1, rcx, 1, 16 ;; 399 more iterations
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b6d			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer
;;	bump	rcx, (-798+160+80+4*200)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 1596 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 400 macros each processing 32 data values

ypass2_6400_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 16*YMM_SCD2+16*YMM_SCD2+64*YMM_SCD4+320*YMM_SCD4
	loops_init_prefetch 400, 64, 2, rcx ;; 100 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 99 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 64, 2*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*16*64+4*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*4*64+dist64	;; Next source pointer
	loops	25, c5b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 1584 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 400 macros each processing 32 data values

	bump	rcx, (1600+24-160-80-5*200-400)*64 ;; Move prefetch pointer along
	loops_init_prefetch 400, 64, 1, rcx ;; 25 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 16*64, 4*64, 8*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*16*64+64	;; Next source pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	25, c4b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 400 macros each processing 32 data values

	bump	rdi, -16*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-16*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 800 cache lines
	loops_init_prefetch 400, 64, 1, rcx ;; 25 iters of 16
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 16*64, 32*64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3a			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 16
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Test loop counter
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	25, c3b			;; Test loop counter
	bump	rsi, -25*dist64		;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 256 ten_reals_unfft operations
;; Do 512 five_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 40 data values

	bump	rdi, -16*YMM_SCD2-64*YMM_SCD4 ;; Load sin/cos ptrs
	loops_init_prefetch 320, 64, 1, rcx ;; 5 iters of 64
	yr5_5cl_ten_reals_unfft_preload
c2a:	yr5_5cl_ten_reals_unfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 64
	yr5_r5cl_five_complex_djbunfft_preload
c2b:	yr5_r5cl_five_complex_djbunfft rsi, 64, dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+5*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD4	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*5*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6400	+1	+1	+1
;;	4	...
;;	...
;;	6396

;; Do 1280 ten_reals_unfft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 40 data values

	bump	rdi, -320*YMM_SCD4	;; Load sin/cos ptr
	bump	rcx, (800-400-320-80)*64 ;; Move prefetch pointer along
	loops_init_prefetch 320, 64, 4, rcx ;; 320 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 5*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	5, c1b			;; Test loop counter

ypass2_6400_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-6400-complex macro ******************
; This macro takes 6400 complex values and performs the final 12.644 levels of a standard
; radix-4 FFT, squares the results, and does the first 12.644 levels of the inverse FFT.

yr4dwpn_pass2_6400_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_6400_complex_1, ypass2_6400_complex_2
	LOCAL	ypass2_6400_complex_3, ypass2_6400_complex_4
	LOCAL	ypass2_6400_complex_unfft, ypass2_6400_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1600 cache lines + 24 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6400_complex_4

;; Do FFT level 1,2 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6400	+1	+1	+1
;;	4	...
;;	...
;;	6396
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 1280 five_complex_fft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 40 data values

;; Do FFT levels 3,4 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 1280 five_complex_fft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+320*YMM_SCD2]
	loops_init_prefetch 320, 64, 5, rcx ;; 320 iterations

	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, dist64, 5*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos data
	loops	5, b1b			;; Test loop counter
	bump	rsi, -5*dist64		;; Restore source pointer
	bump	rdi, -5*64*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 5

;;	yr5_5cl_five_complex_djbfft_preload
b2b:	yr5_5cl_five_complex_djbfft rsi, 5*dist64, dist64, rbp
	loops	5, b2b			;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -5*5*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64		;; Restore source pointer
	bump	rdi, -64*YMM_SCD2+320*YMM_SCD2+64*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 400 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 400 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 400 macros each processing 32 data values

;; Do FFT levels 11,12 as well as inverse FFT levels 11,12
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 400 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	4	+128	+128	+128
;;	8	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 400 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	16	+128	+128	+128
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...

;; Do 1600 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 400 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+128	+128	+128	64	+128	+128	+128
;;	4	...
;;	...
;;	60	...
;;	1	...
;;	...
;;	512	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...

;; Do 1600 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 400 macros each processing 32 data values

;; Do this 64 cache lines (4KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_6400_complex_1
	jg	ypass2_6400_complex_3

ypass2_6400_complex_2:
	start_timer 6
	loops_init_prefetch 400, 64, 2, rcx ;; 25 iters of 64 cache lines

	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	yr4_4cl_four_complex_with_square_preload
b6b:	yr4_4cl_four_complex_with_square rsi, 64, 16*64, 32*64
	loops	16, b6b			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5b			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b3b			;; Loop 25 times
	bump	rsi, -25*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_6400_complex_unfft


ypass2_6400_complex_1:
	start_timer 6
	bump	rcx, (1600+24-2*64-4*400)*64 ;; Move prefetch pointer along
	loops_init_prefetch 400, 64, 1, rcx ;; 25 iters of 64 cache lines

	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3a			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5a			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	yr4_4cl_four_complex_fft_final_preload
b6a:	yr4_4cl_four_complex_fft_final rsi, 64, 16*64, 32*64
	loops	16, b6a			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b3a			;; Loop 25 times
	end_timer 6
	jmp	ypass2_6400_complex_done


ypass2_6400_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 400, 64, 2, rcx ;; 25 iters of 64 cache lines

	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 16			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	4, b5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

	yr4_4cl_four_complex_with_mult_preload
b6c:	yr4_4cl_four_complex_with_mult rsi, 64, 16*64, 32*64
	loops	16, b6c			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5c			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Restore loop counter

;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4c			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3c			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b3c			;; Loop 25 times
	bump	rsi, -25*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_6400_complex_unfft


ypass2_6400_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 320*YMM_SCD2+64*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 400, 64, 1, rcx ;; 25 iters of 64 cache lines

	yr4_4cl_four_complex_with_mulf_preload
b6d:	yr4_4cl_four_complex_with_mulf rsi, 64, 16*64, 32*64
	loops	16, b6d			;; Loop 16 times
	bump	rsi, -16*64		;; Restore source pointer
	loops_undo 16			;; Back up loop counter

	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	4, c5d			;; Loop 4 times
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -16*4*64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*16*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4			;; Back up loop counter

;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
;;	bump	rsi, -16*64		;; Restore source pointer
	bump	rdi, -16*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -16*64+dist64	;; Next source pointer
	loops	25, b6d			;; Loop 25 times
	bump	rsi, -25*dist64		;; Restore source pointer
	bump	rcx, (-4*400+2*64+7*200)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	256	+1	+1	+1
;;	4	...
;;	...
;;	252	...
;;	512	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...

;; Do 1280 five_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 320 macros each processing 40 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1280	+1	+1	+1
;;	4	...
;;	...
;;	1276	...
;;	2560	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6400	+1	+1	+1
;;	4	...
;;	...
;;	6396

;; Do 1280 five_complex_unfft operations
;;	distance between fft data elements is 1280
;;	do 320 macros each processing 40 data values

ypass2_6400_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+320*YMM_SCD2]
	bump	rcx, (1600+24-2*64-7*200-64-32)*64 ;; Move prefetch pointer along
	loops_init_prefetch 320, 64, 5, rcx ;; 320 iterations

	loops_set_prefetch 64, 5, rcx	;; prefetch 64 cache lines in this loop
	yr5_5cl_five_complex_djbunfft_preload
c2b:	yr5_5cl_five_complex_djbunfft rsi, 5*dist64, dist64, rbp
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*5*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5			;; Restore loop counter

	loops_set_prefetch 64, 10, rcx	;; prefetch 32 cache lines in this loop
;;	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, dist64, 5*dist64, rdi
	bump	rdi, 64*YMM_SCD2	;; Next set of sin/cos data
	loops	5, c1b			;; Test loop counter
;;	bump	rsi, -5*dist64		;; Restore source pointer
	bump	rdi, -5*64*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -5*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	end_timer 13

ypass2_6400_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-13-levels
;*********************************************************************************************


; *************** radix4-pass2-4608-real macro ******************
; This macro takes 9216 real values and performs the final 13.17 levels of the FFT.
; The results are squared, and the first 13.17 levels of the inverse FFT are done.

yr4dwpn_pass2_4608_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_4608_real_1, ypass2_4608_real_2
	LOCAL	ypass2_4608_real_3, ypass2_4608_real_4
	LOCAL	ypass2_4608_real_unfft, ypass2_4608_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1152 cache lines + 2*17 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_4608_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4608	+1	+1	+1
;;	4	...
;;	...
;;	4604
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...

;; Do 1536 six_reals_fft operations
;;	distance between fft data elements is 1536
;;	do 384 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 384, 64, 4, rcx ;; 384 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 6*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	6, b1b			;; Test loop counter
	bump	rsi, -6*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 six_reals_fft operations
;; Do 1024 three_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 24 data values

	loops_init_prefetch 384, 64, 4, rcx ;; 3 iters of 128
	yr3_3cl_six_reals_fft_preload
b2a:	yr3_3cl_six_reals_fft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2a			;; Test loop counter
	bump	rsi, -2*dist64+6*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr3_r3cl_three_complex_djbfft_preload
b2b:	yr3_r3cl_three_complex_djbfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+6*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*6*dist64	;; Restore source pointer
	bump	rdi, 128*YMM_SCD2	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 288 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+32*YMM_SCD2]
	loops_init_prefetch 288, 64, 2, rcx ;; 9 iterations of 32
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 32
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sin/cos ptr
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*2*dist64	;; Restore source pointer
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 1120 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 288 macros each processing 32 data values

	loops_init_prefetch 288, 64, 2, rcx ;; 9 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 8 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer
	loops	9, b4b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 1144 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 288 macros each processing 32 data values

	loops_init_prefetch 288, 64, 2, rcx ;; 36 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 35 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	9, b5b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 575 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 144 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_4608_real_1
	jg	ypass2_4608_real_3

ypass2_4608_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 144, 64, 1, rcx, 1, 16 ;; 143 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	9, b6b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer
	jmp	ypass2_4608_real_unfft

ypass2_4608_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 576 cache lines
	loops_init_prefetch 144, 128, 1, rcx, 1, 16 ;; 143 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	9, b6a			;; Test loop counter
	jmp	ypass2_4608_real_done

ypass2_4608_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 144, 64, 1, rcx, 1, 16 ;; 143 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	9, b6c			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer
	jmp	ypass2_4608_real_unfft

ypass2_4608_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 144, 128, 1, rcx, 1, 16 ;; 143 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	9, b6d			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer
;;	bump	rcx, (-288+2*96+3*144+143)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 1144 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 288 macros each processing 32 data values

ypass2_4608_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 32*YMM_SCD2+32*YMM_SCD2+128*YMM_SCD2+384*YMM_SCD2
	loops_init_prefetch 288, 64, 2, rcx ;; 36 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 35 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	9, c5b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 1120 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 288 macros each processing 32 data values

	loops_init_prefetch 288, 64, 2, rcx ;; 9 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer
	loops	9, c4b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 288 macros each processing 32 data values

	bump	rdi, -32*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-32*YMM_SCD2]
	bump	rcx, (1152+2*17-2*96-3*144-143-2*144-144)*64 ;; Move prefetch pointer along
	loops_init_prefetch 288, 64, 2, rcx ;; 9 iters of 32
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 32
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	9, c3b			;; Test loop counter
	bump	rsi, -9*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...

;; Do 512 six_reals_unfft operations
;; Do 1024 three_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 24 data values

	bump	rdi, -32*YMM_SCD2-128*YMM_SCD2 ;; Load sin/cos ptrs
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 576 cache lines
	loops_init_prefetch 384, 64, 1, rcx ;; 3 iters of 128
	yr3_3cl_six_reals_unfft_preload
c2a:	yr3_3cl_six_reals_unfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Test loop counter
	bump	rsi, -2*dist64+6*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr3_r3cl_three_complex_djbunfft_preload
c2b:	yr3_r3cl_three_complex_djbunfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+6*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*6*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4608	+1	+1	+1
;;	4	...
;;	...
;;	4604

;; Do 1536 six_reals_unfft operations
;;	distance between fft data elements is 1536
;;	do 384 macros each processing 24 data values

	bump	rdi, -384*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (576-192-384)*64	;; Move prefetch pointer along
	loops_init_prefetch 384, 64, 2, rcx ;; 384 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 6*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	6, c1b			;; Test loop counter

ypass2_4608_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-4608-complex macro ******************
; This macro takes 4608 complex values and performs the final 12.17 levels of a standard
; radix-4 FFT, squares the results, and does the first 12.17 levels of the inverse FFT.

yr4dwpn_pass2_4608_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_4608_complex_1, ypass2_4608_complex_2
	LOCAL	ypass2_4608_complex_3, ypass2_4608_complex_4
	LOCAL	ypass2_4608_complex_unfft, ypass2_4608_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1152 cache lines + 2*17 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_4608_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4608	+1	+1	+1
;;	4	...
;;	...
;;	4604
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...

;; Do 1536 three_complex_fft operations
;;	distance between fft data elements is 1536
;;	do 384 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 1536 three_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+384*YMM_SCD1]
	loops_init_prefetch 384, 64, 3, rcx ;; 384 iterations
	yr3_f3cl_three_complex_djbfft_preload

b1b:	yr3_f3cl_three_complex_djbfft rsi, 2*dist64, 6*dist64, rdi
	bump	rdi, 128*YMM_SCD1	;; Next sin/cos data
	loops	3, b1b			;; Test loop counter
	bump	rsi, -3*2*dist64	;; Restore source pointer
	bump	rdi, -3*128*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 3			;; Back up loop counter

b2b:	yr3_3cl_three_complex_djbfft rsi, 6*dist64, 2*dist64, rbp
	loops	3, b2b			;; Test loop counter
	bump	rbp, YMM_SCD1		;; Next sin/cos data

	bump	rsi, -3*6*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -128*YMM_SCD1+384*YMM_SCD1+128*YMM_SCD1 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1152 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 288 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1152 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 288 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1152 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 288 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 576 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 144 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1152 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 288 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1152 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 288 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 1152 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 288 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_4608_complex_1
	jg	ypass2_4608_complex_3

ypass2_4608_complex_2:
	start_timer 6
	loops_init_prefetch 288, 64, 2, rcx ;; 9 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3b			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 36 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6b:	yr8_8cl_eight_complex_with_square rsi, 4*64, 32*64, dist64, 64
	loops	8, b6b, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6b			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_4608_complex_unfft


ypass2_4608_complex_1:
	start_timer 6
	bump	rcx, (1152+2*17-2*128-3*288-144)*64 ;; Move prefetch pointer along
	loops_init_prefetch 288, 64, 1, rcx ;; 9 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3a			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6a:	yr8_8cl_eight_complex_fft_final rsi, 4*64, 32*64, dist64, 64
	loops	8, b6a, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6a			;; Loop 2 times
;;	bump	rsi, -2*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	9, b3a			;; Loop 9 times
	end_timer 6
	jmp	ypass2_4608_complex_done


ypass2_4608_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 288, 64, 2, rcx ;; 9 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3c			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 36 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6c:	yr8_8cl_eight_complex_with_mult rsi, 4*64, 32*64, dist64, 64
	loops	8, b6c, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6c			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 72 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3c			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	9, b3c			;; Loop 9 times
	bump	rsi, -9*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_4608_complex_unfft


ypass2_4608_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 384*YMM_SCD1+128*YMM_SCD1
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 288, 64, 1, rcx ;; 9 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 144 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 4*64, 32*64, dist64, 64
	loops	8, b6d, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3d			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	9, b6d			;; Loop 9 times
	bump	rsi, -9*2*dist64	;; Restore source pointer
	bump	rcx, (-144-3*288+2*128+144+2*72+36+72+2*144)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...

;; Do 1536 three_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 24 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1536	+1	+1	+1
;;	4	...
;;	...
;;	1532	...
;;	3072	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4608	+1	+1	+1
;;	4	...
;;	...
;;	4604

;; Do 1536 three_complex_unfft operations
;;	distance between fft data elements is 1536
;;	do 384 macros each processing 24 data values

ypass2_4608_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+384*YMM_SCD1]
	bump	rcx, (1152+2*17-2*128-144-2*72-36-72-2*144-2*128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 384, 64, 3, rcx ;; 384 iterations
	yr3_3cl_three_complex_djbunfft_preload

c2b:	yr3_3cl_three_complex_djbunfft rsi, 6*dist64, 2*dist64, rbp
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*6*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD1		;; Next sine/cosine pointer
	loops_undo 3			;; Restore loop counter

c1b:	yr3_3cl_three_complex_djbunfft rsi, 2*dist64, 6*dist64, rdi
	bump	rdi, 128*YMM_SCD1	;; Next set of sin/cos data
	loops	3, c1b			;; Test loop counter
;;	bump	rsi, -3*2*dist64		;; Restore source pointer
	bump	rdi, -3*128*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -3*2*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Loop 2 times
	end_timer 13

ypass2_4608_complex_done:
	ENDM


; *************** radix4-pass2-6144-real macro ******************
; This macro takes 12288 real values and performs the final 13.585 levels of the FFT.
; The results are squared, and the first 13.585 levels of the inverse FFT are done.

yr4dwpn_pass2_6144_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_6144_real_1, ypass2_6144_real_2
	LOCAL	ypass2_6144_real_3, ypass2_6144_real_4
	LOCAL	ypass2_6144_real_unfft, ypass2_6144_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1536 cache lines + 23 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6144_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6144	+1	+1	+1
;;	4	...
;;	...
;;	6140
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 2048 six_reals_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 8*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 512 eight_reals_fft operations
;; Do 1024 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+128*YMM_SCD2]
	loops_init_prefetch 384, 64, 2, rcx ;; 3 iterations of 128
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 2*dist64, 4*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 1408 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 384 macros each processing 32 data values

	bump	rdi, 128*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 384, 64, 2, rcx ;; 3 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 2 more iters of 128
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sin/cos pointer
	loops	3, b3b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 1504 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 384 macros each processing 32 data values

	loops_init_prefetch 384, 64, 2, rcx ;; 12 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 11 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b4b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 1528 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 384 macros each processing 32 data values

	loops_init_prefetch 384, 64, 2, rcx ;; 48 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 47 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b5b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 767 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 192 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_6144_real_1
	jg	ypass2_6144_real_3

ypass2_6144_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 192, 64, 1, rcx, 1, 32 ;; 191 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6b			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b6b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer
	jmp	ypass2_6144_real_unfft

ypass2_6144_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 784 cache lines
	loops_init_prefetch 192, 128, 1, rcx, 1, 32 ;; 191 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6a			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b6a			;; Test loop counter
	jmp	ypass2_6144_real_done

ypass2_6144_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 192, 64, 1, rcx, 1, 32 ;; 191 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6c			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6c			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b6c			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer
	jmp	ypass2_6144_real_unfft

ypass2_6144_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 192, 128, 1, rcx, 1, 32 ;; 191 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6d			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6d			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b6d			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer
;;	bump	rcx, (-384+256+4*192+191)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 1528 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 384 macros each processing 32 data values

ypass2_6144_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 128*YMM_SCD2+128*YMM_SCD2+512*YMM_SCD2
	loops_init_prefetch 384, 64, 2, rcx ;; 48 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 47 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	8, c5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, c5b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 1504 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 384 macros each processing 32 data values

	bump	rcx, (1536+23-256-4*192-191-192-192)*64 ;; Move prefetch pointer along
	loops_init_prefetch 384, 64, 2, rcx ;; 12 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 11 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, c4b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 1408 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 384 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 784 cache lines
	loops_init_prefetch 384, 64, 2, rcx ;; 3 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sine/cosine pointer
	loops	3, c3b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 512 eight_reals_unfft operations
;; Do 1024 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 32 data values

	bump	rdi, -128*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-128*YMM_SCD2]
	loops_init_prefetch 384, 64, 1, rcx ;; 3 iterations of 128
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 2*dist64, 4*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6144	+1	+1	+1
;;	4	...
;;	...
;;	6140

;; Do 2048 six_reals_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 24 data values

	bump	rdi, -128*YMM_SCD2-512*YMM_SCD2 ;; Load sin/cos ptr
	bump	rcx, (784-192-384-256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 8*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter

ypass2_6144_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-6144-complex macro ******************
; This macro takes 6144 complex values and performs the final 12.585 levels of a standard
; radix-4 FFT, squares the results, and does the first 12.585 levels of the inverse FFT.

yr4dwpn_pass2_6144_complex MACRO
	LOCAL	b1a, b1b, b2b, b3b, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3a, c3b, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_6144_complex_1, ypass2_6144_complex_2
	LOCAL	ypass2_6144_complex_3, ypass2_6144_complex_4
	LOCAL	ypass2_6144_complex_unfft, ypass2_6144_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1536 cache lines + 23 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_6144_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6144	+1	+1	+1
;;	4	...
;;	...
;;	6140
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 2048 three_complex_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 24 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 32 data values

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 384 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+512*YMM_SCD1]
	mov	rdx, rbp
	loops_init_prefetch 1536, 64, 12, rcx ;; 512 iterations or 384 iterations

	loops_set_prefetch 64, 12, rcx	;; prefetch 128 cache lines in this loop
b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 32*64, 8*dist64, rdi
	bump	rdi, 32*YMM_SCD1	;; Next sin/cos data
	loops	2, b1b, 3		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 16*3			;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 192 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b2b, 4		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*32*YMM_SCD2	;; Restore sin/cos data
	loops	3, b2b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sin/cos data
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 192 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b3b:	yr4_eb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, b3b			;; Loop 3 times
;;	bump	rsi, -3*4*2*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer

	bump	rsi, -3*4*2*dist64+64	;; Next source pointer
	loops	32, b1a			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD1+512*YMM_SCD1+128*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 384 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 384 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 768 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 192 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 384 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 384 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_6144_complex_1
	jg	ypass2_6144_complex_3

ypass2_6144_complex_2:
	start_timer 6
	loops_init_prefetch 384, 64, 4, rcx ;; 12 iters of 128 cache lines

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 192 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6b:	yr8_8cl_eight_complex_with_square rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6b, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6b			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4b			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b4b			;; Loop 3 times
	bump	rsi, -3*8*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_6144_complex_unfft


ypass2_6144_complex_1:
	start_timer 6
	bump	rcx, (1536+23-128-2*192-3*384)*64 ;; Move prefetch pointer along
	loops_init_prefetch 384, 64, 1, rcx ;; 12 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 384 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 384 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6a:	yr8_8cl_eight_complex_fft_final rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6a, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6a			;; Loop 4 times
;;	bump	rsi, -4*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+32*64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b4a			;; Loop 3 times
	end_timer 6
	jmp	ypass2_6144_complex_done


ypass2_6144_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 384, 64, 2, rcx ;; 12 iters of 128 cache lines

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 192 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6c:	yr8_8cl_eight_complex_with_mult rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6c, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6c			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 96 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4c			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b4c			;; Loop 3 times
	bump	rsi, -3*8*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_6144_complex_unfft


ypass2_6144_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 512*YMM_SCD1+128*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 384, 64, 1, rcx ;; 12 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 384 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6d, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6d			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 384 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 384 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4d			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	3, b6d			;; Loop 3 times
	bump	rsi, -3*8*dist64	;; Restore source pointer
	bump	rcx, (-3*384+128+2*192+2*96+192+2*96)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 384 macros each processing 32 data values

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	6144	+1	+1	+1
;;	4	...
;;	...
;;	6140

;; Do 2048 three_complex_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 24 data values

ypass2_6144_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+512*YMM_SCD1]
	mov	rdx, rbp
	bump	rcx, (1536+23-128-2*192-2*96-192-2*96-2*192-128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1536, 64, 16, rcx ;; 512 iterations or 384 iterations

	loops_set_prefetch 64, 8, rcx	;; prefetch 192 cache lines in this loop
c3a:	yr4_eb4cl_four_complex_djbunfft_preload
c3b:	yr4_eb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c3b			;; Loop 3 times
	bump	rsi, -3*4*2*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 8, rcx	;; prefetch 192 cache lines in this loop
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 32*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c2b, 4		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*8*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*4*4		;; Back up loop counter

	loops_set_prefetch 64, 12, rcx	;; prefetch 128 cache lines in this loop
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 32*64, 8*dist64, rdi
	bump	rdi, 32*YMM_SCD1	;; Next set of sin/cos data
	loops	2, c1b, 3		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter
;;	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -8*dist64+64	;; Next source pointer
	loops	32, c3a			;; Loop 32 times
	end_timer 13

ypass2_6144_complex_done:
	ENDM


; *************** radix4-pass2-7680-real macro ******************
; This macro takes 15360 real values and performs the final 13.907 levels of the FFT.
; The results are squared, and the first 13.907 levels of the inverse FFT are done.

yr4dwpn_pass2_7680_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_7680_real_1, ypass2_7680_real_2
	LOCAL	ypass2_7680_real_3, ypass2_7680_real_4
	LOCAL	ypass2_7680_real_unfft, ypass2_7680_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1920 cache lines + 2*29 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_7680_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	7680	+1	+1	+1
;;	4	...
;;	...
;;	7676
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 2560 six_reals_fft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 640, 64, 2, rcx ;; 640 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 10*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	10, b1b			;; Test loop counter
	bump	rsi, -10*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 ten_reals_fft operations
;; Do 1024 five_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 40 data values

	loops_init_prefetch 384, 64, 1, rcx ;; 3 iters of 128
	yr5_5cl_ten_reals_fft_preload
b2a:	yr5_5cl_ten_reals_fft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2a			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr5_r5cl_five_complex_djbfft_preload
b2b:	yr5_r5cl_five_complex_djbfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*10*dist64	;; Restore source pointer
	bump	rdi, 128*YMM_SCD4	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 1792 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 480 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+32*YMM_SCD2]
	loops_init_prefetch 480, 64, 2, rcx ;; 15 iterations of 32
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 32
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sin/cos ptr
	loops	15, b3b			;; Loop 15 times
	bump	rsi, -15*2*dist64	;; Restore source pointer
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 1888 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 480 macros each processing 32 data values

	loops_init_prefetch 480, 64, 2, rcx ;; 15 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 14 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer
	loops	15, b4b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 1912 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 480 macros each processing 32 data values

	loops_init_prefetch 480, 64, 2, rcx ;; 60 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 59 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	15, b5b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 959 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 240 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_7680_real_1
	jg	ypass2_7680_real_3

ypass2_7680_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 240, 64, 2, rcx, 1, 16 ;; 239 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	15, b6b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer
	jmp	ypass2_7680_real_unfft

ypass2_7680_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 960 cache lines
	loops_init_prefetch 240, 128, 1, rcx, 1, 16 ;; 239 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	15, b6a			;; Test loop counter
	jmp	ypass2_7680_real_done

ypass2_7680_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 240, 64, 2, rcx, 1, 16 ;; 239 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	15, b6c			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer
	jmp	ypass2_7680_real_unfft

ypass2_7680_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 240, 128, 1, rcx, 1, 16 ;; 239 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	15, b6d			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer
;;	bump	rcx, (-478+320+384+3*240+120)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 1912 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 480 macros each processing 32 data values

ypass2_7680_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 32*YMM_SCD2+32*YMM_SCD2+128*YMM_SCD4+640*YMM_SCD2
	loops_init_prefetch 480, 64, 2, rcx ;; 60 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 59 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	15, c5b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 1888 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 480 macros each processing 32 data values

	bump	rcx, (1920+2*29-320-384-3*240-120-240-240)*64 ;; Move prefetch pointer along
	loops_init_prefetch 480, 64, 2, rcx ;; 15 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer
	loops	15, c4b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 1792 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 480 macros each processing 32 data values

	bump	rdi, -32*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-32*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 960 cache lines
	loops_init_prefetch 480, 64, 1, rcx ;; 15 iters of 32
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 14 more iters of 32
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	15, c3b			;; Test loop counter
	bump	rsi, -15*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 512 ten_reals_unfft operations
;; Do 1024 five_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 40 data values

	bump	rdi, -32*YMM_SCD2-128*YMM_SCD4 ;; Load sin/cos ptr
	loops_init_prefetch 384, 64, 2, rcx ;; 3 iters of 128
	yr5_5cl_ten_reals_unfft_preload
c2a:	yr5_5cl_ten_reals_unfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 128
	yr5_r5cl_five_complex_djbunfft_preload
c2b:	yr5_r5cl_five_complex_djbunfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*10*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	7680	+1	+1	+1
;;	4	...
;;	...
;;	7676

;; Do 2560 six_reals_unfft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 24 data values

	bump	rdi, -640*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (960-480-192-320)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 2, rcx ;; 640 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 10*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	10, c1b			;; Test loop counter

ypass2_7680_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-7680-complex macro ******************
; This macro takes 7680 complex values and performs the final 12.907 levels of a standard
; radix-4 FFT, squares the results, and does the first 12.907 levels of the inverse FFT.

yr4dwpn_pass2_7680_complex MACRO
	LOCAL	b1a, b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_7680_complex_1, ypass2_7680_complex_2
	LOCAL	ypass2_7680_complex_3, ypass2_7680_complex_4
	LOCAL	ypass2_7680_complex_unfft, ypass2_7680_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 1920 cache lines + 2*29 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_7680_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	7680	+1	+1	+1
;;	4	...
;;	...
;;	7676
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 2560 three_complex_fft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 1536 five_complex_fft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+640*YMM_SCD1]
	loops_init_prefetch 1920, 64, 15, rcx ;; 640 iterations or 384 iterations

b1a:	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 2*dist64, 10*dist64, rdi
	bump	rdi, 128*YMM_SCD1	;; Next sin/cos data
	loops	5, b1b, 3		;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rdi, -5*128*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 5*3			;; Back up loop counter

	yr5_5cl_five_complex_djbfft_preload
b2b:	yr5_5cl_five_complex_djbfft rsi, 10*dist64, 2*dist64, rbp
	loops	3, b2b, 5		;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -3*10*dist64+64	;; Next source pointer
	loops	64, b1a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1a			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -128*YMM_SCD1+640*YMM_SCD1+128*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1920 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 480 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1920 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 480 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1920 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 480 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 960 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 240 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1920 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 480 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1920 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 480 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 1920 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 480 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_7680_complex_1
	jg	ypass2_7680_complex_3

ypass2_7680_complex_2:
	start_timer 6
	loops_init_prefetch 480, 64, 2, rcx ;; 15 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3b			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 120 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6b:	yr8_8cl_eight_complex_with_square rsi, 4*64, 32*64, dist64, 64
	loops	8, b6b, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6b			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	15, b3b			;; Loop 15 times
	bump	rsi, -15*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_7680_complex_unfft


ypass2_7680_complex_1:
	start_timer 6
;;	bump	rcx, (1920+2*29-2*128-3*480-240)*64 ;; Move prefetch pointer along
	loops_init_prefetch 480, 64, 1, rcx ;; 15 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3a			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6a:	yr8_8cl_eight_complex_fft_final rsi, 4*64, 32*64, dist64, 64
	loops	8, b6a, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6a			;; Loop 2 times
;;	bump	rsi, -2*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	15, b3a			;; Loop 15 times
	end_timer 6
	jmp	ypass2_7680_complex_done


ypass2_7680_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 480, 64, 2, rcx ;; 15 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3c			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 120 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6c:	yr8_8cl_eight_complex_with_mult rsi, 4*64, 32*64, dist64, 64
	loops	8, b6c, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6c			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3c			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	15, b3c			;; Loop 15 times
	bump	rsi, -15*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_7680_complex_unfft


ypass2_7680_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 640*YMM_SCD1+128*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 480, 64, 1, rcx ;; 15 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 240 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 4*64, 32*64, dist64, 64
	loops	8, b6d, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 480 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3d			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	15, b6d			;; Loop 15 times
	bump	rsi, -15*2*dist64	;; Restore source pointer
;;	bump	rcx, (-240-3*480+2*128+2*240+2*120+3*240)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 1536 five_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 384 macros each processing 40 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	7680	+1	+1	+1
;;	4	...
;;	...
;;	7676

;; Do 2560 three_complex_unfft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 24 data values

ypass2_7680_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+640*YMM_SCD1]
	bump	rcx, (1920+2*29-2*128-3*240-120-3*240-128-64)*64 ;; Move prefetch pointer along
	loops_init_prefetch 1920, 64, 15, rcx ;; 384 iterations or 640 iterations

	loops_set_prefetch 64, 15, rcx	;; prefetch 128 cache lines in this loop
c2a:	yr5_5cl_five_complex_djbunfft_preload
c2b:	yr5_5cl_five_complex_djbunfft rsi, 10*dist64, 2*dist64, rbp
	loops	3, c2b, 5		;; Test loop counter
	bump	rsi, -3*10*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 3*5			;; Restore loop counter

	loops_set_prefetch 64, 30, rcx	;; prefetch 64 cache lines in this loop
	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 2*dist64, 10*dist64, rdi
	bump	rdi, 128*YMM_SCD1	;; Next set of sin/cos data
	loops	5, c1b, 3		;; Test loop counter
;;	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rdi, -5*128*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -5*2*dist64+64	;; Next source pointer
	loops	64, c2a			;; Loop 64 times
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Loop 2 times
	end_timer 13

ypass2_7680_complex_done:
	ENDM


; *************** radix4-pass2-13-levels-real macro ******************
; This macro takes 16384 real values and performs the final 14 levels of the FFT.
; The results are squared, and the first 14 levels of the inverse FFT are done.

yr4dwpn_pass2_13_levels_real MACRO
	LOCAL	b1b, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_13_levels_real_1, ypass2_13_levels_real_2
	LOCAL	ypass2_13_levels_real_3, ypass2_13_levels_real_4
	LOCAL	ypass2_13_levels_real_unfft, ypass2_13_levels_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2048 cache lines + 31 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_13_levels_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	8192	+1	+1	+1
;;	4	...
;;	...
;;	8188
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...

;; Do 2048 eight_reals_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 32 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 512, 64, 1, rcx ;; 512 iterations
	yr4_fs4cl_eight_reals_fft_preload
b1b:	yr4_fs4cl_eight_reals_fft rsi, 64, 8*dist64, 16*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...

;; Do 512 eight_reals_fft operations
;; Do 1536 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 512 macros each processing 32 data values

	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b2b:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 8*dist64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -512*YMM_SCD3	;; Restore sin/cos ptr

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 1920 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 512 macros each processing 32 data values

	loops_init_prefetch 512, 64, 2, rcx ;; 4 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 8*dist64, 32*64, dist64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -128*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 3 more iters of 128
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 8*dist64, 32*64, dist64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -128*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*2*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 2016 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 512 macros each processing 32 data values

	loops_init_prefetch 512, 64, 2, rcx ;; 16 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 8*dist64, 8*64, 16*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 15 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 8*dist64, 8*64, 16*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 2040 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 512 macros each processing 32 data values

	loops_init_prefetch 512, 64, 2, rcx ;; 64 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 8*dist64, 2*64, 4*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 63 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 8*dist64, 2*64, 4*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*64*YMM_SCD3	;; Restore sin/cos pointer
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 1023 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 256 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_13_levels_real_1
	jg	ypass2_13_levels_real_3

ypass2_13_levels_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 8*dist64, 16*dist64, 64
	loops_init_prefetch 256, 64, 16, rcx, 1, 32 ;; 255 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	32, b6b			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	8, b6b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
	jmp	ypass2_13_levels_real_unfft

ypass2_13_levels_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 8*dist64, 16*dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1040 cache lines
	loops_init_prefetch 256, 128, 1, rcx, 1, 32 ;; 255 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	32, b6a			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	8, b6a			;; Test loop counter
	jmp	ypass2_13_levels_real_done

ypass2_13_levels_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 8*dist64, 16*dist64, 64
	loops_init_prefetch 256, 64, 16, rcx, 1, 32 ;; 255 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	32, b6c			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	8, b6c			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
	jmp	ypass2_13_levels_real_unfft

ypass2_13_levels_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 8*dist64, 16*dist64, 64
	loops_init_prefetch 256, 128, 1, rcx, 1, 32 ;; 255 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	32, b6d			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	8, b6d			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
;;	bump	rcx, (-512+512+4*256+32)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 2040 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 512 macros each processing 32 data values

ypass2_13_levels_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 512*YMM_SCD3
	loops_init_prefetch 512, 64, 2, rcx ;; 64 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 8*dist64, 2*64, 4*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 63 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 8*dist64, 2*64, 4*64, rdi
	bump	rdi, 64*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	8, c5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	8, c5b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 2016 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 512 macros each processing 32 data values

	bump	rcx, (2048+31-512-4*256-32-256-256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 2, rcx ;; 16 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 8*dist64, 8*64, 16*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 15 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 8*dist64, 8*64, 16*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 1920 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 512 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1040 cache lines
	loops_init_prefetch 512, 64, 32, rcx ;; 4 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 8*dist64, 32*64, dist64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -128*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 3 more iters of 128
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 8*dist64, 32*64, dist64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -128*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...

;; Do 512 eight_reals_unfft operations
;; Do 1536 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 512 macros each processing 32 data values

	loops_init_prefetch 512, 64, 1, rcx ;; 512 iterations
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c2b:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 8*dist64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*8*dist64+64	;; Next source pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	8192	+1	+1	+1
;;	4	...
;;	...
;;	8188

;; Do 2048 eight_reals_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 32 data values

	bump	rdi, -512*YMM_SCD3-512*YMM_SCD3 ;; Load sin/cos pointer
	bump	rcx, (1040-16-512-512)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 1, rcx ;; 512 iterations
	yr4_s4cl_eight_reals_unfft_preload
c1b:	yr4_s4cl_eight_reals_unfft rsi, 64, 8*dist64, 16*dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter

ypass2_13_levels_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-13-levels-complex macro ******************
; This macro takes 8192 complex values and performs the final 13 levels of a standard
; radix-4 FFT, squares the results, and does the first 13 levels of the inverse FFT.

yr4dwpn_pass2_13_levels_complex MACRO
	LOCAL	b1b, b2b, b3b, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_13_levels_complex_1, ypass2_13_levels_complex_2
	LOCAL	ypass2_13_levels_complex_3, ypass2_13_levels_complex_4
	LOCAL	ypass2_13_levels_complex_unfft, ypass2_13_levels_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2048 cache lines + 31 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_13_levels_complex_4

;; Do FFT level 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	8192	+1	+1	+1
;;	4	...
;;	...
;;	8188
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...

;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 32 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 512 macros each processing 32 data values

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 512 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	mov	rbp, rdi
	mov	rdx, rdi
	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations

	loops_set_prefetch 64, 2, rcx	;; prefetch 256 cache lines in this loop
	yr4_fs4cl_four_complex_djbfft_preload
b1b:	yr4_fs4cl_four_complex_djbfft rsi, 32*64, 8*dist64, 16*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 256 cache lines in this loop
;;BUG	yr4_eb4cl_four_complex_djbfft_preload - hope these are compatible
b2b:	yr4_eb4cl_four_complex_djbfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 128*YMM_SCD2	;; Next sin/cos data
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*128*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*8*dist64	;; Restore source pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
b3b:	yr4_eb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdx
	loops	4, b3b			;; Loop 4 times
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
;;	bump	rsi, -4*4*2*dist64	;; Restore source pointer

	bump	rsi, -4*4*2*dist64+64	;; Next source pointer
	loops	32, b1b			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2+512*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 512 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 512 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...

;; Do 1024 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 256 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	8	+4K	+4K	+4K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 512 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	32	+4K	+4K	+4K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 512 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_13_levels_complex_1
	jg	ypass2_13_levels_complex_3

ypass2_13_levels_complex_2:
	start_timer 6
	loops_init_prefetch 512, 64, 4, rcx ;; 16 iters of 128 cache lines

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 32 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
	bump	rsi, -16*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, c4b			;; Loop 4 times
;;	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*8*dist64+32*64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_13_levels_complex_unfft


ypass2_13_levels_complex_1:
	start_timer 6
	bump	rcx, (2048+31-2*256-128-3*512)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 1, rcx ;; 16 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 512 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 512 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 512 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+32*64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b4a			;; Loop 8 times
	end_timer 6
	jmp	ypass2_13_levels_complex_done


ypass2_13_levels_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 512, 64, 4, rcx ;; 16 iters of 128 cache lines

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 32 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
	bump	rsi, -16*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, c4c			;; Loop 4 times
;;	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*8*dist64+32*64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*dist64		;; Restore source pointer
	end_timer 6
	jmp	ypass2_13_levels_complex_unfft


ypass2_13_levels_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 512*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 512, 64, 1, rcx ;; 16 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 256 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 8*dist64, 16*dist64, 64
	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
	bump	rsi, -16*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 512 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+8*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 512 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+8*dist64	;; Next source pointer
	loops	4, c4d			;; Loop 4 times
;;	bump	rsi, -4*8*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*8*dist64+32*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b6d			;; Loop 8 times
	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rcx, (-256-2*512+2*256+3*128+32+2*128)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	128	+4K	+4K	+4K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...

;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 512 macros each processing 32 data values

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	512	+4K	+4K	+4K
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;;	1	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...

;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 512 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+4K	+4K	+4K	2048	+4K	+4K	+4K
;;	4	...
;;	...
;;	2044	...
;;	1	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	8192	+1	+1	+1
;;	4	...
;;	...
;;	8188

;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 32 data values

ypass2_13_levels_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	mov	rbp, rdi
	mov	rdx, rdi
	bump	rcx, (2048+31-2*256-3*128-32-2*128-128-2*256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations

	loops_set_prefetch 64, 4, rcx	;; prefetch 128 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c3b:	yr4_eb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdx
	loops	4, c3b			;; Loop 4 times
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
	bump	rsi, -4*4*2*dist64	;; Restore source pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c2b:	yr4_eb4cl_four_complex_djbunfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 128*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*128*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*8*dist64	;; Restore source pointer
	loops_undo 4*4			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 256 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c1b:	yr4_s4cl_four_complex_djbunfft rsi, 32*64, 8*dist64, 16*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next set of sin/cos data
	loops	2, c1b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter
;;	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -8*dist64+64	;; Next source pointer
	loops	32, c3b			;; Loop 32 times
	end_timer 13

ypass2_13_levels_complex_done:
	ENDM


; *************** radix4-pass2-10240-real macro ******************
; This macro takes 20480 real values and performs the final 14.322 levels of the FFT.
; The results are squared, and the first 14.322 levels of the inverse FFT are done.

yr4dwpn_pass2_10240_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_10240_real_1, ypass2_10240_real_2
	LOCAL	ypass2_10240_real_3, ypass2_10240_real_4
	LOCAL	ypass2_10240_real_unfft, ypass2_10240_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2560 cache lines + 39 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_10240_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	10240	+1	+1	+1
;;	4	...
;;	...
;;	10236
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 2048 ten_reals_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 40 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 512, 64, 2, rcx ;; 512 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 8*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 512 eight_reals_fft operations
;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+128*YMM_SCD2]
	loops_init_prefetch 640, 64, 1, rcx ;; 5 iterations of 128
	yr4_s4cl_2sc_eight_reals_fft_preload
b2a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 2*dist64, 4*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 128
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 2432 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 640 macros each processing 32 data values

	bump	rdi, 128*YMM_SCD2	;; Load sin/cos ptr
	loops_init_prefetch 640, 64, 2, rcx ;; 5 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b3a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 5 more iters of 128
	yr4_rb4cl_four_complex_djbfft_preload
b3b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sin/cos pointer
	loops	5, b3b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 2528 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 640 macros each processing 32 data values

	loops_init_prefetch 640, 64, 2, rcx ;; 20 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 19 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b4b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 2552 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 640 macros each processing 32 data values

	loops_init_prefetch 640, 64, 2, rcx ;; 80 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 79 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	8, b5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b5b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 1279 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 319 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_10240_real_1
	jg	ypass2_10240_real_3

ypass2_10240_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 320, 64, 4, rcx, 1, 32 ;; 319 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6b			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b6b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer
	jmp	ypass2_10240_real_unfft

ypass2_10240_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1296 cache lines
	loops_init_prefetch 320, 128, 1, rcx, 1, 32 ;; 319 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6a			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b6a			;; Test loop counter
	jmp	ypass2_10240_real_done

ypass2_10240_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 320, 64, 4, rcx, 1, 32 ;; 319 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6c			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6c			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b6c			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer
	jmp	ypass2_10240_real_unfft

ypass2_10240_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops_init_prefetch 320, 128, 1, rcx, 1, 32 ;; 319 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
	loops	32, b6d			;; Test loop counter
	bump	rsi, -32*2*64+dist64	;; Next source pointer
	loops	2, b6d			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b6d			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer
;;	bump	rcx, (-638+256+640+3*320+160)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 2552 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 640 macros each processing 32 data values

ypass2_10240_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 128*YMM_SCD2+128*YMM_SCD2+512*YMM_SCD4
	loops_init_prefetch 640, 64, 2, rcx ;; 80 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 79 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	8, c5b			;; Test loop counter
	bump	rsi, -8*8*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, c5b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 2528 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 640 macros each processing 32 data values

	bump	rcx, (2560+39-256-640-3*320-160-320-320)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 2, rcx ;; 20 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 19 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -32*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, c4b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 2432 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 640 macros each processing 32 data values

	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1296 cache lines
	loops_init_prefetch 640, 64, 1, rcx ;; 5 iterations of 128
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c3a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3a			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 128
	yr4_rb4cl_four_complex_djbunfft_preload
c3b:	yr4_rb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c3b			;; Test loop counter
	bump	rsi, -4*2*dist64+64	;; Next source pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD3	;; Restore sine/cosine pointer
	loops	5, c3b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 512 eight_reals_unfft operations
;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 32 data values

	bump	rdi, -128*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-128*YMM_SCD2]
	loops_init_prefetch 640, 64, 1, rcx ;; 5 iterations of 128
	yr4_s4cl_2sc_eight_reals_unfft_preload
c2a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 2*dist64, 4*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 128
	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 2*dist64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	bump	rdi, -128*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	10240	+1	+1	+1
;;	4	...
;;	...
;;	10236

;; Do 2048 ten_reals_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 40 data values

	bump	rdi, -128*YMM_SCD2-512*YMM_SCD4 ;; Load sin/cos ptr
	bump	rcx, (1296-2*640-16)*64 ;; Move prefetch pointer along
	loops_init_prefetch 512, 64, 32, rcx ;; 512 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 8*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter

ypass2_10240_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-10240-complex macro ******************
; This macro takes 10240 complex values and performs the final 13.322 levels of a standard
; radix-4 FFT, squares the results, and does the first 13.322 levels of the inverse FFT.

yr4dwpn_pass2_10240_complex MACRO
	LOCAL	b1a, b1b, b2b, b3b, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3a, c3b, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_10240_complex_1, ypass2_10240_complex_2
	LOCAL	ypass2_10240_complex_3, ypass2_10240_complex_4
	LOCAL	ypass2_10240_complex_unfft, ypass2_10240_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2560 cache lines + 39 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_10240_complex_4

;; Do FFT level 1,2 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	10240	+1	+1	+1
;;	4	...
;;	...
;;	10236
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 2048 five_complex_fft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 40 data values

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_fft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 32 data values

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 640 macros each processing 32 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+512*YMM_SCD2]
	mov	rdx, rbp
	loops_init_prefetch 2560, 64, 20, rcx ;; 512 iterations or 640 iterations

	loops_set_prefetch 64, 20, rcx	;; prefetch 128 cache lines in this loop
b1a:	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 32*64, 8*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b1b, 5		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, b1b			;; Test loop counter
	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 16*5			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 160 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b2b:	yr4_s4cl_four_complex_djbfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 32*YMM_SCD2	;; Next sin/cos data
	loops	2, b2b, 4		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*32*YMM_SCD2	;; Restore sin/cos data
	loops	5, b2b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sin/cos data
	loops_undo 5*4*4		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 160 cache lines in this loop
b3b:	yr4_eb4cl_four_complex_djbfft rsi, 2*dist64, 32*64, dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, b3b			;; Loop 5 times
;;	bump	rsi, -5*4*2*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer

	bump	rsi, -5*4*2*dist64+64	;; Next source pointer
	loops	32, b1a			;; Test loop counter
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2+512*YMM_SCD2+128*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 640 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 640 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 1280 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 320 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	8	+1K	+1K	+1K
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 640 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	32	+1K	+1K	+1K
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 640 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_10240_complex_1
	jg	ypass2_10240_complex_3

ypass2_10240_complex_2:
	start_timer 6
	loops_init_prefetch 640, 64, 2, rcx ;; 20 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4b:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5b:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6b:	yr8_8cl_eight_complex_with_square rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6b, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6b			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4b:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4b			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b4b			;; Loop 5 times
	bump	rsi, -5*8*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_10240_complex_unfft


ypass2_10240_complex_1:
	start_timer 6
;;	bump	rcx, (2560+39-128-2*160-3*640)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 1, rcx ;; 20 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 640 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4a:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 640 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5a:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 640 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6a:	yr8_8cl_eight_complex_fft_final rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6a, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6a			;; Loop 4 times
;;	bump	rsi, -4*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+32*64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b4a			;; Loop 5 times
	end_timer 6
	jmp	ypass2_10240_complex_done


ypass2_10240_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 640, 64, 2, rcx ;; 20 iters of 128 cache lines

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr4_b4cl_four_complex_djbfft_preload
b4c:	yr4_b4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, b4c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
;;	yr4_b4cl_four_complex_djbfft_preload
b5c:	yr4_b4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6c:	yr8_8cl_eight_complex_with_mult rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6c, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6c			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 320 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4c:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4c			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b4c			;; Loop 5 times
	bump	rsi, -5*8*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_10240_complex_unfft


ypass2_10240_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 512*YMM_SCD2+128*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 640, 64, 1, rcx ;; 20 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 640 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 2*dist64, 4*dist64, 64
;;	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 8*64, 2*dist64, 4*dist64, 64
	loops	4, b6d, 2		;; Loop 4 times with non-standard increment
	bump	rsi, -4*8*64+2*64	;; Next source pointer
	loops	4, b6d			;; Loop 4 times
	bump	rsi, -4*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 640 cache lines in this loop
	yr4_b4cl_four_complex_djbunfft_preload
c5d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD2/4	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -4*YMM_SCD2/4	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 640 cache lines in this loop
;;	yr4_b4cl_four_complex_djbunfft_preload
c4d:	yr4_b4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD2/4		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	loops	4, c4d			;; Loop 4 times
;;	bump	rsi, -4*2*dist64	;; Restore source pointer
	bump	rdi, -32*YMM_SCD2/4	;; Restore sine/cosine pointer

	bump	rsi, -4*2*dist64+32*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*dist64+8*dist64	;; Next source pointer
	loops	5, b6d			;; Loop 5 times
	bump	rsi, -5*8*dist64	;; Restore source pointer
;;	bump	rcx, (-3*640+128+2*160+5*320)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	128	+1K	+1K	+1K
;;	4	...
;;	...
;;	124	...
;;	256	...
;;	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...

;; Do 2560 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 640 macros each processing 32 data values

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1K	+1K	+1K	512	+1K	+1K	+1K
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...

;; Do 2560 four_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 32 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2048	+1	+1	+1
;;	4	...
;;	...
;;	2044	...
;;	4096	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	10240	+1	+1	+1
;;	4	...
;;	...
;;	6140

;; Do 2048 five_complex_unfft operations
;;	distance between fft data elements is 2048
;;	do 512 macros each processing 40 data values

ypass2_10240_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+512*YMM_SCD2]
	mov	rdx, rbp
	bump	rcx, (2560+39-128-2*160-5*320-2*160-256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 2560, 64, 16, rcx ;; 512 iterations or 640 iterations

	loops_set_prefetch 64, 16, rcx	;; prefetch 160 cache lines in this loop
c3a:	yr4_eb4cl_four_complex_djbunfft_preload
c3b:	yr4_eb4cl_four_complex_djbunfft rsi, 2*dist64, 32*64, dist64, rdx
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c3b, 4		;; Loop 4 times
	bump	rdx, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c3b			;; Loop 3 times
	bump	rsi, -5*4*2*dist64	;; Restore source pointer
	bump	rdx, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5*4*4		;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 160 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c2b:	yr4_s4cl_four_complex_djbunfft rsi, 32*64, 2*dist64, 4*dist64, rbp
	bump	rbp, 32*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c2b, 4		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+8*dist64 ;; Next source pointer
	bump	rbp, -4*32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*8*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5*4*4		;; Back up loop counter

	loops_set_prefetch 64, 10, rcx	;; prefetch 256 cache lines in this loop
	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 32*64, 8*dist64, rdi
	bump	rdi, 32*YMM_SCD2	;; Next set of sin/cos data
	loops	2, c1b, 5		;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	8, c1b			;; Test loop counter
;;	bump	rsi, -8*dist64		;; Restore source pointer
	bump	rdi, -16*32*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -8*dist64+64	;; Next source pointer
	loops	32, c3a			;; Loop 32 times
	end_timer 13

ypass2_10240_complex_done:
	ENDM


; *************** radix4-pass2-12800-real macro ******************
; This macro takes 25600 real values and performs the final 14.644 levels of the FFT.
; The results are squared, and the first 14.644 levels of the inverse FFT are done.

yr4dwpn_pass2_12800_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b
	LOCAL	ypass2_12800_real_1, ypass2_12800_real_2
	LOCAL	ypass2_12800_real_3, ypass2_12800_real_4
	LOCAL	ypass2_12800_real_unfft, ypass2_12800_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3200 cache lines + 2*49 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12800_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12800	+1	+1	+1
;;	4	...
;;	...
;;	12796
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 2560 ten_reals_fft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 40 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 640, 64, 2, rcx ;; 640 iterations
	yr5_f5cl_ten_reals_fft_preload
b1b:	yr5_f5cl_ten_reals_fft rsi, 64, 10*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	10, b1b			;; Test loop counter
	bump	rsi, -10*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 512 ten_reals_fft operations
;; Do 1024 five_complex_fft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 40 data values

	loops_init_prefetch 640, 64, 2, rcx ;; 5 iters of 128
	yr5_5cl_ten_reals_fft_preload
b2a:	yr5_5cl_ten_reals_fft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2a			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 128
	yr5_r5cl_five_complex_djbfft_preload
b2b:	yr5_r5cl_five_complex_djbfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b2b			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sin/cos ptr
	loops	5, b2b			;; Loop 5 times
	bump	rsi, -5*10*dist64	;; Restore source pointer
	bump	rdi, 128*YMM_SCD4	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 128 eight_reals_fft operations
;; Do 3072 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 800 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+32*YMM_SCD2]
	loops_init_prefetch 800, 64, 2, rcx ;; 25 iterations of 32
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	32, b3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 32
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	32, b3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sin/cos ptr
	loops	25, b3b			;; Loop 25 times
	bump	rsi, -25*2*dist64	;; Restore source pointer
	bump	rdi, 32*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_fft operations
;; Do 3168 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 800 macros each processing 32 data values

	loops_init_prefetch 800, 64, 2, rcx ;; 25 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 24 more iters of 32
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, b4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sin/cos pointer
	loops	25, b4b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_fft operations
;; Do 3192 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 800 macros each processing 32 data values

	loops_init_prefetch 800, 64, 2, rcx ;; 100 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 99 more iters of 8
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	25, b5b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1 sixteen_reals_fft operation
;; Do 1659 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 400 macros each processing 64 data values

	cmp	ffttype, 2
	jl	ypass2_12800_real_1
	jg	ypass2_12800_real_3

ypass2_12800_real_2:
	yr8_8cl_sixteen_reals_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 400, 64, 1, rcx, 1, 16 ;; 399 more iterations
b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	25, b6b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer
	jmp	ypass2_12800_real_unfft

ypass2_12800_real_1:
	yr8_8cl_sixteen_reals_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1600 cache lines
	loops_init_prefetch 400, 128, 1, rcx, 1, 16 ;; 399 more iterations
b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
	loops	16, b6a			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	25, b6a			;; Test loop counter
	jmp	ypass2_12800_real_done

ypass2_12800_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 400, 64, 1, rcx, 1, 16 ;; 399 more iterations
b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
	loops	16, b6c			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	25, b6c			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer
	jmp	ypass2_12800_real_unfft

ypass2_12800_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr8_8cl_sixteen_reals_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops_init_prefetch 400, 128, 1, rcx, 1, 16 ;; 399 more iterations
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
	loops	16, b6d			;; Test loop counter
	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	25, b6d			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer
;;	bump	rcx, (-798+2*320+3*400+399)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 8 eight_reals_unfft operations
;; Do 3192 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 800 macros each processing 32 data values

ypass2_12800_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 32*YMM_SCD2+32*YMM_SCD2+128*YMM_SCD4+640*YMM_SCD4
	loops_init_prefetch 800, 64, 2, rcx ;; 100 iterations of 8
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5a			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 99 more iters of 8
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 2*64, 4*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -8*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*8*64+2*dist64	;; Next source pointer
	loops	25, c5b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 32 eight_reals_unfft operations
;; Do 3168 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 800 macros each processing 32 data values

	bump	rcx, (3200+2*49-2*320-3*400-399-400-800)*64 ;; Move prefetch pointer along
	loops_init_prefetch 800, 64, 1, rcx ;; 25 iterations of 32
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4a			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4a			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 32
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, 32*64, 8*64, 16*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Test loop counter
	bump	rsi, -2*dist64+64	;; Next source pointer
	loops	8, c4b			;; Test loop counter
	bump	rsi, -8*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD3	;; Restore sine/cosine pointer
	loops	25, c4b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 128 eight_reals_unfft operations
;; Do 3072 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 800 macros each processing 32 data values

	bump	rdi, -32*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-32*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1600 cache lines
	loops_init_prefetch 800, 64, 2, rcx ;; 25 iters of 32
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, 32*64, dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3a			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 24 more iters of 32
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Test loop counter
	bump	rsi, -32*64+2*dist64	;; Next source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops	25, c3b			;; Test loop counter
	bump	rsi, -25*2*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 512 ten_reals_unfft operations
;; Do 1024 five_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 40 data values

	bump	rdi, -32*YMM_SCD2-128*YMM_SCD4 ;; Load sin/cos ptr
	loops_init_prefetch 640, 64, 1, rcx ;; 5 iters of 128
	yr5_5cl_ten_reals_unfft_preload
c2a:	yr5_5cl_ten_reals_unfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2a			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer

	loops_reset			;; 4 more iters of 128
	yr5_r5cl_five_complex_djbunfft_preload
c2b:	yr5_r5cl_five_complex_djbunfft rsi, 64, 2*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Test loop counter
	bump	rsi, -2*dist64+10*dist64 ;; Next source pointer
	bump	rdi, -128*YMM_SCD4	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*10*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12800	+1	+1	+1
;;	4	...
;;	...
;;	12796

;; Do 2560 ten_reals_unfft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 40 data values

	bump	rdi, -640*YMM_SCD4	;; Load sin/cos ptr
	bump	rcx, (1600-400-640-640)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 1, rcx ;; 640 iterations
	yr5_5cl_ten_reals_unfft_preload
c1b:	yr5_5cl_ten_reals_unfft rsi, 64, 10*dist64, rdi
	bump	rdi, YMM_SCD4		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	10, c1b			;; Test loop counter

ypass2_12800_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-12800-complex macro ******************
; This macro takes 12800 complex values and performs the final 13.644 levels of a standard
; radix-4 FFT, squares the results, and does the first 13.644 levels of the inverse FFT.

yr4dwpn_pass2_12800_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b6d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d
	LOCAL	ypass2_12800_complex_1, ypass2_12800_complex_2
	LOCAL	ypass2_12800_complex_3, ypass2_12800_complex_4
	LOCAL	ypass2_12800_complex_unfft, ypass2_12800_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3200 cache lines + 2*49 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12800_complex_4

;; Do FFT level 1,2 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12800	+1	+1	+1
;;	4	...
;;	...
;;	12796
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 2560 five_complex_fft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 40 data values

;; Do FFT levels 3,4 (actually 2.322 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 2560 five_complex_fft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 40 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+640*YMM_SCD2]
	loops_init_prefetch 640, 64, 5, rcx ;; 640 iterations

	yr5_f5cl_five_complex_djbfft_preload
b1b:	yr5_f5cl_five_complex_djbfft rsi, 2*dist64, 10*dist64, rdi
	bump	rdi, 128*YMM_SCD2	;; Next sin/cos data
	loops	5, b1b			;; Test loop counter
	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rdi, -5*128*YMM_SCD2+YMM_SCD2 ;; Next sin/cos data
	loops_undo 5			;; Back up loop counter

;;	yr5_5cl_five_complex_djbfft_preload
b2b:	yr5_5cl_five_complex_djbfft rsi, 10*dist64, 2*dist64, rbp
	loops	5, b2b			;; Test loop counter
	bump	rbp, YMM_SCD2		;; Next sin/cos data

	bump	rsi, -5*10*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, b1b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -128*YMM_SCD2+640*YMM_SCD2+128*YMM_SCD2 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 3200 four_complex_fft operations
;;	distance between fft data elements is 128
;;	do 800 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 3200 four_complex_fft operations
;;	distance between fft data elements is 32
;;	do 800 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 3200 four_complex_fft operations
;;	distance between fft data elements is 8
;;	do 800 macros each processing 32 data values

;; Do FFT levels 11,12,13 as well as inverse FFT levels 11,12,13
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 1600 eight_complex_fft operations
;;	distance between fft data elements is 1
;;	do 400 macros each processing 64 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	8	+256	+256	+256
;;	4	...
;;	16	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 3200 four_complex_unfft operations
;;	distance between fft data elements is 8
;;	do 800 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	32	+256	+256	+256
;;	4	...
;;	...
;;	28	...
;;	64	...
;;	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...

;; Do 3200 four_complex_unfft operations
;;	distance between fft data elements is 32
;;	do 800 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+256	+256	+256	128	+256	+256	+256
;;	4	...
;;	...
;;	124	...
;;	1	...
;;	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...

;; Do 3200 four_complex_unfft operations
;;	distance between fft data elements is 128
;;	do 800 macros each processing 32 data values

;; Do this 128 cache lines (8KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_12800_complex_1
	jg	ypass2_12800_complex_3

ypass2_12800_complex_2:
	start_timer 6
	loops_init_prefetch 800, 64, 2, rcx ;; 25 iters of 128 cache lines

	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3b			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	yr8_8cl_eight_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b6b:	yr8_8cl_eight_complex_with_square rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6b, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6b:	yr8_8cl_eight_complex_with_square rsi, 4*64, 32*64, dist64, 64
	loops	8, b6b, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6b			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5b			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5b			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4b			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4b			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3b			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	25, b3b			;; Loop 25 times
	bump	rsi, -25*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_12800_complex_unfft


ypass2_12800_complex_1:
	start_timer 6
	bump	rcx, (3200+2*49-2*128-4*800)*64 ;; Move prefetch pointer along
	loops_init_prefetch 800, 64, 1, rcx ;; 25 iters of 128 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3a			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4a			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4a			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5a:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5a			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5a			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5a			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 128, 2, rcx	;; prefetch 800 cache lines in this loop
	yr8_8cl_eight_complex_fft_final_preload
;; Loop below reworked to avoid 4KB distances
;;b6a:	yr8_8cl_eight_complex_fft_final rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6a, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6a:	yr8_8cl_eight_complex_fft_final rsi, 4*64, 32*64, dist64, 64
	loops	8, b6a, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6a			;; Loop 2 times
;;	bump	rsi, -2*2*64		;; Restore source pointer

	bump	rsi, -16*2*64+2*dist64	;; Next source pointer
	loops	25, b3a			;; Loop 25 times
	end_timer 6
	jmp	ypass2_12800_complex_done


ypass2_12800_complex_3:
	start_timer 6
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 800, 64, 2, rcx ;; 25 iters of 128 cache lines

	yr4_s4cl_four_complex_djbfft_preload
b3c:	yr4_s4cl_four_complex_djbfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, b3c			;; Loop 32 times
	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 32			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b4c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, b4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbfft_preload
b5c:	yr4_eb4cl_four_complex_djbfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, b5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, b5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	yr8_8cl_eight_complex_with_mult_preload
;; Loop below reworked to avoid 4KB distances
;;b6c:	yr8_8cl_eight_complex_with_mult rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6c, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6c:	yr8_8cl_eight_complex_with_mult rsi, 4*64, 32*64, dist64, 64
	loops	8, b6c, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6c			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	yr4_eb4cl_four_complex_djbunfft_preload
c5c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5c			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5c			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5c			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

;;	yr4_eb4cl_four_complex_djbunfft_preload
c4c:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4c			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4c			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

;;	yr4_s4cl_four_complex_djbunfft_preload
c3c:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3c			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	25, b3c			;; Loop 25 times
	bump	rsi, -25*2*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_12800_complex_unfft


ypass2_12800_complex_4:
	start_timer 6
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	bump	rdi, 640*YMM_SCD2+128*YMM_SCD2
	mov	rbp, DIST_TO_MULSRCARG
	loops_init_prefetch 800, 64, 1, rcx ;; 25 iters of 128 cache lines

	loops_set_prefetch 128, 2, rcx	;; prefetch 800 cache lines in this loop
	yr8_8cl_eight_complex_with_mulf_preload
;; Loop below reworked to avoid 4KB distances
;;b6d:	yr8_8cl_eight_complex_with_mulf rsi, 2*64, 32*64, dist64, 64
;;	loops	16, b6d, 2		;; Loop 16 times with non-standard increment
;;	bump	rsi, -16*2*64		;; Restore source pointer
b6d:	yr8_8cl_eight_complex_with_mulf rsi, 4*64, 32*64, dist64, 64
	loops	8, b6d, 2		;; Loop 8 times with non-standard increment
	bump	rsi, -8*4*64+2*64	;; Next source pointer
	loops	2, b6d			;; Loop 2 times
	bump	rsi, -2*2*64		;; Restore source pointer
	loops_undo 16*2			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 2*64, 4*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	2, c5d			;; Loop 2 times
	bump	rsi, -2*64+8*64		;; Next source pointer
	bump	rdi, -2*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*8*64+32*64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c5d			;; Test loop counter
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*2		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 8*64, 16*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	8, c4d			;; Loop 8 times
	bump	rsi, -8*64+32*64	;; Next source pointer
	bump	rdi, -8*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*32*64+dist64	;; Next source pointer
	loops	2, c4d			;; Loop 2 times
	bump	rsi, -2*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*8			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 800 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, 32*64, dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	32, c3d			;; Loop 32 times
;;	bump	rsi, -32*64		;; Restore source pointer
	bump	rdi, -32*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -32*64+2*dist64	;; Next source pointer
	loops	25, b6d			;; Loop 25 times
	bump	rsi, -25*2*dist64	;; Restore source pointer
	bump	rcx, (-4*800+2*128+7*400)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	512	+1	+1	+1
;;	4	...
;;	...
;;	508	...
;;	1024	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...

;; Do 2560 five_complex_unfft operations
;;	distance between fft data elements is 512
;;	do 640 macros each processing 40 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	2560	+1	+1	+1
;;	4	...
;;	...
;;	2556	...
;;	5120	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12800	+1	+1	+1
;;	4	...
;;	...
;;	12796

;; Do 2560 three_complex_unfft operations
;;	distance between fft data elements is 2560
;;	do 640 macros each processing 40 data values

ypass2_12800_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+640*YMM_SCD2]
	bump	rcx, (3200+2*49-2*128-7*400-2*128)*64 ;; Move prefetch pointer along
	loops_init_prefetch 640, 64, 5, rcx ;; 640 iterations

	yr5_5cl_five_complex_djbunfft_preload
c2b:	yr5_5cl_five_complex_djbunfft rsi, 10*dist64, 2*dist64, rbp
	loops	5, c2b			;; Test loop counter
	bump	rsi, -5*10*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD2		;; Next sine/cosine pointer
	loops_undo 5			;; Restore loop counter

;;	yr5_5cl_five_complex_djbunfft_preload
c1b:	yr5_5cl_five_complex_djbunfft rsi, 2*dist64, 10*dist64, rdi
	bump	rdi, 128*YMM_SCD2	;; Next set of sin/cos data
	loops	5, c1b			;; Test loop counter
;;	bump	rsi, -5*2*dist64	;; Restore source pointer
	bump	rdi, -5*128*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer

	bump	rsi, -5*2*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	2, c2b			;; Loop 2 times
	end_timer 13

ypass2_12800_complex_done:
	ENDM


;*********************************************************************************************
;			Macros derived from pass2-14-levels
;*********************************************************************************************


; *************** radix4-pass2-9216-real macro ******************
; This macro takes 18432 real values and performs the final 14.17 levels of the FFT.
; The results are squared, and the first 14.17 levels of the inverse FFT are done.

yr4dwpn_pass2_9216_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b, c6a, c6b
	LOCAL	ypass2_9216_real_1, ypass2_9216_real_2
	LOCAL	ypass2_9216_real_3, ypass2_9216_real_4
	LOCAL	ypass2_9216_real_unfft, ypass2_9216_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2304 cache lines + 35 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_9216_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	9216	+1	+1	+1
;;	4	...
;;	...
;;	9212
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...

;; Do 3072 six_reals_fft operations
;;	distance between fft data elements is 3072
;;	do 768 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 768, 64, 2, rcx ;; 768 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 12*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	12, b1b			;; Test loop counter
	bump	rsi, -12*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 1024 six_reals_fft operations
;; Do 2048 three_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 24 data values

	loops_init_prefetch 768, 64, 2, rcx ;; 3 iters of 256
	yr3_3cl_six_reals_fft_preload
b2a:	yr3_3cl_six_reals_fft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b2a			;; Test loop counter
	bump	rsi, -4*dist64+12*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 256
	yr3_r3cl_three_complex_djbfft_preload
b2b:	yr3_r3cl_three_complex_djbfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b2b			;; Test loop counter
	bump	rsi, -4*dist64+12*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sin/cos ptr
	loops	3, b2b			;; Loop 3 times
	bump	rsi, -3*12*dist64	;; Restore source pointer
	bump	rdi, 256*YMM_SCD2	;; Next sin/cos pointer

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 256 eight_reals_fft operations
;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 576 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+64*YMM_SCD2]
	loops_init_prefetch 576, 64, 2, rcx ;; 9 iterations of 64
	yr4_s4cl_2sc_eight_reals_fft_preload
b3a:	yr4_s4cl_2sc_eight_reals_fft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	bump	rdx, YMM_SCD2		;; Next sin/cos data
	loops	64, b3a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 64
	yr4_s4cl_four_complex_djbfft_preload
b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos data
	loops	64, b3b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sin/cos ptr
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*4*dist64	;; Restore source pointer
	bump	rdi, 64*YMM_SCD2	;; Next sin/cos ptr

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_fft operations
;; Do 2240 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 576 macros each processing 32 data values

	loops_init_prefetch 576, 64, 2, rcx ;; 9 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b4a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b4a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 8 more iters of 64
	yr4_rb4cl_four_complex_djbfft_preload
b4b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sin/cos pointer
	loops	4, b4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, b4b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sin/cos pointer
	loops	9, b4b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_fft operations
;; Do 2288 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 576 macros each processing 32 data values

	loops_init_prefetch 576, 64, 4, rcx ;; 36 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b5a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b5a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 35 more iters of 16
	yr4_rb4cl_four_complex_djbfft_preload
b5b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sin/cos pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	9, b5b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_fft operations
;; Do 2300 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 576 macros each processing 32 data values

	loops_init_prefetch 576, 64, 4, rcx ;; 144 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbfft_preload
b6a:	yr4_4cl_eight_reals_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b6a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer

	loops_reset			;; 143 more iters of 4
	yr4_rb4cl_four_complex_djbfft_preload
b6b:	yr4_rb4cl_four_complex_djbfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sin/cos pointer
	loops	4, b6b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sin/cos pointer
	loops	16, b6b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	9, b6b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do FFT levels 13,14 as well as inverse FFT levels 13,14
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 1 eight_reals_fft operation
;; Do 2303 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 576 macros each processing 32 data values

	cmp	ffttype, 2
	jl	ypass2_9216_real_1
	jg	ypass2_9216_real_3

ypass2_9216_real_2:
	yr4_4cl_eight_reals_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops_init_prefetch 576, 64, 4, rcx, 1, 64 ;; 575 more iterations
b7b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
	loops	64, b7b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	9, b7b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer
	jmp	ypass2_9216_real_unfft

ypass2_9216_real_1:
	yr4_4cl_eight_reals_four_complex_fft_final rsi, 64, dist64, 2*dist64
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1152 cache lines
	loops_init_prefetch 576, 128, 1, rcx, 1, 64 ;; 575 more iterations
b7a:	yr4_4cl_four_complex_fft_final rsi, 64, dist64, 2*dist64
	loops	64, b7a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	9, b7a			;; Test loop counter
	jmp	ypass2_9216_real_done

ypass2_9216_real_3:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops_init_prefetch 576, 64, 4, rcx, 1, 64 ;; 575 more iterations
b7c:	yr4_4cl_four_complex_with_mult rsi, 64, dist64, 2*dist64
	loops	64, b7c			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	9, b7c			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer
	jmp	ypass2_9216_real_unfft

ypass2_9216_real_4:
	mov	rbp, DIST_TO_MULSRCARG
	yr4_4cl_eight_reals_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops_init_prefetch 576, 128, 1, rcx, 1, 64 ;; 575 more iterations
b7d:	yr4_4cl_four_complex_with_mulf rsi, 64, dist64, 2*dist64
	loops	64, b7d			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	loops	9, b7d			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer
;;	bump	rcx, (-1152+2*384+2*288+3*144)*64 ;; Move prefetch pointer back to where squaring would be

;; Do inverse FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 4 eight_reals_unfft operations
;; Do 2300 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 576 macros each processing 32 data values

ypass2_9216_real_unfft:
	mov	rdi, sincos3		;; Load sin/cos pointer
	bump	rdi, 64*YMM_SCD2+64*YMM_SCD2+256*YMM_SCD2+768*YMM_SCD2
	loops_init_prefetch 576, 64, 4, rcx ;; 144 iterations of 4
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c6a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c6a			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 143 more iters of 4
	yr4_rb4cl_four_complex_djbunfft_preload
c6b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 64, 2*64, rdi
	bump	rdi, 16*YMM_SCD3	;; Next sine/cosine pointer
	loops	4, c6b			;; Test loop counter
	bump	rsi, -4*dist64+4*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD3	;; Restore sine/cosine pointer
	loops	16, c6b			;; Test loop counter
	bump	rsi, -16*4*64+4*dist64	;; Next source pointer
	loops	9, c6b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 16 eight_reals_unfft operations
;; Do 2288 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 576 macros each processing 32 data values

	loops_init_prefetch 576, 64, 4, rcx ;; 36 iterations of 16
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c5a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c5a			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 35 more iters of 16
	yr4_rb4cl_four_complex_djbunfft_preload
c5b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 4*64, 8*64, rdi
	bump	rdi, 4*YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD3	;; Restore sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*16*64+4*dist64	;; Next source pointer
	loops	9, c5b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 64 eight_reals_unfft operations
;; Do 2240 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 576 macros each processing 32 data values

	bump	rcx, (2304+35-2*384-2*288-5*144-288)*64 ;; Move prefetch pointer along
	loops_init_prefetch 576, 64, 2, rcx ;; 9 iterations of 64
	yr4_4cl_eight_reals_four_complex_djbunfft_preload
c4a:	yr4_4cl_eight_reals_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4a			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c4a			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 64
	yr4_rb4cl_four_complex_djbunfft_preload
c4b:	yr4_rb4cl_four_complex_djbunfft rsi, dist64, 16*64, 32*64, rdi
	bump	rdi, YMM_SCD3		;; Next sine/cosine pointer
	loops	4, c4b			;; Test loop counter
	bump	rsi, -4*dist64+64	;; Next source pointer
	loops	16, c4b			;; Test loop counter
	bump	rsi, -16*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD3	;; Restore sine/cosine pointer
	loops	9, c4b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 256 eight_reals_unfft operations
;; Do 2048 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 576 macros each processing 32 data values

	bump	rdi, -64*YMM_SCD2	;; Load sin/cos ptrs
	lea	rdx, [rdi-64*YMM_SCD2]
	mov	rcx, xsincos_complex	;; Prefetch complex sin/cos data, 1152 cache lines
	loops_init_prefetch 576, 64, 1, rcx ;; 9 iters of 64
	yr4_s4cl_2sc_eight_reals_unfft_preload
c3a:	yr4_s4cl_2sc_eight_reals_unfft rsi, 64, dist64, 2*dist64, rdi, rdx
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	bump	rdx, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c3a			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 8 more iters of 64
	yr4_s4cl_four_complex_djbunfft_preload
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c3b			;; Test loop counter
	bump	rsi, -64*64+4*dist64	;; Next source pointer
	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
	loops	9, c3b			;; Test loop counter
	bump	rsi, -9*4*dist64	;; Restore source pointer

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...

;; Do 1024 six_reals_unfft operations
;; Do 2048 three_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 24 data values

	bump	rdi, -64*YMM_SCD2-256*YMM_SCD2 ;; Load sin/cos ptrs
	loops_init_prefetch 768, 64, 2, rcx ;; 3 iters of 256
	yr3_3cl_six_reals_unfft_preload
c2a:	yr3_3cl_six_reals_unfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2a			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2a			;; Test loop counter
	bump	rsi, -4*dist64+12*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer

	loops_reset			;; 2 more iters of 256
	yr3_r3cl_three_complex_djbunfft_preload
c2b:	yr3_r3cl_three_complex_djbunfft rsi, 64, 4*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
	loops	64, c2b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*dist64+12*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*12*dist64	;; Restore source pointer

;; Do inverse FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	9216	+1	+1	+1
;;	4	...
;;	...
;;	9212

;; Do 3072 six_reals_unfft operations
;;	distance between fft data elements is 3072
;;	do 768 macros each processing 24 data values

	bump	rdi, -768*YMM_SCD2	;; Load sin/cos ptr
	bump	rcx, (1152-576-384-384)*64 ;; Move prefetch pointer along
	loops_init_prefetch 768, 64, 2, rcx ;; 768 iterations
	yr3_3cl_six_reals_unfft_preload
c1b:	yr3_3cl_six_reals_unfft rsi, 64, 12*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, c1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	12, c1b			;; Test loop counter

ypass2_9216_real_done:
	end_timer 2
	ENDM

; *************** radix4-pass2-9216-complex macro ******************
; This macro takes 9216 complex values and performs the final 13.585 levels of a standard
; radix-4 FFT, squares the results, and does the first 13.585 levels of the inverse FFT.

yr4dwpn_pass2_9216_complex MACRO
	LOCAL	b1b, b2b, b3a, b3b, b3c, b4a, b4b, b4c, b5a, b5b, b5c, b6a, b6b, b6c, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2b, c3b, c3c, c3d, c4b, c4c, c4d, c5b, c5c, c5d, c6b, c6c, c6d
	LOCAL	ypass2_9216_complex_1, ypass2_9216_complex_2
	LOCAL	ypass2_9216_complex_3, ypass2_9216_complex_4
	LOCAL	ypass2_9216_complex_unfft, ypass2_9216_complex_done

;; Type 4 FFTs skip the forward FFT process

	mov	rsi, DATA_ADDR		;; Load address of FFT data
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 2304 cache lines + 35 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_9216_complex_4

;; Do FFT level 1,2 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	9216	+1	+1	+1
;;	4	...
;;	...
;;	9212
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...

;; Do 3072 three_complex_fft operations
;;	distance between fft data elements is 3072
;;	do 768 macros each processing 24 data values

;; Do FFT levels 3,4 (actually 1.585 levels)
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 3072 three_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 24 data values

	start_timer 4
	mov	rdi, xsincos_complex	;; The sin/cos ptrs
	lea	rbp, [rdi+768*YMM_SCD1]
	loops_init_prefetch 768, 64, 3, rcx ;; 768 iterations

	yr3_f3cl_three_complex_djbfft_preload
b1b:	yr3_f3cl_three_complex_djbfft rsi, 4*dist64, 12*dist64, rdi
	bump	rdi, 256*YMM_SCD1	;; Next sin/cos data
	loops	3, b1b			;; Test loop counter
	bump	rsi, -3*4*dist64	;; Restore source pointer
	bump	rdi, -3*256*YMM_SCD1+YMM_SCD1 ;; Next sin/cos data
	loops_undo 3			;; Back up loop counter

;;	yr3_3cl_three_complex_djbfft_preload
b2b:	yr3_3cl_three_complex_djbfft rsi, 12*dist64, 4*dist64, rbp
	loops	3, b2b			;; Test loop counter
	bump	rbp, YMM_SCD1		;; Next sin/cos data

	bump	rsi, -3*12*dist64+64	;; Next source pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, b1b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -256*YMM_SCD1+768*YMM_SCD1+256*YMM_SCD1 ;; Next sin/cos ptr
	end_timer 4

;; Do FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_fft operations
;;	distance between fft data elements is 256
;;	do 576 macros each processing 32 data values

;; Do FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_fft operations
;;	distance between fft data elements is 64
;;	do 576 macros each processing 32 data values

;; Do FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_fft operations
;;	distance between fft data elements is 16
;;	do 576 macros each processing 32 data values

;; Do FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_fft operations
;;	distance between fft data elements is 4
;;	do 576 macros each processing 32 data values

;; Do FFT levels 13,14 as well as inverse FFT levels 13,14
;; On input and output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_fft operations
;;	distance between fft data elements is 1
;;	do 576 macros each processing 32 data values

;; Do inverse FFT levels 11,12
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	4	+512	+512	+512
;;	8	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_unfft operations
;;	distance between fft data elements is 4
;;	do 576 macros each processing 32 data values

;; Do inverse FFT levels 9,10
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	16	+512	+512	+512
;;	4	...
;;	...
;;	12	...
;;	32	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_unfft operations
;;	distance between fft data elements is 16
;;	do 576 macros each processing 32 data values

;; Do inverse FFT levels 7,8
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	64	+512	+512	+512
;;	4	...
;;	...
;;	60	...
;;	128	...
;;	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...

;; Do 2304 four_complex_unfft operations
;;	distance between fft data elements is 64
;;	do 576 macros each processing 32 data values

;; Do inverse FFT levels 5,6
;; On input the 64-byte cache lines hold these data values:
;;	0	+512	+512	+512	256	+512	+512	+512
;;	4	...
;;	...
;;	508	...
;;	1	...
;;	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...

;; Do 2304 four_complex_unfft operations
;;	distance between fft data elements is 256
;;	do 576 macros each processing 32 data values

;; Do this 256 cache lines (16KB) at a time to maximize accessing data
;; while it is in the L1 cache.

;; Execute the right middle step

	cmp	ffttype, 2
	jl	ypass2_9216_complex_1
	jg	ypass2_9216_complex_3

ypass2_9216_complex_2:
	start_timer 6
	loops_init_prefetch 576, 64, 4, rcx ;; 9 iters of 256 cache lines

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
;; Loop below reworked to avoid 4KB distances
;;b3b:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
;;	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
;;	loops	64, b3b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
b3b:	yr4_s4cl_four_complex_djbfft rsi, 4*64, dist64, 2*dist64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b3b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b3b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b4b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, b4b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, b4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b5b:	yr4_eb4cl_four_complex_djbfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, b5b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, b5b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbfft_preload
b6b:	yr4_eb4cl_four_complex_djbfft rsi, 4*64, 64, 2*64, rdi
	loops	16, b6b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, b6b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 16, rcx	;; prefetch 36 cache lines in this loop
	yr4_4cl_four_complex_with_square_preload
;; Loop below reworked to avoid 4KB distances
;;b7b:	yr4_4cl_four_complex_with_square rsi, 64, dist64, 2*dist64
;;	loops	64, b7b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
b7b:	yr4_4cl_four_complex_with_square rsi, 4*64, dist64, 2*dist64
	loops	16, b7b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	loops	4, b7b			;; Loop 4 times
	bump	rsi, -4*64		;; Restore source pointer
	loops_undo 64			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
	yr4_eb4cl_four_complex_djbunfft_preload
c6b:	yr4_eb4cl_four_complex_djbunfft rsi, 4*64, 64, 2*64, rdi
	loops	16, c6b			;; Loop 4 times
	bump	rsi, -16*4*64+dist64	;; Next source pointer
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, c6b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c5b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5b			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5b			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 4, rcx	;; prefetch 144 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4b:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c4b			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4b			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
;; Loop below reworked to avoid 4KB distances
;;c3b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, dist64, 2*dist64, rdi
;;	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
;;	loops	64, c3b			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
c3b:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, dist64, 2*dist64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3b			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c3b			;; Loop 4 times
;;	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -4*64+4*dist64	;; Next source pointer
	loops	9, b3b			;; Loop 9 times
	bump	rsi, -9*4*dist64	;; Restore source pointer
	end_timer 6
	jmp	ypass2_9216_complex_unfft


ypass2_9216_complex_1:
	start_timer 6
	bump	rcx, (2304+35-2*256-2*576-2*288-144)*64 ;; Move prefetch pointer along
	loops_init_prefetch 576, 64, 1, rcx ;; 9 iters of 256 cache lines

	loops_set_prefetch 64, 1, rcx	;; prefetch 576 cache lines in this loop
	yr4_s4cl_four_complex_djbfft_preload
;; Loop below reworked to avoid 4KB distances
;;b3a:	yr4_s4cl_four_complex_djbfft rsi, 64, dist64, 2*dist64, rdi
;;	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
;;	loops	64, b3a			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
