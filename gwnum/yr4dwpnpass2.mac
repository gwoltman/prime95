	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 2, rcx	;; prefetch 288 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c5d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 4*64, 8*64, rdi
	bump	rdi, 16*YMM_SCD2	;; Next sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*64+16*64	;; Next source pointer
	bump	rdi, -4*16*YMM_SCD2	;; Restore sine/cosine pointer
	loops	4, c5d			;; Loop 4 times
	bump	rsi, -4*16*64+dist64	;; Next source pointer
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	4, c5d			;; Test loop counter
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*4*4		;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 576 cache lines in this loop
;;	yr4_eb4cl_four_complex_djbunfft_preload
c4d:	yr4_eb4cl_four_complex_djbunfft rsi, 64, 16*64, 32*64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c4d			;; Loop 16 times
	bump	rsi, -16*64+dist64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c4d			;; Loop 4 times
	bump	rsi, -4*dist64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer
	loops_undo 4*16			;; Back up loop counter

	loops_set_prefetch 64, 1, rcx	;; prefetch 576 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
;; Loop below reworked to avoid 4KB distances
;;c3d:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
;;	bump	rdi, YMM_SCD2		;; Next sine/cosine pointer
;;	loops	64, c3d			;; Loop 64 times
;;	bump	rsi, -64*64		;; Restore source pointer
;;	bump	rdi, -64*YMM_SCD2	;; Restore sine/cosine pointer
c3d:	yr4_s4cl_four_complex_djbunfft rsi, 4*64, dist64, 2*dist64, rdi
	bump	rdi, 4*YMM_SCD2		;; Next sine/cosine pointer
	loops	16, c3d			;; Loop 16 times
	bump	rsi, -16*4*64+64	;; Next source pointer
	bump	rdi, -16*4*YMM_SCD2+YMM_SCD2 ;; Next sine/cosine pointer
	loops	4, c3d			;; Loop 4 times
;;	bump	rsi, -4*64		;; Restore source pointer
	bump	rdi, -4*YMM_SCD2	;; Restore sine/cosine pointer

	bump	rsi, -4*64+4*dist64	;; Next source pointer
	loops	9, b7d			;; Loop 9 times
	bump	rsi, -9*4*dist64	;; Restore source pointer
	bump	rcx, (-2*576-2*288-144+2*256+4*144+36+3*144+288)*64 ;; Move prefetch pointer to where squaring would be
	end_timer 6

;; Do inverse FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	1024	+1	+1	+1
;;	4	...
;;	...
;;	1020	...
;;	2048	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...

;; Do 3072 three_complex_unfft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 24 data values

;; Do inverse FFT levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	3072	+1	+1	+1
;;	4	...
;;	...
;;	3068	...
;;	6144	...
;;	...
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	9216	+1	+1	+1
;;	4	...
;;	...
;;	9212

;; Do 3072 three_complex_unfft operations
;;	distance between fft data elements is 3072
;;	do 768 macros each processing 24 data values

ypass2_9216_complex_unfft:
	start_timer 13
	mov	rdi, xsincos_complex	;; Load sin/cos pointers
	lea	rbp, [rdi+768*YMM_SCD1]
	bump	rcx, (2304+35-2*256-4*144-36-3*144-288-2*256)*64 ;; Move prefetch pointer along
	loops_init_prefetch 768, 64, 3, rcx ;; 768 iterations

	yr3_3cl_three_complex_djbunfft_preload
c2b:	yr3_3cl_three_complex_djbunfft rsi, 12*dist64, 4*dist64, rbp
	loops	3, c2b			;; Test loop counter
	bump	rsi, -3*12*dist64	;; Restore source pointer
	bump	rbp, YMM_SCD1		;; Next sine/cosine pointer
	loops_undo 3			;; Restore loop counter

;;	yr3_3cl_three_complex_djbunfft_preload
c1b:	yr3_3cl_three_complex_djbunfft rsi, 4*dist64, 12*dist64, rdi
	bump	rdi, 256*YMM_SCD1	;; Next set of sin/cos data
	loops	3, c1b			;; Test loop counter
;;	bump	rsi, -3*4*dist64		;; Restore source pointer
	bump	rdi, -3*256*YMM_SCD1+YMM_SCD1 ;; Next sine/cosine pointer

	bump	rsi, -3*4*dist64+64	;; Next source pointer
	loops	64, c2b			;; Loop 64 times
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	4, c2b			;; Loop 4 times
	end_timer 13

ypass2_9216_complex_done:
	ENDM


; *************** radix4-pass2-12288-real macro ******************
; This macro takes 24576 real values and performs the final 14.585 levels of the FFT.
; The results are squared, and the first 14.585 levels of the inverse FFT are done.

yr4dwpn_pass2_12288_real MACRO
	LOCAL	b1b, b2a, b2b, b3a, b3b, b4a, b4b, b5a, b5b, b6a, b6b, b7a, b7b, b7c, b7d
	LOCAL	c1b, c2a, c2b, c3a, c3b, c4a, c4b, c5a, c5b, c6a, c6b
	LOCAL	ypass2_12288_real_1, ypass2_12288_real_2
	LOCAL	ypass2_12288_real_3, ypass2_12288_real_4
	LOCAL	ypass2_12288_real_unfft, ypass2_12288_real_done

;; Type 4 FFTs skip the forward FFT process

	start_timer 2
	mov	rsi, DATA_ADDR		;; Load source address
	mov	rbx, DIST_TO_FFTSRCARG
	mov	rcx, DATA_PREFETCH	;; Prefetch pointer (we need to prefetch 
					;; 3072 cache lines + 47 pad cache lines)
	cmp	ffttype, 4
	je	ypass2_12288_real_4

;; Do FFT levels 1,2,3 which correspond to complex levels 1,2
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	12288	+1	+1	+1
;;	4	...
;;	...
;;	12284
;; On output the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...

;; Do 4096 six_reals_fft operations
;;	distance between fft data elements is 4096
;;	do 1024 macros each processing 24 data values

	mov	rdi, sincos3		;; Load sin/cos pointer
	loops_init_prefetch 1024, 64, 2, rcx ;; 1024 iterations
	yr3_f3cl_six_reals_fft_preload
b1b:	yr3_f3cl_six_reals_fft rsi, 64, 16*dist64, rdi
	bump	rdi, YMM_SCD2		;; Next sin/cos pointer
	loops	64, b1b			;; Test loop counter
	bump	rsi, -64*64+dist64	;; Next source pointer
	loops	16, b1b			;; Test loop counter
	bump	rsi, -16*dist64		;; Restore source pointer

;; Do FFT levels 3,4
;; On input the 64-byte cache lines hold these data values:
;;	0	+1	+1	+1	4096	+1	+1	+1
;;	4	...
;;	...
;;	4092	...
;;	8192	...
;;	...
;; On output the 64-byte cache lines are swizzled to hold these data values:
;;	0	+2K	+2K	+2K	1024	+2K	+2K	+2K
;;	4	...
;;	...
;;	1020	...
;;	1	...
;;	...
;;	8192	...
;;	...

;; Do 1024 eight_reals_fft operations
;; Do 2048 four_complex_fft operations
;;	distance between fft data elements is 1024
;;	do 768 macros each processing 32 data values

	mov	rdx, rdi		;; Load sin/cos ptrs
	lea	rdi, [rdx+256*YMM_SCD2]
	loops_init_prefetch 768, 64, 2, rcx ;; 3 iterations of 256
