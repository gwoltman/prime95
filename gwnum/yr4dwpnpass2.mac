	loops_set_prefetch 64, 2, rcx	;; prefetch 480 cache lines in this loop
;;	yr4_s4cl_four_complex_djbunfft_preload
;; Loop below reworked to avoid 4KB distances
;;c3b:	yr4_s4cl_four_complex_djbunfft rsi, 64, dist64, 2*dist64, rdi
