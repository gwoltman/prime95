	loops	4, c2b			;; Test loop counter
	bump	rsi, -4*dist64+16*dist64 ;; Next source pointer
	bump	rdi, -256*YMM_SCD2	;; Restore sine/cosine pointer
	loops	5, c2b			;; Test loop counter
