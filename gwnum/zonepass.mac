; ********************************************************
; ********************  FFT MACROS  **********************
; ********************************************************
; ********************************************************

;; Wrapper macro that takes two reals, swizzles data, and applies weights.  Output will be suitable for use by a pass 2 FFT macro.
;; NOTE: The r1/r9 col multiplier is 1.0 thus there are no fudges to apply to R1/R9

zsf_onepass_real_fft_wrapper_preload MACRO
	vbroadcastsd zmm28, ZMM_ONE_OVER_B
	ENDM
zsf_onepass_real_fft_wrapper MACRO srcreg,srcinc,d1,d2,d4,colreg,colinc,maskreg,maskinc,grpreg,grpinc,maxrpt,L1pt,L1pd
	vmovapd zmm30, [grpreg+0*64]		;; group multiplier for R1-R8
	vmulpd	zmm14, zmm30, [srcreg+rbx]	;; apply the group multiplier to R1			; 1-4		n ??
	vmulpd	zmm2, zmm30, [srcreg+rbx+d1]	;; apply the group multiplier to R2			; 1-4		n 5

	vmulpd	zmm10, zmm30, [srcreg+rbx+d2]	;; apply the group multiplier to R3			; 2-5		n 6
	vmulpd	zmm6, zmm30, [srcreg+rbx+d2+d1]	;; apply the group multiplier to R4			; 2-5		n 7

	vmulpd	zmm16, zmm30, [srcreg+rbx+d4]	;; apply the group multiplier to R5			; 3-6		n 8
	vmulpd	zmm8, zmm30, [srcreg+rbx+d4+d1]	;; apply the group multiplier to R6			; 3-6		n 9

	vmulpd	zmm12, zmm30, [srcreg+rbx+d4+d2];; apply the group multiplier to R7			; 4-7		n 10
	vmulpd	zmm4, zmm30, [srcreg+rbx+d4+d2+d1];; apply the group multiplier to R8			; 4-7		n 11

	vmovapd zmm20, [grpreg+1*64]		;; group multiplier for R9-R16
	vbroadcastsd zmm30, [colreg+1*8]	;; Load col multiplier for R2/R10
	vmulpd	zmm2, zmm2, zmm30		;; apply the col multiplier to R2			; 5-8		n 13
	vmulpd	zmm21, zmm20, zmm30		;; unfudged multiplier for R10				; 5-8		n 14

	vbroadcastsd zmm30, [colreg+2*8]	;; Load col multiplier for R3/R11
	vmulpd	zmm10, zmm10, zmm30		;; apply the col multiplier to R3			; 6-9		n 15
	vmulpd	zmm22, zmm20, zmm30		;; unfudged multiplier for R11				; 6-9		n 16

	vbroadcastsd zmm30, [colreg+3*8]	;; Load col multiplier for R4/R12
	vmulpd	zmm6, zmm6, zmm30		;; apply the col multiplier to R4			; 7-10		n 17
	vmulpd	zmm23, zmm20, zmm30		;; unfudged multiplier for R12				; 7-10		n 18

	vbroadcastsd zmm30, [colreg+4*8]	;; Load col multiplier for R5/R13
	vmulpd	zmm16, zmm16, zmm30		;; apply the col multiplier to R5			; 8-11		n 23
	vmulpd	zmm24, zmm20, zmm30		;; unfudged multiplier for R13				; 8-11		n 24

	vbroadcastsd zmm30, [colreg+5*8]	;; Load col multiplier for R6/R14
	vmulpd	zmm8, zmm8, zmm30		;; apply the col multiplier to R6			; 9-12		n 29
	vmulpd	zmm25, zmm20, zmm30		;; unfudged multiplier for R14				; 9-12		n 30

	vbroadcastsd zmm30, [colreg+6*8]	;; Load col multiplier for R7/R15
	vmulpd	zmm12, zmm12, zmm30		;; apply the col multiplier to R7			; 10-13		n 31
	vmulpd	zmm26, zmm20, zmm30		;; unfudged multiplier for R15				; 10-13		n 32

	mov	r13, [maskreg+0*8]		;; Load uncompressed fudge flags
	vbroadcastsd zmm30, [colreg+7*8]	;; Load col multiplier for R8/R16
	kmovw	k3, r13d			;; Load R2 and R10 fudge factor mask			; 11		n 12
	vmulpd	zmm4, zmm4, zmm30		;; apply the col multiplier to R8			; 11-14		n 33
	shr	r13, 16				;; Next 16 bits of fudge flags

	kshiftrw k4, k3, 8			;; R10's fudge						; 12		n 14
	vmulpd	zmm27, zmm20, zmm30		;; unfudged multiplier for R16				; 12-15		n 34
	mov	r14, [maskreg+1*8]		;; Load uncompressed fudge flags
	bump	maskreg, maskinc

	kmovw	k1, r13d			;; Load R3 and R11 fudge factor mask			; 13		n 14
	vmulpd	zmm2{k3}, zmm2, zmm28		;; apply fudge to R2					; 13-16		n 20
	shr	r13, 16				;; Next 16 bits of fudge flags

	kshiftrw k2, k1, 8			;; R11's fudge						; 14		n 16
	vmulpd	zmm21{k4}, zmm21, zmm28		;; fudged multiplier for R10				; 14-17		n 20
	bump	grpreg, grpinc

	kmovw	k3, r13d			;; Load R4 and R12 fudge factor mask			; 15		n 16
	vmulpd	zmm10{k1}, zmm10, zmm28		;; apply fudge to R3					; 15-18		n 21
	shr	r13, 16				;; Next 16 bits of fudge flags
	bump	colreg, colinc

	kshiftrw k4, k3, 8			;; R12's fudge						; 16		n 18
	vmulpd	zmm22{k2}, zmm22, zmm28		;; fudged multiplier for R11				; 16-19		n 21

	kmovw	k1, r13d			;; Load R5 and R13 fudge factor mask			; 17		n 18
	vmulpd	zmm6{k3}, zmm6, zmm28		;; apply fudge to R4					; 17-20		n 22
	vmovapd	zmm17, [srcreg+rbx+64]		;; r9

	kshiftrw k2, k1, 8			;; R13's fudge						; 18		n 24
	vmulpd	zmm23{k4}, zmm23, zmm28		;; fudged multiplier for R12				; 18-21		n 22
	vmovapd	zmm18, [srcreg+rbx+d1+64]	;; r10

	kmovw	k3, r14d			;; Load R6 and R14 fudge factor mask			; 19		n 20
	zfmaddpd zmm13, zmm17, zmm20, zmm14	;; r1+r9*group_mult					; 19-22		n 25
	shr	r14, 16				;; Next 16 bits of fudge flags
	vmovapd	zmm0, [srcreg+rbx+d2+64]	;; r11

	kshiftrw k4, k3, 8			;; R14's fudge						; 20		n 30
	zfmaddpd zmm1, zmm18, zmm21, zmm2	;; r2+r10*fudged_mult					; 20-23		n 25
	vmovapd	zmm19, [srcreg+rbx+d2+d1+64]	;; r12

	kmovw	k5, r14d			;; Load R7 and R15 fudge factor mask			; 21		n 22
	zfmaddpd zmm9, zmm0, zmm22, zmm10	;; r3+r11*fudged_mult					; 21-24		n 27
	shr	r14, 16				;; Next 16 bits of fudge flags
	vmovapd	zmm29, [srcreg+rbx+d4+64]	;; r13

	kshiftrw k6, k5, 8			;; R15's fudge						; 22		n 32
	zfmaddpd zmm5, zmm19, zmm23, zmm6	;; r4+r12*fudged_mult					; 22-25		n 27
	L1prefetch srcreg+L1pd, L1pt

	kmovw	k7, r14d			;; Load R8 and R16 fudge factor mask			; 23		n 24
	vmulpd	zmm16{k1}, zmm16, zmm28		;; apply fudge to R5					; 23-26		n 35
	L1prefetch srcreg+64+L1pd, L1pt

	kshiftrw k1, k7, 8			;; R16's fudge						; 24		n 34
	vmulpd	zmm24{k2}, zmm24, zmm28		;; fudged multiplier for R13				; 24-27		n 35

;;	zscatter srcreg,d1,d2,d4,zmm13,zmm1,zmm3,zmm9,zmm15,zmm7,zmm11,zmm3,zmm31
;;	zscatter srcreg+64,d1,d2,d4,zmm14,zmm2,zmm4,zmm10,zmm16,zmm8,zmm12,zmm6,zmm30

	vshufpd	zmm31, zmm13, zmm1, 00000000b	;; d1_6 d0_6 d1_4 d0_4 d1_2 d0_2 d1_0 d0_0 R1/R2	; 25		n 29
	zfnmaddpd zmm14, zmm17, zmm20, zmm14	;; r1-r9*group_mult					; 25-28		n 33
	vmovapd	zmm17, [srcreg+rbx+d4+d1+64]	;; r14

	vshufpd	zmm13, zmm13, zmm1, 11111111b	;; d1_7 d0_7 d1_5 d0_5 d1_3 d0_3 d1_1 d0_1 R1/R2	; 26		n 31
	zfnmaddpd zmm2, zmm18, zmm21, zmm2	;; r2-r10*fudged_mult					; 26-29		n 33
	vmovapd	zmm20, [srcreg+rbx+d4+d2+64]	;; r15

	vshufpd	zmm1, zmm9, zmm5, 00000000b	;; d3_6 d2_6 d3_4 d2_4 d3_2 d2_2 d3_0 d2_0 R3/R4	; 27		n 29
	zfnmaddpd zmm10, zmm0, zmm22, zmm10	;; r3-r11*fudged_mult					; 27-30		n 35
	vmovapd	zmm18, [srcreg+rbx+d4+d2+d1+64]	;; r16

	vshufpd	zmm9, zmm9, zmm5, 11111111b	;; d3_7 d2_7 d3_5 d2_5 d3_3 d2_3 d3_1 d2_1 R3/R4	; 28		n 31
	zfnmaddpd zmm6, zmm19, zmm23, zmm6	;; r4-r12*fudged_mult					; 28-31		n 35
	L1prefetch srcreg+d1+L1pd, L1pt

	vshuff64x2 zmm5, zmm31, zmm1, 10001000b ;; d3_4 d2_4 d3_0 d2_0 d1_4 d0_4 d1_0 d0_0		; 29-31		n 53
	vmulpd	zmm8{k3}, zmm8, zmm28		;; apply fudge to R6					; 29-32		n 36
	L1prefetch srcreg+d1+64+L1pd, L1pt

	vshuff64x2 zmm31, zmm31, zmm1, 11011101b ;; d3_6 d2_6 d3_2 d2_2 d1_6 d0_6 d1_2 d0_2		; 30-32		n 55
	vmulpd	zmm25{k4}, zmm25, zmm28		;; fudged multiplier for R14				; 30-33		n 36
	L1prefetch srcreg+d2+L1pd, L1pt

	vshuff64x2 zmm1, zmm13, zmm9, 10001000b ;; d3_5 d2_5 d3_1 d2_1 d1_5 d0_5 d1_1 d0_1		; 31-33		n 57
	vmulpd	zmm12{k5}, zmm12, zmm28		;; apply fudge to R7					; 31-34		n 39
	L1prefetch srcreg+d2+64+L1pd, L1pt

	vshuff64x2 zmm13, zmm13, zmm9, 11011101b ;; d3_7 d2_7 d3_3 d2_3 d1_7 d0_7 d1_3 d0_3		; 32-34		n 59
	vmulpd	zmm26{k6}, zmm26, zmm28		;; fudged multiplier for R15				; 32-35		n 39
	L1prefetch srcreg+d2+d1+L1pd, L1pt

	vshufpd	zmm30, zmm14, zmm2, 00000000b	;; d1_6 d0_6 d1_4 d0_4 d1_2 d0_2 d1_0 d0_0 R9/R10	; 33		n 37
	vmulpd	zmm4{k7}, zmm4, zmm28		;; apply fudge to R8					; 33-36		n 40
	L1prefetch srcreg+d2+d1+64+L1pd, L1pt

	vshufpd	zmm14, zmm14, zmm2, 11111111b	;; d1_7 d0_7 d1_5 d0_5 d1_3 d0_3 d1_1 d0_1 R9/R10	; 34		n 39
	vmulpd	zmm27{k1}, zmm27, zmm28		;; fudged multiplier for R16				; 34-37		n 40
	L1prefetch srcreg+d4+L1pd, L1pt

	vshufpd	zmm2, zmm10, zmm6, 00000000b	;; d3_6 d2_6 d3_4 d2_4 d3_2 d2_2 d3_0 d2_0 R11/R12	; 35		n 37
	zfmaddpd zmm15, zmm29, zmm24, zmm16	;; r5+r13*fudged_mult					; 35-38		n 41
	L1prefetch srcreg+d4+64+L1pd, L1pt

	vshufpd	zmm10, zmm10, zmm6, 11111111b	;; d3_7 d2_7 d3_5 d2_5 d3_3 d2_3 d3_1 d2_1 R11/R12	; 36		n 39
	zfmaddpd zmm7, zmm17, zmm25, zmm8	;; r6+r14*fudged_mult					; 36-39		n 41
	L1prefetch srcreg+d4+d1+L1pd, L1pt

	vshuff64x2 zmm6, zmm30, zmm2, 10001000b ;; d3_4 d2_4 d3_0 d2_0 d1_4 d0_4 d1_0 d0_0		; 37-39		n 65
	zfnmaddpd zmm16, zmm29, zmm24, zmm16	;; r5-r13*fudged_mult					; 37-40		n 43
	L1prefetch srcreg+d4+d1+64+L1pd, L1pt

	vshuff64x2 zmm30, zmm30, zmm2, 11011101b ;; d3_6 d2_6 d3_2 d2_2 d1_6 d0_6 d1_2 d0_2		; 38-40		n 67
	zfnmaddpd zmm8, zmm17, zmm25, zmm8	;; r6-r14*fudged_mult					; 38-41		n 43
	L1prefetch srcreg+d4+d2+L1pd, L1pt

	vshuff64x2 zmm2, zmm14, zmm10, 10001000b ;; d3_5 d2_5 d3_1 d2_1 d1_5 d0_5 d1_1 d0_1		; 39-41		n 69
	zfmaddpd zmm11, zmm20, zmm26, zmm12	;; r7+r15*fudged_mult					; 39-42		n 45
	L1prefetch srcreg+d4+d2+64+L1pd, L1pt

	vshuff64x2 zmm14, zmm14, zmm10, 11011101b ;; d3_7 d2_7 d3_3 d2_3 d1_7 d0_7 d1_3 d0_3		; 40-42		n 71
	zfmaddpd zmm3, zmm18, zmm27, zmm4	;; r8+r16*fudged_mult					; 40-43		n 45
	L1prefetch srcreg+d4+d2+d1+L1pd, L1pt

	vshufpd	zmm9, zmm15, zmm7, 00000000b	;; d5_6 d4_6 d5_4 d4_4 d5_2 d4_2 d5_0 d4_0 R5/R6	; 41		n 49
	zfnmaddpd zmm12, zmm20, zmm26, zmm12	;; r7-r15*fudged_mult					; 41-44		n 47
	L1prefetch srcreg+d4+d2+d1+64+L1pd, L1pt

	vshufpd	zmm15, zmm15, zmm7, 11111111b	;; d5_7 d4_7 d5_5 d4_5 d5_3 d4_3 d5_1 d4_1 R5/R6	; 42		n 51
	zfnmaddpd zmm4, zmm18, zmm27, zmm4	;; r8-r16*fudged_mult					; 42-45		n 47

	vshufpd	zmm10, zmm16, zmm8, 00000000b	;; d5_6 d4_6 d5_4 d4_4 d5_2 d4_2 d5_0 d4_0 R13/R14	; 43		n 61
	vshufpd	zmm16, zmm16, zmm8, 11111111b	;; d5_7 d4_7 d5_5 d4_5 d5_3 d4_3 d5_1 d4_1 R13/R14	; 44		n 63

	vshufpd	zmm7, zmm11, zmm3, 00000000b	;; d7_6 d6_6 d7_4 d6_4 d7_2 d6_2 d7_0 d6_0 R7/R8	; 45		n 49
	vshufpd	zmm11, zmm11, zmm3, 11111111b	;; d7_7 d6_7 d7_5 d6_5 d7_3 d6_3 d7_1 d6_1 R7/R8	; 46		n 51

	vshufpd	zmm8, zmm12, zmm4, 00000000b	;; d7_6 d6_6 d7_4 d6_4 d7_2 d6_2 d7_0 d6_0 R15/R16	; 47		n 61
	vshufpd	zmm12, zmm12, zmm4, 11111111b	;; d7_7 d6_7 d7_5 d6_5 d7_3 d6_3 d7_1 d6_1 R15/R16	; 48		n 63

	vshuff64x2 zmm3, zmm9, zmm7, 10001000b ;; d7_4 d6_4 d7_0 d6_0 d5_4 d4_4 d5_0 d4_0		; 49-51		n 53
	vshuff64x2 zmm9, zmm9, zmm7, 11011101b ;; d7_6 d6_6 d7_2 d6_2 d5_6 d4_6 d5_2 d4_2		; 50-52		n 55
	vshuff64x2 zmm7, zmm15, zmm11, 10001000b ;; d7_5 d6_5 d7_1 d6_1 d5_5 d4_5 d5_1 d4_1		; 51-53		n 57
	vshuff64x2 zmm15, zmm15, zmm11, 11011101b ;; d7_7 d6_7 d7_3 d6_3 d5_7 d4_7 d5_3 d4_3		; 52-54		n 59

	vshuff64x2 zmm11, zmm5, zmm3, 10001000b ;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0		; 53-55
	vshuff64x2 zmm5, zmm5, zmm3, 11011101b ;; d7_4 d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4		; 54-56
	vshuff64x2 zmm3, zmm31, zmm9, 10001000b ;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1		; 55-57
	vshuff64x2 zmm31, zmm31, zmm9, 11011101b ;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5		; 56-58
	zstore	[srcreg], zmm11										; 56

	vshuff64x2 zmm9, zmm1, zmm7, 10001000b ;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2		; 57-59
	zstore	[srcreg+d4], zmm5									; 57

	vshuff64x2 zmm1, zmm1, zmm7, 11011101b ;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6		; 58-60
	zstore	[srcreg+d2], zmm3									; 58

	vshuff64x2 zmm7, zmm13, zmm15, 10001000b ;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3		; 59-61
	zstore	[srcreg+d4+d2], zmm31									; 59

	vshuff64x2 zmm13, zmm13, zmm15, 11011101b ;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7		; 60-62
	zstore	[srcreg+d1], zmm9									; 60

	vshuff64x2 zmm4, zmm10, zmm8, 10001000b ;; d7_4 d6_4 d7_0 d6_0 d5_4 d4_4 d5_0 d4_0		; 61-63		n 65
	zstore	[srcreg+d4+d1], zmm1									; 61

	vshuff64x2 zmm10, zmm10, zmm8, 11011101b ;; d7_6 d6_6 d7_2 d6_2 d5_6 d4_6 d5_2 d4_2		; 62-64		n 67
	zstore	[srcreg+d2+d1], zmm7									; 62

	vshuff64x2 zmm8, zmm16, zmm12, 10001000b ;; d7_5 d6_5 d7_1 d6_1 d5_5 d4_5 d5_1 d4_1		; 63-65		n 69
	zstore	[srcreg+d4+d2+d1], zmm13								; 63

	vshuff64x2 zmm16, zmm16, zmm12, 11011101b ;; d7_7 d6_7 d7_3 d6_3 d5_7 d4_7 d5_3 d4_3		; 64-66		n 71

	vshuff64x2 zmm12, zmm6, zmm4, 10001000b ;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0		; 65-67
	vshuff64x2 zmm6, zmm6, zmm4, 11011101b ;; d7_4 d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4		; 66-68
	vshuff64x2 zmm4, zmm30, zmm10, 10001000b ;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1		; 67-69
	vshuff64x2 zmm30, zmm30, zmm10, 11011101b ;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5		; 68-70
	zstore	[srcreg+64], zmm12									; 68

	vshuff64x2 zmm10, zmm2, zmm8, 10001000b ;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2		; 69-71
	zstore	[srcreg+d4+64], zmm6									; 69

	vshuff64x2 zmm2, zmm2, zmm8, 11011101b ;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6		; 70-72
	zstore	[srcreg+d2+64], zmm4									; 70

	vshuff64x2 zmm8, zmm14, zmm16, 10001000b ;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3		; 71-73
	zstore	[srcreg+d4+d2+64], zmm30								; 71

	vshuff64x2 zmm14, zmm14, zmm16, 11011101b ;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7		; 72-74
	zstore	[srcreg+d1+64], zmm10									; 72

	zstore	[srcreg+d4+d1+64], zmm2									; 73
	zstore	[srcreg+d2+d1+64], zmm8									; 74
	zstore	[srcreg+d4+d2+d1+64], zmm14								; 75
	bump	srcreg, srcinc
	ENDM


;; Wrapper macro that takes two reals, swizzles data, and applies weights.  Output will be suitable for use by a pass 2 FFT macro.
;; This version does more loads so that we can use vblendmpd and vbroadcastf64x4 instead of vshuff64x2.
;; The former can run on ports 0 & 5 whereas the latter only runs on port 5.
;; NOTE: The r1/r9 inverse col multiplier is 1.0 thus there are no fudges to apply to R1/R9

zs_onepass_real_unfft_wrapper_preload MACRO
	mov	r14d, 11110000b
	kmovw	k6, r14d
	knotw	k7, k6
	vbroadcastsd zmm28, ZMM_B
	ENDM
zs_onepass_real_unfft_wrapper MACRO srcreg,srcinc,d1,d2,d4,colreg,colinc,maskreg,maskinc,maxrpt,L1pt,L1pd
	vmovapd	zmm15, [srcreg]				;; d0_7	d0_6 d0_5 d0_4 d0_3 d0_2 d0_1 d0_0
	vmovapd	zmm16, [srcreg+d1]			;; d1_7	d1_6 d1_5 d1_4 d1_3 d1_2 d1_1 d1_0
	vbroadcastf64x4	zmm15{k6}, [srcreg+d2]		;; d2_3 d2_2 d2_1 d2_0 d0_3 d0_2 d0_1 d0_0		; 1		n 2
	vbroadcastf64x4	zmm16{k6}, [srcreg+d2+d1]	;; d3_3 d3_2 d3_1 d3_0 d1_3 d1_2 d1_1 d1_0		; 1		n 2

	vmovapd	zmm2, [srcreg+d4]			;; d4_7	d4_6 d4_5 d4_4 d4_3 d4_2 d4_1 d4_0
	vshufpd	zmm5, zmm15, zmm16, 00000000b		;; d3_2 d2_2 d3_0 d2_0 d1_2 d0_2 d1_0 d0_0		; 2		n 10
	vbroadcastf64x4	zmm2{k6}, [srcreg+d4+d2]	;; d6_3 d6_2 d6_1 d6_0 d4_3 d4_2 d4_1 d4_0		; 2		n 4

	vmovapd	zmm8, [srcreg+d4+d1]			;; d5_7	d5_6 d5_5 d5_4 d5_3 d5_2 d5_1 d5_0
	vshufpd	zmm16, zmm15, zmm16, 11111111b		;; d3_3 d2_3 d3_1 d2_1 d1_3 d0_3 d1_1 d0_1		; 3		n 12
	vbroadcastf64x4	zmm8{k6}, [srcreg+d4+d2+d1]	;; d7_3 d7_2 d7_1 d7_0 d5_3 d5_2 d5_1 d5_0		; 3		n 4

	vmovapd	zmm3, [srcreg+d2]			;; d2_7	d2_6 d2_5 d2_4 d2_3 d2_2 d2_1 d2_0
	vmovupd	zmm17, [srcreg+32]			;; (+64 d0_3 d0_2 d0_1 d0_0) d0_7 d0_6 d0_5 d0_4
	vshufpd	zmm15, zmm2, zmm8, 00000000b		;; d7_2 d6_2 d7_0 d6_0 d5_2 d4_2 d5_0 d4_0		; 4		n 10
	vblendmpd zmm3{k6}, zmm17, zmm3			;; d2_7 d2_6 d2_5 d2_4 d0_7 d0_6 d0_5 d0_4		; 4		n 6

	vmovapd	zmm31, [srcreg+d2+d1]			;; d3_7	d3_6 d3_5 d3_4 d3_3 d3_2 d3_1 d3_0
	vmovupd	zmm18, [srcreg+d1+32]			;; (+64 d1_3 d1_2 d1_1 d1_0) d1_7 d1_6 d1_5 d1_4
	vshufpd	zmm8, zmm2, zmm8, 11111111b		;; d7_3 d6_3 d7_1 d6_1 d5_3 d4_3 d5_1 d4_1		; 5		n 12
	vblendmpd zmm31{k6}, zmm18, zmm31		;; d3_7 d3_6 d3_5 d3_4 d1_7 d1_6 d1_5 d1_4		; 5		n 6

	vmovapd	zmm7, [srcreg+d4+d2]			;; d6_7	d6_6 d6_5 d6_4 d6_3 d6_2 d6_1 d6_0
	vmovupd	zmm19, [srcreg+d4+32]			;; (+64 d4_3 d4_2 d4_1 d4_0) d4_7 d4_6 d4_5 d4_4
	vshufpd	zmm2, zmm3, zmm31, 00000000b		;; d3_6 d2_6 d3_4 d2_4 d1_6 d0_6 d1_4 d0_4		; 6		n 14
	vblendmpd zmm7{k6}, zmm19, zmm7			;; d6_7	d6_6 d6_5 d6_4 d4_7 d4_6 d4_5 d4_4		; 6		n 8

	vmovapd	zmm14, [srcreg+d4+d2+d1]		;; d7_7	d7_6 d7_5 d7_4 d7_3 d7_2 d7_1 d7_0
	vmovupd zmm29, [srcreg+d4+d1+32]		;; (+64 d5_3 d5_2 d5_1 d5_0) d5_7 d5_6 d5_5 d5_4
	vshufpd	zmm31, zmm3, zmm31, 11111111b		;; d3_7 d2_7 d3_5 d2_5 d1_7 d0_7 d1_5 d0_5		; 7		n 16
	vblendmpd zmm14{k6}, zmm29, zmm14		;; d7_7	d7_6 d7_5 d7_4 d5_7 d5_6 d5_5 d5_4		; 7		n 8

	vmovapd	zmm9, [srcreg+d2+64]			;; (+64 d2_7 d2_6 d2_5 d2_4 d2_3 d2_2 d2_1 d2_0)
	vshufpd	zmm3, zmm7, zmm14, 00000000b		;; d7_6 d6_6 d7_4 d6_4 d5_6 d4_6 d5_4 d4_4		; 8		n 14
	vblendmpd zmm9{k6}, zmm9, zmm17			;; (+64 d0_3 d0_2 d0_1 d0_0 d2_3 d2_2 d2_1 d2_0)	; 8		n 18

	vmovapd	zmm11, [srcreg+d2+d1+64]		;; (+64 d3_7 d3_6 d3_5 d3_4 d3_3 d3_2 d3_1 d3_0)
	vshufpd	zmm14, zmm7, zmm14, 11111111b		;; d7_7 d6_7 d7_5 d6_5 d5_7 d4_7 d5_5 d4_5		; 9		n 16
	vblendmpd zmm11{k6}, zmm11, zmm18		;; (+64 d1_3 d1_2 d1_1 d1_0 d3_3 d3_2 d3_1 d3_0)	; 9		n 18

	vmovapd	zmm13, [srcreg+d4+d2+64]		;; (+64 d6_7 d6_6 d6_5 d6_4 d6_3 d6_2 d6_1 d6_0)
	vshuff64x2 zmm7, zmm5, zmm15, 10001000b		;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0 (R1)		; 10-12		n 16
	vblendmpd zmm13{k6}, zmm13, zmm19		;; (+64 d4_3 d4_2 d4_1 d4_0 d6_3 d6_2 d6_1 d6_0)	; 10		n 20

	vmovapd	zmm12, [srcreg+d4+d2+d1+64]		;; (+64 d7_7 d7_6 d7_5 d7_4 d7_3 d7_2 d7_1 d7_0)
	vshuff64x2 zmm15, zmm5, zmm15, 11011101b	;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2 (R3)		; 11-13		n 16
	vblendmpd zmm12{k6}, zmm12, zmm29		;; (+64 d5_3 d5_2 d5_1 d5_0 d7_3 d7_2 d7_1 d7_0)	; 11		n 20

	vmovapd	zmm10, [srcreg+64]			;; (+64 d0_7 d0_6 d0_5 d0_4 d0_3 d0_2 d0_1 d0_0)
	vshuff64x2 zmm5, zmm16, zmm8, 10001000b		;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1 (R2)		; 12-14		n 17
	vbroadcastf64x4	zmm10{k7}, [srcreg+d2+64+32]	;; (+64 d0_7 d0_6 d0_5 d0_4 d2_7 d2_6 d2_5 d2_4)	; 12		n 22

	vmovapd	zmm30, [srcreg+d1+64]			;; (+64 d1_7 d1_6 d1_5 d1_4 d1_3 d1_2 d1_1 d1_0)
	vshuff64x2 zmm8, zmm16, zmm8, 11011101b		;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3 (R4)		; 13-15		n 18
	vbroadcastf64x4	zmm30{k7}, [srcreg+d2+d1+64+32]	;; (+64 d1_7 d1_6 d1_5 d1_4 d3_7 d3_6 d3_5 d3_4)	; 13		n 22
	zstore	[srcreg], zmm7				;; Save R1						; 13

	vmovapd	zmm1, [srcreg+d4+64]			;; (+64 d4_7 d4_6 d4_5 d4_4 d4_3 d4_2 d4_1 d4_0)
	vshuff64x2 zmm16, zmm2, zmm3, 10001000b		;; d7_4	d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4 (R5)		; 14-16		n 19
	vbroadcastf64x4	zmm1{k7}, [srcreg+d4+d2+64+32]	;; (+64 d4_7 d4_6 d4_5 d4_4 d6_7 d6_6 d6_5 d6_4)	; 14		n 24

	vmovapd	zmm6, [srcreg+d4+d1+64]			;; (+64 d5_7 d5_6 d5_5 d5_4 d5_3 d5_2 d5_1 d5_0)
	vshuff64x2 zmm3, zmm2, zmm3, 11011101b		;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6 (R7)		; 15-17		n 20
	vbroadcastf64x4	zmm6{k7}, [srcreg+d4+d2+d1+64+32];;(+64 d5_7 d5_6 d5_5 d5_4 d7_7 d7_6 d7_5 d7_4)	; 15		n 24

	vbroadcastsd zmm22, [colreg+2*8]		;; Load the inverse col multiplier for R3/R11
	vshuff64x2 zmm2, zmm31, zmm14, 10001000b	;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5 (R6)		; 16-18		n 21
	vmulpd	zmm15, zmm15, zmm22			;; apply the inverse col multiplier to R3		; 16-19		n 37

	vbroadcastsd zmm21, [colreg+1*8]		;; Load the inverse col multiplier for R2/R10
	vshuff64x2 zmm14, zmm31, zmm14, 11011101b	;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7 (R8)		; 17-19		n 22
	vmulpd	zmm5, zmm5, zmm21			;; apply the inverse col multiplier to R2		; 17-20		n 36

	vbroadcastsd zmm23, [colreg+3*8]		;; Load the inverse col multiplier for R4/R12
	vshufpd	zmm0, zmm9, zmm11, 00000000b		;; d1_2 d0_2 d1_0 d0_0 d3_2 d2_2 d3_0 d2_0		; 18		n 26
	vmulpd	zmm8, zmm8, zmm23			;; apply the inverse col multiplier to R4		; 18-21		n 38

	vbroadcastsd zmm24, [colreg+4*8]		;; Load the inverse col multiplier for R5/R13
	vshufpd	zmm11, zmm9, zmm11, 11111111b		;; d1_3 d0_3 d1_1 d0_1 d3_3 d2_3 d3_1 d2_1		; 19		n 32
	vmulpd	zmm16, zmm16, zmm24			;; apply the inverse col multiplier to R5		; 19-22		n 39

	vbroadcastsd zmm26, [colreg+6*8]		;; Load the inverse col multiplier for R7/R15
	vshufpd	zmm9, zmm13, zmm12, 00000000b		;; d5_2 d4_2 d5_0 d4_0 d7_2 d6_2 d7_0 d6_0		; 20		n 26
	vmulpd	zmm3, zmm3, zmm26			;; apply the inverse col multiplier to R7		; 20-23		n 44

	vbroadcastsd zmm25, [colreg+5*8]		;; Load the inverse col multiplier for R6/R14
	vshufpd	zmm12, zmm13, zmm12, 11111111b		;; d5_3 d4_3 d5_1 d4_1 d7_3 d6_3 d7_1 d6_1		; 21		n 32
	vmulpd	zmm2, zmm2, zmm25			;; apply the inverse col multiplier to R6		; 21-24		n 43

	vbroadcastsd zmm27, [colreg+7*8]		;; Load the inverse col multiplier for R8/R16
	vshufpd	zmm13, zmm10, zmm30, 00000000b		;; d1_6 d0_6 d1_4 d0_4 d3_6 d2_6 d3_4 d2_4		; 22		n 28
	vmulpd	zmm14, zmm14, zmm27			;; apply the inverse col multiplier to R8		; 22-25		n 45

	vshufpd	zmm30, zmm10, zmm30, 11111111b		;; d1_7 d0_7 d1_5 d0_5 d3_7 d2_7 d3_5 d2_5		; 23		n 30
	mov	r13, [maskreg+0*8]			;; Load uncompressed fudge flags

	vshufpd	zmm10, zmm1, zmm6, 00000000b		;; d5_6 d4_6 d5_4 d4_4 d7_6 d6_6 d7_4 d6_4		; 24		n 28
	mov	r14, [maskreg+1*8]			;; Load uncompressed fudge flags

	vshufpd	zmm6, zmm1, zmm6, 11111111b		;; d5_7 d4_7 d5_5 d4_5 d7_7 d6_7 d7_5 d6_5		; 25		n 30
	L1prefetchw srcreg+L1pd, L1pt
	bump	colreg, colinc

	vshuff64x2 zmm1, zmm0, zmm9, 00100010b		;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0 (R9)		; 26-28		n 29
	L1prefetchw srcreg+64+L1pd, L1pt
	bump	maskreg, maskinc

	vshuff64x2 zmm9, zmm0, zmm9, 01110111b		;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2 (R11)	; 27-29		n 30
	L1prefetchw srcreg+d1+L1pd, L1pt

	vshuff64x2 zmm0, zmm13, zmm10, 00100010b	;; d7_4 d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4 (R13)	; 28-30		n 31
	L1prefetchw srcreg+d1+64+L1pd, L1pt

	vshuff64x2 zmm10, zmm13, zmm10, 01110111b	;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6 (R15)	; 29-31		n 32
	L1prefetchw srcreg+d2+L1pd, L1pt
	zstore	[srcreg+64], zmm1			;; Save R9						; 29

	vshuff64x2 zmm13, zmm30, zmm6, 00100010b	;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5 (R14)	; 30-32		n 33
	vmulpd	zmm9, zmm9, zmm22			;; apply the inverse col multiplier to R11		; 30-33		n 40
	L1prefetchw srcreg+d2+64+L1pd, L1pt

	vshuff64x2 zmm6, zmm30, zmm6, 01110111b		;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7 (R16)	; 31-33		n 34
	vmulpd	zmm0, zmm0, zmm24			;; apply the inverse col multiplier to R13		; 31-34		n 45
	L1prefetchw srcreg+d2+d1+L1pd, L1pt

	vshuff64x2 zmm4, zmm11, zmm12, 00100010b	;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1 (R10)	; 32-34		n 41
	vmulpd	zmm10, zmm10, zmm26			;; apply the inverse col multiplier to R15		; 32-35		n 47
	L1prefetchw srcreg+d2+d1+64+L1pd, L1pt

	vshuff64x2 zmm12, zmm11, zmm12, 01110111b	;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3 (R12)	; 33-35		n 44
	vmulpd	zmm13, zmm13, zmm25			;; apply the inverse col multiplier to R14		; 33-36		n 46
	L1prefetchw srcreg+d4+L1pd, L1pt

	kmovw	k2, r13d				;; Load R2 and R10 fudge factor mask			; 34		n 35
	vmulpd	zmm6, zmm6, zmm27			;; apply the inverse col multiplier to R16		; 34-37		n 48
	shr	r13, 16					;; Next 16 bits of fudge flags
	L1prefetchw srcreg+d4+64+L1pd, L1pt

	kmovw	k3, r13d				;; Load R3 and R11 fudge factor mask			; 35		n 36
	vmulpd	zmm5{k2}, zmm5, zmm28			;; apply fudge multiplier for R2			; 35-38
	shr	r13, 16					;; Next 16 bits of fudge flags
	L1prefetchw srcreg+d4+d1+L1pd, L1pt

	kmovw	k4, r13d				;; Load R4 and R12 fudge factor mask			; 36		n 37
	vmulpd	zmm15{k3}, zmm15, zmm28			;; apply fudge multiplier for R3			; 36-39
	shr	r13, 16					;; Next 16 bits of fudge flags
	L1prefetchw srcreg+d4+d1+64+L1pd, L1pt

	kmovw	k5, r13d				;; Load R5 and R13 fudge factor mask			; 37		n 38
	vmulpd	zmm8{k4}, zmm8, zmm28			;; apply fudge multiplier for R4			; 37-40
	L1prefetchw srcreg+d4+d2+L1pd, L1pt

	kshiftrw k2, k2, 8				;; R10's fudge						; 38		n 39
	vmulpd	zmm16{k5}, zmm16, zmm28			;; apply fudge multiplier for R5			; 38-41
	L1prefetchw srcreg+d4+d2+64+L1pd, L1pt

	kshiftrw k3, k3, 8				;; R11's fudge						; 39		n 40
	vmulpd	zmm4{k2}, zmm4, zmm28			;; apply fudge multiplier for R10			; 39-42		n 50
	L1prefetchw srcreg+d4+d2+d1+L1pd, L1pt
	zstore	[srcreg+d1], zmm5			;; Save R2						; 39

	kmovw	k1, r14d				;; Load R6 and R14 fudge factor mask			; 40		n 41
	vmulpd	zmm9{k3}, zmm9, zmm28			;; apply fudge multiplier for R11			; 40-43
	shr	r14, 16					;; Next 16 bits of fudge flags
	L1prefetchw srcreg+d4+d2+d1+64+L1pd, L1pt
	zstore	[srcreg+d2], zmm15			;; Save R3						; 40

	kmovw	k2, r14d				;; Load R7 and R15 fudge factor mask			; 41		n 42
	vmulpd	zmm2{k1}, zmm2, zmm28			;; apply fudge multiplier for R6			; 41-44
	shr	r14, 16					;; Next 16 bits of fudge flags
	zstore	[srcreg+d2+d1], zmm8			;; Save R4						; 41

	kmovw	k3, r14d				;; Load R8 and R16 fudge factor mask			; 42		n 43
	vmulpd	zmm3{k2}, zmm3, zmm28			;; apply fudge multiplier for R7			; 42-45
	zstore	[srcreg+d4], zmm16			;; Save R5						; 42

	kshiftrw k4, k4, 8				;; R12's fudge						; 43		n 44
	vmulpd	zmm14{k3}, zmm14, zmm28			;; apply fudge multiplier for R8			; 43-46

	kshiftrw k5, k5, 8				;; R13's fudge						; 44		n 45
	vmulpd	zmm12{k4}, zmm12, zmm28			;; apply fudge multiplier for R12			; 44-47		n 49
 	zstore	[srcreg+d2+64], zmm9			;; Save R11						; 44

	kshiftrw k1, k1, 8				;; R14's fudge						; 45		n 46
	vmulpd	zmm0{k5}, zmm0, zmm28			;; apply fudge multiplier for R13			; 45-48
	zstore	[srcreg+d4+d1], zmm2			;; Save R6						; 45

	kshiftrw k2, k2, 8				;; R15's fudge						; 46		n 47
	vmulpd	zmm13{k1}, zmm13, zmm28			;; apply fudge multiplier for R14			; 46-49
	zstore	[srcreg+d4+d2], zmm3			;; Save R7						; 46

	kshiftrw k3, k3, 8				;; R16's fudge						; 47		n 48
	vmulpd	zmm10{k2}, zmm10, zmm28			;; apply fudge multiplier for R15			; 47-50
	zstore	[srcreg+d4+d2+d1], zmm14		;; Save R8						; 47

	vmulpd	zmm6{k3}, zmm6, zmm28			;; apply fudge multiplier for R16			; 48-51
	vmulpd	zmm4, zmm4, zmm21			;; apply the inverse col multiplier to R10		; 48-51

	vmulpd	zmm12, zmm12, zmm23			;; apply the inverse col multiplier to R12		; 49-52
	zstore	[srcreg+d4+64], zmm0			;; Save R13						; 49

	zstore	[srcreg+d4+d1+64], zmm13		;; Save R14						; 50
	zstore	[srcreg+d4+d2+64], zmm10		;; Save R15						; 51
	zstore	[srcreg+d4+d2+d1+64], zmm6		;; Save R16						; 52
	zstore	[srcreg+d1+64], zmm4			;; Save R10						; 52+1
	zstore	[srcreg+d2+d1+64], zmm12		;; Save R12						; 53+1
	bump	srcreg, srcinc
	ENDM


;; Wrapper macro that takes two all-complex reals, swizzles data, and applies weights.  Output will be suitable for use by a pass 2 FFT macro.
;; NOTE: The r1/i1 col multiplier is 1.0 thus there are no fudges to apply to R1/I1.  Also the column multiplier has been
;; pre-applied to the complex-multiplier sine value.

zsf_onepass_complex_fft_wrapper_preload MACRO
	vbroadcastsd zmm28, ZMM_ONE_OVER_B
	ENDM
zsf_onepass_complex_fft_wrapper MACRO srcreg,srcinc,d1,d2,d4,pmreg,pminc,maskreg,maskinc,grpreg,grpinc,maxrpt,L1pt,L1pd
	vmovapd zmm30, [grpreg+0*64]			;; group multiplier for R1-R8
	vmulpd	zmm14, zmm30, [srcreg+rbx]		;; apply group multiplier to R1			; 1-4		n 9
	vmulpd	zmm2, zmm30, [srcreg+rbx+d1]		;; apply group multiplier to R2			; 1-4		n 10

	vmulpd	zmm10, zmm30, [srcreg+rbx+d2]		;; apply group multiplier to R3			; 2-5		n 11
	vmulpd	zmm6, zmm30, [srcreg+rbx+d2+d1]		;; apply group multiplier to R4			; 2-5		n 12

	vmulpd	zmm16, zmm30, [srcreg+rbx+d4]		;; apply group multiplier to R5			; 3-6		n 13
	vmulpd	zmm8, zmm30, [srcreg+rbx+d4+d1]		;; apply group multiplier to R6			; 3-6		n 14

	vmulpd	zmm12, zmm30, [srcreg+rbx+d4+d2]	;; apply group multiplier to R7			; 4-7		n 15
	vmulpd	zmm4, zmm30, [srcreg+rbx+d4+d2+d1]	;; apply group multiplier to R8			; 4-7		n 16

	vmovapd zmm31, [grpreg+1*64]			;; group multiplier for I1-I8
	vmulpd	zmm20, zmm31, [srcreg+rbx+64]		;; apply group multiplier to I1			; 5-8		n 9
	vmulpd	zmm21, zmm31, [srcreg+rbx+d1+64]	;; apply group multiplier to I2			; 5-8		n 10

	vmulpd	zmm22, zmm31, [srcreg+rbx+d2+64]	;; apply group multiplier to I3			; 6-9		n 11
	vmulpd	zmm23, zmm31, [srcreg+rbx+d2+d1+64]	;; apply group multiplier to I4			; 6-9		n 12

	vmulpd	zmm24, zmm31, [srcreg+rbx+d4+64]	;; apply group multiplier to I5			; 7-10		n 13
	vmulpd	zmm25, zmm31, [srcreg+rbx+d4+d1+64]	;; apply group multiplier to I6			; 7-10		n 14

	vmulpd	zmm26, zmm31, [srcreg+rbx+d4+d2+64]	;; apply group multiplier to I7			; 8-11		n 15
	vmulpd	zmm27, zmm31, [srcreg+rbx+d4+d2+d1+64]	;; apply group multiplier to I8			; 8-11		n 17

	vmovapd zmm9, [pmreg+0*128]		;; premultiplier sine for R1/I1
	vmulpd	zmm14, zmm14, zmm9		;; apply col multiplier * premultiplier sine to R1	; 9-12		n 24
	vmulpd	zmm20, zmm20, zmm9		;; apply col multiplier * premultiplier sine to I1	; 9-12		n 24

	vmovapd zmm1, [pmreg+1*128]		;; premultiplier sine for R2/I2
	vmulpd	zmm2, zmm2, zmm1		;; apply col multiplier * premultiplier sine to R2	; 10-13		n 18
	vmulpd	zmm21, zmm21, zmm1		;; apply col multiplier * premultiplier sine to I2	; 10-13		n 19

	vmovapd zmm11, [pmreg+2*128]		;; premultiplier sine for R3/I3
	vmulpd	zmm10, zmm10, zmm11		;; apply col multiplier * premultiplier sine to R3	; 11-14		n 20
	vmulpd	zmm22, zmm22, zmm11		;; apply col multiplier * premultiplier sine to I3	; 11-14		n 21

	vmovapd zmm3, [pmreg+3*128]		;; premultiplier sine for R4/I4
	vmulpd	zmm6, zmm6, zmm3		;; apply col multiplier * premultiplier sine to R4	; 12-15		n 22
	vmulpd	zmm23, zmm23, zmm3		;; apply col multiplier * premultiplier sine to I4	; 12-15		n 23

	vmovapd zmm13, [pmreg+4*128]		;; premultiplier sine for R5/I5
	vmulpd	zmm16, zmm16, zmm13		;; apply col multiplier * premultiplier sine to R5	; 13-16		n 28
	vmulpd	zmm24, zmm24, zmm13		;; apply col multiplier * premultiplier sine to I5	; 13-16		n 29

	vmovapd zmm5, [pmreg+5*128]		;; premultiplier sine for R6/I6
	vmulpd	zmm8, zmm8, zmm5		;; apply col multiplier * premultiplier sine to R6	; 14-17		n 30
	vmulpd	zmm25, zmm25, zmm5		;; apply col multiplier * premultiplier sine to I6	; 14-17		n 31

	vmovapd zmm15, [pmreg+6*128]		;; premultiplier sine for R7/I7
	vmulpd	zmm12, zmm12, zmm15		;; apply col multiplier * premultiplier sine to R7	; 15-18		n 36
	vmulpd	zmm26, zmm26, zmm15		;; apply col multiplier * premultiplier sine to I7	; 15-18		n 37
	bump	grpreg, grpinc

	mov	r14, [maskreg+0*8]		;; Load uncompressed fudge flags
	vmovapd zmm7, [pmreg+7*128]		;; premultiplier sine for R8/I8
	kmovw	k3, r14d			;; Load R2 and I2 fudge factor mask			; 16		n 17
	vmulpd	zmm4, zmm4, zmm7		;; apply col multiplier * premultiplier sine to R8	; 16-19		n 38
	shr	r14, 16				;; Next 16 bits of fudge flags

	kshiftrw k4, k3, 8			;; I2's fudge						; 17		n 19
	vmulpd	zmm27, zmm27, zmm7		;; apply col multiplier * premultiplier sine to I8	; 17-20		n 39
	mov	r12, [maskreg+1*8]		;; Load uncompressed fudge flags
	vmovapd zmm17, [pmreg+0*128+64]		;; premultiplier cosine/sine for R1/I1
	bump	maskreg, maskinc

	kmovw	k1, r14d			;; Load R3 and I3 fudge factor mask			; 18		n 20
	vmulpd	zmm2{k3}, zmm2, zmm28		;; apply fudge to R2					; 18-21		n 25
	shr	r14, 16				;; Next 16 bits of fudge flags
	vmovapd zmm18, [pmreg+1*128+64]		;; premultiplier cosine/sine for R2/I2

	kshiftrw k2, k1, 8			;; I3's fudge						; 19		n 21
	vmulpd	zmm21{k4}, zmm21, zmm28		;; apply fudge to I2					; 19-22		n 25
	vmovapd zmm19, [pmreg+2*128+64]		;; premultiplier cosine/sine for R3/I3

	kmovw	k3, r14d			;; Load R4 and I4 fudge factor mask			; 20		n 22
	vmulpd	zmm10{k1}, zmm10, zmm28		;; apply fudge to R3					; 20-23		n 26
	vmovapd zmm29, [pmreg+3*128+64]		;; premultiplier cosine/sine for R4/I4
	shr	r14, 16				;; Next 16 bits of fudge flags

	kshiftrw k4, k3, 8			;; I4's fudge						; 21		n 25
	vmulpd	zmm22{k2}, zmm22, zmm28		;; apply fudge to I3					; 21-24		n 26
	vmovapd zmm0, [pmreg+4*128+64]		;; premultiplier cosine/sine for R5/I5

	kmovw	k1, r14d			;; Load R5 and I5 fudge factor mask			; 22		n 23
	vmulpd	zmm6{k3}, zmm6, zmm28		;; apply fudge to R4					; 22-25		n 27
	vmovapd zmm31, [pmreg+5*128+64]		;; premultiplier cosine/sine for R6/I6

	kshiftrw k2, k1, 8			;; I5's fudge						; 23		n 29
	vmulpd	zmm23{k4}, zmm23, zmm28		;; apply fudge to I4					; 23-26		n 27
	vmovapd zmm30, [pmreg+6*128+64]		;; premultiplier cosine/sine for R7/I7

	kmovw	k3, r12d			;; Load R6 and I6 fudge factor mask			; 24		n 25
	zfmsubpd zmm1, zmm14, zmm17, zmm20	;; R1 * cosine - I1 (new R1)				; 24-27		n 30
	vmovapd zmm15, [pmreg+7*128+64]		;; premultiplier cosine/sine for R8/I8
	shr	r12, 16				;; Next 16 bits of fudge flags

	kshiftrw k4, k3, 8			;; I6's fudge						; 25		n 31
	zfmsubpd zmm3, zmm2, zmm18, zmm21	;; R2 * cosine - I2 (new R2)				; 25-28		n 30
	L1prefetch srcreg+L1pd, L1pt
	bump	pmreg, pminc

	kmovw	k5, r12d			;; Load R7 and I7 fudge factor mask			; 26		n 27
	zfmsubpd zmm5, zmm10, zmm19, zmm22	;; R3 * cosine - I3 (new R3)				; 26-29		n 32
	shr	r12, 16				;; Next 16 bits of fudge flags
	L1prefetch srcreg+64+L1pd, L1pt

	kshiftrw k6, k5, 8			;; I7's fudge						; 27		n 37
	zfmsubpd zmm7, zmm6, zmm29, zmm23	;; R4 * cosine - I4 (new R4)				; 27-30		n 32
	L1prefetch srcreg+d1+L1pd, L1pt

	kmovw	k7, r12d			;; Load R8 and I8 fudge factor mask			; 28		n 29
	vmulpd	zmm16{k1}, zmm16, zmm28		;; apply fudge to R5					; 28-31		n 40
	L1prefetch srcreg+d1+64+L1pd, L1pt

	kshiftrw k1, k7, 8			;; I8's fudge						; 29		n 39
	vmulpd	zmm24{k2}, zmm24, zmm28		;; apply fudge to I5					; 29-32		n 40
	L1prefetch srcreg+d2+L1pd, L1pt

;;	zscatter srcreg,d1,d2,d4,zmm1,zmm3,zmm5,zmm7,zmm11,zmm13,zmm14,zmm18,zmm9
	vshufpd	zmm9, zmm1, zmm3, 00000000b	;; d1_6 d0_6 d1_4 d0_4 d1_2 d0_2 d1_0 d0_0		; 30		n 34
	vmulpd	zmm8{k3}, zmm8, zmm28		;; apply fudge to R6					; 30-33		n 41
	L1prefetch srcreg+d2+64+L1pd, L1pt

	vshufpd	zmm1, zmm1, zmm3, 11111111b	;; d1_7 d0_7 d1_5 d0_5 d1_3 d0_3 d1_1 d0_1		; 31		n 36
	vmulpd	zmm25{k4}, zmm25, zmm28		;; apply fudge to I6					; 31-34		n 41
	L1prefetch srcreg+d2+d1+L1pd, L1pt

	vshufpd	zmm3, zmm5, zmm7, 00000000b	;; d3_6 d2_6 d3_4 d2_4 d3_2 d2_2 d3_0 d2_0		; 32		n 34
	zfmaddpd zmm20, zmm20, zmm17, zmm14	;; I1 * cosine + R1 (new I1)				; 32-35		n 38
	L1prefetch srcreg+d2+d1+64+L1pd, L1pt

	vshufpd	zmm5, zmm5, zmm7, 11111111b	;; d3_7 d2_7 d3_5 d2_5 d3_3 d2_3 d3_1 d2_1		; 33		n 36
	zfmaddpd zmm21, zmm21, zmm18, zmm2	;; I2 * cosine + R2 (new I2)				; 33-36		n 38
	L1prefetch srcreg+d4+L1pd, L1pt

	vshuff64x2 zmm7, zmm9, zmm3, 10001000b	;; d3_4 d2_4 d3_0 d2_0 d1_4 d0_4 d1_0 d0_0		; 34-36		n 54
	zfmaddpd zmm22, zmm22, zmm19, zmm10	;; I3 * cosine + R3 (new I3)				; 34-37		n 40
	L1prefetch srcreg+d4+64+L1pd, L1pt

	vshuff64x2 zmm9, zmm9, zmm3, 11011101b ;; d3_6 d2_6 d3_2 d2_2 d1_6 d0_6 d1_2 d0_2		; 35-37		n 56
	zfmaddpd zmm23, zmm23, zmm29, zmm6	;; I4 * cosine + R4 (new I4)				; 35-38		n 40
	L1prefetch srcreg+d4+d1+L1pd, L1pt

	vshuff64x2 zmm3, zmm1, zmm5, 10001000b ;; d3_5 d2_5 d3_1 d2_1 d1_5 d0_5 d1_1 d0_1		; 36-38		n 58
	vmulpd	zmm12{k5}, zmm12, zmm28		;; apply fudge to R7					; 36-39		n 42
	L1prefetch srcreg+d4+d1+64+L1pd, L1pt

	vshuff64x2 zmm1, zmm1, zmm5, 11011101b ;; d3_7 d2_7 d3_3 d2_3 d1_7 d0_7 d1_3 d0_3		; 37-39		n 60
	vmulpd	zmm26{k6}, zmm26, zmm28		;; apply fudge to I7					; 37-40		n 42
	L1prefetch srcreg+d4+d2+L1pd, L1pt

;;	zscatter srcreg+64,d1,d2,d4,zmm20,zmm21,zmm22,zmm23,zmm24,zmm25,zmm26,zmm27,zmm17
	vshufpd	zmm17, zmm20, zmm21, 00000000b	;; d1_6 d0_6 d1_4 d0_4 d1_2 d0_2 d1_0 d0_0		; 38		n 42
	vmulpd	zmm4{k7}, zmm4, zmm28		;; apply fudge to R8					; 38-41		n 43
	L1prefetch srcreg+d4+d2+64+L1pd, L1pt

	vshufpd	zmm20, zmm20, zmm21, 11111111b	;; d1_7 d0_7 d1_5 d0_5 d1_3 d0_3 d1_1 d0_1		; 39		n 44
	vmulpd	zmm27{k1}, zmm27, zmm28		;; apply fudge to I8					; 39-42		n 43
	L1prefetch srcreg+d4+d2+d1+L1pd, L1pt

	vshufpd	zmm21, zmm22, zmm23, 00000000b	;; d3_6 d2_6 d3_4 d2_4 d3_2 d2_2 d3_0 d2_0		; 40		n 42
	zfmsubpd zmm11, zmm16, zmm0, zmm24	;; R5 * cosine - I5 (new R5)				; 40-43		n 46
	L1prefetch srcreg+d4+d2+d1+64+L1pd, L1pt

	vshufpd	zmm22, zmm22, zmm23, 11111111b	;; d3_7 d2_7 d3_5 d2_5 d3_3 d2_3 d3_1 d2_1		; 41		n 44
	zfmsubpd zmm13, zmm8, zmm31, zmm25	;; R6 * cosine - I6 (new R6)				; 41-44		n 46

	vshuff64x2 zmm23, zmm17, zmm21, 10001000b ;; d3_4 d2_4 d3_0 d2_0 d1_4 d0_4 d1_0 d0_0		; 42-44		n 70
	zfmsubpd zmm14, zmm12, zmm30, zmm26	;; R7 * cosine - I7 (new R7)				; 42-45		n 48

	vshuff64x2 zmm17, zmm17, zmm21, 11011101b ;; d3_6 d2_6 d3_2 d2_2 d1_6 d0_6 d1_2 d0_2		; 43-45		n 72
	zfmsubpd zmm18, zmm4, zmm15, zmm27	;; R8 * cosine - I8 (new R8)				; 43-46		n 48

	vshuff64x2 zmm21, zmm20, zmm22, 10001000b ;; d3_5 d2_5 d3_1 d2_1 d1_5 d0_5 d1_1 d0_1		; 44-46		n 74
	zfmaddpd zmm24, zmm24, zmm0, zmm16	;; I5 * cosine + R5 (new I5)				; 44-47		n 62

	vshuff64x2 zmm20, zmm20, zmm22, 11011101b ;; d3_7 d2_7 d3_3 d2_3 d1_7 d0_7 d1_3 d0_3		; 45-47		n 76
	zfmaddpd zmm25, zmm25, zmm31, zmm8	;; I6 * cosine + R6 (new I6)				; 45-48		n 62

	vshufpd	zmm5, zmm11, zmm13, 00000000b	;; d5_6 d4_6 d5_4 d4_4 d5_2 d4_2 d5_0 d4_0		; 46		n 50
	zfmaddpd zmm26, zmm26, zmm30, zmm12	;; I7 * cosine + R7 (new I7)				; 46-49		n 64

	vshufpd	zmm11, zmm11, zmm13, 11111111b	;; d5_7 d4_7 d5_5 d4_5 d5_3 d4_3 d5_1 d4_1		; 47		n 52
	zfmaddpd zmm27, zmm27, zmm15, zmm4	;; I8 * cosine + R8 (new I8)				; 47-50		n 64

	vshufpd	zmm13, zmm14, zmm18, 00000000b	;; d7_6 d6_6 d7_4 d6_4 d7_2 d6_2 d7_0 d6_0		; 48		n 50

	vshufpd	zmm14, zmm14, zmm18, 11111111b	;; d7_7 d6_7 d7_5 d6_5 d7_3 d6_3 d7_1 d6_1		; 49		n 52

	vshuff64x2 zmm18, zmm5, zmm13, 10001000b ;; d7_4 d6_4 d7_0 d6_0 d5_4 d4_4 d5_0 d4_0		; 50-52		n 54

	vshuff64x2 zmm5, zmm5, zmm13, 11011101b ;; d7_6 d6_6 d7_2 d6_2 d5_6 d4_6 d5_2 d4_2		; 51-53		n 56

	vshuff64x2 zmm13, zmm11, zmm14, 10001000b ;; d7_5 d6_5 d7_1 d6_1 d5_5 d4_5 d5_1 d4_1		; 52-54		n 58

	vshuff64x2 zmm11, zmm11, zmm14, 11011101b ;; d7_7 d6_7 d7_3 d6_3 d5_7 d4_7 d5_3 d4_3		; 53-55		n 60

	vshuff64x2 zmm14, zmm7, zmm18, 10001000b ;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0		; 54-56

	vshuff64x2 zmm7, zmm7, zmm18, 11011101b ;; d7_4 d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4		; 55-57

	vshuff64x2 zmm18, zmm9, zmm5, 10001000b ;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2		; 56-58

	vshuff64x2 zmm9, zmm9, zmm5, 11011101b ;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6		; 57-59
	zstore	[srcreg], zmm14										; 57

	vshuff64x2 zmm5, zmm3, zmm13, 10001000b ;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1		; 58-60
	zstore	[srcreg+d4], zmm7									; 58

	vshuff64x2 zmm3, zmm3, zmm13, 11011101b ;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5		; 59-61
	zstore	[srcreg+d2], zmm18									; 59

	vshuff64x2 zmm13, zmm1, zmm11, 10001000b ;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3		; 60-62
	zstore	[srcreg+d4+d2], zmm9									; 60

	vshuff64x2 zmm1, zmm1, zmm11, 11011101b ;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7		; 61-63
	zstore	[srcreg+d1], zmm5									; 61

	vshufpd	zmm22, zmm24, zmm25, 00000000b	;; d5_6 d4_6 d5_4 d4_4 d5_2 d4_2 d5_0 d4_0		; 62		n 66
	zstore	[srcreg+d4+d1], zmm3									; 62

	vshufpd	zmm24, zmm24, zmm25, 11111111b	;; d5_7 d4_7 d5_5 d4_5 d5_3 d4_3 d5_1 d4_1		; 63		n 68
	zstore	[srcreg+d2+d1], zmm13									; 63

	vshufpd	zmm25, zmm26, zmm27, 00000000b	;; d7_6 d6_6 d7_4 d6_4 d7_2 d6_2 d7_0 d6_0		; 64		n 66
	zstore	[srcreg+d4+d2+d1], zmm1									; 64

	vshufpd	zmm26, zmm26, zmm27, 11111111b	;; d7_7 d6_7 d7_5 d6_5 d7_3 d6_3 d7_1 d6_1		; 65		n 68

	vshuff64x2 zmm27, zmm22, zmm25, 10001000b ;; d7_4 d6_4 d7_0 d6_0 d5_4 d4_4 d5_0 d4_0		; 66-68		n 70

	vshuff64x2 zmm22, zmm22, zmm25, 11011101b ;; d7_6 d6_6 d7_2 d6_2 d5_6 d4_6 d5_2 d4_2		; 67-69		n 72

	vshuff64x2 zmm25, zmm24, zmm26, 10001000b ;; d7_5 d6_5 d7_1 d6_1 d5_5 d4_5 d5_1 d4_1		; 68-70		n 74

	vshuff64x2 zmm24, zmm24, zmm26, 11011101b ;; d7_7 d6_7 d7_3 d6_3 d5_7 d4_7 d5_3 d4_3		; 69-71		n 76

	vshuff64x2 zmm26, zmm23, zmm27, 10001000b ;; d7_0 d6_0 d5_0 d4_0 d3_0 d2_0 d1_0 d0_0		; 70-72

	vshuff64x2 zmm23, zmm23, zmm27, 11011101b ;; d7_4 d6_4 d5_4 d4_4 d3_4 d2_4 d1_4 d0_4		; 71-73

	vshuff64x2 zmm27, zmm17, zmm22, 10001000b ;; d7_2 d6_2 d5_2 d4_2 d3_2 d2_2 d1_2 d0_2		; 72-74

	vshuff64x2 zmm17, zmm17, zmm22, 11011101b ;; d7_6 d6_6 d5_6 d4_6 d3_6 d2_6 d1_6 d0_6		; 73-75
	zstore	[srcreg+64], zmm26									; 73

	vshuff64x2 zmm22, zmm21, zmm25, 10001000b ;; d7_1 d6_1 d5_1 d4_1 d3_1 d2_1 d1_1 d0_1		; 74-76
	zstore	[srcreg+d4+64], zmm23									; 74

	vshuff64x2 zmm21, zmm21, zmm25, 11011101b ;; d7_5 d6_5 d5_5 d4_5 d3_5 d2_5 d1_5 d0_5		; 75-77
	zstore	[srcreg+d2+64], zmm27									; 75

	vshuff64x2 zmm25, zmm20, zmm24, 10001000b ;; d7_3 d6_3 d5_3 d4_3 d3_3 d2_3 d1_3 d0_3		; 76-78
	zstore	[srcreg+d4+d2+64], zmm17								; 76

	vshuff64x2 zmm20, zmm20, zmm24, 11011101b ;; d7_7 d6_7 d5_7 d4_7 d3_7 d2_7 d1_7 d0_7		; 77-79
	zstore	[srcreg+d1+64], zmm22									; 77

	zstore	[srcreg+d4+d1+64], zmm21								; 78
	zstore	[srcreg+d2+d1+64], zmm25								; 79
	zstore	[srcreg+d4+d2+d1+64], zmm20								; 80
	bump	srcreg, srcinc
	ENDM


;; Wrapper macro that takes two all-complex reals, swizzles data, and applies weights.  Output will be suitable for use by a pass 2 FFT macro.
;; NOTE: The r1/i1 inverse column multiplier is 1.0 thus there are no fudges to apply to R1/I1

zs_onepass_complex_unfft_wrapper_preload MACRO
	mov	r14d, 11110000b
	kmovw	k6, r14d
	knotw	k7, k6
	vbroadcastsd zmm28, ZMM_B
	ENDM
zs_onepass_complex_unfft_wrapper MACRO srcreg,srcinc,d1,d2,d4,pmreg,pminc,colreg,colinc,maskreg,maskinc,maxrpt,L1pt,L1pd
	vmovapd zmm21, [pmreg+1*128]		;; premultiplier sine for R2/I2
	vmulpd	zmm21, zmm21, [colreg+1*8]{1to8};; apply the col multiplier to sine for R2/I2		; x17-20
	vmovapd zmm22, [pmreg+2*128]		;; premultiplier sine for R3/I3
	vmulpd	zmm22, zmm22, [colreg+2*8]{1to8};; apply the col multiplier to sine for R3/I3		; x17-20
	vmovapd zmm23, [pmreg+3*128]		;; premultiplier sine for R4/I4
	vmulpd	zmm23, zmm23, [colreg+3*8]{1to8};; apply the col multiplier to sine for R4/I4		; x17-20
	vmovapd zmm24, [pmreg+4*128]		;; premultiplier sine for R5/I5
	vmulpd	zmm24, zmm24, [colreg+4*8]{1to8};; apply the col multiplier to sine for R5/I5		; x17-20
	vmovapd zmm25, [pmreg+5*128]		;; premultiplier sine for R6/I6
	vmulpd	zmm25, zmm25, [colreg+5*8]{1to8};; apply the col multiplier to sine for R6/I6		; x17-20
	vmovapd zmm26, [pmreg+6*128]		;; premultiplier sine for R7/I7
	vmulpd	zmm26, zmm26, [colreg+6*8]{1to8};; apply the col multiplier to sine for R7/I7		; x17-20
