# Makefile for Mac OS X gwnum library
#

ENVP= MACOSX_DEPLOYMENT_TARGET=10.3

CC = gcc
CFLAGS = -I.. -g -DGDEBUG -DX86_64 -m64

CPP = g++
CPPFLAGS = -I.. -I../qd -g -DGDEBUG -DX86_64 -m64

OBJS = amd64/debug/cpuid.o amd64/debug/gwnum.o amd64/debug/gwthread.o amd64/debug/gwutil.o amd64/debug/gwdbldbl.o amd64/debug/giants.o amd64/debug/ecmstag1.o

LIB = amd64/debug/gwnum.a

#########################################################################

$(LIB): $(OBJS)
	ar -rs $(LIB) $(OBJS)

clean:
	rm -f $(OBJS)

amd64/debug/cpuid.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/cpuid.o cpuid.c

amd64/debug/gwnum.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/gwnum.o gwnum.c

amd64/debug/gwthread.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/gwthread.o gwthread.c

amd64/debug/gwutil.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/gwutil.o gwutil.c

amd64/debug/gwdbldbl.o:
	$(ENVP) $(CPP) $(CPPFLAGS) -c -o amd64/debug/gwdbldbl.o gwdbldbl.cpp

amd64/debug/giants.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/giants.o giants.c

amd64/debug/ecmstag1.o:
	$(ENVP) $(CC) $(CFLAGS) -c -o amd64/debug/ecmstag1.o ecmstag1.c

.c.o:
	$(ENVP) $(CC) $(CFLAGS) -c $<

.cpp.o:
	$(ENVP) $(CPP) $(CPPFLAGS) -c $<
